age/jpeg'\x2C fn] -> ['image/jpeg'\x2C null\x2C fn]\n  // ['image/jpeg'\x2C opts\x2C fn] -> ['image/jpeg'\x2C opts\x2C fn]\n  // ['image/jpeg'\x2C qual\x2C fn] -> ['image/jpeg'\x2C {quality: qual}\x2C fn]\n  // ['image/jpeg'\x2C undefined\x2C fn] -> ['image/jpeg'\x2C null\x2C fn]\n  // ['image/jpeg'] -> ['image/jpeg'\x2C null\x2C fn]\n  // ['image/jpeg'\x2C opts] -> ['image/jpeg'\x2C opts\x2C fn]\n  // ['image/jpeg'\x2C qual] -> ['image/jpeg'\x2C {quality: qual}\x2C fn]\n\n  let type = 'image/png'\n  let opts = {}\n  let fn\n\n  if (typeof a1 === 'function') {\n    fn = a1\n  } else {\n    if (typeof a1 === 'string' && FORMATS.includes(a1.toLowerCase())) {\n      type = a1.toLowerCase()\n    }\n\n    if (typeof a2 === 'function') {\n      fn = a2\n    } else {\n      if (typeof a2 === 'object') {\n        opts = a2\n      } else if (typeof a2 === 'number') {\n        opts = { quality: Math.max(0\x2C Math.min(1\x2C a2)) }\n      }\n\n      if (typeof a3 === 'function') {\n        fn = a3\n      } else if (undefined !== a3) {\n        throw new TypeError(`${typeof a3} is not a function`)\n      }\n    }\n  }\n\n  if (this.width === 0 || this.height === 0) {\n    // Per spec\x2C if the bitmap has no pixels\x2C return this string:\n    const str = 'data:\x2C'\n    if (fn) {\n      setTimeout(() => fn(null\x2C str))\n      return\n    } else {\n      return str\n    }\n  }\n\n  if (fn) {\n    this.toBuffer((err\x2C buf) => {\n      if (err) return fn(err)\n      fn(null\x2C `data:${type};base64\x2C${buf.toString('base64')}`)\n    }\x2C type\x2C opts)\n  } else {\n    return `data:${type};base64\x2C${this.toBuffer(type\x2C opts).toString('base64')}`\n  }\n}\n
