e.\n  clone () {\n    webidl.brandCheck(this\x2C Response)\n\n    // 1. If this is unusable\x2C then throw a TypeError.\n    if (bodyUnusable(this)) {\n      throw webidl.errors.exception({\n        header: 'Response.clone'\x2C\n        message: 'Body has already been consumed.'\n      })\n    }\n\n    // 2. Let clonedResponse be the result of cloning this\u2019s response.\n    const clonedResponse = cloneResponse(this[kState])\n\n    // 3. Return the result of creating a Response object\x2C given\n    // clonedResponse\x2C this\u2019s headers\u2019s guard\x2C and this\u2019s relevant Realm.\n    return fromInnerResponse(clonedResponse\x2C getHeadersGuard(this[kHeaders]))\n  }\n\n  [nodeUtil.inspect.custom] (depth\x2C options) {\n    if (options.depth === null) {\n      options.depth = 2\n    }\n\n    options.colors ??= true\n\n    const properties = {\n      status: this.status\x2C\n      statusText: this.statusText\x2C\n      headers: this.headers\x2C\n      body: this.body\x2C\n      bodyUsed: this.bodyUsed\x2C\n      ok: this.ok\x2C\n      redirected: this.redirected\x2C\n      type: this.type\x2C\n      url: this.url\n    }\n\n    return `Response ${nodeUtil.formatWithOptions(options\x2C properties)}`\n  }\n}\n\nmixinBody(Response)\n\nObject.defineProperties(Response.prototype\x2C {\n  type: kEnumerableProperty\x2C\n  url: kEnumerableProperty\x2C\n  status: kEnumerableProperty\x2C\n  ok: kEnumerableProperty\x2C\n  redirected: kEnumerableProperty\x2C\n  statusText: kEnumerableProperty\x2C\n  headers: kEnumerableProperty\x2C\n  clone: kEnumerableProperty\x2C\n  body: kEnumerableProperty\x2C\n  bodyUsed: kEnumerableProperty\x2C\n  [Symbol.toStringTag]: {\n    value: 'Response'\x2C\n    configurable: true\n  }\n})\n\nObject.defineProperties(Response\x2C {\n  json: kEnumerableProperty\x2C\n  redirect: kEnumerableProperty\x2C\n  error: kEnumerableProperty\n})\n\n// https://fetch.spec.whatwg.org/#concept-response-clone\nfunction cloneResponse (response) {\n  // To clone a response response\x2C run these steps:\n\n  // 1. If response is a filtered response\x2C then return a new identical\n  // filtered response whose internal response is a clone of response\u2019s\n  // internal response.\n  if (response.internalResponse) {\n    return filterResponse(\n      cloneResponse(response.internalResponse)\x2C\n      response.type\n    )\n  }\n\n  // 2. Let newResponse be a copy of response\x2C except for its body.\n  const newResponse = makeResponse({ ...response\x2C body: null })\n\n  // 3. If response\u2019s body is non-null\x2C then set newResponse\u2019s body to the\n  // result of cloning response\u2019s body.\n  if (response.body != null) {\n    newResponse.body = cloneBody(newResponse\x2C response.body)\n  }\n\n  // 4. Return newResponse.\n  return newResponse\n}\n\nfunction makeResponse (init) {\n  return {\n    aborted: false\x2C\n    rangeRequested: false\x2C\n    timingAllowPassed: false\x2C\n    requestIncludesCredentials: false\x2C\n    type: 'default'\x2C\n    status: 200\x2C\n    timingInfo: null\x2C\n    cacheState: ''\x2C\n    statusText: ''\x2C\n    ...init\x2C\n    headersList: init?.headersList\n      ? new HeadersList(init?.headersList)\n      : new HeadersList()\x2C\n    urlList: init?.urlList ? [...init.urlList] : []\n  }\n}\n\nfunction makeNetworkError (reason) {\n  const isError = isErrorLike(reason)\n  return makeResponse({\n    type: 'error'\x2C\n    status: 0\x2C\n    error: isError\n      ? reason\n      : new Error(reason ? String(reason) : reason)\x2C\n    aborted: reason && reason.name === 'AbortError'\n  })\n}\n\n// @see https://fetch.spec.whatwg.org/#concept-network-error\nfunction isNetworkError (response) {\n  return (\n    // A network error is a response whose type is "error"\x2C\n    response.type === 'error' &&\n    // status is 0\n    response.status === 0\n  )\n}\n\nfunction makeFilteredResponse (response\x2C state) {\n  state = {\n    internalResponse: response\x2C\n    ...state\n  }\n\n  retur