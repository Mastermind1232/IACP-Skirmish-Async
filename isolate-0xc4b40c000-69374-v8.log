t\x2C unknownOrigin)) {\n        ret.push(key\x2C headers[key])\n      }\n    }\n  } else {\n    assert(headers == null\x2C 'headers must be an object or an array')\n  }\n  return ret\n}\n\nmodule.exports = RedirectHandler\n
