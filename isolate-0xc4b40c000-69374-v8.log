code-creation,Script,9,277555,0x3f05b92951f0,52, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/interrupts.js:1:1,0x3dc363b85100,~
script-source,224,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/interrupts.js,/**\n * Interrupt handlers: still_faster\x2C squad_swarm\x2C overdrive\x2C self_destruct_probe\x2C\n * self_destruct_protocol\x2C last_resort\x2C scavenged_walker\x2C on_diplomatic\x2C bel_reorder\x2C\n * ab_blade_pick\x2C sf_mp_pick\x2C force_slow_pick\x2C excavation_pick\n */\nimport { ButtonBuilder\x2C ActionRowBuilder\x2C ButtonStyle } from 'discord.js';\nimport { parseCustomId\x2C splitCustomId } from '../discord/custom-id.js';\nimport { chunkButtonsToRows } from '../discord/components.js';\nimport { getDcList\x2C getDcMessageIds\x2C getActivatedDcIndices\x2C getPlayAreaId\x2C dcAttachmentsKey\x2C getHandChannelId\x2C opponentPlayerNum\x2C getPlayerId\x2C getCcDiscard\x2C getCcHand\x2C ccHandKey\x2C ccDiscardKey } from '../game/player-helpers.js';\nimport { reduceHp\x2C healHp\x2C awardObjectiveVp\x2C deductVp\x2C awardKillVp\x2C dcNameFromFigureKey\x2C parseFigureKey\x2C getMaxPowerTokens\x2C grantPowerTokens\x2C applyCondition\x2C filterCondition\x2C grantMovementBank\x2C HARMFUL_CONDITIONS } from '../game/index.js';\nimport { getCcEffect } from '../data-loader.js';\nimport { discordCatch } from '../error-handling.js';\nimport { requireGame\x2C requirePlayer } from '../utils/guards.js';\nimport { fetchGameChannel } from '../discord/channel-helpers.js';\nimport { resolveStartOfRoundEffect } from './round.js';\n\n// \u2500\u2500 1. Still Faster Than You \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nexport async function handleStillFaster(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C dcMessageMeta\x2C logGameAction } = ctx;\n  const buttonKey = interaction.customId.startsWith('still_faster_dc_pick_') ? 'still_faster_dc_pick_'\n    : interaction.customId.startsWith('still_faster_skip_') ? 'still_faster_skip_'\n    : 'still_faster_use_';\n\n  // still_faster_use_{gameId}_{activatingMsgId}\n  // still_faster_skip_{gameId}_{activatingMsgId}\n  // still_faster_dc_pick_{gameId}_{sftDcMsgId}_{activatingMsgId}\n  let sftGameId\x2C sftActivatingMsgId\x2C sftPickedMsgId;\n  if (buttonKey === 'still_faster_dc_pick_') {\n    // still_faster_dc_pick_ prefix is 21 chars; remainder: gameId_sftDcMsgId_activatingMsgId\n    const rem = interaction.customId.slice('still_faster_dc_pick_'.length);\n    const remParts = rem.split('_');\n    sftGameId = remParts[0];\n    sftPickedMsgId = remParts[1];\n    sftActivatingMsgId = remParts.slice(2).join('_');\n  } else {\n    const rem = interaction.customId.slice(buttonKey.length);\n    const remParts = rem.split('_');\n    sftGameId = remParts[0];\n    sftActivatingMsgId = remParts.slice(1).join('_');\n  }\n  const sftGame = await requireGame(interaction\x2C getGame\x2C sftGameId);\n  if (!sftGame) return;\n\n  if (buttonKey === 'still_faster_skip_') {\n    const sftPlayerNum = sftGame.pendingStillFaster?.sftPlayerNum;\n    if (!await requirePlayer(interaction\x2C sftGame\x2C interaction.user.id\x2C sftPlayerNum\x2C canActAsPlayer\x2C 'Only the Still Faster Than You player may respond.')) return;\n    delete sftGame.pendingStillFaster;\n    sftGame.stillFasterPlayerNum = null;\n    await interaction.deferUpdate().catch(discordCatch);\n    await interaction.followUp({ content: '**Still Faster Than You** \u2014 Skipped.'\x2C ephemeral: false }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n\n  if (buttonKey === 'still_faster_use_') {\n    const sftPending = sftGame.pendingStillFaster;\n    if (!sftPending) { await interaction.followUp({ content: 'No pending Still Faster Than You.'\x2C ephemeral: true }).catch(discordCatch); return; }\n    const { sftPlayerNum } = sftPending;\n    if (!await requirePlayer(interaction\x2C sftGame\x2C interaction.user.id\x2C sftPlayerNum\x2C canActAsPlayer\x2C 'Only the Still Faster Than You player may respond.')) return;\n    // Show the SFTY player's non-exhausted DCs as picker buttons\n    const sftDcList = sftPlayerNum === 1 ? (sftGame.p1DcList || []) : (sftGame.p2DcList || []);\n    const sftMsgIds = sftPlayerNum === 1 ? (sftGame.p1DcMessageIds || []) : (sftGame.p2DcMessageIds || []);\n    const sftActivatedIndices = sftPlayerNum === 1 ? (sftGame.p1ActivatedDcIndices || []) : (sftGame.p2ActivatedDcIndices || []);\n    const sftButtons = [];\n    for (let i = 0; i < sftDcList.length; i++) {\n      const dc = sftDcList[i];\n      if (!dc || dc.defeated || sftActivatedIndices.includes(i)) continue;\n      const dcMsgId = sftMsgIds[i];\n      if (!dcMsgId) continue;\n      sftButtons.push(new ButtonBuilder()\n        .setCustomId(`still_faster_dc_pick_${sftGameId}_${dcMsgId}_${sftActivatingMsgId}`)\n        .setLabel((dc.displayName || dc.dcName).slice(0\x2C 80))\n        .setStyle(ButtonStyle.Primary));\n    }\n    if (sftButtons.length === 0) {\n      delete sftGame.pendingStillFaster;\n      sftGame.stillFasterPlayerNum = null;\n      await interaction.deferUpdate().catch(discordCatch);\n      await interaction.followUp({ content: '**Still Faster Than You** \u2014 No eligible figures to interrupt with.'\x2C ephemeral: false }).catch(discordCatch);\n      saveGames();\n      return;\n    }\n    const sftRows = chunkButtonsToRows(sftButtons);\n    await interaction.deferUpdate().catch(discordCatch);\n    await interaction.followUp({ content: '**Still Faster Than You** \u2014 Choose which figure interrupts (move 2 + attack):'\x2C components: sftRows\x2C ephemeral: false }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n\n  if (buttonKey === 'still_faster_dc_pick_') {\n    const sftPending = sftGame.pendingStillFaster;\n    if (!sftPending) { await interaction.followUp({ content: 'No pending Still Faster Than You.'\x2C ephemeral: true }).catch(discordCatch); return; }\n    const { sftPlayerNum } = sftPending;\n    if (!await requirePlayer(interaction\x2C sftGame\x2C interaction.user.id\x2C sftPlayerNum\x2C canActAsPlayer\x2C 'Only the Still Faster Than You player may respond.')) return;\n    // Grant 2MP to the picked DC's movement bank and a free attack (excluding the activating hostile)\n    sftGame.movementBank = sftGame.movementBank || {};\n    const sftBank = sftGame.movementBank[sftPickedMsgId] || { total: 0\x2C remaining: 0 };\n    sftBank.total = (sftBank.total ?? 0) + 2;\n    sftBank.remaining = (sftBank.remaining ?? 0) + 2;\n    sftGame.movementBank[sftPickedMsgId] = sftBank;\n    // Free attack: mark this DC with a free attack\x2C excluding the activating hostile\n    sftGame.fellSwoopFreeAttack = sftGame.fellSwoopFreeAttack || {};\n    sftGame.fellSwoopFreeAttack[sftPickedMsgId] = true;\n    // Store exclusion so handleAttackTarget can reject wrong target\n    sftGame.stillFasterExcludeMsgId = sftActivatingMsgId;\n    // Clear the flag (once-per-round CC; clear so it can't be used again)\n    sftGame.stillFasterPlayerNum = null;\n    delete sftGame.pendingStillFaster;\n    const sftMeta = dcMessageMeta.get(sftPickedMsgId);\n    const sftLabel = sftMeta?.displayName || sftMeta?.dcName || sftPickedMsgId;\n    await interaction.deferUpdate().catch(discordCatch);\n    await interaction.followUp({ content: `**Still Faster Than You** \u2014 **${sftLabel}** gains 2 MP and a free Attack. The attack must target a **different hostile** than the one that just activated.`\x2C ephemeral: false }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n  return;\n}\n\n// \u2500\u2500 2. Squad Swarm \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nexport async function handleSquadSwarm(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C dcMessageMeta\x2C logGameAction } = ctx;\n  const buttonKey = interaction.customId.startsWith('squad_swarm_yes_') ? 'squad_swarm_yes_' : 'squad_swarm_no_';\n\n  const _swParts = splitCustomId(interaction.customId\x2C buttonKey);\n  // squad_swarm_yes_{gameId}_{msgId}_{targetMsgId} OR squad_swarm_no_{gameId}_{msgId}\n  const _swGameId = _swParts[0]; const _swMsgId = _swParts[1]; const _swTargetMsgId = _swParts[2];\n  const _swGame = await requireGame(interaction\x2C getGame\x2C _swGameId);\n  if (!_swGame) return;\n  const _swMeta = dcMessageMeta.get(_swMsgId);\n  if (_swMeta && !await requirePlayer(interaction\x2C _swGame\x2C interaction.user.id\x2C _swMeta.playerNum\x2C canActAsPlayer\x2C 'Only the Squad Swarm player may respond.')) return;\n  _swGame.squadSwarmPlayerNum = null;\n  if (buttonKey === 'squad_swarm_yes_') {\n    // Keep cumulative cost so next activation continues the tally\n    const _swTargetName = _swTargetMsgId ? (dcMessageMeta.get(_swTargetMsgId)?.displayName || 'another figure') : 'another figure';\n    await logGameAction(_swGame\x2C client\x2C `**Squad Swarm** \u2014 Activating **${_swTargetName}**. Click its card to begin.`\x2C { phase: 'ROUND'\x2C icon: 'activate' });\n  } else {\n    // G4: Clear cumulative cost when skipping\n    delete _swGame.squadSwarmCumulativeCost;\n    await logGameAction(_swGame\x2C client\x2C `**Squad Swarm** \u2014 Skipped.`\x2C { phase: 'ROUND'\x2C icon: 'activate' });\n  }\n  saveGames(); return;\n}\n\n// \u2500\u2500 3. Overdrive \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nexport async function handleOverdrive(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C dcMessageMeta\x2C logGameAction\x2C dcHealthState\x2C DC_ACTIONS_PER_ACTIVATION\x2C updateDcActionsMessage\x2C renderDcEmbed\x2C getDcPlayAreaComponents\x2C processFigureDefeat } = ctx;\n\n  const _odMsgId = parseCustomId(interaction.customId\x2C 'overdrive_use_');\n  const _odMeta = dcMessageMeta.get(_odMsgId);\n  if (!_odMeta) { await interaction.followUp({ content: 'DC not found.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  const _odGame = await requireGame(interaction\x2C getGame\x2C _odMeta.gameId);\n  if (!_odGame) return;\n  if (!await requirePlayer(interaction\x2C _odGame\x2C interaction.user.id\x2C _odMeta.playerNum\x2C canActAsPlayer\x2C 'Only the DC owner can use Overdrive.')) return;\n  const _odActionsData = _odGame.dcActionsData?.[_odMsgId];\n  if (!_odActionsData) { await interaction.followUp({ content: 'No active activation found.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  const { prevHp: _odPrevHp\x2C newHp: _odNewHp\x2C maxHp: _odMaxHp } = reduceHp(dcHealthState\x2C _odGame\x2C _odMsgId\x2C 0\x2C 1\x2C _odMeta.playerNum);\n  const _odHS = dcHealthState.get(_odMsgId) || [];\n  let _odHpNote = '';\n  if (_odMaxHp > 0) {\n    _odHpNote = ` (HP: ${_odPrevHp}\u2192${_odNewHp})`;\n  }\n  _odActionsData.remaining = Math.min((_odActionsData.total ?? DC_ACTIONS_PER_ACTIVATION) + 1\x2C (_odActionsData.remaining || 0) + 1);\n  const _odDgIdx = (_odMeta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? 1;\n  _odGame.overdriveUsedThisActivation = _odGame.overdriveUsedThisActivation || {};\n  _odGame.overdriveUsedThisActivation[`${_odMeta.dcName}-${_odDgIdx}-0`] = true;\n  const _odDefeatNote = _odNewHp <= 0 ? ' **(defeated)**' : '';\n  await logGameAction(_odGame\x2C client\x2C `**Overdrive** \u2014 **${_odMeta.displayName || _odMeta.dcName}** took 1 Damage${_odHpNote}${_odDefeatNote}; +1 Action granted.`\x2C { phase: 'ROUND'\x2C icon: 'activate' });\n  if (_odNewHp <= 0 && processFigureDefeat) {\n    const _odFigKey = `${_odMeta.dcName}-${_odDgIdx}-0`;\n    await processFigureDefeat(_odGame\x2C {\n      defeatedPlayerNum: _odMeta.playerNum\x2C\n      figureKey: _odFigKey\x2C\n      attackerPlayerNum: opponentPlayerNum(_odMeta.playerNum)\x2C\n      source: 'Overdrive'\x2C\n    });\n  }\n  await updateDcActionsMessage(_odGame\x2C _odMsgId\x2C client);\n  const { embed: _odEmbed\x2C files: _odFiles } = await renderDcEmbed(_odGame\x2C _odMsgId\x2C ctx\x2C { exhausted: true });\n  try {\n    const _odCh = await fetchGameChannel(client\x2C _odMeta.playerNum === 1 ? _odGame.p1PlayAreaId : _odGame.p2PlayAreaId);\n    const _odMsg = await _odCh.messages.fetch(_odMsgId);\n    await _odMsg.edit({ embeds: [_odEmbed]\x2C files: _odFiles\x2C components: getDcPlayAreaComponents(_odMsgId\x2C true\x2C _odGame\x2C _odMeta.dcName) });\n  } catch (err) { console.error('Overdrive embed refresh failed:'\x2C err); }\n  saveGames(); return;\n}\n\n// \u2500\u2500 4. Self-Destruct Probe \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nexport async function handleSelfDestructProbe(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C dcMessageMeta\x2C dcHealthState\x2C logGameAction\x2C getDiceData\x2C getMapData\x2C processFigureDefeat } = ctx;\n  const buttonKey = interaction.customId.startsWith('self_destruct_probe_use_') ? 'self_destruct_probe_use_' : 'self_destruct_probe_skip_';\n\n  const _sdpSuffix = parseCustomId(interaction.customId\x2C buttonKey);\n  const _sdpParts = _sdpSuffix.split('_');\n  const _sdpGameId = _sdpParts[0]; const _sdpMsgId = _sdpParts.slice(1).join('_');\n  const _sdpGame = await requireGame(interaction\x2C getGame\x2C _sdpGameId);\n  if (!_sdpGame) return;\n  const _sdpMeta = dcMessageMeta.get(_sdpMsgId);\n  if (!_sdpMeta) { await interaction.followUp({ content: 'DC not found.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  if (!await requirePlayer(interaction\x2C _sdpGame\x2C interaction.user.id\x2C _sdpMeta.playerNum\x2C canActAsPlayer\x2C 'Only the DC owner can respond.')) return;\n  if (buttonKey === 'self_destruct_probe_skip_') {\n    await logGameAction(_sdpGame\x2C client\x2C `**Self-Destruct** \u2014 ${_sdpMeta.displayName || _sdpMeta.dcName} skipped.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n    saveGames(); return;\n  }\n  // Use: roll 1 red die\x2C apply Hits to adjacent hostile figures\x2C defeat probe\n  const _sdpDiceData = getDiceData ? getDiceData() : null;\n  const _sdpFaces = _sdpDiceData?.attack?.red || [];\n  const _sdpFace = _sdpFaces[Math.floor(Math.random() * Math.max(_sdpFaces.length\x2C 1))] || {};\n  const _sdpHits = _sdpFace.dmg ?? 0;\n  const _sdpFaceLabel = `${_sdpHits}H`;\n  const _sdpPos = (() => { for (const [\x2C pos] of Object.entries(_sdpGame.figurePositions?.[_sdpMeta.playerNum] || {})) { const fk = `${_sdpMeta.dcName}-1-0`; return _sdpGame.figurePositions?.[_sdpMeta.playerNum]?.[fk] || null; } return null; })();\n  let _sdpResultLog = `Rolled red die: **${_sdpFaceLabel}** \u2014 `;\n  const _sdpDamaged = [];\n  const _sdpDefeated = [];\n  if (_sdpHits > 0 && _sdpPos) {\n    const _sdpMs = getMapData ? getMapData(_sdpGame.selectedMap?.id) : null;\n    const _sdpAdj = _sdpMs?.adjacency?.[String(_sdpPos).toLowerCase()] || [];\n    const _sdpAllAdjSpaces = new Set([String(_sdpPos).toLowerCase()\x2C ..._sdpAdj.map(s => String(s).toLowerCase())]);\n    const _sdpHostileNum = opponentPlayerNum(_sdpMeta.playerNum);\n    for (const [_sdpFk\x2C _sdpFkPos] of Object.entries(_sdpGame.figurePositions?.[_sdpHostileNum] || {})) {\n      if (!_sdpFkPos || !_sdpAllAdjSpaces.has(String(_sdpFkPos).toLowerCase())) continue;\n      let _sdpHMsgId = null;\n      for (const [mid\x2C mm] of dcMessageMeta) { if (mm.playerNum === _sdpHostileNum && _sdpFk.startsWith(mm.dcName + '-')) { _sdpHMsgId = mid; break; } }\n      if (!_sdpHMsgId) continue;\n      const _sdpHM = dcMessageMeta.get(_sdpHMsgId);\n      const _sdpFkMatch = _sdpFk.match(/^(.+)-(\\d+)-(\\d+)$/);\n      if (!_sdpFkMatch) continue;\n      const _sdpHFigIdx = parseInt(_sdpFkMatch[3]\x2C 10);\n      const { prevHp: _hc\x2C newHp: _hnc\x2C maxHp: _sdpMaxHp } = reduceHp(dcHealthState\x2C _sdpGame\x2C _sdpHMsgId\x2C _sdpHFigIdx\x2C _sdpHits\x2C _sdpHostileNum);\n      if (_sdpMaxHp === 0 || _hc === null || _hc <= 0) continue;\n      const _sdpDefNote = _hnc <= 0 ? ' **(defeated)**' : '';\n      _sdpDamaged.push(`${_sdpHM?.displayName || _sdpFkMatch[1]} (HP: ${_hc}\u2192${_hnc})${_sdpDefNote}`);\n      if (_hnc <= 0) _sdpDefeated.push({ figureKey: _sdpFk\x2C playerNum: _sdpHostileNum });\n    }\n    _sdpResultLog += _sdpDamaged.length ? _sdpDamaged.join('\x2C ') : 'No adjacent hostiles.';\n  } else {\n    _sdpResultLog += 'No hits.';\n  }\n  // Defeat the probe via centralized defeat pipeline\n  reduceHp(dcHealthState\x2C _sdpGame\x2C _sdpMsgId\x2C 0\x2C 9999\x2C _sdpMeta.playerNum);\n  await logGameAction(_sdpGame\x2C client\x2C `**Self-Destruct** \u2014 ${_sdpMeta.displayName || _sdpMeta.dcName}: ${_sdpResultLog}`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  const _sdpFigureKey = `${_sdpMeta.dcName}-1-0`;\n  await processFigureDefeat(_sdpGame\x2C {\n    defeatedPlayerNum: _sdpMeta.playerNum\x2C\n    figureKey: _sdpFigureKey\x2C\n    attackerPlayerNum: opponentPlayerNum(_sdpMeta.playerNum)\x2C\n    msgId: _sdpMsgId\x2C\n    dcName: _sdpMeta.dcName\x2C\n    displayName: _sdpMeta.displayName || _sdpMeta.dcName\x2C\n    source: 'Self-Destruct'\x2C\n  });\n  // Process defeats of hostile figures damaged by the explosion\n  for (const _sdpDf of _sdpDefeated) {\n    await processFigureDefeat(_sdpGame\x2C {\n      defeatedPlayerNum: _sdpDf.playerNum\x2C\n      figureKey: _sdpDf.figureKey\x2C\n      attackerPlayerNum: _sdpMeta.playerNum\x2C\n      source: 'Self-Destruct Probe'\x2C\n    });\n  }\n  saveGames(); return;\n}\n\n// \u2500\u2500 5. Self-Destruct Protocol \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nexport async function handleSelfDestructProtocol(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C dcMessageMeta\x2C dcHealthState\x2C logGameAction\x2C getDiceData\x2C getMapData\x2C applyDamageAndFinishCombat\x2C processFigureDefeat } = ctx;\n  const buttonKey = interaction.customId.startsWith('self_destruct_protocol_use_') ? 'self_destruct_protocol_use_' : 'self_destruct_protocol_skip_';\n\n  await interaction.deferUpdate().catch(discordCatch);\n  const _sdcpSuffix = parseCustomId(interaction.customId\x2C buttonKey);\n  const _sdcpParts = _sdcpSuffix.split('_');\n  const _sdcpGameId = _sdcpParts[0]; const _sdcpTargetMsgId = _sdcpParts[1];\n  const _sdcpGame = await requireGame(interaction\x2C getGame\x2C _sdcpGameId\x2C { silent: true });\n  if (!_sdcpGame) return;\n  if (!_sdcpGame.pendingSelfDestruct) {\n    await interaction.followUp({ content: 'No pending Self-Destruct Protocol.'\x2C ephemeral: true }).catch(discordCatch); return;\n  }\n  const _sdcpPending = _sdcpGame.pendingSelfDestruct;\n  if (!await requirePlayer(interaction\x2C _sdcpGame\x2C interaction.user.id\x2C _sdcpPending.defenderPlayerNum\x2C canActAsPlayer\x2C 'Only the DC owner may respond.')) return;\n  delete _sdcpGame.pendingSelfDestruct;\n  const _sdcpCombat = _sdcpGame.pendingCombat;\n  if (buttonKey === 'self_destruct_protocol_use_') {\n    // Roll 1 red die\x2C apply Hit results as Damage to adjacent hostile figures\n    const _sdcpDiceData = getDiceData ? getDiceData() : null;\n    const _sdcpFaces = _sdcpDiceData?.attack?.red || [];\n    const _sdcpFace = _sdcpFaces[Math.floor(Math.random() * Math.max(_sdcpFaces.length\x2C 1))] || {};\n    const _sdcpHits = _sdcpFace.dmg ?? 0;\n    const _sdcpFaceLabel = `${_sdcpHits}H`;\n    const _sdcpFigKey = _sdcpCombat?.target?.figureKey;\n    const _sdcpPos = _sdcpFigKey ? _sdcpGame.figurePositions?.[_sdcpPending.defenderPlayerNum]?.[_sdcpFigKey] : null;\n    let _sdcpResultLog = `Rolled red die: **${_sdcpFaceLabel}** \u2014 `;\n    const _sdcpDamaged = [];\n    const _sdcpDefeated = [];\n    if (_sdcpHits > 0 && _sdcpPos && _sdcpGame.selectedMap?.id) {\n      const _sdcpMs = getMapData ? getMapData(_sdcpGame.selectedMap.id) : null;\n      const _sdcpAdj = _sdcpMs?.adjacency?.[String(_sdcpPos).toLowerCase()] || [];\n      const _sdcpAllAdj = new Set([String(_sdcpPos).toLowerCase()\x2C ..._sdcpAdj.map(s => String(s).toLowerCase())]);\n      const _sdcpHostileNum = opponentPlayerNum(_sdcpPending.defenderPlayerNum);\n      for (const [_sfk\x2C _sfkPos] of Object.entries(_sdcpGame.figurePositions?.[_sdcpHostileNum] || {})) {\n        if (!_sfkPos || !_sdcpAllAdj.has(String(_sfkPos).toLowerCase())) continue;\n        if (_sfk === _sdcpFigKey) continue;\n        let _sfkMsgId = null;\n        for (const [_mid\x2C _mm] of dcMessageMeta) { if (_mm.playerNum === _sdcpHostileNum && _sfk.startsWith(_mm.dcName + '-')) { _sfkMsgId = _mid; break; } }\n        if (!_sfkMsgId) continue;\n        const _sfkFigMatch = _sfk.match(/^(.+)-(\\d+)-(\\d+)$/);\n        if (!_sfkFigMatch) continue;\n        const _sfkFigIdx = parseInt(_sfkFigMatch[3]\x2C 10);\n        const { prevHp: _shc\x2C newHp: _shnc\x2C maxHp: _sfkMaxHp } = reduceHp(dcHealthState\x2C _sdcpGame\x2C _sfkMsgId\x2C _sfkFigIdx\x2C _sdcpHits\x2C _sdcpHostileNum);\n        if (_sfkMaxHp === 0 || _shc === null || _shc <= 0) continue;\n        const _sdcpDefNote = _shnc <= 0 ? ' **(defeated)**' : '';\n        _sdcpDamaged.push(`${dcMessageMeta.get(_sfkMsgId)?.displayName || _sfkFigMatch[1]} (HP: ${_shc}\u2192${_shnc})${_sdcpDefNote}`);\n        if (_shnc <= 0) _sdcpDefeated.push({ figureKey: _sfk\x2C playerNum: _sdcpHostileNum });\n      }\n      _sdcpResultLog += _sdcpDamaged.length ? _sdcpDamaged.join('\x2C ') : 'No adjacent hostiles.';\n    } else {\n      _sdcpResultLog += 'No hits.';\n    }\n    await logGameAction(_sdcpGame\x2C client\x2C `**Self-Destruct Protocol** \u2014 ${_sdcpCombat?.target?.label || 'Figure'}: ${_sdcpResultLog}`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n    // Process defeats of hostile figures damaged by the explosion\n    for (const _sdcpDf of _sdcpDefeated) {\n      if (processFigureDefeat) {\n        await processFigureDefeat(_sdcpGame\x2C {\n          defeatedPlayerNum: _sdcpDf.playerNum\x2C\n          figureKey: _sdcpDf.figureKey\x2C\n          attackerPlayerNum: _sdcpPending.defenderPlayerNum\x2C\n          source: 'Self-Destruct Protocol'\x2C\n        });\n      }\n    }\n  } else {\n    await logGameAction(_sdcpGame\x2C client\x2C `**Self-Destruct Protocol** \u2014 Skipped. ${_sdcpCombat?.target?.label || 'Figure'} is defeated.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  }\n  // Finalize defeat by re-calling applyDamageAndFinishCombat (SDP flag already set so no re-trigger)\n  await applyDamageAndFinishCombat(_sdcpGame\x2C _sdcpCombat\x2C {\n    damage: _sdcpPending.damage\x2C hit: _sdcpPending.hit\x2C resultText: _sdcpPending.resultText\x2C\n    totalBlast: _sdcpPending.totalBlast\x2C defenderPlayerNum: _sdcpPending.defenderPlayerNum\x2C\n    attackerPlayerNum: _sdcpPending.attackerPlayerNum\x2C ownerId: _sdcpPending.ownerId\x2C\n    targetMsgId: _sdcpPending.targetMsgId\x2C targetFigIndex: _sdcpPending.targetFigIndex\x2C\n  }\x2C client);\n  saveGames(); return;\n}\n\n// \u2500\u2500 5b. You Have Something I Want (Moff Gideon) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nexport async function handleYHSIW(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C dcMessageMeta\x2C dcHealthState\x2C logGameAction\x2C processFigureDefeat } = ctx;\n  const isTransfer = interaction.customId.startsWith('yhsiw_transfer_');\n  await interaction.deferUpdate().catch(discordCatch);\n  const gameId = parseCustomId(interaction.customId\x2C isTransfer ? 'yhsiw_transfer_' : 'yhsiw_damage_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  if (!game.pendingYHSIW) {\n    await interaction.followUp({ content: 'No pending You Have Something I Want.'\x2C ephemeral: true }).catch(discordCatch); return;\n  }\n  const pending = game.pendingYHSIW;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pending.oppPlayerNum\x2C canActAsPlayer\x2C 'Only the targeted player may respond.')) return;\n  delete game.pendingYHSIW;\n\n  if (isTransfer) {\n    // Transfer the token from target to Moff Gideon\n    const { targetFk\x2C token\x2C gideonFk\x2C gideonPlayerNum\x2C oppPlayerNum } = pending;\n    const isPowerToken = ['Block'\x2C 'Evade'\x2C 'Damage'\x2C 'Surge'].includes(token);\n    if (isPowerToken) {\n      // Remove from target\n      const tTokens = game.figurePowerTokens?.[targetFk] || [];\n      const tIdx = tTokens.indexOf(token);\n      if (tIdx >= 0) tTokens.splice(tIdx\x2C 1);\n      // Add to Gideon\n      grantPowerTokens(game\x2C gideonFk\x2C token\x2C 1);\n    } else {\n      // Condition token: remove from target\x2C apply to Gideon\n      filterCondition(game\x2C targetFk\x2C token);\n      applyCondition(game\x2C gideonFk\x2C token);\n    }\n    const targetName = dcNameFromFigureKey(targetFk);\n    await logGameAction(game\x2C client\x2C `**You Have Something I Want** \u2014 **${targetName}** transfers **${token}** to **Moff Gideon**.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  } else {\n    // Suffer 3 Damage\n    const { targetFk\x2C oppPlayerNum } = pending;\n    const targetName = dcNameFromFigureKey(targetFk);\n    let tMsgId = null;\n    for (const [mid\x2C mm] of dcMessageMeta) {\n      if (mm.playerNum === oppPlayerNum && targetFk.startsWith(mm.dcName + '-')) { tMsgId = mid; break; }\n    }\n    if (tMsgId && dcHealthState) {\n      const fkMatch = targetFk.match(/-(\\d+)-(\\d+)$/);\n      const figIdx = fkMatch ? parseInt(fkMatch[2]\x2C 10) : 0;\n      const { prevHp\x2C newHp } = reduceHp(dcHealthState\x2C game\x2C tMsgId\x2C figIdx\x2C 3\x2C oppPlayerNum);\n      const _yhDefNote = newHp <= 0 ? ' **(defeated)**' : '';\n      await logGameAction(game\x2C client\x2C `**You Have Something I Want** \u2014 **${targetName}** suffers **3 Damage**${_yhDefNote} (HP: ${prevHp}\u2192${newHp}).`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n      if (newHp <= 0 && processFigureDefeat) {\n        await processFigureDefeat(game\x2C {\n          defeatedPlayerNum: oppPlayerNum\x2C\n          figureKey: targetFk\x2C\n          attackerPlayerNum: pending.gideonPlayerNum\x2C\n          source: 'You Have Something I Want'\x2C\n        });\n      }\n    } else {\n      await logGameAction(game\x2C client\x2C `**You Have Something I Want** \u2014 **${targetName}** suffers **3 Damage** (apply manually).`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n    }\n  }\n  // Disable the buttons\n  try { await interaction.message.edit({ components: [] }); } catch {}\n  saveGames();\n}\n\n// \u2500\u2500 6. Last Resort \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nexport async function handleLastResort(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C dcMessageMeta\x2C dcHealthState\x2C logGameAction\x2C getDiceData\x2C getMapData\x2C applyDamageAndFinishCombat\x2C processFigureDefeat } = ctx;\n  const buttonKey = interaction.customId.startsWith('last_resort_use_') ? 'last_resort_use_' : 'last_resort_skip_';\n\n  await interaction.deferUpdate().catch(discordCatch);\n  const _lrSuffix = parseCustomId(interaction.customId\x2C buttonKey);\n  const _lrParts = _lrSuffix.split('_');\n  const _lrGameId = _lrParts[0]; const _lrTargetMsgId = _lrParts[1];\n  const _lrGame = await requireGame(interaction\x2C getGame\x2C _lrGameId\x2C { silent: true });\n  if (!_lrGame) return;\n  if (!_lrGame.pendingLastResort) {\n    await interaction.followUp({ content: 'No pending Last Resort.'\x2C ephemeral: true }).catch(discordCatch); return;\n  }\n  const _lrPending = _lrGame.pendingLastResort;\n  if (!await requirePlayer(interaction\x2C _lrGame\x2C interaction.user.id\x2C _lrPending.defenderPlayerNum\x2C canActAsPlayer\x2C 'Only the DC owner may respond.')) return;\n  delete _lrGame.pendingLastResort;\n  const _lrCombat = _lrGame.pendingCombat;\n  if (buttonKey === 'last_resort_use_') {\n    // Deplete: remove Last Resort from attachments\n    const _lrAttKey = dcAttachmentsKey(_lrPending.defenderPlayerNum);\n    const _lrAtts = _lrGame[_lrAttKey]?.[_lrPending.targetMsgId];\n    if (_lrAtts) {\n      _lrGame[_lrAttKey][_lrPending.targetMsgId] = _lrAtts.filter(a => a !== 'Last Resort');\n    }\n    // Roll 1 red die\x2C apply Hit results as Damage to adjacent figures (both players)\n    const _lrDiceData = getDiceData ? getDiceData() : null;\n    const _lrFaces = _lrDiceData?.attack?.red || [];\n    const _lrFace = _lrFaces[Math.floor(Math.random() * Math.max(_lrFaces.length\x2C 1))] || {};\n    const _lrHits = _lrFace.dmg ?? 0;\n    const _lrFaceLabel = `${_lrHits}H`;\n    const _lrFigKey = _lrCombat?.target?.figureKey;\n    const _lrPos = _lrFigKey ? _lrGame.figurePositions?.[_lrPending.defenderPlayerNum]?.[_lrFigKey] : null;\n    let _lrResultLog = `Rolled red die: **${_lrFaceLabel}** \u2014 `;\n    const _lrDamaged = [];\n    const _lrDefeated = [];\n    if (_lrHits > 0 && _lrPos && _lrGame.selectedMap?.id) {\n      const _lrMs = getMapData ? getMapData(_lrGame.selectedMap.id) : null;\n      const _lrAdj = _lrMs?.adjacency?.[String(_lrPos).toLowerCase()] || [];\n      for (const pn of [1\x2C 2]) {\n        for (const [_lfk\x2C _lfkPos] of Object.entries(_lrGame.figurePositions?.[pn] || {})) {\n          if (!_lfkPos) continue;\n          if (_lfk === _lrFigKey) continue; // skip the dying figure itself\n          if (!_lrAdj.includes(String(_lfkPos).toLowerCase()) && String(_lfkPos).toLowerCase() !== String(_lrPos).toLowerCase()) continue;\n          let _lfkMsgId = null;\n          for (const [_mid\x2C _mm] of dcMessageMeta) { if (_mm.playerNum === pn && _lfk.startsWith(_mm.dcName + '-')) { _lfkMsgId = _mid; break; } }\n          if (!_lfkMsgId) continue;\n          const _lfkMatch = _lfk.match(/^(.+)-(\\d+)-(\\d+)$/);\n          if (!_lfkMatch) continue;\n          const _lfkFigIdx = parseInt(_lfkMatch[3]\x2C 10);\n          const { prevHp: _lhc\x2C newHp: _lhnc\x2C maxHp: _lfkMaxHp } = reduceHp(dcHealthState\x2C _lrGame\x2C _lfkMsgId\x2C _lfkFigIdx\x2C _lrHits\x2C pn);\n          if (_lfkMaxHp === 0 || _lhc === null || _lhc <= 0) continue;\n          const _lrDefNote = _lhnc <= 0 ? ' **(defeated)**' : '';\n          _lrDamaged.push(`${dcMessageMeta.get(_lfkMsgId)?.displayName || _lfkMatch[1]} (HP: ${_lhc}\u2192${_lhnc})${_lrDefNote}`);\n          if (_lhnc <= 0) _lrDefeated.push({ figureKey: _lfk\x2C playerNum: pn });\n        }\n      }\n      _lrResultLog += _lrDamaged.length ? _lrDamaged.join('\x2C ') : 'No adjacent figures.';\n    } else {\n      _lrResultLog += 'No hits.';\n    }\n    await logGameAction(_lrGame\x2C client\x2C `**Last Resort** \u2014 ${_lrCombat?.target?.label || 'Figure'}: ${_lrResultLog}`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n    // Process defeats of figures damaged by the explosion\n    for (const _lrDf of _lrDefeated) {\n      if (processFigureDefeat) {\n        await processFigureDefeat(_lrGame\x2C {\n          defeatedPlayerNum: _lrDf.playerNum\x2C\n          figureKey: _lrDf.figureKey\x2C\n          attackerPlayerNum: opponentPlayerNum(_lrDf.playerNum)\x2C\n          source: 'Last Resort'\x2C\n        });\n      }\n    }\n  } else {\n    await logGameAction(_lrGame\x2C client\x2C `**Last Resort** \u2014 Skipped.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  }\n  // Finalize defeat by re-calling applyDamageAndFinishCombat (lastResortTriggered flag already set)\n  await applyDamageAndFinishCombat(_lrGame\x2C _lrCombat\x2C {\n    damage: _lrPending.damage\x2C hit: _lrPending.hit\x2C resultText: _lrPending.resultText\x2C\n    totalBlast: _lrPending.totalBlast\x2C defenderPlayerNum: _lrPending.defenderPlayerNum\x2C\n    attackerPlayerNum: _lrPending.attackerPlayerNum\x2C ownerId: _lrPending.ownerId\x2C\n    targetMsgId: _lrPending.targetMsgId\x2C targetFigIndex: _lrPending.targetFigIndex\x2C\n  }\x2C client);\n  saveGames(); return;\n}\n\n// \u2500\u2500 7. Scavenged Walker \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nexport async function handleScavengedWalker(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C dcMessageMeta\x2C logGameAction } = ctx;\n  const buttonKey = interaction.customId.startsWith('scavenged_walker_attack_') ? 'scavenged_walker_attack_' : 'scavenged_walker_skip_';\n\n  await interaction.deferUpdate().catch(discordCatch);\n  const _swSuffix = parseCustomId(interaction.customId\x2C buttonKey);\n  const _swParts = _swSuffix.split('_');\n  const _swGameId = _swParts[0]; const _swMsgId = _swParts[1];\n  const _swGame = await requireGame(interaction\x2C getGame\x2C _swGameId);\n  if (!_swGame) return;\n  const _swMeta = dcMessageMeta.get(_swMsgId);\n  if (!_swMeta) { await interaction.followUp({ content: 'DC not found.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  if (!await requirePlayer(interaction\x2C _swGame\x2C interaction.user.id\x2C _swMeta.playerNum\x2C canActAsPlayer\x2C 'Only the DC owner may respond.')) return;\n  if (buttonKey === 'scavenged_walker_attack_') {\n    // Set -1 Hit penalty flag for the next attack from this DC\n    _swGame.scavengedWalkerAttackPenalty = _swGame.scavengedWalkerAttackPenalty || {};\n    _swGame.scavengedWalkerAttackPenalty[_swMsgId] = true;\n    await logGameAction(_swGame\x2C client\x2C `**Scavenged Walker** \u2014 **${_swMeta.displayName || _swMeta.dcName}** will perform an interrupt attack with -1 Hit. Use the Attack button.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  } else {\n    await logGameAction(_swGame\x2C client\x2C `**Scavenged Walker** \u2014 **${_swMeta.displayName || _swMeta.dcName}** skipped end-of-round attack.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  }\n  saveGames(); return;\n}\n\n// \u2500\u2500 8. On a Diplomatic Mission \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nexport async function handleOnDiplomatic(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C dcMessageMeta\x2C logGameAction\x2C checkWinConditions } = ctx;\n\n  await interaction.deferUpdate().catch(discordCatch);\n  const _odmSuffix = parseCustomId(interaction.customId\x2C 'on_diplomatic_');\n  const _odmParts = _odmSuffix.split('_');\n  const _odmGameId = _odmParts[0]; const _odmMsgId = _odmParts[1]; const _odmChoice = _odmParts[2];\n  const _odmGame = await requireGame(interaction\x2C getGame\x2C _odmGameId);\n  if (!_odmGame) return;\n  const _odmMeta = dcMessageMeta.get(_odmMsgId);\n  if (!_odmMeta) {\n    await interaction.followUp({ content: 'DC not found.'\x2C ephemeral: true }).catch(discordCatch); return;\n  }\n  if (!await requirePlayer(interaction\x2C _odmGame\x2C interaction.user.id\x2C _odmMeta.playerNum\x2C canActAsPlayer\x2C 'Only the DC owner may respond.')) return;\n  if (_odmChoice === 'skip') {\n    await logGameAction(_odmGame\x2C client\x2C '**On a Diplomatic Mission** \u2014 Skipped.'\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  } else {\n    // Exhaust the card\n    _odmGame.exhaustedSkirmishUpgrades = _odmGame.exhaustedSkirmishUpgrades || {};\n    _odmGame.exhaustedSkirmishUpgrades[_odmMsgId] = [...(_odmGame.exhaustedSkirmishUpgrades[_odmMsgId] || [])\x2C 'On a Diplomatic Mission'];\n    if (_odmChoice === 'mp') {\n      grantMovementBank(_odmGame\x2C _odmMsgId\x2C 2);\n      await logGameAction(_odmGame\x2C client\x2C `**On a Diplomatic Mission** \u2014 **${_odmMeta.displayName || _odmMeta.dcName}** gains 2 MP.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n    } else if (_odmChoice === 'evade') {\n      _odmGame.diplomaticMissionEvade = _odmGame.diplomaticMissionEvade || {};\n      _odmGame.diplomaticMissionEvade[_odmMsgId] = true;\n      await logGameAction(_odmGame\x2C client\x2C `**On a Diplomatic Mission** \u2014 **${_odmMeta.displayName || _odmMeta.dcName}** gains +1 Evade on defense for the rest of the round.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n    } else if (_odmChoice === 'vp') {\n      awardObjectiveVp(_odmGame\x2C _odmMeta.playerNum\x2C 1);\n      await logGameAction(_odmGame\x2C client\x2C `**On a Diplomatic Mission** \u2014 **${_odmMeta.displayName || _odmMeta.dcName}** gains 1 VP.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n      await checkWinConditions(_odmGame\x2C client);\n    }\n  }\n  saveGames(); return;\n}\n\n// \u2500\u2500 9. Behind Enemy Lines (Bel Reorder) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nexport async function handleBelReorder(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C logGameAction } = ctx;\n  const buttonKey = interaction.customId.startsWith('bel_reorder_1_') ? 'bel_reorder_1_' : 'bel_reorder_2_';\n\n  const _belParts = splitCustomId(interaction.customId\x2C buttonKey);\n  const _belGameId = _belParts[0]; const _belCardIdx = parseInt(_belParts[1]\x2C 10);\n  const _belGame = await requireGame(interaction\x2C getGame\x2C _belGameId\x2C { silent: true });\n  if (!_belGame) return;\n  if (!_belGame.pendingBELReorder) { await interaction.followUp({ content: 'No pending deck reorder.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  const _belData = _belGame.pendingBELReorder;\n  if (!await requirePlayer(interaction\x2C _belGame\x2C interaction.user.id\x2C _belData.playerNum\x2C canActAsPlayer\x2C 'Only the card owner may reorder.')) return;\n  if (buttonKey === 'bel_reorder_1_') {\n    _belData.picked = [_belCardIdx];\n    const _belRem = _belData.cards.filter((_\x2C i) => i !== _belCardIdx);\n    const _belBtns2 = _belRem.map((c\x2C i) => {\n      const _origIdx = _belData.cards.indexOf(c);\n      return new ButtonBuilder().setCustomId(`bel_reorder_2_${_belGameId}_${_origIdx}`).setLabel(`2nd: ${c}`.slice(0\x2C 80)).setStyle(ButtonStyle.Primary);\n    });\n    const _belHandId = _belData.playerNum === 1 ? _belGame.p1HandId : _belGame.p2HandId;\n    const _belHandCh2 = await fetchGameChannel(client\x2C _belHandId);\n    if (_belHandCh2) await _belHandCh2.send({ content: `**Behind Enemy Lines** \u2014 **${_belData.cards[_belCardIdx]}** goes 1st. Choose 2nd card:`\x2C components: [new ActionRowBuilder().addComponents(..._belBtns2.slice(0\x2C 5))] }).catch(discordCatch);\n    saveGames(); return;\n  }\n  // bel_reorder_2_: finalize order\n  const _belFirst = _belData.picked[0];\n  const _belSecond = _belCardIdx;\n  const _belThird = _belData.cards.findIndex((_\x2C i) => i !== _belFirst && i !== _belSecond);\n  const _belNewOrder = [_belData.cards[_belFirst]\x2C _belData.cards[_belSecond]\x2C _belData.cards[_belThird]];\n  const _belDeck = _belGame[_belData.deckKey] || [];\n  _belGame[_belData.deckKey] = [..._belNewOrder\x2C ..._belDeck.slice(_belData.cards.length)];\n  _belGame.pendingBELReorder = null;\n  await logGameAction(_belGame\x2C client\x2C `**Behind Enemy Lines** \u2014 Opponent's deck top 3 reordered to: ${_belNewOrder.map(c => `**${c}**`).join('\x2C ')}.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  saveGames(); return;\n}\n\n// \u2500\u2500 10. Assassin's Blade pick \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// NEW PREFIX: ab_blade_pick_ \u2014 add to router.js\nexport async function handleAssassinsBladePickTarget(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C dcMessageMeta\x2C dcHealthState\x2C logGameAction\x2C processFigureDefeat } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  // ab_blade_pick_{gameId}_{figureKey}\n  const suffix = parseCustomId(interaction.customId\x2C 'ab_blade_pick_');\n  const parts = suffix.split('_');\n  const gameId = parts[0];\n  const figureKey = parts.slice(1).join('_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const pending = game.pendingAssassinsBlade;\n  if (!pending) { await interaction.followUp({ content: 'No pending Assassin\\'s Blade.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  const { hits\x2C rollStr\x2C defenderPlayerNum\x2C attackerPlayerNum } = pending;\n  if (canActAsPlayer && !canActAsPlayer(game\x2C interaction.user.id\x2C attackerPlayerNum)) {\n    await interaction.followUp({ content: 'Only the attacker can pick the target.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  delete game.pendingAssassinsBlade;\n  const dcName = dcNameFromFigureKey(figureKey);\n  // Find the DC message for this figure and apply damage\n  let _abNewHp = null;\n  for (const [msgId\x2C meta] of dcMessageMeta) {\n    if (meta.gameId !== gameId || meta.playerNum !== defenderPlayerNum || meta.dcName !== dcName) continue;\n    const figIdx = parseFigureKey(figureKey).figureIndex;\n    const result = reduceHp(dcHealthState\x2C game\x2C msgId\x2C figIdx\x2C hits\x2C defenderPlayerNum);\n    _abNewHp = result.newHp;\n    break;\n  }\n  const _abDefNote = (_abNewHp !== null && _abNewHp <= 0) ? ' **(defeated)**' : '';\n  await interaction.message.edit({ content: `\ud83d\udde1\ufe0f **Assassin's Blade** \u2014 Rolled 1 red die: **${rollStr}**. **${dcName}** suffers **${hits} Damage**${_abDefNote}.`\x2C components: [] }).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `\ud83d\udde1\ufe0f **Assassin's Blade** \u2014 **${dcName}** suffers **${hits} Damage**${_abDefNote}.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  if (_abNewHp !== null && _abNewHp <= 0 && processFigureDefeat) {\n    await processFigureDefeat(game\x2C {\n      defeatedPlayerNum: defenderPlayerNum\x2C\n      figureKey: figureKey\x2C\n      attackerPlayerNum: attackerPlayerNum\x2C\n      source: "Assassin's Blade"\x2C\n    });\n  }\n  saveGames(); return;\n}\n\n// \u2500\u2500 11. Suppressive Fire MP pick \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// NEW PREFIX: sf_mp_pick_ \u2014 add to router.js\nexport async function handleSuppressiveFireMpPick(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C dcMessageMeta\x2C logGameAction } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  // sf_mp_pick_{gameId}_{figureKey}\n  const suffix = parseCustomId(interaction.customId\x2C 'sf_mp_pick_');\n  const parts = suffix.split('_');\n  const gameId = parts[0];\n  const figureKey = parts.slice(1).join('_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const pending = game.pendingSuppressiveFireMp;\n  if (!pending) { await interaction.followUp({ content: 'No pending Suppressive Fire MP.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  const { attackerPlayerNum } = pending;\n  delete game.pendingSuppressiveFireMp;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C attackerPlayerNum\x2C canActAsPlayer\x2C 'Only the attacker may choose.')) return;\n  const dcName = dcNameFromFigureKey(figureKey);\n  // Find the msgId for this figure\n  let targetMsgId = null;\n  for (const [msgId\x2C meta] of dcMessageMeta) {\n    if (meta.gameId !== gameId || meta.playerNum !== attackerPlayerNum || meta.dcName !== dcName) continue;\n    targetMsgId = msgId;\n    break;\n  }\n  if (!targetMsgId) { await interaction.followUp({ content: 'Could not find DC for this figure.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  grantMovementBank(game\x2C targetMsgId\x2C 2);\n  await interaction.message.edit({ content: `**Suppressive Fire** \u2014 **${dcName}** gains **2 MP**.`\x2C components: [] }).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `**Suppressive Fire** \u2014 **${dcName}** gains 2 MP.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  saveGames(); return;\n}\n\n// \u2500\u2500 12. Force Slow pick \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// NEW PREFIX: force_slow_pick_ \u2014 add to router.js\nexport async function handleForceSlowPick(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C logGameAction } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  // force_slow_pick_{gameId}_{playerNum}_{figureKey}\n  const suffix = parseCustomId(interaction.customId\x2C 'force_slow_pick_');\n  const parts = suffix.split('_');\n  const gameId = parts[0];\n  const ownerPlayerNum = parseInt(parts[1]\x2C 10);\n  const figureKey = parts.slice(2).join('_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C ownerPlayerNum\x2C canActAsPlayer\x2C 'Only the DC owner may choose.')) return;\n  game.forceSlowSkipActivation = game.forceSlowSkipActivation || {};\n  game.forceSlowSkipActivation[figureKey] = true;\n  const dcName = dcNameFromFigureKey(figureKey);\n  await interaction.message.edit({ content: `\ud83d\udc0c **Force Slow** \u2014 **${dcName}** will skip its next activation.`\x2C components: [] }).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `\ud83d\udc0c **Force Slow** \u2014 **${dcName}** will skip its next activation.`\x2C { phase: 'ROUND'\x2C icon: 'round' });\n  await resolveStartOfRoundEffect(game\x2C ctx);\n  saveGames(); return;\n}\n\n// \u2500\u2500 13. Excavation pick \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// NEW PREFIX: excavation_pick_ \u2014 add to router.js\nexport async function handleExcavationPick(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C logGameAction\x2C updateHandChannelMessages } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  // excavation_pick_{gameId}_{playerNum}_{cardIndex}\n  const suffix = parseCustomId(interaction.customId\x2C 'excavation_pick_');\n  const parts = suffix.split('_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const cardIndex = parseInt(parts[2]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the DC owner may choose.')) return;\n  // Rest in Peace: block discard-pile retrieval\n  if (game.restInPeaceActive) {\n    await interaction.message.edit({ content: '**Excavation** \u2014 Blocked by **Rest in Peace** (cannot retrieve from discard piles this round).'\x2C components: [] }).catch(discordCatch);\n    return;\n  }\n  const discardKey = ccDiscardKey(playerNum);\n  const handKey = ccHandKey(playerNum);\n  const discard = game[discardKey] || [];\n  if (cardIndex < 0 || cardIndex >= discard.length) {\n    await interaction.followUp({ content: 'Invalid card selection.'\x2C ephemeral: true }).catch(discordCatch); return;\n  }\n  const cardName = discard[cardIndex];\n  // Move card from discard to hand\n  game[discardKey] = discard.filter((_\x2C i) => i !== cardIndex);\n  game[handKey] = game[handKey] || [];\n  game[handKey].push(cardName);\n  await interaction.message.edit({ content: `\u26cf\ufe0f **Excavation** \u2014 **${cardName}** moved from discard to hand.`\x2C components: [] }).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `\u26cf\ufe0f **Excavation** \u2014 retrieved **${cardName}** from discard pile.`\x2C { phase: 'ROUND'\x2C icon: 'round' });\n  if (updateHandChannelMessages) await updateHandChannelMessages(game\x2C client);\n  await resolveStartOfRoundEffect(game\x2C ctx);\n  saveGames(); return;\n}\n\n// \u2500\u2500 14. Driven by Hatred (Darth Vader EOR) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nexport async function handleDrivenByHatred(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C dcMessageMeta\x2C logGameAction } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n\n  // Determine which button was pressed\n  let buttonKey;\n  if (interaction.customId.startsWith('dbh_force_choke_')) buttonKey = 'dbh_force_choke_';\n  else if (interaction.customId.startsWith('dbh_attack_')) buttonKey = 'dbh_attack_';\n  else buttonKey = 'dbh_skip_';\n\n  const _dbhSuffix = parseCustomId(interaction.customId\x2C buttonKey);\n  const _dbhParts = _dbhSuffix.split('_');\n  const _dbhGameId = _dbhParts[0]; const _dbhMsgId = _dbhParts[1];\n  const _dbhGame = await requireGame(interaction\x2C getGame\x2C _dbhGameId);\n  if (!_dbhGame) return;\n  const _dbhMeta = dcMessageMeta.get(_dbhMsgId);\n  if (!_dbhMeta) { await interaction.followUp({ content: 'DC not found.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  if (!await requirePlayer(interaction\x2C _dbhGame\x2C interaction.user.id\x2C _dbhMeta.playerNum\x2C canActAsPlayer\x2C 'Only the DC owner may respond.')) return;\n\n  const _dbhDisplayName = _dbhMeta.displayName || _dbhMeta.dcName;\n\n  if (buttonKey === 'dbh_skip_') {\n    await logGameAction(_dbhGame\x2C client\x2C `**Driven by Hatred** \u2014 **${_dbhDisplayName}** skipped end-of-round move + attack.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  } else {\n    // Grant 2 MP for movement\n    grantMovementBank(_dbhGame\x2C _dbhMsgId\x2C 2);\n\n    if (buttonKey === 'dbh_force_choke_') {\n      // Flag that Vader should use Force Choke after moving (manual resolution \u2014 player uses Force Choke special action button)\n      _dbhGame.drivenByHatredForceChoke = _dbhGame.drivenByHatredForceChoke || {};\n      _dbhGame.drivenByHatredForceChoke[_dbhMsgId] = true;\n      await logGameAction(_dbhGame\x2C client\x2C `**Driven by Hatred** \u2014 **${_dbhDisplayName}** gains 2 MP. After moving\x2C use the **Force Choke** special action button.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n    } else {\n      // dbh_attack_: Grant free attack with -1 die (remove weakest die from pool)\n      _dbhGame.drivenByHatredAttackPenalty = _dbhGame.drivenByHatredAttackPenalty || {};\n      _dbhGame.drivenByHatredAttackPenalty[_dbhMsgId] = true;\n      _dbhGame.freeAttackBonusPending = _dbhGame.freeAttackBonusPending || {};\n      _dbhGame.freeAttackBonusPending[_dbhMsgId] = true;\n      await logGameAction(_dbhGame\x2C client\x2C `**Driven by Hatred** \u2014 **${_dbhDisplayName}** gains 2 MP. After moving\x2C use the **Attack** button (1 die will be removed from the attack pool).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n    }\n  }\n  saveGames(); return;\n}\n\n// \u2500\u2500 Submit or Fight (Paz Vizsla) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nexport async function handleSubmitOrFight(interaction\x2C ctx) {\n  await interaction.deferUpdate().catch(discordCatch);\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C dcMessageMeta\x2C dcHealthState\x2C logGameAction } = ctx;\n  const isUse = interaction.customId.startsWith('submit_fight_use_');\n  const prefix = isUse ? 'submit_fight_use_' : 'submit_fight_skip_';\n  const suffix = parseCustomId(interaction.customId\x2C prefix);\n  const parts = suffix.split('_');\n  const gameId = parts[0];\n  const figureIndex = parseInt(parts[parts.length - 1]\x2C 10);\n  const msgId = parts.slice(1\x2C -1).join('_');\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  const meta = dcMessageMeta?.get(msgId);\n\n  if (isUse) {\n    const playerNum = meta?.playerNum || (game.player1Id === interaction.user.id ? 1 : 2);\n    if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the DC owner may respond.')) return;\n    // Rest in Peace: block discard-pile access\n    if (game.restInPeaceActive) {\n      await interaction.message.edit({ content: '**Submit or Fight** \u2014 Blocked by **Rest in Peace** (cannot access discard piles this round).'\x2C components: [] }).catch(discordCatch);\n      return;\n    }\n    const discardKey = `p${playerNum}CcDiscard`;\n    const discard = game[discardKey] || [];\n    if (discard.length === 0) {\n      await interaction.followUp({ content: 'No CCs in discard pile.'\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n    // Return last CC from discard to game box (permanently removed)\n    const returnedCc = discard.pop();\n    // Heal 1 HP (reverse the strain damage) \u2014 uses healHp for Map+dcList sync\n    if (dcHealthState) healHp(dcHealthState\x2C game\x2C msgId\x2C figureIndex\x2C 1\x2C playerNum);\n    const dcName = meta?.dcName || 'Paz Vizsla';\n    await interaction.message.edit({ content: `\ud83d\udee1\ufe0f **Submit or Fight** \u2014 **${dcName}** returned **${returnedCc}** to game box to heal 1 Strain damage.`\x2C components: [] }).catch(discordCatch);\n    if (logGameAction) {\n      await logGameAction(game\x2C client\x2C `\ud83d\udee1\ufe0f **Submit or Fight** \u2014 **${dcName}** returned **${returnedCc}** to prevent Strain damage.`\x2C { phase: 'ROUND'\x2C icon: 'defend' });\n    }\n  } else {\n    await interaction.message.edit({ content: '**Submit or Fight** \u2014 Skipped.'\x2C components: [] }).catch(discordCatch);\n  }\n  saveGames();\n}\n\n// \u2500\u2500 [Black Market] SU \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n/**\n * Handle [Black Market] EOR choices: draw (spend VP)\x2C discard (gain VP)\x2C return to top\x2C or skip.\n * Buttons: bm_draw_\x2C bm_discard_\x2C bm_return_\x2C bm_skip_\n */\nexport async function handleBlackMarket(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C dcHealthState\x2C dcMessageMeta\x2C logGameAction\x2C checkWinConditions\x2C processFigureDefeat } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n\n  // Parse customId: bm_{choice}_{gameId}_{msgId}_{playerNum}\n  const _bmPrefixes = ['bm_draw_'\x2C 'bm_discard_'\x2C 'bm_return_'\x2C 'bm_skip_'];\n  const _bmPrefix = _bmPrefixes.find(p => interaction.customId.startsWith(p));\n  if (!_bmPrefix) return;\n  const _bmChoice = _bmPrefix.replace('bm_'\x2C '').replace(/_$/\x2C ''); // draw | discard | return | skip\n  const _bmSuffix = parseCustomId(interaction.customId\x2C _bmPrefix);\n  const _bmParts = _bmSuffix.split('_');\n  const _bmGameId = _bmParts[0];\n  const _bmMsgId = _bmParts[1];\n  const _bmPn = parseInt(_bmParts[2]\x2C 10);\n\n  const game = await requireGame(interaction\x2C getGame\x2C _bmGameId);\n  if (!game) return;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C _bmPn\x2C canActAsPlayer\x2C 'Only the card owner may respond.')) return;\n\n  const pending = game.pendingBlackMarket?.[_bmPn];\n  if (!pending) {\n    await interaction.followUp({ content: '[Black Market] \u2014 No pending choice found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const { topCard\x2C cardCost\x2C smugglerFk\x2C smugglerMsgId\x2C smugglerFigIdx } = pending;\n  const smugglerName = dcNameFromFigureKey(smugglerFk);\n  const deckKey = _bmPn === 1 ? 'player1CcDeck' : 'player2CcDeck';\n\n  if (_bmChoice === 'skip') {\n    delete game.pendingBlackMarket[_bmPn];\n    await interaction.message.edit({ content: '**[Black Market]** \u2014 Skipped. No Strain suffered.'\x2C components: [] }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n\n  // Apply 1 Strain (= 1 HP damage) to the SMUGGLER via canonical reduceHp path\n  const { prevHp: _bmPrevHp\x2C newHp: _bmNewHp } = reduceHp(dcHealthState\x2C game\x2C smugglerMsgId\x2C smugglerFigIdx\x2C 1\x2C _bmPn);\n  const _bmDefeatNote = _bmNewHp <= 0 ? ' **(defeated)**' : '';\n  if (_bmNewHp <= 0 && processFigureDefeat) {\n    await processFigureDefeat(game\x2C {\n      defeatedPlayerNum: _bmPn\x2C\n      figureKey: smugglerFk\x2C\n      attackerPlayerNum: opponentPlayerNum(_bmPn)\x2C\n      source: 'Black Market strain'\x2C\n    });\n  }\n\n  // Remove top card from deck (it was only peeked before)\n  const deck = game[deckKey] || [];\n  if (deck.length > 0 && deck[0] === topCard) {\n    deck.shift();\n  }\n\n  let resultMsg = '';\n  if (_bmChoice === 'draw') {\n    // Spend VP equal to cost\x2C draw the card\n    if (cardCost > 0) {\n      deductVp(game\x2C _bmPn\x2C cardCost);\n    }\n    const handKey = _bmPn === 1 ? 'player1CcHand' : 'player2CcHand';\n    game[handKey] = [...(game[handKey] || [])\x2C topCard];\n    resultMsg = `Drew **${topCard}** (spent ${cardCost} VP). **${smugglerName}** suffered 1 Strain (HP: ${_bmPrevHp}\u2192${_bmNewHp})${_bmDefeatNote}.`;\n  } else if (_bmChoice === 'discard') {\n    // Discard the card\x2C gain VP equal to cost\n    const discardKey = _bmPn === 1 ? 'player1CcDiscard' : 'player2CcDiscard';\n    game[discardKey] = [...(game[discardKey] || [])\x2C topCard];\n    if (cardCost > 0) {\n      awardObjectiveVp(game\x2C _bmPn\x2C cardCost);\n    }\n    resultMsg = `Discarded **${topCard}** (gained ${cardCost} VP). **${smugglerName}** suffered 1 Strain (HP: ${_bmPrevHp}\u2192${_bmNewHp})${_bmDefeatNote}.`;\n  } else if (_bmChoice === 'return') {\n    // Return card to top of deck (put it back)\n    deck.unshift(topCard);\n    resultMsg = `Returned **${topCard}** to top of deck. **${smugglerName}** suffered 1 Strain (HP: ${_bmPrevHp}\u2192${_bmNewHp})${_bmDefeatNote}.`;\n  }\n\n  delete game.pendingBlackMarket[_bmPn];\n  await interaction.message.edit({ content: `**[Black Market]** \u2014 ${resultMsg}`\x2C components: [] }).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `**[Black Market]** \u2014 ${resultMsg}`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  await checkWinConditions(game\x2C client);\n  saveGames();\n}\n\n// \u2500\u2500 Punishing Strike (Skirmish Upgrade) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// ps_replace_{gameId}_{targetFigureKey}_{originalCondition}_{newCondition|skip}\nexport async function handlePunishingStrike(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C logGameAction } = ctx;\n  const m = interaction.customId.match(/^ps_replace_([^_]+)_(.+?)_(Stun|Bleed|Weaken)_(Stun|Bleed|Weaken|skip)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C targetFigureKey\x2C originalCondition\x2C choice] = m;\n  const game = getGame(gameId);\n  if (!game) return;\n  const pending = game.pendingPunishingStrike;\n  if (!pending) {\n    await interaction.message.edit({ content: '**Punishing Strike** \u2014 No longer pending.'\x2C components: [] }).catch(discordCatch);\n    return;\n  }\n  const attackerPn = pending.attackerPlayerNum;\n  const playerId = getPlayerId(game\x2C attackerPn);\n  if (!canActAsPlayer(game\x2C interaction.user.id\x2C attackerPn)) {\n    await interaction.reply({ content: 'Only the attacker\\'s player can choose.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  if (choice === 'skip') {\n    delete game.pendingPunishingStrike;\n    await interaction.message.edit({ content: `**Punishing Strike** \u2014 Skipped. **${originalCondition}** remains on **${dcNameFromFigureKey(targetFigureKey)}**.`\x2C components: [] }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n\n  // Exhaust Punishing Strike\n  const _psExhKey = `ps_army_p${attackerPn}`;\n  game.exhaustedSkirmishUpgrades = game.exhaustedSkirmishUpgrades || {};\n  game.exhaustedSkirmishUpgrades[_psExhKey] = [...(game.exhaustedSkirmishUpgrades[_psExhKey] || [])\x2C 'Punishing Strike'];\n\n  // Remove original condition\x2C apply new one\n  filterCondition(game\x2C targetFigureKey\x2C originalCondition);\n  applyCondition(game\x2C targetFigureKey\x2C choice);\n\n  const targetName = dcNameFromFigureKey(targetFigureKey);\n  delete game.pendingPunishingStrike;\n  await interaction.message.edit({ content: `**Punishing Strike** \u2014 Exhausted: replaced **${originalCondition}** with **${choice}** on **${targetName}**.`\x2C components: [] }).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `**[Punishing Strike]** \u2014 Replaced **${originalCondition}** with **${choice}** on **${targetName}**.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  saveGames();\n}\n\n// \u2500\u2500 Executor (Royal Guard Champion) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// When a friendly figure within 3 spaces is defeated\x2C RGC may interrupt to\n// move up to 2 spaces and then perform an attack. Limit once per round.\nexport async function handleExecutor(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C dcMessageMeta\x2C logGameAction\x2C applyDamageAndFinishCombat } = ctx;\n  const buttonKey = interaction.customId.startsWith('executor_use_') ? 'executor_use_' : 'executor_skip_';\n\n  await interaction.deferUpdate().catch(discordCatch);\n  const _exSuffix = parseCustomId(interaction.customId\x2C buttonKey);\n  const _exParts = _exSuffix.split('_');\n  const _exGameId = _exParts[0];\n  const _exRgcMsgId = _exParts[1];\n  const _exGame = await requireGame(interaction\x2C getGame\x2C _exGameId\x2C { silent: true });\n  if (!_exGame) return;\n  if (!_exGame.pendingExecutorInterrupt) {\n    await interaction.followUp({ content: 'No pending Executor interrupt.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const _exPending = _exGame.pendingExecutorInterrupt;\n  if (!await requirePlayer(interaction\x2C _exGame\x2C interaction.user.id\x2C _exPending.rgcPlayerNum\x2C canActAsPlayer\x2C 'Only the RGC owner may respond.')) return;\n  delete _exGame.pendingExecutorInterrupt;\n  const _exCombat = _exGame.pendingCombat;\n\n  if (buttonKey === 'executor_use_') {\n    // Mark once-per-round usage\n    _exGame.roundFigureAbilityUsed = _exGame.roundFigureAbilityUsed || {};\n    _exGame.roundFigureAbilityUsed[`${_exPending.rgcFigKey}_executor`] = true;\n\n    // Grant 2 free movement points to RGC\n    _exGame.movementBank = _exGame.movementBank || {};\n    if (!_exGame.movementBank[_exPending.rgcMsgId]) {\n      _exGame.movementBank[_exPending.rgcMsgId] = { total: 2\x2C remaining: 2\x2C threadId: null\x2C messageId: null\x2C displayName: _exPending.rgcDcName };\n    } else {\n      _exGame.movementBank[_exPending.rgcMsgId].total = (_exGame.movementBank[_exPending.rgcMsgId].total || 0) + 2;\n      _exGame.movementBank[_exPending.rgcMsgId].remaining = (_exGame.movementBank[_exPending.rgcMsgId].remaining || 0) + 2;\n    }\n\n    // Grant free attack (next attack costs no action)\n    _exGame.freeAttackBonusPending = _exGame.freeAttackBonusPending || {};\n    _exGame.freeAttackBonusPending[_exPending.rgcMsgId] = true;\n\n    await logGameAction(_exGame\x2C client\x2C `**Executor** \u2014 **${_exPending.rgcDcName}** gains 2 MP and a free attack (friendly **${_exPending.defeatedLabel}** defeated). Use Move/Attack buttons on the DC.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  } else {\n    await logGameAction(_exGame\x2C client\x2C `**Executor** \u2014 Skipped.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  }\n\n  // Finalize defeat by re-calling applyDamageAndFinishCombat (executorTriggered flag already set)\n  await applyDamageAndFinishCombat(_exGame\x2C _exCombat\x2C {\n    damage: _exPending.damage\x2C hit: _exPending.hit\x2C resultText: _exPending.resultText\x2C\n    totalBlast: _exPending.totalBlast\x2C defenderPlayerNum: _exPending.defenderPlayerNum\x2C\n    attackerPlayerNum: _exPending.attackerPlayerNum\x2C ownerId: _exPending.ownerId\x2C\n    targetMsgId: _exPending.targetMsgId\x2C targetFigIndex: _exPending.targetFigIndex\x2C\n  }\x2C client);\n  saveGames();\n  return;\n}\n\n// \u2500\u2500 Extra Protection (Onar Koma CC) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// When another friendly figure within 2 spaces suffers 3+ Damage from an attack\x2C\n// Onar may play Extra Protection to move up to 2 spaces and perform an attack.\nexport async function handleExtraProtection(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C logGameAction\x2C applyDamageAndFinishCombat } = ctx;\n  const isPlay = interaction.customId.startsWith('extra_protection_play_');\n  const buttonKey = isPlay ? 'extra_protection_play_' : 'extra_protection_skip_';\n\n  await interaction.deferUpdate().catch(discordCatch);\n  const _epGameId = parseCustomId(interaction.customId\x2C buttonKey);\n  const _epGame = await requireGame(interaction\x2C getGame\x2C _epGameId\x2C { silent: true });\n  if (!_epGame) return;\n  if (!_epGame.pendingExtraProtection) {\n    await interaction.followUp({ content: 'No pending Extra Protection prompt.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const _epPending = _epGame.pendingExtraProtection;\n  if (!await requirePlayer(interaction\x2C _epGame\x2C interaction.user.id\x2C _epPending.playerNum\x2C canActAsPlayer\x2C 'Only the defending player may respond.')) return;\n  delete _epGame.pendingExtraProtection;\n  const _epCombat = _epGame.pendingCombat;\n\n  if (isPlay) {\n    // Remove Extra Protection from hand\x2C add to discard\n    const _epHandKey = _epPending.playerNum === 1 ? 'player1CcHand' : 'player2CcHand';\n    const _epDiscardKey = _epPending.playerNum === 1 ? 'player1CcDiscard' : 'player2CcDiscard';\n    const _epHand = _epGame[_epHandKey] || [];\n    const _epIdx = _epHand.indexOf('Extra Protection');\n    if (_epIdx >= 0) _epHand.splice(_epIdx\x2C 1);\n    _epGame[_epDiscardKey] = _epGame[_epDiscardKey] || [];\n    _epGame[_epDiscardKey].push('Extra Protection');\n\n    // Grant 2 free movement points to Onar Koma\n    _epGame.movementBank = _epGame.movementBank || {};\n    if (!_epGame.movementBank[_epPending.onarMsgId]) {\n      _epGame.movementBank[_epPending.onarMsgId] = { total: 2\x2C remaining: 2\x2C threadId: null\x2C messageId: null\x2C displayName: _epPending.onarDcName };\n    } else {\n      _epGame.movementBank[_epPending.onarMsgId].total = (_epGame.movementBank[_epPending.onarMsgId].total || 0) + 2;\n      _epGame.movementBank[_epPending.onarMsgId].remaining = (_epGame.movementBank[_epPending.onarMsgId].remaining || 0) + 2;\n    }\n\n    // Grant free attack (next attack costs no action)\n    _epGame.freeAttackBonusPending = _epGame.freeAttackBonusPending || {};\n    _epGame.freeAttackBonusPending[_epPending.onarMsgId] = true;\n\n    await logGameAction(_epGame\x2C client\x2C `**Extra Protection** \u2014 **${_epPending.onarDcName}** plays Extra Protection! Gains 2 MP and a free attack. Use Move/Attack buttons on the DC.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  } else {\n    await logGameAction(_epGame\x2C client\x2C `**Extra Protection** \u2014 Skipped.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  }\n\n  // Continue post-combat flow by re-calling applyDamageAndFinishCombat\n  // (extraProtectionTriggeredThisCombat flag prevents re-trigger)\n  await applyDamageAndFinishCombat(_epGame\x2C _epCombat\x2C {\n    damage: _epPending.damage\x2C hit: _epPending.hit\x2C resultText: _epPending.resultText\x2C\n    totalBlast: _epPending.totalBlast\x2C defenderPlayerNum: _epPending.defenderPlayerNum\x2C\n    attackerPlayerNum: _epPending.attackerPlayerNum\x2C ownerId: _epPending.ownerId\x2C\n    targetMsgId: _epPending.targetMsgId\x2C targetFigIndex: _epPending.targetFigIndex\x2C\n  }\x2C client);\n  saveGames();\n  return;\n}\n
