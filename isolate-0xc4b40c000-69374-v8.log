script-source,414,node:internal/file,'use strict';\n\nconst {\n  DateNow\x2C\n  FunctionPrototypeCall\x2C\n  NumberIsNaN\x2C\n  ObjectDefineProperties\x2C\n  ObjectSetPrototypeOf\x2C\n  StringPrototypeToWellFormed\x2C\n  Symbol\x2C\n  SymbolToStringTag\x2C\n} = primordials;\n\nconst {\n  Blob\x2C\n  TransferableBlob\x2C\n} = require('internal/blob');\n\nconst {\n  customInspectSymbol: kInspect\x2C\n  kEnumerableProperty\x2C\n  kEmptyObject\x2C\n} = require('internal/util');\n\nconst {\n  codes: {\n    ERR_INVALID_THIS\x2C\n    ERR_MISSING_ARGS\x2C\n  }\x2C\n} = require('internal/errors');\n\nconst {\n  inspect\x2C\n} = require('internal/util/inspect');\n\nconst {\n  kClone\x2C\n  kDeserialize\x2C\n} = require('internal/worker/js_transferable');\n\nconst kState = Symbol('state');\n\nfunction isFile(object) {\n  return object?.[kState] !== undefined;\n}\n\nclass FileState {\n  name;\n  lastModified;\n\n  /**\n   * @param {string} name\n   * @param {number} lastModified\n   */\n  constructor(name\x2C lastModified) {\n    this.name = name;\n    this.lastModified = lastModified;\n  }\n}\n\nclass File extends Blob {\n  constructor(fileBits\x2C fileName\x2C options = kEmptyObject) {\n    if (arguments.length < 2) {\n      throw new ERR_MISSING_ARGS('fileBits'\x2C 'fileName');\n    }\n\n    super(fileBits\x2C options);\n\n    let { lastModified } = options ?? kEmptyObject;\n\n    if (lastModified !== undefined) {\n      // Using Number(...) will not throw an error for bigints.\n      lastModified = +lastModified;\n\n      if (NumberIsNaN(lastModified)) {\n        lastModified = 0;\n      }\n    } else {\n      lastModified = DateNow();\n    }\n\n    this[kState] = new FileState(StringPrototypeToWellFormed(`${fileName}`)\x2C lastModified);\n  }\n\n  get name() {\n    if (!isFile(this))\n      throw new ERR_INVALID_THIS('File');\n\n    return this[kState].name;\n  }\n\n  get lastModified() {\n    if (!isFile(this))\n      throw new ERR_INVALID_THIS('File');\n\n    return this