script-source,154,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/card-names.js,/** Strip bracket wrapper from skirmish upgrade names. */\nexport function stripBrackets(name) {\n  if (typeof name !== 'string') return name;\n  return name.startsWith('[') && name.endsWith(']') ? name.slice(1\x2C -1) : name;\n}\n\n/** Compare two card names\x2C ignoring bracket wrappers. */\nexport function cardNameEquals(a\x2C b) {\n  return stripBrackets(a) === stripBrackets(b);\n}\n\n/** Check if array contains card name\x2C ignoring bracket wrappers. */\nexport function cardNameIncludes(arr\x2C name) {\n  if (!Array.isArray(arr)) return false;\n  const bare = stripBrackets(name);\n  return arr.some(entry => stripBrackets(entry) === bare);\n}\n
