code-creation,Script,9,105905,0x315fd30554d8,52, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/domain/event-store.js:1:1,0x337a3505f960,~
script-source,129,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/domain/event-store.js,import { insertDomainEvent\x2C getDomainEvents\x2C getLatestDomainSeq\x2C isDbConfigured } from '../db.js';\nimport { shouldSnapshot\x2C saveSnapshot } from './snapshot-store.js';\nimport { gameReducer } from './reducer/index.js';\nimport { resetSeqCounter\x2C getSeqCounter\x2C bumpEventSeq } from './events.js';\n\n/**\n * Initialize seq counters for all active games from DB.\n * Call once at startup after loadGames().\n */\nexport async function initSeqCounters(gameIds) {\n  if (!isDbConfigured()) return;\n  for (const gameId of gameIds) {\n    try {\n      const latestSeq = await getLatestDomainSeq(gameId);\n      if (latestSeq > 0) {\n        resetSeqCounter(gameId\x2C latestSeq);\n      }\n    } catch (e) {\n      console.warn(`[event-store] Failed to init seq for ${gameId}:`\x2C e.message);\n    }\n  }\n  console.log(`[event-store] Initialized seq counters for ${gameIds.length} game(s).`);\n}\n\nexport async function appendEvents(gameId\x2C events\x2C expectedVersion = null) {\n  if (expectedVersion !== null) {\n    const currentSeq = await getLatestDomainSeq(gameId);\n    if (currentSeq !== expectedVersion) {\n      throw new Error(`Concurrency conflict: expected ${expectedVersion}\x2C got ${currentSeq}`);\n    }\n  }\n  for (const event of events) {\n    await insertDomainEvent(gameId\x2C event\x2C { bumpEventSeq });\n  }\n\n  // Auto-snapshot: check if latest seq crosses a snapshot boundary\n  if (events.length > 0) {\n    const latestSeq = events[events.length - 1].seq;\n    if (shouldSnapshot(latestSeq)) {\n      try {\n        // Replay from last snapshot to build current state\n        const snapshotState = await replayToState(gameId);\n        if (snapshotState) {\n          await saveSnapshot(gameId\x2C latestSeq\x2C snapshotState);\n          console.log(`[event-store] Snapshot saved for game ${gameId} at seq ${latestSeq}`);\n        }\n      } catch (e) {\n        console.warn(`[event-store] Snapshot failed for ${gameId}:`\x2C e.message);\n      }\n    }\n  }\n}\n\n/**\n * Replay all events for a game to reconstruct state.\n * Uses latest snapshot as starting point for performance.\n */\nexport async function replayToState(gameId) {\n  const { loadLatestSnapshot } = await import('./snapshot-store.js');\n  const snapshot = await loadLatestSnapshot(gameId);\n  let state = snapshot?.state || {};\n  const afterSeq = snapshot?.version || 0;\n  const events = await getDomainEvents(gameId\x2C afterSeq\x2C 100000);\n  for (const event of events) {\n    state = gameReducer(state\x2C event);\n  }\n  return state;\n}\n\nexport async function getEvents(gameId\x2C { afterSeq = 0\x2C limit = 1000 } = {}) {\n  return getDomainEvents(gameId\x2C afterSeq\x2C limit);\n}\n\nexport async function getLatestSeq(gameId) {\n  return getLatestDomainSeq(gameId);\n}\n\nexport async function getAllEventsSince(gameId\x2C seq) {\n  return getDomainEvents(gameId\x2C seq\x2C 10000);\n}\n
