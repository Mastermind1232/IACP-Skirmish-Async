script-source,190,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/engine/available-actions.js,/**\n * Available actions system: reads game state and returns all legal actions\n * for a given player. Each action includes a type\x2C customId\x2C and description.\n *\n * This is the foundation for the AI player \u2014 it can list what moves are legal\n * without needing Discord.\n */\n\nimport { ACTION_TYPES\x2C buildCustomId } from './action-types.js';\nimport { getPlayerId\x2C getInitiativePlayerNum\x2C opponentPlayerNum\x2C getCcHand\x2C getDcList\x2C getActivatedDcIndices } from '../game/player-helpers.js';\nimport { PHASES\x2C ROUND_PHASES } from '../game/phase.js';\nimport { hasLineOfSight\x2C countSpaces } from '../game/spatial.js';\nimport { edgeKey\x2C getFootprintCells } from '../game/coords.js';\nimport { getBrokenWallEdges } from '../game/movement.js';\nimport { dcNameFromFigureKey\x2C isCompanionHostDefeated } from '../game/dc-helpers.js';\nimport { getAttackerSurgeAbilities\x2C SURGE_LABELS\x2C parseSurgeEffect } from '../game/combat.js';\nimport { getLegalInteractOptions } from '../game/board-helpers.js';\nimport { isDcCompanion\x2C getDcEffects\x2C getMapTokensData\x2C getFigureSize\x2C getLoadoutCards } from '../data-loader.js';\nimport { getConfig } from '../game/figure-config.js';\n\n/**\n * Get all available actions for a player in the current game state.\n * @param {object} game - The game state\n * @param {number} playerNum - 1 or 2\n * @param {object} [deps] - Optional dependencies for advanced queries (dcMessageMeta\x2C getDcStats\x2C etc.)\n * @returns {Array<{ type: string\x2C customId: string\x2C description: string\x2C params?: object }>}\n */\nexport function getAvailableActions(game\x2C playerNum\x2C deps = {}) {\n  if (!game || game.ended) return [];\n\n  // Combat side-effect pending states must resolve before any phase gate.\n  // These are set during combat/activation resolution and could persist into\n  // a round-end phase gate if the triggering action was the last of the round.\n  if (game.pendingCelebration) {\n    const celebActions = getCelebrationActions(game\x2C playerNum);\n    if (celebActions.length > 0) return celebActions;\n  }\n  if (game.pendingPowerTokenGrant) {\n    const tokenActions = getPowerTokenActions(game\x2C playerNum);\n    if (tokenActions.length > 0) return tokenActions;\n  }\n  if (game.pendingSpreadThePainCondPick) {\n    const spreadActions = getSpreadThePainActions(game\x2C playerNum);\n    if (spreadActions.length > 0) return spreadActions;\n  }\n  if (game.pendingDcAbilityChoice && Object.keys(game.pendingDcAbilityChoice).length > 0) {\n    const choiceActions = getDcAbilityChoiceActions(game\x2C playerNum\x2C deps);\n    if (choiceActions.length > 0) return choiceActions;\n  }\n  // Bleeding prompt (headless only): figure owner must accept or prevent\n  if (game.pendingBleeding) {\n    const bl = game.pendingBleeding;\n    if (playerNum === bl.playerNum) {\n      const gameId = game.gameId;\n      const ccDeckLen = (game[playerNum === 1 ? 'player1CcDeck' : 'player2CcDeck'] || []).length;\n      return [\n        { type: 'bleed_accept'\x2C customId: `bleed_accept_${gameId}_${playerNum}_${bl.figureKey}`\x2C description: `Bleeding: ${bl.displayName} takes 1 damage` }\x2C\n        { type: 'bleed_prevent'\x2C customId: `bleed_prevent_${gameId}_${playerNum}_${bl.figureKey}`\x2C description: `Bleeding: prevent (discard CC\x2C ${ccDeckLen} left)`\x2C disabled: ccDeckLen === 0 }\x2C\n      ].filter(a => !a.disabled);\n    }\n    return [];\n  }\n\n  // Post-deploy queue: player must pick which interactive ability to resolve next\n  if (game.postDeployQueue?.awaitingOrder) {\n    const q = game.postDeployQueue;\n    if (playerNum === q.currentPlayerNum) {\n      return (q.abilities || []).map((ab\x2C idx) => ({\n        type: 'post_deploy_pick'\x2C\n        customId: `pd_pick_${game.gameId}_${q.currentPlayerNum}_${idx}`\x2C\n        description: `Post-deploy: ${ab.label} \u2014 ${ab.dcName}`\x2C\n      }));\n    }\n    return [];\n  }\n  // Post-deploy active ability: interactive buttons stashed by post-deploy handlers\n  if (game.postDeployQueue?.pendingActions?.length > 0) {\n    const q = game.postDeployQueue;\n    const pNum = q.activeAbility?.playerNum ?? q.currentPlayerNum;\n    if (playerNum === pNum) return q.pendingActions;\n    return [];\n  }\n\n  // Start-of-round interactive effects (Rule by Fear\x2C Force Slow\x2C etc.)\n  if (game.pendingSorActions?.length > 0) {\n    const mine = game.pendingSorActions.filter(a => a.playerNum === playerNum);\n    if (mine.length > 0) return mine;\n    return [];\n  }\n\n  // Phase gate takes priority \u2014 only ready/unready allowed\n  if (game.phaseGate) {\n    return getPhaseGateActions(game\x2C playerNum);\n  }\n\n  // Dispatch based on game phase\n  switch (game.phase) {\n    case PHASES.LOBBY:\n      return []; // Lobby actions handled outside this system\n\n    case PHASES.MAP_SELECTION:\n      return getMapSelectionActions(game\x2C playerNum\x2C deps);\n\n    case PHASES.INITIATIVE:\n      return getInitiativeActions(game\x2C playerNum);\n\n    case PHASES.ZONE_SELECTION:\n      return getZoneSelectionActions(game\x2C playerNum);\n\n    case PHASES.DEPLOYMENT:\n      return getDeploymentActions(game\x2C playerNum\x2C deps);\n\n    case PHASES.ATTACHMENT:\n      return getAttachmentActions(game\x2C playerNum);\n\n    case PHASES.CC_DRAW:\n      return getCcDrawActions(game\x2C playerNum);\n\n    case PHASES.ROUND_ACTIVE:\n      return getRoundActiveActions(game\x2C playerNum\x2C deps);\n\n    case PHASES.ENDED:\n      return [];\n\n    default:\n      // Legacy games without phase tracking \u2014 try to infer\n      return getLegacyActions(game\x2C playerNum\x2C deps);\n  }\n}\n\n// \u2500\u2500 Phase Gate \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getPhaseGateActions(game\x2C playerNum) {\n  const gate = game.phaseGate;\n  const isReady = playerNum === 1 ? gate.p1Ready : gate.p2Ready;\n  const actions = [];\n\n  if (!isReady) {\n    actions.push({\n      type: ACTION_TYPES.PHASE_GATE_READY\x2C\n      customId: buildCustomId(ACTION_TYPES.PHASE_GATE_READY\x2C { gameId: game.gameId\x2C playerNum })\x2C\n      description: `Ready for ${gate.phase}`\x2C\n    });\n  } else {\n    actions.push({\n      type: ACTION_TYPES.PHASE_GATE_UNREADY\x2C\n      customId: buildCustomId(ACTION_TYPES.PHASE_GATE_UNREADY\x2C { gameId: game.gameId\x2C playerNum })\x2C\n      description: `Unready for ${gate.phase}`\x2C\n    });\n  }\n\n  return actions;\n}\n\n// \u2500\u2500 Map Selection \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getMapSelectionActions(game\x2C playerNum\x2C deps) {\n  // Both players can participate in map selection\n  const actions = [];\n  if (game.draftMapPool?.length) {\n    actions.push({\n      type: ACTION_TYPES.DRAFT_RANDOM\x2C\n      customId: buildCustomId(ACTION_TYPES.DRAFT_RANDOM\x2C { gameId: game.gameId })\x2C\n      description: 'Start random draft'\x2C\n    });\n  }\n  return actions;\n}\n\n// \u2500\u2500 Initiative \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getInitiativeActions(game\x2C playerNum) {\n  // Both squads must be submitted before initiative can be determined\n  if (!game.player1Squad || !game.player2Squad) return [];\n  return [{\n    type: ACTION_TYPES.DETERMINE_INITIATIVE\x2C\n    customId: buildCustomId(ACTION_TYPES.DETERMINE_INITIATIVE\x2C { gameId: game.gameId })\x2C\n    description: 'Determine initiative'\x2C\n  }];\n}\n\n// \u2500\u2500 Zone Selection \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getZoneSelectionActions(game\x2C playerNum) {\n  const chooserId = game.deviousSchemeZoneChooser || game.initiativePlayerId;\n  const chooserPn = chooserId === game.player1Id ? 1 : (chooserId === game.player2Id ? 2 : null);\n\n  if (playerNum !== chooserPn) return [];\n\n  return [\n    {\n      type: ACTION_TYPES.PICK_ZONE\x2C\n      customId: buildCustomId(ACTION_TYPES.PICK_ZONE\x2C { gameId: game.gameId\x2C zone: 'red' })\x2C\n      description: 'Choose RED deployment zone'\x2C\n      params: { zone: 'red' }\x2C\n    }\x2C\n    {\n      type: ACTION_TYPES.PICK_ZONE\x2C\n      customId: buildCustomId(ACTION_TYPES.PICK_ZONE\x2C { gameId: game.gameId\x2C zone: 'blue' })\x2C\n      description: 'Choose BLUE deployment zone'\x2C\n      params: { zone: 'blue' }\x2C\n    }\x2C\n  ];\n}\n\n// \u2500\u2500 Deployment \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getDeploymentActions(game\x2C playerNum\x2C deps) {\n  const initPlayerNum = getInitiativePlayerNum(game);\n  const isInitPlayer = playerNum === initPlayerNum;\n\n  // Initiative player deploys first\x2C then the other\n  if (isInitPlayer && !game.initiativePlayerDeployed) {\n    return getDeployActionsForPlayer(game\x2C playerNum\x2C deps);\n  }\n  if (!isInitPlayer && game.initiativePlayerDeployed && !game.nonInitiativePlayerDeployed) {\n    return getDeployActionsForPlayer(game\x2C playerNum\x2C deps);\n  }\n\n  return [];\n}\n\nfunction getDeployActionsForPlayer(game\x2C playerNum\x2C deps) {\n  const actions = [];\n  const gameId = game.gameId;\n\n  // Deployment done (if all required figures are placed)\n  actions.push({\n    type: ACTION_TYPES.DEPLOY_DONE\x2C\n    customId: buildCustomId(ACTION_TYPES.DEPLOY_DONE\x2C { gameId })\x2C\n    description: 'Finish deployment'\x2C\n  });\n\n  // Individual figure deployment (requires dcMessageMeta to list undeployed figures)\n  // This is a simplified version \u2014 full implementation needs figure-level detail\n  const dcList = getDcListForPlayer(game\x2C playerNum);\n  for (let i = 0; i < dcList.length; i++) {\n    const dc = dcList[i];\n    const dcName = typeof dc === 'object' ? dc.dcName : dc;\n    actions.push({\n      type: ACTION_TYPES.DEPLOY_FIGURE\x2C\n      customId: buildCustomId(ACTION_TYPES.DEPLOY_FIGURE\x2C { gameId\x2C dcIndex: i })\x2C\n      description: `Deploy ${dcName}`\x2C\n      params: { dcIndex: i\x2C dcName }\x2C\n    });\n  }\n\n  return actions;\n}\n\n// \u2500\u2500 Attachment \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getAttachmentActions(game\x2C playerNum) {\n  const confirmed = game.setupAttachmentConfirmed?.[playerNum];\n  if (confirmed) return [];\n\n  return [{\n    type: ACTION_TYPES.CONFIRM_ATTACHMENT\x2C\n    customId: `attach_done_confirm_${game.gameId}_${playerNum}`\x2C\n    description: 'Confirm attachments'\x2C\n  }];\n}\n\n// \u2500\u2500 CC Draw \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getCcDrawActions(game\x2C playerNum) {\n  const drawn = playerNum === 1 ? game.player1CcDrawn : game.player2CcDrawn;\n  if (drawn) return [];\n\n  return [{\n    type: ACTION_TYPES.DRAW_CC\x2C\n    customId: buildCustomId(ACTION_TYPES.DRAW_CC\x2C { gameId: game.gameId })\x2C\n    description: 'Shuffle & draw starting hand'\x2C\n  }];\n}\n\n// \u2500\u2500 Round Active \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getRoundActiveActions(game\x2C playerNum\x2C deps) {\n  const playerId = getPlayerId(game\x2C playerNum);\n  const gameId = game.gameId;\n\n  // Check for pending sub-states first\n  // Negation must be checked before combat/movement \u2014 it blocks all play until resolved\n  if (game.pendingNegation) {\n    return getNegationActions(game\x2C playerNum);\n  }\n\n  // Comm Disruption prompt \u2014 opponent must respond before game continues\n  if (game.pendingCommDisruptionPrompt) {\n    const cdActions = getCommDisruptionActions(game\x2C playerNum);\n    if (cdActions.length > 0) return cdActions;\n  }\n\n  // Power Token Overflow takes priority over combat \u2014 must discard before continuing\n  if (game.pendingPowerTokenOverflow?.length > 0) {\n    const overflowActions = getOverflowActions(game\x2C playerNum);\n    if (overflowActions.length > 0) return overflowActions;\n  }\n\n  if (game.pendingCombat) {\n    const combatActions = getCombatActions(game\x2C playerNum\x2C deps);\n    // Append playable CCs alongside combat actions (combat-timing windows)\n    if (deps.getPlayableCcFromHand) {\n      const hand = playerNum === 1 ? game.player1CcHand : game.player2CcHand;\n      if (hand?.length) {\n        const playable = deps.getPlayableCcFromHand(game\x2C playerNum\x2C hand);\n        for (let i = 0; i < playable.length; i++) {\n          combatActions.push({\n            type: ACTION_TYPES.PLAY_CC\x2C\n            customId: `cc_play_${gameId}_${playerNum}_${i}`\x2C\n            description: `Play CC: ${playable[i]}`\x2C\n            params: { cardIndex: i\x2C cardName: playable[i] }\x2C\n          });\n        }\n      }\n    }\n    return combatActions;\n  }\n\n  if (game.moveInProgress && Object.keys(game.moveInProgress).length > 0) {\n    return getMovementActions(game\x2C playerNum\x2C deps);\n  }\n\n  // \u2500\u2500 Post-combat pending abilities \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  // Set during finishCombatResolution AFTER pendingCombat is deleted.\n  if (game.pendingBoltslinger) {\n    const bl = game.pendingBoltslinger;\n    if (playerNum === bl.attackerPlayerNum) {\n      const acts = (bl.targets || []).slice(0\x2C 4).map((t\x2C i) => ({\n        type: 'boltslinger_target'\x2C customId: `boltslinger_target_${gameId}_${i}`\x2C\n        description: `Boltslinger: deal 1 Dmg to ${t.label}`\x2C\n      }));\n      acts.push({ type: 'boltslinger_skip'\x2C customId: `boltslinger_skip_${gameId}`\x2C description: 'Skip Boltslinger' });\n      return acts;\n    }\n    return [];\n  }\n  if (game.pendingIndiscriminateFire) {\n    const idf = game.pendingIndiscriminateFire;\n    if (playerNum === idf.attackerPlayerNum) {\n      const acts = (idf.availableDice || []).slice(0\x2C 5).map((d\x2C i) => ({\n        type: 'indiscriminate_die'\x2C customId: `indiscriminate_die_${gameId}_${i}`\x2C\n        description: `Indiscriminate Fire: ${d.color} die`\x2C\n      }));\n      acts.push({ type: 'indiscriminate_skip'\x2C customId: `indiscriminate_skip_${gameId}`\x2C description: 'Skip Indiscriminate Fire' });\n      return acts;\n    }\n    return [];\n  }\n  if (game.pendingHeavyFire) {\n    const hf = game.pendingHeavyFire;\n    if (playerNum === (hf.attackerPlayerNum || hf.ownerPlayerNum)) {\n      return [\n        { type: 'heavy_fire_use'\x2C customId: `heavy_fire_use_${gameId}`\x2C description: 'Use Heavy Fire' }\x2C\n        { type: 'heavy_fire_skip'\x2C customId: `heavy_fire_skip_${gameId}`\x2C description: 'Skip Heavy Fire' }\x2C\n      ];\n    }\n    return [];\n  }\n  if (game.pendingHavocShot) {\n    const hs = game.pendingHavocShot;\n    if (playerNum === hs.attackerPlayerNum) {\n      const acts = (hs.targets || []).slice(0\x2C 4).map((t\x2C i) => ({\n        type: 'havoc_shot_target'\x2C customId: `havoc_shot_target_${gameId}_${i}`\x2C\n        description: `Havoc Shot: ${t.label}`\x2C\n      }));\n      acts.push({ type: 'havoc_shot_skip'\x2C customId: `havoc_shot_skip_${gameId}`\x2C description: 'Skip Havoc Shot' });\n      return acts;\n    }\n    return [];\n  }\n  if (game.pendingWantonDestruction) {\n    const wd = game.pendingWantonDestruction;\n    if (playerNum === wd.ownerPlayerNum) {\n      return [\n        { type: 'wanton_use'\x2C customId: `wanton_use_${gameId}`\x2C description: 'Use Wanton Destruction (discard 1 CC)' }\x2C\n        { type: 'wanton_skip'\x2C customId: `wanton_skip_${gameId}`\x2C description: 'Skip Wanton Destruction' }\x2C\n      ];\n    }\n    return [];\n  }\n  if (game.pendingDeflect) {\n    const df = game.pendingDeflect;\n    if (playerNum === df.deflectorPlayerNum) {\n      const acts = (df.hostiles || []).slice(0\x2C 4).map((t\x2C i) => ({\n        type: 'deflect_target'\x2C customId: `deflect_pick_${gameId}_${i}`\x2C\n        description: `Deflect: ${t.label}`\x2C\n      }));\n      acts.push({ type: 'deflect_skip'\x2C customId: `deflect_skip_${gameId}`\x2C description: 'Skip Deflect' });\n      return acts;\n    }\n    return [];\n  }\n  if (game.pendingReaction) {\n    const rx = game.pendingReaction;\n    if (playerNum === rx.defenderPlayerNum) {\n      return [\n        { type: 'reaction_use'\x2C customId: `reaction_use_${gameId}`\x2C description: 'Use Reaction' }\x2C\n        { type: 'reaction_skip'\x2C customId: `reaction_skip_${gameId}`\x2C description: 'Skip Reaction' }\x2C\n      ];\n    }\n    return [];\n  }\n  if (game.pendingMastery) {\n    const ms = game.pendingMastery;\n    if (playerNum === ms.attackerPlayerNum) {\n      const acts = (ms.eligible || []).map((e\x2C i) => ({\n        type: 'mastery_pick'\x2C customId: `mastery_pick_${gameId}_${e.discardKey || i}`\x2C\n        description: `Mastery: discard ${e.label || e.discardKey}`\x2C\n      }));\n      acts.push({ type: 'mastery_skip'\x2C customId: `mastery_skip_${gameId}`\x2C description: 'Skip Mastery' });\n      return acts;\n    }\n    return [];\n  }\n  if (game.pendingInterrogate) {\n    const it = game.pendingInterrogate;\n    if (playerNum === it.attackerPlayerNum) {\n      const acts = (it.opponentHandSnapshot || []).map((card\x2C i) => ({\n        type: 'interrogate_pick'\x2C customId: `interrogate_pick_${gameId}_${i}`\x2C\n        description: `Interrogate: look at ${card}`\x2C\n      }));\n      acts.push({ type: 'interrogate_skip'\x2C customId: `interrogate_skip_${gameId}`\x2C description: 'Skip Interrogation' });\n      return acts;\n    }\n    return [];\n  }\n\n  // Pending DC ability choice (chooseOne mechanic)\n  if (game.pendingDcAbilityChoice && Object.keys(game.pendingDcAbilityChoice).length > 0) {\n    const choiceActions = getDcAbilityChoiceActions(game\x2C playerNum\x2C deps);\n    if (choiceActions.length > 0) return choiceActions;\n  }\n\n  // Pending Celebration (after defeating a unique figure)\n  if (game.pendingCelebration) {\n    const celebActions = getCelebrationActions(game\x2C playerNum);\n    if (celebActions.length > 0) return celebActions;\n  }\n\n  // Pending Pounce space choice (Nexu etc.)\n  if (game.pendingPounceSpaceChoice && Object.keys(game.pendingPounceSpaceChoice).length > 0) {\n    const pounceActions = getPounceSpaceActions(game\x2C playerNum\x2C deps);\n    if (pounceActions.length > 0) return pounceActions;\n  }\n\n  // Pending Missile Salvo (BT-1 etc.)\n  if (game.pendingMissileSalvo && Object.keys(game.pendingMissileSalvo).length > 0) {\n    const salvoActions = getMissileSalvoActions(game\x2C playerNum);\n    if (salvoActions.length > 0) return salvoActions;\n  }\n\n  // Pending Power Token grant\n  if (game.pendingPowerTokenGrant) {\n    const tokenActions = getPowerTokenActions(game\x2C playerNum);\n    if (tokenActions.length > 0) return tokenActions;\n  }\n\n  // Pending Power Token Overflow \u2014 player must discard excess tokens\n  if (game.pendingPowerTokenOverflow?.length > 0) {\n    const overflowActions = getOverflowActions(game\x2C playerNum);\n    if (overflowActions.length > 0) return overflowActions;\n  }\n\n  // Pending Cover Fire\n  if (game.pendingCoverFire) {\n    const coverActions = getCoverFireActions(game\x2C playerNum);\n    if (coverActions.length > 0) return coverActions;\n  }\n\n  // Pending Strain Choice (player must resolve strain allocation before continuing)\n  if (game.pendingStrainChoice && Object.keys(game.pendingStrainChoice).length > 0) {\n    const strainActions = getStrainChoiceActions(game\x2C playerNum);\n    if (strainActions.length > 0) return strainActions;\n  }\n\n  // Force Vision pending: blocked player must pick a group\n  if (game.forceVisionPending && game.forceVisionPending === playerNum) {\n    const fvActions = getForceVisionPickActions(game\x2C playerNum);\n    if (fvActions.length > 0) return fvActions;\n    // Safety: no ready groups remain \u2014 clear the stale pending\n    game.forceVisionPending = null;\n  }\n\n  // Pending Spread the Pain condition pick\n  if (game.pendingSpreadThePainCondPick) {\n    const spreadActions = getSpreadThePainActions(game\x2C playerNum);\n    if (spreadActions.length > 0) return spreadActions;\n  }\n\n  // Pending Still Faster Than You interrupt\n  if (game.pendingStillFaster) {\n    const sfActions = getStillFasterActions(game\x2C playerNum);\n    if (sfActions.length > 0) return sfActions;\n  }\n\n  // Pending Last Resort interrupt (figure about to die)\n  if (game.pendingLastResort) {\n    const lrActions = getLastResortActions(game\x2C playerNum);\n    if (lrActions.length > 0) return lrActions;\n  }\n\n  // Pending CC confirmation (player must confirm/cancel before anything else)\n  if (game.pendingCcConfirmation) {\n    const ccConfirmActions = getCcConfirmActions(game\x2C playerNum);\n    if (ccConfirmActions.length > 0) return ccConfirmActions;\n  }\n\n  // Pending CC choice (chooseOne for CC like Retaliation)\n  if (game.pendingCcChoice && game.pendingCcChoice.gameId) {\n    const ccChoiceActions = getCcChoiceActions(game\x2C playerNum);\n    if (ccChoiceActions.length > 0) return ccChoiceActions;\n  }\n\n  // Pending CC space choice (pick-a-space for CC like Smoke Grenade)\n  if (game.pendingCcSpaceChoice && game.pendingCcSpaceChoice.gameId) {\n    const ccSpaceActions = getCcSpaceActions(game\x2C playerNum);\n    if (ccSpaceActions.length > 0) return ccSpaceActions;\n  }\n\n  // Pending EE-3 Carbine die pick (Boba Fett)\n  if (game.pendingEe3Carbine && typeof game.pendingEe3Carbine === 'object') {\n    const ee3Actions = getEe3CarbineActions(game\x2C playerNum\x2C deps);\n    if (ee3Actions.length > 0) return ee3Actions;\n  }\n\n  // Pending Bo-Rifle weapon pick (Agent Kallus)\n  if (game.pendingBoRifle && typeof game.pendingBoRifle === 'object') {\n    const brActions = getBoRifleActions(game\x2C playerNum\x2C deps);\n    if (brActions.length > 0) return brActions;\n  }\n\n  // Pending Rush (Onar)\n  if (game.pendingRushPush) {\n    const rushActions = getRushPushActions(game\x2C playerNum);\n    if (rushActions.length > 0) return rushActions;\n  }\n\n  // Pending Shoulder Rush (Drokkatta)\n  if (game.pendingShoulderRush) {\n    const srActions = getShoulderRushActions(game\x2C playerNum);\n    if (srActions.length > 0) return srActions;\n  }\n\n  // Pending False Orders / Lure\n  if (game.pendingFalseOrders) {\n    const foActions = getFalseOrdersActions(game\x2C playerNum);\n    if (foActions.length > 0) return foActions;\n  }\n\n  // Check round phase\n  switch (game.roundPhase) {\n    case ROUND_PHASES.START_OF_ROUND:\n      return getStartOfRoundActions(game\x2C playerNum);\n\n    case ROUND_PHASES.ACTIVATION:\n      return getActivationActions(game\x2C playerNum\x2C deps);\n\n    case ROUND_PHASES.END_OF_ROUND:\n      return getEndOfRoundActions(game\x2C playerNum\x2C deps);\n\n    default:\n      return getActivationActions(game\x2C playerNum\x2C deps);\n  }\n}\n\n// \u2500\u2500 Activation Phase \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getActivationActions(game\x2C playerNum\x2C deps) {\n  const playerId = getPlayerId(game\x2C playerNum);\n  const actions = [];\n  const gameId = game.gameId;\n\n  // End activation phase \u2014 both players must confirm\x2C regardless of turn\n  const noActivations = (game.p1ActivationsRemaining ?? 0) === 0 && (game.p2ActivationsRemaining ?? 0) === 0;\n  // Check if any alive DC still has actions remaining (skip stale entries for defeated DCs)\n  const noActionsRemaining = !Object.entries(game.dcActionsData || {}).some(([msgId\x2C d]) => {\n    if (d.remaining <= 0) return false;\n    // If we have health state\x2C verify the DC isn't fully defeated\n    if (deps.dcHealthState) {\n      const hs = deps.dcHealthState.get(msgId);\n      if (hs && hs.every(fig => fig && fig[0] <= 0)) return false;\n    }\n    return true;\n  });\n  if (noActivations && noActionsRemaining) {\n    const alreadyEnded = playerNum === 1 ? game.p1ActivationPhaseEnded : game.p2ActivationPhaseEnded;\n    if (!alreadyEnded) {\n      actions.push({\n        type: ACTION_TYPES.END_ACTIVATION_PHASE\x2C\n        customId: buildCustomId(ACTION_TYPES.END_ACTIVATION_PHASE\x2C { gameId })\x2C\n        description: 'End Activation Phase'\x2C\n      });\n    }\n  }\n\n  // Is it this player's activation turn?\n  const isMyTurn = game.currentActivationTurnPlayerId === playerId;\n\n  // Check for active DC with actions remaining (even if not our turn \u2014 we still\n  // need to offer dc_end_activation for our own DCs that have pending actions)\n  if (!isMyTurn && deps.dcMessageMeta) {\n    for (const [msgId\x2C meta] of deps.dcMessageMeta) {\n      if (meta.gameId !== gameId || meta.playerNum !== playerNum) continue;\n      const data = game.dcActionsData?.[msgId];\n      if (data && data.remaining > 0) {\n        // Skip if DC is fully defeated (stale dcActionsData)\n        if (deps.dcHealthState) {\n          const hs = deps.dcHealthState.get(msgId);\n          if (hs && hs.every(fig => fig && fig[0] <= 0)) continue;\n        }\n        actions.push({\n          type: ACTION_TYPES.DC_END_ACTIVATION\x2C\n          customId: buildCustomId(ACTION_TYPES.DC_END_ACTIVATION\x2C { msgId })\x2C\n          description: `End activation for ${meta.displayName || meta.dcName}`\x2C\n          params: { msgId\x2C dcName: meta.dcName }\x2C\n        });\n      }\n    }\n    return actions;\n  }\n\n  // Check if player has readied DCs to activate\n  const activationsRemaining = playerNum === 1 ? (game.p1ActivationsRemaining ?? 0) : (game.p2ActivationsRemaining ?? 0);\n\n  // Check if there's already an active DC for this player (blocks new activations)\n  // Skip fully defeated DCs \u2014 their stale dcActionsData should not block new activations\n  const hasActiveDc = deps.dcMessageMeta && [...deps.dcMessageMeta].some(([msgId\x2C meta]) => {\n    if (meta.gameId !== gameId || meta.playerNum !== playerNum) return false;\n    if (game.dcActionsData?.[msgId] == null) return false;\n    if (deps.dcHealthState) {\n      const hs = deps.dcHealthState.get(msgId);\n      if (hs && hs.every(fig => fig && fig[0] <= 0)) return false;\n    }\n    return true;\n  });\n\n  if (activationsRemaining > 0 && !hasActiveDc) {\n    // Can activate a DC \u2014 need dcMessageMeta to list available DCs\n    let hasActivatableDc = false;\n    if (deps.dcMessageMeta) {\n      const dcMsgIds = playerNum === 1 ? game.p1DcMessageIds : game.p2DcMessageIds;\n      for (const [msgId\x2C meta] of deps.dcMessageMeta) {\n        if (meta.gameId !== gameId || meta.playerNum !== playerNum) continue;\n        // Check if this DC is readied (not exhausted) and not depleted\n        const exhausted = deps.dcExhaustedState?.get(msgId) ?? false;\n        if (exhausted) continue;\n        const depleted = game.p1DepletedDcMessageIds?.includes(msgId) || game.p2DepletedDcMessageIds?.includes(msgId);\n        if (depleted) continue;\n        // Skip DCs with no surviving figures on the board\n        const figs = game.figurePositions?.[playerNum] || {};\n        if (!Object.keys(figs).some(fk => fk.startsWith(meta.dcName + '-'))) continue;\n        // Companions cannot activate if their host group has left play (rules: COMPANIONS L919-920)\n        if (isCompanionHostDefeated(game\x2C meta.dcName\x2C playerNum)) continue;\n\n        hasActivatableDc = true;\n        const dcIndex = dcMsgIds ? dcMsgIds.indexOf(msgId) : 0;\n        actions.push({\n          type: ACTION_TYPES.ACTIVATE_DC\x2C\n          customId: buildCustomId(ACTION_TYPES.ACTIVATE_DC\x2C { gameId\x2C playerNum\x2C dcIndex })\x2C\n          description: `Activate ${meta.displayName || meta.dcName}`\x2C\n          params: { msgId\x2C dcName: meta.dcName }\x2C\n        });\n      }\n    }\n\n    if (hasActivatableDc) {\n      // Can pass activation turn \u2014 but only if opponent has MORE activations (matches handler guard)\n      const otherPlayerNum = playerNum === 1 ? 2 : 1;\n      const otherRem = otherPlayerNum === 1 ? (game.p1ActivationsRemaining ?? 0) : (game.p2ActivationsRemaining ?? 0);\n      if (otherRem > activationsRemaining) {\n        actions.push({\n          type: ACTION_TYPES.PASS_ACTIVATION_TURN\x2C\n          customId: buildCustomId(ACTION_TYPES.PASS_ACTIVATION_TURN\x2C { gameId })\x2C\n          description: 'Pass activation turn'\x2C\n        });\n      }\n    } else {\n      // Has activations on paper but no DCs to activate (all exhausted/dead)\n      // Offer end activation phase to prevent deadlock\n      const alreadyEnded = playerNum === 1 ? game.p1ActivationPhaseEnded : game.p2ActivationPhaseEnded;\n      if (!alreadyEnded) {\n        actions.push({\n          type: ACTION_TYPES.END_ACTIVATION_PHASE\x2C\n          customId: buildCustomId(ACTION_TYPES.END_ACTIVATION_PHASE\x2C { gameId })\x2C\n          description: 'End Activation Phase (no DCs to activate)'\x2C\n        });\n      }\n    }\n  } else if (!noActivations && !hasActiveDc) {\n    // Player has 0 activations but opponent still has some \u2014 must pass turn\n    actions.push({\n      type: ACTION_TYPES.PASS_ACTIVATION_TURN\x2C\n      customId: buildCustomId(ACTION_TYPES.PASS_ACTIVATION_TURN\x2C { gameId })\x2C\n      description: 'Pass activation turn'\x2C\n    });\n  }\n\n  // Check for active DC with actions remaining\n  if (deps.dcMessageMeta) {\n    for (const [msgId\x2C meta] of deps.dcMessageMeta) {\n      if (meta.gameId !== gameId || meta.playerNum !== playerNum) continue;\n      const data = game.dcActionsData?.[msgId];\n      if (!data || data.remaining <= 0) continue;\n\n      // Skip if all figures for this DC are defeated (no positions on board)\n      const figs = game.figurePositions?.[playerNum] || {};\n      const hasSurvivors = Object.keys(figs).some(fk => fk.startsWith(meta.dcName + '-'));\n      if (!hasSurvivors) continue;\n\n      // This DC has actions remaining \u2014 can move\x2C attack\x2C interact\x2C or special\n      const displayName = meta.displayName || meta.dcName;\n      const figureIndex = data.selectedFigure ?? 0;\n\n      // Build figureKey for condition checks (stun\x2C massive\x2C position)\n      const dgIndex = (displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? 1;\n      const figureKey = `${meta.dcName}-${dgIndex}-${figureIndex}`;\n      const figConditions = game.figureConditions?.[figureKey] || [];\n      const isStunned = figConditions.includes('Stun');\n      const hasPosition = !!game.figurePositions?.[playerNum]?.[figureKey];\n\n      // Wave 4: Stunned figure can spend 1 action to remove Stun (rules: STUNNED L2759-2761)\n      if (isStunned && data.remaining >= 1) {\n        actions.push({\n          type: 'remove_stun'\x2C\n          customId: `dc_remove_stun_${msgId}_f${figureIndex}`\x2C\n          description: `Remove Stun from ${displayName}`\x2C\n          params: { msgId\x2C dcName: meta.dcName }\x2C\n        });\n      }\n\n      // Stunned/no-position/massive-locked/To-the-Limit figures cannot Move\n      if (!isStunned && hasPosition\n          && !game.massiveMovementLocked?.[figureKey]\n          && !game.activationExtraActionThenStun?.[msgId]) {\n        actions.push({\n          type: ACTION_TYPES.MOVE_FIGURE\x2C\n          customId: buildCustomId(ACTION_TYPES.MOVE_FIGURE\x2C { msgId\x2C figureIndex })\x2C\n          description: `Move with ${displayName}`\x2C\n          params: { msgId\x2C dcName: meta.dcName }\x2C\n        });\n      }\n\n      // Arsenal / Epic Arsenal: if DC has Arsenal and no override dice yet\x2C offer dice pick\n      const arsenalActions = getArsenalPickActions(game\x2C playerNum\x2C msgId\x2C deps);\n      if (arsenalActions.length > 0) {\n        actions.push(...arsenalActions);\n      }\n\n      // Attack: compute individual targets if deps available (stunned figures cannot attack)\n      // Enforce 1-attack-per-activation rule: if already attacked\x2C only offer attack if\n      // the DC has Assault\x2C or a free/bonus attack is pending.\n      const alreadyAttacked = !!game.attackPerformedThisActivation?.[msgId];\n      let attackBlocked = false;\n      if (alreadyAttacked) {\n        const hasFreeAttack = game.freeAttackBonusPending?.[msgId] != null\n          || game.pounceAttackPending?.[msgId] != null\n          || game.fellSwoopFreeAttack?.[msgId]\n          || game.pummelTwoAttacksThisActivation?.[msgId];\n        const hasIRMultiAttack = !!game.imperialRetrofittingMultiAttack?.[msgId];\n        if (!hasFreeAttack && !hasIRMultiAttack) {\n          const dcAbilityText = getDcEffects()?.[meta.dcName]?.abilityText || '';\n          const hasAssault = /\\bAssault:/i.test(dcAbilityText);\n          if (!hasAssault) attackBlocked = true;\n        }\n      }\n      const canComputeTargets = deps.getDcStats && deps.getMapData && game.selectedMap?.id;\n      const targets = (isStunned || attackBlocked) ? [] : computeAttackTargets(game\x2C msgId\x2C meta\x2C figureIndex\x2C playerNum\x2C deps);\n      if (targets.length > 0) {\n        game.attackTargets = game.attackTargets || {};\n        game.attackTargets[`${msgId}_${figureIndex}`] = targets;\n        for (let ti = 0; ti < targets.length; ti++) {\n          const t = targets[ti];\n          actions.push({\n            type: ACTION_TYPES.ATTACK_TARGET\x2C\n            customId: `attack_target_${msgId}_${figureIndex}_${ti}`\x2C\n            description: `Attack ${t.label} with ${displayName}`\x2C\n            params: { msgId\x2C dcName: meta.dcName\x2C targetIndex: ti\x2C targetFigureKey: t.figureKey }\x2C\n          });\n        }\n      } else if (!canComputeTargets && !isStunned && !attackBlocked) {\n        // Fallback: deps unavailable\x2C offer generic attack (Discord handler will compute targets)\n        actions.push({\n          type: ACTION_TYPES.ATTACK_TARGET\x2C\n          customId: buildCustomId(ACTION_TYPES.ATTACK_TARGET\x2C { msgId\x2C figureIndex })\x2C\n          description: `Attack with ${displayName}`\x2C\n          params: { msgId\x2C dcName: meta.dcName }\x2C\n        });\n      }\n      // If canComputeTargets but targets is empty: no valid targets in range/LOS \u2014 don't offer attack\n\n      // Interact \u2014 compute legal interact options for each figure of this DC\n      const mapId = game.selectedMap?.id;\n      if (mapId) {\n        const dcEff = getDcEffects()?.[meta.dcName];\n        const abilityText = dcEff?.abilityText || '';\n        const isNonSentient = abilityText.includes('Non-Sentient') && !game.beastTamerInteractOverride?.[msgId];\n        const isCompanion = isDcCompanion(meta.dcName);\n        if (!isNonSentient && !isCompanion) {\n          const dgIndex = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? 1;\n          const figureKey = `${meta.dcName}-${dgIndex}-${figureIndex}`;\n          const pos = game.figurePositions?.[playerNum]?.[figureKey];\n          if (pos) {\n            const interactOpts = getLegalInteractOptions(game\x2C playerNum\x2C figureKey\x2C mapId);\n            for (const opt of interactOpts) {\n              actions.push({\n                type: ACTION_TYPES.INTERACT\x2C\n                customId: buildCustomId(ACTION_TYPES.INTERACT\x2C {\n                  gameId: game.gameId\x2C msgId\x2C figureIndex\x2C optionId: opt.id\x2C\n                })\x2C\n                description: `${opt.label} (${displayName})`\x2C\n                params: {\n                  msgId\x2C dcName: meta.dcName\x2C figureIndex\x2C figureKey\x2C\n                  optionId: opt.id\x2C optionLabel: opt.label\x2C missionSpecific: opt.missionSpecific\x2C\n                }\x2C\n              });\n            }\n          }\n        }\n      }\n\n      // DC Specials \u2014 list available special abilities\n      if (deps.getDcStats) {\n        const dcStats = deps.getDcStats(meta.dcName);\n        const specials = dcStats?.specials || [];\n        const specialIds = dcStats?.specialIds || [];\n        const specialCosts = dcStats?.specialCosts || [];\n        const specialsUsed = data.specialsUsed || [];\n        const isStunned = (game.figureConditions?.[`${meta.dcName}-1-${figureIndex}`] || []).includes('Stun');\n\n        for (let si = 0; si < specials.length; si++) {\n          const cost = specialCosts[si] ?? 1;\n          if (specialsUsed.includes(si)) continue; // Already used this activation\n          if (data.remaining < cost) continue;      // Not enough actions\n          if (isStunned) continue;                   // Stunned figures can't use specials\n\n          actions.push({\n            type: ACTION_TYPES.DC_SPECIAL\x2C\n            customId: buildCustomId(ACTION_TYPES.DC_SPECIAL\x2C { msgId\x2C specialIdx: si })\x2C\n            description: `${specials[si]} (${displayName})`\x2C\n            params: { msgId\x2C dcName: meta.dcName\x2C specialIdx: si\x2C specialName: specials[si]\x2C specialId: specialIds[si] || null\x2C cost }\x2C\n          });\n        }\n      }\n\n      // CC Special Action CCs (timing: specialAction) \u2014 costs 1 action\n      if (deps.getPlayableCcSpecialsForDc && data.remaining >= 1) {\n        const ccSpecials = deps.getPlayableCcSpecialsForDc(game\x2C playerNum\x2C meta.dcName\x2C meta.displayName);\n        for (let ci = 0; ci < ccSpecials.length; ci++) {\n          actions.push({\n            type: ACTION_TYPES.PLAY_CC_SPECIAL\x2C\n            customId: buildCustomId(ACTION_TYPES.PLAY_CC_SPECIAL\x2C { msgId\x2C cardIndex: ci })\x2C\n            description: `Play CC (Special Action): ${ccSpecials[ci]} (${displayName})`\x2C\n            params: { msgId\x2C dcName: meta.dcName\x2C cardIndex: ci\x2C cardName: ccSpecials[ci]\x2C actionCost: 1 }\x2C\n          });\n        }\n      }\n\n      // CC Double Action CCs (timing: doubleActionSpecial) \u2014 costs 2 actions\n      if (deps.getPlayableCcDoubleActionsForDc && data.remaining >= 2) {\n        const ccDoubles = deps.getPlayableCcDoubleActionsForDc(game\x2C playerNum\x2C meta.dcName\x2C meta.displayName);\n        for (let ci = 0; ci < ccDoubles.length; ci++) {\n          actions.push({\n            type: ACTION_TYPES.PLAY_CC_DOUBLE\x2C\n            customId: buildCustomId(ACTION_TYPES.PLAY_CC_DOUBLE\x2C { msgId\x2C cardIndex: ci })\x2C\n            description: `Play CC (Double Action): ${ccDoubles[ci]} (${displayName})`\x2C\n            params: { msgId\x2C dcName: meta.dcName\x2C cardIndex: ci\x2C cardName: ccDoubles[ci]\x2C actionCost: 2 }\x2C\n          });\n        }\n      }\n\n      // End activation early (forfeit remaining actions)\n      actions.push({\n        type: ACTION_TYPES.DC_END_ACTIVATION\x2C\n        customId: buildCustomId(ACTION_TYPES.DC_END_ACTIVATION\x2C { msgId })\x2C\n        description: `End activation for ${displayName}`\x2C\n        params: { msgId\x2C dcName: meta.dcName }\x2C\n      });\n    }\n  }\n\n  // Check for DCs with 0 actions remaining \u2014 need to end activation\n  if (deps.dcMessageMeta) {\n    for (const [msgId\x2C meta] of deps.dcMessageMeta) {\n      if (meta.gameId !== gameId || meta.playerNum !== playerNum) continue;\n      const data = game.dcActionsData?.[msgId];\n      if (data && data.remaining <= 0) {\n        // DC has been activated but has no actions left \u2014 can end activation\n        actions.push({\n          type: ACTION_TYPES.DC_END_ACTIVATION\x2C\n          customId: buildCustomId(ACTION_TYPES.DC_END_ACTIVATION\x2C { msgId })\x2C\n          description: `End activation for ${meta.displayName || meta.dcName}`\x2C\n          params: { msgId\x2C dcName: meta.dcName }\x2C\n        });\n      }\n    }\n  }\n\n  // CC play actions \u2014 list playable CCs from hand\n  if (deps.getPlayableCcFromHand) {\n    const hand = playerNum === 1 ? game.player1CcHand : game.player2CcHand;\n    if (hand?.length) {\n      // getPlayableCcFromHand(game\x2C playerNum\x2C hand) returns string[]\n      const playable = deps.getPlayableCcFromHand(game\x2C playerNum\x2C hand);\n      for (let i = 0; i < playable.length; i++) {\n        const cardName = playable[i];\n        actions.push({\n          type: ACTION_TYPES.PLAY_CC\x2C\n          customId: `cc_play_${gameId}_${playerNum}_${i}`\x2C\n          description: `Play CC: ${cardName}`\x2C\n          params: { cardIndex: i\x2C cardName }\x2C\n        });\n      }\n    }\n  }\n\n  // Non-blocking side prompts: overwatch\x2C bomb drop\x2C orbital bombardment\n  // These appear alongside normal activation actions (player can resolve them at any point)\n  if (game.pendingOverwatchPlacement && Object.keys(game.pendingOverwatchPlacement).length > 0) {\n    actions.push(...getOverwatchPlacementActions(game\x2C playerNum\x2C deps));\n  }\n  if (game.pendingBombDrop && Object.keys(game.pendingBombDrop).length > 0) {\n    actions.push(...getBombDropActions(game\x2C playerNum\x2C deps));\n  }\n  if (game.pendingOrbitalBombardment) {\n    actions.push(...getOrbitalBombardmentActions(game\x2C playerNum\x2C deps));\n  }\n\n  return actions;\n}\n\n// \u2500\u2500 Combat Sub-flow \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getCombatActions(game\x2C playerNum\x2C deps) {\n  const combat = game.pendingCombat;\n  if (!combat) return [];\n\n  const playerId = getPlayerId(game\x2C playerNum);\n  const actions = [];\n  const gameId = game.gameId;\n  const attackerPn = combat.attackerPlayerNum || 1;\n  const defenderPn = opponentPlayerNum(attackerPn);\n\n  // \u2500\u2500 Combat-reaction pending states \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  // These block normal combat flow until resolved. Check in priority order.\n\n  // Pre-roll defensive reactions (set during attack declaration)\n  if (game.pendingStrikeMeDown) {\n    if (playerNum === game.pendingStrikeMeDown.defenderPlayerNum) {\n      return [\n        { type: 'strike_me_down_yes'\x2C customId: `strike_me_down_yes_${gameId}`\x2C description: 'Use Strike Me Down (reduce VP cost\x2C be defeated)' }\x2C\n        { type: 'strike_me_down_no'\x2C customId: `strike_me_down_no_${gameId}`\x2C description: 'Decline Strike Me Down' }\x2C\n      ];\n    }\n    return [];\n  }\n\n  if (game.pendingSlowOnTheDraw) {\n    if (playerNum === game.pendingSlowOnTheDraw.defenderPlayerNum) {\n      return [\n        { type: 'slow_on_draw_yes'\x2C customId: `slow_on_draw_yes_${gameId}`\x2C description: 'Interrupt: Attack Greedo first' }\x2C\n        { type: 'slow_on_draw_no'\x2C customId: `slow_on_draw_no_${gameId}`\x2C description: 'Decline Slow on the Draw' }\x2C\n      ];\n    }\n    return [];\n  }\n\n  if (game.pendingForceExhaustion) {\n    if (playerNum === game.pendingForceExhaustion.defenderPlayerNum) {\n      return [\n        { type: 'force_exhaustion_yes'\x2C customId: `force_exhaustion_yes_${gameId}`\x2C description: 'Use Force Exhaustion (Incapacitate The Child)' }\x2C\n        { type: 'force_exhaustion_no'\x2C customId: `force_exhaustion_no_${gameId}`\x2C description: 'Decline Force Exhaustion' }\x2C\n      ];\n    }\n    return [];\n  }\n\n  if (game.pendingIllicitArms) {\n    const ia = game.pendingIllicitArms;\n    if (playerNum === ia.playerNum) {\n      const iaActions = [];\n      // Generate CC pick options directly (bypass intermediate "use" step)\n      const hand = (ia.playerNum === 1 ? game.player1CcHand : game.player2CcHand) || [];\n      for (let i = 0; i < hand.length; i++) {\n        iaActions.push({\n          type: 'illicit_arms_pick'\x2C\n          customId: `illicit_arms_pick_${gameId}_${i}`\x2C\n          description: `Illicit Arms: Discard ${hand[i]} for +1 Hit`\x2C\n          params: { ccIndex: i\x2C ccName: hand[i] }\x2C\n        });\n      }\n      iaActions.push({\n        type: 'illicit_arms_skip'\x2C\n        customId: `illicit_arms_skip_${gameId}`\x2C\n        description: 'Decline Illicit Arms'\x2C\n      });\n      return iaActions;\n    }\n    return [];\n  }\n\n  // Post-attack-roll reactions\n  if (game.pendingPowerConverter) {\n    if (playerNum === attackerPn) {\n      return [\n        { type: 'power_converter_approve'\x2C customId: `power_converter_approve_${gameId}`\x2C description: 'Use Power Converter (swap/reroll attack die)' }\x2C\n        { type: 'power_converter_skip'\x2C customId: `power_converter_skip_${gameId}`\x2C description: 'Skip Power Converter' }\x2C\n      ];\n    }\n    return [];\n  }\n\n  // Post-defense-roll reactions\n  if (game.pendingThereIsNoTry) {\n    const tint = game.pendingThereIsNoTry;\n    const tintPn = tint.defenderPlayerNum ?? defenderPn;\n    if (playerNum === tintPn) {\n      const tintActions = [];\n      if (tint.pickedDieIdx == null) {\n        // Step 1: skip or pick a defense die\n        const defDice = combat.defenseDiceResults || [];\n        for (let i = 0; i < defDice.length; i++) {\n          tintActions.push({\n            type: 'there_is_no_try_die'\x2C\n            customId: `there_is_no_try_die_${gameId}_${i}`\x2C\n            description: `There Is No Try: Set die #${i + 1} (${defDice[i]?.color || 'white'})`\x2C\n            params: { dieIndex: i }\x2C\n          });\n        }\n        tintActions.push({\n          type: 'there_is_no_try_skip'\x2C\n          customId: `there_is_no_try_skip_${gameId}`\x2C\n          description: 'Skip There Is No Try'\x2C\n        });\n      } else {\n        // Step 2: pick a face for the chosen die\n        const dieIdx = tint.pickedDieIdx;\n        const die = (combat.defenseDiceResults || [])[dieIdx];\n        const color = die?.color || 'white';\n        const faces = color === 'black'\n          ? [{ b: 0\x2C e: 0\x2C d: 0 }\x2C { b: 1\x2C e: 0\x2C d: 0 }\x2C { b: 2\x2C e: 0\x2C d: 0 }\x2C { b: 1\x2C e: 1\x2C d: 0 }\x2C { b: 0\x2C e: 1\x2C d: 0 }\x2C { b: 0\x2C e: 0\x2C d: 1 }]\n          : [{ b: 0\x2C e: 0\x2C d: 0 }\x2C { b: 1\x2C e: 0\x2C d: 0 }\x2C { b: 1\x2C e: 1\x2C d: 0 }\x2C { b: 0\x2C e: 0\x2C d: 1 }];\n        for (const face of faces) {\n          tintActions.push({\n            type: 'there_is_no_try_face'\x2C\n            customId: `there_is_no_try_face_${gameId}_${dieIdx}_${face.b}_${face.e}_${face.d}`\x2C\n            description: `Set to ${face.b}B/${face.e}E${face.d ? '/Dodge' : ''}`\x2C\n            params: { dieIndex: dieIdx\x2C block: face.b\x2C evade: face.e\x2C dodge: face.d }\x2C\n          });\n        }\n      }\n      return tintActions;\n    }\n    return [];\n  }\n\n  // During-reroll reactions\n  if (game.pendingToughLuck) {\n    const tl = game.pendingToughLuck;\n    if (playerNum === game.toughLuckPlayerNum) {\n      return [\n        { type: 'tough_luck_remove'\x2C customId: `tough_luck_remove_${gameId}_${tl.idx}`\x2C description: 'Tough Luck: Remove rerolled die' }\x2C\n        { type: 'tough_luck_skip'\x2C customId: `tough_luck_skip_${gameId}`\x2C description: 'Skip Tough Luck' }\x2C\n      ];\n    }\n    return [];\n  }\n\n  // Combat sub-phase gate \u2014 both players must confirm between combat steps\n  if (combat.combatGate) {\n    const gate = combat.combatGate;\n    const isReady = playerNum === 1 ? gate.p1Ready : gate.p2Ready;\n    if (!isReady) {\n      actions.push({\n        type: ACTION_TYPES.COMBAT_GATE\x2C\n        customId: buildCustomId(ACTION_TYPES.COMBAT_GATE\x2C { gameId })\x2C\n        description: `Combat gate: ${gate.phase}`\x2C\n      });\n    }\n    return actions;\n  }\n\n  // Combat ready check \u2014 both players must confirm\n  if (!combat.p1Ready || !combat.p2Ready) {\n    const isReady = playerNum === 1 ? combat.p1Ready : combat.p2Ready;\n    if (!isReady) {\n      actions.push({\n        type: ACTION_TYPES.COMBAT_READY\x2C\n        customId: buildCustomId(ACTION_TYPES.COMBAT_READY\x2C { gameId })\x2C\n        description: 'Ready for combat'\x2C\n      });\n    }\n    return actions;\n  }\n\n  // Rolling phase \u2014 attacker rolls first\x2C then defender\n  if (!combat.attackRoll) {\n    if (playerNum === attackerPn) {\n      actions.push({\n        type: ACTION_TYPES.COMBAT_ROLL\x2C\n        customId: buildCustomId(ACTION_TYPES.COMBAT_ROLL\x2C { gameId })\x2C\n        description: 'Roll attack dice'\x2C\n      });\n    }\n    return actions;\n  }\n  if (!combat.defenseRoll) {\n    if (playerNum === defenderPn) {\n      actions.push({\n        type: ACTION_TYPES.COMBAT_ROLL\x2C\n        customId: buildCustomId(ACTION_TYPES.COMBAT_ROLL\x2C { gameId })\x2C\n        description: 'Roll defense dice'\x2C\n      });\n    }\n    return actions;\n  }\n\n  // Reroll phase \u2014 list each eligible die for reroll + done option\n  if (combat.rerollPhase) {\n    let rerollPn;\n    if (combat.rerollPhase === 'attacker') {\n      rerollPn = attackerPn;\n    } else if (combat.rerollPhase === 'forced') {\n      rerollPn = (combat.forcedRerollQueue || [])[0]?.controlPlayer ?? attackerPn;\n    } else {\n      rerollPn = defenderPn;\n    }\n    if (playerNum === rerollPn) {\n      const phase = combat.rerollPhase;\n      // For forced rerolls\x2C determine which dice pool based on queue entry\n      let sideKey\x2C rerollsRemaining\x2C diceResults\x2C alreadyRerolled;\n      if (phase === 'forced') {\n        const entry = (combat.forcedRerollQueue || [])[0];\n        rerollsRemaining = entry?.remaining ?? 0;\n        // Forced rerolls can target attack\x2C defense\x2C or any\n        const atkDice = combat.attackDiceResults || [];\n        const defDice = combat.defenseDiceResults || [];\n        const atkRerolled = combat.attackerRerolledIndices || [];\n        const defRerolled = combat.defenderRerolledIndices || [];\n        if (entry?.pool === 'attack' || entry?.pool === 'any') {\n          for (let i = 0; i < atkDice.length; i++) {\n            if (atkRerolled.includes(i)) continue;\n            actions.push({\n              type: ACTION_TYPES.COMBAT_REROLL\x2C\n              customId: buildCustomId(ACTION_TYPES.COMBAT_REROLL\x2C { gameId\x2C side: 'atk'\x2C dieIndex: i })\x2C\n              description: `Force reroll atk die ${i + 1} (${atkDice[i]?.color || 'unknown'})`\x2C\n              params: { side: 'atk'\x2C dieIndex: i }\x2C\n            });\n          }\n        }\n        if (entry?.pool === 'defense' || entry?.pool === 'any') {\n          for (let i = 0; i < defDice.length; i++) {\n            if (defRerolled.includes(i)) continue;\n            actions.push({\n              type: ACTION_TYPES.COMBAT_REROLL\x2C\n              customId: buildCustomId(ACTION_TYPES.COMBAT_REROLL\x2C { gameId\x2C side: 'def'\x2C dieIndex: i })\x2C\n              description: `Force reroll def die ${i + 1} (${defDice[i]?.color || 'unknown'})`\x2C\n              params: { side: 'def'\x2C dieIndex: i }\x2C\n            });\n          }\n        }\n        sideKey = 'atk'; // Used for done button\n      } else {\n        sideKey = phase === 'attacker' ? 'atk' : 'def';\n        rerollsRemaining = phase === 'attacker'\n          ? (combat.attackerRerollsRemaining ?? 0)\n          : (combat.defenderRerollsRemaining ?? 0);\n        diceResults = phase === 'attacker' ? combat.attackDiceResults : combat.defenseDiceResults;\n        alreadyRerolled = phase === 'attacker' ? (combat.attackerRerolledIndices || []) : (combat.defenderRerolledIndices || []);\n\n        if (rerollsRemaining > 0 && diceResults?.length) {\n          for (let i = 0; i < diceResults.length; i++) {\n            if (alreadyRerolled.includes(i)) continue;\n            actions.push({\n              type: ACTION_TYPES.COMBAT_REROLL\x2C\n              customId: buildCustomId(ACTION_TYPES.COMBAT_REROLL\x2C { gameId\x2C side: sideKey\x2C dieIndex: i })\x2C\n              description: `Reroll ${phase} die ${i + 1} (${diceResults[i]?.color || 'unknown'})`\x2C\n              params: { side: sideKey\x2C dieIndex: i }\x2C\n            });\n          }\n        }\n      }\n\n      // Done rerolling / skip\n      actions.push({\n        type: 'combat_reroll_done'\x2C\n        customId: `combat_reroll_${gameId}_${sideKey}_done`\x2C\n        description: 'Done rerolling'\x2C\n      });\n    }\n    return actions;\n  }\n\n  // Pending Hunter Protocol \u2014 attacker may re-trigger a surge ability\n  if (game.pendingHunterProtocol) {\n    if (playerNum === attackerPn) {\n      actions.push({\n        type: 'hunter_protocol_trigger'\x2C\n        customId: `hunter_protocol_trigger_${gameId}`\x2C\n        description: 'Trigger Hunter Protocol (re-use surge)'\x2C\n      });\n      actions.push({\n        type: 'hunter_protocol_skip'\x2C\n        customId: `hunter_protocol_skip_${gameId}`\x2C\n        description: 'Skip Hunter Protocol'\x2C\n      });\n    }\n    return actions;\n  }\n\n  // \u2500\u2500 Pre-resolution combat pending abilities \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  // These are set during resolution while pendingCombat still exists.\n  // They send Discord buttons and wait for player input before combat can continue.\n\n  if (game.pendingFigurehead) {\n    const fh = game.pendingFigurehead;\n    if (playerNum === fh.defenderPlayerNum) {\n      return [\n        { type: 'figurehead_use'\x2C customId: `figurehead_use_${gameId}`\x2C description: 'Use Figurehead (redirect attack)' }\x2C\n        { type: 'figurehead_skip'\x2C customId: `figurehead_skip_${gameId}`\x2C description: 'Skip Figurehead' }\x2C\n      ];\n    }\n    return [];\n  }\n\n  if (game.pendingCleave) {\n    const cl = game.pendingCleave;\n    if (playerNum === cl.attackerPlayerNum) {\n      return (cl.targets || []).map((t\x2C i) => ({\n        type: 'cleave_target'\x2C customId: `cleave_target_${gameId}_${i}`\x2C\n        description: `Cleave ${cl.surgeCleave || ''} to ${t.label}`\x2C\n      }));\n    }\n    return [];\n  }\n\n  if (game.pendingFightingKnife) {\n    const fk = game.pendingFightingKnife;\n    if (playerNum === fk.attackerPlayerNum) {\n      const acts = (fk.targets || []).map((t\x2C i) => ({\n        type: 'fighting_knife_target'\x2C customId: `fighting_knife_target_${gameId}_${i}`\x2C\n        description: `Fighting Knife: ${t.label}`\x2C\n      }));\n      acts.push({ type: 'fighting_knife_skip'\x2C customId: `fighting_knife_skip_${gameId}`\x2C description: 'Skip Fighting Knife' });\n      return acts;\n    }\n    return [];\n  }\n\n  if (game.pendingConcussiveBolt) {\n    const cb = game.pendingConcussiveBolt;\n    if (playerNum === cb.attackerPlayerNum) {\n      const acts = (cb.adjSpaces || []).slice(0\x2C 4).map((sp) => ({\n        type: 'concussive_bolt_push'\x2C customId: `concussive_bolt_push_${gameId}_${sp}`\x2C\n        description: `Push to ${String(sp).toUpperCase()}`\x2C\n      }));\n      acts.push({ type: 'concussive_bolt_skip'\x2C customId: `concussive_bolt_skip_${gameId}`\x2C description: 'Skip Concussive Bolt' });\n      return acts;\n    }\n    return [];\n  }\n\n  if (game.pendingExtraProtection) {\n    const ep = game.pendingExtraProtection;\n    if (playerNum === (ep.defenderPlayerNum || defenderPn)) {\n      return [\n        { type: 'extra_protection_play'\x2C customId: `extra_protection_play_${gameId}`\x2C description: 'Use Extra Protection' }\x2C\n        { type: 'extra_protection_skip'\x2C customId: `extra_protection_skip_${gameId}`\x2C description: 'Skip Extra Protection' }\x2C\n      ];\n    }\n    return [];\n  }\n\n  // Executor interrupt (Royal Guard Champion): fires during damage resolution when\n  // a friendly figure is defeated within 3 spaces. Blocks combat until resolved.\n  if (game.pendingExecutorInterrupt) {\n    const ex = game.pendingExecutorInterrupt;\n    if (playerNum === ex.rgcPlayerNum) {\n      return [\n        { type: 'executor_use'\x2C customId: `executor_use_${gameId}_${ex.rgcMsgId}`\x2C description: 'Use Executor (move 2 + free attack)' }\x2C\n        { type: 'executor_skip'\x2C customId: `executor_skip_${gameId}_${ex.rgcMsgId}`\x2C description: 'Skip Executor' }\x2C\n      ];\n    }\n    return [];\n  }\n\n  // Mid-combat pending sub-states: set during surge/token handling and resolved\n  // via buttons outside getCombatActions. Block ALL combat actions so the defender\n  // can't submit COMBAT_RESOLVE before the attacker resolves the sub-state.\n  if (game.pendingSpreadThePainCondPick || game.pendingRogueOneTokenPick ||\n      game.pendingSurgeOverflow || game.pendingZilloDiscard) {\n    return [];\n  }\n\n  // Surge assignment phase \u2014 list each spendable surge ability\n  if (combat.pendingSurges || combat.surgeRemaining > 0) {\n    if (playerNum === attackerPn) {\n      // Compute surge abilities dynamically (they're not stored on combat state)\n      const surgeKeys = getAttackerSurgeAbilities(combat);\n      const surgesRemaining = combat.surgeRemaining ?? 0;\n      // Overload (Rebel Saboteur): may trigger the same surge ability up to twice per attack\n      const atkDcName = dcNameFromFigureKey(combat.attackerFigureKey || '');\n      const atkEff = getDcEffects()?.[atkDcName] || getDcEffects()?.[(atkDcName || '').replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n      const maxSurgeUses = (atkEff?.specialAbilityIds || []).includes('overload_saboteur') ? 2 : 1;\n\n      for (let i = 0; i < surgeKeys.length; i++) {\n        const key = surgeKeys[i];\n        const isDouble = key.startsWith('double:');\n        const cost = isDouble ? 2 : 1;\n        if (cost > surgesRemaining) continue;\n        // Skip surges already spent the max number of times\n        if (((combat.surgeSpentCount || {})[i] || 0) >= maxSurgeUses) continue;\n\n        const label = SURGE_LABELS[key]\n          || SURGE_LABELS[key.replace('double:'\x2C '')]\n          || key;\n        actions.push({\n          type: ACTION_TYPES.COMBAT_SURGE\x2C\n          customId: buildCustomId(ACTION_TYPES.COMBAT_SURGE\x2C { gameId\x2C surgeIndex: i })\x2C\n          description: `Spend surge: ${label}`\x2C\n          params: { surgeIndex: i\x2C surgeKey: key\x2C cost }\x2C\n        });\n      }\n\n      // Skip remaining surges\n      actions.push({\n        type: ACTION_TYPES.COMBAT_SKIP_SURGES\x2C\n        customId: buildCustomId(ACTION_TYPES.COMBAT_RESOLVE\x2C { gameId })\x2C\n        description: 'Skip surges and resolve'\x2C\n      });\n    }\n    return actions;\n  }\n\n  // Both rolls done\x2C no rerolls\x2C no surges \u2014 ready to resolve\n  // This covers the case where proceedAfterRerolls/proceedAfterTokens already ran\n  if (combat.attackRoll && combat.defenseRoll) {\n    actions.push({\n      type: ACTION_TYPES.COMBAT_RESOLVE\x2C\n      customId: buildCustomId(ACTION_TYPES.COMBAT_RESOLVE\x2C { gameId })\x2C\n      description: 'Ready to resolve rolls'\x2C\n    });\n  }\n\n  return actions;\n}\n\n// \u2500\u2500 Movement Sub-flow \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getMovementActions(game\x2C playerNum\x2C deps) {\n  const actions = [];\n\n  for (const [moveKey\x2C moveState] of Object.entries(game.moveInProgress || {})) {\n    if (moveState.playerNum !== playerNum) continue;\n\n    // Movement in progress \u2014 pick space or adjust MP\n    if (moveState.phase === 'pick_space' || !moveState.phase) {\n      // Compute reachable spaces if deps available\n      if (deps.computeMovementCache && deps.getBoardStateForMovement && moveState.figureKey) {\n        try {\n          const board = deps.getBoardStateForMovement(game\x2C moveState.figureKey);\n          const startPos = moveState.currentPosition || moveState.startCoord;\n          const mpRemaining = moveState.mpRemaining ?? moveState.totalMp ?? 0;\n          // Use stored profile/cache from moveState if available\x2C else compute\n          const profile = moveState.movementProfile\n            || (deps.getMovementProfile\n              ? deps.getMovementProfile(moveState.dcName || ''\x2C moveState.figureKey\x2C game)\n              : {});\n          if (board && mpRemaining > 0 && startPos) {\n            const cache = deps.computeMovementCache(startPos\x2C mpRemaining\x2C board\x2C profile);\n            if (cache?.cells?.size > 0) {\n              for (const [coord\x2C info] of cache.cells) {\n                if (info.cost > 0 && info.cost <= mpRemaining) {\n                  actions.push({\n                    type: ACTION_TYPES.MOVE_PICK_SPACE\x2C\n                    customId: buildCustomId(ACTION_TYPES.MOVE_PICK_SPACE\x2C { moveKey\x2C coord })\x2C\n                    description: `Move to ${coord} (cost ${info.cost})`\x2C\n                    params: { moveKey\x2C coord\x2C cost: info.cost }\x2C\n                  });\n                }\n              }\n            }\n          }\n        } catch {\n          // Fall through to simple finish action\n        }\n      }\n\n      // Always offer finish movement\n      actions.push({\n        type: ACTION_TYPES.MOVE_PICK_SPACE\x2C\n        customId: `move_pick_${moveKey}_done`\x2C\n        description: 'Finish movement'\x2C\n        params: { moveKey\x2C done: true }\x2C\n      });\n    }\n  }\n\n  return actions;\n}\n\n// \u2500\u2500 Negation \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getNegationActions(game\x2C playerNum) {\n  const neg = game.pendingNegation;\n  if (!neg) return [];\n\n  const oppPn = opponentPlayerNum(neg.playedBy);\n  if (playerNum !== oppPn) return [];\n\n  return [\n    {\n      type: 'negation_play'\x2C\n      customId: `negation_play_${game.gameId}`\x2C\n      description: 'Play Negation'\x2C\n    }\x2C\n    {\n      type: 'negation_let_resolve'\x2C\n      customId: `negation_let_resolve_${game.gameId}`\x2C\n      description: 'Let card resolve'\x2C\n    }\x2C\n  ];\n}\n\n// \u2500\u2500 Comm Disruption \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getCommDisruptionActions(game\x2C playerNum) {\n  const cd = game.pendingCommDisruptionPrompt;\n  if (!cd || cd.targetPlayerNum !== playerNum) return [];\n  const gameId = game.gameId;\n  return [\n    { type: ACTION_TYPES.COMM_DISRUPTION_PLAY\x2C customId: buildCustomId(ACTION_TYPES.COMM_DISRUPTION_PLAY\x2C { gameId })\x2C description: 'Play Comm Disruption to cancel' }\x2C\n    { type: ACTION_TYPES.COMM_DISRUPTION_SKIP\x2C customId: buildCustomId(ACTION_TYPES.COMM_DISRUPTION_SKIP\x2C { gameId })\x2C description: 'Skip Comm Disruption' }\x2C\n  ];\n}\n\n// \u2500\u2500 Start of Round \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getStartOfRoundActions(game\x2C playerNum) {\n  return [{\n    type: ACTION_TYPES.END_START_OF_ROUND\x2C\n    customId: buildCustomId(ACTION_TYPES.END_START_OF_ROUND\x2C { gameId: game.gameId })\x2C\n    description: 'End Start of Round window'\x2C\n  }];\n}\n\n// \u2500\u2500 End of Round \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getEndOfRoundActions(game\x2C playerNum\x2C deps) {\n  const playerId = getPlayerId(game\x2C playerNum);\n\n  // Only the player whose turn it is in the EoR window can act\n  if (!game.endOfRoundWhoseTurn) return [];\n  if (game.endOfRoundWhoseTurn !== playerId) return [];\n\n  const actions = [{\n    type: ACTION_TYPES.END_END_OF_ROUND\x2C\n    customId: buildCustomId(ACTION_TYPES.END_END_OF_ROUND\x2C { gameId: game.gameId })\x2C\n    description: 'End "End of Round" window'\x2C\n  }];\n\n  // Append playable CCs (end-of-round timing window)\n  if (deps?.getPlayableCcFromHand) {\n    const hand = playerNum === 1 ? game.player1CcHand : game.player2CcHand;\n    if (hand?.length) {\n      const playable = deps.getPlayableCcFromHand(game\x2C playerNum\x2C hand);\n      const gameId = game.gameId;\n      for (let i = 0; i < playable.length; i++) {\n        actions.push({\n          type: ACTION_TYPES.PLAY_CC\x2C\n          customId: `cc_play_${gameId}_${playerNum}_${i}`\x2C\n          description: `Play CC: ${playable[i]}`\x2C\n          params: { cardIndex: i\x2C cardName: playable[i] }\x2C\n        });\n      }\n    }\n  }\n\n  return actions;\n}\n\n// \u2500\u2500 Legacy (no game.phase) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getLegacyActions(game\x2C playerNum\x2C deps) {\n  // For games without the phase system\x2C try to infer from flags\n  // This is a simplified fallback\n  if (game.phaseGate) return getPhaseGateActions(game\x2C playerNum);\n  if (game.pendingCombat) return getCombatActions(game\x2C playerNum\x2C deps);\n  if (game.currentActivationTurnPlayerId) {\n    return getActivationActions(game\x2C playerNum\x2C deps);\n  }\n  return [];\n}\n\n// \u2500\u2500 DC Ability Choice \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getDcAbilityChoiceActions(game\x2C playerNum\x2C deps) {\n  const actions = [];\n  const gameId = game.gameId;\n\n  for (const [key\x2C pending] of Object.entries(game.pendingDcAbilityChoice)) {\n    // Auto-clear dead-figure entries regardless of playerNum (prevents orphaned states)\n    if (deps?.dcHealthState && pending.msgId) {\n      const hs = deps.dcHealthState.get(pending.msgId);\n      const fi = pending.figureIndex ?? 0;\n      if (hs && hs[fi] && hs[fi][0] <= 0) {\n        delete game.pendingDcAbilityChoice[key];\n        continue;\n      }\n    }\n    if (pending.playerNum !== playerNum) continue;\n    // Choices can be stored as choiceOptions\x2C choices\x2C or targetFigureKeys\n    const choices = pending.choiceOptions || pending.choices || pending.targetFigureKeys || [];\n    if (choices.length === 0) {\n      delete game.pendingDcAbilityChoice[key];\n      continue;\n    }\n    for (let i = 0; i < choices.length; i++) {\n      const label = typeof choices[i] === 'string' ? choices[i] : choices[i]?.label || `Option ${i + 1}`;\n      actions.push({\n        type: ACTION_TYPES.DC_ABILITY_CHOICE\x2C\n        customId: buildCustomId(ACTION_TYPES.DC_ABILITY_CHOICE\x2C {\n          gameId\x2C msgId: pending.msgId\x2C specialIdx: pending.specialIdx\x2C choiceIndex: i\x2C\n        })\x2C\n        description: `Ability choice: ${label}`\x2C\n        params: { key\x2C choiceIndex: i\x2C label }\x2C\n      });\n    }\n  }\n\n  return actions;\n}\n\n// \u2500\u2500 Celebration \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getCelebrationActions(game\x2C playerNum) {\n  const pending = game.pendingCelebration;\n  if (!pending || pending.attackerPlayerNum !== playerNum) return [];\n\n  const handKey = playerNum === 1 ? 'player1CcHand' : 'player2CcHand';\n  const hasCelebration = (game[handKey] || []).includes('Celebration');\n\n  // If the player doesn't have Celebration\x2C auto-pass (clear pending state)\n  if (!hasCelebration) {\n    delete game.pendingCelebration;\n    return [];\n  }\n\n  return [\n    {\n      type: ACTION_TYPES.CELEBRATION_PLAY\x2C\n      customId: buildCustomId(ACTION_TYPES.CELEBRATION_PLAY\x2C { gameId: game.gameId })\x2C\n      description: 'Play Celebration'\x2C\n    }\x2C\n    {\n      type: ACTION_TYPES.CELEBRATION_PASS\x2C\n      customId: buildCustomId(ACTION_TYPES.CELEBRATION_PASS\x2C { gameId: game.gameId })\x2C\n      description: 'Skip Celebration'\x2C\n    }\x2C\n  ];\n}\n\n// \u2500\u2500 Pounce Space \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getPounceSpaceActions(game\x2C playerNum\x2C deps) {\n  const actions = [];\n  const gameId = game.gameId;\n\n  for (const [msgId\x2C pending] of Object.entries(game.pendingPounceSpaceChoice)) {\n    // Auto-clear dead-figure entries regardless of playerNum (prevents orphaned states)\n    if (deps?.dcHealthState) {\n      const hs = deps.dcHealthState.get(msgId);\n      const fi = pending.figureIndex ?? 0;\n      if (hs && hs[fi] && hs[fi][0] <= 0) {\n        delete game.pendingPounceSpaceChoice[msgId];\n        continue;\n      }\n    }\n    if (pending.playerNum !== playerNum) continue;\n    const spaces = pending.validSpaces || [];\n    if (spaces.length === 0) {\n      delete game.pendingPounceSpaceChoice[msgId];\n      continue;\n    }\n    for (const space of spaces) {\n      actions.push({\n        type: ACTION_TYPES.POUNCE_SPACE\x2C\n        customId: buildCustomId(ACTION_TYPES.POUNCE_SPACE\x2C {\n          gameId\x2C msgId\x2C figureIndex: pending.figureIndex ?? 0\x2C space\x2C\n        })\x2C\n        description: `Pounce to ${space}`\x2C\n        params: { msgId\x2C space }\x2C\n      });\n    }\n  }\n\n  return actions;\n}\n\n// \u2500\u2500 Missile Salvo \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getMissileSalvoActions(game\x2C playerNum) {\n  const actions = [];\n  const gameId = game.gameId;\n\n  for (const [msgId\x2C pending] of Object.entries(game.pendingMissileSalvo)) {\n    if (pending.playerNum !== playerNum) continue;\n    const dice = pending.diceAvailable || [];\n    for (const color of dice) {\n      actions.push({\n        type: ACTION_TYPES.MISSILE_SALVO_DIE\x2C\n        customId: buildCustomId(ACTION_TYPES.MISSILE_SALVO_DIE\x2C { gameId\x2C msgId\x2C color })\x2C\n        description: `Missile Salvo: ${color} die`\x2C\n        params: { msgId\x2C color }\x2C\n      });\n    }\n    actions.push({\n      type: ACTION_TYPES.MISSILE_SALVO_DONE\x2C\n      customId: buildCustomId(ACTION_TYPES.MISSILE_SALVO_DONE\x2C { gameId\x2C msgId })\x2C\n      description: 'End Missile Salvo'\x2C\n      params: { msgId }\x2C\n    });\n  }\n\n  return actions;\n}\n\n// \u2500\u2500 Power Token Choice \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getPowerTokenActions(game\x2C playerNum) {\n  const pending = game.pendingPowerTokenGrant;\n  if (!pending || pending.playerNum !== playerNum) return [];\n\n  const gameId = game.gameId;\n  const tokenTypes = ['hit'\x2C 'surge'\x2C 'block'\x2C 'evade'];\n\n  return tokenTypes.map(tokenType => ({\n    type: ACTION_TYPES.POWER_TOKEN_CHOICE\x2C\n    customId: buildCustomId(ACTION_TYPES.POWER_TOKEN_CHOICE\x2C { gameId\x2C tokenType })\x2C\n    description: `Choose ${tokenType} power token`\x2C\n    params: { tokenType }\x2C\n  }));\n}\n\n// \u2500\u2500 Power Token Overflow Discard \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getOverflowActions(game\x2C playerNum) {\n  const overflowArr = game.pendingPowerTokenOverflow;\n  if (!overflowArr?.length) return [];\n  const entry = overflowArr[0];\n  const { figureKey } = entry;\n  // Determine which player owns this figure\n  const ownerPn = Object.entries(game.figurePositions || {}).find(([\x2C figs]) => figs[figureKey])?.[0];\n  if (ownerPn && Number(ownerPn) !== playerNum) return [];\n  const tokens = game.figurePowerTokens?.[figureKey] || [];\n  const gameId = game.gameId;\n  return tokens.map((tokenType\x2C i) => ({\n    type: ACTION_TYPES.PT_OVERFLOW_DISCARD\x2C\n    customId: `pt_overflow_${gameId}_${playerNum}_${figureKey}_${i}`\x2C\n    description: `Discard ${tokenType} token (overflow)`\x2C\n    params: { figureKey\x2C tokenIndex: i\x2C tokenType }\x2C\n  }));\n}\n\n// \u2500\u2500 Cover Fire \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getCoverFireActions(game\x2C playerNum) {\n  const pending = game.pendingCoverFire;\n  if (!pending || pending.attackerPlayerNum !== playerNum) return [];\n\n  const actions = [];\n  const gameId = game.gameId;\n\n  // Offer friendly figures near the target as block token recipients\n  const figs = game.figurePositions?.[playerNum] || {};\n  for (const figureKey of Object.keys(figs)) {\n    actions.push({\n      type: ACTION_TYPES.COVER_FIRE_BLOCK\x2C\n      customId: buildCustomId(ACTION_TYPES.COVER_FIRE_BLOCK\x2C { gameId\x2C playerNum\x2C figureKey })\x2C\n      description: `Cover Fire: grant block to ${figureKey}`\x2C\n      params: { figureKey }\x2C\n    });\n  }\n\n  // Always offer skip\n  actions.push({\n    type: ACTION_TYPES.COVER_FIRE_SKIP\x2C\n    customId: buildCustomId(ACTION_TYPES.COVER_FIRE_SKIP\x2C { gameId })\x2C\n    description: 'Skip Cover Fire'\x2C\n  });\n\n  return actions;\n}\n\n// \u2500\u2500 Strain Choice \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getStrainChoiceActions(game\x2C playerNum) {\n  const pending = game.pendingStrainChoice;\n  if (!pending || !pending.playerNum || pending.playerNum !== playerNum) return [];\n\n  const gameId = game.gameId;\n  const actions = [];\n\n  // Always offer "take all as damage"\n  actions.push({\n    type: ACTION_TYPES.STRAIN_CHOICE_ALLDMG\x2C\n    customId: buildCustomId(ACTION_TYPES.STRAIN_CHOICE_ALLDMG\x2C { gameId })\x2C\n    description: `Take all strain as damage (${pending.amount} HP)`\x2C\n    params: { amount: pending.amount }\x2C\n  });\n\n  // Offer CC discard options (1..maxDiscards) \u2014 rules: discard from deck top\x2C not hand\n  const deckKey = `player${pending.playerNum}CcDeck`;\n  const deck = game[deckKey] || [];\n  const ccCostPerStrain = pending.ccCostPerStrain || 1;\n  const maxDiscards = pending.amount > 0 ? Math.min(pending.amount\x2C Math.floor(deck.length / ccCostPerStrain)) : 0;\n  for (let i = 1; i <= maxDiscards; i++) {\n    const hpRemaining = pending.amount - i;\n    const ccCost = i * ccCostPerStrain;\n    actions.push({\n      type: ACTION_TYPES.STRAIN_CHOICE_DISCARD\x2C\n      customId: buildCustomId(ACTION_TYPES.STRAIN_CHOICE_DISCARD\x2C { gameId\x2C discardCount: i })\x2C\n      description: `Discard ${ccCost} CC${ccCost > 1 ? 's' : ''}${hpRemaining > 0 ? ` + ${hpRemaining} HP` : ''}`\x2C\n      params: { discardCount: i\x2C ccCost\x2C hpRemaining }\x2C\n    });\n  }\n\n  return actions;\n}\n\n// \u2500\u2500 Force Vision (Kanan Jarrus) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getForceVisionPickActions(game\x2C playerNum) {\n  const actions = [];\n  const gameId = game.gameId;\n  const dcList = getDcList(game\x2C playerNum) || [];\n  const activatedIndices = getActivatedDcIndices(game\x2C playerNum) || [];\n  for (let i = 0; i < dcList.length; i++) {\n    if (activatedIndices.includes(i)) continue;\n    const dc = dcList[i];\n    const figs = game.figurePositions?.[playerNum] || {};\n    const alive = Object.keys(figs).some(fk => fk.startsWith(dc.dcName + '-'));\n    if (!alive) continue;\n    actions.push({\n      type: 'force_vision_pick'\x2C\n      customId: `fv_pick_${gameId}_${playerNum}_${i}`\x2C\n      description: `Force Vision: choose ${dc.displayName || dc.dcName}`\x2C\n      params: { dcIndex: i\x2C dcName: dc.dcName }\x2C\n    });\n  }\n  return actions;\n}\n\n// \u2500\u2500 Spread the Pain \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getSpreadThePainActions(game\x2C playerNum) {\n  const pending = game.pendingSpreadThePainCondPick;\n  if (!pending || pending.attackerPlayerNum !== playerNum) return [];\n\n  const gameId = game.gameId;\n  const conditions = ['stun'\x2C 'weaken'\x2C 'bleed'\x2C 'skip'];\n\n  return conditions.map(condition => ({\n    type: ACTION_TYPES.SPREAD_PAIN_COND\x2C\n    customId: buildCustomId(ACTION_TYPES.SPREAD_PAIN_COND\x2C { gameId\x2C condition })\x2C\n    description: condition === 'skip' ? 'Skip Spread the Pain' : `Spread the Pain: ${condition}`\x2C\n    params: { condition }\x2C\n  }));\n}\n\n// \u2500\u2500 Still Faster Than You \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getStillFasterActions(game\x2C playerNum) {\n  const pending = game.pendingStillFaster;\n  if (!pending || pending.sftPlayerNum !== playerNum) return [];\n\n  const gameId = game.gameId;\n  const actMsgId = pending.activatingMsgId;\n\n  return [\n    {\n      type: 'still_faster_use'\x2C\n      customId: `still_faster_use_${gameId}_${actMsgId}`\x2C\n      description: 'Interrupt: Still Faster Than You'\x2C\n    }\x2C\n    {\n      type: 'still_faster_skip'\x2C\n      customId: `still_faster_skip_${gameId}_${actMsgId}`\x2C\n      description: 'Skip Still Faster Than You'\x2C\n    }\x2C\n  ];\n}\n\n// \u2500\u2500 Last Resort \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getLastResortActions(game\x2C playerNum) {\n  const pending = game.pendingLastResort;\n  if (!pending || pending.defenderPlayerNum !== playerNum) return [];\n\n  const gameId = game.gameId;\n  const targetMsgId = pending.targetMsgId;\n\n  return [\n    {\n      type: 'last_resort_use'\x2C\n      customId: `last_resort_use_${gameId}_${targetMsgId}`\x2C\n      description: 'Use Last Resort (AoE damage before defeat)'\x2C\n    }\x2C\n    {\n      type: 'last_resort_skip'\x2C\n      customId: `last_resort_skip_${gameId}_${targetMsgId}`\x2C\n      description: 'Skip Last Resort'\x2C\n    }\x2C\n  ];\n}\n\n// \u2500\u2500 EE-3 Carbine Die Pick \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getEe3CarbineActions(game\x2C playerNum\x2C deps) {\n  const pending = game.pendingEe3Carbine;\n  if (!pending || typeof pending !== 'object') return [];\n  for (const [msgId\x2C val] of Object.entries(pending)) {\n    if (!val || val === 'decided' || typeof val !== 'object') continue;\n    if (val.playerNum !== playerNum) continue;\n    const gameId = game.gameId;\n    const figureIndex = val.figureIndex ?? 0;\n    // Get base dice to find non-red colors\n    const dcMeta = deps.dcMessageMeta?.get(msgId);\n    const stats = dcMeta ? deps.getDcStats?.(dcMeta.dcName) : null;\n    const baseDice = stats?.attack?.dice || ['red'];\n    const nonRedColors = [...new Set(baseDice.filter(d => d !== 'red'))];\n    const actions = nonRedColors.map(color => ({\n      type: ACTION_TYPES.EE3_PICK_DIE\x2C\n      customId: buildCustomId(ACTION_TYPES.EE3_PICK_DIE\x2C { gameId\x2C msgId\x2C figureIndex\x2C color })\x2C\n      description: `EE-3 Carbine: upgrade ${color} \u2192 Red`\x2C\n      params: { color\x2C msgId\x2C figureIndex }\x2C\n    }));\n    actions.push({\n      type: ACTION_TYPES.EE3_PICK_SKIP\x2C\n      customId: buildCustomId(ACTION_TYPES.EE3_PICK_SKIP\x2C { gameId\x2C msgId\x2C figureIndex })\x2C\n      description: 'Skip EE-3 Carbine'\x2C\n      params: { msgId\x2C figureIndex }\x2C\n    });\n    return actions;\n  }\n  return [];\n}\n\n// \u2500\u2500 Bo-Rifle Weapon Pick \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getBoRifleActions(game\x2C playerNum\x2C deps) {\n  const pending = game.pendingBoRifle;\n  if (!pending || typeof pending !== 'object') return [];\n  for (const [msgId\x2C val] of Object.entries(pending)) {\n    if (!val || typeof val !== 'object') continue;\n    if (val.playerNum !== playerNum) continue;\n    const gameId = game.gameId;\n    const figureIndex = val.figureIndex ?? 0;\n    return [\n      {\n        type: ACTION_TYPES.BO_RIFLE_USE\x2C\n        customId: buildCustomId(ACTION_TYPES.BO_RIFLE_USE\x2C { gameId\x2C msgId\x2C figureIndex })\x2C\n        description: 'Bo-Rifle: Melee mode'\x2C\n        params: { msgId\x2C figureIndex }\x2C\n      }\x2C\n      {\n        type: ACTION_TYPES.BO_RIFLE_SKIP\x2C\n        customId: buildCustomId(ACTION_TYPES.BO_RIFLE_SKIP\x2C { gameId\x2C msgId\x2C figureIndex })\x2C\n        description: 'Bo-Rifle: Normal ranged'\x2C\n        params: { msgId\x2C figureIndex }\x2C\n      }\x2C\n    ];\n  }\n  return [];\n}\n\n// \u2500\u2500 Arsenal Pick \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getArsenalPickActions(game\x2C playerNum\x2C msgId\x2C deps) {\n  const dcMeta = deps.dcMessageMeta?.get(msgId);\n  if (!dcMeta || dcMeta.playerNum !== playerNum) return [];\n  const dcEffects = getDcEffects()?.[dcMeta.dcName];\n  const specialIds = dcEffects?.specialAbilityIds || [];\n  const hasArsenal = specialIds.includes('arsenal');\n  const hasEpicArsenal = specialIds.includes('epic_arsenal');\n  if (!hasArsenal && !hasEpicArsenal) return [];\n  if (game.pendingOverrideAttackDice?.[msgId]) return []; // already picked\n  const gameId = game.gameId;\n  const data = game.dcActionsData?.[msgId];\n  const figureIndex = data?.selectedFigure ?? 0;\n  // Arsenal: 2 dice combos; Epic Arsenal: 3 dice combos\n  const diceCount = hasEpicArsenal ? 3 : 2;\n  const colors = ['red'\x2C 'blue'\x2C 'yellow'\x2C 'green'];\n  const combos = [];\n  if (diceCount === 2) {\n    for (let i = 0; i < colors.length; i++)\n      for (let j = i; j < colors.length; j++)\n        combos.push(`${colors[i]}\x2C${colors[j]}`);\n  } else {\n    for (let i = 0; i < colors.length; i++)\n      for (let j = i; j < colors.length; j++)\n        for (let k = j; k < colors.length; k++) {\n          if (colors[i] === colors[j] && colors[j] === colors[k]) continue;\n          combos.push(`${colors[i]}\x2C${colors[j]}\x2C${colors[k]}`);\n        }\n  }\n  return combos.map(combo => ({\n    type: ACTION_TYPES.ARSENAL_PICK\x2C\n    customId: buildCustomId(ACTION_TYPES.ARSENAL_PICK\x2C { gameId\x2C msgId\x2C figureIndex })\x2C\n    description: `Arsenal: ${combo}`\x2C\n    params: { msgId\x2C figureIndex\x2C diceCombo: combo }\x2C\n    selectValues: [combo]\x2C\n  }));\n}\n\n// \u2500\u2500 CC Confirmation \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getCcConfirmActions(game\x2C playerNum) {\n  const pending = game.pendingCcConfirmation;\n  if (!pending || pending.playerNum !== playerNum) return [];\n  const gameId = game.gameId;\n  return [\n    { type: ACTION_TYPES.CC_CONFIRM_PLAY\x2C customId: buildCustomId(ACTION_TYPES.CC_CONFIRM_PLAY\x2C { gameId })\x2C description: `Confirm play: ${pending.card}` }\x2C\n    { type: ACTION_TYPES.CC_CANCEL_PLAY\x2C customId: buildCustomId(ACTION_TYPES.CC_CANCEL_PLAY\x2C { gameId })\x2C description: 'Cancel CC play' }\x2C\n  ];\n}\n\n// \u2500\u2500 CC Choice \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getCcChoiceActions(game\x2C playerNum) {\n  const pending = game.pendingCcChoice;\n  if (!pending || pending.playerNum !== playerNum) return [];\n  const gameId = game.gameId;\n  const options = pending.choiceOptions || [];\n  return options.map((opt\x2C i) => ({\n    type: ACTION_TYPES.CC_CHOICE\x2C\n    customId: buildCustomId(ACTION_TYPES.CC_CHOICE\x2C { gameId\x2C choiceIndex: i })\x2C\n    description: `CC choice: ${typeof opt === 'string' ? opt : opt.label || `Option ${i}`}`\x2C\n    params: { choiceIndex: i }\x2C\n  }));\n}\n\n// \u2500\u2500 CC Space Choice \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getCcSpaceActions(game\x2C playerNum) {\n  const pending = game.pendingCcSpaceChoice;\n  if (!pending || pending.playerNum !== playerNum) return [];\n  const gameId = game.gameId;\n  const validSpaces = pending.validSpaces || [];\n  return validSpaces.map(space => ({\n    type: ACTION_TYPES.CC_SPACE\x2C\n    customId: buildCustomId(ACTION_TYPES.CC_SPACE\x2C { gameId\x2C space: String(space).toLowerCase() })\x2C\n    description: `CC space: ${String(space).toUpperCase()}`\x2C\n    params: { space: String(space).toLowerCase() }\x2C\n  }));\n}\n\n// \u2500\u2500 Rush Push \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getRushPushActions(game\x2C playerNum) {\n  const pending = game.pendingRushPush;\n  if (!pending || pending.playerNum !== playerNum) return [];\n  const gameId = game.gameId;\n  const msgId = pending.msgId;\n  const targets = pending.targets || [];\n  const actions = targets.map((fk\x2C i) => ({\n    type: ACTION_TYPES.RUSH_PUSH_FIG\x2C\n    customId: buildCustomId(ACTION_TYPES.RUSH_PUSH_FIG\x2C { gameId\x2C msgId\x2C choiceIndex: i })\x2C\n    description: `Rush: target ${dcNameFromFigureKey(fk)}`\x2C\n    params: { choiceIndex: i\x2C figureKey: fk }\x2C\n  }));\n  actions.push({\n    type: ACTION_TYPES.RUSH_PUSH_SKIP\x2C\n    customId: buildCustomId(ACTION_TYPES.RUSH_PUSH_SKIP\x2C { gameId\x2C msgId })\x2C\n    description: 'Skip Rush'\x2C\n  });\n  return actions;\n}\n\n// \u2500\u2500 Shoulder Rush \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getShoulderRushActions(game\x2C playerNum) {\n  const pending = game.pendingShoulderRush;\n  if (!pending || pending.playerNum !== playerNum) return [];\n  const gameId = game.gameId;\n  const msgId = pending.msgId;\n  const targets = pending.targets || [];\n  const actions = targets.map((fk\x2C i) => ({\n    type: ACTION_TYPES.SHOULDER_RUSH_FIG\x2C\n    customId: buildCustomId(ACTION_TYPES.SHOULDER_RUSH_FIG\x2C { gameId\x2C msgId\x2C choiceIndex: i })\x2C\n    description: `Shoulder Rush: target ${dcNameFromFigureKey(fk)}`\x2C\n    params: { choiceIndex: i\x2C figureKey: fk }\x2C\n  }));\n  actions.push({\n    type: ACTION_TYPES.SHOULDER_RUSH_SKIP\x2C\n    customId: buildCustomId(ACTION_TYPES.SHOULDER_RUSH_SKIP\x2C { gameId\x2C msgId })\x2C\n    description: 'Skip Shoulder Rush'\x2C\n  });\n  return actions;\n}\n\n// \u2500\u2500 False Orders / Lure \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getFalseOrdersActions(game\x2C playerNum) {\n  const fo = game.pendingFalseOrders;\n  if (!fo || fo.controllerPlayerNum !== playerNum) return [];\n  const gameId = game.gameId;\n  const msgId = fo.murneRinMsgId || fo.msgId;\n  return [\n    { type: ACTION_TYPES.FALSE_ORDERS_MOVE\x2C customId: buildCustomId(ACTION_TYPES.FALSE_ORDERS_MOVE\x2C { gameId\x2C msgId })\x2C description: `False Orders: move ${dcNameFromFigureKey(fo.controlledFigureKey)}` }\x2C\n    { type: ACTION_TYPES.FALSE_ORDERS_ATTACK\x2C customId: buildCustomId(ACTION_TYPES.FALSE_ORDERS_ATTACK\x2C { gameId\x2C msgId })\x2C description: `False Orders: attack with ${dcNameFromFigureKey(fo.controlledFigureKey)}` }\x2C\n    { type: ACTION_TYPES.FALSE_ORDERS_SKIP\x2C customId: buildCustomId(ACTION_TYPES.FALSE_ORDERS_SKIP\x2C { gameId\x2C msgId })\x2C description: 'Skip False Orders' }\x2C\n  ];\n}\n\n// \u2500\u2500 Overwatch Placement \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getOverwatchPlacementActions(game\x2C playerNum\x2C deps) {\n  const pending = game.pendingOverwatchPlacement;\n  if (!pending) return [];\n  // Find msgId entries for this player\n  const getMapDataFn = deps.getMapData;\n  const dcMeta = deps.dcMessageMeta;\n  for (const [msgId\x2C val] of Object.entries(pending)) {\n    if (!val) continue;\n    const meta = dcMeta?.get(msgId);\n    if (meta && meta.playerNum !== playerNum) continue;\n    // Return space options from map\n    const mapId = game.selectedMap?.id;\n    const ms = getMapDataFn?.(mapId);\n    const allSpaces = ms?.adjacency ? Object.keys(ms.adjacency) : [];\n    if (allSpaces.length === 0) continue;\n    const gameId = game.gameId;\n    return allSpaces.slice(0\x2C 25).map(space => ({\n      type: ACTION_TYPES.OVERWATCH_SPACE\x2C\n      customId: buildCustomId(ACTION_TYPES.OVERWATCH_SPACE\x2C { gameId\x2C msgId\x2C space })\x2C\n      description: `Overwatch: place at ${String(space).toUpperCase()}`\x2C\n      params: { space\x2C msgId }\x2C\n    }));\n  }\n  return [];\n}\n\n// \u2500\u2500 Orbital Bombardment \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getOrbitalBombardmentActions(game\x2C playerNum\x2C deps) {\n  const pending = game.pendingOrbitalBombardment;\n  if (!pending || pending.playerNum !== playerNum) return [];\n  const getMapDataFn = deps.getMapData;\n  const mapId = game.selectedMap?.id;\n  const ms = getMapDataFn?.(mapId);\n  const allSpaces = ms?.adjacency ? Object.keys(ms.adjacency) : [];\n  if (allSpaces.length === 0) return [];\n  const gameId = game.gameId;\n  const msgId = pending.msgId;\n  return allSpaces.slice(0\x2C 25).map(space => ({\n    type: ACTION_TYPES.OB_SPACE\x2C\n    customId: buildCustomId(ACTION_TYPES.OB_SPACE\x2C { gameId\x2C msgId\x2C space })\x2C\n    description: `Orbital Bombardment: space ${String(space).toUpperCase()}`\x2C\n    params: { space\x2C msgId }\x2C\n  }));\n}\n\n// \u2500\u2500 Bomb Drop \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getBombDropActions(game\x2C playerNum\x2C deps) {\n  const pending = game.pendingBombDrop;\n  if (!pending) return [];\n  const dcMeta = deps.dcMessageMeta;\n  for (const [msgId\x2C val] of Object.entries(pending)) {\n    if (!val) continue;\n    const meta = dcMeta?.get(msgId);\n    if (meta && meta.playerNum !== playerNum) continue;\n    const getMapDataFn = deps.getMapData;\n    const mapId = game.selectedMap?.id;\n    const ms = getMapDataFn?.(mapId);\n    const allSpaces = ms?.adjacency ? Object.keys(ms.adjacency) : [];\n    if (allSpaces.length === 0) continue;\n    const gameId = game.gameId;\n    return allSpaces.slice(0\x2C 25).map(space => ({\n      type: ACTION_TYPES.BOMB_DROP_SPACE\x2C\n      customId: buildCustomId(ACTION_TYPES.BOMB_DROP_SPACE\x2C { gameId\x2C msgId\x2C space })\x2C\n      description: `Bomb Drop: space ${String(space).toUpperCase()}`\x2C\n      params: { space\x2C msgId }\x2C\n    }));\n  }\n  return [];\n}\n\n// \u2500\u2500 Helpers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction getDcListForPlayer(game\x2C playerNum) {\n  if (playerNum === 1) return game.player1Squad?.dcList || [];\n  return game.player2Squad?.dcList || [];\n}\n\n/**\n * Compute valid attack targets for a given figure.\n * Simplified version of dc-play-area.js target computation for headless use.\n * Returns array of { figureKey\x2C coord\x2C label\x2C hasLOS\x2C dist }.\n *\n * Known gaps vs Discord's buildAndSendAttackTargets (dc-play-area.js:1000):\n * - Priority Target (abilityText-driven forced targeting)\n * - Fire Mission (remote attack delegation)\n * - Droid Arm (Migs Mayfeld melee override)\n * - Vanish immunity bypass\n * These are intentionally deferred from headless backfill.\n */\nfunction computeAttackTargets(game\x2C msgId\x2C meta\x2C figureIndex\x2C playerNum\x2C deps) {\n  const getDcStats = deps.getDcStats;\n  const getMapData = deps.getMapData;\n  if (!getDcStats || !getMapData || !game.selectedMap?.id) return [];\n\n  const stats = getDcStats(meta.dcName);\n  const attackInfo = stats?.attack;\n  if (!attackInfo) return [];\n\n  // Determine attacker position\n  const dgMatch = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/);\n  const dgIndex = dgMatch ? dgMatch[1] : '1';\n  const figureKey = `${meta.dcName}-${dgIndex}-${figureIndex}`;\n  const attackerPos = game.figurePositions?.[playerNum]?.[figureKey];\n  if (!attackerPos) return [];\n\n  // Range: melee = 1\x2C ranged = capped by max possible accuracy from dice + surges.\n  // Previous default [1\x2C20] allowed offering targets that could never be hit (e.g.\n  // blue+red pool has max accuracy 5 \u2014 attacking at distance 8 is guaranteed miss).\n  const isRanged = attackInfo.type === 'range';\n  const MAX_ACC_PER_DIE = { blue: 5\x2C green: 3\x2C yellow: 2\x2C red: 0 };\n  let maxDiceAcc = 0;\n  for (const die of attackInfo.dice || []) maxDiceAcc += MAX_ACC_PER_DIE[die] || 0;\n  // Check DC surge abilities for accuracy surges (e.g. "accuracy 2")\n  const _aaEff = getDcEffects()?.[meta.dcName] || getDcEffects()?.[meta.dcName?.replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n  let maxSurgeAcc = 0;\n  for (const sa of _aaEff?.surgeAbilities || []) {\n    const m = sa.match(/^accuracy\\s+(\\d+)$/i);\n    if (m) maxSurgeAcc = Math.max(maxSurgeAcc\x2C parseInt(m[1]\x2C 10));\n  }\n  const accuracyCeiling = maxDiceAcc + maxSurgeAcc;\n  let [minRange\x2C maxRange] = attackInfo.range || (isRanged ? [1\x2C Math.max(1\x2C accuracyCeiling)] : [1\x2C 1]);\n  // Even with explicit range\x2C cap by accuracy ceiling for ranged attacks \u2014\n  // a weapon with range [1\x2C12] but max accuracy 5 can't hit past 5.\n  if (isRanged && accuracyCeiling > 0) maxRange = Math.min(maxRange\x2C accuracyCeiling);\n  // Reach: melee attackers extend maxRange from 1 to 2 when any of these\n  // are true \u2014 REACH keyword\x2C REACH passive\x2C game.nextAttackReach flag\x2C\n  // [Fury of Kashyyyk] attachment for WOOKIEE attackers\x2C or a loadout card\n  // whose passive === 'Reach' (e.g. Electrostaff). Per CRR\n  // (RULES_REFERENCE.md:1933\x2C 2401\x2C 2404)\x2C Reach melee can target within\n  // 2 spaces.\n  if (!isRanged) {\n    const _reachKws = (_aaEff?.keywords || []).map(k => String(k).toUpperCase());\n    const _reachPassives = (_aaEff?.passives || []).map(p => String(p).toUpperCase());\n    const _hasFury = _reachKws.includes('WOOKIEE')\n      && (getDcList(game\x2C playerNum) || []).some(dc => dc.dcName === '[Fury of Kashyyyk]');\n    const _loadoutName = getConfig(game\x2C figureKey)?.loadout;\n    const _loadoutReach = _loadoutName ? getLoadoutCards()?.[_loadoutName]?.passive === 'Reach' : false;\n    const _hasReach =\n      _reachKws.includes('REACH') ||\n      _reachPassives.includes('REACH') ||\n      !!game.nextAttackReach?.[playerNum] ||\n      _hasFury ||\n      _loadoutReach;\n    if (_hasReach && maxRange < 2) maxRange = 2;\n  }\n  const ms = getMapData(game.selectedMap.id);\n  if (!ms) return [];\n  const _aaMapId = game.selectedMap.id;\n  const _aaAllDoors = getMapTokensData()?.[_aaMapId]?.doors || [];\n  const _aaOpenedSet = new Set((game.openedDoors || []).map(k => String(k).toLowerCase()));\n  const _aaClosedEdgePairs = _aaAllDoors.filter(e => {\n    const a = String(e[0]).toLowerCase()\x2C b = String(e[1]).toLowerCase();\n    return !_aaOpenedSet.has(`${a}|${b}`) && !_aaOpenedSet.has(`${b}|${a}`);\n  });\n  const _aaClosedDoorEdges = new Set(_aaClosedEdgePairs.map(e => edgeKey(e[0]\x2C e[1])));\n  // LOS effectiveMs (parity with dc-play-area.js:937-970): merge closed-door\n  // edges into impassableEdges so doors block LOS\x2C merge energy-shield and\n  // smoke spaces into blocking (CRR p.28 + C54 Smoke Grenade)\x2C and subtract\n  // currently-broken Wasskah walls from the base impassableEdges so LOS can\n  // pass through them (mission rule \u2014 wall between two difficult-terrain\n  // spaces does not block LOS).\n  const _aaShieldSpaces = (game.ancillaryTokens?.energyShield || []).map(s => String(s).toLowerCase());\n  const _aaSmokeSpaces = (game.ancillaryTokens?.smoke || []).map(s => String(s).toLowerCase());\n  const _aaExtraBlocking = [..._aaShieldSpaces\x2C ..._aaSmokeSpaces];\n  const _aaBrokenWalls = getBrokenWallEdges(game\x2C ms);\n  const _aaBaseImpassable = ms.impassableEdges || [];\n  const _aaFilteredImpassable = _aaBrokenWalls.size > 0\n    ? _aaBaseImpassable.filter(e => !_aaBrokenWalls.has(edgeKey(e[0]\x2C e[1])))\n    : _aaBaseImpassable;\n  const _aaNeedsEffective = _aaClosedEdgePairs.length > 0 || _aaExtraBlocking.length > 0 || _aaBrokenWalls.size > 0;\n  const _aaEffectiveMs = _aaNeedsEffective\n    ? {\n        ...ms\x2C\n        impassableEdges: _aaClosedEdgePairs.length > 0\n          ? [..._aaFilteredImpassable\x2C ..._aaClosedEdgePairs]\n          : _aaFilteredImpassable\x2C\n        blocking: _aaExtraBlocking.length > 0\n          ? [...(ms.blocking || [])\x2C ..._aaExtraBlocking]\n          : ms.blocking\x2C\n      }\n    : ms;\n\n  const enemyPn = opponentPlayerNum(playerNum);\n  const enemyPositions = game.figurePositions?.[enemyPn] || {};\n\n  // Build figure-blocking coords (parity with dc-play-area.js:1022-1042)\n  const attackerPosLc = String(attackerPos).toLowerCase();\n  const attackerFpSet = new Set([attackerPosLc]);\n  // Expand attacker footprint for multi-cell figures\n  const attackerSize = game.figureOrientations?.[figureKey] || getFigureSize(meta.dcName);\n  if (attackerSize && attackerSize !== '1x1') {\n    for (const cell of getFootprintCells(attackerPos\x2C attackerSize)) attackerFpSet.add(String(cell).toLowerCase());\n  }\n\n  // Attacker-side figure-blocking bypass (parity with dc-play-area.js:925-936 + 975).\n  // Any one of these nulls the figure-blocking set for the rest of this call:\n  //   - Priority Target: abilityText contains "priority target" AND "line of sight"\n  //   - MASSIVE attacker keyword\n  //   - Clawdite Scout form: figureConfig.form === 'Scout' grants Priority Target\n  //   - Marksman CC: game.nextAttackIgnoreFigureLOS[msgId] bypasses for one attack\n  // Handler consumes the Marksman flag (delete-on-read); engine is read-only here \u2014\n  // consumption is the mutator's responsibility at attack resolution\x2C not at\n  // target enumeration.\n  const _attackerAbilityText = (_aaEff?.abilityText || '').toLowerCase();\n  const _attackerKws = (_aaEff?.keywords || []).map(k => String(k).toUpperCase());\n  const _clawditeForm = getConfig(game\x2C figureKey)?.form;\n  const _attackerIgnoresFigureBlocking =\n    (_attackerAbilityText.includes('priority target') && _attackerAbilityText.includes('line of sight')) ||\n    _attackerKws.includes('MASSIVE') ||\n    _clawditeForm === 'Scout' ||\n    !!game.nextAttackIgnoreFigureLOS?.[msgId];\n\n  const figureBlockingCoords = _attackerIgnoresFigureBlocking ? null : new Set();\n  if (figureBlockingCoords) {\n    for (const poses of [game.figurePositions?.[playerNum] || {}\x2C enemyPositions]) {\n      for (const [fk\x2C pos] of Object.entries(poses)) {\n        if (!pos || attackerFpSet.has(String(pos).toLowerCase())) continue;\n        const fkDcName = dcNameFromFigureKey(fk);\n        const fkEff = getDcEffects()?.[fkDcName] || getDcEffects()?.[fkDcName.replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n        if (fkEff?.companion === true) continue;\n        if ((fkEff?.keywords || []).some(kw => String(kw).toUpperCase() === 'MASSIVE')) continue;\n        const fkSize = game.figureOrientations?.[fk] || getFigureSize(fkDcName);\n        for (const cell of getFootprintCells(pos\x2C fkSize)) figureBlockingCoords.add(String(cell).toLowerCase());\n      }\n    }\n  }\n\n  const targets = [];\n\n  // Attacker footprint cells for multi-cell LOS origin iteration.\n  const _aaAttackerFpCells = [...attackerFpSet];\n\n  for (const [fk\x2C coord] of Object.entries(enemyPositions)) {\n    if (!coord) continue;\n    const coordLc = String(coord).toLowerCase();\n\n    // Target footprint (for multi-cell targets\x2C LOS/distance may be\n    // traced to any occupied cell).\n    const targetDcName = dcNameFromFigureKey(fk);\n    const targetSize = game.figureOrientations?.[fk] || getFigureSize(targetDcName);\n    const _aaTargetFpCells = (targetSize && targetSize !== '1x1')\n      ? getFootprintCells(coord\x2C targetSize).map(c => String(c).toLowerCase())\n      : [coordLc];\n\n    // Distance: minimum over attacker-footprint \xd7 target-footprint\n    // (parity with dc-play-area.js:1010). countSpaces still gates by\n    // closed doors via _aaClosedDoorEdges.\n    let dist = Infinity;\n    for (const ac of _aaAttackerFpCells) {\n      for (const tc of _aaTargetFpCells) {\n        const d = countSpaces(ms\x2C ac\x2C tc\x2C _aaClosedDoorEdges);\n        if (d < dist) dist = d;\n      }\n    }\n    if (dist < minRange || dist > maxRange) continue;\n\n    // Vanish immunity (parity with dc-play-area.js:1002-1006): if the enemy\n    // player has just used Vanish\x2C filter targets whose figureKey starts with\n    // the protected DC's dcName (covers all group/figure indices of that DC)\n    // until the vanisher's next activation.\n    const _vanish = game.vanishImmunityUntilNextActivation?.[enemyPn];\n    if (_vanish) {\n      const _vanishMeta = deps.dcMessageMeta?.get(_vanish.msgId);\n      if (_vanishMeta && fk.startsWith(`${_vanishMeta.dcName}-`)) continue;\n    }\n\n    // I Must Go Alone CC (parity with dc-play-area.js:1012-1013):\n    // when game.roundDefenderCannotBeTargetedUnlessWithinSpaces protects the\n    // enemy player\x2C targets beyond the spaces cap are filtered.\n    const _iMustGoAlone = game.roundDefenderCannotBeTargetedUnlessWithinSpaces;\n    if (_iMustGoAlone?.playerNum === enemyPn && dist > _iMustGoAlone.spaces) continue;\n\n    // LOS check with figure blocking (parity with dc-play-area.js)\n    // Remove target's own footprint from blocking set (target doesn't block LOS to itself)\n    let losBlockingCoords = figureBlockingCoords;\n    const targetEff = getDcEffects()?.[targetDcName] || getDcEffects()?.[targetDcName.replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n    if (figureBlockingCoords === null) {\n      losBlockingCoords = null; // attacker-side bypass active (Priority Target / MASSIVE / Scout form / Marksman)\n    } else if ((targetEff?.keywords || []).some(kw => String(kw).toUpperCase() === 'MASSIVE')) {\n      losBlockingCoords = null; // MASSIVE targets: no figure blocking\n    } else if (targetSize && targetSize !== '1x1') {\n      const targetFp = new Set(_aaTargetFpCells);\n      losBlockingCoords = new Set([...figureBlockingCoords].filter(c => !targetFp.has(c)));\n    } else {\n      // Single-cell target: remove its own coord from blocking\n      if (figureBlockingCoords.has(coordLc)) {\n        losBlockingCoords = new Set(figureBlockingCoords);\n        losBlockingCoords.delete(coordLc);\n      }\n    }\n\n    // Multi-cell LOS: try attacker-fp \xd7 target-fp corner pairs (parity with\n    // dc-play-area.js:1025-1030). Uses _aaEffectiveMs so closed doors and\n    // energy shields block LOS.\n    let los = false;\n    outer: for (const ac of _aaAttackerFpCells) {\n      for (const tc of _aaTargetFpCells) {\n        if (hasLineOfSight(ac\x2C tc\x2C _aaEffectiveMs\x2C losBlockingCoords)) { los = true; break outer; }\n      }\n    }\n\n    // Fire Mission (parity with dc-play-area.js:1032-1050): if primary LOS\n    // failed and the attacker group is in Fire Mission mode\x2C retry LOS from\n    // every other figure in the same group. Uses the same _aaEffectiveMs and\n    // losBlockingCoords as the primary check. Attachment-aware figure count\n    // covers Z-6 / Mortar / Riot Trooper squad upgrades that bump the group\n    // size by 1. Blast 1 is a combat-resolution concern\x2C not target\n    // enumeration\x2C so out of scope here.\n    if (!los && game.fireMissionActive?.[msgId]) {\n      const _fmDgIdx = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n      const _fmFigCount = getDcStats(meta.dcName)?.figures ?? 1;\n      const _fmSuAtts = game.p1DcAttachments?.[msgId] || game.p2DcAttachments?.[msgId] || [];\n      const _fmTotalFigs = _fmFigCount + (_fmSuAtts.some(a => ['Z-6 Trooper'\x2C 'Mortar Trooper'\x2C 'Riot Trooper'].includes(a)) ? 1 : 0);\n      fmRetry: for (let fi2 = 0; fi2 < _fmTotalFigs; fi2++) {\n        if (fi2 === figureIndex) continue;\n        const otherFk = `${meta.dcName}-${_fmDgIdx}-${fi2}`;\n        const otherPos = game.figurePositions?.[playerNum]?.[otherFk];\n        if (!otherPos) continue;\n        const otherSize = game.figureOrientations?.[otherFk] || getFigureSize(meta.dcName);\n        const otherFpCells = getFootprintCells(otherPos\x2C otherSize);\n        for (const oac of otherFpCells) {\n          for (const tc of _aaTargetFpCells) {\n            if (hasLineOfSight(oac\x2C tc\x2C _aaEffectiveMs\x2C losBlockingCoords)) { los = true; break fmRetry; }\n          }\n        }\n      }\n    }\n\n    if (!los) continue;\n\n    // Insignificant (Dio): can't be targeted if in same space as a friendly figure\n    const _insigEff = targetEff;\n    if ((_insigEff?.specialAbilityIds || []).includes('insignificant_dio')) {\n      const friendlyPositions = game.figurePositions?.[enemyPn] || {};\n      const hasFriendlyInSpace = Object.entries(friendlyPositions).some(([ffk\x2C fpos]) =>\n        ffk !== fk && fpos && String(fpos).toLowerCase() === coordLc\n      );\n      if (hasFriendlyInSpace) continue;\n    }\n    targets.push({ figureKey: fk\x2C coord: coordLc\x2C label: targetDcName\x2C hasLOS: los\x2C dist });\n  }\n\n  // NPC targets (Krykna\x2C Thugs): neutral hostile figures targetable by attacks\n  for (const [npcArray\x2C npcType] of [[game.npcKrykna\x2C 'krykna']\x2C [game.npcThugs\x2C 'thug']]) {\n    if (!Array.isArray(npcArray)) continue;\n    for (let i = 0; i < npcArray.length; i++) {\n      const npc = npcArray[i];\n      if (npc.defeated) continue;\n      const npcCoord = String(npc.coord).toLowerCase();\n      // Distance/LOS use attacker footprint iteration for multi-cell parity\n      // and _aaEffectiveMs for door/shield LOS correctness.\n      let npcDist = Infinity;\n      for (const ac of _aaAttackerFpCells) {\n        const d = countSpaces(ms\x2C ac\x2C npcCoord\x2C _aaClosedDoorEdges);\n        if (d < npcDist) npcDist = d;\n      }\n      if (npcDist < minRange || npcDist > maxRange) continue;\n      let npcLosBlocking = figureBlockingCoords;\n      if (figureBlockingCoords && figureBlockingCoords.has(npcCoord)) {\n        npcLosBlocking = new Set(figureBlockingCoords);\n        npcLosBlocking.delete(npcCoord);\n      }\n      let npcLos = false;\n      for (const ac of _aaAttackerFpCells) {\n        if (hasLineOfSight(ac\x2C npcCoord\x2C _aaEffectiveMs\x2C npcLosBlocking)) { npcLos = true; break; }\n      }\n      if (!npcLos) continue;\n      const npcLabel = npcType === 'thug' ? `Thug ${i + 1}` : `Krykna ${i + 1}`;\n      targets.push({ figureKey: `npc_${npcType}_${i}`\x2C coord: npcCoord\x2C label: npcLabel\x2C hasLOS: npcLos\x2C dist: npcDist\x2C isNpc: true\x2C npcType\x2C npcIndex: i });\n    }\n  }\n\n  return targets;\n}\n
