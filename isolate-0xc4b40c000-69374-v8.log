code-creation,Script,9,263387,0x3f05b9293598,52, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/discord/apply-ability-result.js:1:1,0x1d6be1723288,~
script-source,215,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/discord/apply-ability-result.js,import { getPlayAreaId\x2C opponentPlayerNum } from '../game/player-helpers.js';\nimport { enforceContentLimit } from './limits.js';\nimport { withDiscordRetry\x2C discordCatch } from '../error-handling.js';\nimport { fetchGameChannel } from './channel-helpers.js';\n\n/**\n * Unified handler for resolveAbility() result fields.\n * Ensures ALL CC play paths (hand\x2C DC thread\x2C negation\x2C space-pick\x2C choice) handle\n * every result field identically \u2014 no more "field handled in one path but not another" bugs.\n *\n * Callers still own: hand mutation\x2C discard\x2C card image log\x2C pendingNegation\x2C undo push\x2C\n * requiresChoice button send\x2C requiresSpaceChoice button send.\n *\n * @param {object} result - returned by resolveAbility()\n * @param {object} opts\n * @param {object} opts.game\n * @param {number} opts.playerNum - 1 or 2\n * @param {string} [opts.msgId] - DC message ID when played from activation thread\n * @param {import('discord.js').Client} opts.client\n * @param {object} opts.ctx - full handler context with all helper functions\n * @returns {{ handled: boolean\x2C requiresChoice: boolean\x2C requiresSpaceChoice: boolean }}\n */\nexport async function applyAbilityResult(result\x2C opts) {\n  const { game\x2C playerNum\x2C msgId\x2C client\x2C ctx } = opts;\n  const {\n    logGameAction\x2C\n    updateHandVisualMessage\x2C\n    updateDiscardPileMessage\x2C\n    updateDcActionsMessage\x2C\n    ensureMovementBankMessage\x2C\n    updateMovementBankMessage\x2C\n    dcMessageMeta\x2C\n    dcExhaustedState\x2C\n    dcHealthState\x2C\n    renderDcEmbed\x2C\n    getDcPlayAreaComponents\x2C\n    buildBoardMapPayload\x2C\n    getConditionCardPath\x2C\n  } = ctx;\n\n  // --- Unhandled routing: caller must set up pendingCcChoice/pendingCcSpaceChoice themselves ---\n  if (!result.applied && result.requiresChoice && result.choiceOptions?.length > 0) {\n    return { handled: false\x2C requiresChoice: true\x2C requiresSpaceChoice: false };\n  }\n  if (!result.applied && result.requiresSpaceChoice && result.validSpaces?.length > 0) {\n    return { handled: false\x2C requiresChoice: false\x2C requiresSpaceChoice: true };\n  }\n\n  // --- Ready figures: unexhaust and rebuild DC embed ---\n  if (result.applied && result.readyDcMsgIds?.length && dcExhaustedState) {\n    for (const id of result.readyDcMsgIds) {\n      dcExhaustedState.set(id\x2C false);\n      const meta = dcMessageMeta?.get(id);\n      if (meta && renderDcEmbed && getDcPlayAreaComponents) {\n        try {\n          const chId = getPlayAreaId(game\x2C meta.playerNum);\n          const ch = await fetchGameChannel(client\x2C chId);\n          if (!ch) continue;\n          const msg = await ch.messages.fetch(id);\n          const { embed\x2C files } = await renderDcEmbed(game\x2C id\x2C ctx\x2C { exhausted: false });\n          const components = getDcPlayAreaComponents(id\x2C false\x2C game\x2C meta.dcName);\n          await withDiscordRetry(() => msg.edit({ embeds: [embed]\x2C files\x2C components })).catch(discordCatch);\n        } catch (err) {\n          console.error('Failed to update DC embed after ready:'\x2C err);\n        }\n      }\n    }\n  }\n\n  // --- Drew cards (refresh both players' hands since draw effects can affect either) ---\n  if (result.applied && result.drewCards?.length) {\n    if (updateHandVisualMessage) {\n      await updateHandVisualMessage(game\x2C 1\x2C client);\n      await updateHandVisualMessage(game\x2C 2\x2C client);\n    }\n    const drewList = result.drewCards.map((c) => `**${c}**`).join('\x2C ');\n    if (logGameAction) {\n      await logGameAction(game\x2C client\x2C `CC effect: Drew ${drewList}.`\x2C { phase: 'ACTION'\x2C icon: 'card' });\n    }\n  }\n\n  // --- Log message (applied) ---\n  if (result.applied && result.logMessage && !result.drewCards?.length) {\n    if (logGameAction) {\n      await logGameAction(game\x2C client\x2C `CC effect: ${result.logMessage}`\x2C { phase: 'ACTION'\x2C icon: 'card' });\n    }\n  }\n\n  // --- Manual message (not applied) ---\n  if (!result.applied && result.manualMessage) {\n    if (logGameAction) {\n      await logGameAction(game\x2C client\x2C `CC effect: ${result.manualMessage}`\x2C { phase: 'ACTION'\x2C icon: 'card' });\n    }\n  }\n\n  // --- Refresh player hand / discard ---\n  if (result.applied && result.refreshHand && updateHandVisualMessage) {\n    await updateHandVisualMessage(game\x2C playerNum\x2C client);\n  }\n  if (result.applied && result.refreshDiscard && updateDiscardPileMessage) {\n    await updateDiscardPileMessage(game\x2C playerNum\x2C client);\n  }\n\n  // --- Refresh opponent discard ---\n  if (result.applied && result.refreshOpponentDiscard && updateDiscardPileMessage) {\n    const oppNum = opponentPlayerNum(playerNum);\n    await updateDiscardPileMessage(game\x2C oppNum\x2C client);\n  }\n\n  // --- Refresh DC embed ---\n  if (result.applied && result.refreshDcEmbed && updateDcActionsMessage) {\n    const idsToRefresh = [...(result.refreshDcEmbedMsgIds || [])\x2C ...(result.readyDcMsgIds || [])];\n    // Always include the activating DC's own message if played from DC thread\n    if (msgId && !idsToRefresh.includes(msgId)) idsToRefresh.push(msgId);\n    const seen = new Set();\n    for (const id of idsToRefresh) {\n      if (seen.has(id)) continue;\n      seen.add(id);\n      await updateDcActionsMessage(game\x2C id\x2C client).catch(discordCatch);\n    }\n    // Also rebuild the DC play area embed for each refreshed ID so conditions/health show up there too.\n    // readyDcMsgIds already rebuilds with exhausted=false; here we rebuild with the current exhausted state.\n    const readySet = new Set(result.readyDcMsgIds || []);\n    for (const id of idsToRefresh) {\n      if (readySet.has(id)) continue; // already handled by readyDcMsgIds section above\n      const meta = dcMessageMeta?.get(id);\n      if (!meta || !renderDcEmbed || !getDcPlayAreaComponents) continue;\n      try {\n        const chId = getPlayAreaId(game\x2C meta.playerNum);\n        const ch = await fetchGameChannel(client\x2C chId);\n        if (!ch) continue;\n        const msg = await ch.messages.fetch(id);\n        const exhausted = dcExhaustedState?.get(id) || false;\n        const { embed\x2C files } = await renderDcEmbed(game\x2C id\x2C ctx);\n        const components = getDcPlayAreaComponents(id\x2C exhausted\x2C game\x2C meta.dcName);\n        await withDiscordRetry(() => msg.edit({ embeds: [embed]\x2C files\x2C components })).catch(discordCatch);\n      } catch (err) {\n        console.error('Failed to refresh DC play area embed:'\x2C err);\n      }\n    }\n  }\n\n  // --- Refresh movement bank ---\n  if (result.applied && result.refreshMovementBank && result.activeMsgId) {\n    if (ensureMovementBankMessage) {\n      await ensureMovementBankMessage(game\x2C result.activeMsgId\x2C client).catch(discordCatch);\n    }\n    if (updateMovementBankMessage) {\n      await updateMovementBankMessage(game\x2C result.activeMsgId\x2C client).catch(discordCatch);\n    }\n  }\n\n  // --- Refresh board map (e.g. after token placement) ---\n  if (result.applied && result.refreshBoard && game.boardId && game.selectedMap && buildBoardMapPayload) {\n    try {\n      const boardChannel = await fetchGameChannel(client\x2C game.boardId);\n      if (!boardChannel) throw new Error('Board channel not found');\n      const payload = await buildBoardMapPayload(game.gameId\x2C game.selectedMap\x2C game);\n      await boardChannel.send(payload);\n    } catch (err) {\n      console.error('Failed to refresh board after CC effect:'\x2C err);\n    }\n  }\n\n  // --- Notify DC activation thread of conditions/effects (new message\x2C not just minimap update) ---\n  if (result.applied && result.refreshDcEmbed && result.logMessage) {\n    const idsToNotify = [...new Set([...(result.refreshDcEmbedMsgIds || [])\x2C ...(msgId ? [msgId] : [])])];\n    for (const id of idsToNotify) {\n      const data = game.dcActionsData?.[id];\n      if (!data?.threadId) continue;\n      try {\n        const thread = await fetchGameChannel(client\x2C data.threadId);\n        if (!thread) continue;\n        await withDiscordRetry(() => thread.send({ content: enforceContentLimit(`\ud83d\udca1 ${result.logMessage}`) })).catch(discordCatch);\n      } catch (err) {\n        console.error('Failed to send CC effect to DC thread:'\x2C err);\n      }\n    }\n  }\n\n  // --- Process figure defeats routed through processFigureDefeat pipeline ---\n  if (result.applied && result.defeatedFigures?.length && ctx.processFigureDefeat) {\n    for (const df of result.defeatedFigures) {\n      await ctx.processFigureDefeat(game\x2C {\n        defeatedPlayerNum: df.defeatedPlayerNum\x2C\n        figureKey: df.figureKey\x2C\n        attackerPlayerNum: df.attackerPlayerNum\x2C\n        source: df.source || ''\x2C\n      });\n    }\n  }\n\n  // --- Post condition card images to game log ---\n  if (result.applied && result.conditionCardsToPost?.length && getConditionCardPath && logGameAction) {\n    const seen = new Set();\n    for (const cond of result.conditionCardsToPost) {\n      if (seen.has(cond)) continue;\n      seen.add(cond);\n      const imgPath = getConditionCardPath(cond);\n      if (imgPath) {\n        await logGameAction(game\x2C client\x2C `\ud83d\udccb **${cond}** condition card:`\x2C { phase: 'ACTION'\x2C icon: 'card'\x2C files: [imgPath] }).catch(discordCatch);\n      }\n    }\n  }\n\n  return { handled: true\x2C requiresChoice: false\x2C requiresSpaceChoice: false };\n}\n
