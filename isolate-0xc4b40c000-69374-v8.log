script-source,911,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/canvas/lib/DOMMatrix.js,'use strict'\n\nconst util = require('util')\n\n// DOMMatrix per https://drafts.fxtf.org/geometry/#DOMMatrix\n\nclass DOMPoint {\n  constructor (x\x2C y\x2C z\x2C w) {\n    if (typeof x === 'object' && x !== null) {\n      w = x.w\n      z = x.z\n      y = x.y\n      x = x.x\n    }\n    this.x = typeof x === 'number' ? x : 0\n    this.y = typeof y === 'number' ? y : 0\n    this.z = typeof z === 'number' ? z : 0\n    this.w = typeof w === 'number' ? w : 1\n  }\n\n  matrixTransform(init) {\n    // TODO: this next line is wrong. matrixTransform is supposed to only take\n    // an object with the DOMMatrix properties called DOMMatrixInit\n    const m = init instanceof DOMMatrix ? init : new DOMMatrix(init)\n    return m.transformPoint(this)\n  }\n\n  toJSON() {\n    return {\n      x: this.x\x2C\n      y: this.y\x2C\n      z: this.z\x2C\n      w: this.w\n    }\n  }\n\n  static fromPoint(other) {\n    return new this(other.x\x2C other.y\x2C other.z\x2C other.w)\n  }\n}\n\n// Constants to index into _values (col-major)\nconst M11 = 0; const M12 = 1; const M13 = 2; const M14 = 3\nconst M21 = 4; const M22 = 5; const M23 = 6; const M24 = 7\nconst M31 = 8; const M32 = 9; const M33 = 10; const M34 = 11\nconst M41 = 12; const M42 = 13; const M43 = 14; const M44 = 15\n\nconst DEGREE_PER_RAD = 180 / Math.PI\nconst RAD_PER_DEGREE = Math.PI / 180\n\nfunction parseMatrix (init) {\n  let parsed = init.replace('matrix('\x2C '')\n  parsed = parsed.split('\x2C'\x2C 7) // 6 + 1 to handle too many params\n  if (parsed.length !== 6) throw new Error(`Failed to parse ${init}`)\n  parsed = parsed.map(parseFloat)\n  return [\n    parsed[0]\x2C parsed[1]\x2C 0\x2C 0\x2C\n    parsed[2]\x2C parsed[3]\x2C 0\x2C 0\x2C\n    0\x2C 0\x2C 1\x2C 0\x2C\n    parsed[4]\x2C parsed[5]\x2C 0\x2C 1\n  ]\n}\n\nfunction parseMatrix3d (init) {\n  let parsed = init.replace('matrix3d('\x2C '')\n  parsed = parsed.split('\x2C'\x2C 17) // 16 + 1 to handle too many params\n  if (parsed.length !== 16) throw new Error(`Failed to parse ${init}`)\n  return parsed.map(parseFloat)\n}\n\nfunction parseTransform (tform) {\n  const type = tform.split('('\x2C 1)[0]\n  switch (type) {\n    case 'matrix':\n      return parseMatrix(tform)\n    case 'matrix3d':\n      return parseMatrix3d(tform)\n    // TODO This is supposed to support any CSS transform value.\n    default:\n      throw new Error(`${type} parsing not implemented`)\n  }\n}\n\nclass DOMMatrix {\n  constructor (init) {\n    this._is2D = true\n    this._values = new Float64Array([\n      1\x2C 0\x2C 0\x2C 0\x2C\n      0\x2C 1\x2C 0\x2C 0\x2C\n      0\x2C 0\x2C 1\x2C 0\x2C\n      0\x2C 0\x2C 0\x2C 1\n    ])\n\n    let i\n\n    if (typeof init === 'string') { // parse CSS transformList\n      if (init === '') return // default identity matrix\n      const tforms = init.split(/\\)\\s+/\x2C 20).map(parseTransform)\n      if (tforms.length === 0) return\n      init = tforms[0]\n      for (i = 1; i < tforms.length; i++) init = multiply(tforms[i]\x2C init)\n    }\n\n    i = 0\n    if (init && init.length === 6) {\n      setNumber2D(this\x2C M11\x2C init[i++])\n      setNumber2D(this\x2C M12\x2C init[i++])\n      setNumber2D(this\x2C M21\x2C init[i++])\n      setNumber2D(this\x2C M22\x2C init[i++])\n      setNumber2D(this\x2C M41\x2C init[i++])\n      setNumber2D(this\x2C M42\x2C init[i++])\n    } else if (init && init.length === 16) {\n      setNumber2D(this\x2C M11\x2C init[i++])\n      setNumber2D(this\x2C M12\x2C init[i++])\n      setNumber3D(this\x2C M13\x2C init[i++])\n      setNumber3D(this\x2C M14\x2C init[i++])\n      setNumber2D(this\x2C M21\x2C init[i++])\n      setNumber2D(this\x2C M22\x2C init[i++])\n      setNumber3D(this\x2C M23\x2C init[i++])\n      setNumber3D(this\x2C M24\x2C init[i++])\n      setNumber3D(this\x2C M31\x2C init[i++])\n      setNumber3D(this\x2C M32\x2C init[i++])\n      setNumber3D(this\x2C M33\x2C init[i++])\n      setNumber3D(this\x2C M34\x2C init[i++])\n      setNumber2D(this\x2C M41\x2C init[i++])\n      setNumber2D(this\x2C M42\x2C init[i++])\n      setNumber3D(this\x2C M43\x2C init[i++])\n      setNumber3D(this\x2C M44\x2C init[i])\n    } else if (init !== undefined) {\n      throw new TypeError('Expected string or array.')\n    }\n  }\n\n  toString () {\n    return this.is2D\n      ? `matrix(${this.a}\x2C ${this.b}\x2C ${this.c}\x2C ${this.d}\x2C ${this.e}\x2C ${this.f})`\n      : `matrix3d(${this._values.join('\x2C ')})`\n  }\n\n  multiply (other) {\n    return newInstance(this._values).multiplySelf(other)\n  }\n\n  multiplySelf (other) {\n    this._values = multiply(other._values\x2C this._values)\n    if (!other.is2D) this._is2D = false\n    return this\n  }\n\n  preMultiplySelf (other) {\n    this._values = multiply(this._values\x2C other._values)\n    if (!other.is2D) this._is2D = false\n    return this\n  }\n\n  translate (tx\x2C ty\x2C tz) {\n    return newInstance(this._values).translateSelf(tx\x2C ty\x2C tz)\n  }\n\n  translateSelf (tx\x2C ty\x2C tz) {\n    if (typeof tx !== 'number') tx = 0\n    if (typeof ty !== 'number') ty = 0\n    if (typeof tz !== 'number') tz = 0\n    this._values = multiply([\n      1\x2C 0\x2C 0\x2C 0\x2C\n      0\x2C 1\x2C 0\x2C 0\x2C\n      0\x2C 0\x2C 1\x2C 0\x2C\n      tx\x2C ty\x2C tz\x2C 1\n    ]\x2C this._values)\n    if (tz !== 0) this._is2D = false\n    return this\n  }\n\n  scale (scaleX\x2C scaleY\x2C scaleZ\x2C originX\x2C originY\x2C originZ) {\n    return newInstance(this._values).scaleSelf(scaleX\x2C scaleY\x2C scaleZ\x2C originX\x2C originY\x2C originZ)\n  }\n\n  scale3d (scale\x2C originX\x2C originY\x2C originZ) {\n    return newInstance(this._values).scale3dSelf(scale\x2C originX\x2C originY\x2C originZ)\n  }\n\n  scale3dSelf (scale\x2C originX\x2C originY\x2C originZ) {\n    return this.scaleSelf(scale\x2C scale\x2C scale\x2C originX\x2C originY\x2C originZ)\n  }\n\n  /**\n   * @deprecated\n   */\n  scaleNonUniform(scaleX\x2C scaleY) {\n    return this.scale(scaleX\x2C scaleY)\n  }\n\n  scaleSelf (scaleX\x2C scaleY\x2C scaleZ\x2C originX\x2C originY\x2C originZ) {\n    // Not redundant with translate's checks because we need to negate the values later.\n    if (typeof originX !== 'number') originX = 0\n    if (typeof originY !== 'number') originY = 0\n    if (typeof originZ !== 'number') originZ = 0\n    this.translateSelf(originX\x2C originY\x2C originZ)\n    if (typeof scaleX !== 'number') scaleX = 1\n    if (typeof scaleY !== 'number') scaleY = scaleX\n    if (typeof scaleZ !== 'number') scaleZ = 1\n    this._values = multiply([\n      scaleX\x2C 0\x2C 0\x2C 0\x2C\n      0\x2C scaleY\x2C 0\x2C 0\x2C\n      0\x2C 0\x2C scaleZ\x2C 0\x2C\n      0\x2C 0\x2C 0\x2C 1\n    ]\x2C this._values)\n    this.translateSelf(-originX\x2C -originY\x2C -originZ)\n    if (scaleZ !== 1 || originZ !== 0) this._is2D = false\n    return this\n  }\n\n  rotateFromVector (x\x2C y) {\n    return newInstance(this._values).rotateFromVectorSelf(x\x2C y)\n  }\n\n  rotateFromVectorSelf (x\x2C y) {\n    if (typeof x !== 'number') x = 0\n    if (typeof y !== 'number') y = 0\n    const theta = (x === 0 && y === 0) ? 0 : Math.atan2(y\x2C x) * DEGREE_PER_RAD\n    return this.rotateSelf(theta)\n  }\n\n  rotate (rotX\x2C rotY\x2C rotZ) {\n    return newInstance(this._values).rotateSelf(rotX\x2C rotY\x2C rotZ)\n  }\n\n  rotateSelf (rotX\x2C rotY\x2C rotZ) {\n    if (rotY === undefined && rotZ === undefined) {\n      rotZ = rotX\n      rotX = rotY = 0\n    }\n    if (typeof rotY !== 'number') rotY = 0\n    if (typeof rotZ !== 'number') rotZ = 0\n    if (rotX !== 0 || rotY !== 0) this._is2D = false\n    rotX *= RAD_PER_DEGREE\n    rotY *= RAD_PER_DEGREE\n    rotZ *= RAD_PER_DEGREE\n    let c\x2C s\n    c = Math.cos(rotZ)\n    s = Math.sin(rotZ)\n    this._values = multiply([\n      c\x2C s\x2C 0\x2C 0\x2C\n      -s\x2C c\x2C 0\x2C 0\x2C\n      0\x2C 0\x2C 1\x2C 0\x2C\n      0\x2C 0\x2C 0\x2C 1\n    ]\x2C t