script-source,150,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/botmenu.js,/**\n * F16/F11: Bot Stuff menu (Kill Game\x2C Forfeit) via /botmenu in Game Log.\n * Kill Game: participants or Admin/Bothelpers only. First confirm wins.\n * Forfeit: participants only. Ends game cleanly with opponent as winner.\n */\nimport {\n  getBotmenuButtons\x2C\n  getBotmenuKillConfirmButtons\x2C\n  getForfeitConfirmButtons\x2C\n} from '../discord/components.js';\nimport { cleanupGameLock } from '../game/action-queue.js';\nimport { discordCatch } from '../error-handling.js';\nimport { clearBuffer\x2C clearSeqCounter as clearEventLogSeqCounter } from '../event-log.js';\nimport { clearSeqCounter as clearDomainSeqCounter } from '../domain/events.js';\nimport { clearGameErrorThread } from '../discord/messages.js';\nimport { parseCustomId } from '../discord/custom-id.js';\nimport { cleanupCompanionEmbedDeps } from './post-deploy.js';\nimport { fetchGameChannel } from '../discord/channel-helpers.js';\nimport { getIncidentMirrorsForGame\x2C markIncidentMirrorsCleaned } from '../db.js';\n\nconst BOTMENU_ALLOWED_KILL_ROLES = ['Admin'\x2C 'Bothelpers'];\n\n/** True if user can use Kill Game: participant or has role Admin/Bothelpers. */\nfunction canKillGame(interaction\x2C game) {\n  if (game.player1Id === interaction.user.id || game.player2Id === interaction.user.id) return true;\n  const member = interaction.member;\n  if (!member?.roles?.cache) return false;\n  return member.roles.cache.some((r) => BOTMENU_ALLOWED_KILL_ROLES.includes(r.name));\n}\n\n/** True if user is a participant in this game. */\nfunction isParticipant(interaction\x2C game) {\n  return game.player1Id === interaction.user.id || game.player2Id === interaction.user.id;\n}\n\n/**\n * Clean up Discord mirrors for all incidents associated with a game.\n * Queries the incidents table for posted mirrors\x2C deletes threads/messages\x2C marks cleaned.\n */\nasync function cleanupIncidentMirrors(gameId\x2C client) {\n  try {\n    const mirrors = await getIncidentMirrorsForGame(gameId);\n    if (!mirrors.length) return;\n    const threadIds = new Set();\n    const cleanedIds = [];\n    for (const m of mirrors) {\n      cleanedIds.push(m.id);\n      // Collect unique thread IDs for deletion (threads contain all messages)\n      if (m.discord_thread_id) {\n        threadIds.add(m.discord_thread_id);\n      } else if (m.discord_message_id) {\n        // Standalone message in bot-logs channel (no thread) \u2014 delete individually\n        try {\n          const ch = await fetchGameChannel(client\x2C BOT_LOGS_CHANNEL_ID);\n          if (ch) {\n            const msg = await ch.messages.fetch(m.discord_message_id).catch(() => null);\n            if (msg) await msg.delete().catch(discordCatch);\n          }\n        } catch {}\n      }\n    }\n    // Delete error threads (each thread delete removes all messages in it)\n    for (const threadId of threadIds) {\n      let parentChannel = null;\n      try {\n        const thread = await fetchGameChannel(client\x2C threadId);\n        if (thread) {\n          parentChannel = thread.parent;\n          await thread.delete().catch(discordCatch);\n        }\n      } catch (err) {\n        if (err.code !== 10003 && err.code !== 10008) {\n          console.error(`[cleanupIncidentMirrors] Thread delete failed:`\x2C err.message);\n        }\n      }\n      // For message-based threads\x2C thread ID === header message ID.\n      // Delete the header message so bot-logs stays clean.\n      if (parentChannel) {\n        try {\n          const headerMsg = await parentChannel.messages.fetch(threadId).catch(() => null);\n          if (headerMsg) await headerMsg.delete();\n        } catch {}\n      }\n    }\n    await markIncidentMirrorsCleaned(cleanedIds);\n  } catch (err) {\n    console.error(`[cleanupIncidentMirrors] Failed for game ${gameId}:`\x2C err.message);\n  }\n}\n\nconst BOT_LOGS_CHANNEL_ID = '1467647184542634005';\n\n/**\n * Delete game's Discord category and channels\x2C remove from state and DB. Shared by Kill Game and Archive confirm.\n * @param {object} game - Game state (before deleteGame)\n * @param {string} gameId - game.gameId\n * @param {object} ctx - client\x2C deleteGame\x2C saveGames\x2C dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState\x2C deleteGameFromDb\n */\nexport async function deleteGameChannelsAndGame(game\x2C gameId\x2C ctx) {\n  const {\n    client\x2C\n    deleteGame\x2C\n    saveGames\x2C\n    dcMessageMeta\x2C\n    dcExhaustedState\x2C\n    dcHealthState\x2C\n    deleteGameFromDb\x2C\n    channelDeleteGuard\x2C\n  } = ctx;\n  // Mark this game so the channelDelete listener ignores bot-initiated deletions\n  if (channelDeleteGuard) channelDeleteGuard.add(gameId);\n  let categoryId = game.gameCategoryId;\n  if (!categoryId) {\n    const generalCh = await fetchGameChannel(client\x2C game.generalId);\n    categoryId = generalCh?.parentId;\n  }\n  if (categoryId) {\n    try {\n      const guild = (await fetchGameChannel(client\x2C categoryId))?.guild;\n      if (guild) {\n        const children = guild.channels.cache.filter((c) => c.parentId === categoryId);\n        for (const ch of children.values()) await ch.delete().catch(discordCatch);\n        await guild.channels.fetch(categoryId).then((cat) => cat?.delete()).catch(discordCatch);\n      }\n    } catch (err) {\n      console.error('deleteGameChannelsAndGame:'\x2C err);\n    }\n  }\n  if (channelDeleteGuard) channelDeleteGuard.delete(gameId);\n  deleteGame(gameId);\n  cleanupGameLock(gameId);\n  clearBuffer(gameId);\n  clearEventLogSeqCounter(gameId);\n  clearDomainSeqCounter(gameId);\n  await clearGameErrorThread(gameId\x2C client);\n  await cleanupIncidentMirrors(gameId\x2C client);\n  cleanupCompanionEmbedDeps(gameId);\n  saveGames();\n  if (deleteGameFromDb) await deleteGameFromDb(gameId).catch(discordCatch);\n  for (const [msgId\x2C meta] of dcMessageMeta) {\n    if (meta.gameId === gameId) {\n      dcMessageMeta.delete(msgId);\n      dcExhaustedState.delete(msgId);\n      dcHealthState.delete(msgId);\n    }\n  }\n}\n\n/** Kill Game clicked: check permission\x2C show confirmation. */\nexport async function handleBotmenuKill(interaction\x2C ctx) {\n  const { getGame } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'botmenu_kill_');\n  const game = getGame(gameId);\n  if (!game) {\n    console.warn('[botmenu] Game not found for gameId:'\x2C gameId);\n    await interaction.editReply({\n      content: 'Game not found.'\x2C\n      components: []\x2C\n    }).catch(discordCatch);\n    return;\n  }\n  if (!canKillGame(interaction\x2C game)) {\n    await interaction.editReply({\n      content: 'Only game participants or users with the **Admin** or **Bothelpers** role can kill the game.'\x2C\n      components: []\x2C\n    }).catch(discordCatch);\n    return;\n  }\n  await interaction.editReply({\n    content: '**Are you sure you want to kill this game?** This will remove the game and its channels.'\x2C\n    components: [getBotmenuKillConfirmButtons(gameId)]\x2C\n  }).catch(discordCatch);\n}\n\n/** Kill Game Yes: delete channels and game. */\nexport async function handleBotmenuKillYes(interaction\x2C ctx) {\n  const { getGame\x2C logGameErrorToBotLogs } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'botmenu_kill_yes_');\n  const game = getGame(gameId);\n  if (!game) {\n    await interaction.editReply({ content: 'Game not found.'\x2C components: [] }).catch(discordCatch);\n    return;\n  }\n  if (!canKillGame(interaction\x2C game)) {\n    await interaction.editReply({ content: 'You are not allowed to kill this game.'\x2C components: [] }).catch(discordCatch);\n    return;\n  }\n  // Update message before deletion (channel will be deleted along with it)\n  await interaction.editReply({\n    content: `\u23f3 Deleting **IA Game #${gameId}**...`\x2C\n    components: []\x2C\n  }).catch(discordCatch);\n  try {\n    await deleteGameChannelsAndGame(game\x2C gameId\x2C ctx);\n  } catch (err) {\n    console.error('[botmenu] Kill game error:'\x2C err);\n    await logGameErrorToBotLogs(interaction.client\x2C interaction.guild\x2C gameId\x2C err\x2C 'botmenu_kill');\n  }\n}\n\n/** Kill Game No: cancel. */\nexport async function handleBotmenuKillNo(interaction\x2C ctx) {\n  await interaction.editReply({ content: 'Kill game cancelled.'\x2C components: [] }).catch(discordCatch);\n}\n\n// \u2500\u2500 Forfeit \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/** Forfeit clicked: check participant\x2C show confirmation. */\nexport async function handleForfeit(interaction\x2C ctx) {\n  const { getGame } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'forfeit_');\n  const game = getGame(gameId);\n  if (!game) {\n    await interaction.editReply({ content: 'Game not found.'\x2C components: [] }).catch(discordCatch);\n    return;\n  }\n  if (game.ended) {\n    await interaction.editReply({ content: 'This game has already ended.'\x2C components: [] }).catch(discordCatch);\n    return;\n  }\n  if (!isParticipant(interaction\x2C game)) {\n    await interaction.editReply({ content: 'Only game participants can forfeit.'\x2C components: [] }).catch(discordCatch);\n    return;\n  }\n  await interaction.editReply({\n    content: '**Are you sure you want to forfeit?** This will end the game and award the win to your opponent. Channels will be preserved for review.'\x2C\n    components: [getForfeitConfirmButtons(gameId)]\x2C\n  }).catch(discordCatch);\n}\n\n/** Forfeit Yes: end game cleanly via postGameOver. */\nexport async function handleForfeitYes(interaction\x2C ctx) {\n  const { getGame\x2C postGameOver\x2C logGameErrorToBotLogs } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'forfeit_yes_');\n  const game = getGame(gameId);\n  if (!game) {\n    await interaction.editReply({ content: 'Game not found.'\x2C components: [] }).catch(discordCatch);\n    return;\n  }\n  if (game.ended) {\n    await interaction.editReply({ content: 'This game has already ended.'\x2C components: [] }).catch(discordCatch);\n    return;\n  }\n  if (!isParticipant(interaction\x2C game)) {\n    await interaction.editReply({ content: 'Only game participants can forfeit.'\x2C components: [] }).catch(discordCatch);\n    return;\n  }\n  const forfeiterId = interaction.user.id;\n  const winnerId = forfeiterId === game.player1Id ? game.player2Id : game.player1Id;\n  await interaction.editReply({\n    content: `<@${forfeiterId}> has forfeited. **<@${winnerId}> wins!**`\x2C\n    components: []\x2C\n    allowedMentions: { users: [forfeiterId\x2C winnerId] }\x2C\n  }).catch(discordCatch);\n  try {\n    await postGameOver(game\x2C interaction.client\x2C winnerId\x2C 'forfeit');\n  } catch (err) {\n    console.error('[botmenu] Forfeit postGameOver error:'\x2C err);\n    await logGameErrorToBotLogs(interaction.client\x2C interaction.guild\x2C gameId\x2C err\x2C 'forfeit');\n  }\n}\n\n/** Forfeit No: cancel. */\nexport async function handleForfeitNo(interaction\x2C ctx) {\n  await interaction.editReply({ content: 'Forfeit cancelled.'\x2C components: [] }).catch(discordCatch);\n}\n
