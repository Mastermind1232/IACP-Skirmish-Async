code-creation,Script,9,222841,0x3f05b928fd38,57, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/ai/ai-discord.js:1:1,0x3e1e4d0a1430,~
script-source,195,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/ai/ai-discord.js,/**\n * AI Discord integration: runs AI turns through the real handler pipeline\n * so that Discord messages are sent naturally.\n *\n * After a human player's action\x2C this module checks if the game has an AI player\n * and if it's the AI's turn. If so\x2C it loops through available actions\x2C\n * picks the best one\x2C and dispatches it through the registered handler.\n */\n\nimport { getAvailableActions } from '../engine/available-actions.js';\nimport { pickBestAction } from './strategy.js';\nimport { getHandlerKey } from '../router.js';\nimport { getHandler\x2C getHandlerGroup } from '../handlers/index.js';\nimport { buildContext } from '../context-factory.js';\nimport { createFakeInteraction } from '../headless/fake-interaction.js';\nimport { fetchGameChannel } from '../discord/channel-helpers.js';\nimport { withAtomicGameLock } from '../game/action-queue.js';\n\n/** Sentinel user ID prefix for AI players. */\nexport const AI_USER_PREFIX = 'ai_player_';\n\n/**\n * Check if a game has an AI player.\n * @param {object} game\n * @returns {{ hasAi: boolean\x2C aiPlayerNum: number|null\x2C aiUserId: string|null }}\n */\nexport function getAiPlayer(game) {\n  if (!game) return { hasAi: false\x2C aiPlayerNum: null\x2C aiUserId: null };\n  if (game.aiPlayerNum) {\n    const aiUserId = game.aiPlayerNum === 1 ? game.player1Id : game.player2Id;\n    return { hasAi: true\x2C aiPlayerNum: game.aiPlayerNum\x2C aiUserId };\n  }\n  // Check if either player ID starts with AI prefix\n  if (game.player1Id?.startsWith(AI_USER_PREFIX)) {\n    return { hasAi: true\x2C aiPlayerNum: 1\x2C aiUserId: game.player1Id };\n  }\n  if (game.player2Id?.startsWith(AI_USER_PREFIX)) {\n    return { hasAi: true\x2C aiPlayerNum: 2\x2C aiUserId: game.player2Id };\n  }\n  return { hasAi: false\x2C aiPlayerNum: null\x2C aiUserId: null };\n}\n\n/**\n * Create a live interaction that uses the real Discord client to send messages\n * but doesn't require an actual Discord interaction event.\n *\n * Handlers call interaction.deferUpdate()\x2C followUp()\x2C reply()\x2C etc.\n * This fake wires followUp/reply to send messages to the game's general channel.\n *\n * @param {string} customId - The action's customId\n * @param {string} userId - The AI's user ID\n * @param {object} game - Game state (for channel IDs)\n * @param {object} client - Real Discord client\n * @returns {object} An interaction-like object\n */\nexport function createLiveAiInteraction(customId\x2C userId\x2C game\x2C client) {\n  const sentMessages = [];\n\n  const interaction = {\n    customId\x2C\n    user: { id: userId\x2C username: 'AI Player' }\x2C\n    member: { id: userId }\x2C\n    message: {\n      id: 'ai-action-msg'\x2C\n      content: ''\x2C\n      embeds: []\x2C\n      components: []\x2C\n      channel: null\x2C // set below\n      edit: async (payload) => {\n        sentMessages.push({ type: 'edit'\x2C ...payload });\n        return interaction.message;\n      }\x2C\n      delete: async () => {}\x2C\n      pin: async () => {}\x2C\n      react: async () => {}\x2C\n    }\x2C\n    channel: null\x2C // set below\n    channelId: game.generalId || 'unknown'\x2C\n    guild: null\x2C // set below\n    values: []\x2C\n    fields: { getTextInputValue: () => '' }\x2C\n\n    deferUpdate: async () => {}\x2C\n    deferReply: async () => {}\x2C\n    followUp: async (payload) => {\n      // Send to the game's general channel for visibility\n      try {\n        if (game.generalId) {\n          const ch = await fetchGameChannel(client\x2C game.generalId);\n          const content = typeof payload === 'string' ? payload : payload?.content;\n          if (content && !payload?.ephemeral) {\n            await ch.send({ content\x2C embeds: payload?.embeds\x2C components: payload?.components });\n          }\n        }\n      } catch (err) {\n        console.error('[AI] followUp send error:'\x2C err.message);\n      }\n      sentMessages.push({ type: 'followUp'\x2C ...(typeof payload === 'string' ? { content: payload } : payload) });\n      return { id: 'ai-followup-msg' };\n    }\x2C\n    editReply: async (payload) => {\n      sentMessages.push({ type: 'editReply'\x2C ...(typeof payload === 'string' ? { content: payload } : payload) });\n      return { id: 'ai-editreply-msg' };\n    }\x2C\n    reply: async (payload) => {\n      sentMessages.push({ type: 'reply'\x2C ...(typeof payload === 'string' ? { content: payload } : payload) });\n      return { id: 'ai-reply-msg' };\n    }\x2C\n    update: async (payload) => {\n      sentMessages.push({ type: 'update'\x2C ...(typeof payload === 'string' ? { content: payload } : payload) });\n      return interaction.message;\n    }\x2C\n    showModal: async () => {\n      // Modals can't be shown to AI \u2014 silently ignore\n    }\x2C\n\n    isButton: () => true\x2C\n    isStringSelectMenu: () => false\x2C\n    isModalSubmit: () => false\x2C\n    isChatInputCommand: () => false\x2C\n    isAutocomplete: () => false\x2C\n    isRepliable: () => true\x2C\n\n    options: {\n      getInteger: () => null\x2C\n      getString: () => null\x2C\n      getUser: () => null\x2C\n      getSubcommand: () => null\x2C\n    }\x2C\n\n    sentMessages\x2C\n  };\n\n  return interaction;\n}\n\n/**\n * Run AI turns for a game after a human action.\n * Loops until the AI has no more actions or the game ends.\n *\n * @param {object} game - The game state object\n * @param {object} client - Real Discord client\n * @param {function} buildAllDeps - Function to build all dependencies\n * @param {function} getGame - Function to get latest game state\n * @param {object} [options]\n * @param {number} [options.maxSteps=50] - Safety limit per AI turn\n * @param {number} [options.delayMs=1500] - Delay between actions in ms\n * @param {object} [options.deps] - Extra deps for available-actions (dcMessageMeta\x2C etc.)\n * @param {object} [options.atomicOpts] - Options for withAtomicGameLock (getGame\x2C setGame\x2C commitFn\x2C onRollback)\n * @returns {Promise<{ steps: number\x2C actions: string[] }>}\n */\nexport async function runAiTurnLive(game\x2C client\x2C buildAllDeps\x2C getGame\x2C options = {}) {\n  const maxSteps = options.maxSteps || 50;\n  const delayMs = options.delayMs ?? 1500;\n  const extraDeps = options.deps || {};\n  const atomicOpts = options.atomicOpts || null;\n  const { hasAi\x2C aiPlayerNum\x2C aiUserId } = getAiPlayer(game);\n  if (!hasAi || !aiPlayerNum) return { steps: 0\x2C actions: [] };\n\n  const actionLog = [];\n  const suppressedCcPlays = new Set();\n  let lastRoundPhase = null;\n\n  for (let step = 0; step < maxSteps; step++) {\n    // Re-read game state (handlers may have mutated it)\n    const currentGame = getGame(game.gameId);\n    if (!currentGame || currentGame.ended) {\n      return { steps: step\x2C actions: actionLog };\n    }\n\n    // Clear CC suppression when game phase changes\n    const curPhase = `${currentGame.roundPhase || '?'}|${currentGame.currentActivatingDcIndex ?? 'x'}`;\n    if (curPhase !== lastRoundPhase) {\n      suppressedCcPlays.clear();\n      lastRoundPhase = curPhase;\n    }\n\n    // Get available actions for the AI\x2C filtering suppressed CCs\n    const actions = getAvailableActions(currentGame\x2C aiPlayerNum\x2C extraDeps)\n      .filter(a => !(a.type === 'play_cc' && a.params?.cardName && suppressedCcPlays.has(a.params.cardName)))\n      .map(a => ({ ...a\x2C actingPlayer: aiPlayerNum }));\n    if (!actions || actions.length === 0) {\n      return { steps: step\x2C actions: actionLog };\n    }\n\n    // Pick the best action\n    const engineLike = {\n      getState: () => currentGame\x2C\n      getAvailableActions: (pn) => getAvailableActions(currentGame\x2C pn\x2C extraDeps)\x2C\n    };\n    const result = pickBestAction(engineLike\x2C actions\x2C aiPlayerNum\x2C extraDeps);\n    const chosen = result?.action || actions[0];\n    if (!chosen?.customId) {\n      return { steps: step\x2C actions: actionLog };\n    }\n\n    // Add delay for natural pacing (skip on first action)\n    if (step > 0 && delayMs > 0) {\n      await new Promise(resolve => setTimeout(resolve\x2C delayMs));\n    }\n\n    // CC play bridge: play_cc actions require multi-step UI (dropdown \u2192 confirm).\n    // Bypass the dropdown by pre-setting pendingCcConfirmation and routing\n    // directly to the confirm handler\x2C which does the actual play.\n    if (chosen.type === 'play_cc' && chosen.params?.cardName) {\n      currentGame.pendingCcConfirmation = {\n        playerNum: aiPlayerNum\x2C\n        card: chosen.params.cardName\x2C\n        ts: Date.now()\x2C\n      };\n      chosen.customId = `cc_confirm_play_${currentGame.gameId}`;\n    }\n\n    // Dispatch through the real handler pipeline\n    try {\n      const allDeps = buildAllDeps();\n      const handlerKey = getHandlerKey(chosen.customId\x2C 'button');\n      if (!handlerKey) {\n        console.warn(`[AI] No handler key for customId: ${chosen.customId}`);\n        return { steps: step\x2C actions: actionLog };\n      }\n\n      const handler = getHandler(handlerKey);\n      if (!handler) {\n        console.warn(`[AI] No handler for key: ${handlerKey}`);\n        return { steps: step\x2C actions: actionLog };\n      }\n\n      const group = getHandlerGroup(handlerKey);\n      const interaction = createLiveAiInteraction(chosen.customId\x2C aiUserId\x2C currentGame\x2C client);\n      interaction.client = client;\n\n      // Set up guild reference for handlers that need it\n      if (currentGame.guildId) {\n        try {\n          interaction.guild = await client.guilds.fetch(currentGame.guildId);\n        } catch {}\n      }\n\n      // Set up channel reference\n      if (currentGame.generalId) {\n        try {\n          interaction.channel = await fetchGameChannel(client\x2C currentGame.generalId);\n          interaction.message.channel = interaction.channel;\n        } catch {}\n      }\n\n      const runHandler = async () => {\n        if (group) {\n          const ctx = buildContext(group\x2C allDeps);\n          await handler(interaction\x2C ctx);\n        } else {\n          await handler(interaction);\n        }\n      };\n\n      // Acquire per-game mutex so AI handler doesn't race with human interactions\n      if (atomicOpts) {\n        await withAtomicGameLock(currentGame.gameId\x2C atomicOpts\x2C runHandler);\n      } else {\n        await runHandler();\n      }\n\n      // CC retry-loop prevention: suppress card if handler couldn't auto-resolve\n      if (currentGame.pendingIllegalCcPlay) {\n        const suppCard = currentGame.pendingIllegalCcPlay.card;\n        console.log(`[AI] CC suppressed: "${suppCard}" (${currentGame.pendingIllegalCcPlay.reason || 'manual'}) \u2014 will retry after phase change`);\n        suppressedCcPlays.add(suppCard);\n        delete currentGame.pendingIllegalCcPlay;\n        continue;\n      }\n\n      // Negation auto-resolve: cost-0 CCs set pendingNegation. In AI-vs-human\x2C\n      // the AI is one side \u2014 auto-let-resolve on the AI's behalf so the game continues.\n      // (The human opponent still gets normal Negation prompts when THEY play a CC.)\n      if (currentGame.pendingNegation && currentGame.pendingNegation.playedBy === aiPlayerNum) {\n        const negOppNum = aiPlayerNum === 1 ? 2 : 1;\n        const negUserId = negOppNum === 1 ? currentGame.player1Id : currentGame.player2Id;\n        const negCustomId = `negation_let_resolve_${currentGame.gameId}`;\n        try {\n          const negHandlerKey = getHandlerKey(negCustomId\x2C 'button');\n          const negHandler = negHandlerKey ? getHandler(negHandlerKey) : null;\n          if (negHandler) {\n            const negInteraction = createLiveAiInteraction(negCustomId\x2C negUserId\x2C currentGame\x2C client);\n            negInteraction.client = client;\n            if (currentGame.generalId) {\n              try { negInteraction.channel = await fetchGameChannel(client\x2C currentGame.generalId); negInteraction.message.channel = negInteraction.channel; } catch {}\n            }\n            const negGroup = getHandlerGroup(negHandlerKey);\n            const allDepsNeg = buildAllDeps();\n            if (negGroup) {\n              const negCtx = buildContext(negGroup\x2C allDepsNeg);\n              await negHandler(negInteraction\x2C negCtx);\n            } else {\n              await negHandler(negInteraction);\n            }\n            console.log(`[AI] Negation auto-resolved: let "${currentGame.pendingNegation?.card || '?'}" resolve`);\n          } else {\n            delete currentGame.pendingNegation;\n          }\n        } catch (err) {\n          delete currentGame.pendingNegation;\n          console.warn(`[AI] Negation auto-resolve error: ${err.message}`);\n        }\n      }\n\n      actionLog.push(chosen.customId);\n      console.log(`[AI] Step ${step}: ${chosen.type} \u2192 ${chosen.customId}`);\n    } catch (err) {\n      console.error(`[AI] Step ${step} handler error:`\x2C err.message);\n      return { steps: step\x2C actions: actionLog\x2C error: err.message };\n    }\n  }\n\n  console.warn(`[AI] Reached safety limit of ${maxSteps} steps for game ${game.gameId}`);\n  return { steps: maxSteps\x2C actions: actionLog };\n}\n\n/**\n * Mark a game as having an AI player.\n * @param {object} game - Game state\n * @param {number} playerNum - 1 or 2 for which player the AI controls\n */\nexport function markGameAsAi(game\x2C playerNum) {\n  game.aiPlayerNum = playerNum;\n  const aiUserId = `${AI_USER_PREFIX}${playerNum}`;\n  if (playerNum === 1) {\n    game.player1Id = aiUserId;\n  } else {\n    game.player2Id = aiUserId;\n  }\n}\n
