script-source,369,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/undici/lib/handler/retry-handler.js,'use strict'\nconst assert = require('node:assert')\n\nconst { kRetryHandlerDefaultRetry } = require('../core/symbols')\nconst { RequestRetryError } = require('../core/errors')\nconst {\n  isDisturbed\x2C\n  parseHeaders\x2C\n  parseRangeHeader\x2C\n  wrapRequestBody\n} = require('../core/util')\n\nfunction calculateRetryAfterHeader (retryAfter) {\n  const current = Date.now()\n  return new Date(retryAfter).getTime() - current\n}\n\nclass RetryHandler {\n  constructor (opts\x2C handlers) {\n    const { retryOptions\x2C ...dispatchOpts } = opts\n    const {\n      // Retry scoped\n      retry: retryFn\x2C\n      maxRetries\x2C\n      maxTimeout\x2C\n      minTimeout\x2C\n      timeoutFactor\x2C\n      // Response scoped\n      methods\x2C\n      errorCodes\x2C\n      retryAfter\x2C\n      statusCodes\n    } = retryOptions ?? {}\n\n    this.dispatch = handlers.dispatch\n    this.handler = handlers.handler\n    this.opts = { ...dispatchOpts\x2C body: wrapRequestBody(opts.body) }\n    this.abort = null\n    this.aborted = false\n    this.retryOpts = {\n      retry: retryFn ?? RetryHandler[kRetryHandlerDefaultRetry]\x2C\n      retryAfter: retryAfter ?? true\x2C\n      maxTimeout: maxTimeout ?? 30 * 1000\x2C // 30s\x2C\n      minTimeout: minTimeout ?? 500\x2C // .5s\n      timeoutFactor: timeoutFactor ?? 2\x2C\n      maxRetries: maxRetries ?? 5\x2C\n      // What errors we should retry\n      methods: methods ?? ['GET'\x2C 'HEAD'\x2C 'OPTIONS'\x2C 'PUT'\x2C 'DELETE'\x2C 'TRACE']\x2C\n      // Indicates which errors to retry\n      statusCodes: statusCodes ?? [500\x2C 502\x2C 503\x2C 504\x2C 429]\x2C\n      // List of errors to retry\n      errorCodes: errorCodes ?? [\n        'ECONNRESET'\x2C\n        'ECONNREFUSED'\x2C\n        'ENOTFOUND'\x2C\n        'ENETDOWN'\x2C\n        'ENETUNREACH'\x2C\n        'EHOSTDOWN'\x2C\n        'EHOSTUNREACH'\x2C\n        'EPIPE