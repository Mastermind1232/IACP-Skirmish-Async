script-source,257,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/engine/misc-helpers.js,/**\n * Miscellaneous helper functions extracted from index.js.\n * Includes attachment embed building\x2C game-end checks\x2C undo\x2C ID extraction\x2C round messaging.\n */\n\nimport {\n  EmbedBuilder\x2C\n  ActionRowBuilder\x2C\n  ButtonBuilder\x2C\n  ButtonStyle\x2C\n  AttachmentBuilder\x2C\n} from 'discord.js';\nimport { fetchGameChannel\x2C sanitizeMentions } from '../discord/channel-helpers.js';\nimport { chunkButtonsToRows } from '../discord/components.js';\nimport { computeDeckHash } from '../game/deck-hash.js';\nimport { getFavoriteDeckByHash\x2C isFavoritesAvailable } from '../db.js';\nimport { buildFavoriteConfirmButtons\x2C buildFavoriteConfirmContent } from '../handlers/favorites.js';\nimport { getLoadoutCards\x2C getRootDir } from '../data-loader.js';\n\n/**\n * Build embeds and files for the "Attachments" message under a DC.\n * CC attachments then DC (Skirmish Upgrade) attachments.\n * @param {string[]} ccNames\n * @param {string[]} [dcNames]\n * @param {string|null} [attachedToDcName]\n * @param {object} deps\n * @returns {Promise<{ embeds: EmbedBuilder[]\x2C files: AttachmentBuilder[] }>}\n */\nexport async function buildAttachmentEmbedsAndFiles(ccNames\x2C dcNames\x2C attachedToDcName\x2C deps) {\n  const embeds = [];\n  const files = [];\n  const loadoutCards = getLoadoutCards();\n  const rootDir = getRootDir();\n  const items = [\n    ...(ccNames || []).map((name\x2C i) => ({ name\x2C prefix: 'cc-attach'\x2C fallbackLabel: `Attachment ${i + 1}`\x2C resolvePath: deps.getCommandCardImagePath }))\x2C\n    ...(dcNames || []).map((name\x2C i) => {\n      const loadout = loadoutCards[name];\n      if (loadout) {\n        return {\n          name\x2C prefix: 'loadout'\x2C fallbackLabel: 'Loadout'\x2C\n          resolvePath: () => loadout.imagePath ? deps.join(rootDir\x2C loadout.imagePath) : null\x2C\n          isLoadout: true\x2C abilityText: loadout.abilityText\x2C\n        };\n      }\n      return { name\x2C prefix: 'dc-attach'\x2C fallbackLabel: `Skirmish Upgrade ${i + 1}`\x2C resolvePath: (n) => { const rel = deps.getDcImagePath(n); return rel ? deps.join(deps.rootDir\x2C rel) : null; } };\n    })\x2C\n  ];\n  for (let i = 0; i < items.length; i++) {\n    const { name\x2C prefix\x2C fallbackLabel\x2C resolvePath\x2C isLoadout\x2C abilityText } = items[i];\n    const path = resolvePath(name);\n    const ext = path ? (path.toLowerCase().endsWith('.png') ? 'png' : 'jpg') : 'jpg';\n    const fileName = `${prefix}-${i}-${(name || '').replace(/[^a-zA-Z0-9]/g\x2C '')}.${ext}`;\n    const embed = new EmbedBuilder()\n      .setTitle(isLoadout ? `\\u2694\\uFE0F Imperial Loadout: ${name}` : `\\uD83D\\uDCCE ${name || fallbackLabel}`)\n      .setColor(deps.COLORS.BLURPLE);\n    if (attachedToDcName) {\n      embed.setDescription(isLoadout\n        ? `**${attachedToDcName}** \\u2014 ${abilityText}`\n        : `Attached to: **${attachedToDcName}**`);\n    }\n    if (path && deps.existsSync(path)) {\n      files.push(new AttachmentBuilder(path\x2C { name: fileName }));\n      if (isLoadout) {\n        embed.setImage(`attachment://${fileName}`);\n      } else {\n        embed.setThumbnail(`attachment://${fileName}`);\n      }\n    }\n    embeds.push(embed);\n  }\n  return { embeds\x2C files };\n}\n\n/**\n * Returns true if game ended (and replied to user). Call after getGame() in handlers to block further actions.\n * @param {object} game\n * @param {object} interaction\n * @param {object} deps\n * @returns {Promise<boolean>}\n */\nexport async function replyIfGameEnded(game\x2C interaction\x2C deps) {\n  if (game?.ended) {\n    await interaction.followUp({ content: 'This game has ended.'\x2C ephemeral: true }).catch(deps.discordCatch);\n    return true;\n  }\n  return false;\n}\n\n/**\n * Push one undo step. Trims to MAX_UNDO_DEPTH to prevent unbounded growth.\n * @param {object} game\n * @param {object} entry\n * @param {object} deps\n */\nexport function pushUndo(game\x2C entry\x2C deps) {\n  game.undoStack = game.undoStack || [];\n  const { undoStack\x2C ...rest } = game;\n  const snapshot = JSON.parse(JSON.stringify(rest));\n  game.undoStack.push({ ...entry\x2C snapshot\x2C ts: Date.now() });\n  if (game.undoStack.length > deps.MAX_UNDO_DEPTH) game.undoStack.shift();\n}\n\n/**\n * Extract game ID from an interaction's customId using known prefix patterns.\n * @param {object} interaction\n * @param {object} deps\n * @returns {string|null}\n */\nexport function extractGameIdFromInteraction(interaction\x2C deps) {\n  const id = interaction.customId || interaction.values?.[0] || '';\n  const prefixes = [\n    'status_phase_'\x2C 'end_end_of_round_'\x2C 'end_start_of_round_'\x2C 'map_selection_'\x2C 'draft_random_'\x2C\n    'pass_activation_turn_'\x2C 'combat_ready_'\x2C 'combat_roll_'\x2C 'cc_play_select_'\x2C 'cc_discard_select_'\x2C 'cc_attach_to_'\x2C\n    'botmenu_kill_yes_'\x2C 'botmenu_kill_no_'\x2C 'botmenu_kill_'\x2C\n    'kill_game_'\x2C 'refresh_map_'\x2C 'refresh_all_'\x2C 'undo_'\x2C 'deployment_zone_red_'\x2C 'deployment_zone_blue_'\x2C\n  ];\n  const games = deps.getGamesMap();\n  for (const p of prefixes) {\n    if (id.startsWith(p)) {\n      const rest = id.slice(p.length);\n      const gameId = rest.split('_')[0];\n      if (gameId && games.has(gameId)) return gameId;\n      return gameId || null;\n    }\n  }\n  const m = id.match(/^(?:squad_modal_|deploy_modal_|special_done_|interact_choice_|interact_cancel_)([^_]+)/);\n  if (m && games.has(m[1])) return m[1];\n  const dcMatch = id.match(/^dc_(?:activate|move|attack|interact|special)_([^_]+)/);\n  if (dcMatch) {\n    const part = dcMatch[1];\n    if (games.has(part)) return part;\n    for (const [gid\x2C g] of games) {\n      if (g.p1DcMessageIds?.includes(part) || g.p2DcMessageIds?.includes(part)) return gid;\n      for (const [msgId\x2C meta] of deps.dcMessageMeta) {\n        if (meta.gameId === gid && (String(msgId) === part || part.startsWith(msgId))) return gid;\n      }\n    }\n  }\n  const moveMatch = id.match(/^move_(?:mp|pick)_([^_]+)/);\n  if (moveMatch && games.has(moveMatch[1])) return moveMatch[1];\n  const attackMatch = id.match(/^attack_target_(.+)_\\d+_\\d+$/);\n  if (attackMatch) {\n    const msgId = attackMatch[1];\n    for (const [gid\x2C g] of games) {\n      if ([...(g.p1DcMessageIds || [])\x2C ...(g.p2DcMessageIds || [])].includes(msgId)) return gid;\n    }\n  }\n  return null;\n}\n\n/**\n * Resolve game ID for per-game mutex locking.\n * Tries multiple strategies: prefix stripping\x2C dcMessageMeta lookup\x2C existing extractor\x2C channel-based.\n * Returns null for interactions that don't belong to a game (lobby\x2C menu\x2C etc.) \u2014 those run without lock.\n * @param {object} interaction\n * @param {object} deps\n * @returns {string|null}\n */\nexport function resolveGameIdForLock(interaction\x2C deps) {\n  const customId = interaction.customId || '';\n  if (!customId) return null;\n\n  const type = interaction.isButton?.() ? 'button'\n    : interaction.isStringSelectMenu?.() ? 'select'\n    : interaction.isModalSubmit?.() ? 'modal'\n    : null;\n  if (!type) return null;\n\n  const prefix = deps.getHandlerKey(customId\x2C type);\n  if (!prefix) return null;\n\n  const payload = customId.slice(prefix.length);\n  const firstSegment = payload.split('_')[0];\n\n  // Strategy 1: first segment is a gameId directly (5-digit zero-padded)\n  if (firstSegment && deps.getGame(firstSegment)) return firstSegment;\n\n  // Strategy 2: first segment is a Discord message ID -> look up in dcMessageMeta\n  if (firstSegment && /^\\d{10\x2C}$/.test(firstSegment)) {\n    const meta = deps.dcMessageMeta.get(firstSegment);\n    if (meta?.gameId) return meta.gameId;\n  }\n\n  // Strategy 3: fall back to existing extractor (handles more complex patterns)\n  const existing = extractGameIdFromInteraction(interaction\x2C deps);\n  if (existing) return existing;\n\n  // Strategy 4: resolve by channel (covers thread-based interactions)\n  const _chMatch = deps.findGameByChannel(deps.getGamesMap()\x2C interaction.channelId);\n  if (_chMatch) return _chMatch.gameId;\n\n  return null;\n}\n\n/**\n * Extract game ID from a message by channel lookup.\n * @param {object} message\n * @param {object} deps\n * @returns {string|null}\n */\nexport function extractGameIdFromMessage(message\x2C deps) {\n  const chId = message.channel?.id;\n  if (!chId) return null;\n  const _msgMatch = deps.findGameByChannel(deps.getGamesMap()\x2C chId);\n  if (_msgMatch) return _msgMatch.gameId;\n  if (message.channel?.isThread?.()) {\n    const parent = message.channel.parent;\n    if (parent?.name === 'new-games') return null;\n    for (const [gameId\x2C g] of deps.getGamesMap()) {\n      const cat = message.guild?.channels?.cache?.get(g.gameCategoryId);\n      if (cat && message.channel.parentId === cat.id) return gameId;\n    }\n  }\n  return null;\n}\n\n/**\n * Post Devaron Garrison B door-selection buttons for the next player in game.pendingDoorSelections.\n * @param {object} game\n * @param {Array} allDoors - from map-tokens.json\x2C array of [a\x2C b] coordinate pairs\n * @param {import('discord.js').TextChannel} channel - general channel\n * @param {string} gameId\n * @param {object} deps\n */\nexport async function postDevaronDoorButtons(game\x2C allDoors\x2C channel\x2C gameId\x2C deps) {\n  if (!game.pendingDoorSelections || game.pendingDoorSelections.length === 0) return;\n  const pending = game.pendingDoorSelections[0];\n  const { playerNum\x2C doorsRemaining } = pending;\n  const pid = deps.getPlayerId(game\x2C playerNum);\n  const openedSet = new Set((game.openedDoors || []).map((k) => String(k).toLowerCase()));\n  const available = (allDoors || []).filter(([a\x2C b]) => {\n    const ek1 = `${a}|${b}`.toLowerCase();\n    const ek2 = `${b}|${a}`.toLowerCase();\n    return !openedSet.has(ek1) && !openedSet.has(ek2);\n  });\n  if (available.length === 0) {\n    game.pendingDoorSelections.shift();\n    await channel.send(sanitizeMentions({ content: `<@${pid}> \u2014 All doors are already open (no more selections needed).`\x2C allowedMentions: { users: [pid] } })).catch(deps.discordCatch);\n    return;\n  }\n  const rows = [];\n  for (let i = 0; i < Math.min(available.length\x2C 20); i += 5) {\n    const chunk = available.slice(i\x2C i + 5);\n    rows.push(new ActionRowBuilder().addComponents(\n      chunk.map(([a\x2C b]) => new ButtonBuilder()\n        .setCustomId(`devaron_door_open_${gameId}_${a.toLowerCase()}|${b.toLowerCase()}`)\n        .setLabel(`Open door ${a.toUpperCase()}\u2194${b.toUpperCase()}`)\n        .setStyle(ButtonStyle.Primary)\n      )\n    ));\n  }\n  await channel.send(sanitizeMentions({\n    content: `<@${pid}> \u2014 **Crate Rush (EoR)**: You control ${doorsRemaining} terminal${doorsRemaining !== 1 ? 's' : ''}. Choose a door to open (${doorsRemaining} remaining):`\x2C\n    components: rows\x2C\n    allowedMentions: { users: [pid] }\x2C\n  })).catch(deps.discordCatch);\n}\n\n/**\n * Post crate-push buttons for Devaron Garrison B end-of-round crate push phase.\n * @param {object} game\n * @param {import('discord.js').TextChannel} channel - general channel\n * @param {string} gameId\n * @param {object} deps\n */\nexport async function postDevaronCratePushPrompts(game\x2C channel\x2C gameId\x2C deps) {\n  const mapData = deps.getMapTokensData()['devaron-garrison'];\n  const allOrigCoords = Object.values(mapData?.missionB?.positions || {}).flat().filter(Boolean).map((c) => String(c).toLowerCase());\n  if (allOrigCoords.length === 0) return;\n  for (const pn of [1\x2C 2]) {\n    const pid = deps.getPlayerId(game\x2C pn);\n    const controlled = allOrigCoords.filter((origCoord) => {\n      const cur = String(game.cratePositions?.[origCoord] || origCoord).toLowerCase();\n      return deps.getSpaceController(game\x2C 'devaron-garrison'\x2C cur) === pn;\n    });\n    if (controlled.length === 0) continue;\n    const rows = [];\n    for (let i = 0; i < Math.min(controlled.length\x2C 20); i += 5) {\n      const chunk = controlled.slice(i\x2C i + 5);\n      rows.push(new ActionRowBuilder().addComponents(\n        chunk.map((origCoord) => {\n          const cur = String(game.cratePositions?.[origCoord] || origCoord).toLowerCase();\n          return new ButtonBuilder()\n            .setCustomId(`devaron_crate_push_${gameId}_${origCoord}`)\n            .setLabel(`Push crate @ ${cur.toUpperCase()}`)\n            .setStyle(ButtonStyle.Secondary);\n        })\n      ));\n    }\n    await channel.send(sanitizeMentions({\n      content: `<@${pid}> \u2014 **Crate Rush (EoR)**: Push each controlled crate up to 3 spaces. Select a crate:`\x2C\n      components: rows\x2C\n      allowedMentions: { users: [pid] }\x2C\n    })).catch(deps.discordCatch);\n  }\n}\n\n/**\n * Post Krykna push selection buttons for Chopper Base A end-of-round push phase.\n * Shows the next player in game.pendingKryknaPushQueue buttons for each un-pushed Krykna.\n * @param {object} game\n * @param {import('discord.js').TextChannel} channel\n * @param {string} gameId\n * @param {object} deps\n */\nexport async function postKryknaPushButtons(game\x2C channel\x2C gameId\x2C deps) {\n  if (!game.pendingKryknaPushQueue || game.pendingKryknaPushQueue.length === 0) return;\n  const playerNum = game.pendingKryknaPushQueue[0];\n  const pid = deps.getPlayerId(game\x2C playerNum);\n  const pushedIds = new Set(game.kryknaPushedIds || []);\n  const activeKrykna = (game.npcKrykna || []).filter((k) => !k.defeated && !pushedIds.has(k.id));\n  if (activeKrykna.length === 0) return;\n  const remaining = game.pendingKryknaPushQueue.length;\n  const buttons = activeKrykna.map((k) =>\n    new ButtonBuilder()\n      .setCustomId(`krykna_push_${gameId}_${k.id}`)\n      .setLabel(`Push ${k.id} @ ${String(k.coord).toUpperCase()}`)\n      .setStyle(ButtonStyle.Danger)\n  );\n  const rows = chunkButtonsToRows(buttons);\n  await channel.send(sanitizeMentions({\n    content: `\\uD83D\\uDD77\\uFE0F **Krykna Push Phase** (${remaining} push${remaining !== 1 ? 'es' : ''} remaining) \u2014 <@${pid}>\x2C choose a Krykna to push up to 3 spaces (end adjacent to most figures if possible):`\x2C\n    components: rows\x2C\n    allowedMentions: { users: [pid] }\x2C\n  })).catch(deps.discordCatch);\n}\n\n/**\n * Post claimed Krykna placement buttons (Place / Skip) for the current player.\n * @param {object} game\n * @param {import('discord.js').TextChannel} channel\n * @param {string} gameId\n * @param {object} deps - { getPlayerId\x2C discordCatch }\n */\nexport async function postKryknaPlaceButtons(game\x2C channel\x2C gameId\x2C deps) {\n  if (!game.pendingClaimedKryknaQueue || game.pendingClaimedKryknaQueue.length === 0) return;\n  const playerNum = game.pendingClaimedKryknaQueue[0];\n  const pid = deps.getPlayerId(game\x2C playerNum);\n  const claimed = game.claimedKrykna?.[playerNum] || 0;\n  const rows = [\n    new ActionRowBuilder().addComponents(\n      new ButtonBuilder()\n        .setCustomId(`krykna_place_${gameId}`)\n        .setLabel(`Place a Krykna (${claimed} claimed)`)\n        .setStyle(ButtonStyle.Success)\x2C\n      new ButtonBuilder()\n        .setCustomId(`krykna_place_skip_${gameId}`)\n        .setLabel('Skip')\n        .setStyle(ButtonStyle.Secondary)\x2C\n    )\x2C\n  ];\n  await channel.send(sanitizeMentions({\n    content: `\ud83d\udd77\ufe0f **Claimed Krykna Placement** \u2014 <@${pid}>\x2C you may place 1 claimed Krykna in your opponent's deployment zone:`\x2C\n    components: rows\x2C\n    allowedMentions: { users: [pid] }\x2C\n  })).catch(deps.discordCatch);\n}\n\n/**\n * Post fluctuation swap buttons for Lothal Wastes B end-of-round swap phase.\n * Shows one button per fluctuation position (that hasn't been moved this round) + Skip.\n * If game.pendingFluctuationSwapFirst is set\x2C we're in the second-pick phase (target selection).\n * @param {object} game\n * @param {import('discord.js').TextChannel} channel - general channel\n * @param {string} gameId\n * @param {number} playerNum - whose turn to swap\n * @param {object} deps - { getPlayerId\x2C getMapTokensData\x2C discordCatch\x2C getCurrentFluctuationPositions }\n */\nexport async function postFluctuationSwapButtons(game\x2C channel\x2C gameId\x2C playerNum\x2C deps) {\n  const pid = deps.getPlayerId(game\x2C playerNum);\n  const mapId = game.selectedMap?.id;\n  const positions = deps.getCurrentFluctuationPositions(game\x2C mapId\x2C deps.getMapTokensData);\n  const allTokens = deps.getMapTokensData()[mapId]?.missionB;\n  const tokenTypes = allTokens?.tokenTypes || [];\n  const colorToPowerToken = { yellow: 'Surge'\x2C blue: 'Evade'\x2C green: 'Block'\x2C red: 'Damage' };\n  const swappedSet = new Set(game.fluctuationSwappedThisRound || []);\n  const firstPick = game.pendingFluctuationSwapFirst || null;\n\n  // Build flat list of {coord\x2C color\x2C label} for all current fluctuation positions\n  const allFluctuations = [];\n  for (const [id\x2C coords] of Object.entries(positions)) {\n    if (!Array.isArray(coords)) continue;\n    const typeInfo = tokenTypes[parseInt(id)];\n    const imageMatch = (typeInfo?.image || '').match(/Neutral (\\w+)\\./i);\n    const color = imageMatch ? imageMatch[1].toLowerCase() : 'unknown';\n    for (const coord of coords) {\n      if (!coord) continue;\n      allFluctuations.push({ coord: String(coord).toLowerCase()\x2C color\x2C id });\n    }\n  }\n\n  // Filter: exclude already-swapped-this-round coords\n  let available = allFluctuations.filter(f => !swappedSet.has(f.coord));\n  // In second-pick mode\x2C exclude the first pick itself\n  if (firstPick) {\n    available = available.filter(f => f.coord !== firstPick);\n  }\n\n  if (available.length === 0 && !firstPick) {\n    // No fluctuations available to swap \u2014 auto-skip\n    await channel.send(sanitizeMentions({\n      content: `<@${pid}> \u2014 **Fluctuations**: No swappable fluctuations remaining. Skipping.`\x2C\n      allowedMentions: { users: [pid] }\x2C\n    })).catch(deps.discordCatch);\n    return;\n  }\n\n  const label = firstPick\n    ? `Select target fluctuation to swap with **${firstPick.toUpperCase()}** (${allFluctuations.find(f => f.coord === firstPick)?.color?.toUpperCase() || '?'}):`\n    : `Select a fluctuation to swap (or Skip):`;\n\n  const buttons = available.slice(0\x2C 24).map(f =>\n    new ButtonBuilder()\n      .setCustomId(`fluctuation_swap_${gameId}_${f.coord}`)\n      .setLabel(`${f.color.charAt(0).toUpperCase() + f.color.slice(1)} @ ${f.coord.toUpperCase()}`)\n      .setStyle(ButtonStyle.Primary)\n  );\n  if (!firstPick) {\n    buttons.push(\n      new ButtonBuilder()\n        .setCustomId(`fluctuation_skip_${gameId}`)\n        .setLabel('Skip Swap')\n        .setStyle(ButtonStyle.Secondary)\n    );\n  } else {\n    buttons.push(\n      new ButtonBuilder()\n        .setCustomId(`fluctuation_skip_${gameId}`)\n        .setLabel('Cancel (Skip)')\n        .setStyle(ButtonStyle.Secondary)\n    );\n  }\n  const rows = chunkButtonsToRows(buttons);\n  await channel.send(sanitizeMentions({\n    content: `\ud83d\udd04 **Fluctuation Swap** \u2014 <@${pid}> (P${playerNum})\x2C ${label}`\x2C\n    components: rows.slice(0\x2C 5)\x2C\n    allowedMentions: { users: [pid] }\x2C\n  })).catch(deps.discordCatch);\n}\n\n/**\n * Find a Figurehead figure within range 4 of the target (for Figurehead ability).\n * @param {object} game\n * @param {number} defenderPlayerNum\n * @param {string} targetFigureKey\n * @param {object} deps\n * @returns {{ figureKey: string\x2C msgId: string\x2C figIndex: number\x2C label: string }|null}\n */\nexport function findFigureheadFigure(game\x2C defenderPlayerNum\x2C targetFigureKey\x2C deps) {\n  if (!game.selectedMap?.id) return null;\n  const targetPos = game.figurePositions?.[defenderPlayerNum]?.[targetFigureKey];\n  if (!targetPos) return null;\n  const dcList = deps.getDcList(game\x2C defenderPlayerNum);\n  if (!dcList) return null;\n  for (let i = 0; i < dcList.length; i++) {\n    const dc = dcList[i];\n    if (!dc) continue;\n    const dcName = dc.dcName;\n    const eff = deps.getDcEffect(dcName);\n    if (!(eff?.specialAbilityIds || []).includes('figurehead')) continue;\n    const figures = game.figurePositions?.[defenderPlayerNum] || {};\n    for (const [fk\x2C pos] of Object.entries(figures)) {\n      if (fk === targetFigureKey) continue;\n      if (deps.dcNameFromFigureKey(fk) !== dcName) continue;\n      if (!deps.isWithinN(pos\x2C targetPos\x2C 4\x2C game.selectedMap.id)) continue;\n      const msgId = deps.findDcMessageIdForFigure(game.gameId\x2C defenderPlayerNum\x2C fk);\n      const { figureIndex: figIndex } = deps.parseFigureKey(fk);\n      return { figureKey: fk\x2C msgId\x2C figIndex\x2C label: dc.displayName || dcName };\n    }\n  }\n  return null;\n}\n\n/**\n * Send deck-illegal alert with PLAY IT ANYWAY / REDO buttons to the hand channel.\n * @param {object} game\n * @param {boolean} isP1\n * @param {object} squad\n * @param {object} validation\n * @param {object} client - Discord client\n * @param {object} deps\n */\nexport async function sendDeckIllegalAlert(game\x2C isP1\x2C squad\x2C validation\x2C client\x2C deps) {\n  const gameId = game.gameId;\n  const playerNum = isP1 ? 1 : 2;\n  const playerId = isP1 ? game.player1Id : game.player2Id;\n  const key = `${gameId}_${playerNum}`;\n  deps.pendingIllegalSquad.set(key\x2C { squad\x2C timestamp: Date.now() });\n  const handChannelId = isP1 ? game.p1HandId : game.p2HandId;\n  const handChannel = await fetchGameChannel(client\x2C handChannelId);\n  const errorList = validation.errors.map((e) => `\\u2022 ${e}`).join('\\n');\n  const row = new ActionRowBuilder().addComponents(\n    new ButtonBuilder()\n      .setCustomId(deps.getDeckIllegalPlayCustomId(gameId\x2C playerNum))\n      .setLabel('PLAY IT ANYWAY')\n      .setStyle(ButtonStyle.Success)\x2C\n    new ButtonBuilder()\n      .setCustomId(deps.getDeckIllegalRedoCustomId(gameId\x2C playerNum))\n      .setLabel('REDO')\n      .setStyle(ButtonStyle.Danger)\n  );\n  await handChannel.send(sanitizeMentions({\n    content: `<@${playerId}> \u2014 Your deck is **not legal**.\\n\\n${errorList}\\n\\nChoose an option below:`\x2C\n    components: [row]\x2C\n    allowedMentions: { users: [playerId] }\x2C\n  }));\n}\n\n/**\n * Send squad confirmation message with Confirm/Cancel buttons to the hand channel.\n * @param {object} game\n * @param {boolean} isP1\n * @param {object} squad\n * @param {object} validation\n * @param {object} client - Discord client\n * @param {object} deps\n */\nexport async function sendSquadConfirmation(game\x2C isP1\x2C squad\x2C validation\x2C client\x2C deps) {\n  const gameId = game.gameId;\n  const playerNum = isP1 ? 1 : 2;\n  const playerId = isP1 ? game.player1Id : game.player2Id;\n  const key = `${gameId}_${playerNum}`;\n  deps.pendingSquadConfirm.set(key\x2C { squad\x2C validation\x2C timestamp: Date.now() });\n  const handChannelId = isP1 ? game.p1HandId : game.p2HandId;\n  const handChannel = await fetchGameChannel(client\x2C handChannelId);\n  const text = deps.buildSquadConfirmText(squad\x2C validation);\n\n  // Look up existing favorite if DB is available\n  let existingFavorite = null;\n  if (isFavoritesAvailable()) {\n    const deckHash = computeDeckHash(squad);\n    existingFavorite = await getFavoriteDeckByHash(playerId\x2C deckHash);\n  }\n\n  const row = buildFavoriteConfirmButtons(gameId\x2C playerNum\x2C existingFavorite);\n  const content = buildFavoriteConfirmContent(text\x2C existingFavorite);\n\n  await handChannel.send(sanitizeMentions({\n    content\x2C\n    components: [row]\x2C\n    allowedMentions: { users: [playerId] }\x2C\n  }));\n}\n\n/**\n * Send round activation phase message to general channel.\n * @param {object} game\n * @param {object} client - Discord client\n * @param {object} deps\n */\nexport async function sendRoundActivationPhaseMessage(game\x2C client\x2C deps) {\n  const gameId = game.gameId;\n  const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n  const round = game.currentRound || 1;\n  const roundEmbed = new EmbedBuilder()\n    .setTitle(`${deps.GAME_PHASES.ROUND.emoji}  ROUND ${round} - Start of Round`)\n    .setColor(deps.PHASE_COLOR);\n  const showBtn = deps.shouldShowEndActivationPhaseButton(game\x2C gameId);\n  const components = [];\n  if (showBtn) {\n    components.push(new ActionRowBuilder().addComponents(\n      new ButtonBuilder()\n        .setCustomId(`status_phase_${gameId}`)\n        .setLabel(`End R${game.currentRound || 1} Activation Phase`)\n        .setStyle(ButtonStyle.Secondary)\n    ));\n  }\n  const initRem = game.initiativePlayerId === game.player1Id ? (game.p1ActivationsRemaining ?? 0) : (game.p2ActivationsRemaining ?? 0);\n  const otherRem = game.initiativePlayerId === game.player1Id ? (game.p2ActivationsRemaining ?? 0) : (game.p1ActivationsRemaining ?? 0);\n  if (otherRem > initRem && initRem > 0) {\n    components.push(new ActionRowBuilder().addComponents(\n      new ButtonBuilder()\n        .setCustomId(`pass_activation_turn_${gameId}`)\n        .setLabel(`Pass (opponent has ${otherRem - initRem} more activation${otherRem - initRem !== 1 ? 's' : ''} than you)`)\n        .setStyle(ButtonStyle.Secondary)\n    ));\n  }\n  const initPlayerNum = deps.getInitiativePlayerNum(game);\n  const initZone = deps.getInitiativePlayerZoneLabel(game);\n  const passHint = otherRem > initRem && initRem > 0 ? ' You may pass back (opponent has more activations).' : '';\n  const content = showBtn\n    ? `<@${game.initiativePlayerId}> (${initZone}**Player ${initPlayerNum}**) **Round ${round}** \u2014 Your turn! All deployment groups readied. Both players: click **End R${round} Activation Phase** when you've used all activations and any end-of-activation effects.${passHint}`\n    : `<@${game.initiativePlayerId}> (${initZone}**Player ${initPlayerNum}**) **Round ${round}** \u2014 Your turn! All deployment groups readied. Use all activations and actions. The **End R${round} Activation Phase** button will appear when both players have done so.${passHint}`;\n  const sent = await generalChannel.send(sanitizeMentions({\n    content\x2C\n    embeds: [roundEmbed]\x2C\n    components\x2C\n    allowedMentions: { users: [game.initiativePlayerId] }\x2C\n  }));\n  game.roundActivationMessageId = sent.id;\n  game.roundActivationButtonShown = showBtn;\n  game.currentActivationTurnPlayerId = game.initiativePlayerId;\n  // Pure-state flag for restart-strand recovery: once this function has posted\n  // the round activation message\x2C the safety net in refreshAllGameComponents\n  // and finishPostDeploy must not re-post it. Monotonically true after first set.\n  game.activationPhaseMessagePosted = true;\n  await deps.updateHandChannelMessages(game\x2C client);\n}\n
