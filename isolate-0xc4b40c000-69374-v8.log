script-source,125,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/db.js,/**\n * PostgreSQL persistence for game state.\n * Used when DATABASE_URL is set (e.g. on Railway).\n * Falls back to file-based storage when not set (local dev).\n */\nimport pg from 'pg';\nimport { readFileSync } from 'fs';\nimport { join\x2C dirname } from 'path';\nimport { fileURLToPath } from 'url';\nimport { getPlayerId\x2C getInitiativePlayerNum } from './game/player-helpers.js';\n\nconst __dbDirname = dirname(fileURLToPath(import.meta.url));\n\nconst { Pool } = pg;\n\nlet pool = null;\n\n/** True if DATABASE_URL is set and we should use Postgres. */\nexport function isDbConfigured() {\n  return !!process.env.DATABASE_URL;\n}\n\n/** Connect and create the games and completed_games tables if they don't exist (DB2). */\nexport async function initDb() {\n  if (!isDbConfigured()) return;\n  try {\n    pool = new Pool({\n      connectionString: process.env.DATABASE_URL\x2C\n      ssl: process.env.DATABASE_URL?.includes('localhost') ? false : { rejectUnauthorized: false }\x2C\n    });\n    await pool.query(`\n      CREATE TABLE IF NOT EXISTS games (\n        game_id TEXT PRIMARY KEY\x2C\n        game_data JSONB NOT NULL\x2C\n        updated_at TIMESTAMPTZ DEFAULT NOW()\n      )\n    `);\n    await pool.query(`\n      CREATE TABLE IF NOT EXISTS completed_games (\n        id SERIAL PRIMARY KEY\x2C\n        winner_id TEXT\x2C\n        player1_id TEXT NOT NULL\x2C\n        player2_id TEXT NOT NULL\x2C\n        player1_affiliation TEXT\x2C\n        player2_affiliation TEXT\x2C\n        player1_army_json JSONB\x2C\n        player2_army_json JSONB\x2C\n        map_id TEXT\x2C\n        mission_id TEXT\x2C\n        deployment_zone_winner TEXT\x2C\n        ended_at TIMESTAMPTZ DEFAULT NOW()\x2C\n        round_count INT\n      )\n    `);\n    // Add game_id column to completed_games if missing (migration)\n    await pool.query(`ALTER TABLE completed_games ADD COLUMN IF NOT EXISTS game_id TEXT`).catch(() => {});\n    // DB3: optional indexes for active games / recent updates\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_games_updated_at ON games (updated_at)').catch((err) => { console.error('[discord]'\x2C err?.message ?? err); });\n    await pool.query(`CREATE INDEX IF NOT EXISTS idx_games_ended ON games ((game_data->>'ended'))`).catch((err) => { console.error('[discord]'\x2C err?.message ?? err); });\n    // Achievements tables\n    await pool.query(`\n      CREATE TABLE IF NOT EXISTS achievement_defs (\n        id TEXT PRIMARY KEY\x2C\n        name TEXT NOT NULL\x2C\n        description TEXT NOT NULL\x2C\n        icon TEXT DEFAULT '\ud83c\udfc6'\x2C\n        trigger TEXT NOT NULL\x2C\n        threshold INT NOT NULL DEFAULT 1\n      )\n    `);\n    await pool.query(`\n      CREATE TABLE IF NOT EXISTS user_achievements (\n        id SERIAL PRIMARY KEY\x2C\n        user_id TEXT NOT NULL\x2C\n        achievement_id TEXT NOT NULL REFERENCES achievement_defs(id)\x2C\n        earned_at TIMESTAMPTZ DEFAULT NOW()\x2C\n        UNIQUE(user_id\x2C achievement_id)\n      )\n    `);\n    await pool.query(`\n      CREATE TABLE IF NOT EXISTS domain_events (\n        id SERIAL PRIMARY KEY\x2C\n        game_id TEXT NOT NULL\x2C\n        seq INT NOT NULL\x2C\n        type TEXT NOT NULL\x2C\n        correlation_id TEXT\x2C\n        player_id TEXT\x2C\n        aggregate_version INT NOT NULL\x2C\n        timestamp TIMESTAMPTZ DEFAULT NOW()\x2C\n        payload JSONB NOT NULL\x2C\n        UNIQUE(game_id\x2C seq)\n      )\n    `);\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_domain_events_game_seq ON domain_events (game_id\x2C seq)').catch(() => {});\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_domain_events_game_type ON domain_events (game_id\x2C type)').catch(() => {});\n    await pool.query(`\n      CREATE TABLE IF NOT EXISTS game_snapshots (\n        id SERIAL PRIMARY KEY\x2C\n        game_id TEXT NOT NULL\x2C\n        version INT NOT NULL\x2C\n        state JSONB NOT NULL\x2C\n        created_at TIMESTAMPTZ DEFAULT NOW()\x2C\n        UNIQUE(game_id\x2C version)\n      )\n    `);\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_game_snapshots_game ON game_snapshots (game_id\x2C version DESC)').catch(() => {});\n    // Coverage tables\n    await pool.query(`\n      CREATE TABLE IF NOT EXISTS coverage_regions (\n        region_id    TEXT PRIMARY KEY\x2C\n        region_data  JSONB NOT NULL\x2C\n        updated_at   TIMESTAMPTZ DEFAULT NOW()\n      )\n    `);\n    await pool.query(`\n      CREATE TABLE IF NOT EXISTS coverage_incidents (\n        id            SERIAL PRIMARY KEY\x2C\n        region_id     TEXT NOT NULL\x2C\n        region_name   TEXT NOT NULL\x2C\n        severity      TEXT NOT NULL\x2C\n        note          TEXT NOT NULL\x2C\n        game_id       TEXT\x2C\n        phase         TEXT\x2C\n        last_action   TEXT\x2C\n        undo_fixed    BOOLEAN DEFAULT FALSE\x2C\n        refresh_fixed BOOLEAN DEFAULT FALSE\x2C\n        siblings      JSONB DEFAULT '[]'\x2C\n        created_at    TIMESTAMPTZ DEFAULT NOW()\n      )\n    `);\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_coverage_incidents_region ON coverage_incidents(region_id)').catch(() => {});\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_coverage_incidents_severity ON coverage_incidents(severity)').catch(() => {});\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_coverage_incidents_created ON coverage_incidents(created_at DESC)').catch(() => {});\n    // Favorite decks (personal saved-deck library)\n    await pool.query(`\n      CREATE TABLE IF NOT EXISTS favorite_decks (\n        id            BIGSERIAL PRIMARY KEY\x2C\n        user_id       TEXT NOT NULL\x2C\n        deck_hash     TEXT NOT NULL\x2C\n        saved_name    TEXT NOT NULL\x2C\n        deck_data     JSONB NOT NULL\x2C\n        raw_list_text TEXT\x2C\n        affiliation   TEXT\x2C\n        point_total   INT\x2C\n        created_at    TIMESTAMPTZ DEFAULT NOW()\x2C\n        updated_at    TIMESTAMPTZ DEFAULT NOW()\x2C\n        last_used_at  TIMESTAMPTZ\x2C\n        use_count     INT NOT NULL DEFAULT 0\x2C\n        UNIQUE(user_id\x2C deck_hash)\n      )\n    `);\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_favorite_decks_user ON favorite_decks (user_id\x2C last_used_at DESC NULLS LAST)').catch(() => {});\n\n    // \u2500\u2500 Self-play run artifacts \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    await pool.query(`\n      CREATE TABLE IF NOT EXISTS selfplay_runs (\n        id              BIGSERIAL PRIMARY KEY\x2C\n        game_id         TEXT NOT NULL\x2C\n        guild_id        TEXT\x2C\n        scenario        TEXT\x2C\n        result          TEXT NOT NULL\x2C\n        stop_reason     TEXT NOT NULL\x2C\n        commit_sha      TEXT\x2C\n        map             TEXT\x2C\n        p1_squad        JSONB\x2C\n        p2_squad        JSONB\x2C\n        phase           TEXT\x2C\n        round_phase     TEXT\x2C\n        current_round   INT\x2C\n        active_player   TEXT\x2C\n        total_steps     INT NOT NULL\x2C\n        last_action     TEXT\x2C\n        recent_actions  JSONB NOT NULL DEFAULT '[]'\x2C\n        pending_states  JSONB NOT NULL DEFAULT '{}'\x2C\n        recovery_reason TEXT\x2C\n        error_message   TEXT\x2C\n        error_stack     TEXT\x2C\n        handler_key     TEXT\x2C\n        intended_surface TEXT\x2C\n        actual_channel   TEXT\x2C\n        discord_op       TEXT\x2C\n        discord_error    TEXT\x2C\n        started_at      TIMESTAMPTZ NOT NULL\x2C\n        failed_at       TIMESTAMPTZ NOT NULL DEFAULT NOW()\x2C\n        duration_ms     INT\x2C\n        recovery_fired  BOOLEAN DEFAULT FALSE\x2C\n        recovery_count  INT DEFAULT 0\n      )\n    `);\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_selfplay_runs_game ON selfplay_runs (game_id)').catch(() => {});\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_selfplay_runs_reason ON selfplay_runs (stop_reason)').catch(() => {});\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_selfplay_runs_created ON selfplay_runs (failed_at DESC)').catch(() => {});\n\n    // Phase 1 trace columns (queue runner)\n    for (const col of [\n      { name: 'exploration_mode'\x2C type: 'TEXT' }\x2C\n      { name: 'exercised_handlers'\x2C type: "JSONB DEFAULT '[]'" }\x2C\n      { name: 'seen_action_types'\x2C type: "JSONB DEFAULT '[]'" }\x2C\n      { name: 'triggered_pending_states'\x2C type: "JSONB DEFAULT '[]'" }\x2C\n    ]) {\n      try {\n        await pool.query(`ALTER TABLE selfplay_runs ADD COLUMN ${col.name} ${col.type}`);\n      } catch (err) {\n        if (err.code !== '42701') console.error(`[DB] ALTER selfplay_runs add ${col.name}:`\x2C err.message);\n      }\n    }\n\n    // Phase 2: VP/coverage/telemetry columns (were computed but silently dropped)\n    for (const col of [\n      { name: 'checkpoint_games'\x2C type: 'INT' }\x2C\n      { name: 'checkpoint_file'\x2C type: 'TEXT' }\x2C\n      { name: 'winner'\x2C type: 'TEXT' }\x2C\n      { name: 'p1_vp'\x2C type: 'INT DEFAULT 0' }\x2C\n      { name: 'p2_vp'\x2C type: 'INT DEFAULT 0' }\x2C\n      { name: 'vp_per_round'\x2C type: "JSONB DEFAULT '[]'" }\x2C\n      { name: 'total_rounds'\x2C type: 'INT' }\x2C\n      { name: 'figure_defeats'\x2C type: 'INT DEFAULT 0' }\x2C\n      { name: 'action_type_counts'\x2C type: "JSONB DEFAULT '{}'" }\x2C\n      { name: 'transitions_hit'\x2C type: "JSONB DEFAULT '[]'" }\x2C\n      { name: 'runtime_stats'\x2C type: "JSONB DEFAULT '{}'" }\x2C\n      // End-condition telemetry\n      { name: 'game_end_reason'\x2C type: 'TEXT' }\x2C\n      { name: 'p1_figures_remaining'\x2C type: 'INT' }\x2C\n      { name: 'p2_figures_remaining'\x2C type: 'INT' }\x2C\n    ]) {\n      try {\n        await pool.query(`ALTER TABLE selfplay_runs ADD COLUMN ${col.name} ${col.type}`);\n      } catch (err) {\n        if (err.code !== '42701') console.error(`[DB] ALTER selfplay_runs add ${col.name}:`\x2C err.message);\n      }\n    }\n\n    // \u2500\u2500 Exploration tables (headless explorer + coverage persistence) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    await pool.query(`\n      CREATE TABLE IF NOT EXISTS exploration_transitions (\n        transition_key    TEXT PRIMARY KEY\x2C\n        round_phase       TEXT\x2C\n        pending_set       TEXT\x2C\n        action_type       TEXT\x2C\n        status            TEXT NOT NULL DEFAULT 'headless_seen'\x2C\n        headless_count    INTEGER NOT NULL DEFAULT 0\x2C\n        discord_count     INTEGER NOT NULL DEFAULT 0\x2C\n        invariant_fails   INTEGER NOT NULL DEFAULT 0\x2C\n        context_tags      JSONB DEFAULT '{}'\x2C\n        scenarios_reaching JSONB DEFAULT '[]'\x2C\n        first_seen_at     TIMESTAMPTZ DEFAULT NOW()\x2C\n        updated_at        TIMESTAMPTZ DEFAULT NOW()\n      )\n    `);\n    await pool.query(`\n      CREATE TABLE IF NOT EXISTS exploration_episodes (\n        episode_id        TEXT PRIMARY KEY\x2C\n        source            TEXT NOT NULL DEFAULT 'headless'\x2C\n        seed_config       JSONB NOT NULL\x2C\n        total_steps       INTEGER NOT NULL\x2C\n        unique_transitions INTEGER NOT NULL DEFAULT 0\x2C\n        novel_transitions  INTEGER NOT NULL DEFAULT 0\x2C\n        invariant_errors  INTEGER NOT NULL DEFAULT 0\x2C\n        transitions_hit   JSONB NOT NULL DEFAULT '[]'\x2C\n        result            TEXT\x2C\n        stop_reason       TEXT\x2C\n        duration_ms       INTEGER\x2C\n        created_at        TIMESTAMPTZ DEFAULT NOW()\n      )\n    `);\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_exploration_transitions_status ON exploration_transitions (status)').catch(() => {});\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_exploration_episodes_created ON exploration_episodes (created_at DESC)').catch(() => {});\n\n    // \u2500\u2500 Incidents table (Postgres-first error tracking) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    await pool.query(`\n      CREATE TABLE IF NOT EXISTS incidents (\n        id                  BIGSERIAL PRIMARY KEY\x2C\n        game_id             TEXT\x2C\n        guild_id            TEXT\x2C\n        source              TEXT NOT NULL DEFAULT 'pvp'\x2C\n        context             TEXT\x2C\n        error_message       TEXT NOT NULL\x2C\n        error_stack         TEXT\x2C\n        status              TEXT NOT NULL DEFAULT 'open'\x2C\n        mirror_status       TEXT NOT NULL DEFAULT 'pending'\x2C\n        selfplay_run_id     BIGINT\x2C\n        channel_id          TEXT\x2C\n        message_link        TEXT\x2C\n        discord_thread_id   TEXT\x2C\n        discord_message_id  TEXT\x2C\n        metadata            JSONB DEFAULT '{}'\x2C\n        resolved_by         TEXT\x2C\n        resolved_at         TIMESTAMPTZ\x2C\n        created_at          TIMESTAMPTZ DEFAULT NOW()\n      )\n    `);\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_incidents_status ON incidents (status)').catch(() => {});\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_incidents_game ON incidents (game_id)').catch(() => {});\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_incidents_created ON incidents (created_at DESC)').catch(() => {});\n\n    await pool.query(`\n      CREATE TABLE IF NOT EXISTS coverage_items (\n        item_id           TEXT PRIMARY KEY\x2C\n        category          TEXT NOT NULL\x2C\n        name              TEXT NOT NULL\x2C\n        parent_id         TEXT\x2C\n        wired             BOOLEAN DEFAULT TRUE\x2C\n        headless_count    INT DEFAULT 0\x2C\n        discord_count     INT DEFAULT 0\x2C\n        last_discord_game TEXT\x2C\n        last_discord_at   TIMESTAMPTZ\x2C\n        verified          BOOLEAN DEFAULT FALSE\x2C\n        verified_by       TEXT\x2C\n        verified_at       TIMESTAMPTZ\x2C\n        notes             TEXT\x2C\n        updated_at        TIMESTAMPTZ DEFAULT NOW()\n      )\n    `);\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_cov_category ON coverage_items(category)').catch(() => {});\n    await pool.query('CREATE INDEX IF NOT EXISTS idx_cov_unexercised ON coverage_items(category) WHERE discord_count = 0').catch(() => {});\n\n    await seedAchievements();\n    await seedCoverageRegions();\n    // Check coverage_items: warn if empty (seed via: node scripts/seed-coverage.js --backfill)\n    try {\n      const covCheck = await pool.query('SELECT count(*)::int AS c FROM coverage_items');\n      if (covCheck.rows[0].c === 0) {\n        console.warn('[DB] coverage_items is empty \u2014 run: node scripts/seed-coverage.js --backfill');\n      }\n    } catch {}\n\n    console.log('[DB] PostgreSQL connected\x2C all tables ready.');\n  } catch (err) {\n    console.error('[DB] Failed to connect:'\x2C err.message);\n    pool = null;\n  }\n}\n\n/** Write a row to completed_games when a game ends (DB2). Call in the same path that sets game.ended. */\nexport async function insertCompletedGame(game) {\n  if (!pool || !game?.ended) return;\n  try {\n    const winnerId = game.winnerId ?? null;\n    const player1Id = game.player1Id ?? '';\n    const player2Id = game.player2Id ?? '';\n    const p1Squad = game.player1Squad || {};\n    const p2Squad = game.player2Squad || {};\n    const mapId = game.selectedMap?.id ?? null;\n    const missionId = game.selectedMission ? `${game.selectedMap?.id || ''}:${game.selectedMission.variant || 'a'}` : null;\n    const deploymentZoneWinner = game.deploymentZoneChosen ? getPlayerId(game\x2C getInitiativePlayerNum(game)) : null;\n    const roundCount = game.currentRound ?? null;\n    const gameId = game.gameId ?? null;\n    await pool.query(\n      `INSERT INTO completed_games (game_id\x2C winner_id\x2C player1_id\x2C player2_id\x2C player1_affiliation\x2C player2_affiliation\x2C player1_army_json\x2C player2_army_json\x2C map_id\x2C mission_id\x2C deployment_zone_winner\x2C round_count)\n       VALUES ($1\x2C $2\x2C $3\x2C $4\x2C $5\x2C $6\x2C $7\x2C $8\x2C $9\x2C $10\x2C $11\x2C $12)`\x2C\n      [gameId\x2C winnerId\x2C player1Id\x2C player2Id\x2C p1Squad.affiliation ?? null\x2C p2Squad.affiliation ?? null\x2C JSON.stringify(p1Squad)\x2C JSON.stringify(p2Squad)\x2C mapId\x2C missionId\x2C deploymentZoneWinner\x2C roundCount]\n    );\n  } catch (err) {\n    console.error('[DB] insertCompletedGame failed:'\x2C err.message);\n  }\n}\n\n/** Insert a self-play run artifact (failed/stopped runs only by default). */\nexport async function insertSelfPlayRun(artifact) {\n  if (!pool || !artifact) return;\n  try {\n    await pool.query(\n      `INSERT INTO selfplay_runs (\n        game_id\x2C guild_id\x2C scenario\x2C result\x2C stop_reason\x2C commit_sha\x2C\n        map\x2C p1_squad\x2C p2_squad\x2C phase\x2C round_phase\x2C current_round\x2C active_player\x2C\n        total_steps\x2C last_action\x2C recent_actions\x2C pending_states\x2C\n        recovery_reason\x2C error_message\x2C error_stack\x2C handler_key\x2C\n        intended_surface\x2C actual_channel\x2C discord_op\x2C discord_error\x2C\n        started_at\x2C failed_at\x2C duration_ms\x2C recovery_fired\x2C recovery_count\x2C\n        exploration_mode\x2C exercised_handlers\x2C seen_action_types\x2C triggered_pending_states\x2C\n        checkpoint_games\x2C checkpoint_file\x2C winner\x2C p1_vp\x2C p2_vp\x2C\n        vp_per_round\x2C total_rounds\x2C figure_defeats\x2C action_type_counts\x2C\n        transitions_hit\x2C runtime_stats\x2C\n        game_end_reason\x2C p1_figures_remaining\x2C p2_figures_remaining\n      ) VALUES (\n        $1\x2C$2\x2C$3\x2C$4\x2C$5\x2C$6\x2C$7\x2C$8\x2C$9\x2C$10\x2C$11\x2C$12\x2C$13\x2C$14\x2C$15\x2C$16\x2C$17\x2C$18\x2C$19\x2C$20\x2C$21\x2C$22\x2C$23\x2C$24\x2C$25\x2C$26\x2C$27\x2C$28\x2C$29\x2C$30\x2C$31\x2C$32\x2C$33\x2C$34\x2C$35\x2C$36\x2C$37\x2C$38\x2C$39\x2C$40\x2C$41\x2C$42\x2C$43\x2C$44\x2C$45\x2C$46\x2C$47\x2C$48\n      )`\x2C\n      [\n        artifact.game_id\x2C artifact.guild_id ?? null\x2C artifact.scenario ?? null\x2C\n        artifact.result\x2C artifact.stop_reason\x2C artifact.commit_sha ?? null\x2C\n        artifact.map ?? null\x2C\n        JSON.stringify(artifact.p1_squad ?? null)\x2C JSON.stringify(artifact.p2_squad ?? null)\x2C\n        artifact.phase ?? null\x2C artifact.round_phase ?? null\x2C\n        artifact.current_round ?? null\x2C artifact.active_player ?? null\x2C\n        artifact.total_steps\x2C artifact.last_action ?? null\x2C\n        JSON.stringify(artifact.recent_actions ?? [])\x2C JSON.stringify(artifact.pending_states ?? {})\x2C\n        artifact.recovery_reason ?? null\x2C artifact.error_message ?? null\x2C artifact.error_stack ?? null\x2C\n        artifact.handler_key ?? null\x2C artifact.intended_surface ?? null\x2C artifact.actual_channel ?? null\x2C\n        artifact.discord_op ?? null\x2C artifact.discord_error ?? null\x2C\n        artifact.started_at\x2C artifact.failed_at ?? new Date()\x2C\n        artifact.duration_ms ?? null\x2C artifact.recovery_fired ?? false\x2C artifact.recovery_count ?? 0\x2C\n        artifact.exploration_mode ?? null\x2C\n        JSON.stringify(artifact.exercised_handlers ?? [])\x2C\n        JSON.stringify(artifact.seen_action_types ?? [])\x2C\n        JSON.stringify(artifact.triggered_pending_states ?? [])\x2C\n        // Phase 2: VP/coverage/telemetry (previously dropped)\n        artifact.checkpoint_games ?? null\x2C artifact.checkpoint_file ?? null\x2C\n        artifact.winner ?? null\x2C artifact.p1_vp ?? 0\x2C artifact.p2_vp ?? 0\x2C\n        JSON.stringify(artifact.vp_per_round ?? [])\x2C artifact.total_rounds ?? null\x2C\n        artifact.figure_defeats ?? 0\x2C JSON.stringify(artifact.action_type_counts ?? {})\x2C\n        JSON.stringify(artifact.transitions_hit ?? [])\x2C JSON.stringify(artifact.runtime_stats ?? {})\x2C\n        // End-condition telemetry\n        artifact.game_end_reason ?? null\x2C\n        artifact.p1_figures_remaining ?? null\x2C artifact.p2_figures_remaining ?? null\x2C\n      ]\n    );\n  } catch (err) {\n    console.error('[DB] insertSelfPlayRun failed:'\x2C err.message);\n  }\n}\n\n/** Load all games from the database. Returns { gameId: gameObject\x2C ... }. */\nexport async function loadGamesFromDb() {\n  if (!pool) return {};\n  try {\n    const res = await pool.query('SELECT game_id\x2C game_data FROM games');\n    const out = {};\n    for (const row of res.rows) {\n      const g = row.game_data;\n      if (g && typeof g === 'object') delete g.pendingAttack;\n      out[row.game_id] = g;\n    }\n    return out;\n  } catch (err) {\n    console.error('[DB] Load failed:'\x2C err.message);\n    return {};\n  }\n}\n\n/** Set of game IDs that have been modified since last save. */\nconst dirtyGameIds = new Set();\n\n/** Mark a game as needing to be saved. */\nexport function markGameDirty(gameId) {\n  dirtyGameIds.add(gameId);\n}\n\n/** Save only dirty games to the database. */\nexport let savePromise = Promise.resolve();\n\nexport async function saveGamesToDb(gamesMap) {\n  if (!pool) return;\n  const toSave = [...dirtyGameIds].filter(id => gamesMap.has(id));\n  dirtyGameIds.clear();\n  if (toSave.length === 0) return;\n  savePromise = savePromise.then(async () => {\n    for (const gameId of toSave) {\n      const game = gamesMap.get(gameId);\n      if (!game) continue;\n      try {\n        await pool.query(\n          `INSERT INTO games (game_id\x2C game_data) VALUES ($1\x2C $2)\n           ON CONFLICT (game_id) DO UPDATE SET game_data = $2\x2C updated_at = NOW()`\x2C\n          [gameId\x2C JSON.stringify(game)]\n        );\n      } catch (err) {\n        dirtyGameIds.add(gameId);\n        console.error(`[DB] Save failed for ${gameId}:`\x2C err.message);\n      }\n    }\n  });\n  return savePromise;\n}\n\n/** Remove a game and all related data from the database (when game is killed). */\nexport async function deleteGameFromDb(gameId) {\n  if (!pool) return;\n  try {\n    await pool.query('DELETE FROM domain_events WHERE game_id = $1'\x2C [gameId]);\n    await pool.query('DELETE FROM game_snapshots WHERE game_id = $1'\x2C [gameId]);\n    await pool.query('DELETE FROM games WHERE game_id = $1'\x2C [gameId]);\n  } catch (err) {\n    console.error('[DB] Delete failed:'\x2C err.message);\n  }\n}\n\n// --- Stats (completed_games); for use in #statistics channel commands ---\n\n/** Return { totalGames\x2C draws } from completed_games. */\nexport async function getStatsSummary() {\n  if (!pool) return { totalGames: 0\x2C draws: 0 };\n  try {\n    const count = await pool.query('SELECT COUNT(*)::int AS n FROM completed_games');\n    const draws = await pool.query("SELECT COUNT(*)::int AS n FROM completed_games WHERE winner_id IS NULL");\n    return { totalGames: count.rows[0]?.n ?? 0\x2C draws: draws.rows[0]?.n ?? 0 };\n  } catch (err) {\n    console.error('[DB] getStatsSummary failed:'\x2C err.message);\n    return { totalGames: 0\x2C draws: 0 };\n  }\n}\n\n/** Win rate by affiliation. Returns [{ affiliation\x2C wins\x2C games\x2C winRate }] sorted by games desc. */\nexport async function getAffiliationWinRates() {\n  if (!pool) return [];\n  try {\n    const res = await pool.query(`\n      SELECT\n        aff AS affiliation\x2C\n        SUM(wins)::int AS wins\x2C\n        SUM(games)::int AS games\x2C\n        ROUND(100.0 * SUM(wins) / NULLIF(SUM(games)\x2C 0)\x2C 1) AS win_rate\n      FROM (\n        SELECT player1_affiliation AS aff\x2C (winner_id = player1_id)::int AS wins\x2C 1 AS games FROM completed_games WHERE winner_id IS NOT NULL AND player1_affiliation IS NOT NULL\n        UNION ALL\n        SELECT player2_affiliation AS aff\x2C (winner_id = player2_id)::int AS wins\x2C 1 AS games FROM completed_games WHERE winner_id IS NOT NULL AND player2_affiliation IS NOT NULL\n      ) t\n      GROUP BY aff\n      ORDER BY SUM(games) DESC\n    `);\n    return res.rows.map((r) => ({\n      affiliation: r.affiliation\x2C\n      wins: Number(r.wins)\x2C\n      games: Number(r.games)\x2C\n      winRate: r.win_rate != null ? Number(r.win_rate) : 0\x2C\n    }));\n  } catch (err) {\n    console.error('[DB] getAffiliationWinRates failed:'\x2C err.message);\n    return [];\n  }\n}\n\n/** Win rate by deployment card (from army JSON dcList). Returns top N entries [{ dcName\x2C wins\x2C games\x2C winRate }] by games desc. */\nexport async function getDcWinRates(limit = 20) {\n  if (!pool) return [];\n  try {\n    const res = await pool.query(\n      'SELECT player1_army_json\x2C player2_army_json\x2C winner_id\x2C player1_id\x2C player2_id FROM completed_games WHERE winner_id IS NOT NULL'\n    );\n    const byDc = {};\n    for (const row of res.rows) {\n      const p1Won = row.winner_id === row.player1_id;\n      const p2Won = row.winner_id === row.player2_id;\n      const dcList1 = (row.player1_army_json && row.player1_army_json.dcList) || [];\n      const dcList2 = (row.player2_army_json && row.player2_army_json.dcList) || [];\n      const names1 = dcList1.map((d) => (typeof d === 'string' ? d : d?.displayName || d?.name || '')).filter(Boolean);\n      const names2 = dcList2.map((d) => (typeof d === 'string' ? d : d?.displayName || d?.name || '')).filter(Boolean);\n      for (const name of names1) {\n        if (!byDc[name]) byDc[name] = { wins: 0\x2C games: 0 };\n        byDc[name].games += 1;\n        if (p1Won) byDc[name].wins += 1;\n      }\n      for (const name of names2) {\n        if (!byDc[name]) byDc[name] = { wins: 0\x2C games: 0 };\n        byDc[name].games += 1;\n        if (p2Won) byDc[name].wins += 1;\n      }\n    }\n    return Object.entries(byDc)\n      .map(([dcName\x2C o]) => ({\n        dcName\x2C\n        wins: o.wins\x2C\n        games: o.games\x2C\n        winRate: o.games ? Math.round((100.0 * o.wins) / o.games * 10) / 10 : 0\x2C\n      }))\n      .sort((a\x2C b) => b.games - a.games)\n      .slice(0\x2C limit);\n  } catch (err) {\n    console.error('[DB] getDcWinRates failed:'\x2C err.message);\n    return [];\n  }\n}\n\n/** Stats summary for a single player: { games\x2C wins\x2C losses\x2C draws\x2C winRate }. */\nexport async function getStatsSummaryForPlayer(userId) {\n  if (!pool) return { games: 0\x2C wins: 0\x2C losses: 0\x2C draws: 0\x2C winRate: 0 };\n  try {\n    const res = await pool.query(`\n      SELECT\n        COUNT(*)::int AS games\x2C\n        SUM(CASE WHEN winner_id = $1 THEN 1 ELSE 0 END)::int AS wins\x2C\n        SUM(CASE WHEN winner_id IS NOT NULL AND winner_id <> $1 THEN 1 ELSE 0 END)::int AS losses\x2C\n        SUM(CASE WHEN winner_id IS NULL THEN 1 ELSE 0 END)::int AS draws\n      FROM completed_games\n      WHERE player1_id = $1 OR player2_id = $1\n    `\x2C [userId]);\n    const r = res.rows[0] ?? { games: 0\x2C wins: 0\x2C losses: 0\x2C draws: 0 };\n    const games = Number(r.games ?? 0);\n    const wins = Number(r.wins ?? 0);\n    const decisiveGames = games - Number(r.draws ?? 0);\n    const winRate = decisiveGames > 0 ? Math.round((100.0 * wins) / decisiveGames * 10) / 10 : 0;\n    return { games\x2C wins\x2C losses: Number(r.losses ?? 0)\x2C draws: Number(r.draws ?? 0)\x2C winRate };\n  } catch (err) {\n    console.error('[DB] getStatsSummaryForPlayer failed:'\x2C err.message);\n    return { games: 0\x2C wins: 0\x2C losses: 0\x2C draws: 0\x2C winRate: 0 };\n  }\n}\n\n/** Win rate by affiliation for a single player. Returns [{ affiliation\x2C wins\x2C games\x2C winRate }]. */\nexport async function getAffiliationWinRatesPersonal(userId) {\n  if (!pool) return [];\n  try {\n    const res = await pool.query(`\n      SELECT\n        aff AS affiliation\x2C\n        SUM(wins)::int AS wins\x2C\n        SUM(games)::int AS games\x2C\n        ROUND(100.0 * SUM(wins) / NULLIF(SUM(games)\x2C 0)\x2C 1) AS win_rate\n      FROM (\n        SELECT player1_affiliation AS aff\x2C (winner_id = player1_id)::int AS wins\x2C 1 AS games\n          FROM completed_games WHERE winner_id IS NOT NULL AND player1_affiliation IS NOT NULL AND player1_id = $1\n        UNION ALL\n        SELECT player2_affiliation AS aff\x2C (winner_id = player2_id)::int AS wins\x2C 1 AS games\n          FROM completed_games WHERE winner_id IS NOT NULL AND player2_affiliation IS NOT NULL AND player2_id = $1\n      ) t\n      GROUP BY aff ORDER BY SUM(games) DESC\n    `\x2C [userId]);\n    return res.rows.map((r) => ({\n      affiliation: r.affiliation\x2C\n      wins: Number(r.wins)\x2C\n      games: Number(r.games)\x2C\n      winRate: r.win_rate != null ? Number(r.win_rate) : 0\x2C\n    }));\n  } catch (err) {\n    console.error('[DB] getAffiliationWinRatesPersonal failed:'\x2C err.message);\n    return [];\n  }\n}\n\n/** Pick rate by affiliation (global). Returns [{ affiliation\x2C picks\x2C totalArmies\x2C pickRate }]. */\nexport async function getAffiliationPickRates() {\n  if (!pool) return [];\n  try {\n    const res = await pool.query(`\n      SELECT\n        aff AS affiliation\x2C\n        COUNT(*)::int AS picks\x2C\n        (SELECT COUNT(*) * 2 FROM completed_games WHERE player1_affiliation IS NOT NULL)::int AS total_armies\x2C\n        ROUND(100.0 * COUNT(*) / NULLIF((SELECT COUNT(*) * 2 FROM completed_games WHERE player1_affiliation IS NOT NULL)\x2C 0)\x2C 1) AS pick_rate\n      FROM (\n        SELECT player1_affiliation AS aff FROM completed_games WHERE player1_affiliation IS NOT NULL\n        UNION ALL\n        SELECT player2_affiliation AS aff FROM completed_games WHERE player2_affiliation IS NOT NULL\n      ) t\n      GROUP BY aff ORDER BY COUNT(*) DESC\n    `);\n    return res.rows.map((r) => ({\n      affiliation: r.affiliation\x2C\n      picks: Number(r.picks)\x2C\n      totalArmies: Number(r.total_armies)\x2C\n      pickRate: r.pick_rate != null ? Number(r.pick_rate) : 0\x2C\n    }));\n  } catch (err) {\n    console.error('[DB] getAffiliationPickRates failed:'\x2C err.message);\n    return [];\n  }\n}\n\n/** Pick rate by affiliation for a single player. Returns [{ affiliation\x2C picks\x2C totalArmies\x2C pickRate }]. */\nexport async function getAffiliationPickRatesPersonal(userId) {\n  if (!pool) return [];\n  try {\n    const res = await pool.query(`\n      SELECT\n        aff AS affiliation\x2C\n        COUNT(*)::int AS picks\x2C\n        (\n          SELECT COUNT(*) FROM (\n            SELECT player1_affiliation FROM completed_games WHERE (player1_id = $1 OR player2_id = $1) AND player1_affiliation IS NOT NULL\n            UNION ALL\n            SELECT player2_affiliation FROM completed_games WHERE (player1_id = $1 OR player2_id = $1) AND player2_affiliation IS NOT NULL\n          ) sub\n        )::int AS total_armies\x2C\n        ROUND(100.0 * COUNT(*) / NULLIF(\n          (\n            SELECT COUNT(*) FROM (\n              SELECT player1_affiliation FROM completed_games WHERE (player1_id = $1 OR player2_id = $1) AND player1_affiliation IS NOT NULL\n              UNION ALL\n              SELECT player2_affiliation FROM completed_games WHERE (player1_id = $1 OR player2_id = $1) AND player2_affiliation IS NOT NULL\n            ) sub2\n          )\x2C 0\n        )\x2C 1) AS pick_rate\n      FROM (\n        SELECT player1_affiliation AS aff FROM completed_games WHERE player1_id = $1 AND player1_affiliation IS NOT NULL\n        UNION ALL\n        SELECT player2_affiliation AS aff FROM completed_games WHERE player2_id = $1 AND player2_affiliation IS NOT NULL\n      ) t\n      GROUP BY aff ORDER BY COUNT(*) DESC\n    `\x2C [userId]);\n    return res.rows.map((r) => ({\n      affiliation: r.affiliation\x2C\n      picks: Number(r.picks)\x2C\n      totalArmies: Number(r.total_armies)\x2C\n      pickRate: r.pick_rate != null ? Number(r.pick_rate) : 0\x2C\n    }));\n  } catch (err) {\n    console.error('[DB] getAffiliationPickRatesPersonal failed:'\x2C err.message);\n    return [];\n  }\n}\n\n/** Win rate by DC for a single player. Returns top N [{ dcName\x2C wins\x2C games\x2C winRate }] by games desc. */\nexport async function getDcWinRatesPersonal(userId\x2C limit = 20) {\n  if (!pool) return [];\n  try {\n    const res = await pool.query(\n      `SELECT player1_army_json\x2C player2_army_json\x2C winner_id\x2C player1_id\x2C player2_id\n       FROM completed_games WHERE winner_id IS NOT NULL AND (player1_id = $1 OR player2_id = $1)`\x2C\n      [userId]\n    );\n    const byDc = {};\n    for (const row of res.rows) {\n      const isP1 = row.player1_id === userId;\n      const playerWon = row.winner_id === userId;\n      const myArmy = isP1 ? row.player1_army_json : row.player2_army_json;\n      const dcList = (myArmy && myArmy.dcList) || [];\n      const names = dcList.map((d) => (typeof d === 'string' ? d : d?.displayName || d?.name || '')).filter(Boolean);\n      for (const name of names) {\n        if (!byDc[name]) byDc[name] = { wins: 0\x2C games: 0 };\n        byDc[name].games += 1;\n        if (playerWon) byDc[name].wins += 1;\n      }\n    }\n    return Object.entries(byDc)\n      .map(([dcName\x2C o]) => ({\n        dcName\x2C\n        wins: o.wins\x2C\n        games: o.games\x2C\n        winRate: o.games ? Math.round((100.0 * o.wins) / o.games * 10) / 10 : 0\x2C\n      }))\n      .sort((a\x2C b) => b.games - a.games)\n      .slice(0\x2C limit);\n  } catch (err) {\n    console.error('[DB] getDcWinRatesPersonal failed:'\x2C err.message);\n    return [];\n  }\n}\n\n/** Leaderboard: top players by win count. Returns [{ playerId\x2C wins\x2C losses\x2C draws\x2C games\x2C winRate }]. */\nexport async function getLeaderboard(limit = 10) {\n  if (!pool) return [];\n  try {\n    const res = await pool.query(`\n      SELECT\n        player_id\x2C\n        SUM(won)::int AS wins\x2C\n        SUM(lost)::int AS losses\x2C\n        SUM(draw)::int AS draws\x2C\n        COUNT(*)::int AS games\x2C\n        ROUND(100.0 * SUM(won) / NULLIF(COUNT(*) - SUM(draw)\x2C 0)\x2C 1) AS win_rate\n      FROM (\n        SELECT player1_id AS player_id\x2C\n          (winner_id = player1_id)::int AS won\x2C\n          (winner_id = player2_id)::int AS lost\x2C\n          (winner_id IS NULL)::int AS draw\n        FROM completed_games\n        UNION ALL\n        SELECT player2_id AS player_id\x2C\n          (winner_id = player2_id)::int AS won\x2C\n          (winner_id = player1_id)::int AS lost\x2C\n          (winner_id IS NULL)::int AS draw\n        FROM completed_games\n      ) t\n      GROUP BY player_id\n      HAVING COUNT(*) >= 5\n      ORDER BY win_rate DESC NULLS LAST\x2C wins DESC\n      LIMIT $1\n    `\x2C [limit]);\n    return res.rows.map((r) => ({\n      playerId: r.player_id\x2C\n      wins: Number(r.wins ?? 0)\x2C\n      losses: Number(r.losses ?? 0)\x2C\n      draws: Number(r.draws ?? 0)\x2C\n      games: Number(r.games ?? 0)\x2C\n      winRate: r.win_rate != null ? Number(r.win_rate) : 0\x2C\n    }));\n  } catch (err) {\n    console.error('[DB] getLeaderboard failed:'\x2C err.message);\n    return [];\n  }\n}\n\n// \u2500\u2500 Achievements \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nconst ACHIEVEMENT_SEED = [\n  // Games played milestones\n  { id: 'complete_1_game'\x2C   name: 'New Recruit'\x2C             description: 'Complete your first game'\x2C  icon: '\ud83c\udfc6'\x2C trigger: 'game_complete'\x2C threshold: 1   }\x2C\n  { id: 'complete_5_games'\x2C  name: 'Field Tested'\x2C            description: 'Complete 5 games'\x2C          icon: '\ud83c\udfc6'\x2C trigger: 'game_complete'\x2C threshold: 5   }\x2C\n  { id: 'complete_10_games'\x2C name: 'Battle-Hardened'\x2C         description: 'Complete 10 games'\x2C         icon: '\ud83c\udfc6'\x2C trigger: 'game_complete'\x2C threshold: 10  }\x2C\n  { id: 'complete_25_games'\x2C name: 'Veteran of the Outer Rim'\x2Cdescription: 'Complete 25 games'\x2C         icon: '\ud83c\udfc6'\x2C trigger: 'game_complete'\x2C threshold: 25  }\x2C\n  { id: 'complete_50_games'\x2C name: 'Galactic Campaigner'\x2C     description: 'Complete 50 games'\x2C         icon: '\ud83c\udfc6'\x2C trigger: 'game_complete'\x2C threshold: 50  }\x2C\n  { id: 'complete_100_games'\x2Cname: 'Legend of the Empire'\x2C     description: 'Complete 100 games'\x2C        icon: '\ud83c\udfc6'\x2C trigger: 'game_complete'\x2C threshold: 100 }\x2C\n  // Win milestones\n  { id: 'win_1_game'\x2C        name: 'A New Hope'\x2C              description: 'Win your first game'\x2C       icon: '\ud83e\udd47'\x2C trigger: 'game_win'\x2C      threshold: 1   }\x2C\n  { id: 'win_5_games'\x2C       name: 'Rising Force'\x2C            description: 'Win 5 games'\x2C               icon: '\ud83e\udd47'\x2C trigger: 'game_win'\x2C      threshold: 5   }\x2C\n  { id: 'win_10_games'\x2C      name: 'Rebel Commander'\x2C         description: 'Win 10 games'\x2C              icon: '\ud83e\udd47'\x2C trigger: 'game_win'\x2C      threshold: 10  }\x2C\n  { id: 'win_25_games'\x2C      name: 'Grand Admiral'\x2C           description: 'Win 25 games'\x2C              icon: '\ud83e\udd47'\x2C trigger: 'game_win'\x2C      threshold: 25  }\x2C\n  { id: 'win_50_games'\x2C      name: 'The Chosen One'\x2C          description: 'Win 50 games'\x2C              icon: '\ud83e\udd47'\x2C trigger: 'game_win'\x2C      threshold: 50  }\x2C\n  // In-game highlights\n  { id: 'devastator'\x2C        name: 'Devastator'\x2C              description: 'Deal 10+ damage in a single attack'\x2C            icon: '\ud83d\udca5'\x2C trigger: 'single_attack_damage'\x2C threshold: 10 }\x2C\n  { id: 'double_kill'\x2C       name: 'Double Kill'\x2C             description: 'Defeat 2 figures in a single activation'\x2C       icon: '\u2694\ufe0f'\x2C trigger: 'activation_kills'\x2C     threshold: 2  }\x2C\n  { id: 'triple_kill'\x2C       name: 'Triple Kill'\x2C             description: 'Defeat 3 figures in a single activation'\x2C       icon: '\u2694\ufe0f'\x2C trigger: 'activation_kills'\x2C     threshold: 3  }\x2C\n  { id: 'pentakill'\x2C         name: 'PENTAKILL'\x2C               description: 'Defeat 5 figures in a single activation'\x2C       icon: '\ud83d\udc80'\x2C trigger: 'activation_kills'\x2C     threshold: 5  }\x2C\n  // Game-end conditions\n  { id: 'shutout'\x2C           name: 'Shutout'\x2C                 description: 'Win a game where your opponent scored 0 VP'\x2C    icon: '\ud83d\udd12'\x2C trigger: 'shutout_win'\x2C          threshold: 1  }\x2C\n  { id: 'survivor'\x2C          name: 'Survivor'\x2C                description: 'Win a game without losing any figures'\x2C         icon: '\ud83d\udee1\ufe0f'\x2C trigger: 'no_losses_win'\x2C        threshold: 1  }\x2C\n  { id: 'brutalist'\x2C         name: 'Brutalist'\x2C               description: 'Win by eliminating all opponent figures'\x2C       icon: '\u2620\ufe0f'\x2C trigger: 'full_wipe_win'\x2C        threshold: 1  }\x2C\n];\n\nasync function seedAchievements() {\n  if (!pool) return;\n  for (const def of ACHIEVEMENT_SEED) {\n    await pool.query(\n      `INSERT INTO achievement_defs (id\x2C name\x2C description\x2C icon\x2C trigger\x2C threshold)\n       VALUES ($1\x2C $2\x2C $3\x2C $4\x2C $5\x2C $6)\n       ON CONFLICT (id) DO UPDATE SET name = $2\x2C description = $3\x2C icon = $4\x2C trigger = $5\x2C threshold = $6`\x2C\n      [def.id\x2C def.name\x2C def.description\x2C def.icon\x2C def.trigger\x2C def.threshold]\n    ).catch((err) => console.error('[DB] seedAchievements:'\x2C err.message));\n  }\n}\n\n/** Returns earned achievements for a user: [{id\x2C name\x2C description\x2C icon\x2C earned_at}] */\nexport async function getEarnedAchievements(userId) {\n  if (!pool) return [];\n  try {\n    const res = await pool.query(\n      `SELECT d.id\x2C d.name\x2C d.description\x2C d.icon\x2C ua.earned_at\n       FROM user_achievements ua\n       JOIN achievement_defs d ON d.id = ua.achievement_id\n       WHERE ua.user_id = $1\n       ORDER BY ua.earned_at ASC`\x2C\n      [userId]\n    );\n    return res.rows;\n  } catch (err) {\n    console.error('[DB] getEarnedAchievements failed:'\x2C err.message);\n    return [];\n  }\n}\n\n/**\n * Check which achievements for `trigger` are newly earned given `statCount`\x2C\n * insert them\x2C and return the newly granted defs.\n * @param {string} userId\n * @param {'game_complete'|'game_win'|'single_attack_damage'|'activation_kills'|'shutout_win'|'no_losses_win'|'full_wipe_win'} trigger\n * @param {number} statCount\n * @returns {Promise<Array<{id\x2C name\x2C description\x2C icon}>>}\n */\nexport async function checkAndGrantAchievements(userId\x2C trigger\x2C statCount) {\n  if (!pool) return [];\n  try {\n    const res = await pool.query(\n      `INSERT INTO user_achievements (user_id\x2C achievement_id)\n       SELECT $1\x2C d.id\n       FROM achievement_defs d\n       WHERE d.trigger = $2 AND d.threshold <= $3\n       ON CONFLICT (user_id\x2C achievement_id) DO NOTHING\n       RETURNING achievement_id`\x2C\n      [userId\x2C trigger\x2C statCount]\n    );\n    if (res.rows.length === 0) return [];\n    const grantedIds = res.rows.map((r) => r.achievement_id);\n    const defs = await pool.query(\n      `SELECT id\x2C name\x2C description\x2C icon FROM achievement_defs WHERE id = ANY($1)`\x2C\n      [grantedIds]\n    );\n    return defs.rows;\n  } catch (err) {\n    console.error('[DB] checkAndGrantAchievements failed:'\x2C err.message);\n    return [];\n  }\n}\n\n// \u2500\u2500 Event Log \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n// \u2500\u2500 Domain Events (Phase 4) \u2500\u2500\n\nexport async function insertDomainEvent(gameId\x2C event\x2C { bumpEventSeq } = {}) {\n  if (!pool) return;\n  const MAX_RETRIES = 3;\n  for (let attempt = 1; attempt <= MAX_RETRIES; attempt++) {\n    try {\n      await pool.query(\n        `INSERT INTO domain_events (game_id\x2C seq\x2C type\x2C correlation_id\x2C player_id\x2C aggregate_version\x2C timestamp\x2C payload)\n         VALUES ($1\x2C $2\x2C $3\x2C $4\x2C $5\x2C $6\x2C $7\x2C $8)`\x2C\n        [gameId\x2C event.seq\x2C event.type\x2C event.correlationId || null\x2C event.playerId || null\x2C event.aggregateVersion\x2C event.timestamp\x2C JSON.stringify(event.payload)]\n      );\n      return; // success\n    } catch (err) {\n      // 23505 = unique_violation (duplicate seq for this game)\n      if (err.code === '23505' && bumpEventSeq && attempt < MAX_RETRIES) {\n        console.warn(`[DB] insertDomainEvent duplicate seq ${event.seq} for ${gameId}\x2C bumping (attempt ${attempt}/${MAX_RETRIES})`);\n        bumpEventSeq(event);\n        continue;\n      }\n      console.error('[DB] insertDomainEvent failed:'\x2C err.message);\n      return;\n    }\n  }\n}\n\nexport async function getDomainEvents(gameId\x2C afterSeq = 0\x2C limit = 1000) {\n  if (!pool) return [];\n  try {\n    const res = await pool.query(\n      `SELECT * FROM domain_events WHERE game_id = $1 AND seq > $2 ORDER BY seq ASC LIMIT $3`\x2C\n      [gameId\x2C afterSeq\x2C limit]\n    );\n    return res.rows;\n  } catch (err) {\n    console.error('[DB] getDomainEvents failed:'\x2C err.message);\n    return [];\n  }\n}\n\nexport async function getLatestDomainSeq(gameId) {\n  if (!pool) return 0;\n  try {\n    const res = await pool.query(\n      `SELECT MAX(seq) AS max_seq FROM domain_events WHERE game_id = $1`\x2C\n      [gameId]\n    );\n    return res.rows[0]?.max_seq ?? 0;\n  } catch (err) {\n    console.error('[DB] getLatestDomainSeq failed:'\x2C err.message);\n    return 0;\n  }\n}\n\n// \u2500\u2500 Game Snapshots (Phase 4) \u2500\u2500\n\nexport async function insertSnapshot(gameId\x2C version\x2C state) {\n  if (!pool) return;\n  try {\n    await pool.query(\n      `INSERT INTO game_snapshots (game_id\x2C version\x2C state) VALUES ($1\x2C $2\x2C $3)`\x2C\n      [gameId\x2C version\x2C JSON.stringify(state)]\n    );\n  } catch (err) {\n    console.error('[DB] insertSnapshot failed:'\x2C err.message);\n  }\n}\n\nexport async function getLatestSnapshot(gameId) {\n  if (!pool) return null;\n  try {\n    const res = await pool.query(\n      `SELECT version\x2C state FROM game_snapshots WHERE game_id = $1 ORDER BY version DESC LIMIT 1`\x2C\n      [gameId]\n    );\n    if (res.rows.length === 0) return null;\n    return { version: res.rows[0].version\x2C state: res.rows[0].state };\n  } catch (err) {\n    console.error('[DB] getLatestSnapshot failed:'\x2C err.message);\n    return null;\n  }\n}\n\nexport async function getActiveGameIdsFromEvents() {\n  if (!pool) return [];\n  try {\n    const res = await pool.query(\n      `SELECT DISTINCT game_id FROM domain_events ORDER BY game_id`\n    );\n    return res.rows.map(r => r.game_id);\n  } catch (err) {\n    console.error('[DB] getActiveGameIdsFromEvents failed:'\x2C err.message);\n    return [];\n  }\n}\n\nexport async function deleteSnapshots(gameId) {\n  if (!pool) return;\n  try {\n    await pool.query(`DELETE FROM game_snapshots WHERE game_id = $1`\x2C [gameId]);\n  } catch (err) {\n    console.error('[DB] deleteSnapshots failed:'\x2C err.message);\n  }\n}\n\n// --- Coverage Persistence ---\n\n/**\n * Sync coverage_regions from the JSON ledger file on every startup.\n * Merges ledger data into DB while preserving DB-only fields (liveStatus\x2C lastLiveCheck).\n * New regions are inserted; existing regions get their code-managed fields updated.\n * Regions removed from the ledger are left in the DB (no deletes).\n */\nasync function seedCoverageRegions() {\n  if (!pool) return;\n  try {\n    const ledgerPath = join(__dbDirname\x2C '..'\x2C 'tests'\x2C 'headless'\x2C 'coverage-ledger.json');\n    let ledger;\n    try { ledger = JSON.parse(readFileSync(ledgerPath\x2C 'utf8')); } catch { return; }\n    const regions = ledger.regions || {};\n\n    // Load existing DB rows to preserve live statuses\n    const existing = {};\n    const res = await pool.query('SELECT region_id\x2C region_data FROM coverage_regions');\n    for (const row of res.rows) existing[row.region_id] = row.region_data;\n\n    let inserted = 0\x2C updated = 0;\n    for (const [id\x2C ledgerData] of Object.entries(regions)) {\n      const dbData = existing[id];\n      if (dbData) {\n        // Preserve DB-only fields\x2C overwrite everything else from ledger\n        const merged = { ...ledgerData };\n        if (dbData.liveStatus && dbData.liveStatus !== 'untested') merged.liveStatus = dbData.liveStatus;\n        if (dbData.lastLiveCheck) merged.lastLiveCheck = dbData.lastLiveCheck;\n        await pool.query(\n          `UPDATE coverage_regions SET region_data = $2\x2C updated_at = NOW() WHERE region_id = $1`\x2C\n          [id\x2C JSON.stringify(merged)]\n        );\n        updated++;\n      } else {\n        await pool.query(\n          `INSERT INTO coverage_regions (region_id\x2C region_data) VALUES ($1\x2C $2)`\x2C\n          [id\x2C JSON.stringify(ledgerData)]\n        );\n        inserted++;\n      }\n    }\n    console.log(`[DB] Coverage sync: ${inserted} new\x2C ${updated} updated from ledger.`);\n  } catch (err) {\n    console.error('[DB] seedCoverageRegions failed:'\x2C err.message);\n  }\n}\n\n/** Get all coverage regions as { regionId: regionData }. */\nexport async function getCoverageRegions() {\n  if (!pool) return null;\n  try {\n    const res = await pool.query('SELECT region_id\x2C region_data FROM coverage_regions ORDER BY region_id');\n    const out = {};\n    for (const row of res.rows) {\n      out[row.region_id] = row.region_data;\n    }\n    return out;\n  } catch (err) {\n    console.error('[DB] getCoverageRegions failed:'\x2C err.message);\n    return null;\n  }\n}\n\n/** Update a region's live Discord testing status in coverage_regions. */\nexport async function upsertCoverageLiveStatus(regionId\x2C status\x2C lastCheck) {\n  if (!pool) return;\n  try {\n    await pool.query(\n      `UPDATE coverage_regions\n       SET region_data = jsonb_set(jsonb_set(region_data\x2C '{liveStatus}'\x2C $2::jsonb)\x2C '{lastLiveCheck}'\x2C $3::jsonb)\x2C\n           updated_at = NOW()\n       WHERE region_id = $1`\x2C\n      [regionId\x2C JSON.stringify(status)\x2C JSON.stringify(lastCheck || new Date().toISOString().slice(0\x2C 10))]\n    );\n  } catch (err) {\n    console.error('[DB] upsertCoverageLiveStatus failed:'\x2C err.message);\n  }\n}\n\n/** Update a region's verification level and evidence in coverage_regions. */\nexport async function updateCoverageVerification(regionId\x2C verification\x2C evidence) {\n  if (!pool) return;\n  try {\n    await pool.query(\n      `UPDATE coverage_regions\n       SET region_data = jsonb_set(jsonb_set(region_data\x2C '{verification}'\x2C $2::jsonb)\x2C '{evidence}'\x2C $3::jsonb)\x2C\n           updated_at = NOW()\n       WHERE region_id = $1`\x2C\n      [regionId\x2C JSON.stringify(verification)\x2C JSON.stringify(evidence || [])]\n    );\n  } catch (err) {\n    console.error('[DB] updateCoverageVerification failed:'\x2C err.message);\n  }\n}\n\n/** Get all live statuses (convenience wrapper for backward compat). */\nexport async function getCoverageLiveStatuses() {\n  const regions = await getCoverageRegions();\n  if (!regions) return {};\n  const out = {};\n  for (const [id\x2C data] of Object.entries(regions)) {\n    if (data.liveStatus && data.liveStatus !== 'untested') {\n      out[id] = { status: data.liveStatus\x2C lastCheck: data.lastLiveCheck };\n    }\n  }\n  return out;\n}\n\n/** Insert a coverage incident. Returns the created row id. */\nexport async function insertCoverageIncident(incident) {\n  if (!pool) return null;\n  try {\n    const res = await pool.query(\n      `INSERT INTO coverage_incidents (region_id\x2C region_name\x2C severity\x2C note\x2C game_id\x2C phase\x2C last_action\x2C undo_fixed\x2C refresh_fixed\x2C siblings)\n       VALUES ($1\x2C $2\x2C $3\x2C $4\x2C $5\x2C $6\x2C $7\x2C $8\x2C $9\x2C $10)\n       RETURNING id\x2C created_at`\x2C\n      [\n        incident.regionId || incident.region\x2C\n        incident.regionName || ''\x2C\n        incident.severity\x2C\n        incident.note\x2C\n        incident.gameId || null\x2C\n        incident.phase || null\x2C\n        incident.lastAction || null\x2C\n        !!incident.undoFixed || !!incident.undoFixedIt\x2C\n        !!incident.refreshFixed || !!incident.refreshFixedIt\x2C\n        JSON.stringify(incident.siblings || [])\x2C\n      ]\n    );\n    return res.rows[0];\n  } catch (err) {\n    console.error('[DB] insertCoverageIncident failed:'\x2C err.message);\n    return null;\n  }\n}\n\n/**\n * Query coverage incidents. Options:\n *   severity: 'blocker' | 'major' | 'minor'\n *   regionId: filter by region\n *   since: ISO date string \u2014 only incidents after this date\n *   limit: max rows (default 100)\n */\nexport async function getCoverageIncidents(opts = {}) {\n  if (!pool) return [];\n  try {\n    const conditions = [];\n    const params = [];\n    let idx = 1;\n    if (opts.severity) { conditions.push(`severity = $${idx++}`); params.push(opts.severity); }\n    if (opts.regionId) { conditions.push(`region_id = $${idx++}`); params.push(opts.regionId); }\n    if (opts.since) { conditions.push(`created_at >= $${idx++}`); params.push(opts.since); }\n    const where = conditions.length > 0 ? 'WHERE ' + conditions.join(' AND ') : '';\n    const limit = opts.limit || 100;\n    const res = await pool.query(\n      `SELECT id\x2C region_id\x2C region_name\x2C severity\x2C note\x2C game_id\x2C phase\x2C last_action\x2C undo_fixed\x2C refresh_fixed\x2C siblings\x2C created_at\n       FROM coverage_incidents ${where}\n       ORDER BY created_at DESC\n       LIMIT ${limit}`\x2C\n      params\n    );\n    return res.rows.map(r => ({\n      id: r.id\x2C\n      regionId: r.region_id\x2C\n      regionName: r.region_name\x2C\n      severity: r.severity\x2C\n      note: r.note\x2C\n      gameId: r.game_id\x2C\n      phase: r.phase\x2C\n      lastAction: r.last_action\x2C\n      undoFixed: r.undo_fixed\x2C\n      refreshFixed: r.refresh_fixed\x2C\n      siblings: r.siblings || []\x2C\n      createdAt: r.created_at\x2C\n    }));\n  } catch (err) {\n    console.error('[DB] getCoverageIncidents failed:'\x2C err.message);\n    return [];\n  }\n}\n\n// \u2500\u2500 Favorite Decks (personal saved-deck library) \u2500\u2500\n\nexport function isFavoritesAvailable() {\n  return !!pool;\n}\n\nexport async function getFavoriteDecks(userId) {\n  if (!pool) return null;\n  try {\n    const res = await pool.query(\n      `SELECT id\x2C saved_name\x2C deck_hash\x2C deck_data\x2C affiliation\x2C point_total\x2C\n              last_used_at\x2C use_count\x2C created_at\n       FROM favorite_decks\n       WHERE user_id = $1\n       ORDER BY last_used_at DESC NULLS LAST\x2C created_at DESC`\x2C\n      [userId]\n    );\n    return res.rows;\n  } catch (err) {\n    console.error('[DB] getFavoriteDecks failed:'\x2C err.message);\n    return null;\n  }\n}\n\nexport async function getFavoriteDeckByHash(userId\x2C deckHash) {\n  if (!pool) return null;\n  try {\n    const res = await pool.query(\n      `SELECT id\x2C saved_name\x2C deck_hash\x2C deck_data\x2C affiliation\x2C point_total\n       FROM favorite_decks\n       WHERE user_id = $1 AND deck_hash = $2`\x2C\n      [userId\x2C deckHash]\n    );\n    return res.rows[0] || null;\n  } catch (err) {\n    console.error('[DB] getFavoriteDeckByHash failed:'\x2C err.message);\n    return null;\n  }\n}\n\nexport async function getFavoriteDeckById(userId\x2C favoriteId) {\n  if (!pool) return null;\n  try {\n    const res = await pool.query(\n      `SELECT id\x2C saved_name\x2C deck_hash\x2C deck_data\x2C raw_list_text\x2C\n              affiliation\x2C point_total\x2C last_used_at\x2C use_count\x2C created_at\n       FROM favorite_decks\n       WHERE user_id = $1 AND id = $2`\x2C\n      [userId\x2C favoriteId]\n    );\n    return res.rows[0] || null;\n  } catch (err) {\n    console.error('[DB] getFavoriteDeckById failed:'\x2C err.message);\n    return null;\n  }\n}\n\nexport async function insertFavoriteDeck(userId\x2C deckHash\x2C savedName\x2C deckData\x2C\n                                          rawListText\x2C affiliation\x2C pointTotal) {\n  if (!pool) return null;\n  try {\n    const res = await pool.query(\n      `INSERT INTO favorite_decks\n         (user_id\x2C deck_hash\x2C saved_name\x2C deck_data\x2C raw_list_text\x2C affiliation\x2C point_total)\n       VALUES ($1\x2C $2\x2C $3\x2C $4\x2C $5\x2C $6\x2C $7)\n       ON CONFLICT (user_id\x2C deck_hash) DO NOTHING\n       RETURNING id\x2C saved_name`\x2C\n      [userId\x2C deckHash\x2C savedName\x2C JSON.stringify(deckData)\x2C rawListText || null\x2C\n       affiliation || null\x2C pointTotal ?? null]\n    );\n    return res.rows[0] || null;\n  } catch (err) {\n    console.error('[DB] insertFavoriteDeck failed:'\x2C err.message);\n    return null;\n  }\n}\n\nexport async function deleteFavoriteDeck(userId\x2C favoriteId) {\n  if (!pool) return false;\n  try {\n    const res = await pool.query(\n      `DELETE FROM favorite_decks WHERE user_id = $1 AND id = $2`\x2C\n      [userId\x2C favoriteId]\n    );\n    return res.rowCount > 0;\n  } catch (err) {\n    console.error('[DB] deleteFavoriteDeck failed:'\x2C err.message);\n    return false;\n  }\n}\n\nexport async function renameFavoriteDeck(userId\x2C favoriteId\x2C newName) {\n  if (!pool) return false;\n  try {\n    const res = await pool.query(\n      `UPDATE favorite_decks SET saved_name = $3\x2C updated_at = NOW()\n       WHERE user_id = $1 AND id = $2`\x2C\n      [userId\x2C favoriteId\x2C newName]\n    );\n    return res.rowCount > 0;\n  } catch (err) {\n    console.error('[DB] renameFavoriteDeck failed:'\x2C err.message);\n    return false;\n  }\n}\n\nexport async function touchFavoriteDeckUsage(userId\x2C favoriteId) {\n  if (!pool) return;\n  try {\n    await pool.query(\n      `UPDATE favorite_decks SET last_used_at = NOW()\x2C use_count = use_count + 1\n       WHERE user_id = $1 AND id = $2`\x2C\n      [userId\x2C favoriteId]\n    );\n  } catch (err) {\n    console.error('[DB] touchFavoriteDeckUsage failed:'\x2C err.message);\n  }\n}\n\n// \u2500\u2500 Exploration (headless explorer coverage persistence) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/** Upsert a single exploration transition row. */\nexport async function upsertExplorationTransition(row) {\n  if (!pool) return;\n  try {\n    await pool.query(\n      `INSERT INTO exploration_transitions\n         (transition_key\x2C round_phase\x2C pending_set\x2C action_type\x2C status\x2C\n          headless_count\x2C invariant_fails\x2C context_tags\x2C scenarios_reaching)\n       VALUES ($1\x2C $2\x2C $3\x2C $4\x2C $5\x2C $6\x2C $7\x2C $8\x2C $9)\n       ON CONFLICT (transition_key) DO UPDATE SET\n         headless_count = exploration_transitions.headless_count + $6\x2C\n         invariant_fails = exploration_transitions.invariant_fails + $7\x2C\n         context_tags = CASE\n           WHEN exploration_transitions.context_tags = '{}'::jsonb THEN $8\n           ELSE exploration_transitions.context_tags || $8\n         END\x2C\n         scenarios_reaching = COALESCE(\n           (SELECT jsonb_agg(DISTINCT val)\n            FROM jsonb_array_elements(\n              COALESCE(exploration_transitions.scenarios_reaching\x2C '[]'::jsonb) || $9\n            ) AS val)\x2C\n           '[]'::jsonb\n         )\x2C\n         updated_at = NOW()`\x2C\n      [\n        row.transition_key\x2C\n        row.round_phase || null\x2C\n        row.pending_set || null\x2C\n        row.action_type || null\x2C\n        row.status || 'headless_seen'\x2C\n        row.headless_count || 0\x2C\n        row.invariant_fails || 0\x2C\n        JSON.stringify(row.context_tags || {})\x2C\n        JSON.stringify(row.scenarios_reaching || [])\x2C\n      ]\n    );\n  } catch (err) {\n    console.error('[DB] upsertExplorationTransition failed:'\x2C err.message);\n  }\n}\n\n/** Insert an exploration episode record. */\nexport async function insertExplorationEpisode(episode) {\n  if (!pool) return;\n  try {\n    await pool.query(\n      `INSERT INTO exploration_episodes\n         (episode_id\x2C source\x2C seed_config\x2C total_steps\x2C unique_transitions\x2C\n          novel_transitions\x2C invariant_errors\x2C transitions_hit\x2C result\x2C stop_reason\x2C duration_ms)\n       VALUES ($1\x2C $2\x2C $3\x2C $4\x2C $5\x2C $6\x2C $7\x2C $8\x2C $9\x2C $10\x2C $11)`\x2C\n      [\n        episode.episode_id\x2C\n        episode.source || 'headless'\x2C\n        JSON.stringify(episode.seed_config)\x2C\n        episode.total_steps\x2C\n        episode.unique_transitions || 0\x2C\n        episode.novel_transitions || 0\x2C\n        episode.invariant_errors || 0\x2C\n        JSON.stringify(episode.transitions_hit || [])\x2C\n        episode.result || null\x2C\n        episode.stop_reason || null\x2C\n        episode.duration_ms || null\x2C\n      ]\n    );\n  } catch (err) {\n    console.error('[DB] insertExplorationEpisode failed:'\x2C err.message);\n  }\n}\n\n/** Load all exploration transitions into memory. Returns Map<key\x2C row>. */\nexport async function loadExplorationTransitions() {\n  if (!pool) return new Map();\n  try {\n    const res = await pool.query('SELECT * FROM exploration_transitions');\n    const map = new Map();\n    for (const row of res.rows) {\n      map.set(row.transition_key\x2C row);\n    }\n    return map;\n  } catch (err) {\n    console.error('[DB] loadExplorationTransitions failed:'\x2C err.message);\n    return new Map();\n  }\n}\n\n/**\n * Upsert a discord-validated transition. Increments discord_count.\n * Called after a Discord self-play run to record which transitions were proven.\n */\nexport async function upsertDiscordTransition(transitionKey\x2C roundPhase\x2C pendingSet\x2C actionType) {\n  if (!pool) return;\n  try {\n    await pool.query(\n      `INSERT INTO exploration_transitions\n         (transition_key\x2C round_phase\x2C pending_set\x2C action_type\x2C status\x2C discord_count)\n       VALUES ($1\x2C $2\x2C $3\x2C $4\x2C 'discord_seen'\x2C 1)\n       ON CONFLICT (transition_key) DO UPDATE SET\n         discord_count = exploration_transitions.discord_count + 1\x2C\n         status = CASE\n           WHEN exploration_transitions.status = 'headless_seen' THEN 'discord_proven'\n           ELSE exploration_transitions.status\n         END\x2C\n         updated_at = NOW()`\x2C\n      [transitionKey\x2C roundPhase || null\x2C pendingSet || null\x2C actionType || null]\n    );\n  } catch (err) {\n    console.error('[DB] upsertDiscordTransition failed:'\x2C err.message);\n  }\n}\n\n// \u2500\u2500 Incidents (Postgres-first error tracking) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Insert an incident record. Returns the incident id (or null if DB unavailable).\n * @param {{ game_id?\x2C guild_id?\x2C source?\x2C context?\x2C error_message\x2C error_stack?\x2C selfplay_run_id?\x2C channel_id?\x2C message_link?\x2C metadata? }} inc\n * @returns {Promise<string|null>}\n */\nexport async function insertIncident(inc) {\n  if (!pool || !inc) return null;\n  try {\n    const res = await pool.query(\n      `INSERT INTO incidents (\n        game_id\x2C guild_id\x2C source\x2C context\x2C error_message\x2C error_stack\x2C\n        selfplay_run_id\x2C channel_id\x2C message_link\x2C metadata\n      ) VALUES ($1\x2C$2\x2C$3\x2C$4\x2C$5\x2C$6\x2C$7\x2C$8\x2C$9\x2C$10)\n      RETURNING id`\x2C\n      [\n        inc.game_id ?? null\x2C inc.guild_id ?? null\x2C inc.source ?? 'pvp'\x2C\n        inc.context ?? null\x2C inc.error_message\x2C\n        inc.error_stack ? inc.error_stack.slice(0\x2C 4000) : null\x2C\n        inc.selfplay_run_id ?? null\x2C inc.channel_id ?? null\x2C\n        inc.message_link ?? null\x2C JSON.stringify(inc.metadata ?? {})\x2C\n      ]\n    );\n    return res.rows[0]?.id?.toString() ?? null;\n  } catch (err) {\n    console.error('[DB] insertIncident failed:'\x2C err.message);\n    return null;\n  }\n}\n\n/**\n * Update an incident with the Discord mirror IDs (thread + message).\n * Sets mirror_status to 'posted'. Called after the bot-logs message is sent.\n */\nexport async function updateIncidentMirrorPosted(incidentId\x2C threadId\x2C messageId) {\n  if (!pool || !incidentId) return;\n  try {\n    await pool.query(\n      `UPDATE incidents SET discord_thread_id = $2\x2C discord_message_id = $3\x2C mirror_status = 'posted' WHERE id = $1`\x2C\n      [incidentId\x2C threadId ?? null\x2C messageId ?? null]\n    );\n  } catch (err) {\n    console.error('[DB] updateIncidentMirrorPosted failed:'\x2C err.message);\n  }\n}\n\n/**\n * Mark an incident's mirror as failed. Called when Discord posting throws.\n */\nexport async function setIncidentMirrorFailed(incidentId) {\n  if (!pool || !incidentId) return;\n  try {\n    await pool.query(\n      `UPDATE incidents SET mirror_status = 'failed' WHERE id = $1`\x2C\n      [incidentId]\n    );\n  } catch (err) {\n    console.error('[DB] setIncidentMirrorFailed failed:'\x2C err.message);\n  }\n}\n\n/**\n * Resolve an incident by id. Sets status\x2C resolved_by\x2C resolved_at.\n * @returns {Promise<boolean>} true if a row was updated\n */\nexport async function resolveIncident(incidentId\x2C resolvedByUserId) {\n  if (!pool || !incidentId) return false;\n  try {\n    const res = await pool.query(\n      `UPDATE incidents SET status = 'resolved'\x2C resolved_by = $2\x2C resolved_at = NOW() WHERE id = $1 AND status = 'open'`\x2C\n      [incidentId\x2C resolvedByUserId ?? null]\n    );\n    return (res.rowCount ?? 0) > 0;\n  } catch (err) {\n    console.error('[DB] resolveIncident failed:'\x2C err.message);\n    return false;\n  }\n}\n\n/**\n * Get all incidents for a game that have mirrored Discord resources.\n * Used by killgame cleanup to delete bot-logs threads/messages.\n * @returns {Promise<Array<{ id: string\x2C discord_thread_id: string|null\x2C discord_message_id: string|null }>>}\n */\nexport async function getIncidentMirrorsForGame(gameId) {\n  if (!pool || !gameId) return [];\n  try {\n    const res = await pool.query(\n      `SELECT id\x2C discord_thread_id\x2C discord_message_id FROM incidents\n       WHERE game_id = $1 AND mirror_status = 'posted'\n         AND (discord_thread_id IS NOT NULL OR discord_message_id IS NOT NULL)`\x2C\n      [gameId]\n    );\n    return res.rows;\n  } catch (err) {\n    console.error('[DB] getIncidentMirrorsForGame failed:'\x2C err.message);\n    return [];\n  }\n}\n\n/**\n * Mark incident mirrors as cleaned up (set mirror_status = 'cleaned_up').\n * Called after killgame deletes the Discord resources.\n */\nexport async function markIncidentMirrorsCleaned(incidentIds) {\n  if (!pool || !incidentIds?.length) return;\n  try {\n    await pool.query(\n      `UPDATE incidents SET mirror_status = 'cleaned_up'\x2C discord_thread_id = NULL\x2C discord_message_id = NULL\n       WHERE id = ANY($1::bigint[])`\x2C\n      [incidentIds]\n    );\n  } catch (err) {\n    console.error('[DB] markIncidentMirrorsCleaned failed:'\x2C err.message);\n  }\n}\n\n// \u2500\u2500 Coverage Items CRUD \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/** Upsert a single coverage item. On conflict\x2C update name/wired/parent_id. */\nexport async function upsertCoverageItem(itemId\x2C category\x2C name\x2C opts = {}) {\n  if (!pool) return;\n  try {\n    await pool.query(\n      `INSERT INTO coverage_items (item_id\x2C category\x2C name\x2C parent_id\x2C wired\x2C updated_at)\n       VALUES ($1\x2C $2\x2C $3\x2C $4\x2C $5\x2C NOW())\n       ON CONFLICT (item_id) DO UPDATE SET\n         name = EXCLUDED.name\x2C\n         wired = EXCLUDED.wired\x2C\n         parent_id = COALESCE(EXCLUDED.parent_id\x2C coverage_items.parent_id)\x2C\n         updated_at = NOW()`\x2C\n      [itemId\x2C category\x2C name\x2C opts.parent_id ?? null\x2C opts.wired !== false]\n    );\n  } catch (err) {\n    console.error('[DB] upsertCoverageItem failed:'\x2C err.message);\n  }\n}\n\n/**\n * Batch-increment discord_count for multiple coverage items.\n * @param {Map<string\x2Cnumber>} hits - Map of itemId \u2192 increment count\n * @param {string} gameId - The game that produced these hits\n */\nexport async function batchIncrementCoverageDiscord(hits\x2C gameId) {\n  if (!pool || !hits || hits.size === 0) return;\n  try {\n    const ids = [];\n    const counts = [];\n    for (const [id\x2C count] of hits) {\n      ids.push(id);\n      counts.push(count);\n    }\n    await pool.query(\n      `UPDATE coverage_items AS c SET\n         discord_count = c.discord_count + v.inc\x2C\n         last_discord_game = $3\x2C\n         last_discord_at = NOW()\x2C\n         updated_at = NOW()\n       FROM (SELECT unnest($1::text[]) AS item_id\x2C unnest($2::int[]) AS inc) v\n       WHERE c.item_id = v.item_id`\x2C\n      [ids\x2C counts\x2C gameId]\n    );\n  } catch (err) {\n    console.error('[DB] batchIncrementCoverageDiscord failed:'\x2C err.message);\n  }\n}\n\n/**\n * Get unexercised (or under-exercised) coverage items.\n * @param {object} opts - { category\x2C limit\x2C minDiscord }\n */\nexport async function getCoverageGaps(opts = {}) {\n  if (!pool) return [];\n  try {\n    const { category\x2C limit = 10\x2C minDiscord = 0 } = opts;\n    const conditions = ['discord_count <= $1'\x2C 'wired = true'];\n    const params = [minDiscord];\n    if (category) {\n      params.push(category);\n      conditions.push(`category = $${params.length}`);\n    }\n    params.push(limit);\n    const res = await pool.query(\n      `SELECT item_id\x2C category\x2C name\x2C discord_count\x2C parent_id\n       FROM coverage_items\n       WHERE ${conditions.join(' AND ')}\n       ORDER BY discord_count ASC\x2C name\n       LIMIT $${params.length}`\x2C\n      params\n    );\n    return res.rows;\n  } catch (err) {\n    console.error('[DB] getCoverageGaps failed:'\x2C err.message);\n    return [];\n  }\n}\n\n/** Get per-category coverage summary. */\nexport async function getCoverageSummary() {\n  if (!pool) return [];\n  try {\n    const res = await pool.query(\n      `SELECT\n         category\x2C\n         count(*)::int AS total\x2C\n         count(*) FILTER (WHERE wired = true)::int AS wired\x2C\n         count(*) FILTER (WHERE discord_count > 0)::int AS exercised\x2C\n         count(*) FILTER (WHERE wired = false)::int AS hard_gaps\x2C\n         count(*) FILTER (WHERE verified = true)::int AS verified\n       FROM coverage_items\n       GROUP BY category\n       ORDER BY category`\n    );\n    return res.rows;\n  } catch (err) {\n    console.error('[DB] getCoverageSummary failed:'\x2C err.message);\n    return [];\n  }\n}\n\n/**\n * Batch-set verified status for coverage items that passed correctness checks.\n * Only sets verified=true for passing items (never clears existing verification).\n * @param {Map<string\x2C {verified: boolean\x2C verified_by: string}>} verifiedItems\n */\nexport async function batchSetCoverageVerified(verifiedItems) {\n  if (!pool || !verifiedItems || verifiedItems.size === 0) return;\n  try {\n    const ids = [];\n    const bys = [];\n    for (const [id\x2C { verified\x2C verified_by }] of verifiedItems) {\n      if (verified) {\n        ids.push(id);\n        bys.push(verified_by);\n      }\n    }\n    if (ids.length === 0) return;\n    await pool.query(\n      `UPDATE coverage_items AS c SET\n         verified = true\x2C\n         verified_by = v.vby\x2C\n         verified_at = NOW()\x2C\n         updated_at = NOW()\n       FROM (SELECT unnest($1::text[]) AS item_id\x2C unnest($2::text[]) AS vby) v\n       WHERE c.item_id = v.item_id`\x2C\n      [ids\x2C bys]\n    );\n  } catch (err) {\n    console.error('[DB] batchSetCoverageVerified failed:'\x2C err.message);\n  }\n}\n\n/** Get the pool for direct queries (exploration use). */\nexport function getPool() {\n  return pool;\n}\n
