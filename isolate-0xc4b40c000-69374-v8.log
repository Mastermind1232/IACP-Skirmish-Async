code-creation,Script,9,307865,0x3f05b92a1a30,52, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/engine/board-ui-helpers.js:1:1,0x33c46858afe8,~
script-source,260,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/engine/board-ui-helpers.js,/**\n * Board/map UI helper functions extracted from index.js.\n */\n\nimport { existsSync } from 'fs';\nimport { join } from 'path';\nimport { fetchGameChannel } from '../discord/channel-helpers.js';\n\n/** Maps that are play-ready: have deployment zones\x2C map-spaces\x2C and are marked ready. */\nexport function getPlayReadyMaps(deps) {\n  const dz = deps.getDeploymentZones();\n  return deps.getMapRegistry().filter((m) => {\n    if (!dz[m.id]?.red?.length || !dz[m.id]?.blue?.length) return false;\n    const ms = deps.getMapData(m.id);\n    if (!ms || ms.playReady === false) return false;\n    return (Array.isArray(ms.spaces) && ms.spaces.length > 0) || (ms.adjacency && typeof ms.adjacency === 'object' && Object.keys(ms.adjacency).length > 0);\n  });\n}\n\n/** After map selection: randomly pick A or B mission card\x2C post to Game Log\x2C pin it. */\nexport async function postMissionCardAfterMapSelection(game\x2C client\x2C map\x2C deps) {\n  const missions = deps.getMissionCardsData()[map.id];\n  if (!missions?.a || !missions?.b) return;\n  const variant = (game._forceVariant && missions[game._forceVariant]) ? game._forceVariant : (Math.random() < 0.5 ? 'a' : 'b');\n  delete game._forceVariant;\n  const mission = missions[variant];\n  const mapName = map.name || map.id;\n  const fullName = `${mapName} \u2014 ${mission.name}`;\n  game.selectedMission = { variant\x2C name: mission.name\x2C fullName\x2C tokenLabel: mission.tokenLabel || ''\x2C interactLabel: mission.interactLabel || ''\x2C mechanics: mission.mechanics || {} };\n  await postPinnedMissionCardFromGameState(game\x2C client\x2C deps);\n}\n\n/** Post mission card when game.selectedMission and game.selectedMap are already set (e.g. Competitive). */\nexport async function postPinnedMissionCardFromGameState(game\x2C client\x2C deps) {\n  const mission = game.selectedMission;\n  const map = game.selectedMap;\n  if (!mission || !map) return;\n  const missionData = deps.getMissionCardsData()[map.id]?.[mission.variant];\n  const variantLetter = mission.variant ? String(mission.variant).toUpperCase() : '';\n  let missionName = missionData?.name || mission.name || '';\n  const dupPattern = new RegExp(`^${variantLetter}[.:] ?`\x2C 'i');\n  if (variantLetter && dupPattern.test(missionName)) missionName = missionName.replace(dupPattern\x2C '').trim();\n  const variantLabel = variantLetter ? `Variant ${variantLetter} \u2014 ${missionName}` : missionName;\n  const mapLabel = map.name || map.id;\n  const fullName = `${mapLabel}: ${variantLabel}`;\n  try {\n    const ch = await fetchGameChannel(client\x2C game.generalId);\n    let sentMsg;\n    const cardImagePath = missionData?.customImagePath || missionData?.imagePath;\n    if (cardImagePath) {\n      const resolvedPath = deps.resolveMissionCardImagePath(cardImagePath);\n      const imagePath = resolvedPath ? join(deps.rootDir\x2C resolvedPath) : null;\n      if (imagePath && existsSync(imagePath)) {\n        const attachment = new deps.AttachmentBuilder(imagePath\x2C { name: 'mission-card.jpg' });\n        sentMsg = await ch.send({ content: `\\uD83C\\uDFAF **Mission:** ${fullName}`\x2C files: [attachment] });\n      } else {\n        sentMsg = await ch.send({ content: `\\uD83C\\uDFAF **Mission:** ${fullName}` });\n      }\n    } else {\n      const parts = [`\\uD83C\\uDFAF **Mission:** ${fullName}`];\n      if (missionData?.setup) parts.push(`**Setup:** ${missionData.setup}`);\n      if (missionData?.persistent) parts.push(`**Persistent:** ${missionData.persistent}`);\n      if (missionData?.startOfRound) parts.push(`**Start of Round:** ${missionData.startOfRound}`);\n      if (missionData?.endOfRound) parts.push(`**End of Round:** ${missionData.endOfRound}`);\n      sentMsg = await ch.send({ content: parts.join('\\n') });\n    }\n    await sentMsg.pin().catch(deps.discordCatch);\n    await deps.logGameAction(game\x2C client\x2C `Mission selected: **${fullName}** (pinned above).`\x2C { phase: 'SETUP'\x2C icon: 'map' });\n  } catch (err) {\n    console.error('Mission card post error:'\x2C err);\n    await deps.logGameAction(game\x2C client\x2C `Mission selected: **${fullName}**`\x2C { phase: 'SETUP'\x2C icon: 'map' });\n  }\n}\n\n/** Delete setup messages from Game Log when Round 1 begins. */\nexport async function clearPreGameSetup(game\x2C client) {\n  const ids = [\n    ...(game.generalSetupMessageId ? [game.generalSetupMessageId] : [])\x2C\n    ...(game.bothReadyMessageId ? [game.bothReadyMessageId] : [])\x2C\n    ...(game.deploymentZoneMessageId ? [game.deploymentZoneMessageId] : [])\x2C\n    ...(game.setupLogMessageIds || [])\x2C\n  ];\n  if (ids.length === 0 && !game.p1HandId && !game.p2HandId) return;\n  try {\n    const ch = await fetchGameChannel(client\x2C game.generalId);\n    for (const id of ids) {\n      try {\n        const msg = await ch.messages.fetch(id);\n        await msg.delete();\n      } catch {}\n    }\n    game.generalSetupMessageId = null;\n    game.bothReadyMessageId = null;\n    game.deploymentZoneMessageId = null;\n    game.setupLogMessageIds = [];\n  } catch (err) {\n    console.error('Failed to clear pre-game setup:'\x2C err);\n  }\n\n  // Clear deck-selection artifacts from hand channels\n  for (const handId of [game.p1HandId\x2C game.p2HandId]) {\n    if (!handId) continue;\n    try {\n      const handCh = await fetchGameChannel(client\x2C handId);\n      const msgs = await handCh.messages.fetch({ limit: 50 });\n      for (const msg of msgs.values()) {\n        try { await msg.delete(); } catch {}\n      }\n    } catch (err) {\n      console.error('Failed to clear hand channel setup messages:'\x2C err);\n    }\n  }\n}\n
