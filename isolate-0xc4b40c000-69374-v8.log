script-source,205,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/movement.js,/**\n * Movement handlers: move_mp_\x2C move_adjust_mp_\x2C move_pick_\n */\nimport { ActionRowBuilder\x2C ButtonBuilder\x2C ButtonStyle } from 'discord.js';\nimport { buildRowPickerButtons\x2C cleanupSpacePick } from '../discord/components.js';\nimport { canActAsPlayer } from '../utils/can-act-as-player.js';\nimport { getDcEffects\x2C getMapData } from '../data-loader.js';\nimport { bottomLeftCoord\x2C getFootprintCells\x2C normalizeCoord\x2C parseSizeString } from '../game/coords.js';\nimport { reduceHp\x2C dcNameFromFigureKey\x2C getMaxPowerTokens\x2C grantPowerTokens } from '../game/index.js';\nimport { getDcList\x2C getDcMessageIds\x2C getPlayerId\x2C opponentPlayerNum\x2C pushFigure } from '../game/player-helpers.js';\nimport { discordCatch } from '../error-handling.js';\nimport { requireGame\x2C requirePlayer } from '../utils/guards.js';\nimport { detectPostMoveInterrupts } from '../game/movement-interrupts.js';\nimport { fetchGameChannel } from '../discord/channel-helpers.js';\n\nconst BTM_PER_MSG = 5;\nconst SPACE_ROWS_ON_FIRST = 4;\n\n/** Clean up all movement-related state flags for a completed/cancelled move. */\nfunction _cleanupMoveState(game\x2C moveKey\x2C msgId) {\n  delete game.moveInProgress[moveKey];\n  if (game.mobileMovementActive?.[msgId]) delete game.mobileMovementActive[msgId];\n  if (game.urgencyMustSpendAll?.[msgId]) delete game.urgencyMustSpendAll[msgId];\n}\n\n/**\n * Show space picker buttons for a massive-push displaced figure.\n * Stores controller + validSpaces on pending\x2C then delegates rendering to\n * renderMassivePushSpacePrompt so the reconciler can re-post from state alone.\n * @param {object} choice - { entry\x2C validSpaces\x2C controllerPlayerNum } from resolveNextDisplacements\n */\nasync function _showMassivePushPicker(game\x2C choice\x2C interaction\x2C client\x2C logGameAction\x2C buildBoardMapPayload\x2C saveGames) {\n  const pending = game.pendingMassivePush;\n  if (!pending || !choice) { delete game.pendingMassivePush; return; }\n  const { validSpaces\x2C controllerPlayerNum } = choice;\n  pending._currentControllerPlayerNum = controllerPlayerNum;\n  pending._currentValidSpaces = validSpaces;\n  await renderMassivePushSpacePrompt(game\x2C client\x2C { fallbackChannel: interaction?.channel });\n  if (saveGames) saveGames();\n}\n\n/**\n * Show figure-order picker: when 2+ displaced figures remain in the active phase\x2C\n * the controller chooses which one to place next. Figures are encoded by index\n * into pending._currentPickable (figure keys can contain spaces / dashes and\n * don't round-trip cleanly through a customId).\n * Delegates rendering to renderMassivePushFigurePrompt.\n * @param {object} figurePick - { pickable\x2C controllerPlayerNum } from resolveNextDisplacements\n */\nasync function _showMassivePushFigurePicker(game\x2C figurePick\x2C interaction\x2C client\x2C saveGames) {\n  const pending = game.pendingMassivePush;\n  if (!pending || !figurePick) { delete game.pendingMassivePush; return; }\n  const { pickable\x2C controllerPlayerNum } = figurePick;\n  pending._currentControllerPlayerNum = controllerPlayerNum;\n  pending._currentPickable = pickable.map((e) => ({\n    figureKey: e.figureKey\x2C\n    dcName: e.dcName\x2C\n    playerNum: e.playerNum\x2C\n  }));\n  pending._currentValidSpaces = null;\n  await renderMassivePushFigurePrompt(game\x2C client\x2C { fallbackChannel: interaction?.channel });\n  if (saveGames) saveGames();\n}\n\n/**\n * Render-from-state: post the massive-push space picker using only game state\n * and client. Used by _showMassivePushPicker (after it caches\n * _currentValidSpaces on pending) and by the prompt reconciler on refresh.\n * Records the resulting msg into game.promptMessageIds.massivePushSpace.\n */\nexport async function renderMassivePushSpacePrompt(game\x2C client\x2C opts = {}) {\n  const pending = game.pendingMassivePush;\n  if (!pending) return;\n  const validSpaces = pending._currentValidSpaces || [];\n  if (validSpaces.length === 0) return;\n  const queue = pending.phase === 'friendly' ? pending.friendlyQueue : pending.enemyQueue;\n  const entry = queue?.[pending.currentIndex];\n  if (!entry) return;\n  const prevPos = game.figurePositions?.[entry.playerNum]?.[entry.figureKey];\n  const btns = validSpaces.map((space) =>\n    new ButtonBuilder()\n      .setCustomId(`massive_push_space_${pending.gameId}_${space}`)\n      .setLabel(String(space).toUpperCase())\n      .setStyle(ButtonStyle.Primary)\n  );\n  const rows = [];\n  while (btns.length > 0) rows.push(new ActionRowBuilder().addComponents(btns.splice(0\x2C 5)));\n  const from = prevPos ? String(prevPos).toUpperCase() : '?';\n  const controllerTag = pending.phase === 'friendly' ? 'your figure' : 'opponent\\'s figure';\n  const threadId = game.dcActionsData ? Object.values(game.dcActionsData).find((d) => d.threadId)?.threadId : null;\n  const channel = threadId ? await fetchGameChannel(client\x2C threadId) : (opts.fallbackChannel || null);\n  if (!channel) return;\n  const sent = await channel.send({\n    content: `**Massive Displacement** \u2014 Place **${entry.dcName}** (${controllerTag}\x2C currently at **${from}**) to which space?`\x2C\n    components: rows.slice(0\x2C 5)\x2C\n  }).catch(discordCatch);\n  if (sent?.id) {\n    const { recordPromptMessage\x2C signatureFor } = await import('../engine/prompt-reconciler.js');\n    recordPromptMessage(game\x2C 'massivePushSpace'\x2C sent.channelId || channel.id\x2C sent.id\x2C signatureFor('massivePushSpace'\x2C game));\n  }\n}\n\n/**\n * Render-from-state: post the massive-push figure-order picker using only\n * game state and client. Records msg into game.promptMessageIds.massivePushFigure.\n */\nexport async function renderMassivePushFigurePrompt(game\x2C client\x2C opts = {}) {\n  const pending = game.pendingMassivePush;\n  if (!pending) return;\n  const pickable = pending._currentPickable || [];\n  if (pickable.length === 0) return;\n  const btns = pickable.map((entry\x2C idx) => {\n    const pos = game.figurePositions?.[entry.playerNum]?.[entry.figureKey];\n    const label = `${entry.dcName}${pos ? ` @ ${String(pos).toUpperCase()}` : ''}`.slice(0\x2C 80);\n    return new ButtonBuilder()\n      .setCustomId(`massive_push_figure_${pending.gameId}_${idx}`)\n      .setLabel(label)\n      .setStyle(ButtonStyle.Primary);\n  });\n  const rows = [];\n  while (btns.length > 0) rows.push(new ActionRowBuilder().addComponents(btns.splice(0\x2C 5)));\n  const phaseLabel = pending.phase === 'friendly' ? 'your figures' : 'opponent\\'s figures';\n  const threadId = game.dcActionsData ? Object.values(game.dcActionsData).find((d) => d.threadId)?.threadId : null;\n  const channel = threadId ? await fetchGameChannel(client\x2C threadId) : (opts.fallbackChannel || null);\n  if (!channel) return;\n  const sent = await channel.send({\n    content: `**Massive Displacement** \u2014 Pick which of **${phaseLabel}** to place next.`\x2C\n    components: rows.slice(0\x2C 5)\x2C\n  }).catch(discordCatch);\n  if (sent?.id) {\n    const { recordPromptMessage\x2C signatureFor } = await import('../engine/prompt-reconciler.js');\n    recordPromptMessage(game\x2C 'massivePushFigure'\x2C sent.channelId || channel.id\x2C sent.id\x2C signatureFor('massivePushFigure'\x2C game));\n  }\n}\n\n/**\n * Dispatcher: after resolveNextDisplacements returns a result\x2C either:\n *   - result.done        \u2192 cleanup pendingMassivePush\x2C refresh board\x2C resume any\n *                          deferred post-deploy movement-complete callback.\n *   - result.needsFigurePick \u2192 post figure-order picker.\n *   - result.needsChoice \u2192 post space picker for the current figure.\n */\nasync function _dispatchNextMassivePush(game\x2C result\x2C interaction\x2C ctx) {\n  const { client\x2C logGameAction\x2C buildBoardMapPayload\x2C saveGames } = ctx;\n  if (result.done) {\n    const gameId = game.pendingMassivePush?.gameId || game.gameId;\n    delete game.pendingMassivePush;\n    if (game.boardId && game.selectedMap && buildBoardMapPayload) {\n      try {\n        const boardChannel = await fetchGameChannel(client\x2C game.boardId);\n        if (boardChannel) {\n          const payload = await buildBoardMapPayload(gameId\x2C game.selectedMap\x2C game);\n          await boardChannel.send(payload);\n        }\n      } catch (err) { console.error('Massive push: board refresh failed'\x2C err); }\n    }\n    // Resume any deferred post-deploy movement-complete callback gated on\n    // pendingMassivePush. No-op if nothing was deferred.\n    const { resumeDeferredPostDeployMove } = await import('./post-deploy.js');\n    await resumeDeferredPostDeployMove(game\x2C gameId\x2C client\x2C ctx);\n    if (saveGames) saveGames();\n    return;\n  }\n  if (result.needsFigurePick) {\n    await _showMassivePushFigurePicker(game\x2C result.needsFigurePick\x2C interaction\x2C client\x2C saveGames);\n    return;\n  }\n  if (result.needsChoice) {\n    await _showMassivePushPicker(game\x2C result.needsChoice\x2C interaction\x2C client\x2C logGameAction\x2C buildBoardMapPayload\x2C saveGames);\n  }\n}\n\n/**\n * Handle massive push space pick button (massive_push_space_).\n * Places the displaced figure\x2C then continues iterative resolution.\n * Push authority: friendly phase \u2192 massive controller\x2C enemy phase \u2192 enemy player.\n */\nexport async function handleMassivePushSpace(interaction\x2C ctx) {\n  const { getGame\x2C logGameAction\x2C saveGames\x2C client } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const match = interaction.customId.match(/^massive_push_space_([^_]+)_(.+)$/);\n  if (!match) { await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  const [\x2C gameId\x2C chosenSpace] = match;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  const pending = game.pendingMassivePush;\n  if (!pending || pending.gameId !== gameId) {\n    await interaction.followUp({ content: 'No pending displacement.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Push authority: friendly phase \u2192 massive controller picks; enemy phase \u2192 enemy player picks\n  const controllerPlayerNum = pending._currentControllerPlayerNum ?? pending.movingPlayerNum;\n  const authorityLabel = pending.phase === 'friendly'\n    ? 'Only the massive figure\\'s controller can place friendly figures.'\n    : 'Only the displaced figure\\'s controller can place their figures.';\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C controllerPlayerNum\x2C canActAsPlayer\x2C authorityLabel)) return;\n  const valid = (pending._currentValidSpaces || []).map(s => s.toLowerCase());\n  if (!valid.includes(chosenSpace.toLowerCase())) {\n    await interaction.followUp({ content: 'Invalid space.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Apply choice via shared engine\n  const { applyDisplacementChoice\x2C resolveNextDisplacements } = await import('../game/movement.js');\n  const applied = applyDisplacementChoice(game\x2C pending\x2C chosenSpace);\n  if (applied) {\n    const from = applied.prevPos ? String(applied.prevPos).toUpperCase() : '?';\n    await logGameAction(game\x2C client\x2C `**${applied.entry.dcName}** displaced **${from}** \u2192 **${chosenSpace.toUpperCase()}** by massive figure (controller choice).`\x2C { icon: 'move'\x2C phase: 'ROUND' });\n  }\n  try { await interaction.message.edit({ content: `Placed **${applied?.entry?.dcName || 'figure'}** at **${chosenSpace.toUpperCase()}**.`\x2C components: [] }).catch(discordCatch); } catch {}\n  const { clearPromptRecord } = await import('../engine/prompt-reconciler.js');\n  clearPromptRecord(game\x2C 'massivePushSpace');\n  // Continue iterative resolution \u2014 may auto-resolve more figures before next choice\n  const result = resolveNextDisplacements(game\x2C pending);\n  for (const r of result.autoResolved) {\n    const from = r.prevPos ? String(r.prevPos).toUpperCase() : '?';\n    const to = r.newPos ? String(r.newPos).toUpperCase() : '?';\n    const suffix = r.bfs ? ' (no adjacent spaces)' : '';\n    await logGameAction(game\x2C client\x2C `**${r.entry.dcName}** displaced **${from}** \u2192 **${to}** by massive figure${suffix}.`\x2C { icon: 'move'\x2C phase: 'ROUND' });\n  }\n  await _dispatchNextMassivePush(game\x2C result\x2C interaction\x2C ctx);\n  if (saveGames) saveGames();\n}\n\n/**\n * Handle massive push figure-order pick (massive_push_figure_).\n * Controller chooses WHICH displaced figure to place next (when 2+ remain in phase).\n * Authority matches space-pick: friendly phase \u2192 massive controller; enemy phase \u2192 enemy player.\n */\nexport async function handleMassivePushFigure(interaction\x2C ctx) {\n  const { getGame\x2C logGameAction\x2C saveGames\x2C client } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const match = interaction.customId.match(/^massive_push_figure_([^_]+)_(\\d+)$/);\n  if (!match) { await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  const [\x2C gameId\x2C idxStr] = match;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  const pending = game.pendingMassivePush;\n  if (!pending || pending.gameId !== gameId) {\n    await interaction.followUp({ content: 'No pending displacement.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const controllerPlayerNum = pending._currentControllerPlayerNum ?? pending.movingPlayerNum;\n  const authorityLabel = pending.phase === 'friendly'\n    ? 'Only the massive figure\\'s controller can pick placement order.'\n    : 'Only the displaced figure\\'s controller can pick placement order.';\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C controllerPlayerNum\x2C canActAsPlayer\x2C authorityLabel)) return;\n  const idx = parseInt(idxStr\x2C 10);\n  const pickable = pending._currentPickable || [];\n  const choice = pickable[idx];\n  if (!choice) {\n    await interaction.followUp({ content: 'Invalid pick.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { applyFigurePick\x2C resolveNextDisplacements } = await import('../game/movement.js');\n  if (!applyFigurePick(pending\x2C choice.figureKey)) {\n    await interaction.followUp({ content: 'Invalid pick.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  try { await interaction.message.edit({ content: `Order set: **${choice.dcName}** placed next.`\x2C components: [] }).catch(discordCatch); } catch {}\n  const { clearPromptRecord } = await import('../engine/prompt-reconciler.js');\n  clearPromptRecord(game\x2C 'massivePushFigure');\n  // Drive one more resolution step \u2014 with the order locked in\x2C it will either\n  // auto-drain (0/1-space edge cases) or return needsChoice for this figure.\n  const result = resolveNextDisplacements(game\x2C pending);\n  for (const r of result.autoResolved) {\n    const from = r.prevPos ? String(r.prevPos).toUpperCase() : '?';\n    const to = r.newPos ? String(r.newPos).toUpperCase() : '?';\n    const suffix = r.bfs ? ' (no adjacent spaces)' : '';\n    await logGameAction(game\x2C client\x2C `**${r.entry.dcName}** displaced **${from}** \u2192 **${to}** by massive figure${suffix}.`\x2C { icon: 'move'\x2C phase: 'ROUND' });\n  }\n  await _dispatchNextMassivePush(game\x2C result\x2C interaction\x2C ctx);\n  if (saveGames) saveGames();\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C dcMessageMeta\x2C getBoardStateForMovement\x2C getMovementProfile\x2C ensureMovementCache\x2C getSpacesAtCost\x2C clearMoveGridMessages\x2C getMovementMinimapAttachment\x2C client\n */\nexport async function handleMoveMp(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    dcMessageMeta\x2C\n    getBoardStateForMovement\x2C\n    getMovementProfile\x2C\n    ensureMovementCache\x2C\n    getSpacesAtCost\x2C\n    clearMoveGridMessages\x2C\n    getMovementMinimapAttachment\x2C\n    client\x2C\n  } = ctx;\n  const m = interaction.customId.match(/^move_mp_(.+)_(\\d+)_(\\d+)$/);\n  if (!m) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C msgId\x2C figureIndexStr\x2C mpStr] = m;\n  const figureIndex = parseInt(figureIndexStr\x2C 10);\n  const mp = parseInt(mpStr\x2C 10);\n  const meta = dcMessageMeta.get(msgId);\n  if (!meta) {\n    await interaction.followUp({ content: 'DC no longer tracked.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const game = await requireGame(interaction\x2C getGame\x2C meta.gameId);\n  if (!game) return;\n  const moveKey = `${msgId}_${figureIndex}`;\n  const moveState = game.moveInProgress?.[moveKey];\n  if (!moveState) {\n    await interaction.followUp({ content: 'Move session expired.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { figureKey\x2C playerNum\x2C mpRemaining\x2C displayName } = moveState;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner can move.')) return;\n  if (mp < 1 || mp > mpRemaining) {\n    await interaction.followUp({ content: `Choose 1\u2013${mpRemaining} MP.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Urgency: must spend all MP at once (C77)\n  if (game.urgencyMustSpendAll?.[msgId] && mp < mpRemaining) {\n    await interaction.followUp({ content: `**Urgency** requires you to spend all **${mpRemaining}** MP at once.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const boardState = moveState.boardState || getBoardStateForMovement(game\x2C figureKey);\n  if (!boardState) {\n    _cleanupMoveState(game\x2C moveKey\x2C msgId);\n    await interaction.followUp({ content: 'Map data missing. Movement cancelled.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const profile = moveState.movementProfile || getMovementProfile(meta.dcName\x2C figureKey\x2C game);\n  // Force Jump: mobileMovementActive grants MOBILE movement (pass through figures/doors)\n  if (game.mobileMovementActive?.[msgId]) {\n    profile.isMobile = true;\n    profile.ignoreBlocking = true;\n    profile.ignoreFigureCost = true;\n    profile.ignoreDifficult = true;\n  }\n  moveState.boardState = boardState;\n  moveState.movementProfile = profile;\n  const startCoord = moveState.startCoord || game.figurePositions?.[playerNum]?.[figureKey];\n  if (!startCoord) {\n    _cleanupMoveState(game\x2C moveKey\x2C msgId);\n    await interaction.followUp({ content: 'Figure position missing. Movement cancelled.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const cache = ensureMovementCache(moveState\x2C startCoord\x2C mpRemaining\x2C boardState\x2C profile);\n  const spaces = getSpacesAtCost(cache\x2C mp);\n  if (spaces.length === 0) {\n    const validCosts = [...new Set([...cache.cells.values()].map((c) => c.cost))].filter((c) => c > 0 && c <= mpRemaining).sort((a\x2C b) => a - b);\n    const altText = validCosts.length > 0 ? ` Reachable: ${validCosts.join('\x2C ')} MP.` : '';\n    await interaction.followUp({ content: `No spaces exactly **${mp}** MP away.${altText}`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // cache.cells now only stores topLeft cells\x2C so spaces is already topLeft-only.\n  const isMultiTile = profile.size && profile.size !== '1x1';\n  const buttonSpaces = spaces;\n  moveState.pendingMp = mp;\n  await clearMoveGridMessages(game\x2C moveKey\x2C interaction.channel);\n  game.moveGridMessageIds = game.moveGridMessageIds || {};\n  delete game.moveGridMessageIds[moveKey];\n  if (moveState.distanceMessageId && interaction.message?.id === moveState.distanceMessageId) {\n    await interaction.message.edit({\n      content: `**Move** \u2014 Pick a destination (**${mp}** MP) \u2014 see map and buttons below.`\x2C\n      components: []\x2C\n    }).catch(discordCatch);\n  }\n  // Build 2-step row\u2192cell picker via generic space_row_ handler\n  const labelMap = {};\n  if (isMultiTile) {\n    for (const s of buttonSpaces) {\n      const n = normalizeCoord(s);\n      labelMap[n] = bottomLeftCoord(n\x2C profile.size).toUpperCase();\n    }\n  }\n  const multiTileNote = isMultiTile ? `\\n\ud83d\udcd0 Buttons show **bottom-left corner** of each valid placement.` : '';\n  const rowDisplayOffset = isMultiTile ? parseSizeString(profile.size).rows - 1 : 0;\n  const moveContextKey = `${meta.gameId}_${moveKey}`;\n  const moveHeader = `**Move** \u2014 Pick destination (**${mp}** MP):${multiTileNote}`;\n  const moveActionBtns = [\n    { customId: `move_adjust_mp_${msgId}_${figureIndex}`\x2C label: 'Adjust movement points spent'\x2C style: ButtonStyle.Secondary }\x2C\n  ];\n  if (!game.urgencyMustSpendAll?.[msgId]) {\n    moveActionBtns.push(\n      { customId: `move_pick_${msgId}_${figureIndex}_done`\x2C label: 'End Movement'\x2C style: ButtonStyle.Secondary }\n    );\n  }\n  game.pendingSpacePick = game.pendingSpacePick || {};\n  game.pendingSpacePick[moveContextKey] = {\n    validSpaces: buttonSpaces\x2C\n    cellPrefix: `move_pick_${msgId}_${figureIndex}_`\x2C\n    mapSpaces: boardState.mapSpaces\x2C\n    labelMap\x2C\n    headerText: moveHeader\x2C\n    actionButtons: moveActionBtns\x2C\n    rowDisplayOffset\x2C\n  };\n  const { rows: moveRowBtns } = buildRowPickerButtons(buttonSpaces\x2C `space_row_${moveContextKey}_`\x2C { rowDisplayOffset });\n  const actionBtns = moveActionBtns.map(b =>\n    new ButtonBuilder().setCustomId(b.customId).setLabel(b.label).setStyle(b.style)\n  );\n  const actionRow = new ActionRowBuilder().addComponents(...actionBtns);\n  const minimapCells = isMultiTile\n    ? buttonSpaces.map((tl) => bottomLeftCoord(tl\x2C profile.size))\n    : spaces;\n  const moveMinimap = await getMovementMinimapAttachment(game\x2C msgId\x2C figureKey\x2C minimapCells);\n  const gridPayload = {\n    content: `${moveHeader}\\nChoose a row:`\x2C\n    components: [...moveRowBtns.slice(0\x2C 4)\x2C actionRow]\x2C\n    fetchReply: true\x2C\n  };\n  if (moveMinimap) gridPayload.files = [moveMinimap];\n  const gridMsg = await interaction.followUp(gridPayload).catch(() => null);\n  game.moveGridMessageIds = game.moveGridMessageIds || {};\n  game.moveGridMessageIds[moveKey] = gridMsg?.id ? [gridMsg.id] : [];\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C dcMessageMeta\x2C clearMoveGridMessages\x2C getMoveMpButtonRows\n */\nexport async function handleMoveAdjustMp(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    dcMessageMeta\x2C\n    clearMoveGridMessages\x2C\n    getMoveMpButtonRows\x2C\n  } = ctx;\n  const m = interaction.customId.match(/^move_adjust_mp_(.+)_(\\d+)$/);\n  if (!m) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C msgId\x2C figureIndexStr] = m;\n  const figureIndex = parseInt(figureIndexStr\x2C 10);\n  const meta = dcMessageMeta.get(msgId);\n  if (!meta) {\n    await interaction.followUp({ content: 'DC no longer tracked.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const game = await requireGame(interaction\x2C getGame\x2C meta.gameId);\n  if (!game) return;\n  const moveKey = `${msgId}_${figureIndex}`;\n  cleanupSpacePick(game\x2C `${meta.gameId}_${moveKey}`);\n  const moveState = game.moveInProgress?.[moveKey];\n  if (!moveState) {\n    await interaction.followUp({ content: 'Move session expired.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { playerNum\x2C mpRemaining } = moveState;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner can adjust.')) return;\n  // Remove the clicked message from gridIds before clearing so we can transform it in-place\n  const currentMsgId = interaction.message.id;\n  game.moveGridMessageIds = game.moveGridMessageIds || {};\n  game.moveGridMessageIds[moveKey] = (game.moveGridMessageIds[moveKey] || []).filter((id) => id !== currentMsgId);\n  moveState.pendingMp = null;\n  await clearMoveGridMessages(game\x2C moveKey\x2C interaction.channel);\n  game.moveGridMessageIds[moveKey] = [];\n  const mpRows = getMoveMpButtonRows(msgId\x2C figureIndex\x2C mpRemaining);\n  // Transform the clicked message (space grid or "Pick Path Manually" standalone) into the MP picker\n  try {\n    await interaction.message.edit({\n      content: `**Move** \u2014 Pick distance (**${mpRemaining}** MP remaining):`\x2C\n      components: mpRows.length > 0 ? mpRows : []\x2C\n      files: []\x2C\n      attachments: []\x2C // clear old minimap image\n    });\n    moveState.distanceMessageId = currentMsgId;\n  } catch {\n    // Fallback: send a new message if the original was somehow already gone\n    const newMsg = await interaction.channel.send({\n      content: `**Move** \u2014 Pick distance (**${mpRemaining}** MP remaining):`\x2C\n      components: mpRows.length > 0 ? mpRows : []\x2C\n    }).catch(() => null);\n    if (newMsg?.id) moveState.distanceMessageId = newMsg.id;\n  }\n}\n\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C dcMessageMeta\x2C clearMoveGridMessages\x2C getBoardStateForMovement\x2C getMovementProfile\x2C ensureMovementCache\x2C computeMovementCache\x2C normalizeCoord\x2C getMovementTarget\x2C getFigureSize\x2C getNormalizedFootprint\x2C resolveMassivePush\x2C updateMovementBankMessage\x2C getMovementPath\x2C pushUndo\x2C logGameAction\x2C countTerminalsControlledByPlayer\x2C editDistanceMessage\x2C getMoveMpButtonRows\x2C buildBoardMapPayload\x2C updateDcActionsMessage\x2C saveGames\x2C client\n */\nexport async function handleMovePick(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    dcMessageMeta\x2C\n    clearMoveGridMessages\x2C\n    getBoardStateForMovement\x2C\n    getMovementProfile\x2C\n    ensureMovementCache\x2C\n    computeMovementCache\x2C\n    normalizeCoord\x2C\n    getMovementTarget\x2C\n    getFigureSize\x2C\n    getNormalizedFootprint\x2C\n    updateMovementBankMessage\x2C\n    getMovementPath\x2C\n    pushUndo\x2C\n    logGameAction\x2C\n    countTerminalsControlledByPlayer\x2C\n    getMovementMinimapAttachment\x2C\n    buildBoardMapPayload\x2C\n    getDcStats\x2C\n    saveGames\x2C\n    client\x2C\n    processFigureDefeat\x2C\n  } = ctx;\n  const m = interaction.customId.match(/^move_pick_(.+)_(\\d+)_(.+)$/);\n  if (!m) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C msgId\x2C figureIndexStr\x2C space] = m;\n  const figureIndex = parseInt(figureIndexStr\x2C 10);\n  const meta = dcMessageMeta.get(msgId);\n  if (!meta) {\n    await interaction.followUp({ content: 'DC no longer tracked.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const game = await requireGame(interaction\x2C getGame\x2C meta.gameId);\n  if (!game) return;\n  const moveKey = `${msgId}_${figureIndex}`;\n  cleanupSpacePick(game\x2C `${meta.gameId}_${moveKey}`);\n  const moveState = game.moveInProgress?.[moveKey];\n  if (!moveState) {\n    await interaction.followUp({ content: 'Move session expired.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { figureKey\x2C playerNum\x2C mpRemaining\x2C displayName } = moveState;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner can move.')) return;\n\n  // Early termination: "done" ends movement immediately (forfeit remaining MP)\n  if (space === 'done') {\n    await clearMoveGridMessages(game\x2C moveKey\x2C interaction.channel);\n    try { await interaction.message.delete(); } catch { /* already gone */ }\n    _cleanupMoveState(game\x2C moveKey\x2C msgId);\n    await interaction.followUp({ content: `**${displayName}** ended movement (**${mpRemaining}** MP forfeited).`\x2C ephemeral: false }).catch(discordCatch);\n    // Restore activation buttons (figure selector\x2C Move/Attack/etc.)\n    if (ctx.updateDcActionsMessage) {\n      await ctx.updateDcActionsMessage(game\x2C msgId\x2C client).catch(() => {});\n    }\n    saveGames();\n    return;\n  }\n\n  await clearMoveGridMessages(game\x2C moveKey\x2C interaction.channel);\n  // Also delete the message the user clicked on (it may have been edited in-place\n  // by the row\u2192cell picker and removed from moveGridMessageIds tracking)\n  try { await interaction.message.delete(); } catch { /* already gone or no perms */ }\n  const boardState = getBoardStateForMovement(game\x2C figureKey);\n  if (!boardState) {\n    _cleanupMoveState(game\x2C moveKey\x2C msgId);\n    await interaction.followUp({ content: 'Map data missing. Movement cancelled.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const profile = getMovementProfile(meta.dcName\x2C figureKey\x2C game);\n  // Force Jump: mobileMovementActive grants MOBILE movement (pass through figures/doors)\n  if (game.mobileMovementActive?.[msgId]) {\n    profile.isMobile = true;\n    profile.ignoreBlocking = true;\n    profile.ignoreFigureCost = true;\n    profile.ignoreDifficult = true;\n  }\n  const startCoord = moveState.startCoord || game.figurePositions?.[playerNum]?.[figureKey];\n  if (!startCoord) {\n    _cleanupMoveState(game\x2C moveKey\x2C msgId);\n    await interaction.followUp({ content: 'Figure position missing. Movement cancelled.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const cache = ensureMovementCache(moveState\x2C startCoord\x2C mpRemaining\x2C boardState\x2C profile);\n  const targetLower = normalizeCoord(space);\n  const targetInfo = getMovementTarget(cache\x2C targetLower);\n  if (!targetInfo) {\n    await interaction.followUp({ content: 'Destination not valid for the selected MP.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (moveState.pendingMp && targetInfo.cost !== moveState.pendingMp) {\n    await interaction.followUp({ content: 'Select a destination from the most recent distance choice.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const cost = targetInfo.cost;\n  if (cost > mpRemaining) {\n    await interaction.followUp({ content: 'Not enough movement points.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  moveState.pendingMp = null;\n  const mapId = game.selectedMap?.id;\n\n  // Cripple: figure cannot voluntarily exit its current space this round\n  if (game.crippledFigures?.includes(displayName)) {\n    const currentPos = moveState.startCoord || game.figurePositions?.[playerNum]?.[figureKey];\n    if (currentPos && targetInfo.topLeft !== currentPos) {\n      await interaction.followUp({ content: `**${displayName}** is Crippled \u2014 cannot voluntarily exit its space this round.`\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n  }\n\n  // Hold Ground: SMALL hostile figures cannot voluntarily exit spaces adjacent to the Hold Ground player's figures\n  if (game.holdGroundPlayerNum && game.holdGroundPlayerNum !== playerNum) {\n    const isSMALL = getDcStats ? !((getDcStats(meta.dcName)?.keywords || []).some((k) => k === 'LARGE' || k === 'MASSIVE')) : false;\n    if (isSMALL) {\n      const holdPoses = game.figurePositions?.[game.holdGroundPlayerNum] || {};\n      const holdPlayerCells = [];\n      for (const [hfk\x2C hPos] of Object.entries(holdPoses)) {\n        if (!hPos) continue;\n        const hSize = game.figureOrientations?.[hfk];\n        if (hSize && hSize !== '1x1') {\n          for (const c of getFootprintCells(hPos\x2C hSize)) holdPlayerCells.push(String(c).toLowerCase());\n        } else {\n          holdPlayerCells.push(String(hPos).toLowerCase());\n        }\n      }\n      if (holdPlayerCells.length > 0 && mapId) {\n        const boardState = getBoardStateForMovement(game\x2C null);\n        const adjacency = boardState?.mapSpaces?.adjacency || {};\n        const adjacentToHolder = new Set();\n        for (const hLow of holdPlayerCells) {\n          for (const adj of adjacency[hLow] || []) adjacentToHolder.add(String(adj).toLowerCase());\n        }\n        const currentPos = moveState.startCoord || game.figurePositions?.[playerNum]?.[figureKey];\n        if (currentPos && adjacentToHolder.has(String(currentPos).toLowerCase()) && targetInfo.topLeft !== currentPos) {\n          await interaction.followUp({ content: `**${displayName}** cannot voluntarily exit this space \u2014 **Hold Ground** is active.`\x2C ephemeral: true }).catch(discordCatch);\n          return;\n        }\n      }\n    }\n  }\n\n  // Tripod: if figure has attacked this activation\x2C cannot exit its space\n  if (game.tripodAttacked?.[figureKey]) {\n    const currentPos = moveState.startCoord || game.figurePositions?.[playerNum]?.[figureKey];\n    if (currentPos && targetInfo.topLeft !== currentPos) {\n      await interaction.followUp({ content: `**${displayName}** has **Tripod** and has already attacked \u2014 cannot exit its space this activation.`\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n  }\n\n  // Thrusters (74-Z Speeder Bike): after moving\x2C must overlap at least 1 space the figure already occupies\n  {\n    const _thrEff = getDcEffects()?.[meta.dcName];\n    if ((_thrEff?.passives || []).includes('Thrusters')) {\n      const currentPos = moveState.startCoord || game.figurePositions?.[playerNum]?.[figureKey];\n      if (currentPos && targetInfo.topLeft !== currentPos) {\n        const currentSize = game.figureOrientations?.[figureKey] || getFigureSize(meta.dcName);\n        const oldFootprint = new Set(getNormalizedFootprint(currentPos\x2C currentSize));\n        const newFootprint = getNormalizedFootprint(targetInfo.topLeft\x2C targetInfo.size || currentSize);\n        const hasOverlap = newFootprint.some((cell) => oldFootprint.has(cell));\n        if (!hasOverlap) {\n          await interaction.followUp({ content: `**${displayName}** has **Thrusters** \u2014 must enter at least 1 space it already occupies.`\x2C ephemeral: true }).catch(discordCatch);\n          return;\n        }\n      }\n    }\n  }\n\n  const terminalsBefore = mapId ? countTerminalsControlledByPlayer(game\x2C playerNum\x2C mapId) : 0;\n  if (!game.figurePositions) game.figurePositions = { 1: {}\x2C 2: {} };\n  if (!game.figurePositions[playerNum]) game.figurePositions[playerNum] = {};\n  const newTopLeft = targetInfo.topLeft;\n  game.figurePositions[playerNum][figureKey] = newTopLeft;\n  // Track that this figure has moved (used by Tripod\x2C etc.)\n  if (!game.figureMoved) game.figureMoved = {};\n  game.figureMoved[figureKey] = true;\n  // Overrun: when entering a hostile's space\x2C deal 2 damage (once per hostile per move session)\n  if (game.overrunThisActivation?.[msgId]) {\n    const hostilePlayerNum = opponentPlayerNum(playerNum);\n    const hostilePositions = game.figurePositions?.[hostilePlayerNum] || {};\n    game.overrunDamagedThisMove = game.overrunDamagedThisMove || {};\n    if (!game.overrunDamagedThisMove[msgId]) game.overrunDamagedThisMove[msgId] = [];\n    const hostileDcList = getDcList(game\x2C hostilePlayerNum) || [];\n    const hostileMsgIds = getDcMessageIds(game\x2C hostilePlayerNum) || [];\n    const _dcHealthState = ctx.dcHealthState;\n    // Compute the moving figure's footprint tentatively for overlap detection\n    const _movingSize = targetInfo.size || getFigureSize(meta.dcName);\n    const _movingFootprint = new Set(getNormalizedFootprint(newTopLeft\x2C _movingSize));\n    for (const [hostileFigureKey\x2C hostilePos] of Object.entries(hostilePositions)) {\n      if (!hostilePos) continue;\n      if (game.overrunDamagedThisMove[msgId].includes(hostileFigureKey)) continue;\n      const hFkMatch = hostileFigureKey.match(/^(.+)-(\\d+)-(\\d+)$/);\n      if (!hFkMatch) continue;\n      const [\x2C hostileDcName\x2C hostileDgIndex\x2C hostileFigIndexStr] = hFkMatch;\n      const hostileSize = game.figureOrientations?.[hostileFigureKey] || getFigureSize(hostileDcName);\n      const hostileFootprint = new Set(getNormalizedFootprint(hostilePos\x2C hostileSize));\n      const overlaps = [..._movingFootprint].some((s) => hostileFootprint.has(s));\n      if (!overlaps) continue;\n      game.overrunDamagedThisMove[msgId].push(hostileFigureKey);\n      if (!_dcHealthState) continue;\n      let hostileMsgId = null;\n      for (const [hMsgId\x2C hMeta] of dcMessageMeta) {\n        if (hMeta.gameId !== game.gameId) continue;\n        if (hMeta.playerNum !== hostilePlayerNum) continue;\n        if (hMeta.dcName !== hostileDcName) continue;\n        const hDgMatch = (hMeta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/);\n        const hDgIdx = hDgMatch ? hDgMatch[1] : '1';\n        if (String(hDgIdx) === String(hostileDgIndex)) { hostileMsgId = hMsgId; break; }\n      }\n      if (!hostileMsgId) continue;\n      const hFigIndex = parseInt(hostileFigIndexStr\x2C 10);\n      const hHealthState = _dcHealthState.get(hostileMsgId);\n      const hEntry = hHealthState?.[hFigIndex];\n      if (!hEntry || !Array.isArray(hEntry)) continue;\n      const [hCur\x2C hMax] = hEntry;\n      const hCurHp = hCur ?? hMax ?? 0;\n      if (hMax === 0 || hCurHp <= 0) continue;\n      const { prevHp: curHp\x2C newHp } = reduceHp(_dcHealthState\x2C game\x2C hostileMsgId\x2C hFigIndex\x2C 2\x2C hostilePlayerNum);\n      const hDisplayName = dcMessageMeta.get(hostileMsgId)?.displayName || hostileDcName;\n      const defeatNote = newHp <= 0 ? ' **(defeated)**' : '';\n      await logGameAction(game\x2C client\x2C `**Overrun** \u2014 **${displayName}** entered **${hDisplayName}**'s space: 2 Damage${defeatNote} (HP: ${curHp}\u2192${newHp}).`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n      if (newHp <= 0 && processFigureDefeat) {\n        await processFigureDefeat(game\x2C {\n          defeatedPlayerNum: hostilePlayerNum\x2C\n          figureKey: hostileFigureKey\x2C\n          attackerPlayerNum: playerNum\x2C\n          source: 'Overrun'\x2C\n        });\n      }\n    }\n  }\n  // Cut and Run (Davith Elso): when exiting a space containing a hostile\x2C that hostile suffers 1 Damage (once/fig/round)\n  {\n    const _carEff = getDcEffects()?.[meta.dcName];\n    if ((_carEff?.specialAbilityIds || []).includes('cut_and_run_davith') && startCoord && newTopLeft !== startCoord) {\n      const hostilePlayerNum = opponentPlayerNum(playerNum);\n      const hostilePositions = game.figurePositions?.[hostilePlayerNum] || {};\n      const _movingSize = getFigureSize(meta.dcName);\n      const _oldFootprint = new Set(getNormalizedFootprint(startCoord\x2C _movingSize));\n      game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n      const hostileDcList = getDcList(game\x2C hostilePlayerNum) || [];\n      const hostileMsgIds = getDcMessageIds(game\x2C hostilePlayerNum) || [];\n      const _dcHs = ctx.dcHealthState;\n      for (const [hFk\x2C hPos] of Object.entries(hostilePositions)) {\n        if (!hPos) continue;\n        const _carKey = `cut_and_run_${hFk}`;\n        if (game.roundFigureAbilityUsed[_carKey]) continue;\n        const hMatch = hFk.match(/^(.+)-(\\d+)-(\\d+)$/);\n        if (!hMatch) continue;\n        const [\x2C hDcName\x2C hDgIdx\x2C hFigIdxStr] = hMatch;\n        const hSize = game.figureOrientations?.[hFk] || getFigureSize(hDcName);\n        const hFootprint = new Set(getNormalizedFootprint(hPos\x2C hSize));\n        const wasAdjacent = [..._oldFootprint].some(s => hFootprint.has(s));\n        if (!wasAdjacent) continue;\n        game.roundFigureAbilityUsed[_carKey] = true;\n        // Deal 1 damage to hostile\n        if (!_dcHs) continue;\n        let hMsgId = null;\n        for (const [mId\x2C mMeta] of dcMessageMeta) {\n          if (mMeta.gameId !== game.gameId || mMeta.playerNum !== hostilePlayerNum || mMeta.dcName !== hDcName) continue;\n          const dgM = (mMeta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/);\n          if (String(dgM ? dgM[1] : '1') === String(hDgIdx)) { hMsgId = mId; break; }\n        }\n        if (!hMsgId) continue;\n        const hFigIdx = parseInt(hFigIdxStr\x2C 10);\n        const hHealthState2 = _dcHs.get(hMsgId);\n        const hEntry2 = hHealthState2?.[hFigIdx];\n        if (!hEntry2 || !Array.isArray(hEntry2)) continue;\n        const [hCur2\x2C hMax2] = hEntry2;\n        const hCurHp2 = hCur2 ?? hMax2 ?? 0;\n        if (hMax2 === 0 || hCurHp2 <= 0) continue;\n        const { prevHp: hCur\x2C newHp: hNewHp } = reduceHp(_dcHs\x2C game\x2C hMsgId\x2C hFigIdx\x2C 1\x2C hostilePlayerNum);\n        const hDispName = dcMessageMeta.get(hMsgId)?.displayName || hDcName;\n        const defeatNote = hNewHp <= 0 ? ' **(defeated)**' : '';\n        await logGameAction(game\x2C client\x2C `\u2694\ufe0f **Cut and Run** \u2014 **${displayName}** exits **${hDispName}**'s space: 1 Damage${defeatNote} (HP: ${hCur}\u2192${hNewHp}).`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n        if (hNewHp <= 0 && processFigureDefeat) {\n          await processFigureDefeat(game\x2C {\n            defeatedPlayerNum: hostilePlayerNum\x2C\n            figureKey: hFk\x2C\n            attackerPlayerNum: playerNum\x2C\n            source: 'Cut and Run'\x2C\n          });\n        }\n      }\n    }\n  }\n  const newSize = targetInfo.size;\n  const storedSize = game.figureOrientations?.[figureKey] || getFigureSize(meta.dcName);\n  if (newSize !== storedSize) {\n    game.figureOrientations = game.figureOrientations || {};\n    game.figureOrientations[figureKey] = newSize;\n  }\n  const footprintSet = new Set(getNormalizedFootprint(newTopLeft\x2C newSize));\n  const updatedProfile = getMovementProfile(meta.dcName\x2C figureKey\x2C game);\n  // Interactive massive displacement: iterative engine resolves one figure at a time\x2C\n  // recalculating valid spaces after each displacement (board state changes).\n  // Rules: friendly first\x2C then enemy player pushes their own figures.\n  if (updatedProfile.canEndOnOccupied) {\n    const { initMassiveDisplacement\x2C resolveNextDisplacements } = await import('../game/movement.js');\n    const pending = initMassiveDisplacement(game\x2C playerNum\x2C figureKey\x2C footprintSet);\n    if (pending) {\n      // Resolve auto cases (0/1 valid space) iteratively until a choice is needed\n      const result = resolveNextDisplacements(game\x2C pending);\n      for (const r of result.autoResolved) {\n        const from = r.prevPos ? String(r.prevPos).toUpperCase() : '?';\n        const to = r.newPos ? String(r.newPos).toUpperCase() : '?';\n        const suffix = r.bfs ? ' (no adjacent spaces)' : '';\n        await logGameAction(game\x2C client\x2C `**${r.entry.dcName}** displaced **${from}** \u2192 **${to}** by massive figure${suffix}.`\x2C { icon: 'move'\x2C phase: 'ROUND' });\n      }\n      game.massiveMovementLocked = game.massiveMovementLocked || {};\n      game.massiveMovementLocked[figureKey] = true;\n      await logGameAction(game\x2C client\x2C `Massive figure displaced ${pending.totalDisplaced} figure(s). Movement locked for this phase.`\x2C { icon: 'move'\x2C phase: 'ROUND' });\n      if (!result.done) {\n        // Store pending state for interactive resolution\n        game.pendingMassivePush = { ...pending\x2C gameId: game.gameId };\n        await _dispatchNextMassivePush(game\x2C result\x2C interaction\x2C ctx);\n      }\n    }\n  }\n  // Massive figure that pushed someone: movement ends immediately (cannot continue moving)\n  const massivePushHappened = game.massiveMovementLocked?.[figureKey];\n  const newMp = massivePushHappened ? 0 : (mpRemaining - cost);\n  moveState.mpRemaining = newMp;\n  // Track visited coords for anti-oscillation: record the space we're leaving\n  if (moveState.startCoord) {\n    if (!moveState.visitedCoords) moveState.visitedCoords = [];\n    moveState.visitedCoords.push(String(moveState.startCoord).toLowerCase());\n  }\n  moveState.startCoord = targetInfo.topLeft;\n  moveState.boardState = null;\n  moveState.movementCache = null;\n  moveState.cacheMaxMp = 0;\n  if (game.movementBank?.[msgId]) {\n    game.movementBank[msgId].remaining = Math.max(0\x2C newMp);\n    await updateMovementBankMessage(game\x2C msgId\x2C client);\n  }\n  const destDisplay = bottomLeftCoord(newTopLeft\x2C newSize).toUpperCase();\n  const shortName = (displayName || meta.displayName || '').replace(/\\s*\\[(?:DG|Group) \\d+\\]$/\x2C '') || displayName;\n  const pLabel = `P${playerNum}`;\n  const ownerId = getPlayerId(game\x2C playerNum);\n  const path = getMovementPath(cache\x2C startCoord\x2C newTopLeft\x2C newSize\x2C profile);\n  const startDisplay = bottomLeftCoord(startCoord\x2C profile.size).toUpperCase();\n  const pathStr = path.length > 1\n    ? ` via ${path.map((c) => bottomLeftCoord(String(c)\x2C profile.size).toUpperCase()).join(' \u2192 ')}`\n    : '';\n  const moveLogMsg = await logGameAction(game\x2C client\x2C `<@${ownerId}> moved **${displayName}** from **${startDisplay}** \u2192 **${destDisplay}** (**${cost} MP**${pathStr})`\x2C { allowedMentions: { users: [ownerId] }\x2C phase: 'ROUND'\x2C icon: 'move' });\n  pushUndo(game\x2C {\n    type: 'move'\x2C\n    gameId: game.gameId\x2C\n    playerNum\x2C\n    figureKey\x2C\n    msgId\x2C\n    figureIndex\x2C\n    previousTopLeft: startCoord\x2C\n    previousSize: storedSize\x2C\n    mpRemainingBefore: mpRemaining\x2C\n    displayName: (displayName || meta.displayName || '').replace(/\\s*\\[(?:DG|Group) \\d+\\]$/\x2C '') || meta.dcName || figureKey\x2C\n    gameLogMessageId: moveLogMsg?.id\x2C\n  });\n  const terminalsAfter = mapId ? countTerminalsControlledByPlayer(game\x2C playerNum\x2C mapId) : 0;\n  if (terminalsAfter > terminalsBefore) {\n    await logGameAction(game\x2C client\x2C `**${pLabel}: ${shortName}** has taken control of a terminal!`\x2C { phase: 'ROUND'\x2C icon: 'deploy' });\n  }\n  if (newMp <= 0) {\n    // Delete all "Pick a destination" messages \u2014 grid messages already cleared above;\n    // now also delete the distance message itself so nothing lingers.\n    if (moveState.distanceMessageId) {\n      try {\n        const distMsg = await interaction.channel.messages.fetch(moveState.distanceMessageId);\n        await distMsg.delete();\n      } catch { /* already gone */ }\n    }\n    // Sweep thread for any leftover movement minimap messages (belt-and-suspenders cleanup)\n    const actionsMessageId = game.dcActionsData?.[msgId]?.messageId;\n    if (actionsMessageId && interaction.channel) {\n      try {\n        const msgs = await interaction.channel.messages.fetch({ limit: 30 });\n        for (const [mId\x2C m] of msgs) {\n          if (mId === actionsMessageId) continue; // never delete the DC actions message\n          if (m.author?.id !== client?.user?.id) continue; // only our own messages\n          const hasMoveMinimap = m.attachments?.some(a => a.name === 'move-destinations.png');\n          if (hasMoveMinimap) {\n            try { await m.delete(); } catch { /* already gone */ }\n          }\n        }\n      } catch { /* ignore fetch errors */ }\n    }\n    const wasPostDeploy = moveState.postDeployReturn;\n    _cleanupMoveState(game\x2C moveKey\x2C msgId);\n    // Post-deploy movement: advance the post-deploy queue\n    if (wasPostDeploy && game.postDeployQueue) {\n      const { onPostDeployMovementComplete } = await import('./post-deploy.js');\n      await onPostDeployMovementComplete(game\x2C meta.gameId\x2C client\x2C ctx\x2C figureKey);\n    }\n  } else {\n    const nextBoard = getBoardStateForMovement(game\x2C figureKey);\n    if (nextBoard && computeMovementCache) {