code-creation,Script,9,297798,0x3f05b92a0ec8,62, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/discord/embeds.js:1:1,0x63270037ae0,~
script-source,252,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/discord/embeds.js,import { EmbedBuilder } from 'discord.js';\nimport { getPlayerId\x2C getCcDeck\x2C getDcList\x2C getSquad\x2C getInitiativePlayerNum } from '../game/player-helpers.js';\nimport { enforceContentLimit\x2C DISCORD_EMBED_FIELD_LIMIT } from './limits.js';\nimport { COLORS } from './colors.js';\n\n/**\n * Initiative zone label for scorecard (e.g. "[RED] P1 has the initiative!").\n * @param {object} game\n * @returns {string}\n */\nexport function getInitiativePlayerZoneLabel(game) {\n  if (!game?.initiativeDetermined || !game?.deploymentZoneChosen) return '';\n  const playerId = game.initiativePlayerId;\n  let zone = '';\n  if (playerId === game.player1Id || playerId === game.player2Id) {\n    zone = (playerId === game.initiativePlayerId) ? game.deploymentZoneChosen : (game.deploymentZoneChosen === 'red' ? 'blue' : 'red');\n  }\n  return zone ? `[${zone.toUpperCase()}] ` : '';\n}\n\n/**\n * Build Scorecard embed with VP breakdown per player. Initiative shown via bullet row (no token image).\n * @param {object} game\n * @param {{ p1: number\x2C p2: number }} [missionBonus] - Optional mission-specific VP bonus (crate deployment\x2C patron tokens\x2C etc.)\n */\nexport function buildScorecardEmbed(game\x2C missionBonus) {\n  const vp1 = game.player1VP || { total: 0\x2C kills: 0\x2C objectives: 0 };\n  const vp2 = game.player2VP || { total: 0\x2C kills: 0\x2C objectives: 0 };\n  const bonus1 = missionBonus?.p1 || 0;\n  const bonus2 = missionBonus?.p2 || 0;\n  const total1 = vp1.total + bonus1;\n  const total2 = vp2.total + bonus2;\n  const p1HasInitiative = game.initiativeDetermined && getInitiativePlayerNum(game) === 1;\n\n  // Single-line-per-stat layout: works on both desktop and mobile (no inline columns)\n  const totalLabel = (bonus1 || bonus2)\n    ? `**P1:** ${total1} (${vp1.total}+${bonus1}) \\u2003 **P2:** ${total2} (${vp2.total}+${bonus2})`\n    : `**P1:** ${total1} \\u2003 **P2:** ${total2}`;\n  const roundLabel = game.currentRound ? `Round ${game.currentRound}` : '';\n  const fields = [\n    { name: 'Players'\x2C value: `**P1:** <@${game.player1Id}>\\n**P2:** <@${game.player2Id}>`\x2C inline: false }\x2C\n    { name: 'Total VP'\x2C value: totalLabel\x2C inline: false }\x2C\n    { name: 'Kill VP'\x2C value: `**P1:** ${vp1.kills} \\u2003 **P2:** ${vp2.kills}`\x2C inline: false }\x2C\n    { name: 'Objective VP'\x2C value: `**P1:** ${vp1.objectives} \\u2003 **P2:** ${vp2.objectives}`\x2C inline: false }\x2C\n  ];\n  if (roundLabel) fields.push({ name: 'Round'\x2C value: roundLabel\x2C inline: false });\n  if (game.initiativeDetermined) {\n    const zoneLabel = getInitiativePlayerZoneLabel(game);\n    const initiativeValue = p1HasInitiative\n      ? `\u25cf ${zoneLabel}P1 <@${game.player1Id}> has the initiative!`\n      : `\u25cf ${zoneLabel}P2 <@${game.player2Id}> has the initiative!`;\n    fields.push({ name: 'Initiative'\x2C value: initiativeValue\x2C inline: false });\n  }\n\n  return new EmbedBuilder().setTitle('Scorecard').setColor(COLORS.DARK_EMBED).addFields(fields);\n}\n\n/**\n * Format health block for DC embed (single or multi-figure).\n * @param {number} dgIndex - Deployment group index (e.g. 1)\n * @param {[number\x2C number][]} healthState - Per-figure [cur\x2C max]\n * @param {string[][]} [conditionsByFigure] - Optional per-figure condition names (e.g. [['Stun']\x2C ['Weaken']])\n * @param {string[][]} [tokensByFigure] - Optional per-figure power token names (e.g. [['Damage'\x2C 'Block']])\n */\nexport function formatHealthSection(dgIndex\x2C healthState\x2C conditionsByFigure\x2C tokensByFigure\x2C nicknamesByFigure) {\n  if (!healthState?.length) return 'Health\\n\u2014/\u2014';\n  const labels = 'abcdefghij';\n  const lines = healthState.map(([cur\x2C max]\x2C i) => {\n    const c = cur != null ? cur : (max != null ? max : '?');\n    const m = max != null ? max : '?';\n    if (healthState.length === 1) {\n      const nick = nicknamesByFigure?.[i];\n      return nick ? `${nick}: ${c}/${m}` : `${c}/${m}`;\n    }\n    const figLabel = `${dgIndex}${labels[i]}`;\n    const nick = nicknamesByFigure?.[i];\n    return nick ? `${nick} (${figLabel}): ${c}/${m}` : `${figLabel}: ${c}/${m}`;\n  });\n  let out = `Health\\n${lines.join('\\n')}`;\n  if (conditionsByFigure?.length) {\n    const condLines = conditionsByFigure\n      .map((list\x2C i) => {\n        if (!list?.length) return null;\n        const label = healthState.length === 1 ? 'Conditions' : `Conditions (${dgIndex}${labels[i]})`;\n        return `${label}: ${list.join('\x2C ')}`;\n      })\n      .filter(Boolean);\n    if (condLines.length) out += '\\n\\n' + condLines.join('\\n');\n  }\n  if (tokensByFigure?.length) {\n    const tokenLines = tokensByFigure\n      .map((tokens\x2C i) => {\n        if (!tokens?.length) return null;\n        const label = healthState.length === 1 ? 'Tokens' : `Tokens (${dgIndex}${labels[i]})`;\n        return `${label}: ${tokens.join('\x2C ')}`;\n      })\n      .filter(Boolean);\n    if (tokenLines.length) out += '\\n' + tokenLines.join('\\n');\n  }\n  return enforceContentLimit(out\x2C DISCORD_EMBED_FIELD_LIMIT);\n}\n\n/** Card-back character for hand/discard visual. */\nexport const CARD_BACK_CHAR = '\u25ae';\n\n/** Tooltip embed at top of Play Area: player\x2C CC count\x2C DC list. */\nexport function getPlayAreaTooltipEmbed(game\x2C playerNum) {\n  const playerId = getPlayerId(game\x2C playerNum);\n  const deckCount = (getCcDeck(game\x2C playerNum) || []).length;\n  const dcList = getDcList(game\x2C playerNum) || getSquad(game\x2C playerNum)?.dcList || [];\n  const dcNames = Array.isArray(dcList) ? dcList.map((d) => (typeof d === 'object' ? d.dcName || d.displayName : d)).filter(Boolean) : [];\n  const dcText = dcNames.length > 0 ? dcNames.join('\x2C ') : '\u2014';\n  return new EmbedBuilder()\n    .setTitle(`This is Player ${playerNum}'s Play Area`)\n    .setDescription(\n      `**Player:** <@${playerId}>\\n` +\n      `**Command Cards in Deck:** ${deckCount}\\n` +\n      `**Deployment Cards:** ${dcText}`\n    )\n    .setColor(COLORS.BLURPLE);\n}\n\n/** Tooltip embed for Hand thread. */\nexport function getHandTooltipEmbed(game\x2C playerNum\x2C squad) {\n  if (squad) {\n    return new EmbedBuilder()\n      .setTitle('Your Hand')\n      .setDescription(\n        `**Squad:** ${squad.name || 'Unnamed'}\\n` +\n        `**Deployment Cards:** ${squad.dcCount ?? '\u2014'}\\n` +\n        `**Command Cards:** ${squad.ccCount ?? '\u2014'}\\n\\n\u2713 Squad submitted.`\n      )\n      .setColor(COLORS.GREEN);\n  }\n  return new EmbedBuilder()\n    .setTitle('Submit Your Squad')\n    .setDescription(\n      'This is your private hand thread. Submit your squad using **one** of these methods:\\n\\n' +\n      '**OPTION 1 \u2014 Paste your list**\\n' +\n      'Copy your army list from the IACP Skirmish Builder and paste it as a message right here.\\n\\n' +\n      '**OPTION 2 \u2014 Upload a .vsav file**\\n' +\n      'Drag and drop your VASSAL save file (.vsav) into this thread.\\n\\n' +\n      '```\\n' +\n      '            PASTE or UPLOAD below\\n' +\n      '                    |\\n' +\n      '                    |\\n' +\n      '                    V\\n' +\n      '```'\n    )\n    .setColor(COLORS.BLURPLE);\n}\n\n/** Embed showing command cards in hand as card backs. */\nexport function getHandVisualEmbed(handCount) {\n  const count = Math.max(0\x2C handCount ?? 0);\n  const cards = CARD_BACK_CHAR.repeat(count) || '\u2014';\n  return new EmbedBuilder()\n    .setTitle('Command Cards in Hand')\n    .setDescription(`**${count}** cards\\n${cards}`)\n    .setColor(COLORS.DARK_EMBED);\n}\n\n/** Embed showing discard pile count. */\nexport function getDiscardPileEmbed(discardCount) {\n  const count = Math.max(0\x2C discardCount ?? 0);\n  const cards = CARD_BACK_CHAR.repeat(count) || '\u2014';\n  return new EmbedBuilder()\n    .setTitle('Command Cards in Discard Pile')\n    .setDescription(`**${count}** cards\\n${cards}`)\n    .setColor(COLORS.DARK_EMBED);\n}\n\n/** Roster text for lobby (Player 1 / Player 2). */\nexport function getLobbyRosterText(lobby) {\n  const p1 = `1. **Player 1:** <@${lobby.creatorId}>`;\n  const p2 = lobby.joinedId\n    ? `2. **Player 2:** <@${lobby.joinedId}>`\n    : `2. **Player 2:** *(not yet joined)*`;\n  return `${p1}\\n${p2}`;\n}\n\n/** Game Lobby embed. */\nexport function getLobbyEmbed(lobby) {\n  const roster = getLobbyRosterText(lobby);\n  const isReady = !!lobby.joinedId;\n  return new EmbedBuilder()\n    .setTitle('Game Lobby')\n    .setDescription(`${roster}\\n\\n${isReady ? 'Both players ready! Click **Start Game** to begin.' : 'Click **Join Game** to play!'}`)\n    .setColor(COLORS.DARK_EMBED);\n}\n\n/** Tooltip embed explaining the 4 map selection methods. */\nexport function getMapSelectionTooltipEmbed() {\n  return new EmbedBuilder()\n    .setTitle('Map Selection Methods')\n    .setDescription(\n      '**Competitive** \u2014 Random map from the current tournament rotation\\n' +\n      '**Random** \u2014 Random map from all available maps\\n' +\n      '**Select Draw** \u2014 Pick 2+ maps; one is chosen at random\\n' +\n      '**Selection** \u2014 Pick the exact map you want to play'\n    )\n    .setColor(COLORS.DARK_EMBED);\n}\n\n/** Display names for deploy list: duplicate DCs get [Group 1]\x2C [Group 2]\x2C etc. */\nexport function getDeployDisplayNames(dcList) {\n  if (!dcList?.length) return [];\n  const totals = {};\n  const counts = {};\n  for (const d of dcList) totals[d] = (totals[d] || 0) + 1;\n  return dcList.map((dcName) => {\n    counts[dcName] = (counts[dcName] || 0) + 1;\n    const dgIndex = counts[dcName];\n    return totals[dcName] > 1 ? `${dcName} [Group ${dgIndex}]` : dcName;\n  });\n}\n\n/** Max embeds per Discord message (chunking). */\nexport const EMBEDS_PER_MESSAGE = 10;\n
