code-creation,Script,9,307408,0x3f05b92a1908,52, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/engine/dc-ui-helpers.js:1:1,0x33c46858a300,~
script-source,259,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/engine/dc-ui-helpers.js,/**\n * DC UI helper functions extracted from index.js.\n * Build Discord embed data for deployment cards.\n */\n\nexport function getDcUpgradeAttachments(game\x2C msgId) {\n  if (!game || !msgId) return [];\n  return (game.p1DcAttachments?.[msgId] || game.p2DcAttachments?.[msgId] || []);\n}\n\nexport function getConditionsForDcMessage(game\x2C meta\x2C deps) {\n  if (!game?.figureConditions || !meta?.dcName) return undefined;\n  const stats = deps.getDcStats(meta.dcName);\n  const figures = stats.figures ?? 1;\n  const dgMatch = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/);\n  const dgIndex = dgMatch ? dgMatch[1] : '1';\n  const out = [];\n  let hasAny = false;\n  for (let i = 0; i < figures; i++) {\n    const fk = `${meta.dcName}-${dgIndex}-${i}`;\n    const list = game.figureConditions[fk] || [];\n    out.push(Array.isArray(list) ? list : [list]);\n    if (out[out.length - 1].length) hasAny = true;\n  }\n  return hasAny ? out : undefined;\n}\n\nexport function getTokensForDcMessage(game\x2C meta\x2C deps) {\n  if (!game?.figurePowerTokens || !meta?.dcName) return undefined;\n  const stats = deps.getDcStats(meta.dcName);\n  const figures = stats.figures ?? 1;\n  const dgMatch = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/);\n  const dgIndex = dgMatch ? dgMatch[1] : '1';\n  const out = [];\n  let hasAny = false;\n  for (let i = 0; i < figures; i++) {\n    const fk = `${meta.dcName}-${dgIndex}-${i}`;\n    const list = game.figurePowerTokens[fk] || [];\n    out.push(Array.isArray(list) ? [...list] : []);\n    if (out[out.length - 1].length) hasAny = true;\n  }\n  return hasAny ? out : undefined;\n}\n\nexport function getNicknamesForDcMessage(game\x2C meta\x2C deps) {\n  if (!game?.figureNicknames || !meta?.dcName) return undefined;\n  const stats = deps.getDcStats(meta.dcName);\n  const figures = stats.figures ?? 1;\n  if (figures <= 1) return undefined;\n  const dgMatch = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/);\n  const dgIndex = dgMatch ? dgMatch[1] : '1';\n  const out = [];\n  let hasAny = false;\n  for (let i = 0; i < figures; i++) {\n    const fk = `${meta.dcName}-${dgIndex}-${i}`;\n    const nick = game.figureNicknames[fk] || null;\n    out.push(nick);\n    if (nick) hasAny = true;\n  }\n  return hasAny ? out : undefined;\n}\n\n/**\n * Canonical DC display-state builder.\n * Assembles the complete argument set for buildDcEmbedAndFiles from game state.\n * deps must include: dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState\x2C getDcStats.\n */\nexport function buildDcDisplayState(game\x2C msgId\x2C deps) {\n  const meta = deps.dcMessageMeta.get(msgId);\n  if (!meta) return null;\n  return {\n    dcName:             meta.dcName\x2C\n    exhausted:          deps.dcExhaustedState?.get(msgId) ?? false\x2C\n    displayName:        meta.displayName\x2C\n    healthState:        deps.dcHealthState?.get(msgId) ?? [[null\x2C null]]\x2C\n    conditionsByFigure: getConditionsForDcMessage(game\x2C meta\x2C deps)\x2C\n    dcAttachments:      getDcUpgradeAttachments(game\x2C msgId)\x2C\n    tokensByFigure:     getTokensForDcMessage(game\x2C meta\x2C deps)\x2C\n    actionsData:        game.dcActionsData?.[msgId] ?? null\x2C\n    nicknamesByFigure:  getNicknamesForDcMessage(game\x2C meta\x2C deps)\x2C\n    options:            { game\x2C playerNum: meta.playerNum }\x2C\n  };\n}\n\n/**\n * Convenience wrapper: builds canonical display state\x2C applies overrides\x2C renders.\n * deps must also include buildDcEmbedAndFiles.\n */\nexport async function renderDcEmbed(game\x2C msgId\x2C deps\x2C overrides = {}) {\n  const ds = { ...buildDcDisplayState(game\x2C msgId\x2C deps)\x2C ...overrides };\n  return deps.buildDcEmbedAndFiles(\n    ds.dcName\x2C ds.exhausted\x2C ds.displayName\x2C ds.healthState\x2C\n    ds.conditionsByFigure\x2C ds.dcAttachments\x2C ds.tokensByFigure\x2C\n    ds.actionsData\x2C ds.nicknamesByFigure\x2C ds.options\x2C\n  );\n}\n
