allback();\n      });\n      ws.close();\n    }\n  };\n\n  duplex._read = function () {\n    if (ws.isPaused) ws.resume();\n  };\n\n  duplex._write = function (chunk\x2C encoding\x2C callback) {\n    if (ws.readyState === ws.CONNECTING) {\n      ws.once('open'\x2C function open() {\n        duplex._write(chunk\x2C encoding\x2C callback);\n      });\n      return;\n    }\n\n    ws.send(chunk\x2C callback);\n  };\n\n  duplex.on('end'\x2C duplexOnEnd);\n  duplex.on('error'\x2C duplexOnError);\n  return duplex;\n}\n\nmodule.exports = createWebSocketStream;\n
