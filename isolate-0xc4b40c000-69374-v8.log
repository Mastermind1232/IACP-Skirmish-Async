tick,0x183a9c91c,172411,0,0x0,0,0x128adec4c,0x128adee3c,0x128adf774,0x128adffe8,0x128ad7d54,0x128ad81f4,0x128ad84e0,0x128ad866c,0x128ad9e38,0x128ae4124,0x128ae3238,0x128ae37a0,0x128ae29b4,0x128ae4f30,0x128ae53d8,0x128ae44ac,0x128ae3238,0x128ae37a0,0x128ae29b4,0x128ae4f30,0x128ae53d8,0x128ae44ac,0x128ae3238,0x128ae37a0,0x128ae29b4,0x128ae4f30,0x128ae53d8,0x128ae44ac,0x128ae3238,0x128ae37a0,0x128ae29b4,0x128ae4f30,0x128ae53d8,0x128ae44ac,0x128ae3238,0x128ae37a0,0x128ae29b4,0x128ae4f30,0x128ae53d8,0x128ae44ac,0x128ae3238,0x128ae37a0,0x128ae29b4,0x7c98725b85c,0x7c98725b635,0x7c9872569a9,0x7c987256643,0x7c9872530c4,0x7c98725ba3d,0x7c98725b85c,0x7c98725b635,0x7c9872569a9,0x7c987256643,0x7c9872530c4,0x7c98725ba3d,0x7c98725b85c,0x7c98725b635,0x7c9872569a9,0x7c987256643,0x7c9872530c4,0x7c98725ba3d,0x7c98725b85c,0x7c98725b635,0x7c9872569a9,0x7c987256643,0x7c9872530c4,0x7c98725ba3d,0x7c98725b85c,0x7c98725b635,0x7c9872569a9,0x7c987256643,0x7c9872530c4,0x7c987252e14,0x7c987252ab2,0x7c9872528ff,0x7c9872527a0,0x7c987251931,0x7c987251743,0x7c98724efb7,0x7c987249608
code-creation,Script,9,172460,0x3f05b9283dd0,58, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/vp-helpers.js:1:1,0x3c1234e9eac0,~
script-source,169,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/vp-helpers.js,/**\n * Pure VP mutation helpers. No Discord dependency.\n */\n\n/**\n * Ensure the VP object exists for the given player number.\n * @param {object} game\n * @param {number} playerNum - 1 or 2\n * @returns {{ total: number\x2C kills: number\x2C objectives: number }}\n */\nfunction ensureVp(game\x2C playerNum) {\n  const key = playerNum === 1 ? 'player1VP' : 'player2VP';\n  game[key] = game[key] || { total: 0\x2C kills: 0\x2C objectives: 0 };\n  return game[key];\n}\n\n/**\n * Award VP for a kill (figure defeated). Increments kills + total.\n * @param {object} game\n * @param {number} playerNum - player who earns the VP\n * @param {number} amount - VP to award (positive)\n */\nexport function awardKillVp(game\x2C playerNum\x2C amount) {\n  const vp = ensureVp(game\x2C playerNum);\n  vp.kills += amount;\n  vp.total += amount;\n}\n\n/**\n * Award VP for an objective (mission reward\x2C surge ability\x2C etc.). Increments objectives + total.\n * @param {object} game\n * @param {number} playerNum - player who earns the VP\n * @param {number} amount - VP to award (positive)\n */\nexport function awardObjectiveVp(game\x2C playerNum\x2C amount) {\n  const vp = ensureVp(game\x2C playerNum);\n  vp.objectives += amount;\n  vp.total += amount;\n}\n\n/**\n * Nefarious Gains (Jabba the Hutt): when any hostile figure is defeated\x2C\n * check if Jabba is alive on the opposing team and award 1 objective VP.\n * Pure data mutation \u2014 no Discord dependency.\n * @param {object} game\n * @param {number} defeatedOwnerPN - playerNum who owned the defeated figure\n * @returns {{ jabbaOwnerPN: number\x2C vpTotal: number } | null} - info for logging\x2C or null if Jabba not found\n */\nexport function checkNefariousGains(game\x2C defeatedOwnerPN) {\n  const jabbaOwnerPN = defeatedOwnerPN === 1 ? 2 : 1;\n  const jabbaAlive = Object.keys(game.figurePositions?.[jabbaOwnerPN] || {}).some(fk => fk.startsWith('Jabba the Hutt-'));\n  if (!jabbaAlive) return null;\n  awardObjectiveVp(game\x2C jabbaOwnerPN\x2C 1);\n  const vpKey = jabbaOwnerPN === 1 ? 'player1VP' : 'player2VP';\n  return { jabbaOwnerPN\x2C vpTotal: game[vpKey]?.total ?? 0 };\n}\n\n/**\n * Deduct VP (clamped to 0). Deducts from objectives first\x2C then kills.\n * @param {object} game\n * @param {number} playerNum\n * @param {number} amount - VP to deduct (positive)\n */\nexport function deductVp(game\x2C playerNum\x2C amount) {\n  const vp = ensureVp(game\x2C playerNum);\n  let remaining = amount;\n  // Deduct from objectives first\n  const objDeduct = Math.min(vp.objectives || 0\x2C remaining);\n  vp.objectives = (vp.objectives || 0) - objDeduct;\n  remaining -= objDeduct;\n  // Then from kills\n  if (remaining > 0) {\n    vp.kills = Math.max(0\x2C (vp.kills || 0) - remaining);\n  }\n  vp.total = Math.max(0\x2C vp.total - amount);\n}\n
