script-source,658,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/discord.js/src/sharding/ShardClientUtil.js,'use strict';\n\nconst process = require('node:process');\nconst { calculateShardId } = require('@discordjs/util');\nconst { DiscordjsError\x2C DiscordjsTypeError\x2C ErrorCodes } = require('../errors');\nconst Events = require('../util/Events');\nconst { makeError\x2C makePlainError } = require('../util/Util');\n\n/**\n * Helper class for sharded clients spawned as a child process/worker\x2C such as from a {@link ShardingManager}.\n * Utilizes IPC to send and receive data to/from the master process and other shards.\n */\nclass ShardClientUtil {\n  constructor(client\x2C mode) {\n    /**\n     * Client for the shard\n     * @type {Client}\n     */\n    this.client = client;\n\n    /**\n     * Mode the shard was spawned with\n     * @type {ShardingManagerMode}\n     */\n    this.mode = mode;\n\n    /**\n     * Message port for the master process (only when {@link ShardClientUtil#mode} is `worker`)\n     * @type {?MessagePort}\n     */\n    this.parentPort = null;\n\n    switch (mode) {\n      case 'process':\n        process.on('message'\x2C this._handleMessage.bind(this));\n        client.on(Events.ShardReady\x2C () => {\n          process.send({ _ready: true });\n        });\n        client.on(Events.ShardDisconnect\x2C () => {\n          process.send({ _disconnect: true });\n        });\n        client.on(Events.ShardReconnecting\x2C () => {\n          process.send({ _reconnecting: true });\n        });\n        client.on(Events.ShardResume\x2C () => {\n          process.send({ _resume: true });\n        });\n        break;\n      case 'worker':\n        this.parentPort = require('node:worker_threads').parentPort;\n        this.parentPort.on('message'\x2C this._handleMessage.bind(this));\n        client.on(Events.ShardReady\x2C () => {\n          this.parentPort.postMessage({ _ready: true });\n        });\n        client.on(Events.ShardDisconnect\x2C () => {\n          this.parentPort.postMessage({ _disconnect: true });\n        });\n        client.on(Events.ShardReconnecting\x2C () => {\n          this.parentPort.postMessage({ _reconnecting: true });\n        });\n        client.on(Events.ShardResume\x2C () => {\n          this.parentPort.postMessage({ _resume: true });\n        });\n        break;\n    }\n  }\n\n  /**\n   * Array of shard ids of this client\n   * @type {number[]}\n   * @readonly\n   */\n  get ids() {\n    return this.client.options.shards;\n  }\n\n  /**\n   * Total number of shards\n   * @type {number}\n   * @readonly\n   */\n  get count() {\n    return this.client.options.shardCount;\n  }\n\n  /**\n   * Sends a message to the master process.\n   * @param {*} message Message to send\n   * @returns {Promise<void>}\n   * @emits Shard#message\n   */\n  send(message) {\n    return new Promise((resolve\x2C reject) => {\n      switch (this.mode) {\n        case 'process':\n          process.send(message\x2C err => {\n            if (err) reject(err);\n            else resolve();\n          });\n          break;\n        case 'worker':\n          this.parentPort.postMessage(message);\n          resolve();\n          break;\n      }\n    });\n  }\n\n  /**\n   * Fetches a client property value of each shard\x2C or a given shard.\n   * @param {string} prop Name of the client property to get\x2C using periods for nesting\n   * @param {number} [shard] Shard to fetch property from\x2C all if undefined\n   * @returns {Promise<*|Array<*>>}\n   * @example\n   * client.shard.fetchClientValues('guilds.cache.size')\n   *   .then(results => console.log(`${results.reduce((prev\x2C val) => prev + val\x2C 0)} total guilds`))\n   *   .catch(console.error);\n   * @see {@link ShardingManager#fetchClientValues}\n   */\n  fetchClientValues(prop\x2C shard) {\n    return new Promise((resolve\x2C reject) => {\n      const parent = this.parentPort ?? process;\n\n      const listener = message => {\n        if (message?._sFetchProp !== prop || message._sFetchPropShard !== shard) return;\n        parent.removeListener('message'\x2C listener);\n        this.decrementMaxListeners(parent);\n        if (!message._error) resolve(message._result);\n        else reject(makeError(message._error));\n      };\n      this.incrementMaxListeners(parent);\n      parent.on('message'\x2C listener);\n\n      this.send({ _sFetchProp: prop\x2C _sFetchPropShard: shard }).catch(err => {\n        parent.removeListener('message'\x2C listener);\n        this.decrementMaxListeners(parent);\n        reject(err);\n      });\n    });\n  }\n\n  /**\n   * Evaluates a script or function on all shards\x2C or a given shard\x2C in the context of the {@link Client}s.\n   * @param {Function} script JavaScript to run on each shard\n   * @param {BroadcastEvalOptions} [options={}] The options for the broadcast\n   * @returns {Promise<*|Array<*>>} Results of the script execution\n   * @example\n   * client.shard.broadcastEval(client => client.guilds.cache.size)\n   *   .then(results => console.log(`${results.reduce((prev\x2C val) => prev + val\x2C 0)} total guilds`))\n   *   .catch(console.error);\n   * @see {@link ShardingManager#broadcastEval}\n   */\n  broadcastEval(script\x2C options = {}) {\n    return new Promise((resolve\x2C reject) => {\n      const parent = this.parentPort ?? process;\n      if (typeof script !== 'function') {\n        reject(new DiscordjsTypeError(ErrorCodes.ShardingInvalidEvalBroadcast));\n        return;\n      }\n      script = `(${script})(this\x2C ${JSON.stringify(options.context)})`;\n\n      const listener = message => {\n        if (message?._sEval !== script || message._sEvalShard !== options.shard) return;\n        parent.removeListener('message'\x2C listener);\n        this.decrementMaxListeners(parent);\n        if (!message._error) resolve(message._result);\n        else reject(makeError(message._error));\n      };\n      this.incrementMaxListeners(parent);\n      parent.on('message'\x2C listener);\n      this.send({ _sEval: script\x2C _sEvalShard: options.shard }).catch(err => {\n        parent.removeListener('message'\x2C listener);\n        this.decrementMaxListeners(parent);\n        reject(err);\n      });\n    });\n  }\n\n  /**\n   * Requests a respawn of all shards.\n   * @param {MultipleShardRespawnOptions} [options] Options for respawning shards\n   * @returns {Promise<void>} Resolves upon the message being sent\n   * @see {@link ShardingManager#respawnAll}\n   */\n  respawnAll({ shardDelay = 5_000\x2C respawnDelay = 500\x2C timeout = 30_000 } = {}) {\n    return this.send({ _sRespawnAll: { shardDelay\x2C respawnDelay\x2C timeout } });\n  }\n\n  /**\n   * Handles an IPC message.\n   * @param {*} message Message received\n   * @private\n   */\n  async _handleMessage(message) {\n    if (!message) return;\n    if (message._fetchProp) {\n      try {\n        const props = message._fetchProp.split('.');\n        let value = this.client;\n        for (const prop of props) value = value[prop];\n        this._respond('fetchProp'\x2C { _fetchProp: message._fetchProp\x2C _result: value });\n      } catch (err) {\n        this._respond('fetchProp'\x2C { _fetchProp: message._fetchProp\x2C _error: makePlainError(err) });\n      }\n    } else if (message._eval) {\n      try {\n        this._respond('eval'\x2C { _eval: message._eval\x2C _result: await this.client._eval(message._eval) });\n      } catch (err) {\n        this._respond('eval'\x2C { _eval: message._eval\x2C _error: makePlainError(err) });\n      }\n    }\n  }\n\n  /**\n   * Sends a message to the master process\x2C emitting an error from the client upon failure.\n   * @param {string} type Type of response to send\n   * @param {*} message Message to send\n   * @private\n   */\n  _respond(type\x2C message) {\n    this.send(message).catch(err => {\n      const error = new Error(`Error when sending ${type} response to master process: ${err.message}`);\n      error.stack = err.stack;\n      /**\n       * Emitted when the client encounters an error.\n       * <warn>Errors thrown within this event do not have a catch handler\x2C it is\n       * recommended to not use async functions as `error` event handlers. See the\n       * {@link https://nodejs.org/api/events.html#capture-rejections-of-promises Node.js documentation}\n       * for details.)</warn>\n       * @event Client#error\n       * @param {Error} error The error encountered\n       */\n      this.client.emit(Events.Error\x2C error);\n    });\n  }\n\n  /**\n   * Creates/gets the singleton of this class.\n   * @param {Client} client The client to use\n   * @param {ShardingManagerMode} mode Mode the shard was spawned with\n   * @returns {ShardClientUtil}\n   */\n  static singleton(client\x2C mode) {\n    if (!this._singleton) {\n      this._singleton = new this(client\x2C mode);\n    } else {\n      client.emit(\n        Events.Warn\x2C\n        'Multiple clients created in child process/worker; only the first will handle sharding helpers.'\x2C\n      );\n    }\n    return this._singleton;\n  }\n\n  /**\n   * Get the shard id for a given guild id.\n   * @param {Snowflake} guildId Snowflake guild id to get shard id for\n   * @param {number} shardCount Number of shards\n   * @returns {number}\n   */\n  static shardIdForGuildId(guildId\x2C shardCount) {\n    const shard = calculateShardId(guildId\x2C shardCount);\n    if (shard < 0) throw new DiscordjsError(ErrorCodes.ShardingShardMiscalculation\x2C shard\x2C guildId\x2C shardCount);\n    return shard;\n  }\n\n  /**\n   * Increments max listeners by one for a given emitter\x2C if they are not zero.\n   * @param {EventEmitter|process} emitter The emitter that emits the events.\n   * @private\n   */\n  incrementMaxListeners(emitter) {\n    const maxListeners = emitter.getMaxListeners();\n    if (maxListeners !== 0) {\n      emitter.setMaxListeners(maxListeners + 1);\n    }\n  }\n\n  /**\n   * Decrements max listeners by one for a given emitter\x2C if they are not zero.\n   * @param {EventEmitter|process} emitter The emitter that emits the events.\n   * @private\n   */\n  decrementMaxListeners(emitter) {\n    const maxListeners = emitter.getMaxListeners();\n    if (maxListeners !== 0) {\n      emitter.setMaxListeners(maxListeners - 1);\n    }\n  }\n}\n\nmodule.exports = ShardClientUtil;\n
