code-creation,Script,9,280033,0x3f05b9295378,52, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/map-events.js:1:1,0x3dc363b88f90,~
script-source,225,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/map-events.js,/**\n * Map event handlers: devaron_door_open_\x2C devaron_crate_push_\x2C krykna_push_\x2C krykna_place_\x2C krykna_place_skip_\x2C krykna_place_pick_\x2C fluctuation_swap_\x2C fluctuation_skip_\n */\nimport { ModalBuilder\x2C ActionRowBuilder\x2C TextInputBuilder\x2C TextInputStyle\x2C ButtonStyle } from 'discord.js';\nimport { getPlayerId\x2C getInitiativePlayerNum\x2C opponentPlayerNum } from '../game/player-helpers.js';\nimport { edgeKey\x2C normalizeCoord } from '../game/coords.js';\nimport { discordCatch } from '../error-handling.js';\nimport { requireGame\x2C requirePlayer } from '../utils/guards.js';\nimport { fetchGameChannel } from '../discord/channel-helpers.js';\nimport { parseCustomId } from '../discord/custom-id.js';\nimport { buildRowPickerButtons\x2C cleanupSpacePick } from '../discord/components.js';\nimport { getValidKryknaPlacementSpaces } from '../game/mission-rules.js';\nimport { continueAfterFluctuationSwap } from './round.js';\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C logGameAction\x2C getMapTokensData\x2C postDevaronDoorButtons\x2C postDevaronCratePushPrompts\n */\nexport async function handleDevaronDoorOpen(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C client\x2C logGameAction\x2C getMapTokensData\x2C postDevaronDoorButtons\x2C postDevaronCratePushPrompts } = ctx;\n    // customId: devaron_door_open_{gameId}_{a}|{b}\n    const rest = parseCustomId(interaction.customId\x2C 'devaron_door_open_');\n    const pipeIdx = rest.indexOf('|');\n    if (pipeIdx < 0) return;\n    const beforePipe = rest.substring(0\x2C pipeIdx);\n    const afterPipe = rest.substring(pipeIdx + 1);\n    const lastUnderscore = beforePipe.lastIndexOf('_');\n    const gameId = beforePipe.substring(0\x2C lastUnderscore);\n    const edgeA = beforePipe.substring(lastUnderscore + 1);\n    const openedEdgeKey = edgeKey(edgeA\x2C afterPipe);\n    const game = await requireGame(interaction\x2C getGame\x2C gameId);\n    if (!game) return;\n    const pending = game.pendingDoorSelections?.[0];\n    if (!pending) { await interaction.followUp({ content: 'No pending door selections.'\x2C ephemeral: true }).catch(discordCatch); return; }\n    if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pending.playerNum\x2C canActAsPlayer\x2C 'Only the controlling player can select a door.')) return;\n    await interaction.deferUpdate().catch(discordCatch);\n    game.openedDoors = game.openedDoors || [];\n    if (!game.openedDoors.includes(openedEdgeKey)) game.openedDoors.push(openedEdgeKey);\n    const pid = getPlayerId(game\x2C pending.playerNum);\n    await logGameAction(game\x2C client\x2C `\ud83d\udeaa <@${pid}> opened door **${edgeA.toUpperCase()}\u2194${afterPipe.toUpperCase()}** (Crate Rush \u2014 terminal effect).`\x2C { allowedMentions: { users: [pid] }\x2C phase: 'ROUND'\x2C icon: 'round' });\n    pending.doorsRemaining--;\n    if (pending.doorsRemaining <= 0) game.pendingDoorSelections.shift();\n    await interaction.message.edit({ components: [] }).catch(discordCatch);\n    const allDoors = getMapTokensData()['devaron-garrison']?.doors || [];\n    const generalCh = await fetchGameChannel(client\x2C game.generalId);\n    if (game.pendingDoorSelections.length > 0) {\n      await postDevaronDoorButtons(game\x2C allDoors\x2C generalCh\x2C gameId);\n    } else {\n      await postDevaronCratePushPrompts(game\x2C generalCh\x2C gameId);\n    }\n    saveGames();\n    return;\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C canActAsPlayer\x2C client\x2C getSpaceController\n */\nexport async function handleDevaronCratePush(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C client\x2C getSpaceController } = ctx;\n    // customId: devaron_crate_push_{gameId}_{origCoord}\n    const rest = parseCustomId(interaction.customId\x2C 'devaron_crate_push_');\n    const lastUnderscore = rest.lastIndexOf('_');\n    const gameId = rest.substring(0\x2C lastUnderscore);\n    const origCoord = rest.substring(lastUnderscore + 1);\n    const game = await requireGame(interaction\x2C getGame\x2C gameId);\n    if (!game) return;\n    const curCoord = String(game.cratePositions?.[origCoord] || origCoord).toLowerCase();\n    const controller = getSpaceController(game\x2C 'devaron-garrison'\x2C curCoord);\n    if (!controller) { await interaction.followUp({ content: 'No one controls this crate currently.'\x2C ephemeral: true }).catch(discordCatch); return; }\n    if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C controller\x2C canActAsPlayer\x2C 'Only the controlling player can push this crate.')) return;\n    const modal = new ModalBuilder()\n      .setCustomId(`devaron_crate_modal_${gameId}_${origCoord}`)\n      .setTitle(`Push crate (at ${curCoord.toUpperCase()})`);\n    modal.addComponents(\n      new ActionRowBuilder().addComponents(\n        new TextInputBuilder()\n          .setCustomId('target_coord')\n          .setLabel(`Target space (up to 3 spaces\x2C e.g. K12)`)\n          .setStyle(TextInputStyle.Short)\n          .setPlaceholder(curCoord.toUpperCase())\n          .setRequired(true)\n      )\n    );\n    await interaction.showModal(modal).catch(discordCatch);\n    return;\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C canActAsPlayer\x2C client\n */\nexport async function handleKryknaPush(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C client } = ctx;\n    // customId: krykna_push_{gameId}_krykna-{N}\n    const rest = parseCustomId(interaction.customId\x2C 'krykna_push_');\n    const kryknaIdx = rest.indexOf('krykna-');\n    if (kryknaIdx < 0) return;\n    const gameId = rest.substring(0\x2C kryknaIdx - 1);\n    const kryknaId = rest.substring(kryknaIdx);\n    const game = await requireGame(interaction\x2C getGame\x2C gameId);\n    if (!game) return;\n    if (!game.pendingKryknaPushQueue || game.pendingKryknaPushQueue.length === 0) {\n      await interaction.followUp({ content: 'No Krykna push pending.'\x2C ephemeral: true }).catch(discordCatch); return;\n    }\n    const expectedPlayerNum = game.pendingKryknaPushQueue[0];\n    if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C expectedPlayerNum\x2C canActAsPlayer\x2C `It's Player ${expectedPlayerNum}'s turn to push a Krykna.`)) return;\n    const krykna = (game.npcKrykna || []).find((k) => k.id === kryknaId);\n    if (!krykna || krykna.defeated) { await interaction.followUp({ content: 'Krykna not found or already defeated.'\x2C ephemeral: true }).catch(discordCatch); return; }\n    const modal = new ModalBuilder()\n      .setCustomId(`krykna_push_modal_${gameId}_${kryknaId}`)\n      .setTitle(`Push ${kryknaId} (at ${String(krykna.coord).toUpperCase()})`);\n    modal.addComponents(\n      new ActionRowBuilder().addComponents(\n        new TextInputBuilder()\n          .setCustomId('target_coord')\n          .setLabel(`Target space (up to 3 spaces from ${String(krykna.coord).toUpperCase()})`)\n          .setStyle(TextInputStyle.Short)\n          .setPlaceholder(String(krykna.coord).toUpperCase())\n          .setRequired(true)\n      )\n    );\n    await interaction.showModal(modal).catch(discordCatch);\n    return;\n}\n\n/**\n * Handle fluctuation swap pick (first or second).\n * First click: saves source coord to game.pendingFluctuationSwapFirst\x2C re-posts target buttons.\n * Second click: executes swap\x2C advances queue. If queue empty\x2C continues round flow.\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx\n */\nexport async function handleFluctuationSwap(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C logGameAction\x2C postFluctuationSwapButtons } = ctx;\n  // customId: fluctuation_swap_{gameId}_{coord}\n  const rest = parseCustomId(interaction.customId\x2C 'fluctuation_swap_');\n  const lastUnderscore = rest.lastIndexOf('_');\n  const gameId = rest.substring(0\x2C lastUnderscore);\n  const coord = rest.substring(lastUnderscore + 1).toLowerCase();\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!game.pendingFluctuationSwapQueue || game.pendingFluctuationSwapQueue.length === 0) {\n    await interaction.followUp({ content: 'No fluctuation swap pending.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const expectedPlayerNum = game.pendingFluctuationSwapQueue[0];\n  const expectedPlayerId = getPlayerId(game\x2C expectedPlayerNum);\n  if (interaction.user.id !== expectedPlayerId) {\n    await interaction.followUp({ content: `It's Player ${expectedPlayerNum}'s turn to swap a fluctuation.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  await interaction.deferUpdate().catch(discordCatch);\n\n  if (!game.pendingFluctuationSwapFirst) {\n    // First pick \u2014 save source\x2C re-post target buttons\n    game.pendingFluctuationSwapFirst = coord;\n    await interaction.message.edit({ components: [] }).catch(discordCatch);\n    const generalCh = await fetchGameChannel(client\x2C game.generalId);\n    if (postFluctuationSwapButtons) {\n      await postFluctuationSwapButtons(game\x2C generalCh\x2C gameId\x2C expectedPlayerNum);\n    }\n    saveGames();\n    return;\n  }\n\n  // Second pick \u2014 execute the swap\n  const source = game.pendingFluctuationSwapFirst;\n  const target = coord;\n  game.pendingFluctuationSwapFirst = null;\n\n  // Find which token type IDs contain source and target coords\n  const positions = game.fluctuationPositions || {};\n  let sourceTypeId = null\x2C sourceIdx = -1;\n  let targetTypeId = null\x2C targetIdx = -1;\n  for (const [id\x2C coords] of Object.entries(positions)) {\n    if (!Array.isArray(coords)) continue;\n    const sIdx = coords.findIndex(c => normalizeCoord(c) === normalizeCoord(source));\n    if (sIdx >= 0) { sourceTypeId = id; sourceIdx = sIdx; }\n    const tIdx = coords.findIndex(c => normalizeCoord(c) === normalizeCoord(target));\n    if (tIdx >= 0) { targetTypeId = id; targetIdx = tIdx; }\n  }\n  if (sourceTypeId === null || targetTypeId === null) {\n    await interaction.followUp({ content: 'Could not find fluctuation positions to swap.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  // Swap the coordinates between the two token type arrays\n  positions[sourceTypeId][sourceIdx] = normalizeCoord(target);\n  positions[targetTypeId][targetIdx] = normalizeCoord(source);\n\n  // Mark both coords as swapped this round\n  game.fluctuationSwappedThisRound = game.fluctuationSwappedThisRound || [];\n  game.fluctuationSwappedThisRound.push(normalizeCoord(source)\x2C normalizeCoord(target));\n\n  const pid = getPlayerId(game\x2C expectedPlayerNum);\n  await logGameAction(game\x2C client\x2C `\ud83d\udd04 <@${pid}> swapped fluctuations **${source.toUpperCase()}** \u2194 **${target.toUpperCase()}**.`\x2C { allowedMentions: { users: [pid] }\x2C phase: 'ROUND'\x2C icon: 'round' });\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  // Advance queue\n  game.pendingFluctuationSwapQueue.shift();\n  if (game.pendingFluctuationSwapQueue.length > 0) {\n    // Next player's turn to swap\n    const nextPn = game.pendingFluctuationSwapQueue[0];\n    const generalCh = await fetchGameChannel(client\x2C game.generalId);\n    if (postFluctuationSwapButtons) {\n      await postFluctuationSwapButtons(game\x2C generalCh\x2C gameId\x2C nextPn);\n    }\n    saveGames();\n    return;\n  }\n\n  // Queue empty \u2014 continue round flow\n  await continueAfterFluctuationSwap(game\x2C gameId\x2C interaction\x2C ctx);\n  saveGames();\n}\n\n/**\n * Handle fluctuation swap skip (player declines to swap).\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx\n */\nexport async function handleFluctuationSkip(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C logGameAction\x2C postFluctuationSwapButtons } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'fluctuation_skip_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!game.pendingFluctuationSwapQueue || game.pendingFluctuationSwapQueue.length === 0) {\n    await interaction.followUp({ content: 'No fluctuation swap pending.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const expectedPlayerNum = game.pendingFluctuationSwapQueue[0];\n  const expectedPlayerId = getPlayerId(game\x2C expectedPlayerNum);\n  if (interaction.user.id !== expectedPlayerId) {\n    await interaction.followUp({ content: `It's Player ${expectedPlayerNum}'s turn to swap a fluctuation.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  await interaction.deferUpdate().catch(discordCatch);\n\n  // Clear any first-pick state\n  game.pendingFluctuationSwapFirst = null;\n\n  const pid = getPlayerId(game\x2C expectedPlayerNum);\n  await logGameAction(game\x2C client\x2C `\ud83d\udd04 <@${pid}> skipped fluctuation swap.`\x2C { allowedMentions: { users: [pid] }\x2C phase: 'ROUND'\x2C icon: 'round' });\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  // Advance queue\n  game.pendingFluctuationSwapQueue.shift();\n  if (game.pendingFluctuationSwapQueue.length > 0) {\n    // Next player's turn to swap\n    const nextPn = game.pendingFluctuationSwapQueue[0];\n    const generalCh = await fetchGameChannel(client\x2C game.generalId);\n    if (postFluctuationSwapButtons) {\n      await postFluctuationSwapButtons(game\x2C generalCh\x2C gameId\x2C nextPn);\n    }\n    saveGames();\n    return;\n  }\n\n  // Queue empty \u2014 continue round flow\n  await continueAfterFluctuationSwap(game\x2C gameId\x2C interaction\x2C ctx);\n  saveGames();\n}\n\n// \u2500\u2500 Claimed Krykna Placement handlers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Player clicks "Place a Krykna" \u2014 show space grid for opponent's deployment zone.\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx\n */\nexport async function handleKryknaPlace(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C canActAsPlayer } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'krykna_place_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!game.pendingClaimedKryknaQueue || game.pendingClaimedKryknaQueue.length === 0) {\n    await interaction.followUp({ content: 'No Krykna placement pending.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const expectedPlayerNum = game.pendingClaimedKryknaQueue[0];\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C expectedPlayerNum\x2C canActAsPlayer\x2C `It's Player ${expectedPlayerNum}'s turn to place a Krykna.`)) return;\n\n  const claimed = game.claimedKrykna?.[expectedPlayerNum] || 0;\n  if (claimed <= 0) {\n    await interaction.followUp({ content: 'You have no claimed Krykna to place.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const mapId = game.selectedMap?.id;\n  const validSpaces = getValidKryknaPlacementSpaces(game\x2C expectedPlayerNum\x2C mapId);\n  if (validSpaces.length === 0) {\n    await interaction.followUp({ content: 'No valid spaces in opponent\\'s deployment zone (all occupied).'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  await interaction.deferUpdate().catch(discordCatch);\n\n  // Set up pendingSpacePick for the generic space picker\n  const contextKey = `${gameId}_krykna_place`;\n  game.pendingSpacePick = game.pendingSpacePick || {};\n  game.pendingSpacePick[contextKey] = {\n    validSpaces\x2C\n    cellPrefix: `krykna_place_pick_${gameId}_`\x2C\n    mapSpaces: null\x2C\n    headerText: `Place claimed Krykna in opponent's deployment zone`\x2C\n    style: ButtonStyle.Success\x2C\n  };\n\n  const { rows } = buildRowPickerButtons(validSpaces\x2C `space_row_${contextKey}_`\x2C { style: ButtonStyle.Success });\n  await interaction.message.edit({\n    content: `\ud83d\udd77\ufe0f **Place Krykna** \u2014 Pick a row\x2C then a space in opponent's deployment zone:`\x2C\n    components: rows.slice(0\x2C 5)\x2C\n  }).catch(discordCatch);\n  saveGames();\n}\n\n/**\n * Player clicks "Skip" \u2014 declines to place a claimed Krykna this round.\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx\n */\nexport async function handleKryknaPlaceSkip(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C logGameAction\x2C canActAsPlayer\x2C postKryknaPlaceButtons } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'krykna_place_skip_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!game.pendingClaimedKryknaQueue || game.pendingClaimedKryknaQueue.length === 0) {\n    await interaction.followUp({ content: 'No Krykna placement pending.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const expectedPlayerNum = game.pendingClaimedKryknaQueue[0];\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C expectedPlayerNum\x2C canActAsPlayer\x2C `It's Player ${expectedPlayerNum}'s turn to place a Krykna.`)) return;\n\n  await interaction.deferUpdate().catch(discordCatch);\n  const pid = getPlayerId(game\x2C expectedPlayerNum);\n  await logGameAction(game\x2C client\x2C `\ud83d\udd77\ufe0f <@${pid}> skipped claimed Krykna placement.`\x2C { allowedMentions: { users: [pid] }\x2C phase: 'ROUND'\x2C icon: 'round' });\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  // Advance queue\n  game.pendingClaimedKryknaQueue.shift();\n  if (game.pendingClaimedKryknaQueue.length > 0) {\n    const generalCh = await fetchGameChannel(client\x2C game.generalId);\n    if (generalCh && postKryknaPlaceButtons) {\n      await postKryknaPlaceButtons(game\x2C generalCh\x2C gameId\x2C { getPlayerId\x2C discordCatch });\n    }\n  } else {\n    delete game.pendingClaimedKryknaQueue;\n  }\n  saveGames();\n}\n\n/**\n * Player picked a space from the grid \u2014 place a Krykna NPC there.\n * customId: krykna_place_pick_{gameId}_{coord}\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx\n */\nexport async function handleKryknaPlacePick(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C logGameAction\x2C canActAsPlayer\x2C postKryknaPlaceButtons } = ctx;\n  const rest = parseCustomId(interaction.customId\x2C 'krykna_place_pick_');\n  const lastUnderscore = rest.lastIndexOf('_');\n  const gameId = rest.substring(0\x2C lastUnderscore);\n  const coord = rest.substring(lastUnderscore + 1).toLowerCase();\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!game.pendingClaimedKryknaQueue || game.pendingClaimedKryknaQueue.length === 0) {\n    await interaction.followUp({ content: 'No Krykna placement pending.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const expectedPlayerNum = game.pendingClaimedKryknaQueue[0];\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C expectedPlayerNum\x2C canActAsPlayer\x2C `It's Player ${expectedPlayerNum}'s turn to place a Krykna.`)) return;\n\n  // Validate the coord is still valid (occupancy may have changed)\n  const mapId = game.selectedMap?.id;\n  const validSpaces = getValidKryknaPlacementSpaces(game\x2C expectedPlayerNum\x2C mapId);\n  if (!validSpaces.includes(normalizeCoord(coord))) {\n    await interaction.followUp({ content: `${coord.toUpperCase()} is not a valid placement space (occupied or outside zone).`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  await interaction.deferUpdate().catch(discordCatch);\n\n  // Place a new Krykna NPC\n  const nextId = `krykna-${(game.npcKrykna || []).length + 1}`;\n  game.npcKrykna = game.npcKrykna || [];\n  game.npcKrykna.push({ id: nextId\x2C coord: normalizeCoord(coord)\x2C hp: 8\x2C maxHp: 8\x2C defeated: false });\n\n  // Decrement claimed count\n  game.claimedKrykna[expectedPlayerNum] = Math.max(0\x2C (game.claimedKrykna[expectedPlayerNum] || 0) - 1);\n\n  // Clean up space picker\n  cleanupSpacePick(game\x2C `${gameId}_krykna_place`);\n\n  const pid = getPlayerId(game\x2C expectedPlayerNum);\n  await logGameAction(game\x2C client\x2C `\ud83d\udd77\ufe0f <@${pid}> placed a claimed Krykna at **${coord.toUpperCase()}** (${nextId}).`\x2C { allowedMentions: { users: [pid] }\x2C phase: 'ROUND'\x2C icon: 'round' });\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  // Advance queue\n  game.pendingClaimedKryknaQueue.shift();\n  if (game.pendingClaimedKryknaQueue.length > 0) {\n    const generalCh = await fetchGameChannel(client\x2C game.generalId);\n    if (generalCh && postKryknaPlaceButtons) {\n      await postKryknaPlaceButtons(game\x2C generalCh\x2C gameId\x2C { getPlayerId\x2C discordCatch });\n    }\n  } else {\n    delete game.pendingClaimedKryknaQueue;\n  }\n  saveGames();\n}\n
