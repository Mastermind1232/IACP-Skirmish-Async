script-source,386,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/undici/lib/mock/pluralizer.js,'use strict'\n\nconst singulars = {\n  pronoun: 'it'\x2C\n  is: 'is'\x2C\n  was: 'was'\x2C\n  this: 'this'\n}\n\nconst plurals = {\n  pronoun: 'they'\x2C\n  is: 'are'\x2C\n  was: 'were'\x2C\n  this: 'these'\n}\n\nmodule.exports = class Pluralizer {\n  constructor (singular\x2C plural) {\n    this.singular = singular\n    this.plural = plural\n  }\n\n  pluralize (count) {\n    const one = count === 1\n    const keys = one ? singulars : plurals\n    const noun = one ? this.singular : this.plural\n    return { ...keys\x2C count\x2C noun }\n  }\n}\n
