script-source,140,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/domain/reducer/setup-reducer.js,export const setupReducerHandlers = {\n  MapTypeChosen(state\x2C payload) {\n    return { ...state\x2C mapType: payload.mapType };\n  }\x2C\n\n  MapConfirmed(state\x2C payload) {\n    return { ...state\x2C confirmedMapId: payload.mapId };\n  }\x2C\n\n  DraftRandomStarted(state) {\n    return { ...state\x2C draftRandomStarted: true };\n  }\x2C\n\n  FigurePlaced(state\x2C payload) {\n    const figurePositions = structuredClone(state.figurePositions || {});\n    const playerPositions = figurePositions[payload.playerNum] || {};\n    playerPositions[payload.figureKey] = payload.coord;\n    figurePositions[payload.playerNum] = playerPositions;\n    return { ...state\x2C figurePositions };\n  }\x2C\n\n  AttachmentPlaced(state\x2C payload) {\n    const dcAttachments = { ...(state.dcAttachments || {}) };\n    const attachments = [...(dcAttachments[payload.dcName] || [])];\n    attachments.push(payload.attachmentName);\n    dcAttachments[payload.dcName] = attachments;\n    return { ...state\x2C dcAttachments };\n  }\x2C\n};\n
