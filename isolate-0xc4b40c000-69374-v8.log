code-creation,Script,9,242576,0x3f05b9292188,64, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/activation.js:1:1,0x3a994ddaa9b0,~
script-source,207,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/activation.js,/**\n * Activation handlers: status_phase_\x2C pass_activation_turn_\x2C end_turn_\x2C confirm_activate_\x2C cancel_activate_\n */\nimport { EmbedBuilder\x2C ActionRowBuilder\x2C ButtonBuilder\x2C ButtonStyle } from 'discord.js';\nimport { canActAsPlayer } from '../utils/can-act-as-player.js';\nimport { getCcEffectsData\x2C getDcEffects\x2C getMapData\x2C getFigureSize\x2C getDeploymentZones\x2C getDcStats } from '../data-loader.js';\nimport { finalizeActivation\x2C getCompanionForDc\x2C formatCompanionStats } from '../engine/activation-setup.js';\nimport { applyEndOfActivationEffects } from '../engine/activation-effects.js';\nimport { isFigurelessDc } from '../game/dc-helpers.js';\nimport { filterValidTopLeftSpaces } from '../engine/utils.js';\nimport { parseCoord } from '../game/coords.js';\nimport { cleanupActivation } from '../game/activation-state.js';\nimport { applyCondition\x2C filterCondition\x2C dcNameFromFigureKey\x2C parseFigureKey\x2C reduceHp\x2C healHp\x2C getMaxPowerTokens\x2C grantPowerTokens\x2C grantMovementBank\x2C figureChoiceLabels } from '../game/index.js';\nimport { getAllFigureCoords } from '../game/spatial.js';\nimport { countGameSpaces } from '../game/board-helpers.js';\nimport { cardNameIncludes } from '../game/card-names.js';\nimport { getPlayableReactionCardsForTiming } from '../game/cc-timing.js';\nimport { getFootprintCells } from '../game/coords.js';\nimport { getDiceData\x2C getDcKeywords } from '../data-loader.js';\nimport { setRoundPhase\x2C ROUND_PHASES } from '../game/phase.js';\nimport { sendPowerTokenOverflowUI } from './combat.js';\nimport {\n  getPlayerId\x2C\n  getDcList\x2C\n  getDcMessageIds\x2C\n  getPlayAreaId\x2C\n  getHandChannelId\x2C\n  getActivationsRemaining\x2C\n  getActivatedDcIndices\x2C\n  getCcHand\x2C\n  getDcAttachments\x2C\n  setActivatedDcIndices\x2C\n  recomputeActivationCounts\x2C\n  ccDeckKey\x2C\n  ccDiscardKey\x2C\n  ccHandKey\x2C\n  opponentPlayerNum\x2C\n  getInitiativePlayerNum\x2C\n  pushFigure\x2C\n} from '../game/player-helpers.js';\nimport { discordCatch\x2C withDiscordRetry } from '../error-handling.js';\nimport { requireGame\x2C requirePlayer } from '../utils/guards.js';\nimport { chunkButtonsToRows\x2C truncateLabel } from '../discord/components.js';\nimport { parseCustomId\x2C splitCustomId } from '../discord/custom-id.js';\nimport { fetchGameChannel\x2C sanitizeMentions } from '../discord/channel-helpers.js';\n\n/**\n * Determine the companion (if any) for a given DC\x2C considering both\n * direct companion fields (e.g. Iden Versio \u2192 Dio) and attachment-based\n * companions (e.g. [Clan of Two] \u2192 The Child\x2C [Indentured Jester] \u2192 Salacious B. Crumb).\n * Returns { companionName\x2C companionStats\x2C isCoActivation } or null.\n * isCoActivation is true for Junk Droid (Ugnaught) which co-activates rather than before/after.\n */\n\n// getCompanionForDc and formatCompanionStats moved to ../engine/activation-setup.js\n\n/**\n * Field Tactics (Death Trooper Elite/Regular): after activation ends\x2C choose a\n * friendly TROOPER or LEADER figure within 2 spaces (cost \u22646) to perform an\n * interrupt free attack.  Modelled on Coordinated Raid (pendingCoordinatedRaid).\n *\n * @param {object} game\n * @param {object} meta - dcMessageMeta entry for the activating DC\n * @param {string} dcMsgId - DC message ID that just finished activating\n * @param {Function} logGameAction\n * @param {object} client\n * @param {Function} findDcMsgIdForFigure - (gameId\x2C playerNum\x2C figureKey) => msgId | null\n */\nasync function maybePromptFieldTactics(game\x2C meta\x2C dcMsgId\x2C logGameAction\x2C client\x2C findDcMsgIdForFigure) {\n  const dcName = meta.dcName;\n  if (dcName !== 'Death Trooper (Elite)' && dcName !== 'Death Trooper (Regular)') return;\n  // Guard: limit once per round per group\n  const ftRoundKey = `fieldTactics_${dcMsgId}`;\n  if (game.roundFigureAbilityUsed?.[ftRoundKey]) return;\n  const eff = getDcEffects();\n  const dgIndex = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n  const prefix = `${dcName}-${dgIndex}-`;\n  // Find any figure in this DG that is on the board to serve as origin for range check\n  const myFigKeys = Object.keys(game.figurePositions?.[meta.playerNum] || {}).filter(k => k.startsWith(prefix));\n  if (myFigKeys.length === 0) return;\n  const originPos = game.figurePositions?.[meta.playerNum]?.[myFigKeys[0]];\n  if (!originPos) return;\n  // Scan all friendly figures for TROOPER or LEADER keyword\x2C cost \u2264 6\x2C within 2 spaces\n  const validTargets = [];\n  for (const [fk\x2C pos] of Object.entries(game.figurePositions?.[meta.playerNum] || {})) {\n    if (!pos || fk.startsWith(prefix)) continue; // skip self\n    const fkDcName = dcNameFromFigureKey(fk);\n    const fkEff = eff?.[fkDcName];\n    if (!fkEff) continue;\n    const kws = (fkEff.keywords || []).map(k => String(k).toUpperCase());\n    if (!kws.includes('TROOPER') && !kws.includes('LEADER')) continue;\n    if ((fkEff.cost ?? 99) > 6) continue;\n    if (countGameSpaces(game\x2C originPos\x2C pos) > 2) continue;\n    validTargets.push(fk);\n  }\n  if (validTargets.length === 0) return;\n  const ownerId = getPlayerId(game\x2C meta.playerNum);\n  const gameId = game.gameId;\n  if (validTargets.length === 1) {\n    // Auto-select the only eligible figure\n    const chosenFk = validTargets[0];\n    const chosenMsgId = findDcMsgIdForFigure ? findDcMsgIdForFigure(gameId\x2C meta.playerNum\x2C chosenFk) : null;\n    if (chosenMsgId) {\n      game.pendingFieldTactics = { forMsgId: chosenMsgId\x2C chosenFigureKey: chosenFk\x2C triggeredByMsgId: dcMsgId };\n    }\n    game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n    game.roundFigureAbilityUsed[ftRoundKey] = true;\n    const chosenName = dcNameFromFigureKey(chosenFk);\n    await logGameAction(game\x2C client\x2C `**Field Tactics** \u2014 **${chosenName}** may interrupt to perform a free attack. Use their **Attack** button.`\x2C { phase: 'ROUND'\x2C icon: 'activate' });\n    return;\n  }\n  // Multiple targets \u2014 show picker buttons\n  const btns = validTargets.slice(0\x2C 20).map(fk => {\n    const label = dcNameFromFigureKey(fk);\n    return new ButtonBuilder()\n      .setCustomId(`field_tactics_pick_${gameId}_${dcMsgId}_${fk}`)\n      .setLabel(label.slice(0\x2C 80))\n      .setStyle(ButtonStyle.Primary);\n  });\n  btns.push(\n    new ButtonBuilder()\n      .setCustomId(`field_tactics_pick_${gameId}_${dcMsgId}_skip`)\n      .setLabel('Skip')\n      .setStyle(ButtonStyle.Secondary)\n  );\n  const rows = chunkButtonsToRows(btns);\n  await logGameAction(game\x2C client\x2C `<@${ownerId}> **Field Tactics** \u2014 Choose a friendly TROOPER/LEADER (cost \u22646) within 2 spaces to perform a free interrupt attack:`\x2C {\n    components: rows\x2C\n    allowedMentions: { users: [ownerId] }\x2C\n  });\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C replyIfGameEnded\x2C hasActionsRemainingInGame\x2C GAME_PHASES\x2C PHASE_COLOR\x2C getInitiativePlayerZoneLabel\x2C logGameAction\x2C updateHandChannelMessages\x2C saveGames\x2C client\n */\nexport async function handleStatusPhase(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    replyIfGameEnded\x2C\n    hasActionsRemainingInGame\x2C\n    GAME_PHASES\x2C\n    PHASE_COLOR\x2C\n    getInitiativePlayerZoneLabel\x2C\n    logGameAction\x2C\n    updateHandChannelMessages\x2C\n    saveGames\x2C\n    client\x2C\n  } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'status_phase_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (await replyIfGameEnded(game\x2C interaction)) return;\n  if (!canActAsPlayer(game\x2C interaction.user.id\x2C 1) && !canActAsPlayer(game\x2C interaction.user.id\x2C 2)) {\n    await interaction.followUp({ content: 'Only players in this game can end the activation phase.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const r1 = game.p1ActivationsRemaining ?? 0;\n  const r2 = game.p2ActivationsRemaining ?? 0;\n  const hasActions = hasActionsRemainingInGame(game\x2C gameId);\n  if (r1 > 0 || r2 > 0 || hasActions) {\n    const parts = [];\n    if (r1 > 0 || r2 > 0) parts.push(`P1: ${r1} activations left\x2C P2: ${r2} activations left`);\n    if (hasActions) parts.push('some DCs still have actions to spend');\n    await interaction.followUp({\n      content: `Both players must use all activations and actions first. (${parts.join('; ')})`\x2C\n      ephemeral: true\x2C\n    }).catch(discordCatch);\n    return;\n  }\n  const round = game.currentRound || 1;\n  const clickerIsP1 = interaction.user.id === game.player1Id;\n  game.p1ActivationPhaseEnded = game.p1ActivationPhaseEnded || false;\n  game.p2ActivationPhaseEnded = game.p2ActivationPhaseEnded || false;\n  // In test games\x2C human (P1) clicks for both sides; first click = P1\x2C second = P2\n  if (game.isTestGame && clickerIsP1) {\n    if (!game.p1ActivationPhaseEnded) game.p1ActivationPhaseEnded = true;\n    else game.p2ActivationPhaseEnded = true;\n  } else if (clickerIsP1) {\n    game.p1ActivationPhaseEnded = true;\n  } else {\n    game.p2ActivationPhaseEnded = true;\n  }\n  const bothEnded = game.p1ActivationPhaseEnded && game.p2ActivationPhaseEnded;\n  if (!bothEnded) {\n    const waiting = !game.p1ActivationPhaseEnded ? 'P1' : 'P2';\n    await interaction.followUp({\n      content: `${clickerIsP1 ? 'P1' : 'P2'} has ended activation. Waiting for **${waiting}** to click **End R${round} Activation Phase**.`\x2C\n      ephemeral: true\x2C\n    }).catch(discordCatch);\n    const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n    const roundEmbed = new EmbedBuilder()\n      .setTitle(`${GAME_PHASES.ROUND.emoji}  ROUND ${round} - Activation Phase`)\n      .setColor(PHASE_COLOR);\n    const endBtn = new ActionRowBuilder().addComponents(\n      new ButtonBuilder()\n        .setCustomId(`status_phase_${gameId}`)\n        .setLabel(`End R${round} Activation Phase`)\n        .setStyle(ButtonStyle.Secondary)\n    );\n    await interaction.message.edit({\n      content: `**Round ${round}** \u2014 End Activation Phase: ${game.p1ActivationPhaseEnded ? 'P1 \u2705' : 'P1 \u23f3'} | ${game.p2ActivationPhaseEnded ? 'P2 \u2705' : 'P2 \u23f3'}\\nBoth players must click the button when done with activations and any end-of-activation effects.`\x2C\n      embeds: [roundEmbed]\x2C\n      components: [endBtn]\x2C\n    }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n  game.p1ActivationPhaseEnded = false;\n  game.p2ActivationPhaseEnded = false;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  // Phase gate: both players confirm before entering end-of-round effects\n  const { sendPhaseGateMessages } = ctx;\n  if (sendPhaseGateMessages) {\n    await sendPhaseGateMessages(game\x2C 'pre_end_of_round'\x2C ctx);\n  }\n  saveGames();\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C replyIfGameEnded\x2C getPlayerZoneLabel\x2C logGameAction\x2C pushUndo\x2C client\x2C saveGames\n */\nexport async function handlePassActivationTurn(interaction\x2C ctx) {\n  const { getGame\x2C replyIfGameEnded\x2C getPlayerZoneLabel\x2C logGameAction\x2C pushUndo\x2C client\x2C saveGames } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'pass_activation_turn_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (await replyIfGameEnded(game\x2C interaction)) return;\n  const turnPlayerId = game.currentActivationTurnPlayerId ?? game.initiativePlayerId;\n  const turnPlayerNum = turnPlayerId === game.player1Id ? 1 : 2;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C turnPlayerNum\x2C canActAsPlayer\x2C "It's not your turn to pass.")) return;\n  // Force Vision: cannot pass if you haven't picked yet or have a named group pending\n  if (game.forceVisionPending && game.forceVisionPending === turnPlayerNum) {\n    await interaction.followUp({ content: `\ud83d\udc41\ufe0f **Force Vision** \u2014 You must first choose a group from the Force Vision prompt before passing.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (game.forceVisionNextActivation && game.forceVisionNextActivation.playerNum === turnPlayerNum) {\n    const _fvDcName = game.forceVisionNextActivation.dcName;\n    await interaction.followUp({ content: `\ud83d\udc41\ufe0f **Force Vision** \u2014 You cannot pass. You must activate **${_fvDcName}** next.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const myRem = getActivationsRemaining(game\x2C turnPlayerNum) ?? 0;\n  const otherPlayerNum = opponentPlayerNum(turnPlayerNum);\n  const otherRem = getActivationsRemaining(game\x2C otherPlayerNum) ?? 0;\n  if (otherRem <= myRem) {\n    await interaction.followUp({ content: `You have **${myRem}** activation${myRem !== 1 ? 's' : ''} remaining; opponent has **${otherRem}**. You can only pass when they have more.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const otherPlayerId = getPlayerId(game\x2C otherPlayerNum);\n  const round = game.currentRound || 1;\n  const turnNum = turnPlayerNum;\n  const turnZone = getPlayerZoneLabel(game\x2C turnPlayerId);\n  const roundContentBefore = `<@${turnPlayerId}> (${turnZone}**Player ${turnNum}**) **Round ${round}** \u2014 Your turn to activate! You may pass back if the other player has more activations.`;\n  game.currentActivationTurnPlayerId = otherPlayerId;\n  const passLogMsg = await logGameAction(game\x2C client\x2C `<@${turnPlayerId}> passed the turn to <@${otherPlayerId}> (Player ${otherPlayerNum} has more activations remaining).`\x2C { phase: 'ROUND'\x2C icon: 'activate'\x2C allowedMentions: { users: [otherPlayerId] } });\n  pushUndo(game\x2C {\n    type: 'pass_turn'\x2C\n    previousTurnPlayerId: turnPlayerId\x2C\n    gameLogMessageId: passLogMsg?.id\x2C\n    roundMessageId: game.roundActivationMessageId\x2C\n    roundContentBefore\x2C\n    gameId\x2C\n  });\n  if (game.roundActivationMessageId && game.generalId) {\n    try {\n      const ch = await fetchGameChannel(client\x2C game.generalId);\n      const msg = await ch.messages.fetch(game.roundActivationMessageId);\n      const initNum = otherPlayerNum;\n      const newCurrentRem = getActivationsRemaining(game\x2C otherPlayerNum) ?? 0;\n      const justPassedRem = getActivationsRemaining(game\x2C turnPlayerNum) ?? 0;\n      const passRows = [];\n      if (justPassedRem > newCurrentRem && newCurrentRem > 0) {\n        passRows.push(new ActionRowBuilder().addComponents(\n          new ButtonBuilder()\n            .setCustomId(`pass_activation_turn_${gameId}`)\n            .setLabel(`Pass (opponent has ${justPassedRem - newCurrentRem} more activation${justPassedRem - newCurrentRem !== 1 ? 's' : ''} than you)`)\n            .setStyle(ButtonStyle.Secondary)\n        ));\n      }\n      const otherZone = getPlayerZoneLabel(game\x2C otherPlayerId);\n      await msg.edit({\n        content: `<@${otherPlayerId}> (${otherZone}**Player ${initNum}**) **Round ${round}** \u2014 Your turn to activate!${passRows.length ? ' You may pass back if the other player has more activations.' : ''}`\x2C\n        components: passRows\x2C\n        allowedMentions: { users: [otherPlayerId] }\x2C\n      }).catch(discordCatch);\n    } catch (err) {\n      console.error('Failed to update round message for pass:'\x2C err);\n    }\n  }\n  saveGames();\n}\n\n// \u2500\u2500 Lie in Ambush: trigger check + deploy handler \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * After an opponent activates a group\x2C check if the Lie in Ambush trigger fires.\n * "If you have 3+ exhausted or defeated groups and it is not the first round\x2C\n *  deploy this group to any deployment zone."\n * @param {object} game\n * @param {number} activatingPlayerNum - player who just finished activating\n * @param {object} ctx - logGameAction\x2C client\n */\nasync function checkLieInAmbushTrigger(game\x2C activatingPlayerNum\x2C ctx) {\n  const { logGameAction\x2C client } = ctx;\n  const liaOwnerNum = opponentPlayerNum(activatingPlayerNum);\n\n  // Not round 1\n  if ((game.currentRound || 1) <= 1) return;\n\n  // Owner has set-aside figures\n  const setAsideKeys = game.lieInAmbushSetAside?.[liaOwnerNum];\n  if (!setAsideKeys?.length) return;\n\n  // Not already deployed (check first figure key)\n  if (game.figurePositions?.[liaOwnerNum]?.[setAsideKeys[0]]) return;\n\n  // Not already pending\n  if (game.pendingLieInAmbush) return;\n\n  // Count exhausted or defeated groups for the LiA owner\n  const dcList = getDcList(game\x2C liaOwnerNum) || [];\n  const activatedIndices = new Set(getActivatedDcIndices(game\x2C liaOwnerNum) || []);\n  const pos = game.figurePositions?.[liaOwnerNum] || {};\n\n  let exhOrDefeated = 0;\n  const figureDcCounts = {};\n  for (let i = 0; i < dcList.length; i++) {\n    const dc = dcList[i];\n    const dcName = dc?.dcName || dc?.displayName;\n    if (!dcName || isFigurelessDc(dcName)) continue;\n\n    figureDcCounts[dcName] = (figureDcCounts[dcName] || 0) + 1;\n    const dgIndex = figureDcCounts[dcName];\n\n    // Skip the set-aside group itself\n    if (setAsideKeys.includes(`${dcName}-${dgIndex}-0`)) continue;\n\n    // Exhausted = activated this round\n    if (activatedIndices.has(i)) { exhOrDefeated++; continue; }\n\n    // Defeated = all figures removed from board\n    const figures = getDcStats(dcName)?.figures ?? 1;\n    let allGone = true;\n    for (let f = 0; f < figures; f++) {\n      if (pos[`${dcName}-${dgIndex}-${f}`]) { allGone = false; break; }\n    }\n    if (allGone) exhOrDefeated++;\n  }\n\n  if (exhOrDefeated < 3) return;\n\n  // Trigger fires \u2014 show zone selection in owner's hand channel\n  const dcName = dcNameFromFigureKey(setAsideKeys[0]);\n  game.pendingLieInAmbush = { playerNum: liaOwnerNum\x2C dcName };\n\n  const gameId = game.gameId;\n  const liaOwnerId = getPlayerId(game\x2C liaOwnerNum);\n  const handId = getHandChannelId(game\x2C liaOwnerNum);\n\n  try {\n    const handChannel = await fetchGameChannel(client\x2C handId);\n    const row = new ActionRowBuilder().addComponents(\n      new ButtonBuilder()\n        .setCustomId(`lia_deploy_zone_${gameId}_${liaOwnerNum}_red`)\n        .setLabel('Deploy to Red Zone')\n        .setStyle(ButtonStyle.Danger)\x2C\n      new ButtonBuilder()\n        .setCustomId(`lia_deploy_zone_${gameId}_${liaOwnerNum}_blue`)\n        .setLabel('Deploy to Blue Zone')\n        .setStyle(ButtonStyle.Primary)\x2C\n    );\n    await handChannel.send({\n      content: `\ud83c\udfaf **Lie in Ambush** triggered! You have **${exhOrDefeated}** exhausted/defeated groups.\\nDeploy **${dcName}** to any deployment zone:`\x2C\n      components: [row]\x2C\n    });\n  } catch (err) {\n    console.error('[Lie in Ambush] Failed to send zone selection:'\x2C err.message);\n  }\n\n  await logGameAction(game\x2C client\x2C `\ud83c\udfaf **Lie in Ambush** \u2014 <@${liaOwnerId}> may deploy **${dcName}** (${exhOrDefeated} exhausted/defeated groups).`\x2C {\n    allowedMentions: { users: [liaOwnerId] }\x2C\n    phase: 'ROUND'\x2C\n    icon: 'deploy'\x2C\n  });\n}\n\n/**\n * Handle lia_deploy_zone_ button: deploy the set-aside group to chosen zone.\n */\nexport async function handleLiaDeployZone(interaction\x2C ctx) {\n  const { getGame\x2C logGameAction\x2C client\x2C saveGames\x2C updateActivationsMessage } = ctx;\n  // customId: lia_deploy_zone_<gameId>_<playerNum>_<zone>\n  const parts = splitCustomId(interaction.customId\x2C 'lia_deploy_zone_');\n  const zone = parts[parts.length - 1]; // red or blue\n  const playerNum = parseInt(parts[parts.length - 2]\x2C 10);\n  const gameId = parts.slice(0\x2C -2).join('_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n\n  const ownerId = getPlayerId(game\x2C playerNum);\n  if (interaction.user.id !== ownerId) {\n    await interaction.followUp({ content: 'Only the owning player can deploy this group.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const setAsideKeys = game.lieInAmbushSetAside?.[playerNum];\n  if (!setAsideKeys?.length) {\n    await interaction.followUp({ content: 'No set-aside group to deploy.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  // Get zone spaces\n  const mapId = game.selectedMap?.id;\n  const zones = mapId ? getDeploymentZones()[mapId] : null;\n  const zoneSpaces = (zones?.[zone] || []).map(s => String(s).toLowerCase());\n  if (!zoneSpaces.length) {\n    await interaction.followUp({ content: `No spaces in the ${zone} zone.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  // Build occupied set\n  const occupied = [];\n  for (const p of [1\x2C 2]) {\n    for (const [k\x2C s] of Object.entries(game.figurePositions?.[p] || {})) {\n      const dn = dcNameFromFigureKey(k);\n      const size = game.figureOrientations?.[k] || getFigureSize(dn);\n      occupied.push(...getFootprintCells(s\x2C size));\n    }\n  }\n\n  // Compute opponent zone centroid for entrance-based sorting\n  const oppZone = zone === 'red' ? 'blue' : 'red';\n  const oppCoords = (zones?.[oppZone] || []).map(s => parseCoord(String(s).toLowerCase()));\n  const oppCx = oppCoords.length ? oppCoords.reduce((a\x2C c) => a + c.col\x2C 0) / oppCoords.length : 0;\n  const oppCy = oppCoords.length ? oppCoords.reduce((a\x2C c) => a + c.row\x2C 0) / oppCoords.length : 0;\n\n  const dcName = dcNameFromFigureKey(setAsideKeys[0]);\n  const figureSize = getFigureSize(dcName);\n  const ms = getMapData(mapId);\n  const blocking = ms?.blocking || [];\n\n  if (!game.figurePositions) game.figurePositions = { 1: {}\x2C 2: {} };\n  if (!game.figurePositions[playerNum]) game.figurePositions[playerNum] = {};\n\n  let placed = 0;\n  for (const fk of setAsideKeys) {\n    // Rebuild occupied for each figure since previous placements change it\n    const currentOccupied = [];\n    for (const p of [1\x2C 2]) {\n      for (const [k\x2C s] of Object.entries(game.figurePositions[p] || {})) {\n        const dn = dcNameFromFigureKey(k);\n        const size = game.figureOrientations?.[k] || getFigureSize(dn);\n        currentOccupied.push(...getFootprintCells(s\x2C size));\n      }\n    }\n\n    // Check if figure is MOBILE or MASSIVE \u2014 those can deploy on blocking terrain\n    const fkDcName = dcNameFromFigureKey(fk);\n    const fkKeywords = getDcKeywords(game)?.[fkDcName] || [];\n    const fkKwUpper = fkKeywords.map(k => String(k).toUpperCase());\n    const ignoreBlocking = fkKwUpper.includes('MOBILE') || fkKwUpper.includes('MASSIVE');\n    const validSpaces = filterValidTopLeftSpaces(zoneSpaces\x2C currentOccupied\x2C figureSize\x2C getFootprintCells\x2C blocking\x2C ignoreBlocking);\n    if (!validSpaces.length) continue;\n\n    // Sort by proximity to opponent zone entrance\n    validSpaces.sort((a\x2C b) => {\n      const pa = parseCoord(a)\x2C pb = parseCoord(b);\n      return (Math.abs(pa.col - oppCx) + Math.abs(pa.row - oppCy)) -\n             (Math.abs(pb.col - oppCx) + Math.abs(pb.row - oppCy));\n    });\n\n    game.figurePositions[playerNum][fk] = validSpaces[0];\n    placed++;\n  }\n\n  // Clean up set-aside state\n  delete game.lieInAmbushSetAside[playerNum];\n  delete game.pendingLieInAmbush;\n\n  // Recompute activation counts \u2014 LiA set-aside was cleared\x2C figures now on board\n  if (placed > 0) {\n    recomputeActivationCounts(game\x2C playerNum);\n  }\n\n  // Remove the zone selection message\n  try {\n    await interaction.message.delete();\n  } catch {}\n\n  // Apply post-deploy effects that were missed because figures weren't on-board at scan time\n  if (placed > 0) {\n    const atts = getDcAttachments(game\x2C playerNum) || {};\n    const deployedMsgIds = getDcMessageIds(game\x2C playerNum) || [];\n    const deployedDcList = getDcList(game\x2C playerNum) || [];\n    for (let i = 0; i < deployedDcList.length; i++) {\n      if (deployedDcList[i]?.dcName !== dcName) continue;\n      const mid = deployedMsgIds[i];\n      const dcAtts = atts[mid] || [];\n      if (dcAtts.some(a => a.toLowerCase() === 'cross training')) {\n        for (const fk of setAsideKeys) {\n          if (game.figurePositions[playerNum][fk]) {\n            applyCondition(game\x2C fk\x2C 'Hide');\n          }\n        }\n        await logGameAction(game\x2C client\x2C `\ud83e\udd77 **Cross Training** \u2014 **${dcName}** becomes **Hidden** after deployment.`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n      }\n      break;\n    }\n  }\n\n  await logGameAction(game\x2C client\x2C `\ud83c\udfaf **Lie in Ambush** \u2014 **${dcName}** deployed ${placed} figure(s) to the **${zone}** zone!`\x2C {\n    phase: 'ROUND'\x2C\n    icon: 'deploy'\x2C\n  });\n\n  saveGames();\n  await updateActivationsMessage?.(game\x2C playerNum\x2C client);\n\n  // Refresh round activation message buttons \u2014 LiA deployment changes the activation balance\n  if (placed > 0 && game.roundActivationMessageId && game.generalId) {\n    try {\n      const ch = await fetchGameChannel(client\x2C game.generalId);\n      const msg = await ch.messages.fetch(game.roundActivationMessageId);\n      const turnPlayerId = game.currentActivationTurnPlayerId ?? game.initiativePlayerId;\n      const turnPlayerNum = turnPlayerId === game.player1Id ? 1 : 2;\n      const otherNum = opponentPlayerNum(turnPlayerNum);\n      const myRem = getActivationsRemaining(game\x2C turnPlayerNum) ?? 0;\n      const otherRem = getActivationsRemaining(game\x2C otherNum) ?? 0;\n      const round = game.currentRound || 1;\n      const passRows = [];\n      if (otherRem > myRem && myRem > 0) {\n        passRows.push(new ActionRowBuilder().addComponents(\n          new ButtonBuilder()\n            .setCustomId(`pass_activation_turn_${gameId}`)\n            .setLabel(`Pass (opponent has ${otherRem - myRem} more activation${otherRem - myRem !== 1 ? 's' : ''} than you)`)\n            .setStyle(ButtonStyle.Secondary)\n        ));\n      }\n      const turnZone = turnPlayerId === game.player1Id ? 'red' : 'blue';\n      const playAreaId = getPlayAreaId(game\x2C turnPlayerNum);\n      const passHint = passRows.length ? ' You may pass (opponent has more activations).' : '';\n      await msg.edit({\n        content: `<@${turnPlayerId}> **Round ${round}** \u2014 Your turn! Activate DCs in <#${playAreaId}>.${passHint}`\x2C\n        components: passRows\x2C\n        allowedMentions: { users: [turnPlayerId] }\x2C\n      }).catch(discordCatch);\n    } catch (err) {\n      console.error('Failed to refresh round message after LiA deployment:'\x2C err);\n    }\n  }\n\n  await interaction.followUp({ content: `Deployed **${dcName}** (${placed} figure(s)) to the **${zone}** zone.`\x2C ephemeral: true }).catch(discordCatch);\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C replyIfGameEnded\x2C dcMessageMeta\x2C dcHealthState\x2C buildDcEmbedAndFiles\x2C getDcPlayAreaComponents\x2C logGameAction\x2C maybeShowEndActivationPhaseButton\x2C client\x2C saveGames\n */\nexport async function handleEndTurn(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    replyIfGameEnded\x2C\n    dcMessageMeta\x2C\n    dcHealthState\x2C\n    renderDcEmbed\x2C\n    getDcPlayAreaComponents\x2C\n    logGameAction\x2C\n    maybeShowEndActivationPhaseButton\x2C\n    client\x2C\n    saveGames\x2C\n  } = ctx;\n  const match = interaction.customId.match(/^end_turn_([^_]+)_(.+)$/);\n  if (!match) return;\n  const gameId = match[1];\n  const dcMsgId = match[2];\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const meta = dcMessageMeta.get(dcMsgId);\n  if (!meta || meta.gameId !== gameId) {\n    await interaction.followUp({ content: 'Invalid End Turn.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const ownerId = getPlayerId(game\x2C meta.playerNum);\n  if (interaction.user.id !== ownerId) {\n    await interaction.followUp({ content: 'Only the player who finished that activation can end the turn.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const pending = game.pendingEndTurn?.[dcMsgId];\n  if (!pending) {\n    await interaction.followUp({ content: 'This turn was already ended.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Gate: activation thread must be ended first (End Activation button in thread)\n  if (game.dcActionsData?.[dcMsgId]) {\n    await interaction.followUp({ content: 'Press **End Activation** in the activation thread first.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const otherPlayerNum = opponentPlayerNum(meta.playerNum);\n  const otherPlayerId = getPlayerId(game\x2C otherPlayerNum);\n  game.dcFinishedPinged = game.dcFinishedPinged || {};\n  game.dcFinishedPinged[dcMsgId] = true;\n  game.lastActivationMsgIdByPlayer = game.lastActivationMsgIdByPlayer || {};\n  game.lastActivationMsgIdByPlayer[meta.playerNum] = dcMsgId;\n  delete game.pendingEndTurn[dcMsgId];\n  if (pending.messageId) {\n    try {\n      const ch = await fetchGameChannel(client\x2C game.generalId);\n      const endTurnMsg = await ch.messages.fetch(pending.messageId);\n      await endTurnMsg.delete().catch(discordCatch);\n    } catch {}\n  }\n  // Deterministic end-of-activation effects now handled by applyEndOfActivationEffects()\n  // in handleDcEndActivation (shared with headless). Only choice-based effects remain here.\n\n  // Trust Goes Both Ways (Jyn Erso): end-of-activation trigger (limit once per round\x2C shared with start-of-activation)\n  {\n    const _tgbwEff = getDcEffects()?.[meta.dcName] || getDcEffects()?.[meta.dcName?.replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n    if ((_tgbwEff?.specialAbilityIds || []).includes('trust_goes_both_ways_jyn')) {\n      const _tgbwRoundKey = `trustBothWays_${dcMsgId}`;\n      if (!game.roundFigureAbilityUsed?.[_tgbwRoundKey]) {\n        const _tgbwDgIndex = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n        const _tgbwSelfFk = `${meta.dcName}-${_tgbwDgIndex}-0`;\n        const _tgbwSelfPos = game.figurePositions?.[meta.playerNum]?.[_tgbwSelfFk];\n        const _tgbwFriendlies = _tgbwSelfPos ? Object.entries(game.figurePositions?.[meta.playerNum] || {})\n          .filter(([fk\x2C fp]) => fk !== _tgbwSelfFk && fp && countGameSpaces(game\x2C _tgbwSelfPos\x2C fp) <= 1) : [];\n        if (_tgbwFriendlies.length > 0) {\n          const ownerId = getPlayerId(game\x2C meta.playerNum);\n          const _tgbwSlice = _tgbwFriendlies.slice(0\x2C 4);\n          const _tgbwLabels = figureChoiceLabels(_tgbwSlice.map(([fk]) => fk));\n          const btns = _tgbwSlice.map(([fk]\x2C i) =>\n            new ButtonBuilder().setCustomId(`act_passive_${game.gameId}_${dcMsgId}_trustboth_${fk}`).setLabel(_tgbwLabels[i]).setStyle(ButtonStyle.Primary)\n          );\n          btns.push(new ButtonBuilder().setCustomId(`act_passive_${game.gameId}_${dcMsgId}_trustboth_skip`).setLabel('Skip').setStyle(ButtonStyle.Secondary));\n          await logGameAction(game\x2C client\x2C `<@${ownerId}> \ud83e\udd1d **Trust Goes Both Ways** (end of activation) \u2014 Choose an adjacent friendly figure. You and that figure each **Recover 1 Damage** and **gain 1 Surge Token**:`\x2C {\n            components: chunkButtonsToRows(btns)\x2C\n            allowedMentions: { users: [ownerId] }\x2C\n          });\n        }\n      }\n    }\n  }\n\n  const actionsData = game.dcActionsData?.[dcMsgId];\n  if (actionsData?.threadId) {\n    try {\n      const thread = await fetchGameChannel(client\x2C actionsData.threadId);\n      await thread.setArchived(true);\n    } catch (err) {\n      console.error('Failed to archive DC activation thread:'\x2C err);\n    }\n    if (game.dcActionsData?.[dcMsgId]) delete game.dcActionsData[dcMsgId];\n    if (game.nextAttacksBonusHits?.[meta.playerNum]) delete game.nextAttacksBonusHits[meta.playerNum];\n    if (game.nextAttacksBonusConditions?.[meta.playerNum]) delete game.nextAttacksBonusConditions[meta.playerNum];\n    if (game.nextAttackBonusSurgeAbilities?.[meta.playerNum]) delete game.nextAttackBonusSurgeAbilities[meta.playerNum];\n    if (game.nextAttackBonusPierce?.[meta.playerNum]) delete game.nextAttackBonusPierce[meta.playerNum];\n    if (game.movementBank?.[dcMsgId]) delete game.movementBank[dcMsgId];\n  }\n  try {\n    const playAreaId = getPlayAreaId(game\x2C meta.playerNum);\n    const playChannel = await fetchGameChannel(client\x2C playAreaId);\n    const dcMsg = await playChannel.messages.fetch(dcMsgId);\n    const { embed\x2C files } = await renderDcEmbed(game\x2C dcMsgId\x2C ctx\x2C { exhausted: true });\n    const components = getDcPlayAreaComponents(dcMsgId\x2C true\x2C game\x2C meta.dcName);\n    await dcMsg.edit({\n      embeds: [embed]\x2C\n      files\x2C\n      components\x2C\n    }).catch(discordCatch);\n  } catch (err) {\n    console.error('Failed to update DC card after End Turn:'\x2C err);\n  }\n\n  // --- Companion activation at end of turn ---\n  {\n    const _compAttachments = game.p1DcAttachments?.[dcMsgId] || game.p2DcAttachments?.[dcMsgId] || [];\n    const _compInfo = getCompanionForDc(meta.dcName\x2C _compAttachments);\n    if (_compInfo && !_compInfo.isCoActivation) {\n      const _compState = game.companionActivatedBefore?.[dcMsgId];\n      if (_compState === 'pending-after' || !_compState) {\n        const _compSummary = formatCompanionStats(_compInfo.companionName\x2C _compInfo.companionStats);\n        await logGameAction(game\x2C client\x2C `\ud83d\udc3e **${_compInfo.companionName} activates NOW** (after **${meta.displayName || meta.dcName}**'s activation).\\nPerform the companion's activation (move\x2C attack\x2C special actions) manually.\\n\\n${_compSummary}`\x2C {\n          phase: 'ACTIVATION'\x2C\n          icon: 'activate'\x2C\n        });\n      }\n    }\n    if (game.companionActivatedBefore?.[dcMsgId]) {\n      delete game.companionActivatedBefore[dcMsgId];\n    }\n  }\n\n  // Son of Skywalker now handled by applyEndOfActivationEffects() in handleDcEndActivation.\n\n  game.currentActivationTurnPlayerId = otherPlayerId;\n  await logGameAction(game\x2C client\x2C `<@${otherPlayerId}> (**Player ${otherPlayerNum}'s turn**) **${pending.displayName}** finished all actions \u2014 your turn to activate a figure!`\x2C {\n    allowedMentions: { users: [otherPlayerId] }\x2C\n    phase: 'ROUND'\x2C\n    icon: 'activate'\x2C\n  });\n  if (game.roundActivationMessageId && game.generalId && !game.roundActivationButtonShown) {\n    try {\n      const ch = await fetchGameChannel(client\x2C game.generalId);\n      const msg = await ch.messages.fetch(game.roundActivationMessageId);\n      const round = game.currentRound || 1;\n      const newCurrentRem = getActivationsRemaining(game\x2C otherPlayerNum) ?? 0;\n      const justActedRem = getActivationsRemaining(game\x2C meta.playerNum) ?? 0;\n      const passRows = [];\n      if (justActedRem > newCurrentRem && newCurrentRem > 0) {\n        passRows.push(new ActionRowBuilder().addComponents(\n          new ButtonBuilder()\n            .setCustomId(`pass_activation_turn_${gameId}`)\n            .setLabel(`Pass (opponent has ${justActedRem - newCurrentRem} more activation${justActedRem - newCurrentRem !== 1 ? 's' : ''} than you)`)\n            .setStyle(ButtonStyle.Secondary)\n        ));\n      }\n      await msg.edit({\n        content: `<@${otherPlayerId}> (**Player ${otherPlayerNum}**) **Round ${round}** \u2014 Your turn to activate!${passRows.length ? ' You may pass back (opponent has more activations).' : ''}`\x2C\n        components: passRows\x2C\n        allowedMentions: { users: [otherPlayerId] }\x2C\n      }).catch(discordCatch);\n    } catch (err) {\n      console.error('Failed to update round message after end turn:'\x2C err);\n    }\n  }\n  await maybeShowEndActivationPhaseButton(game\x2C client);\n  // Field Tactics (Death Trooper): after activation\x2C choose a friendly TROOPER/LEADER within 2 to perform a free attack\n  await maybePromptFieldTactics(game\x2C meta\x2C dcMsgId\x2C logGameAction\x2C client\x2C ctx.findDcMessageIdForFigure);\n  // Lie in Ambush: after opponent activates\x2C check if trigger fires\n  await checkLieInAmbushTrigger(game\x2C meta.playerNum\x2C ctx);\n  saveGames();\n}\n\n/**\n * Handle dc_switch_fig_ \u2014 "Switch Figure" button in multi-figure DG activation thread.\n * Deselects the current figure and shows the figure picker dropdown again.\n */\nexport async function handleDcSwitchFig(interaction\x2C ctx) {\n  const { getGame\x2C dcMessageMeta\x2C updateDcActionsMessage\x2C saveGames\x2C client } = ctx;\n  const msgId = parseCustomId(interaction.customId\x2C 'dc_switch_fig_');\n  const meta = dcMessageMeta.get(msgId);\n  if (!meta) {\n    await interaction.followUp({ content: 'This DC is no longer tracked.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const game = await requireGame(interaction\x2C getGame\x2C meta.gameId);\n  if (!game) return;\n  const ownerId = getPlayerId(game\x2C meta.playerNum);\n  if (interaction.user.id !== ownerId) {\n    await interaction.followUp({ content: 'Only the owner can switch figures.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (game.dcActionsData?.[msgId]) {\n    game.dcActionsData[msgId].selectedFigure = null;\n  }\n  saveGames();\n  await updateDcActionsMessage(game\x2C msgId\x2C client);\n}\n\n/**\n * Handle dc_end_activation_ \u2014 red "End Activation" button on the DC card.\n * Immediately ends the current activation: deletes thread\x2C cleans up state\x2C pings opponent.\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx\n */\nexport async function handleDcEndActivation(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    replyIfGameEnded\x2C\n    dcMessageMeta\x2C\n    renderDcEmbed\x2C\n    getDcPlayAreaComponents\x2C\n    logGameAction\x2C\n    maybeShowEndActivationPhaseButton\x2C\n    client\x2C\n    saveGames\x2C\n  } = ctx;\n  const msgId = parseCustomId(interaction.customId\x2C 'dc_end_activation_');\n  const meta = dcMessageMeta.get(msgId);\n  if (!meta) {\n    await interaction.followUp({ content: 'This DC is no longer tracked.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const game = await requireGame(interaction\x2C getGame\x2C meta.gameId);\n  if (!game) return;\n  if (await replyIfGameEnded(game\x2C interaction)) return;\n  const ownerId = getPlayerId(game\x2C meta.playerNum);\n  if (interaction.user.id !== ownerId) {\n    await interaction.followUp({ content: 'Only the owner can end this activation.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const otherPlayerNum = opponentPlayerNum(meta.playerNum);\n  const otherPlayerId = getPlayerId(game\x2C otherPlayerNum);\n  const displayName = meta.displayName || meta.dcName;\n  const gameId = game.gameId;\n\n  game.dcFinishedPinged = game.dcFinishedPinged || {};\n  game.dcFinishedPinged[msgId] = true;\n\n  // Clean up activation state\n  const actionsData = game.dcActionsData?.[msgId];\n  if (actionsData?.threadId) {\n    try {\n      const thread = await fetchGameChannel(client\x2C actionsData.threadId);\n      await thread.setArchived(true);\n    } catch (err) {\n      console.error('Failed to archive DC activation thread on End Activation:'\x2C err);\n    }\n  }\n  // Build figure keys for only the activated deployment group (not all DGs)\n  const endEff = getDcEffects()?.[meta.dcName];\n  const figCount = endEff?.figures || 1;\n  const dgIndex = (displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '0';\n  const figureKeys = [];\n  for (let fi = 0; fi < figCount; fi++) {\n    figureKeys.push(`${meta.dcName}-${dgIndex}-${fi}`);\n  }\n  cleanupActivation(game\x2C msgId\x2C meta.playerNum\x2C figureKeys);\n  // Weakened: discarded at end of activation (rules: WEAKENED L2967-2968).\n  // Stun is NOT auto-cleared \u2014 figure must spend 1 action (dc_remove_stun_) per rules: STUNNED L2759-2762.\n  if (game.figureConditions && ctx.getDcStats) {\n    const dgIndex = (displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? 1;\n    const figures = ctx.getDcStats(meta.dcName).figures ?? 1;\n    for (let f = 0; f < figures; f++) {\n      const fk = `${meta.dcName}-${dgIndex}-${f}`;\n      if (!game.disarmPermanentWeakened?.[fk]) {\n        filterCondition(game\x2C fk\x2C 'Weaken');\n      }\n    }\n  }\n\n  // End-of-activation deterministic effects (shared with headless)\n  const { applied: _endEffects } = applyEndOfActivationEffects(game\x2C {\n    dcName: meta.dcName\x2C\n    playerNum: meta.playerNum\x2C\n    displayName\x2C\n    msgId\x2C\n  });\n  for (const eff of _endEffects) {\n    await logGameAction(game\x2C client\x2C eff.message\x2C { phase: 'ROUND'\x2C icon: 'activate' });\n  }\n\n  // Update DC card (stays exhausted)\n  try {\n    const playAreaId = getPlayAreaId(game\x2C meta.playerNum);\n    const playChannel = await fetchGameChannel(client\x2C playAreaId);\n    const dcMsg = await playChannel.messages.fetch(msgId);\n    const { embed\x2C files } = await renderDcEmbed(game\x2C msgId\x2C ctx\x2C { exhausted: true });\n    await dcMsg.edit({ embeds: [embed]\x2C files\x2C components: getDcPlayAreaComponents(msgId\x2C true\x2C game\x2C meta.dcName) }).catch(discordCatch);\n  } catch (err) {\n    console.error('Failed to update DC card after End Activation:'\x2C err);\n  }\n\n  // --- Companion activation at end of activation ---\n  // If companion was marked 'pending-after' or was never addressed (player ignored buttons)\x2C activate now\n  {\n    const _compAttachments = game.p1DcAttachments?.[msgId] || game.p2DcAttachments?.[msgId] || [];\n    const _compInfo = getCompanionForDc(meta.dcName\x2C _compAttachments);\n    if (_compInfo && !_compInfo.isCoActivation) {\n      const _compState = game.companionActivatedBefore?.[msgId];\n      if (_compState === 'pending-after' || !_compState) {\n        const _compSummary = formatCompanionStats(_compInfo.companionName\x2C _compInfo.companionStats);\n        await logGameAction(game\x2C client\x2C `\ud83d\udc3e **${_compInfo.companionName} activates NOW** (after **${displayName}**'s activation).\\nPerform the companion's activation (move\x2C attack\x2C special actions) manually.\\n\\n${_compSummary}`\x2C {\n          phase: 'ACTIVATION'\x2C\n          icon: 'activate'\x2C\n        });\n      }\n    }\n    // Clean up companion tracking for this activation\n    if (game.companionActivatedBefore?.[msgId]) {\n      delete game.companionActivatedBefore[msgId];\n    }\n  }\n\n  // Send End Turn button to game log (turn switch happens when player presses it)\n  game.pendingEndTurn = game.pendingEndTurn || {};\n  if (!game.pendingEndTurn[msgId]) {\n    try {\n      const ch = await fetchGameChannel(client\x2C game.generalId);\n      const icon = '\\u26A1';\n      const timestamp = `<t:${Math.floor(Date.now() / 1000)}:t>`;\n      const endTurnBtn = new ActionRowBuilder().addComponents(\n        new ButtonBuilder()\n          .setCustomId(`end_turn_${gameId}_${msgId}`)\n          .setLabel('End Turn')\n          .setStyle(ButtonStyle.Primary)\n      );\n      const endTurnMsg = await ch.send(sanitizeMentions({\n        content: `${icon} ${timestamp} \u2014 <@${ownerId}> (**Player ${meta.playerNum}**) **${displayName}** activation resolved. Press **End Turn** to pass your turn.`\x2C\n        components: [endTurnBtn]\x2C\n        allowedMentions: { users: [ownerId] }\x2C\n      }));\n      game.pendingEndTurn[msgId] = { playerNum: meta.playerNum\x2C displayName\x2C messageId: endTurnMsg.id };\n    } catch (err) {\n      console.error('Failed to send End Turn prompt after End Activation:'\x2C err);\n    }\n  }\n\n  // On a Diplomatic Mission (Skirmish Upgrade\x2C LEADER): exhaust at end of activation if no attack \u2192 choice\n  {\n    const _odmUpgrades = game.p1DcAttachments?.[msgId] || game.p2DcAttachments?.[msgId] || [];\n    const _odmExh = game.exhaustedSkirmishUpgrades?.[msgId] || [];\n    if (cardNameIncludes(_odmUpgrades\x2C 'On a Diplomatic Mission') && !cardNameIncludes(_odmExh\x2C 'On a Diplomatic Mission') && !game.attackPerformedThisActivation?.[msgId]) {\n      const _odmRow = new ActionRowBuilder().addComponents(\n        new ButtonBuilder().setCustomId(`on_diplomatic_${gameId}_${msgId}_mp`).setLabel('+2 MP').setStyle(ButtonStyle.Primary)\x2C\n        new ButtonBuilder().setCustomId(`on_diplomatic_${gameId}_${msgId}_evade`).setLabel('+1 Evade (rest of round)').setStyle(ButtonStyle.Primary)\x2C\n        new ButtonBuilder().setCustomId(`on_diplomatic_${gameId}_${msgId}_vp`).setLabel('+1 VP').setStyle(ButtonStyle.Success)\x2C\n        new ButtonBuilder().setCustomId(`on_diplomatic_${gameId}_${msgId}_skip`).setLabel('Skip').setStyle(ButtonStyle.Secondary)\x2C\n      );\n      await logGameAction(game\x2C client\x2C `<@${ownerId}> **On a Diplomatic Mission** \u2014 No attack this activation. Choose a bonus:`\x2C {\n        components: [_odmRow]\x2C\n        allowedMentions: { users: [ownerId] }\x2C\n      });\n    }\n  }\n  // Clean up attack tracking for this activation\n  if (game.attackPerformedThisActivation?.[msgId]) delete game.attackPerformedThisActivation[msgId];\n\n  // Squad Swarm: after ending activation\x2C offer to activate another DC with the same name (combined cost \u2264 15)\n  if (game.squadSwarmPlayerNum === meta.playerNum) {\n    const _sqDcList = getDcList(game\x2C meta.playerNum) || [];\n    const _sqDcIds = getDcMessageIds(game\x2C meta.playerNum) || [];\n    const sameNameIds = _sqDcIds.filter((id\x2C i) => {\n      if (!id || id === msgId) return false;\n      const dc = _sqDcList[i];\n      if (!dc || dc.defeated || dc.dcName !== meta.dcName) return false;\n      return !ctx.dcExhaustedState?.get(id);\n    });\n    // G4: Track cumulative cost across chained Squad Swarm activations\n    const thisCost = ctx.getDcStats?.(meta.dcName)?.cost ?? 0;\n    const cumulativeCost = (game.squadSwarmCumulativeCost ?? 0) + thisCost;\n    game.squadSwarmCumulativeCost = cumulativeCost;\n    const eligibleIds = sameNameIds.filter((id) => {\n      const dc = _sqDcList[_sqDcIds.indexOf(id)];\n      const candidateCost = dc ? (ctx.getDcStats?.(dc.dcName)?.cost ?? 0) : 0;\n      return (cumulativeCost + candidateCost) <= 15;\n    });\n    if (eligibleIds.length > 0) {\n      const ownerId = getPlayerId(game\x2C meta.playerNum);\n      const btns = eligibleIds.slice(0\x2C 4).map((id) =>\n        new ButtonBuilder()\n          .setCustomId(`squad_swarm_yes_${gameId}_${msgId}_${id}`)\n          .setLabel(`Activate ${ctx.dcMessageMeta?.get(id)?.displayName || meta.dcName}`.slice(0\x2C 80))\n          .setStyle(ButtonStyle.Success)\n      );\n      btns.push(new ButtonBuilder().setCustomId(`squad_swarm_no_${gameId}_${msgId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary));\n      await logGameAction(game\x2C client\x2C `<@${ownerId}> **Squad Swarm** \u2014 activate another **${meta.dcName}** (${cumulativeCost} pts used)?`\x2C {\n        components: [new ActionRowBuilder().addComponents(...btns)]\x2C\n        allowedMentions: { users: [ownerId] }\x2C\n      });\n    } else {\n      // G4: No eligible candidates \u2014 clear cumulative cost\n      delete game.squadSwarmCumulativeCost;\n    }\n  }\n\n  // Lie in Ambush: after opponent activates\x2C check if trigger fires\n  await checkLieInAmbushTrigger(game\x2C meta.playerNum\x2C ctx);\n\n  // Auto-prompt owner for post-activation reaction cards (Change of Plans\x2C Provoke\x2C etc.)\n  try {\n    const reactCards = getPlayableReactionCardsForTiming(game\x2C meta.playerNum\x2C [\n      'afterYouResolveGroupsActivation'\x2C 'afterActivationResolves'\x2C 'endOfActivation'\x2C\n    ]);\n    if (reactCards.length) {\n      const handId = getHandChannelId(game\x2C meta.playerNum);\n      if (handId) {\n        const handCh = await fetchGameChannel(client\x2C handId);\n        if (handCh) await handCh.send({ content: `<@${ownerId}> \u2014 Activation ended! You have ${reactCards.length} reaction card(s) playable now.`\x2C allowedMentions: { users: [ownerId] } }).catch(discordCatch);\n      }\n    }\n  } catch (_endActErr) {\n    console.error('End-activation reaction prompt error:'\x2C _endActErr?.message ?? _endActErr);\n  }\n\n  // Field Tactics (Death Trooper): after activation\x2C choose a friendly TROOPER/LEADER within 2 to perform a free attack\n  await maybePromptFieldTactics(game\x2C meta\x2C msgId\x2C logGameAction\x2C client\x2C ctx.findDcMessageIdForFigure);\n\n  saveGames();\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState\x2C buildDcEmbedAndFiles\x2C getDcPlayAreaComponents\x2C updateActivationsMessage\x2C getActionsCounterContent\x2C getDcActionButtons\x2C getActivationMinimapAttachment\x2C getActivateDcButtons\x2C DC_ACTIONS_PER_ACTIVATION\x2C ThreadAutoArchiveDuration\x2C ACTION_ICONS\x2C pushUndo\x2C client\x2C saveGames\n */\nexport async function handleConfirmActivate(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    dcExhaustedState\x2C dcHealthState\x2C\n    renderDcEmbed\x2C getDcPlayAreaComponents\x2C\n    updateActivationsMessage\x2C getActionsCounterContent\x2C\n    getDcActionButtons\x2C getActivationMinimapAttachment\x2C getActivateDcButtons\x2C\n    DC_ACTIONS_PER_ACTIVATION\x2C ACTION_ICONS\x2C\n    logGameAction\x2C pushUndo\x2C client\x2C saveGames\x2C\n  } = ctx;\n  const dcMessageMeta = ctx.dcMessageMeta;\n  const match = interaction.customId.match(/^confirm_activate_([^_]+)_(.+)_(\\d+)$/);\n  if (!match) return;\n  const [\x2C gameId\x2C msgId\x2C activateCardMsgIdStr] = match;\n  const activateCardMsgId = activateCardMsgIdStr === '0' ? null : activateCardMsgIdStr;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  const meta = dcMessageMeta.get(msgId);\n  if (!meta || meta.gameId !== gameId) return;\n  const ownerId = getPlayerId(game\x2C meta.playerNum);\n  if (interaction.user.id !== ownerId) return;\n  const remaining = getActivationsRemaining(game\x2C meta.playerNum);\n  if (remaining <= 0) {\n    await interaction.followUp({ content: 'No activations remaining.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Force Vision (Kanan): block activation while opponent hasn't picked yet\n  if (game.forceVisionPending && game.forceVisionPending === meta.playerNum) {\n    await interaction.followUp({ content: `\ud83d\udc41\ufe0f **Force Vision** \u2014 You must first choose a group from the Force Vision prompt before activating.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Force Vision (Kanan): enforce forced activation\n  if (game.forceVisionNextActivation && game.forceVisionNextActivation.playerNum === meta.playerNum) {\n    const _fvConfirmDcName = game.forceVisionNextActivation.dcName;\n    if (meta.dcName !== _fvConfirmDcName) {\n      const _fvConfirmDcList = getDcList(game\x2C meta.playerNum) || [];\n      const _fvConfirmActivated = getActivatedDcIndices(game\x2C meta.playerNum) || [];\n      const _fvConfirmIdx = _fvConfirmDcList.findIndex((d) => d.dcName === _fvConfirmDcName);\n      if (_fvConfirmIdx >= 0 && !_fvConfirmActivated.includes(_fvConfirmIdx)) {\n        const _fvConfirmFigs = game.figurePositions?.[meta.playerNum] || {};\n        const _fvConfirmAlive = Object.entries(_fvConfirmFigs).some(([fk\x2C pos]) => fk.startsWith(_fvConfirmDcName + '-') && pos);\n        if (_fvConfirmAlive) {\n          await interaction.followUp({ content: `\ud83d\udc41\ufe0f **Force Vision** \u2014 **${_fvConfirmDcName}** must be the next group to activate\x2C if able.`\x2C ephemeral: true }).catch(discordCatch);\n          return;\n        }\n        game.forceVisionNextActivation = null;\n      } else {\n        game.forceVisionNextActivation = null;\n      }\n    } else {\n      game.forceVisionNextActivation = null;\n    }\n  }\n  // Strength in Numbers: enforce combined deployment cost <= 12\n  const sinData = game.strengthInNumbersData;\n  if (sinData && sinData.playerNum === meta.playerNum) {\n    const candidateCost = ctx.getDcStats?.(meta.dcName)?.cost ?? 0;\n    const combinedCost = (sinData.triggeringGroupCost || 0) + candidateCost;\n    if (combinedCost > 12) {\n      const displayName = meta.displayName || meta.dcName;\n      await interaction.followUp({\n        content: `**Strength in Numbers** \u2014 Combined deployment cost of **${sinData.triggeringGroupName || 'previous group'}** (${sinData.triggeringGroupCost}) + **${displayName}** (${candidateCost}) = **${combinedCost}**\x2C which exceeds the 12-point cap. Choose a cheaper group.`\x2C\n        ephemeral: true\x2C\n      }).catch(discordCatch);\n      return;\n    }\n  }\n  const displayName = meta.displayName || meta.dcName;\n  const playAreaId = getPlayAreaId(game\x2C meta.playerNum);\n  const playChannel = await fetchGameChannel(client\x2C playAreaId);\n  const dcMsg = await playChannel.messages.fetch(msgId);\n  const dcIndex = (getDcMessageIds(game\x2C meta.playerNum) || []).indexOf(msgId);\n  await finalizeActivation({\n    game\x2C gameId\x2C playerNum: meta.playerNum\x2C dcIndex\x2C\n    dcName: meta.dcName\x2C displayName\x2C msgId\x2C ownerId\x2C\n    dcMessage: dcMsg\x2C\n    pushUndo\x2C\n    confirmationMessage: interaction.message\x2C\n    activateCardMsgId\x2C\n    deps: {\n      dcExhaustedState\x2C dcHealthState\x2C dcMessageMeta: ctx.dcMessageMeta\x2C\n      buildDcEmbedAndFiles: ctx.buildDcEmbedAndFiles\x2C\n      renderDcEmbed\x2C getDcPlayAreaComponents\x2C\n      updateActivationsMessage\x2C getActionsCounterContent\x2C\n      getDcActionButtons\x2C getActivationMinimapAttachment\x2C\n      getActivateDcButtons\x2C\n      DC_ACTIONS_PER_ACTIVATION\x2C ACTION_ICONS\x2C\n      logGameAction\x2C saveGames\x2C client\x2C\n      findDcMessageIdForFigure: ctx.findDcMessageIdForFigure\x2C\n      hasLineOfSight: ctx.hasLineOfSight\x2C\n      getMapData: ctx.getMapData\x2C\n      getDcStats: ctx.getDcStats\x2C\n    }\x2C\n  });\n}\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - (none required; just deferUpdate and edit)\n */\nexport async function handleCancelActivate(interaction\x2C _ctx) {\n  const match = interaction.customId.match(/^cancel_activate_([^_]+)_(.+)$/);\n  if (!match) return;\n  const [\x2C gameId\x2C ownerId] = match;\n  if (interaction.user.id !== ownerId) return;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n}\n\n/**\n * Handle activation-passive choice buttons (act_passive_).\n * Covers: Vigor\x2C Responsive\x2C Hunger (Elite token choice)\x2C Tactical Movement\x2C Advanced Weapons Research\x2C\n * Open-Minded\x2C Calming Presence\x2C Wisdom\x2C Trust Goes Both Ways\x2C Token Distribution (Arms Distribution\x2C\n * Long-Laid Plans)\x2C General's Orders\x2C Durasteel Fist\x2C Motivation\x2C Trusted Ally.\n */\nexport async function handleActPassive(interaction\x2C ctx) {\n  await interaction.deferUpdate().catch(discordCatch);\n  const { getGame\x2C dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState\x2C saveGames\x2C logGameAction\x2C client\x2C renderDcEmbed\x2C getDcPlayAreaComponents\x2C processFigureDefeat } = ctx;\n  // Parse: act_passive_{gameId}_{msgId}_{ability}_{choice}\n  const parts = splitCustomId(interaction.customId\x2C 'act_passive_');\n  if (parts.length < 3) return;\n  const gameId = parts[0];\n  const msgId = parts[1];\n  const ability = parts[2];\n  const choice = parts.slice(3).join('_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  const meta = dcMessageMeta?.get(msgId);\n  if (!meta) return;\n  const displayName = meta.displayName || meta.dcName;\n  // Remove buttons from message\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  if (ability === 'vigor') {\n    if (choice === 'mp') {\n      grantMovementBank(game\x2C msgId\x2C 2);\n      await interaction.message.edit({ content: `\u2728 **Vigor** \u2014 **${displayName}** gained **2 MP**.`\x2C components: [] }).catch(discordCatch);\n    } else if (choice === 'block') {\n      const dgIndex = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n      const fk = `${meta.dcName}-${dgIndex}-0`;\n      grantPowerTokens(game\x2C fk\x2C 'Block'\x2C 1);\n      await interaction.message.edit({ content: `\u2728 **Vigor** \u2014 **${displayName}** gained **1 Block Token**.`\x2C components: [] }).catch(discordCatch);\n      if (game.pendingPowerTokenOverflow?.length > 0) {\n        await sendPowerTokenOverflowUI(game\x2C gameId\x2C interaction.channel\x2C meta.playerNum\x2C saveGames);\n      }\n    }\n  } else if (ability === 'responsive') {\n    if (choice === 'mp') {\n      grantMovementBank(game\x2C msgId\x2C 1);\n      await interaction.message.edit({ content: `\ud83c\udfc3 **Responsive** \u2014 **${displayName}** gained **1 MP**.`\x2C components: [] }).catch(discordCatch);\n    } else if (choice === 'heal') {\n      healHp(dcHealthState\x2C game\x2C msgId\x2C 0\x2C 1\x2C meta.playerNum);\n      await interaction.message.edit({ content: `\ud83c\udfc3 **Responsive** \u2014 **${displayName}** recovered **1 Damage**.`\x2C components: [] }).catch(discordCatch);\n    }\n  } else if (ability === 'fulcrum') {\n    if (choice === 'use') {\n      const _fParts = [];\n      for (const pn of [1\x2C 2]) {\n        const deckKey = ccDeckKey(pn);\n        const handKey = ccHandKey(pn);\n        const deck = game[deckKey] || [];\n        if (deck.length > 0) {\n          const card = deck.shift();\n          game[handKey] = [...(game[handKey] || [])\x2C card];\n          _fParts.push(`P${pn} drew 1 CC`);\n        } else {\n          _fParts.push(`P${pn} deck empty`);\n        }\n      }\n      await interaction.message.edit({ content: `\ud83d\udd75\ufe0f **Fulcrum** \u2014 Each player draws 1 Command card. (${_fParts.join('\x2C ')})`\x2C components: [] }).catch(discordCatch);\n    } else {\n      await interaction.message.edit({ content: `\ud83d\udd75\ufe0f **Fulcrum** \u2014 Skipped.`\x2C components: [] }).catch(discordCatch);\n    }\n  } else if (ability === 'hunger') {\n    const dgIndex = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n    const fk = `${meta.dcName}-${dgIndex}-0`;\n    if (choice === 'block') {\n      grantPowerTokens(game\x2C fk\x2C 'Block'\x2C 1);\n      await interaction.message.edit({ content: `\ud83d\udc3b **Hunger** \u2014 **${displayName}** gained 3 MP and **1 Block Token**.`\x2C components: [] }).catch(discordCatch);\n    } else if (choice === 'evade') {\n      grantPowerTokens(game\x2C fk\x2C 'Evade'\x2C 1);\n      await interaction.message.edit({ content: `\ud83d\udc3b **Hunger** \u2014 **${displayName}** gained 3 MP and **1 Evade Token**.`\x2C components: [] }).catch(discordCatch);\n    }\n    if (game.pendingPowerTokenOverflow?.length > 0) {\n      await sendPowerTokenOverflowUI(game\x2C gameId\x2C interaction.channel\x2C meta.playerNum\x2C saveGames);\n    }\n  } else if (ability === 'tacmove') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: `\ud83c\udfaf **Tactical Movement** \u2014 Skipped.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      // choice is the figureKey of the target\n      const targetFk = choice;\n      const targetDcName = dcNameFromFigureKey(targetFk);\n      // Find the target's msgId to add MP to their movement bank\n      let targetMsgId = null;\n      for (const [mId\x2C mMeta] of dcMessageMeta) {\n        if (mMeta.gameId !== gameId) continue;\n        if (mMeta.dcName === targetDcName && mMeta.playerNum === meta.playerNum) {\n          targetMsgId = mId;\n          break;\n        }\n      }\n      grantMovementBank(game\x2C targetMsgId\x2C 2);\n      await interaction.message.edit({ content: `\ud83c\udfaf **Tactical Movement** \u2014 **${targetDcName}** gained **2 MP**.`\x2C components: [] }).catch(discordCatch);\n    }\n  } else if (ability === 'awr') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: `\ud83d\udd2c **Advanced Weapons Research** \u2014 Skipped.`\x2C components: [] }).catch(discordCatch);\n      delete game.pendingAwr;\n    } else {\n      // choice is the figureKey of the target \u2014 now offer Hit or Surge token choice\n      game.pendingAwr = game.pendingAwr || {};\n      game.pendingAwr.targetFk = choice;\n      const targetDcName = dcNameFromFigureKey(choice);\n      const tokenRow = new ActionRowBuilder().addComponents(\n        new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_awrtoken_damage`).setLabel('Damage Token').setStyle(ButtonStyle.Danger)\x2C\n        new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_awrtoken_surge`).setLabel('Surge Token').setStyle(ButtonStyle.Primary)\x2C\n      );\n      await interaction.message.edit({ content: `\ud83d\udd2c **Advanced Weapons Research** \u2014 **${targetDcName}**: Choose token type:`\x2C components: [tokenRow] }).catch(discordCatch);\n    }\n  } else if (ability === 'awrtoken') {\n    const targetFk = game.pendingAwr?.targetFk;\n    if (!targetFk) return;\n    const targetDcName = dcNameFromFigureKey(targetFk);\n    const tokenType = choice === 'damage' ? 'Damage' : 'Surge';\n    grantPowerTokens(game\x2C targetFk\x2C tokenType\x2C 1);\n    delete game.pendingAwr;\n    await interaction.message.edit({ content: `\ud83d\udd2c **Advanced Weapons Research** \u2014 **${targetDcName}** gained **1 ${tokenType} Token**.`\x2C components: [] }).catch(discordCatch);\n    await logGameAction(game\x2C client\x2C `\ud83d\udd2c **Advanced Weapons Research** \u2014 **${targetDcName}** gained **1 ${tokenType} Token**.`\x2C { phase: 'ACTIVATION'\x2C icon: 'card' });\n    if (game.pendingPowerTokenOverflow?.length > 0) {\n      await sendPowerTokenOverflowUI(game\x2C gameId\x2C interaction.channel\x2C meta.playerNum\x2C saveGames);\n    }\n  } else if (ability === 'openminded') {\n    const dgIndex = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n    const fk = `${meta.dcName}-${dgIndex}-0`;\n    if (choice === 'mp') {\n      grantMovementBank(game\x2C msgId\x2C 1);\n      await interaction.message.edit({ content: `\ud83e\udde0 **Open-Minded** \u2014 **${displayName}** gained **1 MP**.`\x2C components: [] }).catch(discordCatch);\n    } else if (choice === 'token') {\n      // Grant 1 Power Token \u2014 player chooses type via power_token_choice_ flow\n      game.figurePowerTokens = game.figurePowerTokens || {};\n      game.figurePowerTokens[fk] = game.figurePowerTokens[fk] || [];\n      game.pendingPowerTokenGrant = { grants: [{ figureKey: fk\x2C figName: meta.dcName\x2C count: 1 }]\x2C channelId: interaction.channelId\x2C playerNum: meta.playerNum };\n      const { ActionRowBuilder: AR\x2C ButtonBuilder: BB\x2C ButtonStyle: BS } = await import('discord.js');\n      const tokenBtns = ['Damage'\x2C 'Surge'\x2C 'Block'\x2C 'Evade'].map(t =>\n        new BB().setCustomId(`power_token_choice_${gameId}_${t.toLowerCase()}`).setLabel(t).setStyle(BS.Secondary)\n      );\n      await interaction.message.edit({ content: `\ud83e\udde0 **Open-Minded** \u2014 **${displayName}**: Choose Power Token type:`\x2C components: [new AR().addComponents(tokenBtns)] }).catch(discordCatch);\n      saveGames();\n      return; // Don't save twice\n    }\n  // --- Calming Presence: pick condition to remove\x2C suffer 1 Strain ---\n  } else if (ability === 'calmpres') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: `\ud83e\uddd8 **Calming Presence** \u2014 Skipped.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      // choice format: figureKey_Condition (e.g. "Rebel Ranger-1-0_Stun")\n      // But since figureKey contains hyphens\x2C we stored it as act_passive_{gameId}_{msgId}_calmpres_{fk}_{condition}\n      // The fk and condition are in the remaining parts after 'calmpres'\n      // parts[3:] = calmpres\x2C fk...\x2C Condition\n      // We need to re-parse from customId since figureKeys have hyphens\n      const fullSuffix = interaction.customId.replace(/^act_passive_[^_]+_[^_]+_calmpres_/\x2C '');\n      const lastUnderscore = fullSuffix.lastIndexOf('_');\n      const condFk = fullSuffix.slice(0\x2C lastUnderscore);\n      const condName = fullSuffix.slice(lastUnderscore + 1);\n      filterCondition(game\x2C condFk\x2C condName);\n      // Apply 1 Strain to the activating figure\n      const dgIndex = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n      const selfFk = `${meta.dcName}-${dgIndex}-0`;\n      reduceHp(dcHealthState\x2C game\x2C msgId\x2C 0\x2C 1\x2C meta.playerNum);\n      const condFkName = dcNameFromFigureKey(condFk);\n      await interaction.message.edit({ content: `\ud83e\uddd8 **Calming Presence** \u2014 Removed **${condName}** from **${condFkName}**. **${displayName}** suffered **1 Strain**.`\x2C components: [] }).catch(discordCatch);\n      await logGameAction?.(game\x2C client\x2C `**Calming Presence** (Yoda) \u2014 Removed ${condName} from ${condFkName}; ${displayName} suffered 1 Strain.`\x2C { phase: 'ACTIVATION'\x2C icon: 'condition' });\n    }\n  // --- Nemik's Manifesto: exhaust for +1 MP\x2C -2 Strain ---\n  } else if (ability === 'nemik') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: `\ud83d\udcdc **Nemik's Manifesto** \u2014 Skipped.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      // choice = 'use_{nmMsgId}'\n      const nmMsgId = interaction.customId.replace(/^act_passive_[^_]+_[^_]+_nemik_use_/\x2C '');\n      // Exhaust the card\n      game.exhaustedSkirmishUpgrades = game.exhaustedSkirmishUpgrades || {};\n      game.exhaustedSkirmishUpgrades[nmMsgId] = [...(game.exhaustedSkirmishUpgrades[nmMsgId] || [])\x2C "Nemik's Manifesto"];\n      // Grant 1 MP\n      grantMovementBank(game\x2C msgId\x2C 1);\n      // Apply 2 Strain to the activating figure\n      const dgIndex = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n      const fk = `${meta.dcName}-${dgIndex}-0`;\n      const figMatch = fk.match(/-(\\d+)$/);\n      const figIdx = figMatch ? parseInt(figMatch[1]\x2C 10) : 0;\n      reduceHp(dcHealthState\x2C game\x2C msgId\x2C figIdx\x2C 2\x2C meta.playerNum);\n      await interaction.message.edit({ content: `\ud83d\udcdc **Nemik's Manifesto** \u2014 **${displayName}** gained **1 MP** and suffered **2 Strain**. (Exhausted)`\x2C components: [] }).catch(discordCatch);\n      await logGameAction?.(game\x2C client\x2C `**Nemik's Manifesto** \u2014 ${displayName} gained 1 MP\x2C suffered 2 Strain. (Exhausted)`\x2C { phase: 'ACTIVATION'\x2C icon: 'card' });\n    }\n  // --- Unshakable: discard harmful condition from cost\u22659 figure\x2C suffer 1 Strain\x2C exhaust ---\n  } else if (ability === 'unshakable') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: `**Unshakable** \u2014 Skipped.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      // Parse figureKey from remaining parts after 'unshakable'\n      const fullSuffix = interaction.customId.replace(/^act_passive_[^_]+_[^_]+_unshakable_/\x2C '');\n      const targetFk = fullSuffix;\n      const targetDcName = dcNameFromFigureKey(targetFk);\n      const conds = game.figureConditions?.[targetFk] || [];\n      const harmful = conds.filter(c => ['Stun'\x2C 'Bleed'\x2C 'Weaken'].includes(c) && !(c === 'Weaken' && game.disarmPermanentWeakened?.[targetFk]));\n      if (harmful.length > 0) {\n        const removedCond = harmful[0];\n        filterCondition(game\x2C targetFk\x2C removedCond);\n        // Apply 1 Strain to the chosen figure\n        const targetMsgId = ctx.findDcMessageIdForFigure?.(gameId\x2C meta.playerNum\x2C targetFk);\n        if (targetMsgId) {\n          const figMatch = targetFk.match(/-(\\d+)$/);\n          const figIdx = figMatch ? parseInt(figMatch[1]\x2C 10) : 0;\n          reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C figIdx\x2C 1\x2C meta.playerNum);\n        }\n        // Exhaust Unshakable\n        const _usDcList2 = getDcList(game\x2C meta.playerNum) || [];\n        const _usDcMsgIds2 = getDcMessageIds(game\x2C meta.playerNum) || [];\n        for (let i = 0; i < _usDcList2.length; i++) {\n          if ((_usDcList2[i]?.dcName || _usDcList2[i]) === '[Unshakable]') {\n            const usMsgId2 = _usDcMsgIds2[i];\n            if (usMsgId2) {\n              game.exhaustedSkirmishUpgrades = game.exhaustedSkirmishUpgrades || {};\n              game.exhaustedSkirmishUpgrades[usMsgId2] = [...(game.exhaustedSkirmishUpgrades[usMsgId2] || [])\x2C 'Unshakable'];\n            }\n            break;\n          }\n        }\n        await interaction.message.edit({ content: `**Unshakable** \u2014 Removed **${removedCond}** from **${targetDcName}**. That figure suffered **1 Strain**.`\x2C components: [] }).catch(discordCatch);\n        await logGameAction?.(game\x2C client\x2C `**Unshakable** \u2014 Removed ${removedCond} from ${targetDcName}; suffered 1 Strain. (Exhausted)`\x2C { phase: 'ACTIVATION'\x2C icon: 'condition' });\n      } else {\n        await interaction.message.edit({ content: `**Unshakable** \u2014 No harmful conditions to remove.`\x2C components: [] }).catch(discordCatch);\n      }\n    }\n  // --- Spectre Cell: exhaust \u2192 choose another friendly figure \u2192 +2 MP + interrupt attack ---\n  } else if (ability === 'spectrecell') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: '**[Spectre Cell]** \u2014 Skipped.'\x2C components: [] }).catch(discordCatch);\n    } else if (choice === 'use') {\n      // Show figure picker for other friendly figures\n      const allFigs = game.figurePositions?.[meta.playerNum] || {};\n      const activatingPrefix = `${meta.dcName}-`;\n      const targets = [];\n      const seenDcNames = new Set();\n      for (const [fk\x2C pos] of Object.entries(allFigs)) {\n        if (!pos) continue;\n        if (fk.startsWith(activatingPrefix)) continue;\n        const dn = dcNameFromFigureKey(fk);\n        if (seenDcNames.has(dn)) continue;\n        seenDcNames.add(dn);\n        targets.push({ fk\x2C dcName: dn });\n      }\n      if (targets.length > 0) {\n        const btns = targets.slice(0\x2C 24).map(({ fk\x2C dcName: dn }) =>\n          new ButtonBuilder()\n            .setCustomId(`sc_fig_pick_${game.gameId}_${msgId}_${fk}`)\n            .setLabel(truncateLabel(dn))\n            .setStyle(ButtonStyle.Primary)\n        );\n        btns.push(new ButtonBuilder().setCustomId(`sc_fig_pick_${game.gameId}_${msgId}_cancel`).setLabel('Cancel').setStyle(ButtonStyle.Secondary));\n        const rows = chunkButtonsToRows(btns);\n        await interaction.message.edit({\n          content: '**[Spectre Cell]** \u2014 Choose another friendly figure to gain 2 MP and may interrupt to attack:'\x2C\n          components: rows.slice(0\x2C 5)\x2C\n        }).catch(discordCatch);\n      } else {\n        await interaction.message.edit({ content: '**[Spectre Cell]** \u2014 No eligible friendly figures.'\x2C components: [] }).catch(discordCatch);\n      }\n    }\n  // --- Wisdom: return 1 CC to bottom of deck ---\n  } else if (ability === 'wisdom') {\n    const handKey = ccHandKey(meta.playerNum);\n    const deckKey = ccDeckKey(meta.playerNum);\n    const hand = game[handKey] || [];\n    const cardIndex = parseInt(choice\x2C 10);\n    const uniqueCards = [...new Set(hand)];\n    if (cardIndex >= 0 && cardIndex < uniqueCards.length) {\n      const cardName = uniqueCards[cardIndex];\n      const idx = hand.indexOf(cardName);\n      if (idx >= 0) {\n        hand.splice(idx\x2C 1);\n        game[handKey] = hand;\n        game[deckKey] = game[deckKey] || [];\n        game[deckKey].push(cardName);\n        await interaction.message.edit({ content: `\ud83e\uddd8 **Wisdom** \u2014 Returned **${cardName}** to the bottom of the deck.`\x2C components: [] }).catch(discordCatch);\n        await logGameAction?.(game\x2C client\x2C `**Wisdom** (Yoda) \u2014 Drew 1 CC\x2C returned 1 CC to bottom of deck.`\x2C { phase: 'ACTIVATION'\x2C icon: 'card' });\n      }\n    }\n  // --- Strategize (Thrawn): discard top of own or opponent's CC deck ---\n  } else if (ability === 'strategize') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: `\ud83e\udde0 **Strategize** \u2014 Chose not to discard.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      const _strIsOwn = choice === 'own';\n      const _strTargetPn = _strIsOwn ? meta.playerNum : opponentPlayerNum(meta.playerNum);\n      const _strDeckKey = ccDeckKey(_strTargetPn);\n      const _strDeck = game[_strDeckKey] || [];\n      if (_strDeck.length > 0) {\n        const _strCard = _strDeck.shift();\n        const _strDiscKey = ccDiscardKey(_strTargetPn);\n        game[_strDiscKey] = game[_strDiscKey] || [];\n        game[_strDiscKey].push(_strCard);\n        await interaction.message.edit({ content: `\ud83e\udde0 **Strategize** \u2014 Discarded **${_strCard}** from the ${_strIsOwn ? 'own' : "opponent's"} deck.`\x2C components: [] }).catch(discordCatch);\n        await logGameAction?.(game\x2C client\x2C `**Strategize** (Thrawn) \u2014 Discarded ${_strCard} from ${_strIsOwn ? 'own' : "opponent's"} command deck.`\x2C { phase: 'ACTIVATION'\x2C icon: 'card' });\n      } else {\n        await interaction.message.edit({ content: `\ud83e\udde0 **Strategize** \u2014 Deck is empty; nothing to discard.`\x2C components: [] }).catch(discordCatch);\n      }\n    }\n  // --- Trust Goes Both Ways: chosen figure gains 1 MP ---\n  } else if (ability === 'trustboth') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: `\ud83e\udd1d **Trust Goes Both Ways** \u2014 Skipped.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      const targetFk = choice;\n      const targetDcName = dcNameFromFigureKey(targetFk);\n      const { figureIndex: targetFigIdx } = parseFigureKey(targetFk);\n      // Find target's msgId for health state\n      let targetMsgId = null;\n      for (const [mId\x2C mMeta] of dcMessageMeta) {\n        if (mMeta.gameId !== gameId) continue;\n        if (mMeta.dcName === targetDcName && mMeta.playerNum === meta.playerNum) {\n          targetMsgId = mId;\n          break;\n        }\n      }\n      // Self (Jyn) figure key\n      const _tgbwDgIndex = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n      const selfFk = `${meta.dcName}-${_tgbwDgIndex}-0`;\n      // Recover 1 Damage from Jyn\n      const selfHeal = healHp(dcHealthState\x2C game\x2C msgId\x2C 0\x2C 1\x2C meta.playerNum);\n      // Recover 1 Damage from target\n      let targetHeal = { healed: 0 };\n      if (targetMsgId) {\n        targetHeal = healHp(dcHealthState\x2C game\x2C targetMsgId\x2C targetFigIdx\x2C 1\x2C meta.playerNum);\n      }\n      // Grant 1 Surge Token to both\n      grantPowerTokens(game\x2C selfFk\x2C 'Surge'\x2C 1);\n      grantPowerTokens(game\x2C targetFk\x2C 'Surge'\x2C 1);\n      // Mark once-per-round\n      const _tgbwRoundKey = `trustBothWays_${msgId}`;\n      game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n      game.roundFigureAbilityUsed[_tgbwRoundKey] = true;\n      const selfName = meta.displayName || meta.dcName;\n      const parts = [];\n      if (selfHeal.healed > 0) parts.push(`**${selfName}** recovered 1 Damage`);\n      if (targetHeal.healed > 0) parts.push(`**${targetDcName}** recovered 1 Damage`);\n      parts.push(`both gained **1 Surge Token**`);\n      await interaction.message.edit({ content: `\ud83e\udd1d **Trust Goes Both Ways** \u2014 ${parts.join('; ')}.`\x2C components: [] }).catch(discordCatch);\n      await logGameAction?.(game\x2C client\x2C `**Trust Goes Both Ways** (Jyn Erso) \u2014 ${parts.join('; ')}.`\x2C { phase: 'ACTIVATION'\x2C icon: 'activate' });\n    }\n  // --- Token Distribution: used by Arms Distribution and Long-Laid Plans ---\n  } else if (ability === 'tokendist') {\n    const pending = game.pendingTokenDistribution;\n    if (!pending) return;\n    if (choice === 'done') {\n      const abilityLabel = pending.ability === 'longlaid' ? 'Long-Laid Plans' : 'Arms Distribution';\n      await interaction.message.edit({ content: `${pending.ability === 'longlaid' ? '\ud83e\udde0' : '\ud83c\udfaf'} **${abilityLabel}** \u2014 Done (distributed ${(pending.originalRemaining || pending.remaining) - pending.remaining} token${((pending.originalRemaining || pending.remaining) - pending.remaining) !== 1 ? 's' : ''}).`\x2C components: [] }).catch(discordCatch);\n      delete game.pendingTokenDistribution;\n    } else {\n      // choice is figureKey \u2014 show token type picker\n      pending.pendingTargetFk = choice;\n      if (!pending.originalRemaining) pending.originalRemaining = pending.remaining;\n      const tokenBtns = pending.tokenTypes.map(t =>\n        new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_tokenpick_${t.toLowerCase()}`).setLabel(t).setStyle(ButtonStyle.Secondary)\n      );\n      const targetDcName = dcNameFromFigureKey(choice);\n      await interaction.message.edit({ content: `Choose token type for **${targetDcName}** (${pending.remaining} remaining):`\x2C components: [new ActionRowBuilder().addComponents(tokenBtns)] }).catch(discordCatch);\n    }\n  } else if (ability === 'tokenpick') {\n    const pending = game.pendingTokenDistribution;\n    if (!pending || !pending.pendingTargetFk) return;\n    const tokenType = choice.charAt(0).toUpperCase() + choice.slice(1);\n    const fk = pending.pendingTargetFk;\n    grantPowerTokens(game\x2C fk\x2C tokenType\x2C 1);\n    pending.remaining--;\n    const targetDcName = dcNameFromFigureKey(fk);\n    delete pending.pendingTargetFk;\n    const abilityLabel = pending.ability === 'longlaid' ? 'Long-Laid Plans' : 'Arms Distribution';\n    const icon = pending.ability === 'longlaid' ? '\ud83e\udde0' : '\ud83c\udfaf';\n    await logGameAction?.(game\x2C client\x2C `**${abilityLabel}** \u2014 ${targetDcName} gained 1 ${tokenType} Token.`\x2C { phase: 'ACTIVATION'\x2C icon: 'activate' });\n    if (game.pendingPowerTokenOverflow?.length > 0) {\n      await sendPowerTokenOverflowUI(game\x2C gameId\x2C interaction.channel\x2C meta.playerNum\x2C saveGames);\n    }\n    if (pending.remaining <= 0) {\n      await interaction.message.edit({ content: `${icon} **${abilityLabel}** \u2014 **${targetDcName}** gained **1 ${tokenType} Token**. Distribution complete.`\x2C components: [] }).catch(discordCatch);\n      delete game.pendingTokenDistribution;\n    } else {\n      // Show figure picker again for next token\n      const _tdDgIndex = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n      const _tdSelfFk = `${meta.dcName}-${_tdDgIndex}-0`;\n      const _tdSelfPos = game.figurePositions?.[meta.playerNum]?.[_tdSelfFk];\n      const _tdFriendlies = _tdSelfPos ? Object.entries(game.figurePositions?.[meta.playerNum] || {})\n        .filter(([fk2\x2C fp]) => fp && countGameSpaces(game\x2C _tdSelfPos\x2C fp) <= 3) : [];\n      if (_tdFriendlies.length > 0) {\n        const btns = _tdFriendlies.slice(0\x2C 4).map(([fk2]) =>\n          new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_tokendist_${fk2}`).setLabel(dcNameFromFigureKey(fk2)).setStyle(ButtonStyle.Primary)\n        );\n        btns.push(new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_tokendist_done`).setLabel('Done').setStyle(ButtonStyle.Secondary));\n        await interaction.message.edit({ content: `${icon} **${abilityLabel}** \u2014 **${targetDcName}** gained **1 ${tokenType} Token**. Pick next figure (${pending.remaining} remaining):`\x2C components: [new ActionRowBuilder().addComponents(btns)] }).catch(discordCatch);\n      } else {\n        await interaction.message.edit({ content: `${icon} **${abilityLabel}** \u2014 **${targetDcName}** gained **1 ${tokenType} Token**. No more eligible figures.`\x2C components: [] }).catch(discordCatch);\n        delete game.pendingTokenDistribution;\n      }\n    }\n  // --- General's Orders: each chosen figure gains 2 MP ---\n  } else if (ability === 'genorders') {\n    const pending = game.pendingGeneralsOrders;\n    if (!pending) return;\n    if (choice === 'done') {\n      await interaction.message.edit({ content: `\ud83c\udf96\ufe0f **General's Orders** \u2014 Done (${pending.chosen.length} figure${pending.chosen.length !== 1 ? 's' : ''} granted MP).`\x2C components: [] }).catch(discordCatch);\n      delete game.pendingGeneralsOrders;\n    } else {\n      const targetFk = choice;\n      const targetDcName = dcNameFromFigureKey(targetFk);\n      let targetMsgId = null;\n      for (const [mId\x2C mMeta] of dcMessageMeta) {\n        if (mMeta.gameId !== gameId) continue;\n        if (mMeta.dcName === targetDcName && mMeta.playerNum === meta.playerNum) {\n          targetMsgId = mId;\n          break;\n        }\n      }\n      grantMovementBank(game\x2C targetMsgId\x2C 2);\n      pending.chosen.push(targetFk);\n      pending.remaining--;\n      await logGameAction?.(game\x2C client\x2C `**General's Orders** \u2014 ${targetDcName} gained 2 MP.`\x2C { phase: 'ACTIVATION'\x2C icon: 'activate' });\n      if (pending.remaining <= 0) {\n        await interaction.message.edit({ content: `\ud83c\udf96\ufe0f **General's Orders** \u2014 **${targetDcName}** gained **2 MP**. All picks used.`\x2C components: [] }).catch(discordCatch);\n        delete game.pendingGeneralsOrders;\n      } else {\n        // Show remaining figure choices (exclude already chosen)\n        const friendlyFigs = Object.entries(game.figurePositions?.[meta.playerNum] || {})\n          .filter(([fk\x2C fp]) => fp && !pending.chosen.includes(fk));\n        const _goSelfDgIdx = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n        const _goSelfFk = `${meta.dcName}-${_goSelfDgIdx}-0`;\n        const filtered = friendlyFigs.filter(([fk]) => fk !== _goSelfFk);\n        if (filtered.length > 0) {\n          const _go2Slice = filtered.slice(0\x2C 4);\n          const _go2Labels = figureChoiceLabels(_go2Slice.map(([fk]) => fk));\n          const btns = _go2Slice.map(([fk]\x2C i) =>\n            new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_genorders_${fk}`).setLabel(_go2Labels[i]).setStyle(ButtonStyle.Primary)\n          );\n          btns.push(new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_genorders_done`).setLabel('Done').setStyle(ButtonStyle.Secondary));\n          await interaction.message.edit({ content: `\ud83c\udf96\ufe0f **General's Orders** \u2014 **${targetDcName}** gained **2 MP**. Pick figure ${2 - pending.remaining + 1} of 2:`\x2C components: [new ActionRowBuilder().addComponents(btns)] }).catch(discordCatch);\n        } else {\n          await interaction.message.edit({ content: `\ud83c\udf96\ufe0f **General's Orders** \u2014 **${targetDcName}** gained **2 MP**. No more eligible figures.`\x2C components: [] }).catch(discordCatch);\n          delete game.pendingGeneralsOrders;\n        }\n      }\n    }\n  // --- Durasteel Fist: roll 1 green die on adjacent target ---\n  // --- Wookiee Avenger free Slam: roll 1 red die on adjacent target ---\n  } else if (ability === 'wookslam') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: `**Wookiee Avenger** \u2014 Free Slam skipped.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      const targetFk = choice;\n      const targetDcName = dcNameFromFigureKey(targetFk);\n      // Mark Slam as used this activation\n      game.wookieeAvengerSlamUsed = game.wookieeAvengerSlamUsed || {};\n      game.wookieeAvengerSlamUsed[msgId] = true;\n      // Track as special action for CC purposes (To the Limit\x2C All in a Day's Work)\n      game.specialActionUsedThisActivation = game.specialActionUsedThisActivation || {};\n      game.specialActionUsedThisActivation[msgId] = (game.specialActionUsedThisActivation[msgId] || 0) + 1;\n      // Roll 1 red die\n      const faces = getDiceData()?.attack?.red;\n      if (!faces?.length) {\n        await interaction.message.edit({ content: `**Wookiee Avenger Slam** \u2014 Roll 1 red die manually and apply results to **${targetDcName}**.`\x2C components: [] }).catch(discordCatch);\n      } else {\n        const face = faces[Math.floor(Math.random() * faces.length)];\n        const hits = face.dmg ?? 0;\n        const surges = face.surge ?? 0;\n        const dieParts = [];\n        if (hits) dieParts.push(`${hits} Hit${hits !== 1 ? 's' : ''}`);\n        if (surges) dieParts.push(`${surges} Surge${surges !== 1 ? 's' : ''}`);\n        const diceResult = dieParts.length ? dieParts.join('\x2C ') : 'blank';\n        const resultParts = [`Rolled: **${diceResult}**`];\n        // Determine target's playerNum\n        let targetPlayerNum = null;\n        for (const pn of [1\x2C 2]) {\n          if (game.figurePositions?.[pn]?.[targetFk]) { targetPlayerNum = pn; break; }\n        }\n        if (hits > 0 && targetPlayerNum) {\n          let targetMsgId = null;\n          for (const [mId\x2C mMeta] of dcMessageMeta) {\n            if (mMeta.gameId !== gameId || mMeta.playerNum !== targetPlayerNum || mMeta.dcName !== targetDcName) continue;\n            targetMsgId = mId;\n            break;\n          }\n          if (targetMsgId) {\n            const fkMatch = targetFk.match(/-(\\d+)-(\\d+)$/);\n            const figIdx = fkMatch ? parseInt(fkMatch[2]\x2C 10) : 0;\n            const res = reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C figIdx\x2C hits\x2C targetPlayerNum);\n            const _wsDefNote = res.newHp <= 0 ? ' **(defeated)**' : '';\n            resultParts.push(`${hits} Damage to **${targetDcName}**${_wsDefNote} (HP: ${res.prevHp} -> ${res.newHp})`);\n            if (res.newHp <= 0 && processFigureDefeat) {\n              await processFigureDefeat(game\x2C {\n                defeatedPlayerNum: targetPlayerNum\x2C\n                figureKey: targetFk\x2C\n                attackerPlayerNum: meta.playerNum\x2C\n                source: 'Wookiee Avenger Slam'\x2C\n              });\n            }\n          } else {\n            resultParts.push(`Apply ${hits} Damage to **${targetDcName}** manually`);\n          }\n        }\n        // SMALL push check: if target is SMALL\x2C alive\x2C and took hits\x2C offer space picker for push\n        const _wsTargetAlive = targetPlayerNum && game.figurePositions?.[targetPlayerNum]?.[targetFk];\n        const targetKws = getDcKeywords(game)?.[targetDcName] || [];\n        const isSmall = !targetKws.some(k => /large|massive/i.test(String(k)));\n        if (isSmall && hits > 0 && _wsTargetAlive) {\n          const _waMapId = game.selectedMap?.id;\n          const _waMs = _waMapId ? getMapData(_waMapId) : null;\n          const _waDgIndex = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n          const _waSelfFk = `${meta.dcName}-${_waDgIndex}-0`;\n          const _waSelfPos = game.figurePositions?.[meta.playerNum]?.[_waSelfFk];\n          if (_waSelfPos && _waMs) {\n            const adjSpaces = _waMs.adjacency?.[String(_waSelfPos).toLowerCase()] || [];\n            const occupiedSet = new Set([...Object.values(game.figurePositions?.[1] || {})\x2C ...Object.values(game.figurePositions?.[2] || {})].filter(Boolean).map(s => String(s).toLowerCase()));\n            const targetCurPos = game.figurePositions?.[targetPlayerNum]?.[targetFk];\n            const validPushSpaces = adjSpaces.filter(s => {\n              const sl = String(s).toLowerCase();\n              return !occupiedSet.has(sl) || (targetCurPos && sl === String(targetCurPos).toLowerCase());\n            });\n            if (validPushSpaces.length > 0) {\n              // Store pending push state\n              game.pendingWookSlamPush = { targetFk\x2C targetPlayerNum\x2C gameId\x2C msgId };\n              const spaceBtns = validPushSpaces.slice(0\x2C 4).map(s =>\n                new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_wookslamspace_${String(s).toLowerCase()}`).setLabel(String(s).toUpperCase()).setStyle(ButtonStyle.Primary)\n              );\n              spaceBtns.push(new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_wookslamspace_skip`).setLabel('Skip push').setStyle(ButtonStyle.Secondary));\n              await interaction.message.edit({ content: `**Wookiee Avenger Slam** \u2014 ${resultParts.join('. ')}. Push **${targetDcName}** to which space?`\x2C components: [new ActionRowBuilder().addComponents(spaceBtns)] }).catch(discordCatch);\n              await logGameAction?.(game\x2C client\x2C `**Wookiee Avenger Slam** \u2014 Rolled ${diceResult} against ${targetDcName}. Push pending.`\x2C { phase: 'ACTIVATION'\x2C icon: 'activate' });\n              saveGames();\n              return; // Don't save again at the end\n            }\n          }\n        }\n        await interaction.message.edit({ content: `**Wookiee Avenger Slam** \u2014 Target: **${targetDcName}**. ${resultParts.join('. ')}.`\x2C components: [] }).catch(discordCatch);\n        await logGameAction?.(game\x2C client\x2C `**Wookiee Avenger Slam** \u2014 Rolled ${diceResult} against ${targetDcName}.`\x2C { phase: 'ACTIVATION'\x2C icon: 'activate' });\n      }\n    }\n  // --- Wookiee Avenger Slam push space chosen ---\n  } else if (ability === 'wookslamspace') {\n    const pending = game.pendingWookSlamPush;\n    if (!pending) {\n      await interaction.message.edit({ content: `**Wookiee Avenger Slam** \u2014 No pending push.`\x2C components: [] }).catch(discordCatch);\n    } else if (choice === 'skip') {\n      delete game.pendingWookSlamPush;\n      await interaction.message.edit({ content: `**Wookiee Avenger Slam** \u2014 Push skipped.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      const { targetFk\x2C targetPlayerNum } = pending;\n      const targetDcName = dcNameFromFigureKey(targetFk);\n      const chosenSpace = String(choice).toLowerCase();\n      pushFigure(game\x2C targetPlayerNum\x2C targetFk\x2C chosenSpace);\n      delete game.pendingWookSlamPush;\n      await interaction.message.edit({ content: `**Wookiee Avenger Slam** \u2014 Pushed **${targetDcName}** to **${chosenSpace.toUpperCase()}**.`\x2C components: [] }).catch(discordCatch);\n      await logGameAction?.(game\x2C client\x2C `**Wookiee Avenger Slam** \u2014 Pushed **${targetDcName}** to **${chosenSpace.toUpperCase()}**.`\x2C { phase: 'ACTIVATION'\x2C icon: 'move' });\n    }\n  // --- Durasteel Fist: roll 1 green die on adjacent target ---\n  } else if (ability === 'durasteelfist') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: `\ud83e\udd1c **Durasteel Fist** \u2014 Skipped.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      const targetFk = choice;\n      const targetDcName = dcNameFromFigureKey(targetFk);\n      game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n      game.roundFigureAbilityUsed[`${meta.dcName}_durasteel_fist_${msgId}`] = true;\n      // Roll 1 green die\n      const faces = getDiceData()?.attack?.green;\n      if (!faces?.length) {\n        await interaction.message.edit({ content: `\ud83e\udd1c **Durasteel Fist** \u2014 Roll 1 green die manually and apply results to **${targetDcName}**.`\x2C components: [] }).catch(discordCatch);\n      } else {\n        const face = faces[Math.floor(Math.random() * faces.length)];\n        const hits = face.dmg ?? 0;\n        const surges = face.surge ?? 0;\n        const dieParts = [];\n        if (hits) dieParts.push(`${hits} Hit${hits !== 1 ? 's' : ''}`);\n        if (surges) dieParts.push(`${surges} Surge${surges !== 1 ? 's' : ''}`);\n        const diceResult = dieParts.length ? dieParts.join('\x2C ') : 'blank';\n        const resultParts = [`Rolled: **${diceResult}**`];\n        // Determine target's playerNum\n        let targetPlayerNum = null;\n        for (const pn of [1\x2C 2]) {\n          if (game.figurePositions?.[pn]?.[targetFk]) { targetPlayerNum = pn; break; }\n        }\n        if (hits > 0 && targetPlayerNum) {\n          // Find target's msgId\n          let targetMsgId = null;\n          for (const [mId\x2C mMeta] of dcMessageMeta) {\n            if (mMeta.gameId !== gameId || mMeta.playerNum !== targetPlayerNum || mMeta.dcName !== targetDcName) continue;\n            targetMsgId = mId;\n            break;\n          }\n          if (targetMsgId) {\n            const fkMatch = targetFk.match(/-(\\d+)-(\\d+)$/);\n            const figIdx = fkMatch ? parseInt(fkMatch[2]\x2C 10) : 0;\n            const res = reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C figIdx\x2C hits\x2C targetPlayerNum);\n            const _dfDefNote = res.newHp <= 0 ? ' **(defeated)**' : '';\n            resultParts.push(`${hits} Damage to **${targetDcName}**${_dfDefNote} (HP: ${res.prevHp} -> ${res.newHp})`);\n            if (res.newHp <= 0 && processFigureDefeat) {\n              await processFigureDefeat(game\x2C {\n                defeatedPlayerNum: targetPlayerNum\x2C\n                figureKey: targetFk\x2C\n                attackerPlayerNum: meta.playerNum\x2C\n                source: 'Durasteel Fist'\x2C\n              });\n            }\n          } else {\n            resultParts.push(`Apply ${hits} Damage to **${targetDcName}** manually`);\n          }\n        }\n        // Surge + SMALL check: push (player chooses push direction \u2014 no space picker for single push)\n        if (surges > 0) {\n          const targetKws = getDcKeywords(game)?.[targetDcName] || [];\n          const isSmall = !targetKws.some(k => /large|massive/i.test(String(k)));\n          if (isSmall) {\n            resultParts.push(`Surge rolled and target is SMALL \u2014 push **${targetDcName}** 1 space`);\n          }\n        }\n        await interaction.message.edit({ content: `\ud83e\udd1c **Durasteel Fist** \u2014 Target: **${targetDcName}**. ${resultParts.join('. ')}.`\x2C components: [] }).catch(discordCatch);\n        await logGameAction?.(game\x2C client\x2C `**Durasteel Fist** \u2014 Rolled ${diceResult} against ${targetDcName}.`\x2C { phase: 'ACTIVATION'\x2C icon: 'activate' });\n      }\n    }\n  // --- Motivation: chosen figure recovers 1 or discards harmful\x2C then gains 1 MP ---\n  } else if (ability === 'motivation') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: `**Motivation** \u2014 Skipped.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      const targetFk = choice;\n      const targetDcName = dcNameFromFigureKey(targetFk);\n      // Exhaust the upgrade\n      game.exhaustedSkirmishUpgrades = game.exhaustedSkirmishUpgrades || {};\n      game.exhaustedSkirmishUpgrades[msgId] = game.exhaustedSkirmishUpgrades[msgId] || [];\n      if (!cardNameIncludes(game.exhaustedSkirmishUpgrades[msgId]\x2C 'Motivation')) {\n        game.exhaustedSkirmishUpgrades[msgId].push('Motivation');\n      }\n      // Store pending and show heal vs discard choice\n      game.pendingMotivation = { targetFk\x2C gameId\x2C msgId\x2C playerNum: meta.playerNum };\n      // Disarm permanent Weakened: exclude locked Weaken from discardable choices\n      const conds = (game.figureConditions?.[targetFk] || []).filter(c => ['Stun'\x2C 'Bleed'\x2C 'Weaken'].includes(c) && !(c === 'Weaken' && game.disarmPermanentWeakened?.[targetFk]));\n      const btns = [\n        new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_motivchoice_heal`).setLabel('Recover 1 Damage').setStyle(ButtonStyle.Primary)\x2C\n      ];\n      if (conds.length > 0) {\n        for (const c of [...new Set(conds)].slice(0\x2C 3)) {\n          btns.push(new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_motivchoice_${c}`).setLabel(`Discard ${c}`).setStyle(ButtonStyle.Danger));\n        }\n      }\n      await interaction.message.edit({ content: `**Motivation** \u2014 **${targetDcName}**: Choose one:`\x2C components: [new ActionRowBuilder().addComponents(btns)] }).catch(discordCatch);\n    }\n  } else if (ability === 'motivchoice') {\n    const pending = game.pendingMotivation;\n    if (!pending) return;\n    const targetFk = pending.targetFk;\n    const targetDcName = dcNameFromFigureKey(targetFk);\n    // Find target's msgId for HP operations\n    let targetMsgId = null;\n    for (const [mId\x2C mMeta] of dcMessageMeta) {\n      if (mMeta.gameId !== gameId || mMeta.dcName !== targetDcName || mMeta.playerNum !== meta.playerNum) continue;\n      targetMsgId = mId;\n      break;\n    }\n    const resultParts = [];\n    if (choice === 'heal') {\n      if (targetMsgId) {\n        const fkMatch = targetFk.match(/-(\\d+)-(\\d+)$/);\n        const figIdx = fkMatch ? parseInt(fkMatch[2]\x2C 10) : 0;\n        healHp(dcHealthState\x2C game\x2C targetMsgId\x2C figIdx\x2C 1\x2C meta.playerNum);\n        resultParts.push('recovered 1 Damage');\n      }\n    } else {\n      // choice is a condition name\n      filterCondition(game\x2C targetFk\x2C choice);\n      resultParts.push(`discarded ${choice}`);\n    }\n    // Grant 1 MP to target\n    if (targetMsgId) {\n      grantMovementBank(game\x2C targetMsgId\x2C 1);\n      resultParts.push('gained 1 MP');\n    }\n    delete game.pendingMotivation;\n    await interaction.message.edit({ content: `**Motivation** \u2014 **${targetDcName}**: ${resultParts.join('\x2C ')}.`\x2C components: [] }).catch(discordCatch);\n    await logGameAction?.(game\x2C client\x2C `**Motivation** \u2014 ${targetDcName}: ${resultParts.join('\x2C ')}.`\x2C { phase: 'ACTIVATION'\x2C icon: 'activate' });\n  // --- Trusted Ally: chosen figure recovers 1 or discards harmful ---\n  } else if (ability === 'trustedally') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: `**Trusted Ally** \u2014 Skipped.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      const targetFk = choice;\n      const targetDcName = dcNameFromFigureKey(targetFk);\n      // Exhaust the upgrade\n      game.exhaustedSkirmishUpgrades = game.exhaustedSkirmishUpgrades || {};\n      game.exhaustedSkirmishUpgrades[msgId] = game.exhaustedSkirmishUpgrades[msgId] || [];\n      if (!cardNameIncludes(game.exhaustedSkirmishUpgrades[msgId]\x2C 'Trusted Ally')) {\n        game.exhaustedSkirmishUpgrades[msgId].push('Trusted Ally');\n      }\n      // Show heal vs discard choice\n      game.pendingTrustedAlly = { targetFk\x2C gameId\x2C msgId\x2C playerNum: meta.playerNum };\n      // Disarm permanent Weakened: exclude locked Weaken from discardable choices\n      const conds = (game.figureConditions?.[targetFk] || []).filter(c => ['Stun'\x2C 'Bleed'\x2C 'Weaken'].includes(c) && !(c === 'Weaken' && game.disarmPermanentWeakened?.[targetFk]));\n      const btns = [\n        new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_tallychoice_heal`).setLabel('Recover 1 Damage').setStyle(ButtonStyle.Primary)\x2C\n      ];\n      if (conds.length > 0) {\n        for (const c of [...new Set(conds)].slice(0\x2C 3)) {\n          btns.push(new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_tallychoice_${c}`).setLabel(`Discard ${c}`).setStyle(ButtonStyle.Danger));\n        }\n      }\n      await interaction.message.edit({ content: `**Trusted Ally** \u2014 **${targetDcName}**: Choose one:`\x2C components: [new ActionRowBuilder().addComponents(btns)] }).catch(discordCatch);\n    }\n  } else if (ability === 'tallychoice') {\n    const pending = game.pendingTrustedAlly;\n    if (!pending) return;\n    const targetFk = pending.targetFk;\n    const targetDcName = dcNameFromFigureKey(targetFk);\n    let targetMsgId = null;\n    for (const [mId\x2C mMeta] of dcMessageMeta) {\n      if (mMeta.gameId !== gameId || mMeta.dcName !== targetDcName || mMeta.playerNum !== meta.playerNum) continue;\n      targetMsgId = mId;\n      break;\n    }\n    if (choice === 'heal') {\n      if (targetMsgId) {\n        const fkMatch = targetFk.match(/-(\\d+)-(\\d+)$/);\n        const figIdx = fkMatch ? parseInt(fkMatch[2]\x2C 10) : 0;\n        healHp(dcHealthState\x2C game\x2C targetMsgId\x2C figIdx\x2C 1\x2C meta.playerNum);\n      }\n      await interaction.message.edit({ content: `**Trusted Ally** \u2014 **${targetDcName}** recovered **1 Damage**.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      filterCondition(game\x2C targetFk\x2C choice);\n      await interaction.message.edit({ content: `**Trusted Ally** \u2014 **${targetDcName}** discarded **${choice}**.`\x2C components: [] }).catch(discordCatch);\n    }\n    delete game.pendingTrustedAlly;\n    await logGameAction?.(game\x2C client\x2C `**Trusted Ally** \u2014 ${targetDcName}: ${choice === 'heal' ? 'recovered 1 Damage' : 'discarded ' + choice}.`\x2C { phase: 'ACTIVATION'\x2C icon: 'activate' });\n  // --- Imperial Retrofitting (I48): exhaust for multi-attack/move\x2C deplete for Focus ---\n  } else if (ability === 'impretro') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: `**Imperial Retrofitting** \u2014 Skipped.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      // choice is 'multiattack_<irMsgId>'\x2C 'move_<irMsgId>'\x2C or 'focus_<irMsgId>'\n      const _irParts = choice.split('_');\n      const _irAction = _irParts[0]; // 'multiattack'\x2C 'move'\x2C or 'focus'\n      const _irCardMsgId = _irParts.slice(1).join('_'); // the IR card's msgId\n      if (_irAction === 'multiattack') {\n        // Exhaust Imperial Retrofitting\n        game.exhaustedSkirmishUpgrades = game.exhaustedSkirmishUpgrades || {};\n        game.exhaustedSkirmishUpgrades[_irCardMsgId] = game.exhaustedSkirmishUpgrades[_irCardMsgId] || [];\n        if (!cardNameIncludes(game.exhaustedSkirmishUpgrades[_irCardMsgId]\x2C 'Imperial Retrofitting')) {\n          game.exhaustedSkirmishUpgrades[_irCardMsgId].push('Imperial Retrofitting');\n        }\n        // Allow multiple attacks this activation for the vehicle\n        game.imperialRetrofittingMultiAttack = game.imperialRetrofittingMultiAttack || {};\n        game.imperialRetrofittingMultiAttack[msgId] = true;\n        await interaction.message.edit({ content: `**Imperial Retrofitting** \u2014 Exhausted. **${displayName}** may perform **multiple attacks** this activation.`\x2C components: [] }).catch(discordCatch);\n        await logGameAction?.(game\x2C client\x2C `**Imperial Retrofitting** exhausted \u2014 **${displayName}** may perform multiple attacks this activation.`\x2C { phase: 'ACTIVATION'\x2C icon: 'card' });\n        // After exhaust\x2C offer deplete for Focus if card is not yet depleted\n        const _irStillAvailable = !(game.p1DepletedDcMessageIds || []).includes(_irCardMsgId) && !(game.p2DepletedDcMessageIds || []).includes(_irCardMsgId);\n        if (_irStillAvailable) {\n          const _irFocusBtns = [\n            new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_impretro_focus_${_irCardMsgId}`).setLabel('IR: Focus (Deplete)').setStyle(ButtonStyle.Danger)\x2C\n            new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_impretro_skip`).setLabel('Skip').setStyle(ButtonStyle.Secondary)\x2C\n          ];\n          await interaction.channel.send({ content: `**Imperial Retrofitting** \u2014 Also deplete for **Focus** before declaring an attack?`\x2C components: [new ActionRowBuilder().addComponents(_irFocusBtns)] }).catch(discordCatch);\n        }\n      } else if (_irAction === 'move') {\n        // Exhaust Imperial Retrofitting\n        game.exhaustedSkirmishUpgrades = game.exhaustedSkirmishUpgrades || {};\n        game.exhaustedSkirmishUpgrades[_irCardMsgId] = game.exhaustedSkirmishUpgrades[_irCardMsgId] || [];\n        if (!cardNameIncludes(game.exhaustedSkirmishUpgrades[_irCardMsgId]\x2C 'Imperial Retrofitting')) {\n          game.exhaustedSkirmishUpgrades[_irCardMsgId].push('Imperial Retrofitting');\n        }\n        // Grant Speed MP to the vehicle\n        const _irSpeed = ctx.getDcStats?.(meta.dcName)?.speed ?? 4;\n        grantMovementBank(game\x2C msgId\x2C _irSpeed);\n        await interaction.message.edit({ content: `**Imperial Retrofitting** \u2014 Exhausted. **${displayName}** performs a move (**${_irSpeed} MP**).`\x2C components: [] }).catch(discordCatch);\n        await logGameAction?.(game\x2C client\x2C `**Imperial Retrofitting** exhausted \u2014 **${displayName}** gains ${_irSpeed} MP (performs a move).`\x2C { phase: 'ACTIVATION'\x2C icon: 'card' });\n        // After exhaust\x2C offer deplete for Focus if card is not yet depleted\n        const _irStillAvailable = !(game.p1DepletedDcMessageIds || []).includes(_irCardMsgId) && !(game.p2DepletedDcMessageIds || []).includes(_irCardMsgId);\n        if (_irStillAvailable) {\n          const _irFocusBtns = [\n            new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_impretro_focus_${_irCardMsgId}`).setLabel('IR: Focus (Deplete)').setStyle(ButtonStyle.Danger)\x2C\n            new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_impretro_skip`).setLabel('Skip').setStyle(ButtonStyle.Secondary)\x2C\n          ];\n          await interaction.channel.send({ content: `**Imperial Retrofitting** \u2014 Also deplete for **Focus** before declaring an attack?`\x2C components: [new ActionRowBuilder().addComponents(_irFocusBtns)] }).catch(discordCatch);\n        }\n      } else if (_irAction === 'focus') {\n        // Deplete Imperial Retrofitting \u2014 mark as depleted\n        if (meta.playerNum === 1) {\n          game.p1DepletedDcMessageIds = game.p1DepletedDcMessageIds || [];\n          if (!game.p1DepletedDcMessageIds.includes(_irCardMsgId)) game.p1DepletedDcMessageIds.push(_irCardMsgId);\n        } else {\n          game.p2DepletedDcMessageIds = game.p2DepletedDcMessageIds || [];\n          if (!game.p2DepletedDcMessageIds.includes(_irCardMsgId)) game.p2DepletedDcMessageIds.push(_irCardMsgId);\n        }\n        // Apply Focus to the vehicle figure\n        const _irDgIdx = (displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n        const _irFigKey = `${meta.dcName}-${_irDgIdx}-0`;\n        applyCondition(game\x2C _irFigKey\x2C 'Focus');\n        await interaction.message.edit({ content: `**Imperial Retrofitting** \u2014 Depleted. **${displayName}** becomes **Focused**.`\x2C components: [] }).catch(discordCatch);\n        await logGameAction?.(game\x2C client\x2C `**Imperial Retrofitting** depleted \u2014 **${displayName}** becomes Focused.`\x2C { phase: 'ACTIVATION'\x2C icon: 'card' });\n      }\n    }\n  } else if (ability === 'citadel') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: `**Imperial Citadel** \u2014 Skipped.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      // choice is 'token_<type>' e.g. 'token_focus'\x2C 'token_block'\n      const _icType = choice.replace('token_'\x2C '');\n      const _icTokens = game.imperialCitadelTokens || {};\n      if ((_icTokens[_icType] || 0) > 0) {\n        _icTokens[_icType]--;\n        game.imperialCitadelTokens = _icTokens;\n        const dgIndex = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n        const fk = `${meta.dcName}-${dgIndex}-0`;\n        grantPowerTokens(game\x2C fk\x2C _icType.charAt(0).toUpperCase() + _icType.slice(1)\x2C 1);\n        await interaction.message.edit({ content: `**Imperial Citadel** \u2014 **${displayName}** gained 1 **${_icType.charAt(0).toUpperCase() + _icType.slice(1)} Token** from the Citadel.`\x2C components: [] }).catch(discordCatch);\n        await logGameAction?.(game\x2C client\x2C `**Imperial Citadel** \u2014 **${displayName}** gained 1 ${_icType.charAt(0).toUpperCase() + _icType.slice(1)} Token from the Citadel.`\x2C { phase: 'ACTIVATION'\x2C icon: 'card' });\n        // Refresh Citadel play area embed to show updated token counts\n        try {\n          const _icDcListRefresh = getDcList(game\x2C meta.playerNum) || [];\n          const _icMsgIdsRefresh = getDcMessageIds(game\x2C meta.playerNum) || [];\n          const _icIdx = _icDcListRefresh.findIndex(dc => dc?.dcName === '[Imperial Citadel]');\n          if (_icIdx >= 0 && _icMsgIdsRefresh[_icIdx]) {\n            const _icMsgId = _icMsgIdsRefresh[_icIdx];\n            const _icChId = getPlayAreaId(game\x2C meta.playerNum);\n            const _icCh = await fetchGameChannel(client\x2C _icChId);\n            const _icMsg = await _icCh.messages.fetch(_icMsgId);\n            const _icExh = dcExhaustedState?.get(_icMsgId) || false;\n            const { embed: _icEmb\x2C files: _icFiles } = await renderDcEmbed(game\x2C _icMsgId\x2C ctx);\n            const _icComps = getDcPlayAreaComponents(_icMsgId\x2C _icExh\x2C game\x2C '[Imperial Citadel]');\n            await _icMsg.edit({ embeds: [_icEmb]\x2C files: _icFiles?.length ? _icFiles : []\x2C components: _icComps }).catch(discordCatch);\n          }\n        } catch (_icErr) {\n          console.error('Failed to refresh Imperial Citadel embed:'\x2C _icErr);\n        }\n        if (game.pendingPowerTokenOverflow?.length > 0) {\n          await sendPowerTokenOverflowUI(game\x2C gameId\x2C interaction.channel\x2C meta.playerNum\x2C saveGames);\n        }\n      } else {\n        await interaction.message.edit({ content: `**Imperial Citadel** \u2014 No ${_icType} tokens remaining.`\x2C components: [] }).catch(discordCatch);\n      }\n    }\n  } else if (ability === 'unstabledev') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: `\ud83d\udd27 **Unstable Devices** \u2014 Skipped.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      // choice = figureKey\n      const targetFk = choice;\n      const targetDcName = dcNameFromFigureKey(targetFk);\n      game.deviceTokens = game.deviceTokens || {};\n      game.deviceTokens[targetFk] = (game.deviceTokens[targetFk] || 0) + 1;\n      game.unstableDevicesUsedThisActivation = game.unstableDevicesUsedThisActivation || {};\n      game.unstableDevicesUsedThisActivation[msgId] = true;\n      await interaction.message.edit({ content: `\ud83d\udd27 **Unstable Devices** \u2014 **${targetDcName}** gains **1 Device token** (now ${game.deviceTokens[targetFk]}).`\x2C components: [] }).catch(discordCatch);\n      await logGameAction?.(game\x2C client\x2C `\ud83d\udd27 **Unstable Devices** \u2014 **${targetDcName}** gains 1 Device token (now ${game.deviceTokens[targetFk]}).`\x2C { phase: 'ACTIVATION'\x2C icon: 'activate' });\n    }\n  } else if (ability === 'droidkit') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: `\ud83e\udd16 **Droid Kit** \u2014 Skipped.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      const tokenMap = { damage: 'Damage'\x2C surge: 'Surge'\x2C block: 'Block'\x2C evade: 'Evade' };\n      const tokenType = tokenMap[choice];\n      if (tokenType) {\n        const dgIndex = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n        const fk = `${meta.dcName}-${dgIndex}-0`;\n        grantPowerTokens(game\x2C fk\x2C tokenType\x2C 1);\n        await interaction.message.edit({ content: `\ud83e\udd16 **Droid Kit** \u2014 **${displayName}** gained **1 ${tokenType} Token**.`\x2C components: [] }).catch(discordCatch);\n        await logGameAction?.(game\x2C client\x2C `\ud83e\udd16 **Droid Kit** \u2014 **${displayName}** gained 1 ${tokenType} Token.`\x2C { phase: 'ACTIVATION'\x2C icon: 'activate' });\n      }\n    }\n  // --- Conspire (Senator form): distribute Focus tokens to friendlies within 1 space ---\n  } else if (ability === 'conspire') {\n    if (choice === 'skip') {\n      delete game.pendingConspire;\n      await interaction.message.edit({ content: `\ud83d\udde3\ufe0f **Conspire** \u2014 Skipped.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      const targetFk = choice;\n      const targetDcName = dcNameFromFigureKey(targetFk);\n      grantPowerTokens(game\x2C targetFk\x2C 'Damage'\x2C 1);\n      await interaction.message.edit({ content: `\ud83d\udde3\ufe0f **Conspire** \u2014 **${targetDcName}** gained **1 Focus (Damage) Token**.`\x2C components: [] }).catch(discordCatch);\n      await logGameAction?.(game\x2C client\x2C `\ud83d\udde3\ufe0f **Conspire** \u2014 **${targetDcName}** gained 1 Focus (Damage) Token.`\x2C { phase: 'ACTIVATION'\x2C icon: 'activate' });\n      // If more tokens to distribute\x2C show picker again\n      if (game.pendingConspire) {\n        game.pendingConspire.tokensRemaining = (game.pendingConspire.tokensRemaining || 1) - 1;\n        if (game.pendingConspire.tokensRemaining > 0) {\n          const _conFk = game.pendingConspire.senderFk;\n          const _conPos = game.figurePositions?.[meta.playerNum]?.[_conFk];\n          if (_conPos) {\n            const { getMapData: _gms } = await import('../data-loader.js');\n            const _conMs = _gms(game.selectedMap?.id);\n            const _conAdj = (_conMs?.adjacency?.[String(_conPos).toLowerCase()] || []).map(s => String(s).toLowerCase());\n            const _conFriendlies = Object.entries(game.figurePositions?.[meta.playerNum] || {})\n              .filter(([fk2\x2C pos2]) => fk2 !== _conFk && pos2 && _conAdj.includes(String(pos2).toLowerCase()));\n            if (_conFriendlies.length > 0) {\n              const _conSlice = _conFriendlies.slice(0\x2C 4);\n              const _conLabels = figureChoiceLabels(_conSlice.map(([fk2]) => fk2));\n              const btns = _conSlice.map(([fk2]\x2C i) =>\n                new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_conspire_${fk2}`).setLabel(_conLabels[i]).setStyle(ButtonStyle.Primary)\n              );\n              btns.push(new ButtonBuilder().setCustomId(`act_passive_${gameId}_${msgId}_conspire_skip`).setLabel('Done').setStyle(ButtonStyle.Secondary));\n              const thread = interaction.channel;\n              await thread.send({ content: `\ud83d\udde3\ufe0f **Conspire** \u2014 ${game.pendingConspire.tokensRemaining} Focus token(s) remaining. Choose a figure:`\x2C components: [new ActionRowBuilder().addComponents(btns)] }).catch(discordCatch);\n              saveGames();\n              return;\n            }\n          }\n        }\n        delete game.pendingConspire;\n      }\n    }\n  // --- Shields Up (Soldier form): place energy shield in adjacent space ---\n  } else if (ability === 'shieldsup') {\n    if (choice === 'skip') {\n      await interaction.message.edit({ content: `\ud83d\udee1\ufe0f **Shields Up** \u2014 Skipped.`\x2C components: [] }).catch(discordCatch);\n    } else {\n      const space = choice.toLowerCase();\n      game.ancillaryTokens = game.ancillaryTokens || {};\n      game.ancillaryTokens.energyShield = game.ancillaryTokens.energyShield || [];\n      game.ancillaryTokens.energyShield.push(space);\n      // Track as special action for CC purposes\n      game.specialActionUsedThisActivation = game.specialActionUsedThisActivation || {};\n      game.specialActionUsedThisActivation[msgId] = (game.specialActionUsedThisActivation[msgId] || 0) + 1;\n      await interaction.message.edit({ content: `\ud83d\udee1\ufe0f **Shields Up** \u2014 Energy shield placed at **${space.toUpperCase()}**.`\x2C components: [] }).catch(discordCatch);\n      await logGameAction?.(game\x2C client\x2C `\ud83d\udee1\ufe0f **Shields Up** \u2014 Energy shield placed at **${space.toUpperCase()}**.`\x2C { phase: 'ACTIVATION'\x2C icon: 'activate' });\n    }\n  } else if (ability === 'companionbefore') {\n    // Player chose to activate companion BEFORE the main group\n    const _compAttachments = game.p1DcAttachments?.[msgId] || game.p2DcAttachments?.[msgId] || [];\n    const _compInfo = getCompanionForDc(meta.dcName\x2C _compAttachments);\n    if (_compInfo) {\n      game.companionActivatedBefore = game.companionActivatedBefore || {};\n      game.companionActivatedBefore[msgId] = 'before';\n      const _compSummary = formatCompanionStats(_compInfo.companionName\x2C _compInfo.companionStats);\n      await interaction.message.edit({\n        content: `\ud83d\udc3e **${_compInfo.companionName} activates NOW** (before **${displayName}**).\\nPerform the companion's activation (move\x2C attack\x2C special actions) manually\x2C then continue with **${meta.dcName}**'s activation.\\n\\n${_compSummary}`\x2C\n        components: []\x2C\n      }).catch(discordCatch);\n      await logGameAction?.(game\x2C client\x2C `\ud83d\udc3e **${_compInfo.companionName}** activates **before** **${displayName}**.`\x2C { phase: 'ACTIVATION'\x2C icon: 'activate' });\n    }\n  } else if (ability === 'companionafter') {\n    // Player chose to skip \u2014 companion will activate after the main group's activation ends\n    const _compAttachments = game.p1DcAttachments?.[msgId] || game.p2DcAttachments?.[msgId] || [];\n    const _compInfo = getCompanionForDc(meta.dcName\x2C _compAttachments);\n    if (_compInfo) {\n      game.companionActivatedBefore = game.companionActivatedBefore || {};\n      game.companionActivatedBefore[msgId] = 'pending-after'; // Will activate at end\n      await interaction.message.edit({\n        content: `\ud83d\udc3e **${_compInfo.companionName}** will activate **after** **${displayName}**'s activation ends.`\x2C\n        components: []\x2C\n      }).catch(discordCatch);\n    }\n  }\n  saveGames();\n}\n\n/**\n * Handle field_tactics_pick_ \u2014 player chose a figure (or skip) for Field Tactics interrupt attack.\n * Button format: field_tactics_pick_{gameId}_{triggerMsgId}_{figureKey|skip}\n */\nexport async function handleFieldTacticsPick(interaction\x2C ctx) {\n  const { getGame\x2C dcMessageMeta\x2C logGameAction\x2C saveGames\x2C client } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'field_tactics_pick_');\n  // Format: gameId_triggerMsgId_figureKey (figureKey may contain underscores \u2014 but figure keys use hyphens)\n  // Actually: gameId and triggerMsgId are snowflake-like\x2C figureKey is the rest\n  const gameId = parts[0];\n  const triggerMsgId = parts[1];\n  const chosenValue = parts.slice(2).join('_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  if (chosenValue === 'skip') {\n    await interaction.message.edit({ content: '**Field Tactics** \u2014 Skipped.'\x2C components: [] }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n  const figureKey = chosenValue;\n  const triggerMeta = dcMessageMeta.get(triggerMsgId);\n  if (!triggerMeta) {\n    await interaction.followUp({ content: '**Field Tactics** \u2014 Could not resolve trigger DC.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const findDcMsgIdForFigure = ctx.findDcMessageIdForFigure;\n  const chosenMsgId = findDcMsgIdForFigure ? findDcMsgIdForFigure(gameId\x2C triggerMeta.playerNum\x2C figureKey) : null;\n  if (chosenMsgId) {\n    game.pendingFieldTactics = { forMsgId: chosenMsgId\x2C chosenFigureKey: figureKey\x2C triggeredByMsgId: triggerMsgId };\n  }\n  const ftRoundKey = `fieldTactics_${triggerMsgId}`;\n  game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n  game.roundFigureAbilityUsed[ftRoundKey] = true;\n  const chosenName = dcNameFromFigureKey(figureKey);\n  await interaction.message.edit({ content: `**Field Tactics** \u2014 **${chosenName}** may interrupt to perform a free attack. Use their **Attack** button.`\x2C components: [] }).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `**Field Tactics** \u2014 **${chosenName}** may interrupt to perform a free attack. Use their **Attack** button.`\x2C { phase: 'ROUND'\x2C icon: 'activate' });\n  saveGames();\n}\n\n/**\n * Handle Force Vision pick: opponent chooses which of their groups must activate next.\n * Button prefix: fv_pick_{gameId}_{oppPlayerNum}_{dcIndex}\n */\nexport async function handleForceVisionPick(interaction\x2C ctx) {\n  await interaction.deferUpdate().catch(discordCatch);\n  const { getGame\x2C logGameAction\x2C saveGames\x2C client } = ctx;\n  const match = interaction.customId.match(/^fv_pick_([^_]+)_(\\d+)_(\\d+)$/);\n  if (!match) return;\n  const [\x2C gameId\x2C oppNumStr\x2C dcIndexStr] = match;\n  const oppNum = parseInt(oppNumStr\x2C 10);\n  const dcIndex = parseInt(dcIndexStr\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  const clickerId = interaction.user.id;\n  if (!canActAsPlayer(game\x2C clickerId\x2C oppNum)) {\n    await interaction.followUp({ content: 'Only the affected player can pick.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const dcList = getDcList(game\x2C oppNum) || [];\n  const dc = dcList[dcIndex];\n  if (!dc) {\n    await interaction.followUp({ content: 'Group not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const displayName = dc.displayName || dc.dcName;\n  // Store the forced activation and clear the pending flag\n  game.forceVisionNextActivation = { playerNum: oppNum\x2C dcName: dc.dcName };\n  game.forceVisionPending = null;\n  // Remove buttons from message\n  await interaction.message.edit({\n    content: `\ud83d\udc41\ufe0f **Force Vision** \u2014 <@${clickerId}> chose **${displayName}**. That group must be activated next\x2C if possible.`\x2C\n    components: []\x2C\n    allowedMentions: { users: [] }\x2C\n  }).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `\ud83d\udc41\ufe0f **Force Vision** \u2014 **${displayName}** must be activated next by Player ${oppNum}\x2C if possible.`\x2C { phase: 'ROUND'\x2C icon: 'activate' });\n  saveGames();\n}\n\n/**\n * Heroic Effort: player picks a CC from hand to place on bottom of deck.\n */\nexport async function handleHeroicEffortReturn(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C updateHandVisualMessage\x2C logGameAction\x2C client } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'heroic_effort_return_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const cardIdx = parseInt(parts[2]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!game.pendingHeroicEffortReturn?.[playerNum]) {\n    await interaction.followUp({ content: 'No Heroic Effort return pending.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const hKey = ccHandKey(playerNum);\n  const dKey = ccDeckKey(playerNum);\n  const hand = game[hKey] || [];\n  if (cardIdx < 0 || cardIdx >= hand.length) {\n    await interaction.followUp({ content: 'Invalid card selection.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const cardName = hand[cardIdx];\n  hand.splice(cardIdx\x2C 1);\n  game[hKey] = hand;\n  game[dKey] = [...(game[dKey] || [])\x2C cardName];\n  delete game.pendingHeroicEffortReturn[playerNum];\n  if (Object.keys(game.pendingHeroicEffortReturn).length === 0) delete game.pendingHeroicEffortReturn;\n  await interaction.message.edit({\n    content: `**Heroic Effort** \u2014 Placed **${cardName}** on the bottom of your deck.`\x2C\n    components: []\x2C\n  }).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `**Heroic Effort** \u2014 P${playerNum} returned 1 Command card to deck bottom.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  if (updateHandVisualMessage) await updateHandVisualMessage(game\x2C playerNum\x2C client);\n  saveGames();\n}\n\n/**\n * Scavenged Weaponry: player picks which friendly Droid/Vehicle to transfer the attachment to.\n */\nexport async function handleScavWeaponTransfer(interaction\x2C ctx) {\n  await interaction.deferUpdate().catch(discordCatch);\n  const { getGame\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'scav_weapon_transfer_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const targetIdx = parseInt(parts[2]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const pending = game.pendingScavengedWeaponryTransfer;\n  if (!pending || pending.playerNum !== playerNum) {\n    await interaction.followUp({ content: 'No Scavenged Weaponry transfer pending.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const target = pending.eligible[targetIdx];\n  if (!target) {\n    await interaction.followUp({ content: 'Invalid target.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const attKey = playerNum === 1 ? 'p1DcAttachments' : 'p2DcAttachments';\n  game[attKey][target.msgId] = [...(game[attKey][target.msgId] || [])\x2C 'Scavenged Weaponry'];\n  delete game.pendingScavengedWeaponryTransfer;\n  await interaction.message.edit({\n    content: `**Scavenged Weaponry** \u2014 Transferred to **${target.displayName}**.`\x2C\n    components: []\x2C\n  }).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `**Scavenged Weaponry** \u2014 Transferred to **${target.displayName}** after defeat.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  saveGames();\n}\n\n/**\n * Handle sc_fig_pick_ \u2014 player picks target figure for Spectre Cell exhaust ability.\n * customId: sc_fig_pick_{gameId}_{activatingMsgId}_{figureKey|cancel}\n */\nexport async function handleScFigPick(interaction\x2C ctx) {\n  await interaction.deferUpdate().catch(discordCatch);\n  const { getGame\x2C dcMessageMeta\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  // Parse: sc_fig_pick_{gameId}_{activatingMsgId}_{rest}\n  const full = parseCustomId(interaction.customId\x2C 'sc_fig_pick_');\n  const firstUs = full.indexOf('_');\n  const gameId = full.slice(0\x2C firstUs);\n  const rest = full.slice(firstUs + 1);\n  const secondUs = rest.indexOf('_');\n  const activatingMsgId = rest.slice(0\x2C secondUs);\n  const target = rest.slice(secondUs + 1);\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n\n  if (target === 'cancel') {\n    await interaction.message.edit({ content: '**[Spectre Cell]** \u2014 Cancelled.'\x2C components: [] }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n\n  const meta = dcMessageMeta.get(activatingMsgId);\n  if (!meta) return;\n\n  const targetFk = target;\n  const targetDcName = dcNameFromFigureKey(targetFk);\n\n  // Exhaust Spectre Cell\n  const dcList = getDcList(game\x2C meta.playerNum) || [];\n  const dcMsgIds = getDcMessageIds(game\x2C meta.playerNum) || [];\n  for (let i = 0; i < dcList.length; i++) {\n    if ((dcList[i]?.dcName || dcList[i]) === '[Spectre Cell]') {\n      const scMsgId = dcMsgIds[i];\n      if (scMsgId) {\n        game.exhaustedSkirmishUpgrades = game.exhaustedSkirmishUpgrades || {};\n        game.exhaustedSkirmishUpgrades[scMsgId] = [...(game.exhaustedSkirmishUpgrades[scMsgId] || [])\x2C 'Spectre Cell'];\n      }\n      break;\n    }\n  }\n\n  // Grant 2 MP to target figure \u2014 find target's msgId\n  let targetMsgId = null;\n  for (const [mId\x2C mMeta] of dcMessageMeta) {\n    if (mMeta.gameId !== gameId) continue;\n    if (mMeta.dcName === targetDcName && mMeta.playerNum === meta.playerNum) {\n      targetMsgId = mId;\n      break;\n    }\n  }\n  grantMovementBank(game\x2C targetMsgId\x2C 2);\n\n  await interaction.message.edit({\n    content: `**[Spectre Cell]** \u2014 **${targetDcName}** gains 2 MP and may interrupt to perform an attack. (Exhausted)`\x2C\n    components: []\x2C\n  }).catch(discordCatch);\n  await logGameAction?.(game\x2C client\x2C `**[Spectre Cell]** \u2014 ${targetDcName} gains 2 MP\x2C may interrupt attack. (Exhausted)`\x2C { phase: 'ACTIVATION'\x2C icon: 'card' });\n  saveGames();\n}\n\n/**\n * Hair Trigger: use interrupt attack\n */\nexport async function handleHairTriggerUse(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C logGameAction } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  // hair_trigger_use_{gameId}_{htMsgId}_{figureKey}\n  const suffix = parseCustomId(interaction.customId\x2C 'hair_trigger_use_');\n  const parts = suffix.split('_');\n  const gameId = parts[0];\n  const htMsgId = parts[1];\n  const figureKey = parts.slice(2).join('_');\n  const game = getGame(gameId);\n  if (!game) return;\n  const htOwnerPN = game.figurePositions?.[1]?.[figureKey] ? 1 : (game.figurePositions?.[2]?.[figureKey] ? 2 : null);\n  if (!htOwnerPN) return;\n  if (interaction.user.id !== getPlayerId(game\x2C htOwnerPN)) return;\n  const htKey = `hairTrigger_${figureKey}`;\n  game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n  game.roundFigureAbilityUsed[htKey] = true;\n  // Grant free attack\n  game.freeAttackBonusPending = game.freeAttackBonusPending || {};\n  game.freeAttackBonusPending[htMsgId] = true;\n  const htDcName = dcNameFromFigureKey(figureKey);\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  await interaction.followUp({\n    content: `**Hair Trigger** \u2014 **${htDcName}** interrupts! Use the **Attack** button on your DC card to perform a free attack.`\x2C\n  }).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `**Hair Trigger** \u2014 **${htDcName}** interrupts to perform a free attack.`\x2C { phase: 'ACTIVATION'\x2C icon: 'attack' });\n  saveGames();\n}\n\n/**\n * Hair Trigger: skip\n */\nexport async function handleHairTriggerSkip(interaction\x2C ctx) {\n  const { getGame\x2C saveGames } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  // hair_trigger_skip_{gameId}_{figureKey}\n  const suffix = parseCustomId(interaction.customId\x2C 'hair_trigger_skip_');\n  const parts = suffix.split('_');\n  const gameId = parts[0];\n  const game = getGame(gameId);\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  if (game) saveGames();\n}\n\n/**\n * It Will Be Alright: Use \u2014 show figure picker for friendly figures within 2 spaces to sacrifice.\n */\nexport async function handleItWillBeAlrightUse(interaction\x2C ctx) {\n  const { getGame\x2C dcMessageMeta\x2C dcHealthState\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  // iwba_use_{gameId}_{msgId}\n  const m = interaction.customId.match(/^iwba_use_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C msgId] = m;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  const meta = dcMessageMeta?.get(msgId);\n  if (!meta) return;\n  const displayName = meta.displayName || meta.dcName;\n\n  const dgIndex = (displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n  const selfFk = `Cassian Andor-${dgIndex}-0`;\n  const selfPos = game.figurePositions?.[meta.playerNum]?.[selfFk];\n\n  // Find eligible targets within 2 spaces\n  const targets = [];\n  for (const [fk\x2C pos] of Object.entries(game.figurePositions?.[meta.playerNum] || {})) {\n    if (!pos || fk === selfFk) continue;\n    if (countGameSpaces(game\x2C selfPos\x2C pos) > 2) continue;\n    const fkDcName = dcNameFromFigureKey(fk);\n    const fkMsgId = ctx.findDcMessageIdForFigure(gameId\x2C meta.playerNum\x2C fk);\n    if (!fkMsgId) continue;\n    const fkMatch = fk.match(/-(\\d+)-(\\d+)$/);\n    const fkFigIdx = fkMatch ? parseInt(fkMatch[2]\x2C 10) : 0;\n    const fkEntry = dcHealthState?.get(fkMsgId)?.[fkFigIdx];\n    if (!fkEntry || !Array.isArray(fkEntry)) continue;\n    const [fkCur\x2C fkMax] = fkEntry;\n    if ((fkMax ?? 0) === 0 || ((fkCur ?? fkMax ?? 0) <= 0)) continue;\n    targets.push({ figureKey: fk\x2C dcName: fkDcName\x2C msgId: fkMsgId\x2C figIdx: fkFigIdx });\n  }\n\n  if (targets.length === 0) {\n    await interaction.message.edit({ content: '**It Will Be Alright** \u2014 No eligible friendly figures within 2 spaces.'\x2C components: [] }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n\n  // Store pending state\n  game.pendingItWillBeAlright = {\n    cassianMsgId: msgId\x2C\n    playerNum: meta.playerNum\x2C\n    targets: targets.map(t => ({ figureKey: t.figureKey\x2C dcName: t.dcName\x2C msgId: t.msgId\x2C figIdx: t.figIdx }))\x2C\n  };\n\n  const btns = targets.slice(0\x2C 20).map(t =>\n    new ButtonBuilder()\n      .setCustomId(`iwba_pick_${gameId}_${t.figureKey}`)\n      .setLabel(t.dcName.replace(/_/g\x2C ' '))\n      .setStyle(ButtonStyle.Danger)\n  );\n  const rows = [];\n  while (btns.length > 0) rows.push(new ActionRowBuilder().addComponents(btns.splice(0\x2C 5)));\n\n  await interaction.message.edit({\n    content: `**It Will Be Alright** \u2014 Choose a friendly figure to sacrifice:`\x2C\n    components: rows.slice(0\x2C 5)\x2C\n  }).catch(discordCatch);\n  saveGames();\n}\n\n/**\n * It Will Be Alright: Skip\n */\nexport async function handleItWillBeAlrightSkip(interaction\x2C ctx) {\n  const { getGame\x2C saveGames } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const m = interaction.customId.match(/^iwba_skip_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId] = m;\n  const game = getGame(gameId);\n  await interaction.message.edit({ content: '**It Will Be Alright** \u2014 Skipped.'\x2C components: [] }).catch(discordCatch);\n  if (game) {\n    delete game.pendingItWillBeAlright;\n    saveGames();\n  }\n}\n\n/**\n * It Will Be Alright: Pick \u2014 defeat chosen figure\x2C then offer free move or attack.\n */\nexport async function handleItWillBeAlrightPick(interaction\x2C ctx) {\n  const { getGame\x2C dcMessageMeta\x2C dcHealthState\x2C saveGames\x2C logGameAction\x2C client\x2C processFigureDefeat } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  // iwba_pick_{gameId}_{figureKey}\n  const m = interaction.customId.match(/^iwba_pick_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C figureKey] = m;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n\n  const pending = game.pendingItWillBeAlright;\n  if (!pending) {\n    await interaction.message.edit({ components: [] }).catch(discordCatch);\n    return;\n  }\n\n  const target = pending.targets.find(t => t.figureKey === figureKey);\n  if (!target) {\n    await interaction.message.edit({ components: [] }).catch(discordCatch);\n    return;\n  }\n\n  const { dcName: targetDcName\x2C msgId: targetMsgId\x2C figIdx: targetFigIdx } = target;\n  const playerNum = pending.playerNum;\n  const oppNum = opponentPlayerNum(playerNum);\n\n  // Defeat the figure: set HP to 0\n  const hs = dcHealthState?.get(targetMsgId);\n  const prevHp = hs?.[targetFigIdx]?.[0] ?? 0;\n  if (prevHp > 0) reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C targetFigIdx\x2C prevHp\x2C playerNum);\n\n  // Route through centralized defeat handler (VP\x2C CC attachments\x2C passive redraws\x2C\n  // Heroic Effort\x2C Scavenged Weaponry\x2C Hunt Dissent\x2C activation decrement\x2C win conditions)\n  if (processFigureDefeat) {\n    await processFigureDefeat(game\x2C {\n      defeatedPlayerNum: playerNum\x2C\n      figureKey\x2C\n      attackerPlayerNum: oppNum\x2C\n      msgId: targetMsgId\x2C\n      dcName: targetDcName\x2C\n      displayName: targetDcName\x2C\n      source: 'It Will Be Alright'\x2C\n    });\n  }\n\n  // Offer free move or attack\n  const cassianMsgId = pending.cassianMsgId;\n  const cassianMeta = dcMessageMeta?.get(cassianMsgId);\n  const cassianDisplay = cassianMeta?.displayName || 'Cassian Andor';\n\n  game.pendingItWillBeAlright = { ...pending\x2C phase: 'action'\x2C sacrificed: targetDcName };\n\n  const actionRow = new ActionRowBuilder().addComponents(\n    new ButtonBuilder().setCustomId(`iwba_action_${gameId}_${cassianMsgId}_move`).setLabel('Free Move').setStyle(ButtonStyle.Primary)\x2C\n    new ButtonBuilder().setCustomId(`iwba_action_${gameId}_${cassianMsgId}_attack`).setLabel('Free Attack').setStyle(ButtonStyle.Danger)\x2C\n  );\n\n  await interaction.message.edit({\n    content: `**It Will Be Alright** \u2014 **${targetDcName}** defeated. **${cassianDisplay}** may perform a free move or attack:`\x2C\n    components: [actionRow]\x2C\n  }).catch(discordCatch);\n  saveGames();\n}\n\n/**\n * It Will Be Alright: Action \u2014 grant free move or attack to Cassian.\n */\nexport async function handleItWillBeAlrightAction(interaction\x2C ctx) {\n  const { getGame\x2C dcMessageMeta\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  // iwba_action_{gameId}_{cassianMsgId}_{move|attack}\n  const m = interaction.customId.match(/^iwba_action_([^_]+)_([^_]+)_(move|attack)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C cassianMsgId\x2C actionType] = m;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n\n  const cassianMeta = dcMessageMeta?.get(cassianMsgId);\n  const cassianDisplay = cassianMeta?.displayName || 'Cassian Andor';\n\n  if (actionType === 'move') {\n    // Grant Cassian's speed as movement points\n    const cassianStats = getDcStats('Cassian Andor');\n    const speed = cassianStats?.speed ?? 4;\n    grantMovementBank(game\x2C cassianMsgId\x2C speed);\n    await interaction.message.edit({\n      content: `**It Will Be Alright** \u2014 **${cassianDisplay}** gains **${speed} MP** (free move).`\x2C\n      components: []\x2C\n    }).catch(discordCatch);\n    await logGameAction(game\x2C client\x2C `**It Will Be Alright** \u2014 **${cassianDisplay}** gains ${speed} MP (free move after sacrifice).`\x2C { phase: 'ACTIVATION'\x2C icon: 'move' });\n  } else {\n    // Grant free attack\n    game.freeAttackBonusPending = game.freeAttackBonusPending || {};\n    game.freeAttackBonusPending[cassianMsgId] = true;\n    await interaction.message.edit({\n      content: `**It Will Be Alright** \u2014 **${cassianDisplay}** may perform a free attack. Use the **Attack** button.`\x2C\n      components: []\x2C\n    }).catch(discordCatch);\n    await logGameAction(game\x2C client\x2C `**It Will Be Alright** \u2014 **${cassianDisplay}** gains a free attack (after sacrifice).`\x2C { phase: 'ACTIVATION'\x2C icon: 'attack' });\n  }\n\n  delete game.pendingItWillBeAlright;\n  saveGames();\n}\n
