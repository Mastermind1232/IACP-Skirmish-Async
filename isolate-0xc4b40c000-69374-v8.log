script-source,201,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/mission-rules.js,/**\n * Mission rules engine: runs data-driven end-of-round (and future) effects from mission-cards.json "rules".\n * Each effect type is implemented here; mission-cards.json supplies parameters (e.g. vp: 15).\n */\nimport { awardObjectiveVp } from './vp-helpers.js';\nimport { getPlayerId\x2C getCcHand\x2C getInitiativePlayerNum } from './player-helpers.js';\nimport { dcNameFromFigureKey } from './dc-helpers.js';\nimport { grantPowerTokens } from './game-helpers.js';\nimport { getDeploymentZones } from '../data-loader.js';\nimport { getPlayerOccupiedCellsForControl } from './board-helpers.js';\nimport { snowflakeUsers } from '../discord/channel-helpers.js';\nimport { normalizeCoord } from './coords.js';\n\n/**\n * Canonical accessor for current fluctuation positions.\n * Lazily deep-copies static JSON positions into game.fluctuationPositions on first access.\n * All consumers (VP scoring\x2C power token grant\x2C map rendering\x2C swap UI) use this single function.\n * @param {object} game\n * @param {string} mapId\n * @param {Function} getMapTokensDataFn\n * @returns {object} { "0": ["j10"\x2C "p10"]\x2C "2": ["h21"\x2C "t21"]\x2C ... } \u2014 string keys\x2C string arrays\n */\nexport function getCurrentFluctuationPositions(game\x2C mapId\x2C getMapTokensDataFn) {\n  if (game.fluctuationPositions) return game.fluctuationPositions;\n  const allTokens = typeof getMapTokensDataFn === 'function' ? getMapTokensDataFn() : {};\n  const missionData = allTokens[mapId]?.missionB;\n  const positions = missionData?.positions || {};\n  game.fluctuationPositions = {};\n  for (const [id\x2C coords] of Object.entries(positions)) {\n    game.fluctuationPositions[id] = (coords || []).map(c => normalizeCoord(c));\n  }\n  return game.fluctuationPositions;\n}\n\n/** Extract flat coordinate array from a missionA/missionB token data block (generic). */\nfunction extractTokenCoords(missionTokenData) {\n  if (!missionTokenData) return [];\n  if (missionTokenData.positions && typeof missionTokenData.positions === 'object') {\n    return Object.values(missionTokenData.positions).flat();\n  }\n  for (const val of Object.values(missionTokenData)) {\n    if (Array.isArray(val) && val.length > 0 && typeof val[0] === 'string') return val;\n  }\n  return [];\n}\n\n/** Who controls a named area: player with more figures in the area's cells; tie or none = null.\n *  Excludes companion figures not counted for control (Indentured Jester\x2C Clan of Two incapacitated\x2C\n *  Dio while Iden Versio is alive). */\nfunction getNamedAreaController(game\x2C mapId\x2C areaName\x2C getMapTokensDataFn) {\n  const allTokens = typeof getMapTokensDataFn === 'function' ? getMapTokensDataFn() : {};\n  const mapData = allTokens[mapId];\n  const areas = mapData?.namedAreas || [];\n  const area = [].concat(areas).find((a) => a && String(a.name || '').toLowerCase() === String(areaName || '').toLowerCase());\n  if (!area || !Array.isArray(area.cells) || area.cells.length === 0) return null;\n  const cellSet = new Set(area.cells.map((c) => normalizeCoord(c)));\n  // Companions not counted for control: Salacious B. Crumb (Indentured Jester \u2014 always excluded)\x2C\n  // The Child (Clan of Two \u2014 excluded while incapacitated\x2C i.e. when game.childIncapacitated is true)\x2C\n  // Dio (excluded while Iden Versio is alive; counts after Iden is defeated)\n  const excludedNames = new Set(['salacious b. crumb']);\n  if (game.childIncapacitated) excludedNames.add('the child');\n  // Pre-check whether Iden Versio is alive for each player (Dio excluded only while Iden lives)\n  const idenAlive = {};\n  for (const pn of [1\x2C 2]) {\n    idenAlive[pn] = Object.keys(game.figurePositions?.[pn] || {}).some((fk) => dcNameFromFigureKey(fk) === 'Iden Versio');\n  }\n  let p1 = 0;\n  let p2 = 0;\n  for (const pn of [1\x2C 2]) {\n    const poses = game.figurePositions?.[pn] || {};\n    for (const [fk\x2C cell] of Object.entries(poses)) {\n      if (!cellSet.has(normalizeCoord(cell))) continue;\n      const dcName = dcNameFromFigureKey((fk || '')).toLowerCase();\n      if (excludedNames.has(dcName)) continue;\n      // Dio excluded while its owner Iden Versio is alive\n      if (dcName === 'dio' && idenAlive[pn]) continue;\n      if (pn === 1) p1++;\n      else p2++;\n    }\n  }\n  if (p1 > p2) return 1;\n  if (p2 > p1) return 2;\n  return null;\n}\n\n/**\n * Run end-of-round rules for the given mission variant.\n * @param {object} game - Game state\n * @param {string} mapId - Selected map id\n * @param {string} variant - 'a' or 'b'\n * @param {object} rules - getMissionRules(mapId\x2C variant).endOfRound (object keyed by effect type)\n * @param {object} ctx - { logGameAction\x2C checkWinConditions\x2C getMapTokensData\x2C getSpaceController\x2C client }\n * @returns {Promise<{ gameEnded: boolean }>}\n */\nexport async function runEndOfRoundRules(game\x2C mapId\x2C variant\x2C rules\x2C ctx) {\n  const { logGameAction\x2C checkWinConditions\x2C getMapTokensData\x2C getSpaceController\x2C client } = ctx;\n  let gameEnded = false;\n\n  if (!rules || typeof rules !== 'object') return { gameEnded };\n\n  if (rules.vpForControllingNamedArea && mapId) {\n    const { areaName\x2C vp } = rules.vpForControllingNamedArea;\n    if (areaName && typeof vp === 'number') {\n      const controller = getNamedAreaController(game\x2C mapId\x2C areaName\x2C getMapTokensData);\n      if (controller) {\n        const vpVal = vp;\n        const pid = getPlayerId(game\x2C controller);\n        awardObjectiveVp(game\x2C controller\x2C vpVal);\n        await logGameAction(game\x2C client\x2C `<@${pid}> gained **${vpVal} VP** for controlling **${areaName}**.`\x2C { allowedMentions: { users: [pid] }\x2C phase: 'ROUND'\x2C icon: 'round' });\n        await checkWinConditions(game\x2C client);\n        if (game.ended) return { gameEnded: true };\n      }\n    }\n  }\n\n  if (rules.vpPerContrabandInDeploymentZone && game.figureContraband) {\n    const { vp\x2C vpMessage } = rules.vpPerContrabandInDeploymentZone;\n    if (typeof vp === 'number') {\n      const vpPerFigure = vp;\n      const { isFigureInDeploymentZone } = ctx;\n      for (const pn of [1\x2C 2]) {\n        let scored = 0;\n        for (const [figureKey\x2C carrying] of Object.entries(game.figureContraband)) {\n          if (!carrying) continue;\n          const poses = game.figurePositions?.[pn] || {};\n          if (!(figureKey in poses)) continue;\n          if (!isFigureInDeploymentZone(game\x2C pn\x2C figureKey\x2C mapId)) continue;\n          const vpState = game[`player${pn}VP`] || { total: 0\x2C kills: 0\x2C objectives: 0 };\n          vpState.total = (vpState.total || 0) + vpPerFigure;\n          vpState.objectives = (vpState.objectives || 0) + vpPerFigure;\n          game[`player${pn}VP`] = vpState;\n          delete game.figureContraband[figureKey];\n          scored++;\n        }\n        if (scored > 0) {\n          const pid = getPlayerId(game\x2C pn);\n          const msg = vpMessage\n            ? vpMessage.replace('{vp}'\x2C String(vpPerFigure * scored)).replace('{count}'\x2C String(scored))\n            : `${scored} figure(s) scoring ${vpPerFigure} VP each (mission objective)`;\n          await logGameAction(game\x2C client\x2C `<@${pid}> gained **${vpPerFigure * scored} VP** \u2014 ${msg}.`\x2C { allowedMentions: { users: [pid] }\x2C phase: 'ROUND'\x2C icon: 'round' });\n          await checkWinConditions(game\x2C client);\n          if (game.ended) return { gameEnded: true };\n        }\n      }\n    }\n  }\n\n  if (rules.vpPerLaunchPanelControlled && mapId) {\n    const { green\x2C gray\x2C vpMessage } = rules.vpPerLaunchPanelControlled;\n    if (typeof green === 'number' && typeof gray === 'number') {\n      const variant = game?.selectedMission?.variant || 'a';\n      const missionSide = variant === 'a' ? 'missionA' : 'missionB';\n      const launchPanels = extractTokenCoords(getMapTokensData()[mapId]?.[missionSide]);\n      const state = game.launchPanelState || {};\n      let p1Vp = 0;\n      let p2Vp = 0;\n      for (const coord of launchPanels) {\n        const c = String(coord).toLowerCase();\n        const side = state[c];\n        if (!side) continue;\n        const controller = getSpaceController(game\x2C mapId\x2C coord);\n        if (!controller) continue;\n        const vp = side === 'colored' ? green : gray;\n        if (controller === 1) p1Vp += vp;\n        else p2Vp += vp;\n      }\n      if (p1Vp > 0) {\n        awardObjectiveVp(game\x2C 1\x2C p1Vp);\n        const msg = vpMessage ? vpMessage.replace('{vp}'\x2C String(p1Vp)) : `mission objective`;\n        await logGameAction(game\x2C client\x2C `<@${game.player1Id}> gained **${p1Vp} VP** \u2014 ${msg}.`\x2C { allowedMentions: { users: snowflakeUsers([game.player1Id]) }\x2C phase: 'ROUND'\x2C icon: 'round' });\n        await checkWinConditions(game\x2C client);\n        if (game.ended) return { gameEnded: true };\n      }\n      if (p2Vp > 0) {\n        awardObjectiveVp(game\x2C 2\x2C p2Vp);\n        const msg = vpMessage ? vpMessage.replace('{vp}'\x2C String(p2Vp)) : `mission objective`;\n        await logGameAction(game\x2C client\x2C `<@${game.player2Id}> gained **${p2Vp} VP** \u2014 ${msg}.`\x2C { allowedMentions: { users: snowflakeUsers([game.player2Id]) }\x2C phase: 'ROUND'\x2C icon: 'round' });\n        await checkWinConditions(game\x2C client);\n        if (game.ended) return { gameEnded: true };\n      }\n    }\n  }\n\n  if (rules.vpPerTokenForControllingCell && mapId) {\n    const { controlCell\x2C vpPerToken\x2C tokenCountKey\x2C vpMessage: tokenVpMsg } = rules.vpPerTokenForControllingCell;\n    if (controlCell && tokenCountKey && typeof vpPerToken === 'number') {\n      const controller = getSpaceController(game\x2C mapId\x2C controlCell);\n      const count = typeof game[tokenCountKey] === 'number' ? game[tokenCountKey] : 0;\n      if (controller && count > 0) {\n        const vpVal = vpPerToken * count;\n        const pid = getPlayerId(game\x2C controller);\n        awardObjectiveVp(game\x2C controller\x2C vpVal);\n        game[tokenCountKey] = 0;\n        const ctrlMsg = tokenVpMsg\n          ? tokenVpMsg.replace('{vp}'\x2C String(vpVal)).replace('{count}'\x2C String(count))\n          : `controlling the objective (${count} token${count !== 1 ? 's' : ''})`;\n        await logGameAction(game\x2C client\x2C `<@${pid}> gained **${vpVal} VP** \u2014 ${ctrlMsg}.`\x2C { allowedMentions: { users: [pid] }\x2C phase: 'ROUND'\x2C icon: 'round' });\n        await checkWinConditions(game\x2C client);\n        if (game.ended) return { gameEnded: true };\n      } else if (count > 0) {\n        game[tokenCountKey] = 0;\n      }\n    }\n  }\n\n  // vpPerControlledSpaceInList: iterate all mission token positions\x2C award vp to controller of each space.\n  // Used by Lothal Wastes A (Blitz): 2 VP per critical position controlled.\n  if (rules.vpPerControlledSpaceInList && mapId) {\n    const { vp\x2C vpMessage } = rules.vpPerControlledSpaceInList;\n    if (typeof vp === 'number') {\n      const missionSide = variant === 'a' ? 'missionA' : 'missionB';\n      const missionData = getMapTokensData()[mapId]?.[missionSide];\n      const allSpaces = Object.values(missionData?.positions || {}).flat().filter(Boolean);\n      const vpByPlayer = { 1: 0\x2C 2: 0 };\n      for (const coord of allSpaces) {\n        const controller = getSpaceController(game\x2C mapId\x2C coord);\n        if (controller) vpByPlayer[controller] += vp;\n      }\n      for (const pn of [1\x2C 2]) {\n        if (vpByPlayer[pn] > 0) {\n          const vpVal = vpByPlayer[pn];\n          const count = vpByPlayer[pn] / vp;\n          const pid = getPlayerId(game\x2C pn);\n          awardObjectiveVp(game\x2C pn\x2C vpVal);\n          const msg = vpMessage\n            ? vpMessage.replace('{vp}'\x2C String(vpVal)).replace('{count}'\x2C String(count))\n            : `mission objective (${count} position${count !== 1 ? 's' : ''} \xd7 ${vp} VP)`;\n          await logGameAction(game\x2C client\x2C `<@${pid}> gained **${vpVal} VP** \u2014 ${msg}.`\x2C { allowedMentions: { users: [pid] }\x2C phase: 'ROUND'\x2C icon: 'round' });\n          await checkWinConditions(game\x2C client);\n          if (game.ended) return { gameEnded: true };\n        }\n      }\n    }\n  }\n\n  // vpPerControlledFluctuation: for each fluctuation space\x2C award vp to controller and grant a color-matched\n  // power token to any figure standing on that space. Used by Lothal Wastes B (Fluctuations).\n  if (rules.vpPerControlledFluctuation && mapId) {\n    const { vp\x2C grantPowerToken\x2C vpMessage } = rules.vpPerControlledFluctuation;\n    if (typeof vp === 'number') {\n      const missionData = getMapTokensData()[mapId]?.missionB;\n      const tokenTypes = missionData?.tokenTypes || [];\n      const positions = getCurrentFluctuationPositions(game\x2C mapId\x2C getMapTokensData);\n      const colorToPowerToken = { yellow: 'Surge'\x2C blue: 'Evade'\x2C green: 'Block'\x2C red: 'Damage' };\n      const vpByPlayer = { 1: 0\x2C 2: 0 };\n      const tokensGranted = [];\n      for (const [id\x2C coords] of Object.entries(positions)) {\n        if (!Array.isArray(coords) || coords.length === 0) continue;\n        const typeInfo = tokenTypes[parseInt(id)];\n        const imageMatch = (typeInfo?.image || '').match(/Neutral (\\w+)\\./i);\n        const color = imageMatch ? imageMatch[1].toLowerCase() : null;\n        const powerToken = color ? (colorToPowerToken[color] || null) : null;\n        for (const coord of coords) {\n          const controller = getSpaceController(game\x2C mapId\x2C coord);\n          if (controller) vpByPlayer[controller] += vp;\n          if (grantPowerToken && powerToken) {\n            for (const pn of [1\x2C 2]) {\n              const poses = game.figurePositions?.[pn] || {};\n              for (const [figKey\x2C figCoord] of Object.entries(poses)) {\n                if (normalizeCoord(figCoord) === normalizeCoord(coord)) {\n                  grantPowerTokens(game\x2C figKey\x2C powerToken\x2C 1);\n                  tokensGranted.push(`${figKey} \u2192 ${powerToken}`);\n                }\n              }\n            }\n          }\n        }\n      }\n      for (const pn of [1\x2C 2]) {\n        if (vpByPlayer[pn] > 0) {\n          const vpVal = vpByPlayer[pn];\n          const count = vpByPlayer[pn] / vp;\n          const pid = getPlayerId(game\x2C pn);\n          awardObjectiveVp(game\x2C pn\x2C vpVal);\n          const msg = vpMessage\n            ? vpMessage.replace('{vp}'\x2C String(vpVal)).replace('{count}'\x2C String(count))\n            : `mission objective (${count} fluctuation${count !== 1 ? 's' : ''} controlled)`;\n          await logGameAction(game\x2C client\x2C `<@${pid}> gained **${vpVal} VP** \u2014 ${msg}.`\x2C { allowedMentions: { users: [pid] }\x2C phase: 'ROUND'\x2C icon: 'round' });\n          await checkWinConditions(game\x2C client);\n          if (game.ended) return { gameEnded: true };\n        }\n      }\n      if (grantPowerToken) {\n        await logGameAction(game\x2C client\x2C `**Fluctuations:** Figures on fluctuation spaces received power tokens (Yellow\u2192Surge\x2C Blue\u2192Evade\x2C Green\u2192Block\x2C Red\u2192Hit). _(Reminder: each player may now swap 1 fluctuation.)_`\x2C { phase: 'ROUND'\x2C icon: 'round' });\n      }\n    }\n  }\n\n  // vpPerStrainOnControlledSpaces: score 2 VP per strain token on each signal marker the player controls.\n  // Strain is removed after scoring. Used by Chopper Base B (Powered Perimeter).\n  if (rules.vpPerStrainOnControlledSpaces && mapId) {\n    const { vpPerStrain = 2\x2C strainStateKey = 'signalMarkerStrain'\x2C vpMessage } = rules.vpPerStrainOnControlledSpaces;\n    const strainMap = game[strainStateKey];\n    if (strainMap && typeof strainMap === 'object') {\n      const vpByPlayer = { 1: 0\x2C 2: 0 };\n      const strainRemovedByPlayer = { 1: 0\x2C 2: 0 };\n      for (const [coord\x2C strainCount] of Object.entries(strainMap)) {\n        if (!strainCount || strainCount <= 0) continue;\n        const controller = getSpaceController(game\x2C mapId\x2C coord);\n        if (!controller) continue; // uncontrolled markers retain strain\n        vpByPlayer[controller] += vpPerStrain * strainCount;\n        strainRemovedByPlayer[controller] += strainCount;\n        game[strainStateKey][coord] = 0;\n      }\n      for (const pn of [1\x2C 2]) {\n        if (vpByPlayer[pn] > 0) {\n          const vpVal = vpByPlayer[pn];\n          const removed = strainRemovedByPlayer[pn];\n          const pid = getPlayerId(game\x2C pn);\n          awardObjectiveVp(game\x2C pn\x2C vpVal);\n          const msg = vpMessage\n            ? vpMessage.replace('{vp}'\x2C String(vpVal)).replace('{count}'\x2C String(removed))\n            : `signal markers controlled (${removed} strain removed \xd7 ${vpPerStrain} VP)`;\n          await logGameAction(game\x2C client\x2C `<@${pid}> gained **${vpVal} VP** \u2014 ${msg}.`\x2C { allowedMentions: { users: [pid] }\x2C phase: 'ROUND'\x2C icon: 'round' });\n          await checkWinConditions(game\x2C client);\n          if (game.ended) return { gameEnded: true };\n        }\n      }\n    }\n  }\n\n  // autoDistributeCrateTokens: for each crate with accumulated tokens\x2C find the controller\x2C\n  // then auto-give all tokens to the first friendly figure on or adjacent to the crate.\n  // Also awards 2 VP per controlled crate. Used by Devaron Garrison A.\n  if (rules.autoDistributeCrateTokens && mapId) {\n    const { vpPerCrate = 2 } = rules.autoDistributeCrateTokens;\n    const { getFiguresOnOrAdjacentToSpace } = ctx;\n    const crateTokens = game.crateTokens;\n    if (crateTokens && typeof crateTokens === 'object') {\n      const vpByPlayer = { 1: 0\x2C 2: 0 };\n      const distributionLog = [];\n      for (const [coord\x2C tokens] of Object.entries(crateTokens)) {\n        if (!Array.isArray(tokens) || tokens.length === 0) continue;\n        const controller = getSpaceController(game\x2C mapId\x2C coord);\n        if (!controller) { game.crateTokens[coord] = []; continue; }\n        vpByPlayer[controller] += vpPerCrate;\n        // Find first friendly figure on or adjacent to this crate\n        const nearbyFigs = getFiguresOnOrAdjacentToSpace ? getFiguresOnOrAdjacentToSpace(game\x2C controller\x2C coord\x2C mapId) : [];\n        if (nearbyFigs.length > 0) {\n          const recipient = nearbyFigs[0];\n          for (const tok of tokens) grantPowerTokens(game\x2C recipient\x2C tok\x2C 1);\n          distributionLog.push(`${coord}: [${tokens.join('\x2C ')}] \u2192 ${recipient}`);\n        } else {\n          distributionLog.push(`${coord}: [${tokens.join('\x2C ')}] \u2014 no adjacent friendly\x2C tokens lost`);\n        }\n        game.crateTokens[coord] = [];\n      }\n      if (distributionLog.length > 0) {\n        await logGameAction(game\x2C client\x2C `**Crate tokens distributed:** ${distributionLog.join(' | ')}`\x2C { phase: 'ROUND'\x2C icon: 'round' });\n      }\n      for (const pn of [1\x2C 2]) {\n        if (vpByPlayer[pn] > 0) {\n          const vpVal = vpByPlayer[pn];\n          const count = vpByPlayer[pn] / vpPerCrate;\n          const pid = getPlayerId(game\x2C pn);\n          awardObjectiveVp(game\x2C pn\x2C vpVal);\n          await logGameAction(game\x2C client\x2C `<@${pid}> gained **${vpVal} VP** \u2014 ${count} crate${count !== 1 ? 's' : ''} controlled (${vpPerCrate} VP each).`\x2C { allowedMentions: { users: [pid] }\x2C phase: 'ROUND'\x2C icon: 'round' });\n          await checkWinConditions(game\x2C client);\n          if (game.ended) return { gameEnded: true };\n        }\n      }\n    }\n  }\n\n  // vpPerControlledDeploymentZone: award VP for each deployment zone a player controls.\n  // Control = more figures in the zone than the opponent (strict majority).\n  // Used by Hoth Battle Station A (Inside Job): 3 VP per zone controlled.\n  if (rules.vpPerControlledDeploymentZone && mapId) {\n    const { vp\x2C vpMessage } = rules.vpPerControlledDeploymentZone;\n    if (typeof vp === 'number') {\n      const zoneData = getDeploymentZones()?.[mapId];\n      if (zoneData) {\n        const p1Cells = getPlayerOccupiedCellsForControl(game\x2C 1);\n        const p2Cells = getPlayerOccupiedCellsForControl(game\x2C 2);\n        const vpByPlayer = { 1: 0\x2C 2: 0 };\n        for (const zoneColor of ['red'\x2C 'blue']) {\n          const zoneSpaces = new Set((zoneData[zoneColor] || []).map(s => normalizeCoord(s)));\n          if (zoneSpaces.size === 0) continue;\n          let p1Count = 0\x2C p2Count = 0;\n          for (const c of zoneSpaces) {\n            if (p1Cells.has(c)) p1Count++;\n            if (p2Cells.has(c)) p2Count++;\n          }\n          if (p1Count > p2Count) vpByPlayer[1] += vp;\n          else if (p2Count > p1Count) vpByPlayer[2] += vp;\n        }\n        for (const pn of [1\x2C 2]) {\n          if (vpByPlayer[pn] > 0) {\n            const vpVal = vpByPlayer[pn];\n            const count = vpVal / vp;\n            const pid = getPlayerId(game\x2C pn);\n            awardObjectiveVp(game\x2C pn\x2C vpVal);\n            const msg = vpMessage || `deployment zone(s) controlled (${vp} VP each)`;\n            await logGameAction(game\x2C client\x2C `<@${pid}> gained **${vpVal} VP** \u2014 ${msg}.`\x2C { allowedMentions: { users: [pid] }\x2C phase: 'ROUND'\x2C icon: 'round' });\n            await checkWinConditions(game\x2C client);\n            if (game.ended) return { gameEnded: true };\n          }\n        }\n      }\n    }\n  }\n\n  // vpPerContrabandInOpponentDeploymentZone: score VP for figures carrying contraband in the OPPONENT's deployment zone.\n  // Used by Hoth Battle Station B (Bomb Drop): 4 VP per explosive discarded.\n  if (rules.vpPerContrabandInOpponentDeploymentZone && game.figureContraband) {\n    const { vp\x2C vpMessage } = rules.vpPerContrabandInOpponentDeploymentZone;\n    if (typeof vp === 'number') {\n      const oppZoneData = getDeploymentZones()?.[mapId];\n      if (oppZoneData) {\n        const initPn = getInitiativePlayerNum(game);\n        for (const pn of [1\x2C 2]) {\n          const oppPn = 3 - pn;\n          const oppZoneColor = oppPn === initPn ? game.deploymentZoneChosen : (game.deploymentZoneChosen === 'red' ? 'blue' : 'red');\n          const oppZoneSpaces = new Set((oppZoneData[oppZoneColor] || []).map(s => normalizeCoord(s)));\n          let scored = 0;\n          for (const [figureKey\x2C carrying] of Object.entries(game.figureContraband)) {\n            if (!carrying) continue;\n            const poses = game.figurePositions?.[pn] || {};\n            if (!(figureKey in poses)) continue;\n            const figCoord = normalizeCoord(poses[figureKey]);\n            if (!oppZoneSpaces.has(figCoord)) continue;\n            scored++;\n            delete game.figureContraband[figureKey];\n          }\n          if (scored > 0) {\n            const vpVal = vp * scored;\n            const pid = getPlayerId(game\x2C pn);\n            awardObjectiveVp(game\x2C pn\x2C vpVal);\n            const msg = vpMessage || `explosive(s) discarded in opponent's deployment zone (${vp} VP each)`;\n            await logGameAction(game\x2C client\x2C `<@${pid}> gained **${vpVal} VP** \u2014 ${msg}.`\x2C { allowedMentions: { users: [pid] }\x2C phase: 'ROUND'\x2C icon: 'round' });\n            await checkWinConditions(game\x2C client);\n            if (game.ended) return { gameEnded: true };\n          }\n        }\n      }\n    }\n  }\n\n  return { gameEnded };\n}\n\n/**\n * Run start-of-round rules.\n * Now async so rules can log via logGameAction.\n * @param {object} game\n * @param {string} mapId\n * @param {string} variant - 'a' | 'b'\n * @param {object} rules - getMissionRules(mapId\x2C variant).startOfRound\n * @param {object} ctx - { logGameAction\x2C client\x2C getMapTokensData }\n */\nexport async function runStartOfRoundRules(game\x2C mapId\x2C variant\x2C rules\x2C ctx = {}) {\n  if (!rules || typeof rules !== 'object') return;\n  const { logGameAction\x2C client\x2C getMapTokensData } = ctx;\n\n  if (rules.setTokenCountFromInitiativeHand) {\n    const { gameKey } = rules.setTokenCountFromInitiativeHand;\n    if (gameKey) {\n      const initId = game.initiativePlayerId;\n      const hand = initId === game.player1Id ? (game.player1CcHand || []) : (game.player2CcHand || []);\n      game[gameKey] = hand.length;\n      if (logGameAction && client) {\n        const missionName = game.selectedMission?.name || 'Mission Effect';\n        await logGameAction(game\x2C client\x2C `\ud83d\udcca **${missionName}** \u2014 Cantina tokens set to **${hand.length}** (initiative player's hand size).`\x2C { phase: 'ROUND'\x2C icon: 'round' });\n      }\n    }\n  }\n\n  // randomRevealAndPlaceStrain: each player randomly reveals one token from the face-down set.\n  // +1 strain placed on each signal marker matching the revealed color.\n  // Used by Chopper Base B (Powered Perimeter).\n  if (rules.randomRevealAndPlaceStrain && mapId && getMapTokensData) {\n    const { strainStateKey = 'signalMarkerStrain' } = rules.randomRevealAndPlaceStrain;\n    const missionSide = variant === 'a' ? 'missionA' : 'missionB';\n    const missionData = getMapTokensData()[mapId]?.[missionSide];\n    const tokenTypes = missionData?.tokenTypes || [];\n    const positions = missionData?.positions || {};\n    // Build list of color groups (skip empty position groups)\n    const colorGroups = [];\n    for (const [id\x2C coords] of Object.entries(positions)) {\n      if (!Array.isArray(coords) || coords.length === 0) continue;\n      const typeInfo = tokenTypes[parseInt(id)];\n      const imageMatch = (typeInfo?.image || '').match(/Neutral (\\w+)\\./i);\n      const color = imageMatch ? imageMatch[1].toLowerCase() : null;\n      if (color) colorGroups.push({ id\x2C color\x2C coords });\n    }\n    if (colorGroups.length > 0) {\n      game[strainStateKey] = game[strainStateKey] || {};\n      // Shuffle tokens (Fisher-Yates) \u2014 draw without replacement like physical tokens\n      const shuffled = [...colorGroups];\n      for (let i = shuffled.length - 1; i > 0; i--) {\n        const j = Math.floor(Math.random() * (i + 1));\n        [shuffled[i]\x2C shuffled[j]] = [shuffled[j]\x2C shuffled[i]];\n      }\n      const reveals = [];\n      for (let p = 1; p <= 2; p++) {\n        const pick = shuffled[p - 1]; // each player gets a distinct token\n        reveals.push({ player: p\x2C color: pick.color\x2C coords: pick.coords });\n        for (const coord of pick.coords) {\n          const c = normalizeCoord(coord);\n          game[strainStateKey][c] = (game[strainStateKey][c] || 0) + 1;\n        }\n      }\n      const lines = reveals.map((r) => `Player ${r.player} revealed **${r.color.toUpperCase()}** (+1 strain on ${r.coords.join('\x2C ')})`);\n      if (logGameAction && client) {\n        await logGameAction(game\x2C client\x2C `**Powered Perimeter \u2014 token reveal:** ${lines.join(' | ')}`\x2C { phase: 'ROUND'\x2C icon: 'round' });\n      }\n    }\n  }\n\n  // placeTokensOnCrates: each start-of-round\x2C +1 power token on each crate matching its color.\n  // Used by Devaron Garrison A.\n  if (rules.placeTokensOnCrates && mapId && getMapTokensData) {\n    const missionSide = variant === 'a' ? 'missionA' : 'missionB';\n    const missionData = getMapTokensData()[mapId]?.[missionSide];\n    const tokenTypes = missionData?.tokenTypes || [];\n    const positions = missionData?.positions || {};\n    const colorToPowerToken = { blue: 'Block'\x2C red: 'Damage'\x2C yellow: 'Surge' };\n    game.crateTokens = game.crateTokens || {};\n    const placed = [];\n    for (const [id\x2C coords] of Object.entries(positions)) {\n      if (!Array.isArray(coords) || coords.length === 0) continue;\n      const typeInfo = tokenTypes[parseInt(id)];\n      const imageMatch = (typeInfo?.image || '').match(/(Blue|Red|Yellow)/i);\n      const color = imageMatch ? imageMatch[1].toLowerCase() : null;\n      const token = color ? (colorToPowerToken[color] || null) : null;\n      if (!token) continue;\n      for (const coord of coords) {\n        const c = normalizeCoord(coord);\n        game.crateTokens[c] = game.crateTokens[c] || [];\n        game.crateTokens[c].push(token);\n        placed.push(`${c} (${token})`);\n      }\n    }\n    if (placed.length > 0 && logGameAction && client) {\n      await logGameAction(game\x2C client\x2C `**Crate tokens placed:** ${placed.join('\x2C ')}`\x2C { phase: 'ROUND'\x2C icon: 'round' });\n    }\n  }\n}\n\n/**\n * Process end-of-round Krykna effects for Chopper Base A.\n * Lazy-inits game.npcKrykna from missionA token positions.\n * Emits damage events for all non-Krykna figures adjacent to any Krykna.\n * (The player-driven push phase is handled interactively via pendingKryknaPush \u2014 see round.js)\n * @returns { logs\x2C damageEvents }\n */\nexport function runNpcKryknaActivation(game\x2C mapId\x2C ctx = {}) {\n  const { getMapTokensData\x2C getMapData\x2C getMapRegistry\x2C filterMapSpacesByBounds } = ctx;\n\n  // Lazy-init from missionA token positions\n  if (!game.npcKrykna) {\n    const missionData = getMapTokensData?.()[mapId]?.missionA;\n    const positions = Object.values(missionData?.positions || {}).flat().filter(Boolean);\n    if (positions.length === 0) return { logs: []\x2C damageEvents: [] };\n    game.npcKrykna = positions.map((coord\x2C i) => ({ id: `krykna-${i + 1}`\x2C coord: normalizeCoord(coord)\x2C hp: 8\x2C maxHp: 8\x2C defeated: false }));\n  }\n\n  const activeKrykna = game.npcKrykna.filter((k) => !k.defeated);\n  if (activeKrykna.length === 0) return { logs: [`All Krykna defeated.`]\x2C damageEvents: [] };\n\n  const rawMapSpaces = getMapData?.(mapId);\n  if (!rawMapSpaces?.adjacency) return { logs: ['No adjacency data \u2014 Krykna damage skipped']\x2C damageEvents: [] };\n  const mapDef = getMapRegistry?.()?.find?.((m) => m.id === mapId);\n  const mapSpaces = filterMapSpacesByBounds?.(rawMapSpaces\x2C mapDef?.gridBounds) || rawMapSpaces;\n  const adjacency = mapSpaces.adjacency || {};\n\n  const kryknaCoords = new Set(activeKrykna.map((k) => normalizeCoord(k.coord)));\n  const logs = [];\n  const damageEvents = [];\n\n  for (const pn of [1\x2C 2]) {\n    for (const [figKey\x2C figCoord] of Object.entries(game.figurePositions?.[pn] || {})) {\n      const fc = normalizeCoord(figCoord);\n      const adjToKrykna = (adjacency[fc] || []).some((n) => kryknaCoords.has(normalizeCoord(n)));\n      if (adjToKrykna) damageEvents.push({ figureKey: figKey\x2C playerNum: pn\x2C damage: 2 });\n    }\n  }\n\n  if (damageEvents.length > 0) {\n    logs.push(`${damageEvents.length} hostile figure(s) adjacent to Krykna each suffer **2 damage**.`);\n  }\n\n  // Flag whether any claimed Krykna need interactive placement (after damage resolves)\n  const claimed1 = game.claimedKrykna?.[1] || 0;\n  const claimed2 = game.claimedKrykna?.[2] || 0;\n  const claimedPlacementNeeded = claimed1 > 0 || claimed2 > 0;\n\n  return { logs\x2C damageEvents\x2C claimedPlacementNeeded };\n}\n\n/**\n * Get valid spaces for placing a claimed Krykna \u2014 opponent's deployment zone minus occupied spaces.\n * @param {object} game\n * @param {number} playerNum - the player placing (they place in the OPPONENT's zone)\n * @param {string} mapId\n * @returns {string[]} normalized coords that are valid for placement\n */\nexport function getValidKryknaPlacementSpaces(game\x2C playerNum\x2C mapId) {\n  const zones = getDeploymentZones()[mapId];\n  if (!zones) return [];\n\n  // Player places in opponent's deployment zone\n  const opponentZoneLabel = playerNum === 1 ? 'blue' : 'red';\n  const zoneCoords = (zones[opponentZoneLabel] || []).map(c => normalizeCoord(c));\n\n  // Collect all occupied spaces (both players' figures + active Krykna)\n  const occupied = new Set();\n  for (const pn of [1\x2C 2]) {\n    for (const coord of Object.values(game.figurePositions?.[pn] || {})) {\n      occupied.add(normalizeCoord(coord));\n    }\n  }\n  for (const k of (game.npcKrykna || [])) {\n    if (!k.defeated) occupied.add(normalizeCoord(k.coord));\n  }\n\n  return zoneCoords.filter(c => !occupied.has(c));\n}\n\n/**\n * Advance all NPC thugs toward the nearest hostile figure\x2C then emit damage events for adjacent hostiles.\n * Returns { logs\x2C damageEvents } \u2014 damage is NOT applied here; round.js handles it.\n * Lazily initializes game.npcThugs from map-tokens if not already set.\n * @param {object} game\n * @param {string} mapId\n * @param {object} ctx - { getMapData\x2C getMapRegistry\x2C filterMapSpacesByBounds\x2C getMapTokensData }\n */\nexport function runNpcThugActivation(game\x2C mapId\x2C ctx = {}) {\n  const { getMapData\x2C getMapRegistry\x2C filterMapSpacesByBounds\x2C getMapTokensData } = ctx;\n\n  // Lazy-init: create npcThugs from missionA token positions if not yet set\n  if (!game.npcThugs) {\n    const missionData = getMapTokensData?.()[mapId]?.missionA;\n    const positions = Object.values(missionData?.positions || {}).flat().filter(Boolean);\n    if (positions.length === 0) return { logs: []\x2C damageEvents: [] };\n    game.npcThugs = positions.map((coord\x2C i) => ({ id: `thug-${i + 1}`\x2C coord: normalizeCoord(coord)\x2C hp: 4\x2C maxHp: 4\x2C defeated: false }));\n  }\n\n  const activeThugs = game.npcThugs.filter((t) => !t.defeated);\n  if (activeThugs.length === 0) return { logs: []\x2C damageEvents: [] };\n\n  const rawMapSpaces = getMapData?.(mapId);\n  if (!rawMapSpaces?.adjacency) return { logs: ['No map adjacency \u2014 thug movement skipped']\x2C damageEvents: [] };\n  const mapDef = getMapRegistry?.()?.find?.((m) => m.id === mapId);\n  const mapSpaces = filterMapSpacesByBounds?.(rawMapSpaces\x2C mapDef?.gridBounds) || rawMapSpaces;\n  const adjacency = mapSpaces.adjacency || {};\n\n  // Map coord \u2192 { figureKey\x2C playerNum } for all hostile figures\n  const hostileByCoord = new Map();\n  for (const pn of [1\x2C 2]) {\n    for (const [figKey\x2C coord] of Object.entries(game.figurePositions?.[pn] || {})) {\n      hostileByCoord.set(normalizeCoord(coord)\x2C { figureKey: figKey\x2C playerNum: pn });\n    }\n  }\n  const allHostileCoords = new Set(hostileByCoord.keys());\n\n  const logs = [];\n\n  for (const thug of activeThugs) {\n    const startCoord = normalizeCoord(thug.coord);\n\n    // BFS from thug to find nearest hostile\n    const visited = new Map([[startCoord\x2C null]]);\n    const queue = [startCoord];\n    let targetCoord = null;\n    outer: while (queue.length > 0) {\n      const curr = queue.shift();\n      for (const neighbor of (adjacency[curr] || [])) {\n        const n = normalizeCoord(neighbor);\n        if (visited.has(n)) continue;\n        visited.set(n\x2C curr);\n        if (allHostileCoords.has(n)) { targetCoord = n; break outer; }\n        queue.push(n);\n      }\n    }\n    if (!targetCoord) { logs.push(`Thug at ${thug.coord}: no hostile found\x2C stays put.`); continue; }\n\n    // Reconstruct path (list of spaces from start to target\x2C not including start)\n    const path = [];\n    let cur = targetCoord;\n    while (cur && cur !== startCoord) {\n      const prev = visited.get(cur);\n      if (prev !== undefined && prev !== null) path.unshift(cur);\n      cur = visited.get(cur);\n    }\n\n    // Move up to 2 steps\x2C stopping 1 space short of the hostile (to be adjacent)\n    const maxSteps = Math.min(2\x2C Math.max(0\x2C path.length - 1));\n    if (maxSteps > 0) {\n      thug.coord = path[maxSteps - 1];\n      logs.push(`Thug moved ${startCoord} \u2192 **${thug.coord}** (${maxSteps} step${maxSteps !== 1 ? 's' : ''} toward ${targetCoord}).`);\n    } else {\n      logs.push(`Thug at **${startCoord}**: already adjacent to hostile at ${targetCoord}.`);\n    }\n  }\n\n  // Emit damage events: each hostile adjacent to any active thug takes 2 damage\n  const thugCoords = new Set(game.npcThugs.filter((t) => !t.defeated).map((t) => normalizeCoord(t.coord)));\n  const damageEvents = [];\n  for (const pn of [1\x2C 2]) {\n    for (const [figKey\x2C figCoord] of Object.entries(game.figurePositions?.[pn] || {})) {\n      const fc = normalizeCoord(figCoord);\n      const adjToThug = (adjacency[fc] || []).some((n) => thugCoords.has(normalizeCoord(n)));\n      if (adjToThug) damageEvents.push({ figureKey: figKey\x2C playerNum: pn\x2C damage: 2 });\n    }\n  }\n\n  return { logs\x2C damageEvents };\n}\n
