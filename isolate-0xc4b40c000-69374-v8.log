script-source,212,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/asset-paths.js,/**\n * Asset path resolution utilities for CC/DC card images\x2C figure tokens\x2C\n * condition cards\x2C and mission cards. No Discord dependency.\n */\nimport { existsSync } from 'fs';\nimport { join\x2C dirname } from 'path';\nimport { fileURLToPath } from 'url';\nimport { getDcImages\x2C getFigureImages\x2C getRootDir } from './data-loader.js';\nimport { isFigurelessDc } from './game/dc-helpers.js';\n\nconst __dirname = dirname(fileURLToPath(import.meta.url));\nconst rootDir = join(__dirname\x2C '..');\nconst IMAGES_DIR = join(rootDir\x2C 'vassal_extracted'\x2C 'images');\nconst CC_DIR = join(IMAGES_DIR\x2C 'cc');\nconst CARDBACKS_DIR = join(IMAGES_DIR\x2C 'cardbacks');\n\n/**\n * Maps figure DC name \u2192 { upgradeName \u2192 upgraded card image path }.\n * When a figure has the named skirmish upgrade attached\x2C the embed shows the upgraded art.\n */\nexport const UPGRADE_IMAGE_OVERRIDES = {\n  'Darth Vader': { 'Driven by Hatred': 'vassal_extracted/images/dc-figures/Darth Vader Driven by Hatred.jpg' }\x2C\n  'Han Solo':    { 'Rogue Smuggler':   'vassal_extracted/images/dc-figures/Han Solo Rogue Smuggler.jpg' }\x2C\n  'Chewbacca':   { 'Wookiee Avenger':  'vassal_extracted/images/dc-figures/Chewbacca Wookiee Avenger.jpg' }\x2C\n  'IG-88':       { 'Focused on the Kill': 'vassal_extracted/images/dc-figures/IG-88 Focused on the Kill.jpg' }\x2C\n};\n\n/** Resolve CC image path (cc/ subfolder first\x2C IACP variants\x2C cardback fallback). */\nexport function getCommandCardImagePath(cardName) {\n  if (!cardName || typeof cardName !== 'string') return null;\n  const stripped = cardName.replace(/\\s+\\((?:Mercenary|Imperial|Rebel)\\)$/i\x2C '').trim();\n  const clean = stripped.replace(/[':]/g\x2C '').replace(/\\s+/g\x2C ' ').trim();\n  const iacp = `${stripped} (IACP)`;\n  const cleanIacp = `${clean} (IACP)`;\n  const candidates = [];\n  if (stripped.trim().toLowerCase() === 'smoke grenade') {\n    candidates.push('Smoke Grenade Final.png'\x2C '003 Smoke Grenade Final.png');\n  }\n  for (const base of [iacp\x2C cleanIacp\x2C stripped\x2C clean]) {\n    candidates.push(`${base}.jpg`\x2C `${base}.png`);\n  }\n  for (const base of [stripped\x2C clean]) {\n    candidates.push(\n      `C card--${base}.jpg`\x2C\n      `C card--${base}.png`\x2C\n      `IACP_C card--${base}.png`\x2C\n      `IACP_C card--${base}.jpg`\x2C\n      `IACP9_C card--${base}.png`\x2C\n      `IACP9_C card--${base}.jpg`\x2C\n      `IACP10_C card--${base}.png`\x2C\n      `IACP10_C card--${base}.jpg`\x2C\n      `IACP11_C card--${base}.png`\x2C\n      `IACP11_C card--${base}.jpg`\x2C\n    );\n  }\n  for (const c of candidates) {\n    const inCc = join(CC_DIR\x2C c);\n    if (existsSync(inCc)) return inCc;\n    const inRoot = join(IMAGES_DIR\x2C c);\n    if (existsSync(inRoot)) return inRoot;\n  }\n  const cardbackCandidates = [\n    join(CARDBACKS_DIR\x2C 'Command cardback.jpg')\x2C\n    join(CC_DIR\x2C 'Command cardback.jpg')\x2C\n    join(IMAGES_DIR\x2C 'Command cardback.jpg')\x2C\n  ];\n  for (const p of cardbackCandidates) {\n    if (existsSync(p)) return p;\n  }\n  return null;\n}\n\n/** Try subfolder first\x2C then root. relPath is e.g. "vassal_extracted/images/X.gif". */\nexport function resolveAssetPath(relPath\x2C subfolder) {\n  if (!relPath || typeof relPath !== 'string') return null;\n  const filename = relPath.split(/[/\\\\]/).pop() || relPath;\n  const inSub = `vassal_extracted/images/${subfolder}/${filename}`;\n  if (existsSync(join(rootDir\x2C inSub))) return inSub;\n  if (subfolder === 'figures') {\n    const inTokens = `vassal_extracted/images/figure-tokens/${filename}`;\n    if (existsSync(join(rootDir\x2C inTokens))) return inTokens;\n  }\n  if (existsSync(join(rootDir\x2C relPath))) return relPath;\n  return relPath;\n}\n\n/** Prefer IACP variant image when it exists. Then prefer dc-figures/ or DC Skirmish Upgrades/ subfolder. */\nexport function resolveDcImagePath(relPath\x2C dcName) {\n  if (!relPath || typeof relPath !== 'string') return null;\n  const parts = relPath.split(/[/\\\\]/);\n  const dirRel = parts.slice(0\x2C -1).join('/');\n  const baseWithExt = parts[parts.length - 1] || relPath;\n  const baseName = baseWithExt.replace(/\\.[^.]+$/\x2C '');\n  for (const ext of ['.jpg'\x2C '.png'\x2C '.gif']) {\n    const iacpRel = dirRel + '/' + baseName + ' (IACP)' + ext;\n    if (existsSync(join(rootDir\x2C ...iacpRel.split('/')))) return iacpRel;\n  }\n  const filename = baseWithExt;\n  const subfolder = dcName && isFigurelessDc(dcName) ? 'DC Skirmish Upgrades' : 'dc-figures';\n  const inSub = `vassal_extracted/images/${subfolder}/${filename}`;\n  if (existsSync(join(rootDir\x2C inSub))) return inSub;\n  const otherSub = subfolder === 'dc-figures' ? 'DC Skirmish Upgrades' : 'dc-figures';\n  const inOther = `vassal_extracted/images/${otherSub}/${filename}`;\n  if (existsSync(join(rootDir\x2C inOther))) return inOther;\n  if (existsSync(join(rootDir\x2C relPath))) return relPath;\n  return relPath;\n}\n\n/** Shared fuzzy image lookup: exact \u2192 lowercase \u2192 strip Elite/Regular \u2192 prefix match. */\nfunction _lookupImageByName(registry\x2C dcName\x2C resolve) {\n  if (!dcName || typeof dcName !== 'string') return null;\n  const exact = registry[dcName];\n  if (exact) return resolve(exact\x2C dcName);\n  const lower = dcName.toLowerCase();\n  let key = Object.keys(registry).find((k) => k.toLowerCase() === lower);\n  if (key) return resolve(registry[key]\x2C key);\n  const base = dcName.replace(/\\s*\\((?:Elite|Regular)\\)\\s*$/i\x2C '').trim();\n  if (base !== dcName) {\n    key = Object.keys(registry).find((k) => k.toLowerCase() === base.toLowerCase());\n    if (key) return resolve(registry[key]\x2C key);\n    key = Object.keys(registry).find((k) => k.toLowerCase().startsWith(base.toLowerCase()));\n    if (key) return resolve(registry[key]\x2C key);\n  }\n  key = Object.keys(registry).find((k) => k.toLowerCase().startsWith(lower) || lower.startsWith(k.toLowerCase()));\n  return key ? resolve(registry[key]\x2C key) : null;\n}\n\n/** Resolve DC name to DC card image path (for deployment card embeds). */\nexport function getDcImagePath(dcName) {\n  if (!dcName || typeof dcName !== 'string') return null;\n  const registry = getDcImages();\n  // Bracket-wrapped DC names (e.g. "[Skirmish Upgrade]")\n  const trimmed = dcName.trim();\n  if (!/^\\[.+\\]$/.test(trimmed) && registry[`[${trimmed}]`]) {\n    return resolveDcImagePath(registry[`[${trimmed}]`]\x2C `[${trimmed}]`);\n  }\n  return _lookupImageByName(registry\x2C dcName\x2C resolveDcImagePath);\n}\n\n/** Return absolute path to condition card image\x2C or null if not found. */\n// Game state stores short verbs (Focus\x2C Stun\x2C etc.); card files use participles (Focused\x2C Stunned\x2C etc.)\nconst COND_CARD_NAME = { Focus: 'Focused'\x2C Stun: 'Stunned'\x2C Bleed: 'Bleeding'\x2C Weaken: 'Weakened'\x2C Hide: 'Hidden' };\nexport function getConditionCardPath(conditionName) {\n  if (!conditionName) return null;\n  const fname = `Condition card--${COND_CARD_NAME[conditionName] || conditionName}.jpg`;\n  const p = join(rootDir\x2C 'vassal_extracted'\x2C 'images'\x2C 'conditions'\x2C fname);\n  return existsSync(p) ? p : null;\n}\n\n/** Resolve DC name to circular figure image (for map tokens). */\nexport function getFigureImagePath(dcName) {\n  return _lookupImageByName(getFigureImages()\x2C dcName\x2C (path) => resolveAssetPath(path\x2C 'figures'));\n}\n\n/** Resolve mission card image path; tries .png\x2C .jpg\x2C .jpeg so data can say .png while files are .jpg. */\nexport function resolveMissionCardImagePath(relPath) {\n  if (!relPath || typeof relPath !== 'string') return null;\n  const subfolder = 'mission-cards';\n  const filename = relPath.split(/[/\\\\]/).pop() || relPath;\n  const base = filename.replace(/\\.[^.]+$/i\x2C '') || filename;\n  const exts = ['.png'\x2C '.jpg'\x2C '.jpeg'];\n  const tried = new Set();\n  for (const ext of exts) {\n    const name = base + ext;\n    if (tried.has(name.toLowerCase())) continue;\n    tried.add(name.toLowerCase());\n    const inSub = `vassal_extracted/images/${subfolder}/${name}`;\n    if (existsSync(join(rootDir\x2C inSub))) return inSub;\n  }\n  return resolveAssetPath(relPath\x2C subfolder);\n}\n
