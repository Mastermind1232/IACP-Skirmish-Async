.dictionaryConverter([\n  {\n    key: 'status'\x2C\n    converter: webidl.converters['unsigned short']\x2C\n    defaultValue: () => 200\n  }\x2C\n  {\n    key: 'statusText'\x2C\n    converter: webidl.converters.ByteString\x2C\n    defaultValue: () => ''\n  }\x2C\n  {\n    key: 'headers'\x2C\n    converter: webidl.converters.HeadersInit\n  }\n])\n\nmodule.exports = {\n  isNetworkError\x2C\n  makeNetworkError\x2C\n  makeResponse\x2C\n  makeAppropriateNetworkError\x2C\n  filterResponse\x2C\n  Response\x2C\n  cloneResponse\x2C\n  fromInnerResponse\n}\n
