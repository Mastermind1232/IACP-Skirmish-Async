code-creation,Script,9,76404,0x7c98725abd8,105, file:///Users/adammeehan/Public/IACP-Skirmish-Async/tests/headless/benchmark-mcts.js:1:1,0x78fd2b012c0,~
script-source,86,file:///Users/adammeehan/Public/IACP-Skirmish-Async/tests/headless/benchmark-mcts.js,#!/usr/bin/env node\n/**\n * MCTS feasibility benchmark: measures the per-iteration cost of a tree-search\n * rollout against the current simulator.\n *\n * Measurements:\n *   [1] structuredClone(state)               \u2014 clone cost per MCTS branch\n *   [2] getAvailableActions(state\x2C p)        \u2014 legal-move enumeration\n *   [3] pickSmartAction(...) (DQN eval)      \u2014 leaf-node value estimation\n *   [4] full cycle: clone + enumerate + step \u2014 atomic MCTS iteration\n *\n * Budget calculation: real MCTS does ~1 full cycle per simulation. At think\n * time T\x2C the number of simulations per decision \u2248 T / cycle_time.\n *\n * Run: node tests/headless/benchmark-mcts.js\n */\nimport { createTestGame } from '../fixtures/game-builder.js';\nimport { getAvailableActions } from '../../src/engine/available-actions.js';\nimport { getDcStats\x2C getMapData } from '../../src/data-loader.js';\nimport { getBoardStateForMovement\x2C getMovementProfile\x2C computeMovementCache } from '../../src/game/movement.js';\nimport { getPlayableCcFromHand } from '../../src/game/cc-timing.js';\nimport { pickSmartAction\x2C loadLearnings\x2C initializeNetwork } from './learnings.js';\nimport { performance } from 'perf_hooks';\n\nconst BENCH_ITERS = 1000;\nconst WARMUP_ITERS = 50;\n\nasync function autoResolvePhaseGates(harness\x2C game\x2C budget = 20) {\n  let safety = budget;\n  while (safety-- > 0 && game.phaseGate) {\n    const gateId = `phase_gate_ready_${game.gameId}`;\n    try { await harness.submitAction(gateId\x2C game.player1Id); } catch {}\n    if (game.phaseGate) {\n      try { await harness.submitAction(gateId\x2C game.player2Id); } catch {}\n    }\n  }\n}\n\nasync function advanceNActions(harness\x2C game\x2C actionDeps\x2C playerNum\x2C n) {\n  const userId = playerNum === 1 ? game.player1Id : game.player2Id;\n  for (let i = 0; i < n; i++) {\n    if (game.ended) return;\n    const actions = getAvailableActions(game\x2C playerNum\x2C actionDeps);\n    if (actions.length === 0) return;\n    // Prefer an activate_dc to get into activation flow\n    const a = actions.find(x => x.type === 'activate_dc') || actions[0];\n    try { await harness.submitAction(a.customId\x2C userId); } catch {}\n  }\n}\n\nfunction fmtUs(ms) {\n  return `${(ms * 1000).toFixed(1)} \xb5s`;\n}\n\nfunction budgetLine(label\x2C msPerOp) {\n  const line = [50\x2C 100\x2C 250\x2C 500].map(b => `${b}ms\u2192${Math.floor(b / msPerOp)}`).join('  ');\n  return `    ${label}: ${line}`;\n}\n\nasync function main() {\n  console.log('=== MCTS Feasibility Benchmark ===\\n');\n\n  // \u2500\u2500 1. Build a game and advance to a realistic mid-round state \u2500\u2500\n  const builder = createTestGame()\n    .lightweight()\n    .withMap('mos-eisley-outskirts')\n    .withMissionVariant('a')\n    .withPlayer1Army([{ dcName: 'storm-troopers' }\x2C { dcName: 'royal-guards' }])\n    .withPlayer2Army([{ dcName: 'rebel-troopers' }\x2C { dcName: 'han-solo' }])\n    .inRound(1);\n\n  const { game\x2C harness\x2C deps\x2C dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState } = builder.build();\n  const hDeps = harness.getDeps();\n  const actionDeps = {\n    dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState\x2C getDcStats\x2C getMapData\x2C\n    computeMovementCache\x2C getBoardStateForMovement\x2C getMovementProfile\x2C\n    getPlayableCcFromHand\x2C\n    getPlayableCcSpecialsForDc: hDeps.getPlayableCcSpecialsForDc\x2C\n    getPlayableCcDoubleActionsForDc: hDeps.getPlayableCcDoubleActionsForDc\x2C\n  };\n\n  await autoResolvePhaseGates(harness\x2C game);\n  await advanceNActions(harness\x2C game\x2C actionDeps\x2C 1\x2C 4);\n  await autoResolvePhaseGates(harness\x2C game);\n  await advanceNActions(harness\x2C game\x2C actionDeps\x2C 2\x2C 4);\n  await autoResolvePhaseGates(harness\x2C game);\n\n  const snapJson = JSON.stringify(game);\n  const sizeKb = (snapJson.length / 1024).toFixed(1);\n  const actionsSample = getAvailableActions(game\x2C 1\x2C actionDeps);\n  console.log(`Mid-round state: round=${game.currentRound}\x2C phase=${game.phase}\x2C ended=${!!game.ended}`);\n  console.log(`State size (JSON-serialized): ${sizeKb} KB`);\n  console.log(`Legal actions (p1) at snapshot: ${actionsSample.length}`);\n  console.log('');\n\n  const snap = structuredClone(game);\n\n  // \u2500\u2500 2. Load or init learnings for DQN eval \u2500\u2500\n  let learnings;\n  try {\n    learnings = loadLearnings('./tests/headless/learnings-data.json');\n    console.log(`DQN: loaded checkpoint (totalGames=${learnings.totalGames || '?'})`);\n  } catch (e) {\n    learnings = initializeNetwork();\n    console.log(`DQN: using fresh-init network (checkpoint load failed: ${e.message})`);\n  }\n  console.log('');\n\n  // \u2500\u2500 3. Warmup \u2500\u2500\n  for (let i = 0; i < WARMUP_ITERS; i++) {\n    structuredClone(snap);\n    getAvailableActions(snap\x2C 1\x2C actionDeps);\n    pickSmartAction(actionsSample\x2C snap\x2C learnings\x2C 1\x2C dcHealthState\x2C dcMessageMeta);\n  }\n\n  // \u2500\u2500 4. Benchmark: structuredClone \u2500\u2500\n  {\n    const t0 = performance.now();\n    for (let i = 0; i < BENCH_ITERS; i++) structuredClone(snap);\n    const t1 = performance.now();\n    const msPerOp = (t1 - t0) / BENCH_ITERS;\n    console.log(`[1] structuredClone(state)           ${fmtUs(msPerOp).padStart(10)}/op`);\n    console.log(budgetLine('clones'\x2C msPerOp));\n  }\n\n  // \u2500\u2500 5. Benchmark: getAvailableActions \u2500\u2500\n  {\n    const t0 = performance.now();\n    let sumActions = 0;\n    for (let i = 0; i < BENCH_ITERS; i++) {\n      const a = getAvailableActions(snap\x2C 1\x2C actionDeps);\n      sumActions += a.length;\n    }\n    const t1 = performance.now();\n    const msPerOp = (t1 - t0) / BENCH_ITERS;\n    console.log(`[2] getAvailableActions(state\x2C p)    ${fmtUs(msPerOp).padStart(10)}/op  (avg ${(sumActions / BENCH_ITERS).toFixed(1)} actions)`);\n    console.log(budgetLine('enums'\x2C msPerOp));\n  }\n\n  // \u2500\u2500 6. Benchmark: DQN eval (pickSmartAction) \u2500\u2500\n  {\n    const actions = getAvailableActions(snap\x2C 1\x2C actionDeps);\n    const t0 = performance.now();\n    for (let i = 0; i < BENCH_ITERS; i++) {\n      pickSmartAction(actions\x2C snap\x2C learnings\x2C 1\x2C dcHealthState\x2C dcMessageMeta);\n    }\n    const t1 = performance.now();\n    const msPerOp = (t1 - t0) / BENCH_ITERS;\n    console.log(`[3] pickSmartAction (DQN fwd pass)   ${fmtUs(msPerOp).padStart(10)}/op`);\n    console.log(budgetLine('evals '\x2C msPerOp));\n  }\n\n  // \u2500\u2500 7. Benchmark: full MCTS-style iteration \u2500\u2500\n  // Each iteration: clone snapshot \u2192 install as current game \u2192 enumerate \u2192 step once\n  {\n    const gamesMap = harness.getGamesMap();\n    // Save the original dcExhausted/dcHealth state for reset\n    const origExhausted = new Map(dcExhaustedState);\n    const origHealth = new Map(dcHealthState);\n    const t0 = performance.now();\n    let okCount = 0;\n    for (let i = 0; i < BENCH_ITERS; i++) {\n      // Clone state + install\n      const cloned = structuredClone(snap);\n      gamesMap.set(snap.gameId\x2C cloned);\n      // Reset sidecar maps to snapshot state\n      dcExhaustedState.clear();\n      for (const [k\x2C v] of origExhausted) dcExhaustedState.set(k\x2C v);\n      dcHealthState.clear();\n      for (const [k\x2C v] of origHealth) dcHealthState.set(k\x2C v);\n\n      const actions = getAvailableActions(cloned\x2C 1\x2C actionDeps);\n      if (actions.length > 0) {\n        try {\n          await harness.submitAction(actions[0].customId\x2C cloned.player1Id);\n          okCount++;\n        } catch {}\n      }\n    }\n    const t1 = performance.now();\n    const msPerOp = (t1 - t0) / BENCH_ITERS;\n    console.log(`[4] FULL CYCLE (clone+enum+step)     ${fmtUs(msPerOp).padStart(10)}/op  (${okCount}/${BENCH_ITERS} ok)`);\n    console.log(budgetLine('sims  '\x2C msPerOp));\n    console.log('');\n    console.log('\u2500\u2500 MCTS viability assessment \u2500\u2500');\n    const sims100 = Math.floor(100 / msPerOp);\n    const sims500 = Math.floor(500 / msPerOp);\n    if (sims100 >= 1000) {\n      console.log(`\u2713 STRONG: ${sims100} sims @ 100ms \u2014 full MCTS depth+width feasible out of the box`);\n    } else if (sims100 >= 200) {\n      console.log(`\u25cb VIABLE: ${sims100} sims @ 100ms \u2014 usable but shallow; speedup recommended`);\n    } else if (sims100 >= 50) {\n      console.log(`\u25b3 MARGINAL: ${sims100} sims @ 100ms \u2014 need optimization or longer think time (${sims500} @ 500ms)`);\n    } else {\n      console.log(`\u2717 BLOCKED: ${sims100} sims @ 100ms \u2014 simulator speedup required before MCTS build`);\n    }\n  }\n}\n\nmain().catch(err => { console.error('ERROR:'\x2C err); process.exit(1); });\n
