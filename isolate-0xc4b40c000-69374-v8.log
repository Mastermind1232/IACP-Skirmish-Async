adata(client\x2C messageInteractionMetadata) {\n  return {\n    id: messageInteractionMetadata.id\x2C\n    type: messageInteractionMetadata.type\x2C\n    user: client.users._add(messageInteractionMetadata.user)\x2C\n    authorizingIntegrationOwners: messageInteractionMetadata.authorizing_integration_owners\x2C\n    originalResponseMessageId: messageInteractionMetadata.original_response_message_id ?? null\x2C\n    interactedMessageId: messageInteractionMetadata.interacted_message_id ?? null\x2C\n    triggeringInteractionMetadata: messageInteractionMetadata.triggering_interaction_metadata\n      ? _transformAPIMessageInteractionMetadata(client\x2C messageInteractionMetadata.triggering_interaction_metadata)\n      : null\x2C\n  };\n}\n\n/**\n * Transforms a guild scheduled event recurrence rule object to a snake-cased variant.\n * @param {GuildScheduledEventRecurrenceRuleOptions} recurrenceRule The recurrence rule to transform\n * @returns {APIGuildScheduledEventRecurrenceRule}\n * @ignore\n */\nfunction _transformGuildScheduledEventRecurrenceRule(recurrenceRule) {\n  return {\n    start: new Date(recurrenceRule.startAt).toISOString()\x2C\n    frequency: recurrenceRule.frequency\x2C\n    interval: recurrenceRule.interval\x2C\n    by_weekday: recurrenceRule.byWeekday\x2C\n    by_n_weekday: recurrenceRule.byNWeekday\x2C\n    by_month: recurrenceRule.byMonth\x2C\n    by_month_day: recurrenceRule.byMonthDay\x2C\n  };\n}\n\n/**\n * Transforms API incidents data to a camel-cased variant.\n * @param {APIIncidentsData} data The incidents data to transform\n * @returns {IncidentActions}\n * @ignore\n */\nfunction _transformAPIIncidentsData(data) {\n  return {\n    invitesDisabledUntil: data.invites_disabled_until ? new Date(data.invites_disabled_until) : null\x2C\n    dmsDisabledUntil: data.dms_disabled_until ? new Date(data.dms_disabled_until) : null\x2C\n    dmSpamDetectedAt: data.dm_spam_detected_at ? new Date(data.dm_spam_detected_at) : null\x2C\n    raidDetectedAt: data.raid_detected_at ? new Date(data.raid_detected_at) : null\x2C\n  };\n}\n\n/**\n * Transforms a collectibles object to a camel-cased variant.\n *\n * @param {APICollectibles} collectibles The collectibles to transform\n * @returns {Collectibles}\n * @ignore\n */\nfunction _transformCollectibles(collectibles) {\n  if (!collectibles.nameplate) return { nameplate: null };\n\n  return {\n    nameplate: {\n      skuId: collectibles.nameplate.sku_id\x2C\n      asset: collectibles.nameplate.asset\x2C\n      label: collectibles.nameplate.label\x2C\n      palette: collectibles.nameplate.palette\x2C\n    }\x2C\n  };\n}\n\nmodule.exports = {\n  toSnakeCase\x2C\n  _transformAPIAutoModerationAction\x2C\n  _transformAPIMessageInteractionMetadata\x2C\n  _transformGuildScheduledEventRecurrenceRule\x2C\n  _transformAPIIncidentsData\x2C\n  _transformCollectibles\x2C\n};\n
