script-source,81,node:internal/net,'use strict';\n\nconst {\n  RegExp\x2C\n  RegExpPrototypeTest\x2C\n  Symbol\x2C\n} = primordials;\n\nconst Buffer = require('buffer').Buffer;\nconst { writeBuffer } = internalBinding('fs');\nconst {\n  UVException\x2C\n} = require('internal/errors');\n\n// IPv4 Segment\nconst v4Seg = '(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])';\nconst v4Str = `(?:${v4Seg}\\\\.){3}${v4Seg}`;\nconst IPv4Reg = new RegExp(`^${v4Str}$`);\n\n// IPv6 Segment\nconst v6Seg = '(?:[0-9a-fA-F]{1\x2C4})';\nconst IPv6Reg = new RegExp('^(?:' +\n  `(?:${v6Seg}:){7}(?:${v6Seg}|:)|` +\n  `(?:${v6Seg}:){6}(?:${v4Str}|:${v6Seg}|:)|` +\n  `(?:${v6Seg}:){5}(?::${v4Str}|(?::${v6Seg}){1\x2C2}|:)|` +\n  `(?:${v6Seg}:){4}(?:(?::${v6Seg}){0\x2C1}:${v4Str}|(?::${v6Seg}){1\x2C3}|:)|` +\n  `(?:${v6Seg}:){3}(?:(?::${v6Seg}){0\x2C2}:${v4Str}|(?::${v6Seg}){1\x2C4}|:)|` +\n  `(?:${v6Seg}:){2}(?:(?::${v6Seg}){0\x2C3}:${v4Str}|(?::${v6Seg}){1\x2C5}|:)|` +\n  `(?:${v6Seg}:){1}(?:(?::${v6Seg}){0\x2C4}:${v4Str}|(?::${v6Seg}){1\x2C6}|:)|` +\n  `(?::(?:(?::${v6Seg}){0\x2C5}:${v4Str}|(?::${v6Seg}){1\x2C7}|:))` +\n')(?:%[0-9a-zA-Z-.:]{1\x2C})?$');\n\n/**\n * @param {string} s\n * @returns {boolean}\n */\nfunction isIPv4(s) {\n  // TODO(aduh95): Replace RegExpPrototypeTest with RegExpPrototypeExec when it\n  // no longer creates a perf regression in the dns benchmark.\n  // eslint-disable-next-line node-core/avoid-prototype-pollution\n  return RegExpPrototypeTest(IPv4Reg\x2C s);\n}\n\n/**\n * @param {string} s\n * @returns {boolean}\n */\nfunction isIPv6(s) {\n  // TODO(aduh95): Replace RegExpPrototypeTest with RegExpPrototypeExec when it\n  // no longer creates a perf regression in the dns benchmark.\n  // eslint-disable-next-line node-core/avoid-prototype-pollution\n  return RegExpPrototypeTest(IPv6Reg\x2C s);\n}\n\n/**\n * @param {string} s\n * @returns {4|6|0}\n */\nfunction isIP(s) {\n  if (isIPv4(s)) return 4;\n  if (isIPv6(s)) return 6;\n  return 0;\n}\n\nfunction makeSyncWrite(fd) {\n  return function(chunk\x2C enc\x2C cb) {\n    if (enc !== 'buffer')\n      chunk = Buffer.from(chunk\x2C enc);\n\n    this._handle.bytesWritten += chunk.length;\n\n    const ctx = {};\n    writeBuffer(fd\x2C chunk\x2C 0\x2C chunk.length\x2C null\x2C undefined\x2C ctx);\n    if (ctx.errno !== undefined) {\n      const ex = new UVException(ctx);\n      ex.errno = ctx.errno;\n      return cb(ex);\n    }\n    cb();\n  };\n}\n\n/**\n * https://www.iana.org/assignments/iana-ipv4-special-registry/iana-ipv4-special-registry.xhtml\n * https://www.iana.org/assignments/iana-ipv6-special-registry/iana-ipv6-special-registry.xhtml\n * https://www.iana.org/assignments/special-use-domain-names/special-use-domain-names.xhtml\n * @param {string} host\n * @returns {boolean}\n */\nfunction isLoopback(host) {\n  const hostLower = host.toLowerCase();\n\n  return (\n    hostLower === 'localhost' ||\n    hostLower.startsWith('127.') ||\n    hostLower === '[::1]' ||\n    hostLower === '[0:0:0:0:0:0:0:1]'\n  );\n}\n\nmodule.exports = {\n  kReinitializeHandle: Symbol('kReinitializeHandle')\x2C\n  isIP\x2C\n  isIPv4\x2C\n  isIPv6\x2C\n  makeSyncWrite\x2C\n  normalizedArgsSymbol: Symbol('normalizedArgs')\x2C\n  isLoopback\x2C\n};\n
