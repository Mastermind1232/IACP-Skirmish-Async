script-source,47,node:internal/source_map/source_map_cache,'use strict';\n\nconst {\n  ArrayPrototypeIndexOf\x2C\n  ArrayPrototypePush\x2C\n  JSONParse\x2C\n  ObjectFreeze\x2C\n  RegExpPrototypeExec\x2C\n  RegExpPrototypeSymbolSplit\x2C\n  SafeMap\x2C\n  StringPrototypeCodePointAt\x2C\n  StringPrototypeSplit\x2C\n  StringPrototypeStartsWith\x2C\n} = primordials;\n\n// See https://tc39.es/ecma426/ for SourceMap V3 specification.\nconst { Buffer } = require('buffer');\nlet debug = require('internal/util/debuglog').debuglog('source_map'\x2C (fn) => {\n  debug = fn;\n});\n\nconst { readFileSync } = require('fs');\nconst { validateBoolean\x2C validateObject } = require('internal/validators');\nconst {\n  setSourceMapsEnabled: setSourceMapsNative\x2C\n} = internalBinding('errors');\nconst {\n  defaultPrepareStackTrace\x2C\n  setInternalPrepareStackTrace\x2C\n} = require('internal/errors');\nconst { getLazy\x2C isUnderNodeModules\x2C kEmptyObject } = require('internal/util');\n\nconst getModuleSourceMapCache = getLazy(() => {\n  const { SourceMapCacheMap } = require('internal/source_map/source_map_cache_map');\n  return new SourceMapCacheMap();\n});\n\n// The generated source module/script instance is not accessible\x2C so we can use\n// a Map without memory concerns. Separate generated source entries with the module\n// source entries to avoid overriding the module source entries with arbitrary\n// source url magic comments.\nconst generatedSourceMapCache = new SafeMap();\nconst kLeadingProtocol = /^\\w+:\\/\\//;\nconst kSourceMappingURLMagicComment = /\\/[*/]#\\s+sourceMappingURL=(?<sourceMappingURL>[^\\s]+)/g;\nconst kSourceURLMagicComment = /\\/[*/]#\\s+sourceURL=(?<sourceURL>[^\\s]+)/g;\n\nconst { isAbsolute } = require('path');\nconst { fileURLToPath\x2C pathToFileURL\x2C URL\x2C URLParse } = require('internal/url');\n\nlet SourceMap;\n\n// This is configured with --enable-source-maps during pre-execution.\nlet sourceMapsSupport = ObjectFreeze({\n  __proto__: null\x2