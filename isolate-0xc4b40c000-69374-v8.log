code-creation,Script,9,177890,0x3f05b92850c0,52, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/figure-config.js:1:1,0x3c1234eaac78,~
script-source,175,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/figure-config.js,/**\n * Per-figure config store.\n * Stores persistent per-figure data: loadout choice\x2C form choice\x2C companion state\x2C attachments.\n * game.figureConfig[figureKey] = { loadout\x2C form\x2C attachments: [...]\x2C ... }\n */\n\n/**\n * Get config for a figure. Returns empty object if none set.\n * @param {object} game\n * @param {string} figureKey\n * @returns {object}\n */\nexport function getConfig(game\x2C figureKey) {\n  return game.figureConfig?.[figureKey] || {};\n}\n\n/**\n * Set a single config key for a figure.\n * @param {object} game\n * @param {string} figureKey\n * @param {string} key\n * @param {*} val\n */\nexport function setConfig(game\x2C figureKey\x2C key\x2C val) {\n  game.figureConfig = game.figureConfig || {};\n  game.figureConfig[figureKey] = game.figureConfig[figureKey] || {};\n  game.figureConfig[figureKey][key] = val;\n}\n\n/**\n * Clear all config for a figure (e.g.\x2C on defeat).\n * @param {object} game\n * @param {string} figureKey\n */\nexport function clearConfig(game\x2C figureKey) {\n  if (game.figureConfig) delete game.figureConfig[figureKey];\n}\n\n/**\n * Get list of attachment card names for a figure.\n * @param {object} game\n * @param {string} figureKey\n * @returns {string[]}\n */\nexport function getAttachments(game\x2C figureKey) {\n  return game.figureConfig?.[figureKey]?.attachments || [];\n}\n\n/**\n * Check if a figure has a specific attachment.\n * @param {object} game\n * @param {string} figureKey\n * @param {string} attachmentName\n * @returns {boolean}\n */\nexport function hasAttachment(game\x2C figureKey\x2C attachmentName) {\n  return getAttachments(game\x2C figureKey).includes(attachmentName);\n}\n\n/**\n * Returns a Set of form names already chosen by OTHER Clawdite Shapeshifters\n * on the same team.  Used to prevent two Clawdites from sharing a form.\n * @param {object} game\n * @param {number} playerNum  1 or 2\n * @param {string} excludeFigureKey  figureKey of the Clawdite currently picking\n * @returns {Set<string>}\n */\nexport function getFormsChosenByTeamClawdites(game\x2C playerNum\x2C excludeFigureKey) {\n  const taken = new Set();\n  const positions = game.figurePositions?.[playerNum] || {};\n  for (const fk of Object.keys(positions)) {\n    if (fk === excludeFigureKey) continue;\n    if (!fk.startsWith('Clawdite Shapeshifter')) continue;\n    const form = getConfig(game\x2C fk)?.form;\n    if (form) taken.add(form);\n  }\n  return taken;\n}\n
