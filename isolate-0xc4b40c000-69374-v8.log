code-creation,Script,9,77838,0x7c98725c208,193, file:///Users/adammeehan/Public/IACP-Skirmish-Async/tests/fixtures/game-builder.js:1:1,0x78fd2b09190,~
script-source,88,file:///Users/adammeehan/Public/IACP-Skirmish-Async/tests/fixtures/game-builder.js,/**\n * Fluent game builder for headless integration tests.\n *\n * Usage:\n *   const { game\x2C harness\x2C deps } = createTestGame()\n *     .withMap('mos-eisley-outskirts')\n *     .withPlayer1Army([{ dcName: 'Stormtrooper'\x2C count: 1 }])\n *     .withPlayer2Army([{ dcName: 'Rebel Saboteur'\x2C count: 1 }])\n *     .deployed()\n *     .inRound(1)\n *     .build();\n */\n\nimport { createHarness } from '../../src/headless/game-harness.js';\nimport { buildHeadlessDeps } from '../../src/headless/headless-deps.js';\nimport { initializeDcState\x2C initializeFigurePositions } from '../../src/headless/init-dc-state.js';\nimport { getDcStats\x2C getDeploymentZones\x2C getMapData\x2C getMissionCardsData\x2C getMapTokensData } from '../../src/data-loader.js';\nimport { PHASES\x2C ROUND_PHASES } from '../../src/game/phase.js';\nimport { isFigurelessDc } from '../../src/game/dc-helpers.js';\n\nlet gameIdCounter = 1;\n\nexport function createTestGame() {\n  return new GameBuilder();\n}\n\nclass GameBuilder {\n  constructor() {\n    this._mapId = 'mos-eisley-outskirts';\n    this._p1Army = [];\n    this._p2Army = [];\n    this._deployed = false;\n    this._round = 0;\n    this._gameId = String(gameIdCounter++).padStart(5\x2C '0');\n    this._p1Id = 'player1';\n    this._p2Id = 'player2';\n    this._p1CcDeck = [];\n    this._p2CcDeck = [];\n    this._p1CcHand = [];\n    this._p2CcHand = [];\n    this._missionVariant = null;\n    this._lightweight = false;\n  }\n\n  lightweight() { this._lightweight = true; return this; }\n  withMap(mapId) { this._mapId = mapId; return this; }\n  withGameId(id) { this._gameId = id; return this; }\n  withPlayer1Id(id) { this._p1Id = id; return this; }\n  withPlayer2Id(id) { this._p2Id = id; return this; }\n\n  withPlayer1Army(army) { this._p1Army = army; return this; }\n  withPlayer2Army(army) { this._p2Army = army; return this; }\n\n  withMissionVariant(variant) { this._missionVariant = variant; return this; }\n  withPlayer1CcHand(cards) { this._p1CcHand = cards; return this; }\n  withPlayer2CcHand(cards) { this._p2CcHand = cards; return this; }\n  withPlayer1CcDeck(cards) { this._p1CcDeck = cards; return this; }\n  withPlayer2CcDeck(cards) { this._p2CcDeck = cards; return this; }\n\n  deployed() { this._deployed = true; return this; }\n  inRound(n) { this._round = n; this._deployed = true; return this; }\n\n  build() {\n    const game = this._buildGame();\n    const dcMessageMeta = new Map();\n    const dcExhaustedState = new Map();\n    const dcHealthState = new Map();\n\n    // Initialize DC state\n    initializeDcState(game\x2C dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState);\n\n    // Build deps and harness\n    const deps = buildHeadlessDeps({\n      dcMessageMeta\x2C\n      dcExhaustedState\x2C\n      dcHealthState\x2C\n      lightweight: this._lightweight\x2C\n    });\n\n    // If deployed\x2C initialize figure positions\n    if (this._deployed) {\n      const deploymentZones = getDeploymentZones();\n      const mapSpaces = getMapData(this._mapId);\n      initializeFigurePositions(game\x2C dcMessageMeta\x2C { deploymentZones\x2C mapSpaces });\n    }\n\n    // Set up activations\n    if (this._round > 0) {\n      this._setupActivations(game\x2C dcMessageMeta);\n    }\n\n    const harness = createHarness(game\x2C { deps\x2C dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState\x2C lightweight: this._lightweight });\n\n    return { game: harness.getGame()\x2C harness\x2C deps\x2C dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState };\n  }\n\n  _buildDcList(army) {\n    const dcList = [];\n    const counts = {};\n    for (const entry of army) {\n      const dcName = entry.dcName || entry;\n      const count = entry.count || 1;\n      for (let dg = 0; dg < count; dg++) {\n        counts[dcName] = (counts[dcName] || 0) + 1;\n        const dgIndex = counts[dcName];\n        const stats = getDcStats(dcName);\n        const displayName = count > 1 ? `${dcName} [Group ${dgIndex}]` : dcName;\n        const figureCount = stats?.figures ?? 1;\n        const maxHp = stats?.health ?? 1;\n        const healthState = [];\n        for (let f = 0; f < figureCount; f++) {\n          healthState.push([maxHp\x2C maxHp]);\n        }\n        dcList.push({\n          dcName\x2C\n          displayName\x2C\n          healthState\x2C\n          dgIndex\x2C\n          cost: stats?.cost ?? 0\x2C\n        });\n      }\n    }\n    return dcList;\n  }\n\n  _buildGame() {\n    const p1DcList = this._buildDcList(this._p1Army);\n    const p2DcList = this._buildDcList(this._p2Army);\n\n    const game = {\n      gameId: this._gameId\x2C\n      player1Id: this._p1Id\x2C\n      player2Id: this._p2Id\x2C\n      selectedMap: { id: this._mapId }\x2C\n      selectedMission: this._buildMission()\x2C\n      round: this._round || 1\x2C\n      currentRound: this._round || 1\x2C\n      ended: false\x2C\n\n      // Squads\n      player1Squad: { dcList: p1DcList.map(d => ({ dcName: d.dcName\x2C displayName: d.displayName })) }\x2C\n      player2Squad: { dcList: p2DcList.map(d => ({ dcName: d.dcName\x2C displayName: d.displayName })) }\x2C\n      p1DcList\x2C\n      p2DcList\x2C\n\n      // VP\n      player1VP: { total: 0\x2C kills: 0\x2C objectives: 0 }\x2C\n      player2VP: { total: 0\x2C kills: 0\x2C objectives: 0 }\x2C\n\n      // Figure positions\n      figurePositions: { 1: {}\x2C 2: {} }\x2C\n\n      // CC state \u2014 if a deck is provided and we're starting in-round\x2C\n      // shuffle and draw the standard 3-card starting hand automatically\n      // (mirrors setup-bridge.js drawStartingHand logic).\n      ...this._buildCcState()\x2C\n\n      // Initiative\n      initiativePlayerId: this._p1Id\x2C\n\n      // Deployment zones\n      deploymentZoneChosen: 'red'\x2C\n      player1DeploymentZone: 'red'\x2C\n      player2DeploymentZone: 'blue'\x2C\n\n      // Damage tracking\n      totalDamageReceived: { 1: 0\x2C 2: 0 }\x2C\n\n      // Undo\n      undoStack: []\x2C\n\n      // Channel IDs (headless: fake IDs so fetchGameChannel returns a usable channel)\n      generalId: `fake-general-${this._gameId}`\x2C\n    };\n\n    // Set phase based on build config\n    if (this._round > 0) {\n      game.phase = PHASES.ROUND_ACTIVE;\n      game.roundPhase = ROUND_PHASES.ACTIVATION;\n      game.currentActivationTurnPlayerId = this._p1Id;\n    } else if (this._deployed) {\n      game.phase = PHASES.ROUND_ACTIVE;\n      game.roundPhase = ROUND_PHASES.START_OF_ROUND;\n    } else {\n      game.phase = PHASES.LOBBY;\n    }\n\n    // Mission NPC initialization (mirrors dc-play-area.js NPC init)\n    if (this._missionVariant && this._deployed) {\n      const mapTokens = getMapTokensData();\n      if (this._mapId === 'chopper-base-atollon' && this._missionVariant === 'a') {\n        const positions = Object.values(mapTokens[this._mapId]?.missionA?.positions || {}).flat().filter(Boolean);\n        if (positions.length > 0) game.npcKrykna = positions.map((coord\x2C i) => ({ id: `krykna-${i + 1}`\x2C coord: String(coord).toLowerCase()\x2C hp: 8\x2C maxHp: 8\x2C defeated: false }));\n      }\n      if (this._mapId === 'corellian-underground' && this._missionVariant === 'a') {\n        const positions = Object.values(mapTokens[this._mapId]?.missionA?.positions || {}).flat().filter(Boolean);\n        if (positions.length > 0) game.npcThugs = positions.map((coord\x2C i) => ({ id: `thug-${i + 1}`\x2C coord: String(coord).toLowerCase()\x2C hp: 4\x2C maxHp: 4\x2C defeated: false }));\n      }\n    }\n\n    return game;\n  }\n\n  _buildCcState() {\n    const buildForPlayer = (deck\x2C hand) => {\n      // If explicit hand was provided\x2C use it as-is\n      if (hand.length > 0) return { deck: [...deck]\x2C hand: [...hand] };\n      // If deck provided and we're skipping to in-round\x2C draw starting hand\n      if (deck.length > 0 && this._round >= 1) {\n        const shuffled = [...deck];\n        // Fisher-Yates shuffle\n        for (let i = shuffled.length - 1; i > 0; i--) {\n          const j = Math.floor(Math.random() * (i + 1));\n          [shuffled[i]\x2C shuffled[j]] = [shuffled[j]\x2C shuffled[i]];\n        }\n        const drawn = shuffled.splice(0\x2C 3);\n        return { deck: shuffled\x2C hand: drawn };\n      }\n      return { deck: [...deck]\x2C hand: [] };\n    };\n\n    const p1 = buildForPlayer(this._p1CcDeck\x2C this._p1CcHand);\n    const p2 = buildForPlayer(this._p2CcDeck\x2C this._p2CcHand);\n\n    return {\n      player1CcHand: p1.hand\x2C\n      player2CcHand: p2.hand\x2C\n      player1CcDeck: p1.deck\x2C\n      player2CcDeck: p2.deck\x2C\n      player1CcDiscard: []\x2C\n      player2CcDiscard: []\x2C\n      player1CcDrawn: true\x2C\n      player2CcDrawn: true\x2C\n    };\n  }\n\n  _buildMission() {\n    if (!this._missionVariant) return null;\n    const missionCards = getMissionCardsData();\n    const mapMissions = missionCards?.[this._mapId];\n    const missionData = mapMissions?.[this._missionVariant];\n    if (missionData) {\n      return {\n        variant: this._missionVariant\x2C\n        name: missionData.name\x2C\n        fullName: missionData.name\x2C\n        tokenLabel: missionData.tokenLabel || ''\x2C\n        interactLabel: missionData.interactLabel || ''\x2C\n        mechanics: missionData.mechanics || {}\x2C\n        rules: missionData.rules || {}\x2C\n      };\n    }\n    return { variant: this._missionVariant };\n  }\n\n  _setupActivations(game\x2C dcMessageMeta) {\n    // Count non-figureless DCs for each player\n    let p1Acts = 0\x2C p2Acts = 0;\n    for (const [msgId\x2C meta] of dcMessageMeta) {\n      if (meta.gameId !== game.gameId) continue;\n      if (isFigurelessDc(meta.dcName)) continue;\n      if (meta.playerNum === 1) p1Acts++;\n      else p2Acts++;\n    }\n\n    game.p1ActivationsRemaining = p1Acts;\n    game.p2ActivationsRemaining = p2Acts;\n    game.p1ActivationsTotal = p1Acts;\n    game.p2ActivationsTotal = p2Acts;\n    game.p1ActivatedDcIndices = [];\n    game.p2ActivatedDcIndices = [];\n\n    // Initialize dcActionsData \u2014 each DC starts with 0 actions (not activated yet)\n    game.dcActionsData = {};\n  }\n}\n
