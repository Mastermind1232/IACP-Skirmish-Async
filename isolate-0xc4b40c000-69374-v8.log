script-source,143,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/phase.js,/**\n * Phase enums and setters for the hierarchical state machine.\n * game.phase is the single source of truth for top-level game phase.\n * game.roundPhase tracks sub-phase within round_active.\n */\n\nexport const PHASES = {\n  LOBBY: 'lobby'\x2C\n  MAP_SELECTION: 'map_selection'\x2C\n  INITIATIVE: 'initiative'\x2C\n  ZONE_SELECTION: 'zone_selection'\x2C\n  DEPLOYMENT: 'deployment'\x2C\n  ATTACHMENT: 'attachment'\x2C\n  CC_DRAW: 'cc_draw'\x2C\n  ROUND_ACTIVE: 'round_active'\x2C\n  ENDED: 'ended'\x2C\n};\n\nexport const ROUND_PHASES = {\n  START_OF_ROUND: 'start_of_round'\x2C\n  ACTIVATION: 'activation'\x2C\n  END_OF_ROUND: 'end_of_round'\x2C\n};\n\n/**\n * Valid top-level phase transitions.\n * Key = current phase\x2C Value = array of allowed next phases.\n * null/undefined = legacy game\x2C any transition allowed.\n * Any phase \u2192 'ended' is always allowed (game can end at any time).\n */\nexport const VALID_PHASE_TRANSITIONS = {\n  [PHASES.LOBBY]:          [PHASES.MAP_SELECTION]\x2C\n  [PHASES.MAP_SELECTION]:  [PHASES.INITIATIVE]\x2C\n  [PHASES.INITIATIVE]:     [PHASES.ZONE_SELECTION]\x2C\n  [PHASES.ZONE_SELECTION]: [PHASES.ATTACHMENT\x2C PHASES.DEPLOYMENT]\x2C\n  [PHASES.ATTACHMENT]:     [PHASES.DEPLOYMENT]\x2C\n  [PHASES.DEPLOYMENT]:     [PHASES.ATTACHMENT\x2C PHASES.CC_DRAW]\x2C\n  [PHASES.CC_DRAW]:        [PHASES.ROUND_ACTIVE]\x2C\n  [PHASES.ROUND_ACTIVE]:   [PHASES.ENDED]\x2C\n  [PHASES.ENDED]:          []\x2C // terminal\n};\n\n/**\n * Valid round sub-phase transitions.\n * null/undefined = first entry\x2C any allowed.\n */\nexport const VALID_ROUND_PHASE_TRANSITIONS = {\n  [ROUND_PHASES.START_OF_ROUND]: [ROUND_PHASES.ACTIVATION]\x2C\n  [ROUND_PHASES.ACTIVATION]:     [ROUND_PHASES.END_OF_ROUND]\x2C\n  [ROUND_PHASES.END_OF_ROUND]:   [ROUND_PHASES.START_OF_ROUND]\x2C\n};\n\n// \u2500\u2500 Global strict mode \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// When enabled\x2C all phase transitions throw on invalid (no opts.strict needed).\n// Activated by headless-deps for self-play; harmless for Discord (valid transitions unaffected).\nlet globalStrictMode = false;\n\n/** Enable strict phase transitions globally. */\nexport function enableStrictPhaseTransitions() { globalStrictMode = true; }\n\n/**\n * Validate a phase transition. Returns true if valid.\n * @param {string|null|undefined} from - Current phase\n * @param {string} to - Target phase\n * @param {object} transitionMap - VALID_PHASE_TRANSITIONS or VALID_ROUND_PHASE_TRANSITIONS\n * @returns {boolean}\n */\nfunction isValidTransition(from\x2C to\x2C transitionMap) {\n  // Legacy games (null/undefined phase) \u2014 allow any transition\n  if (from == null) return true;\n  // Any \u2192 ended always allowed (top-level only)\n  if (to === PHASES.ENDED && transitionMap === VALID_PHASE_TRANSITIONS) return true;\n  const allowed = transitionMap[from];\n  if (!allowed) return true; // unknown source phase \u2014 allow (defensive)\n  return allowed.includes(to);\n}\n\n/**\n * Set the top-level phase. Validates transition before assignment.\n * @param {object} game\n * @param {string} phase - One of PHASES values\n * @param {string|null} [roundPhase] - One of ROUND_PHASES values (only for round_active)\n * @param {object} [opts]\n * @param {boolean} [opts.strict] - If true\x2C throw on invalid transition (for headless/tests)\n */\nexport function setPhase(game\x2C phase\x2C roundPhase = null\x2C opts = {}) {\n  const from = game.phase;\n  if (!isValidTransition(from\x2C phase\x2C VALID_PHASE_TRANSITIONS)) {\n    const msg = `Invalid phase transition: ${from} \u2192 ${phase}`;\n    if (opts.strict || globalStrictMode) throw new Error(msg);\n    console.warn(`[Phase] ${msg}`);\n  }\n  game.phase = phase;\n  game.roundPhase = phase === 'round_active' ? (roundPhase || game.roundPhase) : null;\n}\n\n/**\n * Set the round sub-phase (within round_active). Validates transition.\n * @param {object} game\n * @param {string} roundPhase - One of ROUND_PHASES values\n * @param {object} [opts]\n * @param {boolean} [opts.strict] - If true\x2C throw on invalid transition\n */\nexport function setRoundPhase(game\x2C roundPhase\x2C opts = {}) {\n  const from = game.roundPhase;\n  if (!isValidTransition(from\x2C roundPhase\x2C VALID_ROUND_PHASE_TRANSITIONS)) {\n    const msg = `Invalid round phase transition: ${from} \u2192 ${roundPhase}`;\n    if (opts.strict || globalStrictMode) throw new Error(msg);\n    console.warn(`[Phase] ${msg}`);\n  }\n  game.roundPhase = roundPhase;\n}\n
