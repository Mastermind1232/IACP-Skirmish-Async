script-source,782,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/discord.js/src/managers/ReactionUserManager.js,'use strict';\n\nconst { Collection } = require('@discordjs/collection');\nconst { makeURLSearchParams } = require('@discordjs/rest');\nconst { ReactionType\x2C Routes } = require('discord-api-types/v10');\nconst CachedManager = require('./CachedManager');\nconst { DiscordjsError\x2C ErrorCodes } = require('../errors');\nconst User = require('../structures/User');\n\n/**\n * Manages API methods for users who reacted to a reaction and stores their cache.\n * @extends {CachedManager}\n */\nclass ReactionUserManager extends CachedManager {\n  constructor(reaction\x2C iterable) {\n    super(reaction.client\x2C User\x2C iterable);\n\n    /**\n     * The reaction that this manager belongs to\n     * @type {MessageReaction}\n     */\n    this.reaction = reaction;\n  }\n\n  /**\n   * The cache of this manager\n   * @type {Collection<Snowflake\x2C User>}\n   * @name ReactionUserManager#cache\n   */\n\n  /**\n   * Options used to fetch users who gave a reaction.\n   * @typedef {Object} FetchReactionUsersOptions\n   * @property {ReactionType} [type=ReactionType.Normal] The reaction type to fetch\n   * @property {number} [limit=100] The maximum amount of users to fetch\x2C defaults to `100`\n   * @property {Snowflake} [after] Limit fetching users to those with an id greater than the supplied id\n   */\n\n  /**\n   * Fetches all the users that gave this reaction. Resolves with a collection of users\x2C mapped by their ids.\n   * @param {FetchReactionUsersOptions} [options] Options for fetching the users\n   * @returns {Promise<Collection<Snowflake\x2C User>>}\n   */\n  async fetch({ type = ReactionType.Normal\x2C limit = 100\x2C after } = {}) {\n    const message = this.reaction.message;\n    const query = makeURLSearchParams({ limit\x2C after\x2C type });\n    const data = await this.client.rest.get(\n      Routes.channelMessageReaction(message.channelId\x2C message.id\x2C this.reaction.emoji.identifier)\x2C\n      { query }\x2C\n    );\n    const users = new Collection();\n    for (const rawUser of data) {\n      const user = this.client.users._add(rawUser);\n      this.cache.set(user.id\x2C user);\n      users.set(user.id\x2C user);\n    }\n    return users;\n  }\n\n  /**\n   * Removes a user from this reaction.\n   * @param {UserResolvable} [user=this.client.user] The user to remove the reaction of\n   * @returns {Promise<MessageReaction>}\n   */\n  async remove(user = this.client.user) {\n    const userId = this.client.users.resolveId(user);\n    if (!userId) throw new DiscordjsError(ErrorCodes.ReactionResolveUser);\n    const message = this.reaction.message;\n    const route =\n      userId === this.client.user.id\n        ? Routes.channelMessageOwnReaction(message.channelId\x2C message.id\x2C this.reaction.emoji.identifier)\n        : Routes.channelMessageUserReaction(message.channelId\x2C message.id\x2C this.reaction.emoji.identifier\x2C userId);\n    await this.client.rest.delete(route);\n    return this.reaction;\n  }\n}\n\nmodule.exports = ReactionUserManager;\n
