code-creation,Script,9,305470,0x3f05b92a1440,52, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/engine/game-readers.js:1:1,0x33c4685850c0,~
script-source,256,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/engine/game-readers.js,/**\n * Game state reader functions extracted from index.js.\n * Read game state + dcMessageMeta\x2C no Discord writes.\n */\n\nexport function hasActionsRemainingInGame(game\x2C gameId\x2C dcMessageMeta) {\n  for (const [mid\x2C meta] of dcMessageMeta) {\n    if (meta.gameId !== gameId) continue;\n    const data = game.dcActionsData?.[mid];\n    if (data?.remaining > 0) {\n      // Skip fully defeated DCs \u2014 stale remaining count on a dead group is not real\n      const figs = game.figurePositions?.[meta.playerNum] || {};\n      if (!Object.keys(figs).some(fk => fk.startsWith(meta.dcName + '-'))) continue;\n      return true;\n    }\n  }\n  return false;\n}\n\n/** True when both players have no readied DCs and no actions left to spend. */\nexport function shouldShowEndActivationPhaseButton(game\x2C gameId\x2C dcMessageMeta) {\n  const r1 = game.p1ActivationsRemaining ?? 0;\n  const r2 = game.p2ActivationsRemaining ?? 0;\n  if (r1 > 0 || r2 > 0) return false;\n  if (hasActionsRemainingInGame(game\x2C gameId\x2C dcMessageMeta)) return false;\n  return true;\n}\n\n/** True if all figures in this deployment group are defeated (or never deployed). */\nexport function isGroupDefeated(game\x2C playerNum\x2C dcIndex\x2C deps) {\n  const dcList = deps.getDcList(game\x2C playerNum) || [];\n  const dc = dcList[dcIndex];\n  if (!dc) return true;\n  const dcName = dc.dcName || dc;\n  const displayName = typeof dc === 'object' ? dc.displayName : dcName;\n  const dgMatch = displayName?.match(/\\[(?:DG|Group) (\\d+)\\]/);\n  const dgIndex = dgMatch ? dgMatch[1] : '1';\n  const stats = deps.getDcStats(dcName);\n  const figureCount = stats.figures ?? 1;\n  const poses = game.figurePositions?.[playerNum] || {};\n  for (let f = 0; f < figureCount; f++) {\n    const figureKey = `${dcName}-${dgIndex}-${f}`;\n    if (figureKey in poses) return false;\n  }\n  return true;\n}\n\nexport function isDepletedRemovedFromGame(game\x2C msgId) {\n  if (!game || !msgId) return false;\n  const p1 = game.p1DepletedDcMessageIds || [];\n  const p2 = game.p2DepletedDcMessageIds || [];\n  return p1.includes(msgId) || p2.includes(msgId);\n}\n\nexport function findDcMessageIdForFigure(gameId\x2C playerNum\x2C figureKey\x2C dcMessageMeta) {\n  const m = figureKey.match(/^(.+)-(\\d+)-(\\d+)$/);\n  const dcName = m ? m[1] : figureKey;\n  const dgIndex = m ? m[2] : '1';\n  for (const [msgId\x2C meta] of dcMessageMeta) {\n    if (meta.gameId !== gameId || meta.playerNum !== playerNum) continue;\n    const dn = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/);\n    const metaDgIndex = dn ? String(dn[1]) : '1';\n    if (meta.dcName === dcName && metaDgIndex === String(dgIndex)) return msgId;\n  }\n  return null;\n}\n\nexport function lookupFigureDcIndex(game\x2C playerNum\x2C figureKey\x2C deps) {\n  const msgId = findDcMessageIdForFigure(game.gameId\x2C playerNum\x2C figureKey\x2C deps.dcMessageMeta);\n  const dcIds = deps.getDcMessageIds(game\x2C playerNum);\n  const dcList = deps.getDcList(game\x2C playerNum);\n  const idx = (dcIds || []).indexOf(msgId);\n  return { msgId\x2C dcList\x2C idx };\n}\n\nexport function getFigureLabel(game\x2C playerNum\x2C figureKey\x2C fallback\x2C maxLen\x2C deps) {\n  const { msgId\x2C dcList\x2C idx } = lookupFigureDcIndex(game\x2C playerNum\x2C figureKey\x2C deps);\n  const raw = (idx >= 0 && dcList?.[idx]?.displayName) ? dcList[idx].displayName : (fallback ?? deps.dcNameFromFigureKey(figureKey));\n  return { msgId\x2C label: String(raw).slice(0\x2C maxLen || 80) };\n}\n\nexport function getPlayerZoneLabel(game\x2C playerId) {\n  if (!playerId) return '';\n  let zone = playerId === game.player1Id ? game.player1DeploymentZone : game.player2DeploymentZone;\n  if (!zone && game.deploymentZoneChosen) {\n    zone = (playerId === game.initiativePlayerId) ? game.deploymentZoneChosen : (game.deploymentZoneChosen === 'red' ? 'blue' : 'red');\n  }\n  return zone ? `[${zone.toUpperCase()}] ` : '';\n}\n\nexport function countActiveGamesForPlayer(playerId\x2C gamesMap) {\n  if (!playerId) return 0;\n  let count = 0;\n  for (const [\x2C game] of gamesMap) {\n    if (game.ended) continue;\n    if (game.player1Id === playerId || game.player2Id === playerId) count++;\n  }\n  return count;\n}\n
