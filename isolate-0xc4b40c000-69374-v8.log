script-source,139,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/domain/reducer/vp-reducer.js,export const vpReducerHandlers = {\n  VpAwarded(state\x2C payload) {\n    const vpKey = payload.playerNum === 1 ? 'player1VP' : 'player2VP';\n    const vp = { ...(state[vpKey] || { total: 0\x2C kills: 0\x2C objectives: 0 }) };\n    vp.total += payload.amount;\n    if (payload.reason === 'kill') vp.kills += payload.amount;\n    if (payload.reason === 'objective') vp.objectives += payload.amount;\n    return { ...state\x2C [vpKey]: vp };\n  }\x2C\n\n  VpDeducted(state\x2C payload) {\n    const vpKey = payload.playerNum === 1 ? 'player1VP' : 'player2VP';\n    const vp = { ...(state[vpKey] || { total: 0\x2C kills: 0\x2C objectives: 0 }) };\n    vp.total = Math.max(0\x2C vp.total - payload.amount);\n    if (payload.reason === 'kill') vp.kills = Math.max(0\x2C vp.kills - payload.amount);\n    if (payload.reason === 'objective') vp.objectives = Math.max(0\x2C vp.objectives - payload.amount);\n    return { ...state\x2C [vpKey]: vp };\n  }\x2C\n\n  ObjectiveClaimed(state\x2C payload) {\n    const vpKey = payload.playerNum === 1 ? 'player1VP' : 'player2VP';\n    const vp = { ...(state[vpKey] || { total: 0\x2C kills: 0\x2C objectives: 0 }) };\n    vp.objectives += (payload.vpValue || 0);\n    vp.total += (payload.vpValue || 0);\n    const claimedObjectives = [...(state.claimedObjectives || [])];\n    claimedObjectives.push(payload.objectiveId);\n    return { ...state\x2C [vpKey]: vp\x2C claimedObjectives };\n  }\x2C\n\n  TerminalControlled(state\x2C payload) {\n    const vpKey = payload.playerNum === 1 ? 'player1VP' : 'player2VP';\n    const vp = { ...(state[vpKey] || { total: 0\x2C kills: 0\x2C objectives: 0 }) };\n    vp.objectives += (payload.vpValue || 0);\n    vp.total += (payload.vpValue || 0);\n    return { ...state\x2C [vpKey]: vp };\n  }\x2C\n\n  CrateCollected(state\x2C payload) {\n    const vpKey = payload.playerNum === 1 ? 'player1VP' : 'player2VP';\n    const vp = { ...(state[vpKey] || { total: 0\x2C kills: 0\x2C objectives: 0 }) };\n    vp.objectives += (payload.vpValue || 0);\n    vp.total += (payload.vpValue || 0);\n    const collectedCrates = [...(state.collectedCrates || [])];\n    collectedCrates.push(payload.crateId);\n    return { ...state\x2C [vpKey]: vp\x2C collectedCrates };\n  }\x2C\n};\n
