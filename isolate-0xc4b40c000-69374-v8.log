code-creation,Script,9,78601,0x7c98725c3a8,58, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/headless/game-harness.js:1:1,0x78fd2b0be38,~
script-source,89,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/headless/game-harness.js,/**\n * Game harness: executes handler actions headlessly.\n *\n * Ties together:\n * - Router (customId \u2192 handler key)\n * - Handler registry (key \u2192 handler function)\n * - Context factory (group \u2192 context from deps)\n * - Fake interactions (capture Discord output)\n *\n * Usage:\n *   const harness = createHarness(initialGame\x2C options);\n *   const result = await harness.submitAction(customId\x2C userId);\n *   console.log(harness.getGame());\n */\n\nimport { getHandlerKey } from '../router.js';\nimport { getHandler\x2C getHandlerGroup } from '../handlers/index.js';\nimport { buildContext } from '../context-factory.js';\nimport { buildHeadlessDeps } from './headless-deps.js';\nimport { createFakeInteraction } from './fake-interaction.js';\nimport { createFakeClient } from './fake-client.js';\nimport { captureSnapshot\x2C computeDiff } from '../event-log.js';\nimport { translateDiffToEvents } from '../domain/diff-translator.js';\nimport { getDcList\x2C getDcMessageIds\x2C getActivationsRemaining\x2C setActivationsRemaining\x2C getActivatedDcIndices } from '../game/player-helpers.js';\nimport { DC_ACTIONS_PER_ACTIVATION } from '../discord/messages.js';\nimport { isCompanionHostDefeated } from '../game/dc-helpers.js';\nimport { applyStartOfActivationEffects } from '../engine/activation-effects.js';\n\n/**\n * Headless-only DC activation: performs the 4 critical game-state mutations\n * that the Discord handler does\x2C without touching Discord APIs.\n *\n * Bypasses: fetchGameChannel\x2C message.edit\x2C startThread\x2C thread.send\x2C\n *           updateActivationsMessage \u2014 all Discord-only side effects.\n *\n * @param {object} game - The game state object\n * @param {string} customId - The dc_activate_ customId\n * @param {Map} dcExhaustedState - DC exhausted state map\n * @param {Map} dcHealthState - DC health state map\n * @returns {{ ok: boolean\x2C error?: string }}\n */\nfunction headlessActivateDc(game\x2C customId\x2C dcExhaustedState\x2C dcHealthState) {\n  // customId format: dc_activate_{gameId}_{playerNum}_{dcIndex}_{ownerId}\n  const suffix = customId.replace(/^dc_activate_/\x2C '');\n  const parts = suffix.split('_');\n  // parts: [gameId\x2C playerNum\x2C dcIndex\x2C ownerId]\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const dcIndex = parseInt(parts[2]\x2C 10);\n\n  const dcList = getDcList(game\x2C playerNum) || [];\n  const dc = dcList[dcIndex];\n  if (!dc) return { ok: false\x2C error: `DC not found at index ${dcIndex} for player ${playerNum}` };\n\n  const { dcName\x2C displayName } = dc;\n  const remaining = getActivationsRemaining(game\x2C playerNum);\n  if (remaining <= 0) return { ok: false\x2C error: 'No activations remaining this round' };\n\n  // Companion host defeated: companion cannot activate if host group left play\n  if (isCompanionHostDefeated(game\x2C dcName\x2C playerNum)) {\n    return { ok: false\x2C rejected: true };\n  }\n\n  const dcMessageIds = getDcMessageIds(game\x2C playerNum) || [];\n  const msgId = dcMessageIds[dcIndex];\n  if (!msgId) return { ok: false\x2C error: `DC message ID not found at index ${dcIndex}` };\n\n  // 1. Mark DC exhausted\n  dcExhaustedState.set(msgId\x2C true);\n\n  // 2. Initialize movement bank (consume any pending MP bonus)\n  game.movementBank = game.movementBank || {};\n  const pendingMp = game.pendingMpBonus?.[msgId] ?? 0;\n  if (pendingMp && game.pendingMpBonus) delete game.pendingMpBonus[msgId];\n  game.movementBank[msgId] = {\n    total: pendingMp\x2C remaining: pendingMp\x2C\n    threadId: null\x2C messageId: null\x2C displayName\x2C\n  };\n\n  // 3. Populate dcActionsData \u2014 gates move/attack action availability\n  game.dcActionsData = game.dcActionsData || {};\n  game.dcActionsData[msgId] = {\n    remaining: DC_ACTIONS_PER_ACTIVATION\x2C total: DC_ACTIONS_PER_ACTIVATION\x2C\n    messageId: null\x2C threadId: null\x2C specialsUsed: []\x2C\n  };\n\n  // 4. Update activation counters\n  setActivationsRemaining(game\x2C playerNum\x2C remaining - 1);\n  getActivatedDcIndices(game\x2C playerNum).push(dcIndex);\n\n  // Strength in Numbers: clear after extra activation committed\n  if (game.strengthInNumbersData && game.strengthInNumbersData.playerNum === playerNum) {\n    game.strengthInNumbersData = null;\n    game.strengthInNumbersPlayerNum = null;\n  }\n\n  // Agitate: clear restriction once the correct (or any) group activates\n  if (game.agitateNextActivation && game.agitateNextActivation.playerNum === playerNum) {\n    game.agitateNextActivation = null;\n  }\n\n  // Deterministic start-of-activation effects\n  applyStartOfActivationEffects(game\x2C { dcName\x2C playerNum\x2C displayName\x2C msgId\x2C dcHealthState });\n\n  return { ok: true };\n}\n\n/**\n * Create a headless game harness for testing.\n *\n * @param {object} initialGame - The starting game state\n * @param {object} [options]\n * @param {object} [options.deps] - Pre-built headless deps (created if omitted)\n * @param {Map} [options.dcMessageMeta] - DC message metadata\n * @param {Map} [options.dcExhaustedState] - DC exhausted state\n * @param {Map} [options.dcHealthState] - DC health state\n * @returns {object} Harness with submitAction\x2C getGame\x2C getMessages\x2C getDeps\n */\nexport function createHarness(initialGame\x2C options = {}) {\n  const lightweight = !!options.lightweight;\n  const gamesMap = new Map();\n  if (initialGame) {\n    gamesMap.set(initialGame.gameId\x2C structuredClone(initialGame));\n  }\n\n  const client = createFakeClient();\n\n  const deps = options.deps || buildHeadlessDeps({\n    gamesMap\x2C\n    client\x2C\n    dcMessageMeta: options.dcMessageMeta || new Map()\x2C\n    dcExhaustedState: options.dcExhaustedState || new Map()\x2C\n    dcHealthState: options.dcHealthState || new Map()\x2C\n  });\n\n  // Override getGame/setGame/saveGames to use our local gamesMap\n  deps.getGame = (id) => gamesMap.get(id) || null;\n  deps.setGame = (id\x2C game) => { gamesMap.set(id\x2C game); };\n  deps.saveGames = () => {};\n  deps.client = client;\n\n  const allMessages = [];\n\n  function _translateEvents(gameId\x2C handlerKey\x2C playerId\x2C beforeSnap\x2C gamesMap) {\n    if (!beforeSnap || !gameId) return [];\n    const afterSnap = captureSnapshot(gamesMap.get(gameId));\n    const diff = computeDiff(beforeSnap\x2C afterSnap);\n    if (!diff) return [];\n    return translateDiffToEvents(handlerKey\x2C diff\x2C {\n      gameId\x2C playerId\x2C before: beforeSnap\x2C after: afterSnap\x2C\n    });\n  }\n\n  return {\n    /**\n     * Submit a handler action headlessly.\n     * @param {string} customId - The button/select customId\n     * @param {string} userId - The user submitting the action\n     * @param {object} [actionOpts] - Additional options (type\x2C values\x2C etc.)\n     * @returns {Promise<{ game: object\x2C messages: Array\x2C error?: string }>}\n     */\n    async submitAction(customId\x2C userId\x2C actionOpts = {}) {\n      const type = actionOpts.type || 'button';\n      const handlerKey = getHandlerKey(customId\x2C type);\n\n      if (!handlerKey) {\n        return {\n          game: gamesMap.get(initialGame?.gameId)\x2C\n          messages: []\x2C\n          error: `No handler found for customId: ${customId}`\x2C\n        };\n      }\n\n      const handler = getHandler(handlerKey);\n      if (!handler) {\n        return {\n          game: gamesMap.get(initialGame?.gameId)\x2C\n          messages: []\x2C\n          error: `No handler function for key: ${handlerKey}`\x2C\n        };\n      }\n\n      const gameId = initialGame?.gameId;\n\n      // Headless intercept: dc_activate_ bypasses Discord handler entirely\n      if (customId.startsWith('dc_activate_')) {\n        const game = gamesMap.get(gameId);\n        if (!game) return { game: null\x2C messages: []\x2C error: 'Game not found'\x2C events: [] };\n        const beforeSnap = lightweight ? null : captureSnapshot(game);\n        const result = headlessActivateDc(game\x2C customId\x2C deps.dcExhaustedState\x2C deps.dcHealthState);\n        if (!result.ok) {\n          // Graceful rejection (validation gate) vs hard error\n          return { game\x2C messages: []\x2C error: result.rejected ? undefined : result.error\x2C events: [] };\n        }\n        const events = lightweight ? [] : _translateEvents(gameId\x2C handlerKey\x2C userId\x2C beforeSnap\x2C gamesMap);\n        return { game\x2C messages: []\x2C events };\n      }\n\n      const beforeSnap = lightweight ? null : (gameId ? captureSnapshot(gamesMap.get(gameId)) : null);\n\n      const group = getHandlerGroup(handlerKey);\n      if (!group) {\n        // Handler with no group \u2014 call with no context\n        const interaction = createFakeInteraction(customId\x2C userId\x2C {\n          ...actionOpts\x2C\n          client\x2C\n          channel: client._channelCache.values().next().value\x2C\n        });\n        try {\n          await handler(interaction);\n          if (!lightweight) {\n            allMessages.push(...interaction.sentMessages);\n            const events = _translateEvents(gameId\x2C handlerKey\x2C userId\x2C beforeSnap\x2C gamesMap);\n            return { game: gamesMap.get(gameId)\x2C messages: interaction.sentMessages\x2C events };\n          }\n          return { game: gamesMap.get(gameId)\x2C messages: []\x2C events: [] };\n        } catch (err) {\n          return {\n            game: gamesMap.get(gameId)\x2C\n            messages: lightweight ? [] : interaction.sentMessages\x2C\n            error: err.message\x2C\n            events: []\x2C\n          };\n        }\n      }\n\n      const context = buildContext(group\x2C deps);\n      const interaction = createFakeInteraction(customId\x2C userId\x2C { ...actionOpts\x2C client });\n\n      try {\n        await handler(interaction\x2C context);\n        if (!lightweight) {\n          allMessages.push(...interaction.sentMessages);\n          const events = _translateEvents(gameId\x2C handlerKey\x2C userId\x2C beforeSnap\x2C gamesMap);\n          return { game: gamesMap.get(gameId)\x2C messages: interaction.sentMessages\x2C events };\n        }\n        return { game: gamesMap.get(gameId)\x2C messages: []\x2C events: [] };\n      } catch (err) {\n        return {\n          game: gamesMap.get(gameId)\x2C\n          messages: lightweight ? [] : interaction.sentMessages\x2C\n          error: err.message\x2C\n          events: []\x2C\n        };\n      }\n    }\x2C\n\n    /**\n     * Get the current game state.\n     * @param {string} [gameId] - Defaults to initialGame.gameId\n     * @returns {object|null}\n     */\n    getGame(gameId) {\n      return gamesMap.get(gameId || initialGame?.gameId) || null;\n    }\x2C\n\n    /**\n     * Get all captured messages across all actions.\n     * @returns {Array}\n     */\n    getMessages() {\n      return allMessages;\n    }\x2C\n\n    /**\n     * Get the deps bag (for inspection/override in tests).\n     * @returns {object}\n     */\n    getDeps() {\n      return deps;\n    }\x2C\n\n    /**\n     * Get the in-memory games map.\n     * @returns {Map}\n     */\n    getGamesMap() {\n      return gamesMap;\n    }\x2C\n  };\n}\n
