script-source,528,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/discord.js/src/client/websocket/WebSocketManager.js,'use strict';\n\nconst EventEmitter = require('node:events');\nconst process = require('node:process');\nconst { setImmediate } = require('node:timers');\nconst { Collection } = require('@discordjs/collection');\nconst {\n  WebSocketManager: WSWebSocketManager\x2C\n  WebSocketShardEvents: WSWebSocketShardEvents\x2C\n  CompressionMethod\x2C\n  CloseCodes\x2C\n} = require('@discordjs/ws');\nconst { GatewayCloseCodes\x2C GatewayDispatchEvents } = require('discord-api-types/v10');\nconst WebSocketShard = require('./WebSocketShard');\nconst PacketHandlers = require('./handlers');\nconst { DiscordjsError\x2C ErrorCodes } = require('../../errors');\nconst Events = require('../../util/Events');\nconst Status = require('../../util/Status');\nconst WebSocketShardEvents = require('../../util/WebSocketShardEvents');\n\nlet zlib;\nlet deprecationEmitted = false;\n\ntry {\n  zlib = require('zlib-sync');\n} catch {} // eslint-disable-line no-empty\n\nconst BeforeReadyWhitelist = [\n  GatewayDispatchEvents.Ready\x2C\n  GatewayDispatchEvents.Resumed\x2C\n  GatewayDispatchEvents.GuildCreate\x2C\n  GatewayDispatchEvents.GuildDelete\x2C\n  GatewayDispatchEvents.GuildMembersChunk\x2C\n  GatewayDispatchEvents.GuildMemberAdd\x2C\n  GatewayDispatchEvents.GuildMemberRemove\x2C\n];\n\nconst WaitingForGuildEvents = [GatewayDispatchEvents.GuildCreate\x2C GatewayDispatchEvents.GuildDelete];\n\nconst UNRECOVERABLE_CLOSE_CODES = [\n  GatewayCloseCodes.AuthenticationFailed\x2C\n  GatewayCloseCodes.InvalidShard\x2C\n  GatewayCloseCodes.ShardingRequired\x2C\n  GatewayCloseCodes.InvalidAPIVersion\x2C\n  GatewayCloseCodes.InvalidIntents\x2C\n  GatewayCloseCodes.DisallowedIntents\x2C\n];\n\nconst reasonIsDeprecated = 'the reason property is deprecated\x2C use the code property to determine the reason';\nlet deprecationEmittedForInvalidSessionEvent = false;\nlet deprecationEmittedForDestroyedEvent = false;\n\n/**\n * The WebSocket manager for this client.\n * <info>This class forwards raw dispatch events\x2C\n * read more about it here {@link https://discord.com/developers/docs/topics/gateway}</info>\n * @extends {EventEmitter}\n */\nclass WebSocketManager extends EventEmitter {\n  constructor(client) {\n    super();\n\n    /**\n     * The client that instantiated this WebSocketManager\n     * @type {Client}\n     * @readonly\n     * @name WebSocketManager#client\n     */\n    Object.defineProperty(this\x2C 'client'\x2C { value: client });\n\n    /**\n     * The gateway this manager uses\n     * @type {?string}\n     */\n    this.gateway = null;\n\n    /**\n     * A collection of all shards this manager handles\n     * @type {Collection<number\x2C WebSocketShard>}\n     */\n    this.shards = new Collection();\n\n    /**\n     * An array of queued events before this WebSocketManager became ready\n     * @type {Object[]}\n     * @private\n     * @name WebSocketManager#packetQueue\n     */\n    Object.defineProperty(this\x2C 'packetQueue'\x2C { value: [] });\n\n    /**\n     * The current status of this WebSocketManager\n     * @type {Status}\n     */\n    this.status = Status.Idle;\n\n    /**\n     * If this manager was destroyed. It will prevent shards from reconnecting\n     * @type {boolean}\n     * @private\n     */\n    this.destroyed = false;\n\n    /**\n     * The internal WebSocketManager from `@discordjs/ws`.\n     * @type {WSWebSocketManager}\n     * @private\n     */\n    this._ws = null;\n  }\n\n  /**\n   * The average ping of all WebSocketShards\n   * @type {number}\n   * @readonly\n   */\n  get ping() {\n    const sum = this.shards.reduce((a\x2C b) => a + b.ping\x2C 0);\n    return sum / this.shards.size;\n  }\n\n  /**\n   * Emits a debug message.\n   * @param {string[]} messages The debug message\n   * @param {?number} [shardId] The id of the shard that emitted this message\x2C if any\n   * @private\n   */\n  debug(messages\x2C shardId) {\n    this.client.emit(\n      Events.Debug\x2C\n      `[WS => ${typeof shardId === 'number' ? `Shard ${shardId}` : 'Manager'}] ${messages.join('\\n\\t')}`\x2C\n    );\n  }\n\n  /**\n   * Connects this manager to the gateway.\n   * @private\n   */\n  async connect() {\n    const invalidToken = new DiscordjsError(ErrorCodes.TokenInvalid);\n    const { shards\x2C shardCount\x2C intents\x2C ws } = this.client.options;\n    if (this._ws && this._ws.options.token !== this.client.token) {\n      await this._ws.destroy({ code: CloseCodes.Normal\x2C reason: 'Login with differing token requested' });\n      this._ws = null;\n    }\n    if (!this._ws) {\n      const wsOptions = {\n        intents: intents.bitfield\x2C\n        rest: this.client.rest\x2C\n        token: this.client.token\x2C\n        largeThreshold: ws.large_threshold\x2C\n        version: ws.version\x2C\n        shardIds: shards === 'auto' ? null : shards\x2C\n        shardCount: shards === 'auto' ? null : shardCount\x2C\n        initialPresence: ws.presence\x2C\n        retrieveSessionInfo: shardId => this.shards.get(shardId).sessionInfo\x2C\n        updateSessionInfo: (shardId\x2C sessionInfo) => {\n          this.shards.get(shardId).sessionInfo = sessionInfo;\n        }\x2C\n        compression: zlib ? CompressionMethod.ZlibStream : null\x2C\n      };\n      if (ws.buildIdentifyThrottler) wsOptions.buildIdentifyThrottler = ws.buildIdentifyThrottler;\n      if (ws.buildStrategy) wsOptions.buildStrategy = ws.buildStrategy;\n      this._ws = new WSWebSocketManager(wsOptions);\n      this.attachEvents();\n    }\n\n    const {\n      url: gatewayURL\x2C\n      shards: recommendedShards\x2C\n      session_start_limit: sessionStartLimit\x2C\n    } = await this._ws.fetchGatewayInformation().catch(error => {\n      throw error.status === 401 ? invalidToken : error;\n    });\n\n    const { total\x2C remaining } = sessionStartLimit;\n    this.debug(['Fetched Gateway Information'\x2C `URL: ${gatewayURL}`\x2C `Recommended Shards: ${recommendedShards}`]);\n    this.debug(['Session Limit Information'\x2C `Total: ${total}`\x2C `Remaining: ${remaining}`]);\n    this.gateway = `${gatewayURL}/`;\n\n    this.client.options.shardCount = await this._ws.getShardCount();\n    this.client.options.shards = await this._ws.getShardIds();\n    this.totalShards = this.client.options.shards.length;\n    for (const id of this.client.options.shards) {\n      if (!this.shards.has(id)) {\n        const shard = new WebSocketShard(this\x2C id);\n        this.shards.set(id\x2C shard);\n\n        shard.on(WebSocketShardEvents.AllReady\x2C unavailableGuilds => {\n          /**\n           * Emitted when a shard turns ready.\n           * @event Client#shardReady\n           * @param {number} id The shard id that turned ready\n           * @param {?Set<Snowflake>} unavailableGuilds Set of unavailable guild ids\x2C if any\n           */\n          this.client.emit(Events.ShardReady\x2C shard.id\x2C unavailableGuilds);\n\n          this.checkShardsReady();\n        });\n        shard.status = Status.Connecting;\n      }\n    }\n\n    await this._ws.connect();\n\n    this.shards.forEach(shard => {\n      if (shard.listenerCount(WebSocketShardEvents.InvalidSession) > 0 && !deprecationEmittedForInvalidSessionEvent) {\n        process.emitWarning(\n          'The WebSocketShard#invalidSession event is deprecated and will never emit.'\x2C\n          'DeprecationWarning'\x2C\n        );\n\n        deprecationEmittedForInvalidSessionEvent = true;\n      }\n      if (shard.listenerCount(WebSocketShardEvents.Destroyed) > 0 && !deprecationEmittedForDestroyedEvent) {\n        process.emitWarning(\n          'The WebSocketShard#destroyed event is deprecated and will never emit.'\x2C\n          'DeprecationWarning'\x2C\n        );\n\n        deprecationEmittedForDestroyedEvent = true;\n      }\n    });\n  }\n\n  /**\n   * Attaches event handlers to the internal WebSocketShardManager from `@discordjs/ws`.\n   * @private\n   */\n  attachEvents() {\n    this._ws.on(WSWebSocketShardEvents.Debug\x2C ({ message\x2C shardId }) => this.debug([message]\x2C shardId));\n    this._ws.on(WSWebSocketShardEvents.Dispatch\x2C ({ data\x2C shardId }) => {\n      this.client.emit(Events.Raw\x2C data\x2C shardId);\n      this.emit(data.t\x2C data.d\x2C shardId);\n      const shard = this.shards.get(shardId);\n      this.handlePacket(data\x2C shard);\n      if (shard.status === Status.WaitingForGuilds && WaitingForGuildEvents.includes(data.t)) {\n        shard.gotGuild(data.d.id);\n      }\n    });\n\n    this._ws.on(WSWebSocketShardEvents.Ready\x2C ({ data\x2C shardId }) => {\n      this.shards.get(shardId).onReadyPacket(data);\n    });\n\n    this._ws.on(WSWebSocketShardEvents.Closed\x2C ({ code\x2C shardId }) => {\n      const shard = this.shards.get(shardId);\n      shard.emit(WebSocketShardEvents.Close\x2C { code\x2C reason: reasonIsDeprecated\x2C wasClean: true });\n      if (UNRECOVERABLE_CLOSE_CODES.includes(code)) {\n        shard.status = Status.Disconnected;\n        /**\n         * Emitted when a shard's WebSocket disconnects and will no longer reconnect.\n         * @event Client#shardDisconnect\n         * @param {CloseEvent} event The WebSocket close event\n         * @param {number} id The shard id that disconnected\n         */\n        this.client.emit(Events.ShardDisconnect\x2C { code\x2C reason: reasonIsDeprecated\x2C wasClean: true }\x2C shardId);\n        this.debug([`Shard not recoverable: ${code} (${GatewayCloseCodes[code] ?? CloseCodes[code]})`]\x2C shardId);\n        return;\n      }\n\n      this.shards.get(shardId).status = Status.Connecting;\n      /**\n       * Emitted when a shard is attempting to reconnect or re-identify.\n       * @event Client#shardReconnecting\n       * @param {number} id The shard id that is attempting to reconnect\n       */\n      this.client.emit(Events.ShardReconnecting\x2C shardId);\n    });\n    this._ws.on(WSWebSocketShardEvents.Hello\x2C ({ shardId }) => {\n      const shard = this.shards.get(shardId);\n      if (shard.sessionInfo) {\n        shard.closeSequence = shard.sessionInfo.sequence;\n        shard.status = Status.Resuming;\n      } else {\n        shard.status = Status.Identifying;\n      }\n    });\n\n    this._ws.on(WSWebSocketShardEvents.Resumed\x2C ({ shardId }) => {\n      const shard = this.shards.get(shardId);\n      shard.status = Status.Ready;\n      /**\n       * Emitted when the shard resumes successfully\n       * @event WebSocketShard#resumed\n       */\n      shard.emit(WebSocketShardEvents.Resumed);\n    });\n\n    this._ws.on(WSWebSocketShardEvents.HeartbeatComplete\x2C ({ heartbeatAt\x2C latency\x2C shardId }) => {\n      this.debug([`Heartbeat acknowledged\x2C latency of ${latency}ms.`]\x2C shardId);\n      const shard = this.shards.get(shardId);\n      shard.lastPingTimestamp = heartbeatAt;\n      shard.ping = latency;\n    });\n\n    this._ws.on(WSWebSocketShardEvents.Error\x2C ({ error\x2C shardId }) => {\n      /**\n       * Emitted whenever a shard's WebSocket encounters a connection error.\n       * @event Client#shardError\n       * @param {Error} error The encountered error\n       * @param {number} shardId The shard that encountered this error\n       */\n      this.client.emit(Events.ShardError\x2C error\x2C shardId);\n    });\n  }\n\n  /**\n   * Broadcasts a packet to every shard this manager handles.\n   * @param {Object} packet The packet to send\n   * @private\n   */\n  broadcast(packet) {\n    for (const shardId of this.shards.keys()) this._ws.send(shardId\x2C packet);\n  }\n\n  /**\n   * Destroys this manager and all its shards.\n   * @private\n   */\n  async destroy() {\n    if (this.destroyed) return;\n    // TODO: Make a util for getting a stack\n    this.debug([Object.assign(new Error()\x2C { name: 'Manager was destroyed:' }).stack]);\n    this.destroyed = true;\n    await this._ws?.destroy({ code: CloseCodes.Normal\x2C reason: 'Manager was destroyed' });\n  }\n\n  /**\n   * Processes a packet and queues it if this WebSocketManager is not ready.\n   * @param {Object} [packet] The packet to be handled\n   * @param {WebSocketShard} [shard] The shard that will handle this packet\n   * @returns {boolean}\n   * @private\n   */\n  handlePacket(packet\x2C shard) {\n    if (packet && this.status !== Status.Ready) {\n      if (!BeforeReadyWhitelist.includes(packet.t)) {\n        this.packetQueue.push({ packet\x2C shard });\n        return false;\n      }\n    }\n\n    if (this.packetQueue.length) {\n      const item = this.packetQueue.shift();\n      setImmediate(() => {\n        this.handlePacket(item.packet\x2C item.shard);\n      }).unref();\n    }\n\n    if (packet && PacketHandlers[packet.t]) {\n      PacketHandlers[packet.t](this.client\x2C packet\x2C shard);\n    }\n\n    return true;\n  }\n\n  /**\n   * Checks whether the client is ready to be marked as ready.\n   * @private\n   */\n  checkShardsReady() {\n    if (this.status === Status.Ready) return;\n    if (this.shards.size !== this.totalShards || this.shards.some(shard => shard.status !== Status.Ready)) {\n      return;\n    }\n\n    this.triggerClientReady();\n  }\n\n  /**\n   * Causes the client to be marked as ready and emits the ready event.\n   * @private\n   */\n  triggerClientReady() {\n    this.status = Status.Ready;\n\n    this.client.readyTimestamp = Date.now();\n\n    /**\n     * Emitted when the client becomes ready to start working.\n     * @event Client#ready\n     * @deprecated Use {@link Client#event:clientReady} instead.\n     * @param {Client} client The client\n     */\n    if (this.client.emit('ready'\x2C this.client) && !deprecationEmitted) {\n      deprecationEmitted = true;\n\n      process.emitWarning(\n        // eslint-disable-next-line max-len\n        'The ready event has been renamed to clientReady to distinguish it from the gateway READY event and will only emit under that name in v15. Please use clientReady instead.'\x2C\n