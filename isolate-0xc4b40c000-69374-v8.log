script-source,158,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/discord/messages.js,/**\n * Game phases\x2C action icons\x2C and game-log / error-log helpers.\n */\nimport { EmbedBuilder\x2C ChannelType\x2C ThreadAutoArchiveDuration\x2C ActionRowBuilder\x2C ButtonBuilder\x2C ButtonStyle } from 'discord.js';\nimport { getActivationsMessageId\x2C getActivationsRemaining\x2C getActivationsTotal\x2C getPlayAreaId } from '../game/player-helpers.js';\nimport { enforceContentLimit\x2C DISCORD_CONTENT_LIMIT } from './limits.js';\nimport { withDiscordRetry\x2C discordCatch } from '../error-handling.js';\nimport { fetchGameChannel\x2C sanitizeMentions } from './channel-helpers.js';\nimport { insertIncident\x2C updateIncidentMirrorPosted\x2C setIncidentMirrorFailed } from '../db.js';\n\n/** Orange sidebar color for phase embeds */\nexport const PHASE_COLOR = 0xf39c12;\n\n/** Game phases for visual organization \u2014 all use orange sidebar */\nexport const GAME_PHASES = {\n  SETUP: { name: 'PRE-GAME SETUP'\x2C emoji: '\u2699\ufe0f'\x2C color: PHASE_COLOR }\x2C\n  INITIATIVE: { name: 'INITIATIVE'\x2C emoji: '\ud83c\udfb2'\x2C color: PHASE_COLOR }\x2C\n  DEPLOYMENT: { name: 'DEPLOYMENT'\x2C emoji: '\ud83d\udccd'\x2C color: PHASE_COLOR }\x2C\n  ROUND: { name: 'ROUND'\x2C emoji: '\u2694\ufe0f'\x2C color: PHASE_COLOR }\x2C\n  ACTIVATION: { name: 'ACTIVATION'\x2C emoji: '\ud83c\udfb4'\x2C color: PHASE_COLOR }\x2C\n  ACTION: { name: 'ACTION'\x2C emoji: '\ud83c\udfb4'\x2C color: PHASE_COLOR }\x2C\n};\n\n/** Action icons for game log */\nexport const ACTION_ICONS = {\n  squad: '\ud83d\udccb'\x2C\n  map: '\ud83d\uddfa\ufe0f'\x2C\n  initiative: '\ud83c\udfb2'\x2C\n  zone: '\ud83c\udfc1'\x2C\n  deploy: '\ud83d\udccd'\x2C\n  exhaust: '\ud83d\ude34'\x2C\n  activate: '\u26a1'\x2C\n  ready: '\u2728'\x2C\n  move: '\ud83d\udeb6'\x2C\n  attack: '\u2694\ufe0f'\x2C\n  interact: '\ud83e\udd1d'\x2C\n  special: '\u2734\ufe0f'\x2C\n  deployed: '\u2705'\x2C\n  card: '\ud83c\udfb4'\x2C\n  deplete: '\ud83d\udd04'\x2C\n};\n\n/** Map<"guildId_gameId"\x2C { threadId\x2C headerMsgId }> */\nconst gameErrorThreads = new Map();\n\n/**\n * Delete the bot-logs error thread for a game\x2C then clear the cached mapping.\n * Falls back to searching by thread name if the in-memory map has no entry\n * (e.g. after a bot restart).\n * @param {string} gameId\n * @param {object} [client] - Discord client. If provided\x2C deletes the thread from Discord.\n */\nexport async function clearGameErrorThread(gameId\x2C client) {\n  let found = false;\n  for (const [key\x2C entry] of gameErrorThreads.entries()) {\n    if (key.endsWith(`_${gameId}`)) {\n      found = true;\n      if (client) {\n        const threadId = typeof entry === 'string' ? entry : entry?.threadId;\n        const headerMsgId = typeof entry === 'string' ? null : entry?.headerMsgId;\n        // Delete thread first\x2C then header message\n        if (threadId) {\n          try {\n            const thread = await fetchGameChannel(client\x2C threadId);\n            if (thread) await thread.delete();\n          } catch (err) {\n            if (err.code !== 10003 && err.code !== 10008) {\n              console.error(`[clearGameErrorThread] Failed to delete thread for ${gameId}:`\x2C err.message);\n            }\n          }\n        }\n        // Delete the header message in bot-logs (prevents orphaned "started a thread" text)\n        if (headerMsgId) {\n          try {\n            const ch = await fetchGameChannel(client\x2C BOT_LOGS_CHANNEL_ID);\n            if (ch) {\n              const msg = await ch.messages.fetch(headerMsgId).catch(() => null);\n              if (msg) await msg.delete();\n            }\n          } catch (err) {\n            if (err.code !== 10003 && err.code !== 10008) {\n              console.error(`[clearGameErrorThread] Failed to delete header message for ${gameId}:`\x2C err.message);\n            }\n          }\n        }\n      }\n      gameErrorThreads.delete(key);\n    }\n  }\n  // Fallback: search bot-logs channel by thread name (handles bot restarts)\n  if (!found && client) {\n    try {\n      let ch = null;\n      try { ch = await fetchGameChannel(client\x2C BOT_LOGS_CHANNEL_ID); } catch {}\n      if (ch) {\n        const threads = await ch.threads.fetchActive();\n        const threadName = `IA${gameId} errors`;\n        const match = threads.threads.find(t => t.name === threadName);\n        if (match) {\n          // Find and delete the header message (the thread's parent/starter message)\n          const starterMsgId = match.id; // Thread from message: thread ID === starter message ID\n          await match.delete();\n          // Also try to delete the header message\n          try {\n            const headerMsg = await ch.messages.fetch(starterMsgId).catch(() => null);\n            if (headerMsg) await headerMsg.delete();\n          } catch {}\n        }\n      }\n    } catch (err) {\n      if (err.code !== 10003 && err.code !== 10008) {\n        console.error(`[clearGameErrorThread] Fallback search failed for ${gameId}:`\x2C err.message);\n      }\n    }\n  }\n}\nconst BOT_LOGS_CHANNEL_NAMES = ['bot-logs'\x2C 'bot-log'\x2C 'bot logs'\x2C 'botlogs'];\nconst BOT_LOGS_CHANNEL_ID = '1467647184542634005';\n\n/** Post a phase header to the game log (only when phase changes) */\nexport async function logPhaseHeader(game\x2C client\x2C phase\x2C roundNum = null) {\n  // Guard against unknown phase keys (e.g.\x2C typos like 'ACTIVATION' when only\n  // 'ROUND' existed). Without this\x2C a missing GAME_PHASES[key] makes `phase`\n  // undefined and `phase.name` crashes logGameAction's try/catch\x2C silently\n  // swallowing the entire log message (content and all).\n  if (!phase) return;\n  const phaseKey = 'currentPhase';\n  const phaseName = roundNum ? `${phase.name} ${roundNum}` : phase.name;\n  const fullKey = roundNum ? `${phase.name}_${roundNum}` : phase.name;\n  if (game[phaseKey] === fullKey) return;\n  game[phaseKey] = fullKey;\n  try {\n    const ch = await fetchGameChannel(client\x2C game.generalId);\n    const embed = new EmbedBuilder()\n      .setTitle(`${phase.emoji}  ${phaseName}`)\n      .setColor(phase.color);\n    const msg = await withDiscordRetry(() => ch.send({ embeds: [embed] }));\n    const setupPhases = ['SETUP'\x2C 'INITIATIVE'\x2C 'DEPLOYMENT'];\n    if (setupPhases.includes(phase.name)) {\n      game.setupLogMessageIds = game.setupLogMessageIds || [];\n      game.setupLogMessageIds.push(msg.id);\n    }\n  } catch (err) {\n    console.error('Phase header error:'\x2C err);\n  }\n}\n\n/** Log a game action with icon and clean formatting. Returns the sent message (or null) so callers can store gameLogMessageId for undo (F14). */\nexport async function logGameAction(game\x2C client\x2C content\x2C options = {}) {\n  try {\n    // Clear the previous ping in the game log (fire-and-forget)\n    if (game._lastPingLogMsgId) {\n      _clearPreviousPing(game\x2C client);\n    }\n\n    const ch = await fetchGameChannel(client\x2C game.generalId);\n    const icon = options.icon ? `${ACTION_ICONS[options.icon] || ''} ` : '';\n    const phase = options.phase;\n    if (phase) {\n      await logPhaseHeader(game\x2C client\x2C GAME_PHASES[phase]\x2C options.roundNum);\n    }\n    const timestamp = `<t:${Math.floor(Date.now() / 1000)}:t>`;\n    const msgContent = enforceContentLimit(`${icon}${timestamp} \u2014 ${content}`);\n    const payload = sanitizeMentions({ content: msgContent\x2C allowedMentions: options.allowedMentions });\n    if (options.files?.length) payload.files = options.files;\n    if (options.components?.length) payload.components = options.components;\n    const sentMsg = await withDiscordRetry(() => ch.send(payload));\n    const setupPhases = ['SETUP'\x2C 'INITIATIVE'\x2C 'DEPLOYMENT'];\n    if (phase && setupPhases.includes(phase)) {\n      game.setupLogMessageIds = game.setupLogMessageIds || [];\n      game.setupLogMessageIds.push(sentMsg.id);\n    }\n\n    // Track this message if it pings users\x2C so the next action can clear it\n    if (options.allowedMentions?.users?.length > 0) {\n      game._lastPingLogMsgId = sentMsg.id;\n      game._lastPingHasComponents = !!(options.components?.length);\n    } else {\n      delete game._lastPingLogMsgId;\n      delete game._lastPingHasComponents;\n    }\n\n    return sentMsg;\n  } catch (err) {\n    console.error('Game log error:'\x2C err);\n    return null;\n  }\n}\n\n/**\n * Edit the previous ping message in the game log to strip @mentions.\n * Replaces <@userId> with bold "P1"/"P2" so the mention highlight disappears.\n * Skips clearing if the previous message has active components (buttons needing action).\n */\nfunction _clearPreviousPing(game\x2C client) {\n  const msgId = game._lastPingLogMsgId;\n  const hasComponents = game._lastPingHasComponents;\n  delete game._lastPingLogMsgId;\n  delete game._lastPingHasComponents;\n  if (!msgId || !game.generalId || hasComponents) return;\n  fetchGameChannel(client\x2C game.generalId).then(ch =>\n    ch?.messages.fetch(msgId).then(msg => {\n      let text = msg.content;\n      if (game.player1Id) text = text.replaceAll(`<@${game.player1Id}>`\x2C '**P1**');\n      if (game.player2Id) text = text.replaceAll(`<@${game.player2Id}>`\x2C '**P2**');\n      if (text !== msg.content) {\n        msg.edit({ content: text\x2C allowedMentions: { parse: [] } }).catch(discordCatch);\n      }\n    })\n  ).catch(discordCatch);\n}\n\nconst BOTHELPERS_ROLE_NAME = 'bothelpers';\n\n/**\n * Log a game error to the guild's bot-logs channel (optionally in a per-game thread).\n * @mentions the **Bothelpers** role (by name) so the team is notified. Optionally include a jump link to the message that triggered the error.\n * @param {import('discord.js').Client} client\n * @param {import('discord.js').Guild|null} guild\n * @param {string|null} gameId - IA game id (e.g. "123"); included in message and used for per-game thread\n * @param {Error|unknown} error\n * @param {string} [context] - e.g. 'interactionCreate'\x2C 'dc_activate'\n * @param {{ messageLink?: { guildId: string\x2C channelId: string\x2C messageId: string } }} [options] - when provided\x2C adds "Jump to message" link\n */\nexport async function logGameErrorToBotLogs(client\x2C guild\x2C gameId\x2C error\x2C context = ''\x2C options = {}) {\n  try {\n    const errMsg = error?.message || String(error);\n    const link = options.messageLink?.guildId && options.messageLink?.channelId && options.messageLink?.messageId\n      ? `https://discord.com/channels/${options.messageLink.guildId}/${options.messageLink.channelId}/${options.messageLink.messageId}`\n      : null;\n\n    // \u2500\u2500 Step 1: Persist to Postgres (source of truth) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    const source = context === 'selfplay' ? 'selfplay'\n      : (!gameId ? 'system' : 'pvp');\n    const incidentId = await insertIncident({\n      game_id: gameId ?? null\x2C\n      guild_id: guild?.id ?? null\x2C\n      source\x2C\n      context: context || null\x2C\n      error_message: errMsg\x2C\n      error_stack: error?.stack ?? null\x2C\n      selfplay_run_id: options.selfplayRunId ?? null\x2C\n      channel_id: options.messageLink?.channelId ?? null\x2C\n      message_link: link\x2C\n      metadata: options.metadata ?? {}\x2C\n    });\n\n    // \u2500\u2500 Step 2: Mirror to Discord bot-logs \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    if (!guild) {\n      console.error('logGameErrorToBotLogs: no guild (interaction may be in DMs)');\n      if (incidentId) setIncidentMirrorFailed(incidentId).catch(discordCatch);\n      return;\n    }\n    let ch = null;\n    try {\n      await guild.roles.fetch().catch(discordCatch);\n      try { ch = await fetchGameChannel(client\x2C BOT_LOGS_CHANNEL_ID); } catch {}\n      if (!ch) {\n        await guild.channels.fetch().catch(discordCatch);\n        ch = guild.channels.cache.find((c) => {\n          if (c.type !== ChannelType.GuildText) return false;\n          const name = (c.name || '').toLowerCase().trim();\n          return BOT_LOGS_CHANNEL_NAMES.includes(name) || name.replace(/\\s+/g\x2C '-') === 'bot-logs';\n        });\n      }\n    } catch {}\n    if (!ch) {\n      console.error(\n        `Bot logs channel not found in guild "${guild.name}" (${guild.id}). Ensure your existing bot logs text channel is named one of: ${BOT_LOGS_CHANNEL_NAMES.join('\x2C ')}\x2C or has ID ${BOT_LOGS_CHANNEL_ID}.`\n      );\n      if (incidentId) setIncidentMirrorFailed(incidentId).catch(discordCatch);\n      return;\n    }\n    const stack = error?.stack ? `\\n\\`\\`\\`\\n${error.stack.slice(0\x2C 800)}\\n\\`\\`\\`` : '';\n    const ctx = context ? ` (${context})` : '';\n    const bothelpersRole = guild.roles.cache.find((r) => (r.name || '').toLowerCase() === BOTHELPERS_ROLE_NAME.toLowerCase());\n    let content = '';\n    if (bothelpersRole) content += `<@&${bothelpersRole.id}> `;\n    const channelRef = options.messageLink?.channelId ? ` | <#${options.messageLink.channelId}>` : '';\n    const incidentRef = incidentId ? ` [#${incidentId}]` : '';\n    content += `\u26a0\ufe0f **Game Error**${gameId ? ` \u2014 IA Game #${gameId}` : ''}${incidentRef}${channelRef}${ctx}\\n${errMsg}${stack}`;\n    if (link) content += `\\n\\n**Jump to message:** ${link}`;\n\n    const resolveRow = new ActionRowBuilder().addComponents(\n      new ButtonBuilder()\n        .setCustomId(`botlog_resolve_${incidentId || ''}`)\n        .setLabel('Resolve')\n        .setStyle(ButtonStyle.Secondary)\x2C\n    );\n    const sendPayload = { content\x2C components: [resolveRow] };\n    if (bothelpersRole) sendPayload.allowedMentions = { roles: [bothelpersRole.id] };\n\n    let sentMsg = null;\n    let usedThreadId = null;\n    try {\n      if (gameId) {\n        const key = `${guild.id}_${gameId}`;\n        let entry = gameErrorThreads.get(key);\n        let threadId = typeof entry === 'string' ? entry : entry?.threadId;\n        let headerMsgId = typeof entry === 'string' ? null : entry?.headerMsgId;\n        if (!threadId) {\n          try {\n            // Send a header message to bot-logs\x2C then create thread from it.\n            // This avoids the orphaned Discord system message that standalone\n            // threads.create() leaves behind when the thread is later deleted.\n            const headerMsg = await ch.send(sanitizeMentions({\n              content: `\ud83e\uddf5 **IA${gameId}** \u2014 Error thread`\x2C\n              allowedMentions: { users: [] }\x2C\n            }));\n            const thread = await headerMsg.startThread({\n              name: `IA${gameId} errors`\x2C\n              autoArchiveDuration: ThreadAutoArchiveDuration.OneWeek\x2C\n            });\n            threadId = thread.id;\n            headerMsgId = headerMsg.id;\n            gameErrorThreads.set(key\x2C { threadId\x2C headerMsgId });\n          } catch {\n            threadId = null;\n            headerMsgId = null;\n          }\n        }\n        let target = threadId ? await fetchGameChannel(client\x2C threadId) : null;\n        if (!target) {\n          if (threadId) gameErrorThreads.delete(key);\n          target = ch;\n          threadId = null;\n          headerMsgId = null;\n        }\n        usedThreadId = threadId;\n        if (sendPayload.content.length > 2000) sendPayload.content = sendPayload.content.slice(0\x2C 1997) + '...';\n        sentMsg = await withDiscordRetry(() => target.send(sendPayload));\n      } else {\n        if (sendPayload.content.length > 2000) sendPayload.content = sendPayload.content.slice(0\x2C 1997) + '...';\n        sentMsg = await withDiscordRetry(() => ch.send(sendPayload));\n      }\n    } catch (mirrorErr) {\n      console.error('Failed to mirror incident to bot-logs:'\x2C mirrorErr?.message ?? mirrorErr);\n      if (incidentId) setIncidentMirrorFailed(incidentId).catch(discordCatch);\n      return;\n    }\n\n    // \u2500\u2500 Step 3: Store Discord mirror IDs back to incident \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    if (incidentId && sentMsg) {\n      updateIncidentMirrorPosted(incidentId\x2C usedThreadId\x2C sentMsg.id).catch(discordCatch);\n    }\n  } catch (e) {\n    console.error('Failed to log game error to bot-logs:'\x2C e?.message ?? e);\n  }\n}\n\n/** Thread name from lobby state; fetches usernames. */\nexport async function getThreadName(thread\x2C lobby) {\n  const truncate = (s) => (s.length > 18 ? s.slice(0\x2C 15) + '\u2026' : s);\n  let p1Name = 'Creator';\n  let p2Name = lobby.joinedId ? 'Joiner' : '(waiting)';\n  try {\n    const p1 = await thread.client.users.fetch(lobby.creatorId);\n    p1Name = truncate(p1.username || p1.globalName || 'P1');\n    if (lobby.joinedId) {\n      const p2 = await thread.client.users.fetch(lobby.joinedId);\n      p2Name = truncate(p2.username || p2.globalName || 'P2');\n    }\n  } catch {\n    // fallback to IDs if fetch fails\n  }\n  const status = lobby.status || (lobby.joinedId ? 'Full' : 'LFG');\n  return `[${status}] ${p1Name} vs ${p2Name}`;\n}\n\n/** Update thread name to reflect lobby (e.g. [LFG] Creator vs (waiting)). */\nexport async function updateThreadName(thread\x2C lobby) {\n  try {\n    const name = await getThreadName(thread\x2C lobby);\n    await thread.setName(name.slice(0\x2C 100));\n  } catch (err) {\n    console.error('Failed to update thread name:'\x2C err);\n  }\n}\n\n/** Content string for the activations header in Play Area (green/red circles). */\nexport function getActivationsLine(remaining\x2C total) {\n  const green = '\ud83d\udfe2';\n  const red = '\ud83d\udd34';\n  const used = Math.max(0\x2C total - remaining);\n  const circles = green.repeat(remaining) + red.repeat(used);\n  return `**Activations:** ${circles} (${remaining}/${total} remaining)`;\n}\n\n/** Default actions per activation (2). */\nexport const DC_ACTIONS_PER_ACTIVATION = 2;\n\n/** Returns "X/2 Actions Remaining" with green/red square visual (\ud83d\udfe9=remaining\x2C \ud83d\udfe5=used). */\nexport function getActionsCounterContent(remaining\x2C total = DC_ACTIONS_PER_ACTIVATION) {\n  const r = Math.max(0\x2C Math.min(remaining\x2C total));\n  const used = total - r;\n  const green = '\ud83d\udfe9'.repeat(r);\n  const red = '\ud83d\udfe5'.repeat(used);\n  return `**Actions** \u2022 ${r}/${total} ${green}${red}`;\n}\n\n/** Call after changing game.p1ActivationsRemaining or game.p2ActivationsRemaining to refresh the Play Area header. */\nexport async function updateActivationsMessage(game\x2C playerNum\x2C client) {\n  const msgId = getActivationsMessageId(game\x2C playerNum);\n  const remaining = getActivationsRemaining(game\x2C playerNum);\n  const total = getActivationsTotal(game\x2C playerNum);\n  if (msgId == null || total === 0) return;\n  try {\n    const channelId = getPlayAreaId(game\x2C playerNum);\n    const channel = await fetchGameChannel(client\x2C channelId);\n    if (!channel) return;\n    const msg = await channel.messages.fetch(msgId);\n    await msg.edit(getActivationsLine(remaining\x2C total));\n  } catch (err) {\n    console.error('Failed to update activations message:'\x2C err);\n  }\n}\n
