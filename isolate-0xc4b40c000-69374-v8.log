script-source,144,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/discord/custom-id.js,export function parseCustomId(customId\x2C prefix) {\n  if (!customId?.startsWith(prefix)) return null;\n  return customId.slice(prefix.length);\n}\n\nexport function splitCustomId(customId\x2C prefix) {\n  const suffix = parseCustomId(customId\x2C prefix);\n  return suffix ? suffix.split('_') : [];\n}\n\nexport function matchCustomId(customId\x2C regex) {\n  const m = customId?.match(regex);\n  return m ? m.slice(1) : null;\n}\n
