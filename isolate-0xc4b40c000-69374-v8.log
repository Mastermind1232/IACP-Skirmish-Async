code-creation,Script,9,272722,0x3f05b9294c18,87, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/fast-forward.js:1:1,0x1d6be1738100,~
script-source,221,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/fast-forward.js,/**\n * Fast Forward: simulates movement rounds for testready games and opens activation threads\x2C\n * allowing the user to test CC cards at the right timing window.\n */\nimport { ActionRowBuilder\x2C ButtonBuilder\x2C ButtonStyle\x2C ThreadAutoArchiveDuration } from 'discord.js';\nimport { getAbilityLibrary\x2C getDcEffects\x2C getCcEffect as _getCcEffect } from '../data-loader.js';\nimport { getBoardStateForMovement\x2C getMovementProfile\x2C computeMovementCache } from '../game/movement.js';\nimport { parseCoord\x2C normalizeCoord } from '../game/coords.js';\nimport {\n  getDcList\x2C getDcMessageIds\x2C getPlayAreaId\x2C getPlayerId\x2C\n  getActivatedDcIndices\x2C getCcHand\x2C\n  setActivatedDcIndices\x2C getActivatedDcIndices as getActivatedIndices\x2C\n  recomputeActivationCounts\x2C\n  ccHandKey\x2C ccDiscardKey\x2C\n} from '../game/player-helpers.js';\nimport { dcNameFromFigureKey } from '../game/index.js';\nimport { parseCustomId } from '../discord/custom-id.js';\nimport { setRoundPhase\x2C ROUND_PHASES } from '../game/phase.js';\nimport { discordCatch } from '../error-handling.js';\nimport { requireGame } from '../utils/guards.js';\nimport { fetchGameChannel } from '../discord/channel-helpers.js';\n\n/**\n * Infer the timing category for fast-forward based on the primary CC's ability entry.\n * @param {object|null} entry - Ability library entry for the primary card\n * @returns {'roundStart'|'combatAttacker'|'combatDefender'|'activationStart'}\n */\nfunction inferTimingForFastForward(entry) {\n  if (!entry) return 'activationStart';\n  if (entry.claimInitiative) return 'roundStart';\n  if (entry.attackSurgeBonus || entry.attackAccuracyBonus || entry.nextAttackBonusPierce\n      || entry.attackBonusDice || entry.attackBonusHits || entry.nextAttacksBonusHits)\n    return 'combatAttacker';\n  if (entry.applyHideWhenDefending || entry.defenseBonusDice\n      || entry.roundDefenseBonusEvade || entry.roundDefenseBonusBlock)\n    return 'combatDefender';\n  return 'activationStart';\n}\n\n/** Chebyshev distance between two coordinate strings (includes diagonal). */\nfunction coordDistance(a\x2C b) {\n  if (!a || !b) return Infinity;\n  const { col: ac\x2C row: ar } = parseCoord(a);\n  const { col: bc\x2C row: br } = parseCoord(b);\n  return Math.max(Math.abs(ac - bc)\x2C Math.abs(ar - br));\n}\n\n/**\n * Among all reachable cells in the cache\x2C find the topLeft position that brings the figure's\n * footprint closest to the target coordinate.\n * @param {Map<string\x2C {cost: number\x2C topLeft: string\x2C size: string}>} cells\n * @param {string} targetPos\n * @returns {string|null} topLeft coord to move to\x2C or null if no reachable cells\n */\nfunction findClosestTopLeft(cells\x2C targetPos) {\n  let bestTopLeft = null;\n  let bestDist = Infinity;\n  for (const [cell\x2C info] of cells) {\n    const dist = coordDistance(cell\x2C targetPos);\n    if (dist < bestDist) {\n      bestDist = dist;\n      bestTopLeft = info.topLeft;\n    }\n  }\n  return bestTopLeft;\n}\n\n/** Get base movement speed for a DC from dc-effects\x2C fallback 4. */\nfunction getSpeedForDc(dcName) {\n  const effects = getDcEffects() || {};\n  const base = (dcName || '').replace(/\\s*\\[.*\\]\\s*$/\x2C '').trim();\n  const entry = effects[base] || effects[dcName] || (() => {\n    const key = Object.keys(effects).find((k) => k.toLowerCase() === (base || '').toLowerCase());\n    return key ? effects[key] : {};\n  })();\n  return entry?.speed ?? 4;\n}\n\n/** Get the first positioned figure for a player. Returns { figureKey\x2C pos } or null. */\nfunction getFirstPositionedFigure(game\x2C playerNum) {\n  const positions = game.figurePositions?.[playerNum] || {};\n  const figureKey = Object.keys(positions)[0];\n  if (!figureKey) return null;\n  return { figureKey\x2C pos: positions[figureKey] };\n}\n\n/**\n * Find the first non-activated\x2C non-defeated DC index for a player.\n * "Defeated" means no figure of that DC has a position.\n */\nfunction findFirstActiveDcIndex(game\x2C playerNum) {\n  const dcList = getDcList(game\x2C playerNum) || [];\n  const activated = new Set(getActivatedDcIndices(game\x2C playerNum) || []);\n  const poses = game.figurePositions?.[playerNum] || {};\n\n  for (let i = 0; i < dcList.length; i++) {\n    if (activated.has(i)) continue;\n    const dc = dcList[i];\n    const dcName = typeof dc === 'object' ? dc.dcName : dc;\n    const displayName = typeof dc === 'object' ? (dc.displayName || dcName) : dcName;\n    const dgIndex = displayName?.match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n    const hasPosition = Object.keys(poses).some((k) => {\n      const kDcName = dcNameFromFigureKey(k);\n      const kDg = k.match(/-(\\d+)-\\d+$/)?.[1] ?? '1';\n      return kDcName === dcName && kDg === dgIndex;\n    });\n    if (hasPosition) return i;\n  }\n  // Fallback: first non-activated DC even without a position (e.g. not deployed)\n  for (let i = 0; i < dcList.length; i++) {\n    if (!activated.has(i)) return i;\n  }\n  return 0;\n}\n\n/**\n * Simulate movement rounds\x2C moving figures toward each other.\n * @param {object} game\n * @param {number} activatorNum - Player number who will be activating\n * @param {number} defenderNum - The other player\n * @param {string} timing - from inferTimingForFastForward\n * @param {number} maxRounds\n * @returns {{ roundsSimulated: number\x2C movementLog: string[] }}\n */\nexport function simulateMovementRounds(game\x2C activatorNum\x2C defenderNum\x2C timing\x2C maxRounds = 5) {\n  const movementLog = [];\n  let roundsSimulated = 0;\n\n  for (let round = 0; round < maxRounds; round++) {\n    const aPoses = game.figurePositions?.[activatorNum] || {};\n    const dPoses = game.figurePositions?.[defenderNum] || {};\n    const aFigKey = Object.keys(aPoses)[0];\n    const dFigKey = Object.keys(dPoses)[0];\n\n    if (!aFigKey || !dFigKey) break;\n    const aPos = aPoses[aFigKey];\n    const dPos = dPoses[dFigKey];\n    if (!aPos || !dPos) break;\n\n    // For combat timing\x2C stop if already adjacent before moving\n    if ((timing === 'combatAttacker' || timing === 'combatDefender') && coordDistance(aPos\x2C dPos) <= 1) break;\n\n    // Move activator toward defender\n    const aDcName = dcNameFromFigureKey(aFigKey);\n    const aBoardState = getBoardStateForMovement(game\x2C aFigKey);\n    if (aBoardState) {\n      const aProfile = getMovementProfile(aDcName\x2C aFigKey\x2C game);\n      const aSpeed = getSpeedForDc(aDcName);\n      const aCache = computeMovementCache(aPos\x2C aSpeed\x2C aBoardState\x2C aProfile);\n      const aBest = findClosestTopLeft(aCache.cells\x2C dPos);\n      if (aBest && aBest !== normalizeCoord(aPos)) {\n        game.figurePositions = game.figurePositions || {};\n        game.figurePositions[activatorNum] = game.figurePositions[activatorNum] || {};\n        const oldPos = aPos;\n        game.figurePositions[activatorNum][aFigKey] = aBest;\n        movementLog.push(`${aDcName} moved ${String(oldPos).toUpperCase()} \u2192 ${aBest.toUpperCase()}`);\n      }\n    }\n\n    // For non-combat timing\x2C also move defender toward activator\n    if (timing !== 'combatAttacker' && timing !== 'combatDefender') {\n      const dDcName = dcNameFromFigureKey(dFigKey);\n      const dBoardState = getBoardStateForMovement(game\x2C dFigKey);\n      if (dBoardState) {\n        const dProfile = getMovementProfile(dDcName\x2C dFigKey\x2C game);\n        const dSpeed = getSpeedForDc(dDcName);\n        const dCache = computeMovementCache(dPos\x2C dSpeed\x2C dBoardState\x2C dProfile);\n        const newAPos = game.figurePositions?.[activatorNum]?.[aFigKey] || aPos;\n        const dBest = findClosestTopLeft(dCache.cells\x2C newAPos);\n        if (dBest && dBest !== normalizeCoord(dPos)) {\n          game.figurePositions = game.figurePositions || {};\n          game.figurePositions[defenderNum] = game.figurePositions[defenderNum] || {};\n          const oldDPos = dPos;\n          game.figurePositions[defenderNum][dFigKey] = dBest;\n          movementLog.push(`${dDcName} moved ${String(oldDPos).toUpperCase()} \u2192 ${dBest.toUpperCase()}`);\n        }\n      }\n    }\n\n    roundsSimulated++;\n\n    // Check stop condition after movement\n    const newAPos = game.figurePositions?.[activatorNum]?.[aFigKey];\n    const newDPos = game.figurePositions?.[defenderNum]?.[dFigKey];\n\n    // Non-combat: 1 round is enough\n    if (timing !== 'combatAttacker' && timing !== 'combatDefender') break;\n\n    // Combat: stop when adjacent\n    if (newAPos && newDPos && coordDistance(newAPos\x2C newDPos) <= 1) break;\n\n    // Advance game state for next round\n    game.currentRound = (game.currentRound || 1) + 1;\n    setRoundPhase(game\x2C ROUND_PHASES.START_OF_ROUND);\n    for (const pn of [1\x2C 2]) {\n      setActivatedDcIndices(game\x2C pn\x2C []);\n      recomputeActivationCounts(game\x2C pn);\n    }\n  }\n\n  return { roundsSimulated\x2C movementLog };\n}\n\n/**\n * Programmatically open an activation thread for a player's DC (without an interaction).\n * Mirrors handleDcActivate logic (dc-play-area.js) but uses direct channel/message fetching.\n */\nexport async function startActivationThreadForFastForward(game\x2C playerNum\x2C dcIndex\x2C gameId\x2C client\x2C ctx) {\n  const {\n    dcExhaustedState\x2C\n    renderDcEmbed\x2C\n    getDcPlayAreaComponents\x2C\n    getDcActionButtons\x2C\n    getActionsCounterContent\x2C\n    getActivationMinimapAttachment\x2C\n    updateActivationsMessage\x2C\n    DC_ACTIONS_PER_ACTIVATION\x2C\n  } = ctx;\n\n  const dcList = getDcList(game\x2C playerNum) || [];\n  const dcMessageIds = getDcMessageIds(game\x2C playerNum) || [];\n  const playAreaId = getPlayAreaId(game\x2C playerNum);\n  const ownerId = getPlayerId(game\x2C playerNum);\n\n  const dc = dcList[dcIndex];\n  if (!dc) throw new Error(`DC not found at index ${dcIndex} for player ${playerNum}`);\n\n  const dcName = typeof dc === 'object' ? dc.dcName : dc;\n  const displayName = typeof dc === 'object' ? (dc.displayName || dcName) : dcName;\n  const msgId = dcMessageIds[dcIndex];\n  if (!msgId) throw new Error(`No message ID for DC index ${dcIndex} player ${playerNum}`);\n\n  const healthState = (dcHealthState && dcHealthState.get(msgId)) || dc.healthState || [[null\x2C null]];\n\n  const channel = await fetchGameChannel(client\x2C playAreaId);\n  if (!channel) throw new Error(`Play area channel ${playAreaId} not found`);\n  const msg = await channel.messages.fetch(msgId);\n\n  dcExhaustedState.set(msgId\x2C true);\n  const { embed\x2C files } = await renderDcEmbed(game\x2C msgId\x2C ctx\x2C { exhausted: true });\n  await msg.edit({ embeds: [embed]\x2C files\x2C components: getDcPlayAreaComponents(msgId\x2C true\x2C game\x2C dcName) });\n\n  const threadName = displayName.length > 100 ? displayName.slice(0\x2C 97) + '\u2026' : displayName;\n  const thread = await msg.startThread({ name: threadName\x2C autoArchiveDuration: ThreadAutoArchiveDuration.OneWeek });\n\n  game.movementBank = game.movementBank || {};\n  game.movementBank[msgId] = { total: 0\x2C remaining: 0\x2C threadId: thread.id\x2C messageId: null\x2C displayName };\n  game.dcActionsData = game.dcActionsData || {};\n  game.dcActionsData[msgId] = { remaining: DC_ACTIONS_PER_ACTIVATION\x2C total: DC_ACTIONS_PER_ACTIVATION\x2C messageId: null\x2C threadId: thread.id\x2C specialsUsed: [] };\n\n  const pingContent = `<@${ownerId}> \u2014 Your activation thread. ${getActionsCounterContent(DC_ACTIONS_PER_ACTIVATION\x2C DC_ACTIONS_PER_ACTIVATION)}`;\n  const actMinimap = getActivationMinimapAttachment ? await getActivationMinimapAttachment(game\x2C msgId) : null;\n  const actionsPayload = {\n    content: pingContent\x2C\n    components: getDcActionButtons(msgId\x2C dcName\x2C displayName\x2C game.dcActionsData[msgId]\x2C game)\x2C\n    allowedMentions: { users: [ownerId] }\x2C\n  };\n  if (actMinimap) actionsPayload.files = [actMinimap];\n  const actionsMsg = await thread.send(actionsPayload);\n  game.dcActionsData[msgId].messageId = actionsMsg.id;\n\n  const currentActivated = getActivatedIndices(game\x2C playerNum) || [];\n  currentActivated.push(dcIndex);\n  setActivatedDcIndices(game\x2C playerNum\x2C currentActivated);\n  recomputeActivationCounts(game\x2C playerNum);\n  await updateActivationsMessage(game\x2C playerNum\x2C client);\n\n  return { thread\x2C msgId\x2C displayName };\n}\n\n/**\n * Open a defender thread for a player's DC (no activation state changes).\n * Shows CC buttons playable while defending.\n */\nexport async function startDefenderThreadForFastForward(game\x2C defenderPlayerNum\x2C defenderDcIndex\x2C gameId\x2C client\x2C ctx) {\n  const { getCcEffect } = ctx;\n\n  const dcList = getDcList(game\x2C defenderPlayerNum) || [];\n  const dcMessageIds = getDcMessageIds(game\x2C defenderPlayerNum) || [];\n  const playAreaId = getPlayAreaId(game\x2C defenderPlayerNum);\n\n  const dc = dcList[defenderDcIndex];\n  if (!dc) return null;\n\n  const dcName = typeof dc === 'object' ? dc.dcName : dc;\n  const displayName = typeof dc === 'object' ? (dc.displayName || dcName) : dcName;\n  const msgId = dcMessageIds[defenderDcIndex];\n  if (!msgId) return null;\n\n  const channel = await fetchGameChannel(client\x2C playAreaId);\n  if (!channel) return null;\n  const msg = await channel.messages.fetch(msgId);\n\n  const threadName = (`\ud83d\udee1\ufe0f DEFENDER \u2014 ${displayName}`).slice(0\x2C 100);\n  const thread = await msg.startThread({ name: threadName\x2C autoArchiveDuration: ThreadAutoArchiveDuration.OneWeek });\n\n  game.defenderThreadData = game.defenderThreadData || {};\n  game.defenderThreadData[msgId] = {\n    remaining: 0\x2C total: 0\x2C messageId: null\x2C threadId: thread.id\x2C specialsUsed: []\x2C\n    isDefenderThread: true\x2C playerNum: defenderPlayerNum\x2C\n  };\n\n  // Filter CC hand for defender-relevant cards\n  const hand = getCcHand(game\x2C defenderPlayerNum) || [];\n  const defenderCards = hand.filter((cardName) => {\n    const effect = getCcEffect(cardName);\n    if (!effect) return false;\n    return effect.applyHideWhenDefending || effect.defenseBonusDice\n        || effect.roundDefenseBonusEvade || effect.roundDefenseBonusBlock;\n  });\n\n  if (defenderCards.length === 0) {\n    await thread.send({ content: '\ud83d\udee1\ufe0f No defender CCs available in hand.' });\n  } else {\n    const btns = defenderCards.slice(0\x2C 5).map((cardName\x2C idx) =>\n      new ButtonBuilder()\n        .setCustomId(`dc_cc_defender_${gameId}_${msgId}_${idx}`)\n        .setLabel(`CC: ${cardName}`.slice(0\x2C 80))\n        .setStyle(ButtonStyle.Secondary)\n    );\n    const row = new ActionRowBuilder().addComponents(...btns);\n    // Store card list so handler can look up by index\n    game.defenderThreadData[msgId].defenderCards = defenderCards.slice(0\x2C 5);\n    await thread.send({ content: '\ud83d\udee1\ufe0f Defender CCs (play while being attacked):'\x2C components: [row] });\n  }\n\n  return { thread\x2C msgId\x2C displayName };\n}\n\n/**\n * Handle the fast_forward_{gameId} button.\n * Simulates movement rounds\x2C opens activation thread (and defender thread if needed).\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx\n */\nexport async function handleFastForward(interaction\x2C ctx) {\n  const gameId = parseCustomId(interaction.customId\x2C 'fast_forward_');\n  const { getGame\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!game.isTestGame || game.ended) {\n    await interaction.followUp({ content: 'Fast Forward is only available for active test games.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n\n  try {\n    // Infer timing from the primary card\n    const lib = getAbilityLibrary();\n    const primaryCard = game.testScenarioPrimaryCard;\n    const entry = primaryCard ? (lib?.abilities?.[primaryCard] ?? null) : null;\n    const timing = inferTimingForFastForward(entry);\n\n    // Determine who activates and who defends\n    // combatDefender: P2 attacks\x2C P1 defends (has the defender CC)\n    const activatorNum = timing === 'combatDefender' ? 2 : 1;\n    const defenderNum = 3 - activatorNum;\n\n    // Simulate movement rounds\n    const { roundsSimulated\x2C movementLog } = simulateMovementRounds(game\x2C activatorNum\x2C defenderNum\x2C timing\x2C 5);\n\n    // Find first non-activated DC for activator\n    const activatorDcIndex = findFirstActiveDcIndex(game\x2C activatorNum);\n\n    // Open activation thread\n    const activationResult = await startActivationThreadForFastForward(game\x2C activatorNum\x2C activatorDcIndex\x2C gameId\x2C client\x2C ctx);\n\n    // For combatDefender: also open defender thread for defender player\n    if (timing === 'combatDefender') {\n      const defenderDcIndex = findFirstActiveDcIndex(game\x2C defenderNum);\n      await startDefenderThreadForFastForward(game\x2C defenderNum\x2C defenderDcIndex\x2C gameId\x2C client\x2C ctx);\n    }\n\n    // Build summary log\n    const roundsLabel = roundsSimulated === 1 ? '1 round' : `${roundsSimulated} rounds`;\n    const moveSummary = movementLog.length > 0\n      ? '\\n' + movementLog.map((m) => `  \u2022 ${m}`).join('\\n')\n      : '';\n    const activatorDcName = activationResult?.displayName || 'figure';\n    await logGameAction(game\x2C client\x2C\n      `\u23e9 Fast-forwarded ${roundsLabel}.${moveSummary}\\nActivation thread opened for **${activatorDcName}**.`\x2C\n      { icon: 'activate' }\n    );\n\n    saveGames();\n  } catch (err) {\n    console.error('handleFastForward error:'\x2C err);\n    await interaction.followUp({ content: `Fast Forward failed: ${err.message}. Check bot console for details.`\x2C ephemeral: true }).catch((err2) => { console.error('[discord]'\x2C err2?.message ?? err2); });\n  }\n}\n\n/**\n * Handle the dc_cc_defender_{gameId}_{msgId}_{idx} button.\n * Plays a defender CC from the defender thread.\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx\n */\nexport async function handleDefenderCcPlay(interaction\x2C ctx) {\n  // customId: dc_cc_defender_{gameId}_{msgId}_{idx}\n  // gameId and msgId are digit-only strings; idx is a small integer\n  const idWithoutPrefix = parseCustomId(interaction.customId\x2C 'dc_cc_defender_');\n  const parts = idWithoutPrefix.split('_');\n  if (parts.length < 3) {\n    await interaction.followUp({ content: 'Invalid defender CC button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const gameId = parts[0];\n  const idx = parseInt(parts[parts.length - 1]\x2C 10);\n  const msgId = parts.slice(1\x2C -1).join('_');\n\n  const {\n    getGame\x2C\n    getCcEffect\x2C\n    resolveAbility\x2C\n    logGameAction\x2C\n    updateHandVisualMessage\x2C\n    updateDiscardPileMessage\x2C\n    saveGames\x2C\n    client\x2C\n  } = ctx;\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n\n  const defenderData = game.defenderThreadData?.[msgId];\n  if (!defenderData) {\n    await interaction.followUp({ content: 'Defender thread context not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const playerNum = defenderData.playerNum;\n  const defenderCards = defenderData.defenderCards;\n  if (!defenderCards || isNaN(idx) || idx < 0 || idx >= defenderCards.length) {\n    await interaction.followUp({ content: 'Defender CC not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const card = defenderCards[idx];\n  const handKey = ccHandKey(playerNum);\n  const discardKey = ccDiscardKey(playerNum);\n  const hand = game[handKey] || [];\n\n  if (!hand.includes(card)) {\n    await interaction.followUp({ content: "That card is no longer in your hand."\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n\n  // Remove from hand\x2C add to discard\n  hand.splice(hand.indexOf(card)\x2C 1);\n  game[handKey] = hand;\n  game[discardKey] = game[discardKey] || [];\n  game[discardKey].push(card);\n\n  // Resolve ability\n  if (resolveAbility) {\n    const effectData = getCcEffect(card);\n    const abilityId = effectData?.abilityId ?? card;\n    resolveAbility(abilityId\x2C { game\x2C playerNum\x2C cardName: card\x2C msgId\x2C isDefending: true });\n  }\n\n  await logGameAction(game\x2C client\x2C `\ud83d\udee1\ufe0f <@${getPlayerId(game\x2C playerNum)}> played defender CC **${card}**.`\x2C { icon: 'card' });\n  await updateHandVisualMessage(game\x2C playerNum\x2C client);\n  await updateDiscardPileMessage(game\x2C playerNum\x2C client);\n\n  saveGames();\n}\n
