script-source,135,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/domain/reducer/movement-reducer.js,export const movementReducerHandlers = {\n  MovementStarted(state\x2C payload) {\n    const moveInProgress = { ...(state.moveInProgress || {}) };\n    moveInProgress[payload.figureKey] = {\n      figureKey: payload.figureKey\x2C\n      movementPoints: payload.movementPoints\x2C\n      remaining: payload.movementPoints\x2C\n      startCoord: payload.startCoord || null\x2C\n      path: []\x2C\n    };\n    return { ...state\x2C moveInProgress };\n  }\x2C\n\n  MovementPointsAdjusted(state\x2C payload) {\n    const entry = state.moveInProgress?.[payload.figureKey];\n    if (!entry) return state;\n    const moveInProgress = {\n      ...state.moveInProgress\x2C\n      [payload.figureKey]: {\n        ...entry\x2C\n        remaining: entry.remaining + payload.adjustment\x2C\n        movementPoints: entry.movementPoints + payload.adjustment\x2C\n      }\x2C\n    };\n    return { ...state\x2C moveInProgress };\n  }\x2C\n\n  FigureMoved(state\x2C payload) {\n    // Update figurePositions\n    const figurePositions = structuredClone(state.figurePositions || {});\n    const playerPositions = figurePositions[payload.playerNum] || {};\n    playerPositions[payload.figureKey] = payload.toCoord;\n    figurePositions[payload.playerNum] = playerPositions;\n\n    // Deduct MP if moveInProgress exists\n    const moveInProgress = state.moveInProgress ? { ...state.moveInProgress } : {};\n    const entry = moveInProgress[payload.figureKey];\n    if (entry) {\n      moveInProgress[payload.figureKey] = {\n        ...entry\x2C\n        remaining: entry.remaining - (payload.mpCost ?? 1)\x2C\n        path: [...entry.path\x2C payload.toCoord]\x2C\n      };\n    }\n\n    return { ...state\x2C figurePositions\x2C moveInProgress };\n  }\x2C\n\n  MovementCompleted(state\x2C payload) {\n    const moveInProgress = { ...state.moveInProgress };\n    delete moveInProgress[payload.figureKey];\n    return { ...state\x2C moveInProgress };\n  }\x2C\n\n  MovementCancelled(state\x2C payload) {\n    const moveInProgress = { ...state.moveInProgress };\n    const entry = moveInProgress[payload.figureKey];\n\n    // Revert position if original coord provided\n    let figurePositions = state.figurePositions;\n    if (payload.originalCoord && payload.playerNum) {\n      figurePositions = structuredClone(state.figurePositions || {});\n      const playerPositions = figurePositions[payload.playerNum] || {};\n      playerPositions[payload.figureKey] = payload.originalCoord;\n      figurePositions[payload.playerNum] = playerPositions;\n    }\n\n    delete moveInProgress[payload.figureKey];\n    return { ...state\x2C figurePositions\x2C moveInProgress };\n  }\x2C\n\n  FigurePushed(state\x2C payload) {\n    const figurePositions = structuredClone(state.figurePositions || {});\n    const playerPositions = figurePositions[payload.playerNum] || {};\n    playerPositions[payload.figureKey] = payload.toCoord;\n    figurePositions[payload.playerNum] = playerPositions;\n    return { ...state\x2C figurePositions };\n  }\x2C\n};\n
