script-source,862,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/discord.js/src/structures/InteractionCallbackResponse.js,'use strict';\n\nconst InteractionCallback = require('./InteractionCallback');\nconst InteractionCallbackResource = require('./InteractionCallbackResource');\n\n/**\n * Represents an interaction's response\n */\nclass InteractionCallbackResponse {\n  constructor(client\x2C data) {\n    /**\n     * The client that instantiated this\n     * @name InteractionCallbackResponse#client\n     * @type {Client}\n     * @readonly\n     */\n    Object.defineProperty(this\x2C 'client'\x2C { value: client });\n\n    /**\n     * The interaction object associated with the interaction callback response\n     * @type {InteractionCallback}\n     */\n    this.interaction = new InteractionCallback(client\x2C data.interaction);\n\n    /**\n     * The resource that was created by the interaction response\n     * @type {?InteractionCallbackResource}\n     */\n    this.resource = data.resource ? new InteractionCallbackResource(client\x2C data.resource) : null;\n  }\n}\n\nmodule.exports = InteractionCallbackResponse;\n
