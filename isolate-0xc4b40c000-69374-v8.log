script-source,200,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/ai/training-config.js,/**\n * Training whitelist and matchup configuration.\n *\n * Defines the fixed set of deployment cards\x2C command cards\x2C and matchups\n * used for headless self-play training. Any card outside these sets\n * triggers a hard abort before training data is generated.\n */\n\n// \u2500\u2500 Whitelisted Deployment Cards (25) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nexport const TRAINING_WHITELIST_DCS = new Set([\n  // Original 7\n  'Luke Skywalker'\x2C\n  'Wookiee Warrior (Elite)'\x2C\n  'Darth Vader'\x2C\n  'Emperor Palpatine'\x2C\n  'Stormtrooper (Elite)'\x2C\n  'Boba Fett'\x2C\n  'Nexu (Elite)'\x2C\n  // Wave 1 Expansion (10) \u2014 archetype diversity\n  'Bantha Rider'\x2C                   // Ultra-tank (21HP)\x2C Scum\n  'Leia Organa'\x2C                    // LEADER + support + recovery surge\x2C Rebel\n  'Bo-Katan Kryze'\x2C                 // High surge complexity (4 options)\x2C ranged\x2C Scum\n  'Rebel Trooper (Elite)'\x2C          // 3-fig ranged swarm\x2C Rebel\n  '74-Z Speeder Bike (Elite)'\x2C      // Vehicle\x2C 2-fig fast ranged\x2C Imperial\n  'Yoda'\x2C                           // Slow support (spd 3)\x2C Rebel\n  'Wookiee Warrior (Regular)'\x2C      // Non-elite variant (11HP vs 13HP)\x2C Rebel\n  'The Armorer'\x2C                    // Melee support\x2C Scum\n  '0-0-0'\x2C                          // Droid w/ special ability\x2C Imperial\n  'CT-1701'\x2C                        // Mid-range Rebel unique\n  // Wave 2 Expansion (8) \u2014 new tactical problems\n  'Gaarkhan'\x2C                       // AoE melee berserker\x2C brutal_cleave\x2C Rebel\n  'Gideon Argus'\x2C                   // Ultra-squishy commander (5HP)\x2C on_my_mark\x2C Rebel\n  'C-3P0'\x2C                          // Non-combatant support droid (4HP)\x2C Rebel\n  'Mara Jade'\x2C                      // Cross-faction flex melee\x2C Any\n  'BT-1'\x2C                           // Droid ranged w/ AoE missile_salvo\x2C Imperial\n  'Thrawn'\x2C                         // Imperial strategist/commander\x2C strategize\n  'Chewbacca'\x2C                      // Bodyguard/protector tank (14HP)\x2C Rebel\n  'Paz Vizsla'\x2C                     // Scum heavy infantry w/ strain pressure\n]);\n\n// \u2500\u2500 Whitelisted Command Cards (35) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nexport const TRAINING_WHITELIST_CCS = new Set([\n  // Original 20\n  'Burst Fire'\x2C\n  'Concentrated Fire'\x2C\n  'Covering Fire'\x2C\n  'Deadeye'\x2C\n  'Deflection'\x2C\n  'Dirty Trick'\x2C\n  'Disorient'\x2C\n  'Element of Surprise'\x2C\n  'Focus'\x2C\n  'Force Lightning'\x2C\n  'Force Push'\x2C\n  'Hunt Them Down'\x2C\n  'Lock On'\x2C\n  'Lure of the Dark Side'\x2C\n  'Marksman'\x2C\n  'Ready Weapons'\x2C\n  'Take Cover'\x2C\n  'Take Initiative'\x2C\n  'Urgency'\x2C\n  'Wookiee Rage'\x2C\n  // Wave 1 Expansion (10) \u2014 timing diversity\n  'Brace Yourself'\x2C           // 0-cost\x2C whenAttackDeclaredOnYou \u2014 defensive\n  'Ambush'\x2C                   // 1-cost\x2C whenAttackDeclaredOnYou \u2014 reactive\n  'Blitz'\x2C                    // 1-cost\x2C duringAttack \u2014 offensive combat\n  'Fleet Footed'\x2C             // 0-cost\x2C duringActivation \u2014 movement utility\n  'Expose Weakness'\x2C          // 0-cost\x2C duringActivation \u2014 debuff\n  'Deadly Precision'\x2C         // 0-cost\x2C startOfActivation \u2014 offensive\n  'Bodyguard'\x2C                // 1-cost\x2C whenAttackDeclaredOnAdjacentFriendly \u2014 positional\n  'Battlefield Awareness'\x2C    // 1-cost\x2C afterAttackDice \u2014 combat reactive\n  'Celebration'\x2C              // 0-cost\x2C afterUniqueHostileDefeated \u2014 kill reward\n  'Force Rush'\x2C               // 0-cost\x2C startOfActivation \u2014 movement burst\n  // Wave 2 Expansion (5) \u2014 counter-play + new timings\n  'Negation'\x2C                 // 1-cost\x2C whenCommandCardPlayed \u2014 counter-play\n  'Parry'\x2C                    // 0-cost\x2C whileDefending \u2014 melee counter\n  'Planning'\x2C                 // 0-cost\x2C specialAction \u2014 utility action\n  'Call the Vanguard'\x2C        // 2-cost\x2C startOfRound \u2014 round-start tempo\n  'Heart of Freedom'\x2C         // 2-cost\x2C startOfActivation \u2014 activation burst\n]);\n\n// \u2500\u2500 Training Maps (6 with valid deployment zones) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nexport const TRAINING_MAPS = [\n  'mos-eisley-outskirts'\x2C\n  'corellian-underground'\x2C\n  'lothal-wastes'\x2C\n  'chopper-base-atollon'\x2C\n  'devaron-garrison'\x2C\n  'hoth-battle-station'\x2C\n];\n\n// \u2500\u2500 Fixed Training Matchups (8) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nexport const TRAINING_MATCHUPS = [\n  // \u2500\u2500 Original 2 (preserved for regression testing) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  {\n    label: 'Rebels vs Imperial'\x2C\n    p1Deck: {\n      name: 'Default Rebels'\x2C\n      dcList: ['Luke Skywalker'\x2C 'Wookiee Warrior (Elite)']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deadeye'\x2C 'Deflection'\x2C 'Dirty Trick'\x2C 'Disorient'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Force Push'\x2C 'Lock On'\x2C 'Take Cover'\x2C 'Take Initiative'\x2C 'Marksman'\x2C 'Ready Weapons']\x2C\n      dcCount: 2\x2C\n      ccCount: 15\x2C\n    }\x2C\n    p2Deck: {\n      name: 'Default Imperial'\x2C\n      dcList: ['Darth Vader'\x2C 'Emperor Palpatine'\x2C 'Stormtrooper (Elite)']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deadeye'\x2C 'Deflection'\x2C 'Dirty Trick'\x2C 'Disorient'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Force Lightning'\x2C 'Lock On'\x2C 'Take Cover'\x2C 'Take Initiative'\x2C 'Marksman'\x2C 'Ready Weapons']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n  }\x2C\n  {\n    label: 'Rebels vs Scum'\x2C\n    p1Deck: {\n      name: 'Default Rebels'\x2C\n      dcList: ['Luke Skywalker'\x2C 'Wookiee Warrior (Elite)']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deadeye'\x2C 'Deflection'\x2C 'Dirty Trick'\x2C 'Disorient'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Force Push'\x2C 'Lock On'\x2C 'Take Cover'\x2C 'Take Initiative'\x2C 'Marksman'\x2C 'Ready Weapons']\x2C\n      dcCount: 2\x2C\n      ccCount: 15\x2C\n    }\x2C\n    p2Deck: {\n      name: 'Default Scum'\x2C\n      dcList: ['Boba Fett'\x2C 'Nexu (Elite)']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Dirty Trick'\x2C 'Disorient'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Hunt Them Down'\x2C 'Lure of the Dark Side'\x2C 'Lock On'\x2C 'Take Cover'\x2C 'Take Initiative'\x2C 'Marksman'\x2C 'Ready Weapons'\x2C 'Urgency'\x2C 'Wookiee Rage']\x2C\n      dcCount: 2\x2C\n      ccCount: 15\x2C\n    }\x2C\n  }\x2C\n\n  // \u2500\u2500 Expansion 6 (new matchups for coverage) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n  // Matchup 3: Swarm vs elite \u2014 many weak bodies vs fewer tough ones\n  {\n    label: 'Rebel Swarm vs Imperial Armor'\x2C\n    p1Deck: {\n      name: 'Rebel Swarm'\x2C\n      dcList: ['Leia Organa'\x2C 'Rebel Trooper (Elite)'\x2C 'CT-1701']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deflection'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Fleet Footed'\x2C 'Take Cover'\x2C 'Take Initiative'\x2C 'Bodyguard'\x2C 'Celebration'\x2C 'Force Rush'\x2C 'Urgency'\x2C 'Deadly Precision'\x2C 'Brace Yourself']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n    p2Deck: {\n      name: 'Imperial Armor'\x2C\n      dcList: ['Darth Vader'\x2C '74-Z Speeder Bike (Elite)']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deflection'\x2C 'Dirty Trick'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Lock On'\x2C 'Take Cover'\x2C 'Take Initiative'\x2C 'Blitz'\x2C 'Ambush'\x2C 'Battlefield Awareness'\x2C 'Marksman'\x2C 'Ready Weapons']\x2C\n      dcCount: 2\x2C\n      ccCount: 15\x2C\n    }\x2C\n  }\x2C\n\n  // Matchup 4: Ultra-tank + ranged vs support + melee \u2014 asymmetric HP pools\n  {\n    label: 'Scum Heavies vs Rebel Defense'\x2C\n    p1Deck: {\n      name: 'Scum Heavies'\x2C\n      dcList: ['Bantha Rider'\x2C 'Bo-Katan Kryze']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Dirty Trick'\x2C 'Disorient'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Hunt Them Down'\x2C 'Lock On'\x2C 'Take Initiative'\x2C 'Blitz'\x2C 'Ambush'\x2C 'Expose Weakness'\x2C 'Marksman'\x2C 'Lure of the Dark Side'\x2C 'Urgency']\x2C\n      dcCount: 2\x2C\n      ccCount: 15\x2C\n    }\x2C\n    p2Deck: {\n      name: 'Rebel Defense'\x2C\n      dcList: ['Leia Organa'\x2C 'Wookiee Warrior (Elite)']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deflection'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Force Push'\x2C 'Take Cover'\x2C 'Take Initiative'\x2C 'Bodyguard'\x2C 'Brace Yourself'\x2C 'Fleet Footed'\x2C 'Wookiee Rage'\x2C 'Celebration'\x2C 'Ready Weapons']\x2C\n      dcCount: 2\x2C\n      ccCount: 15\x2C\n    }\x2C\n  }\x2C\n\n  // Matchup 5: Multi-fig vs multi-unit \u2014 crowded board positioning\n  {\n    label: 'Imperial Line vs Scum Raiders'\x2C\n    p1Deck: {\n      name: 'Imperial Line'\x2C\n      dcList: ['Stormtrooper (Elite)'\x2C '74-Z Speeder Bike (Elite)'\x2C '0-0-0']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deadeye'\x2C 'Deflection'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Lock On'\x2C 'Take Cover'\x2C 'Take Initiative'\x2C 'Blitz'\x2C 'Battlefield Awareness'\x2C 'Marksman'\x2C 'Ready Weapons'\x2C 'Deadly Precision']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n    p2Deck: {\n      name: 'Scum Raiders'\x2C\n      dcList: ['Boba Fett'\x2C 'The Armorer'\x2C 'Nexu (Elite)']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Dirty Trick'\x2C 'Disorient'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Hunt Them Down'\x2C 'Lure of the Dark Side'\x2C 'Lock On'\x2C 'Take Initiative'\x2C 'Ambush'\x2C 'Expose Weakness'\x2C 'Urgency'\x2C 'Blitz'\x2C 'Brace Yourself']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n  }\x2C\n\n  // Matchup 6: Slow support + fast hero vs tanky melee pair\n  {\n    label: 'Jedi Council vs Sith Lords'\x2C\n    p1Deck: {\n      name: 'Jedi Council'\x2C\n      dcList: ['Luke Skywalker'\x2C 'Yoda']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deflection'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Force Push'\x2C 'Force Rush'\x2C 'Take Cover'\x2C 'Take Initiative'\x2C 'Fleet Footed'\x2C 'Bodyguard'\x2C 'Celebration'\x2C 'Deadly Precision'\x2C 'Brace Yourself']\x2C\n      dcCount: 2\x2C\n      ccCount: 15\x2C\n    }\x2C\n    p2Deck: {\n      name: 'Sith Lords'\x2C\n      dcList: ['Darth Vader'\x2C 'Emperor Palpatine']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deflection'\x2C 'Dirty Trick'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Force Lightning'\x2C 'Lock On'\x2C 'Take Initiative'\x2C 'Blitz'\x2C 'Ambush'\x2C 'Expose Weakness'\x2C 'Lure of the Dark Side'\x2C 'Marksman']\x2C\n      dcCount: 2\x2C\n      ccCount: 15\x2C\n    }\x2C\n  }\x2C\n\n  // Matchup 7: Broad roster \u2014 6 DCs on board\x2C diverse profiles\n  {\n    label: 'Rebel Alliance vs Scum Muscle'\x2C\n    p1Deck: {\n      name: 'Rebel Alliance'\x2C\n      dcList: ['CT-1701'\x2C 'Wookiee Warrior (Regular)'\x2C 'Rebel Trooper (Elite)']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deflection'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Take Cover'\x2C 'Take Initiative'\x2C 'Wookiee Rage'\x2C 'Fleet Footed'\x2C 'Bodyguard'\x2C 'Celebration'\x2C 'Brace Yourself'\x2C 'Ready Weapons'\x2C 'Urgency']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n    p2Deck: {\n      name: 'Scum Muscle'\x2C\n      dcList: ['Bantha Rider'\x2C 'Bo-Katan Kryze'\x2C 'The Armorer']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Dirty Trick'\x2C 'Disorient'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Hunt Them Down'\x2C 'Lure of the Dark Side'\x2C 'Lock On'\x2C 'Take Initiative'\x2C 'Blitz'\x2C 'Ambush'\x2C 'Expose Weakness'\x2C 'Urgency'\x2C 'Marksman']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n  }\x2C\n\n  // Matchup 8: Imperial heavy vs Rebel support-heavy\n  {\n    label: 'Imperial Elite vs Rebel Guerrillas'\x2C\n    p1Deck: {\n      name: 'Imperial Elite'\x2C\n      dcList: ['Darth Vader'\x2C '0-0-0'\x2C 'Stormtrooper (Elite)']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deflection'\x2C 'Dirty Trick'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Force Lightning'\x2C 'Lock On'\x2C 'Take Initiative'\x2C 'Blitz'\x2C 'Ambush'\x2C 'Battlefield Awareness'\x2C 'Marksman'\x2C 'Ready Weapons']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n    p2Deck: {\n      name: 'Rebel Guerrillas'\x2C\n      dcList: ['Luke Skywalker'\x2C 'Leia Organa'\x2C 'Yoda']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deflection'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Force Push'\x2C 'Force Rush'\x2C 'Take Cover'\x2C 'Take Initiative'\x2C 'Fleet Footed'\x2C 'Bodyguard'\x2C 'Celebration'\x2C 'Deadly Precision'\x2C 'Brace Yourself']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n  }\x2C\n\n  // \u2500\u2500 Wave 2 Expansion (5 new matchups) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n  // Matchup 9: Protect-the-commander \u2014 melee rush with squishy support vs ranged kiting\n  {\n    label: 'Rebel Melee Storm vs Scum Firepower'\x2C\n    p1Deck: {\n      name: 'Rebel Melee Storm'\x2C\n      dcList: ['Gaarkhan'\x2C 'Chewbacca'\x2C 'Gideon Argus']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deflection'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Wookiee Rage'\x2C 'Bodyguard'\x2C 'Brace Yourself'\x2C 'Fleet Footed'\x2C 'Heart of Freedom'\x2C 'Parry'\x2C 'Celebration'\x2C 'Take Initiative'\x2C 'Negation']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n    p2Deck: {\n      name: 'Scum Firepower'\x2C\n      dcList: ['Paz Vizsla'\x2C 'Bo-Katan Kryze'\x2C 'The Armorer']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Dirty Trick'\x2C 'Disorient'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Hunt Them Down'\x2C 'Lure of the Dark Side'\x2C 'Lock On'\x2C 'Take Initiative'\x2C 'Blitz'\x2C 'Ambush'\x2C 'Expose Weakness'\x2C 'Negation'\x2C 'Marksman']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n  }\x2C\n\n  // Matchup 10: Combined arms command vs individual hero play\n  {\n    label: 'Imperial Combined Arms vs Rebel Heroes'\x2C\n    p1Deck: {\n      name: 'Imperial Combined Arms'\x2C\n      dcList: ['Thrawn'\x2C 'BT-1'\x2C 'Stormtrooper (Elite)']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deflection'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Lock On'\x2C 'Take Initiative'\x2C 'Blitz'\x2C 'Battlefield Awareness'\x2C 'Marksman'\x2C 'Ready Weapons'\x2C 'Planning'\x2C 'Call the Vanguard'\x2C 'Negation']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n    p2Deck: {\n      name: 'Rebel Heroes'\x2C\n      dcList: ['Luke Skywalker'\x2C 'Leia Organa'\x2C 'Mara Jade']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deflection'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Force Push'\x2C 'Force Rush'\x2C 'Take Cover'\x2C 'Take Initiative'\x2C 'Fleet Footed'\x2C 'Celebration'\x2C 'Heart of Freedom'\x2C 'Deadly Precision'\x2C 'Parry']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n  }\x2C\n\n  // Matchup 11: All-tech ranged vs melee Force users \u2014 asymmetric engagement ranges\n  {\n    label: 'Droid Coalition vs Force Council'\x2C\n    p1Deck: {\n      name: 'Droid Coalition'\x2C\n      dcList: ['BT-1'\x2C '0-0-0'\x2C '74-Z Speeder Bike (Elite)']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deadeye'\x2C 'Deflection'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Lock On'\x2C 'Take Cover'\x2C 'Take Initiative'\x2C 'Blitz'\x2C 'Battlefield Awareness'\x2C 'Marksman'\x2C 'Ready Weapons'\x2C 'Planning']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n    p2Deck: {\n      name: 'Force Council'\x2C\n      dcList: ['Luke Skywalker'\x2C 'Yoda'\x2C 'Gaarkhan']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deflection'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Force Push'\x2C 'Force Rush'\x2C 'Wookiee Rage'\x2C 'Take Initiative'\x2C 'Fleet Footed'\x2C 'Bodyguard'\x2C 'Celebration'\x2C 'Heart of Freedom'\x2C 'Parry']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n  }\x2C\n\n  // Matchup 12: Protector + non-combatant + screen vs fast assassin trio\n  {\n    label: 'Bodyguard Formation vs Assassins'\x2C\n    p1Deck: {\n      name: 'Bodyguard Formation'\x2C\n      dcList: ['Chewbacca'\x2C 'C-3P0'\x2C 'Rebel Trooper (Elite)']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deflection'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Take Cover'\x2C 'Take Initiative'\x2C 'Bodyguard'\x2C 'Brace Yourself'\x2C 'Fleet Footed'\x2C 'Celebration'\x2C 'Negation'\x2C 'Planning'\x2C 'Heart of Freedom']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n    p2Deck: {\n      name: 'Assassin Trio'\x2C\n      dcList: ['Boba Fett'\x2C 'Nexu (Elite)'\x2C 'Mara Jade']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Dirty Trick'\x2C 'Disorient'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Hunt Them Down'\x2C 'Lure of the Dark Side'\x2C 'Lock On'\x2C 'Take Initiative'\x2C 'Blitz'\x2C 'Ambush'\x2C 'Expose Weakness'\x2C 'Urgency'\x2C 'Deadly Precision']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n  }\x2C\n\n  // Matchup 13: Imperial strategic depth vs Scum raw stats advantage\n  {\n    label: 'Imperial Doctrine vs Scum Muscle'\x2C\n    p1Deck: {\n      name: 'Imperial Doctrine'\x2C\n      dcList: ['Thrawn'\x2C 'Darth Vader'\x2C 'BT-1']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Covering Fire'\x2C 'Deflection'\x2C 'Dirty Trick'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Force Lightning'\x2C 'Lock On'\x2C 'Take Initiative'\x2C 'Blitz'\x2C 'Battlefield Awareness'\x2C 'Marksman'\x2C 'Planning'\x2C 'Call the Vanguard']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n    p2Deck: {\n      name: 'Scum Muscle'\x2C\n      dcList: ['Paz Vizsla'\x2C 'Bantha Rider'\x2C 'Bo-Katan Kryze']\x2C\n      ccList: ['Burst Fire'\x2C 'Concentrated Fire'\x2C 'Dirty Trick'\x2C 'Disorient'\x2C 'Element of Surprise'\x2C 'Focus'\x2C 'Hunt Them Down'\x2C 'Lure of the Dark Side'\x2C 'Lock On'\x2C 'Take Initiative'\x2C 'Blitz'\x2C 'Ambush'\x2C 'Expose Weakness'\x2C 'Urgency'\x2C 'Negation']\x2C\n      dcCount: 3\x2C\n      ccCount: 15\x2C\n    }\x2C\n  }\x2C\n];\n
