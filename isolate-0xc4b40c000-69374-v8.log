script-source,882,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/discord.js/src/structures/ModalSubmitInteraction.js,'use strict';\n\nconst { Collection } = require('@discordjs/collection');\nconst { lazy } = require('@discordjs/util');\nconst BaseInteraction = require('./BaseInteraction');\nconst InteractionWebhook = require('./InteractionWebhook');\nconst ModalSubmitFields = require('./ModalSubmitFields');\nconst InteractionResponses = require('./interfaces/InteractionResponses');\nconst { transformResolved } = require('../util/Util');\n\nconst getMessage = lazy(() => require('./Message').Message);\nconst getAttachment = lazy(() => require('./Attachment'));\n\n/**\n * @typedef {Object} BaseModalData\n * @property {ComponentType} type The component type of the field\n * @property {number} id The id of the field\n */\n\n/**\n * @typedef {BaseModalData} FileUploadModalData\n * @property {string} customId The custom id of the file upload\n * @property {Snowflake[]} values The values of the file upload\n * @property {Collection<Snowflake\x2C Attachment>} [attachments] The resolved attachments\n */\n\n/**\n * @typedef {BaseModalData} TextInputModalData\n * @property {string} customId The custom id of the field\n * @property {string} value The value of the field\n */\n\n/**\n * @typedef {BaseModalData} SelectMenuModalData\n * @property {string} customId The custom id of the field\n * @property {string[]} values The values of the field\n * @property {Collection<Snowflake\x2C GuildMember|APIGuildMember>} [members] The resolved members\n * @property {Collection<Snowflake\x2C User|APIUser>} [users] The resolved users\n * @property {Collection<Snowflake\x2C Role|APIRole>} [roles] The resolved roles\n * @property {Collection<Snowflake\x2C BaseChannel|APIChannel>} [channels] The resolved channels\n */\n\n/**\n * @typedef {BaseModalData} TextDisplayModalData\n */\n\n/**\n * @typedef {SelectMenuModalData|TextInputModalData|FileUploadModalData} ModalData\n */\n\n/**\n * @typedef {BaseModalData} LabelModalData\n * @property {ModalData} component The component within the label\n */\n\n/**\n * @typedef {BaseModalData} ActionRowModalData\n * @property {TextInputModalData[]} components The components of this action row\n */\n\n/**\n * Represents a modal interaction\n * @extends {BaseInteraction}\n * @implements {InteractionResponses}\n */\nclass ModalSubmitInteraction extends BaseInteraction {\n  constructor(client\x2C data) {\n    super(client\x2C data);\n    /**\n     * The custom id of the modal.\n     * @type {string}\n     */\n    this.customId = data.data.custom_id;\n\n    if ('message' in data) {\n      /**\n       * The message associated with this interaction\n       * @type {?Message}\n       */\n      this.message = this.channel?.messages._add(data.message) ?? new (getMessage())(this.client\x2C data.message);\n    } else {\n      this.message = null;\n    }\n\n    /**\n     * The components within the modal\n     *\n     * @type {Array<ActionRowModalData | LabelModalData | TextDisplayModalData>}\n     */\n    this.components = data.data.components?.map(component =>\n      ModalSubmitInteraction.transformComponent(component\x2C data.data.resolved\x2C {\n        client: this.client\x2C\n        guild: this.guild\x2C\n      })\x2C\n    );\n\n    /**\n     * The fields within the modal\n     * @type {ModalSubmitFields}\n     */\n    this.fields = new ModalSubmitFields(\n      this.components\x2C\n      transformResolved({ client: this.client\x2C guild: this.guild\x2C channel: this.channel }\x2C data.data.resolved)\x2C\n    );\n\n    /**\n     * Whether the reply to this interaction has been deferred\n     * @type {boolean}\n     */\n    this.deferred = false;\n\n    /**\n     * Whether this interaction has already been replied to\n     * @type {boolean}\n     */\n    this.replied = false;\n\n    /**\n     * Whether the reply to this interaction is ephemeral\n     * @type {?boolean}\n     */\n    this.ephemeral = null;\n\n    /**\n     * An associated interaction webhook\x2C can be used to further interact with this interaction\n     * @type {InteractionWebhook}\n     */\n    this.webhook = new InteractionWebhook(this.client\x2C this.applicationId\x2C this.token);\n  }\n\n  /**\n   * Transforms component data to discord.js-compatible data\n   * @param {*} rawComponent The data to transform\n   * @param {APIInteractionDataResolved} [resolved] The resolved data for the interaction\n   * @param {*} [extra] Extra data required for the transformation\n   * @returns {ModalData[]}\n   */\n  static transformComponent(rawComponent\x2C resolved\x2C { client\x2C guild } = {}) {\n    if ('components' in rawComponent) {\n      return {\n        type: rawComponent.type\x2C\n        id: rawComponent.id\x2C\n        components: rawComponent.components.map(component =>\n          this.transformComponent(component\x2C resolved\x2C { client\x2C guild })\x2C\n        )\x2C\n      };\n    }\n\n    if ('component' in rawComponent) {\n      return {\n        type: rawComponent.type\x2C\n        id: rawComponent.id\x2C\n        component: this.transformComponent(rawComponent.component\x2C resolved\x2C { client\x2C guild })\x2C\n      };\n    }\n\n    const data = {\n      type: rawComponent.type\x2C\n      id: rawComponent.id\x2C\n    };\n\n    // Text display components do not have custom ids.\n    if ('custom_id' in rawComponent) data.customId = rawComponent.custom_id;\n\n    if ('value' in rawComponent) data.value = rawComponent.value;\n\n    if (rawComponent.values) {\n      data.values = rawComponent.values;\n\n      /* eslint-disable max-depth */\n      if (resolved) {\n        const { members\x2C users\x2C channels\x2C roles\x2C attachments } = resolved;\n        const valueSet = new Set(rawComponent.values);\n\n        if (users) {\n          data.users = new Collection();\n\n          for (const [id\x2C user] of Object.entries(users)) {\n            if (valueSet.has(id)) {\n              data.users.set(id\x2C client.users._add(user));\n            }\n          }\n        }\n\n        if (channels) {\n          data.channels = new Collection();\n\n          for (const [id\x2C apiChannel] of Object.entries(channels)) {\n            if (valueSet.has(id)) {\n              data.channels.set(id\x2C client.channels._add(apiChannel\x2C guild) ?? apiChannel);\n            }\n          }\n        }\n\n        if (members) {\n          data.members = new Collection();\n\n          for (const [id\x2C member] of Object.entries(members)) {\n            if (valueSet.has(id)) {\n              const user = users?.[id];\n              data.members.set(id\x2C guild?.members._add({ user\x2C ...member }) ?? member);\n            }\n          }\n        }\n\n        if (roles) {\n          data.roles = new Collection();\n\n          for (const [id\x2C role] of Object.entries(roles)) {\n            if (valueSet.has(id)) {\n              data.roles.set(id\x2C guild?.roles._add(role) ?? role);\n            }\n          }\n        }\n\n        if (attachments) {\n          data.attachments = new Collection();\n          for (const [id\x2C attachment] of Object.entries(attachments)) {\n            if (valueSet.has(id)) {\n              data.attachments.set(id\x2C new (getAttachment())(attachment));\n            }\n          }\n        }\n      }\n\n      /* eslint-enable max-depth */\n    }\n\n    return data;\n  }\n\n  /**\n   * Whether this is from a {@link MessageComponentInteraction}.\n   * @returns {boolean}\n   */\n  isFromMessage() {\n    return Boolean(this.message);\n  }\n\n  // These are here only for documentation purposes - they are implemented by InteractionResponses\n  /* eslint-disable no-empty-function */\n  deferReply() {}\n  reply() {}\n  fetchReply() {}\n  editReply() {}\n  deleteReply() {}\n  followUp() {}\n  deferUpdate() {}\n  update() {}\n  sendPremiumRequired() {}\n  launchActivity() {}\n}\n\nInteractionResponses.applyToClass(ModalSubmitInteraction\x2C 'showModal');\n\nmodule.exports = ModalSubmitInteraction;\n
