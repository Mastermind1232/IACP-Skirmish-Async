script-source,288,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/pg-types/lib/builtins.js,/**\n * Following query was used to generate this file:\n\n SELECT json_object_agg(UPPER(PT.typname)\x2C PT.oid::int4 ORDER BY pt.oid)\n FROM pg_type PT\n WHERE typnamespace = (SELECT pgn.oid FROM pg_namespace pgn WHERE nspname = 'pg_catalog') -- Take only builting Postgres types with stable OID (extension types are not guaranted to be stable)\n AND typtype = 'b' -- Only basic types\n AND typelem = 0 -- Ignore aliases\n AND typisdefined -- Ignore undefined types\n */\n\nmodule.exports = {\n    BOOL: 16\x2C\n    BYTEA: 17\x2C\n    CHAR: 18\x2C\n    INT8: 20\x2C\n    INT2: 21\x2C\n    INT4: 23\x2C\n    REGPROC: 24\x2C\n    TEXT: 25\x2C\n    OID: 26\x2C\n    TID: 27\x2C\n    XID: 28\x2C\n    CID: 29\x2C\n    JSON: 114\x2C\n    XML: 142\x2C\n    PG_NODE_TREE: 194\x2C\n    SMGR: 210\x2C\n    PATH: 602\x2C\n    POLYGON: 604\x2C\n    CIDR: 650\x2C\n    FLOAT4: 700\x2C\n    FLOAT8: 701\x2C\n    ABSTIME: 702\x2C\n    RELTIME: 703\x2C\n    TINTERVAL: 704\x2C\n    CIRCLE: 718\x2C\n    MACADDR8: 774\x2C\n    MONEY: 790\x2C\n    MACADDR: 829\x2C\n    INET: 869\x2C\n    ACLITEM: 1033\x2C\n    BPCHAR: 1042\x2C\n    VARCHAR: 1043\x2C\n    DATE: 1082\x2C\n    TIME: 1083\x2C\n    TIMESTAMP: 1114\x2C\n    TIMESTAMPTZ: 1184\x2C\n    INTERVAL: 1186\x2C\n    TIMETZ: 1266\x2C\n    BIT: 1560\x2C\n    VARBIT: 1562\x2C\n    NUMERIC: 1700\x2C\n    REFCURSOR: 1790\x2C\n    REGPROCEDURE: 2202\x2C\n    REGOPER: 2203\x2C\n    REGOPERATOR: 2204\x2C\n    REGCLASS: 2205\x2C\n    REGTYPE: 2206\x2C\n    UUID: 2950\x2C\n    TXID_SNAPSHOT: 2970\x2C\n    PG_LSN: 3220\x2C\n    PG_NDISTINCT: 3361\x2C\n    PG_DEPENDENCIES: 3402\x2C\n    TSVECTOR: 3614\x2C\n    TSQUERY: 3615\x2C\n    GTSVECTOR: 3642\x2C\n    REGCONFIG: 3734\x2C\n    REGDICTIONARY: 3769\x2C\n    JSONB: 3802\x2C\n    REGNAMESPACE: 4089\x2C\n    REGROLE: 4096\n};\n
