script-source,168,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/damage-helpers.js,/**\n * Pure HP math helpers + dcHealthState/dcList sync.\n * No Discord dependency. Used by combat\x2C abilities\x2C handlers.\n */\nimport { getDcMessageIds\x2C getDcList } from './player-helpers.js';\n\n/**\n * Sync healthState from dcHealthState Map to the redundant copy in game.p1/p2DcList.\n * @param {object} game\n * @param {string} msgId\n * @param {number} playerNum - 1 or 2\n * @param {Array} healthState - the full healthState array for this DC\n */\nfunction syncDcList(game\x2C msgId\x2C playerNum\x2C healthState) {\n  const dcIds = getDcMessageIds(game\x2C playerNum);\n  const dcList = getDcList(game\x2C playerNum);\n  const idx = (dcIds || []).indexOf(msgId);\n  if (idx >= 0 && dcList?.[idx]) dcList[idx].healthState = [...healthState];\n}\n\n/**\n * Reduce HP for a figure. Clamps to 0. Syncs dcHealthState + dcList.\n * @param {Map} dcHealthState - external health state Map\n * @param {object} game\n * @param {string} msgId - DC message ID\n * @param {number} figureIndex - 0-based figure index within healthState\n * @param {number} damage - amount to reduce (non-negative)\n * @param {number} playerNum - 1 or 2\n * @returns {{ newHp: number\x2C maxHp: number\x2C prevHp: number\x2C wasDefeated: boolean }}\n */\nexport function reduceHp(dcHealthState\x2C game\x2C msgId\x2C figureIndex\x2C damage\x2C playerNum) {\n  const healthState = dcHealthState.get(msgId);\n  if (!healthState || !Array.isArray(healthState[figureIndex])) {\n    return { newHp: 0\x2C maxHp: 0\x2C prevHp: 0\x2C wasDefeated: false };\n  }\n  const [cur\x2C max] = healthState[figureIndex];\n  const prevHp = cur ?? max ?? 0;\n  const maxHp = max ?? cur ?? 0;\n  const newHp = Math.max(0\x2C prevHp - damage);\n  healthState[figureIndex] = [newHp\x2C maxHp];\n  dcHealthState.set(msgId\x2C healthState);\n  syncDcList(game\x2C msgId\x2C playerNum\x2C healthState);\n\n  // Track actual damage received for tiebreaker scoring\n  const actualDamage = prevHp - newHp;\n  if (actualDamage > 0 && game.totalDamageReceived) {\n    game.totalDamageReceived[playerNum] = (game.totalDamageReceived[playerNum] || 0) + actualDamage;\n  }\n\n  return { newHp\x2C maxHp\x2C prevHp\x2C wasDefeated: newHp <= 0 };\n}\n\n/**\n * Heal HP for a figure. Clamps to max. Syncs dcHealthState + dcList.\n * @param {Map} dcHealthState - external health state Map\n * @param {object} game\n * @param {string} msgId - DC message ID\n * @param {number} figureIndex - 0-based figure index within healthState\n * @param {number} amount - amount to heal (non-negative)\n * @param {number} playerNum - 1 or 2\n * @returns {{ newHp: number\x2C maxHp: number\x2C healed: number }}\n */\nexport function healHp(dcHealthState\x2C game\x2C msgId\x2C figureIndex\x2C amount\x2C playerNum) {\n  const healthState = dcHealthState.get(msgId);\n  if (!healthState || !Array.isArray(healthState[figureIndex])) {\n    return { newHp: 0\x2C maxHp: 0\x2C healed: 0 };\n  }\n  const [cur\x2C max] = healthState[figureIndex];\n  const prevHp = cur ?? max ?? 0;\n  const maxHp = max ?? cur ?? 0;\n  const newHp = Math.min(prevHp + amount\x2C maxHp);\n  const healed = newHp - prevHp;\n  healthState[figureIndex] = [newHp\x2C maxHp];\n  dcHealthState.set(msgId\x2C healthState);\n  syncDcList(game\x2C msgId\x2C playerNum\x2C healthState);\n  return { newHp\x2C maxHp\x2C healed };\n}\n\n/**\n * Heal HP across all figures in a DC\x2C distributing up to totalAmount.\n * Heals figures in order (index 0 first). Syncs dcHealthState + dcList.\n * @param {Map} dcHealthState\n * @param {object} game\n * @param {string} msgId\n * @param {number} totalAmount - total HP to distribute\n * @param {number} playerNum\n * @returns {{ totalRecovered: number\x2C perFigure: Array<{index: number\x2C healed: number\x2C newHp: number}> }}\n */\nexport function healHpDistributed(dcHealthState\x2C game\x2C msgId\x2C totalAmount\x2C playerNum) {\n  const healthState = dcHealthState.get(msgId);\n  if (!healthState) return { totalRecovered: 0\x2C perFigure: [] };\n  let remaining = totalAmount;\n  const perFigure = [];\n  for (let i = 0; i < healthState.length; i++) {\n    if (remaining <= 0) break;\n    if (!Array.isArray(healthState[i])) continue;\n    const [cur\x2C max] = healthState[i];\n    const prevHp = cur ?? max ?? 0;\n    const maxHp = max ?? cur ?? 0;\n    const damage = maxHp - prevHp;\n    if (damage <= 0) continue;\n    const heal = Math.min(remaining\x2C damage);\n    healthState[i] = [prevHp + heal\x2C maxHp];\n    remaining -= heal;\n    perFigure.push({ index: i\x2C healed: heal\x2C newHp: prevHp + heal });\n  }\n  if (perFigure.length > 0) {\n    dcHealthState.set(msgId\x2C healthState);\n    syncDcList(game\x2C msgId\x2C playerNum\x2C healthState);\n  }\n  return { totalRecovered: totalAmount - remaining\x2C perFigure };\n}\n
