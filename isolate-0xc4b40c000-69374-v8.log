code-creation,Eval,9,579350,0x71b1371da30,5, /Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/discord.js/src/structures/GuildOnboarding.js:1:1,0x228cecf28550,~
script-source,674,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/discord.js/src/structures/GuildOnboarding.js,'use strict';\n\nconst { Collection } = require('@discordjs/collection');\nconst Base = require('./Base');\nconst { GuildOnboardingPrompt } = require('./GuildOnboardingPrompt');\n\n/**\n * Represents the onboarding data of a guild.\n * @extends {Base}\n */\nclass GuildOnboarding extends Base {\n  constructor(client\x2C data) {\n    super(client);\n\n    /**\n     * The id of the guild this onboarding data is for\n     * @type {Snowflake}\n     */\n    this.guildId = data.guild_id;\n\n    const guild = this.guild;\n\n    /**\n     * The prompts shown during onboarding and in customize community\n     * @type {Collection<Snowflake\x2C GuildOnboardingPrompt>}\n     */\n    this.prompts = data.prompts.reduce(\n      (prompts\x2C prompt) => prompts.set(prompt.id\x2C new GuildOnboardingPrompt(client\x2C prompt\x2C this.guildId))\x2C\n      new Collection()\x2C\n    );\n\n    /**\n     * The ids of the channels that new members get opted into automatically\n     * @type {Collection<Snowflake\x2C GuildChannel>}\n     */\n    this.defaultChannels = data.default_channel_ids.reduce(\n      (channels\x2C channelId) => channels.set(channelId\x2C guild.channels.cache.get(channelId))\x2C\n      new Collection()\x2C\n    );\n\n    /**\n     * Whether onboarding is enabled\n     * @type {boolean}\n     */\n    this.enabled = data.enabled;\n\n    /**\n     * The mode of this onboarding\n     * @type {GuildOnboardingMode}\n     */\n    this.mode = data.mode;\n  }\n\n  /**\n   * The guild this onboarding is from\n   * @type {Guild}\n   * @readonly\n   */\n  get guild() {\n    return this.client.guilds.cache.get(this.guildId);\n  }\n}\n\nexports.GuildOnboarding = GuildOnboarding;\n
