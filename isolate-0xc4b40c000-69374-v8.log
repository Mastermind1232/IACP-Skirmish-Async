* @returns {string|null}\n */\nexport function getHandlerGroup(handlerKey) {\n  return HANDLER_GROUPS.get(handlerKey) ?? null;\n}\n\nexport { handleLobbyJoin\x2C handleLobbyStart } from './lobby.js';\nexport { handleRequestResolve\x2C handleRequestReject } from './requests.js';\nexport {\n  handleRefreshMap\x2C\n  handleRefreshAll\x2C\n  handleUndo\x2C\n  handleKillGame\x2C\n  handleDefaultDeck\x2C\n} from './game-tools.js';\nexport { handleSpecialDone } from './special.js';\nexport { handleInteractCancel\x2C handleInteractChoice } from './interact.js';\nexport { handleEndEndOfRound\x2C handleEndStartOfRound\x2C handleSorMissionReveal\x2C runStartOfRoundDcEffects\x2C runStartOfRoundContinuation\x2C runStatusPhaseAfterEndOfRound\x2C handleExtraArmorPick\x2C handleExtraArmorConfirm\x2C handleExtraArmorCancel\x2C handleRbfDiscard\x2C handleRogueOneReturn\x2C handleImpCitadel\x2C handleProgrammingOverride\x2C handleCtfPick\x2C handleCtfStrain\x2C handleDoubtFigPick\x2C handleDoubtRemove\x2C resolveStartOfRoundEffect } from './round.js';\nexport {\n  runPostDeployPhase\x2C advancePostDeployQueue\x2C onPostDeployMovementComplete\x2C onExtraArmorComplete\x2C\n  cleanupCompanionEmbedDeps\x2C\n  handlePostDeployPick\x2C handleSecurityDetailPick\x2C handleStrikeTeamAdjPick\x2C\n  handleStrikeTeamOrderPick\x2C handleStrikeTeamTokenPick\x2C handleStrikeTeamTokenDone\x2C\n  handlePostDeployMoveSkip\x2C handlePostDeployMoveStay\x2C handleSmoothLandingPick\x2C\n  handleWalkerMove\x2C handleWalkerSkip\x2C\n  handleArmsDistFigPick\x2C handleArmsDistTokenPick\x2C\n  handleCompanionDeployPick\x2C\n} from './post-deploy.js';\nexport { handleMoveMp\x2C handleMoveAdjustMp\x2C handleMovePick\x2C handleMoveInterruptPlay\x2C handleMoveInterruptSkip\x2C handleOverwatchInterruptUse\x2C handleOverwatchInterruptSkip } from './movement.js';\nexport { handleAttackTarget\x2C handleCleaveTarget\x2C handleCoverFireBlock\x2C handleCoverFireDiscard\x2C handleGuidanceSystems\x2C handleCombatReady\x2C handleCombatResolveReady\x2C handleCombatRoll\x2C handleCombatSurge\x2C handleCombatReroll\x2C handlePreReroll\x2C handleCombatPassive\x2C handleCombatToken\x2C handlePowerTokenChoice\x2C handlePowerTokenOverflowDiscard\x2C sendPowerTokenOverflowUI\x2C handleSpreadThePainCondPick\x2C handleFigureheadDecision\x2C handleLasatDiePick\x2C handleLasatFacePick\x2C handleFalseOrdersAtkPick\x2C sendRerollUI\x2C proceedAfterRerolls\x2C sendReadyToResolveRolls\x2C handleStrainChoice\x2C handleRogueOneTokenPick\x2C handleCombatGateReady\x2C sendCombatGate } from './combat.js';\nexport { handleStatusPhase\x2C handlePassActivationTurn\x2C handleEndTurn\x2C handleDcEndActivation\x2C handleDcSwitchFig\x2C handleConfirmActivate\x2C handleCancelActivate\x2C handleActPassive\x2C handleFieldTacticsPick\x2C handleForceVisionPick\x2C handleLiaDeployZone\x2C handleHeroicEffortReturn\x2C handleScavWeaponTransfer\x2C handleScFigPick\x2C handleHairTriggerUse\x2C handleHairTriggerSkip } from './activation.js';\nexport {\n  handleMapSelection\x2C\n  handleMapTypeChoice\x2C\n  handleMapSelectionDraw\x2C\n  handleMapSelectionPick\x2C\n  handleDraftRandom\x2C\n  handleDetermineInitiative\x2C\n  handleDeploymentZone\x2C\n  handleDeploymentFig\x2C\n  handleDeploymentOrient\x2C\n  handleDeployPick\x2C\n  handleDeployRow\x2C\n  handleDeployRowBack\x2C\n  handleLoadoutSelect\x2C\n  handleLoadoutConfirm\x2C\n  handleFormPick\x2C\n  handleDeploymentDone\x2C\n  handleAutoDeploy\x2C\n  handleMapConfirm\x2C\n  handleMapGoBack\x2C\n  handleSetupAttachTo\x2C\n  handleAttachConfirm\x2C\n  handleAttachReselect\x2C\n  handleAttachDoneConfirm\x2C\n  handleAttachDoneRedo\x2C\n  startDeploymentAfterAttachments\x2C\n} from './setup.js';\nexport {\n  handleBlitzGroupSelect\x2C\n  handleBlitzPass\x2C\n  handleBlitzMoveFig\x2C\n  handleBlitzMovePick\x2C\n  handleBlitzMoveDone\x2C\n} from './blitz-deploy.js';\nexport {\n  handleDcActivate\x2C\n  handleDcUnactivate\x2C\n  handleDcToggle\x2C\n  handleDcDeplete\x2C\n  handleDcRename\x2C\n  handleDcRemoveStun\x2C\n  handleDcCcSpecial\x2C\n  handleDcCcEndOfActivation\x2C\n  handleDcCcDoubleAction\x2C\n  handleDcAction\x2C\n  handlePounceSpacePick\x2C\n  handleDcAbilityChoice\x2C\n  handleArsenalPick\x2C\n  handleEe3DiePick\x2C\n  handleBoRiflePick\x2C\n  handleFalseOrdersAction\x2C\n  handleFalseOrdersMovePick\x2C\n  handleOrderMove\x2C\n  handleOrderMoveSpacePick\x2C\n  handleRushPushFig\x2C\n  handleRushPushSpace\x2C\n  handleRushPushSkip\x2C\n  handleShoulderRushFig\x2C\n  handleShoulderRushSpace\x2C\n  handleShoulderRushSkip\x2C\n  handleOverwatchSpacePick\x2C\n  handleOrbitalBombardmentDeplete\x2C\n  handleOrbitalBombardmentSkip\x2C\n  handleOrbitalBombardmentSpacePick\x2C\n  handleBombDropSpacePick\x2C\n} from './dc-play-area.js';\nexport {\n  handleSquadModal\x2C\n  handleDeployModal\x2C\n  handleCcAttachTo\x2C\n  handleCcPlaySelect\x2C\n  handleCcConfirmPlay\x2C\n  handleCcCancelPlay\x2C\n  handleCcDiscardSelect\x2C\n  handleSquadConfirm\x2C\n  handleSquadCancel\x2C\n  handleDeckIllegalPlay\x2C\n  handleDeckIllegalRedo\x2C\n  handleCcShuffleDraw\x2C\n  handleIKnowEverythingKeep\x2C\n  handleCcPlay\x2C\n  handleCcDraw\x2C\n  handleCcSearchDiscard\x2C\n  handleCcCloseDiscard\x2C\n  handleCcDiscard\x2C\n  handleCcChoice\x2C\n  handleSquadSelect\x2C\n  handleIllegalCcIgnore\x2C\n  handleIllegalCcUnplay\x2C\n  handleNegationPlay\x2C\n  handleNegationLetResolve\x2C\n  handleCelebrationPlay\x2C\n  handleCelebrationPass\x2C\n  handleCcSpacePick\x2C\n} from './cc-hand.js';\nexport {\n  handleBotmenuKill\x2C\n  handleBotmenuKillYes\x2C\n  handleBotmenuKillNo\x2C\n  handleForfeit\x2C\n  handleForfeitYes\x2C\n  handleForfeitNo\x2C\n} from './botmenu.js';\nexport { handleBotmenuRecover\x2C runRecovery } from './recover.js';\nexport { handlePhaseGateReady\x2C handlePhaseGateUnready\x2C sendPhaseGateMessages } from './phase-gate.js';\nexport { getWaitingPlayers } from '../game/phase-gate.js';\nexport { handleFastForward\x2C handleDefenderCcPlay } from './fast-forward.js';\nexport { handleToughLuck\x2C handleThereIsNoTry\x2C handleVetInstincts\x2C handleHunterProtocol\x2C handleStrikeMeDown\x2C handleSlowOnTheDraw\x2C handleSlowOnTheDrawResume\x2C handlePowerConverter\x2C handleIllicitArms\x2C handleDoubtReroll } from './combat-reactions.js';\nexport { handleReactionSkip\x2C handleReactionUse\x2C handleRightBack\x2C handleMasteryPick\x2C handleInterrogatePick } from './post-combat.js';\nexport { handleStillFaster\x2C handleSquadSwarm\x2C handleOverdrive\x2C handleSelfDestructProbe\x2C handleSelfDestructProtocol\x2C handleLastResort\x2C handleScavengedWalker\x2C handleOnDiplomatic\x2C handleBelReorder\x2C handleAssassinsBladePickTarget\x2C handleSuppressiveFireMpPick\x2C handleForceSlowPick\x2C handleExcavationPick\x2C handleYHSIW\x2C handleSubmitOrFight\x2C handleDrivenByHatred\x2C handleBlackMarket\x2C handlePunishingStrike\x2C handleExecutor\x2C handleExtraProtection } from './interrupts.js';\nexport { handleDevaronDoorOpen\x2C handleDevaronCratePush\x2C handleKryknaPush\x2C handleKryknaPlace\x2C handleKryknaPlaceSkip\x2C handleKryknaPlacePick\x2C handleFluctuationSwap\x2C handleFluctuationSkip } from './map-events.js';\nexport { buildFavoritesListPayload\x2C handleFavNameModal\x2C handleFavRenameModal\x2C handleFavListRenameModal } from './favorites.js';\nexport {\n  handleBleedResolve\x2C\n  handleSidewinderApply\x2C handleSidewinderSkip\x2C\n  handleBoltslingerTarget\x2C handleBoltslingerSkip\x2C\n  handleIndiscriminateFireDie\x2C handleIndiscriminateFireSkip\x2C\n  handleFightingKnifeTarget\x2C handleFightingKnifeSkip\x2C\n  handleConcussiveBoltPush\x2C handleConcussiveBoltSkip\x2C\n  handleSpreadThePainFigPick\x2C handleSpreadThePainSkip\x2C\n  handleMissileSalvoDie\x2C handleMissileSalvoDone\x2C\n  handleHeavyFireUse\x2C handleHeavyFireSkip\x2C\n  handleHeavyFireTarget\x2C handleHeavyFireDone\x2C\n  handleHeavyFireCondition\x2C\n  handleHavocShotUse\x2C handleHavocShotSkip\x2C handleHavocShotPick\x2C handleHavocShotDone\x2C\n  handleDeflectPick\x2C handleDeflectSkip\x2C\n  handleWantonUse\x2C handleWantonCcPick\x2C handleWantonPick\x2C handleWantonDone\x2C handleWantonSkip\x2C\n} from './combat-special-effects.js';\n
