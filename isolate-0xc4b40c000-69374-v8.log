code-creation,Script,9,251771,0x3f05b92929c8,178, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/setup.js:1:1,0x1d6be1708d98,~
script-source,211,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/setup.js,/**\n * Setup handlers: map_selection_\x2C map_type_\x2C draft_random_\x2C determine_initiative_\x2C deployment_zone_red_/blue_\x2C deployment_fig_\x2C deployment_orient_\x2C deploy_pick_\x2C deployment_done_\n * F17: map_type_ buttons (Competitive/Random/Select Draw/Selection)\x2C map_selection_draw_\x2C map_selection_pick_\n */\nimport { ActionRowBuilder\x2C AttachmentBuilder\x2C ButtonBuilder\x2C ButtonStyle\x2C EmbedBuilder\x2C ModalBuilder\x2C StringSelectMenuBuilder\x2C TextInputBuilder\x2C TextInputStyle } from 'discord.js';\nimport { existsSync } from 'fs';\nimport { join\x2C dirname } from 'path';\nimport { fileURLToPath } from 'url';\nimport { getLoadoutCards\x2C getFormCards\x2C getDcEffects\x2C getDcStats\x2C getMapData\x2C getDcKeywords\x2C getRootDir } from '../data-loader.js';\nimport { getDcImagePath } from '../asset-paths.js';\nimport { setPhase\x2C PHASES } from '../game/phase.js';\n\nconst __dirname = dirname(fileURLToPath(import.meta.url));\nconst rootDir = join(__dirname\x2C '..'\x2C '..');\nimport { getConfig\x2C setConfig\x2C getFormsChosenByTeamClawdites } from '../game/figure-config.js';\nimport {\n  getPlayerId\x2C getSquad\x2C getDcList\x2C getDcMessageIds\x2C getHandChannelId\x2C getPlayAreaId\x2C\n  dcAttachmentsKey\x2C ccDeckKey\x2C ccHandKey\x2C\n  deployLabelsKey as _deployLabelsKey\x2C deployMetadataKey as _deployMetadataKey\x2C\n  getInitiativePlayerNum\x2C opponentPlayerNum\x2C\n} from '../game/player-helpers.js';\nimport { dcNameFromFigureKey\x2C isFigurelessDc } from '../game/index.js';\nimport { stripBrackets\x2C cardNameEquals } from '../game/card-names.js';\nimport { discordCatch } from '../error-handling.js';\nimport { requireGame } from '../utils/guards.js';\nimport { resolveStartOfRoundEffect } from './round.js';\nimport { fetchGameChannel\x2C snowflakeUsers } from '../discord/channel-helpers.js';\nimport { chunkButtonsToRows\x2C buildRowPickerButtons } from '../discord/components.js';\nimport { parseCustomId\x2C splitCustomId } from '../discord/custom-id.js';\nimport { _matchesKeywordPhrase } from '../game/validation.js';\nimport { isBlitzMission\x2C initBlitzDeployment\x2C sendBlitzTurnPrompt\x2C checkBlitzGroupComplete } from './blitz-deploy.js';\n\n/** Get blocking terrain info for deployment filtering.\n * When ignoreBlocking is true (Massive/Mobile)\x2C blocking cells are merged into\n * the zone so the footprint zone-membership check passes for cells that are\n * blocking terrain but geographically inside the deployment zone.\n */\nfunction getDeployBlockingInfo(game\x2C dcName) {\n  const ms = getMapData(game.selectedMap?.id);\n  const blocking = ms?.blocking || [];\n  const keywords = getDcKeywords(game)?.[dcName] || [];\n  const kwUpper = keywords.map(k => String(k).toUpperCase());\n  const ignoreBlocking = kwUpper.includes('MOBILE') || kwUpper.includes('MASSIVE');\n  return { blocking\x2C ignoreBlocking };\n}\n\n\n/** Keyword tokens recognized as trait/type restrictions (not DC names). */\nconst RESTRICTION_KEYWORDS = ['LEADER'\x2C 'HUNTER'\x2C 'DROID'\x2C 'CREATURE'\x2C 'TROOPER'\x2C 'VEHICLE'\x2C\n  'SMUGGLER'\x2C 'WOOKIEE'\x2C 'WOOKIE'\x2C 'FORCE USER'\x2C 'HEAVY WEAPON'\x2C 'UNIQUE FIGURE'\x2C\n  'NON-UNIQUE'\x2C 'NON-MASSIVE'\x2C 'BRAWLER'\x2C 'SPY'\x2C 'GUARDIAN'\x2C 'IMPERIAL'\x2C 'REBEL'\x2C\n  'SCUM'\x2C 'FIGURE WITH'\x2C 'FIGURE COST'\x2C 'GROUP WITH'\x2C 'MASSIVE'];\n\n/**\n * Parse the restriction line from an attachment card and return a filter function.\n * Returns { restrictionText\x2C filter: (dcName) => bool } or null if no restriction.\n */\nfunction getAttachmentRestriction(cardName) {\n  const effects = getDcEffects();\n  const card = effects[cardName] || effects[`[${cardName}]`];\n  if (!card) return null;\n  if (!card.abilityText && !(card.keywords?.length > 0)) return null;\n  const firstLine = (card.abilityText || '').split('\\n')[0].trim();\n  const onlyMatch = firstLine.match(/^(.+?)\\s+ONLY$/i);\n  // Fallback: if no "X ONLY" line but card has keywords\x2C use keywords as restriction\n  if (!onlyMatch) {\n    // No "X ONLY" restriction line \u2014 card can attach to any DC\n    // Note: card.keywords are traits the card grants\x2C NOT target restrictions\n    return null;\n  }\n  const restrictionRaw = onlyMatch[1].replace(/"/g\x2C '').trim();\n  const restrictionUpper = restrictionRaw.toUpperCase();\n\n  // Split into OR-alternatives. "4 OR MORE" is a phrase\x2C not an alternative split.\n  // "VEHICLE\x2C DROID\x2C OR HEAVY WEAPON" \u2192 ["VEHICLE"\x2C "DROID"\x2C "HEAVY WEAPON"]\n  // "NON-MASSIVE\x2C NON-UNIQUE" \u2192 treated as single conjunctive phrase (not split)\n  const normalized = restrictionRaw.replace(/(\\d+)\\s+OR\\s+MORE/gi\x2C '$1_OR_MORE');\n  const orParts = normalized.split(/\\s+OR\\s+/i).map(s => s.trim()).filter(Boolean);\n  const alternatives = [];\n  for (const part of orParts) {\n    // If part has commas (e.g. "VEHICLE\x2C DROID")\x2C split further \u2014 unless all parts are NON- (conjunctive)\n    if (part.includes('\x2C') && !part.includes('NON-')) {\n      const subs = part.split(/\x2C\\s*/).map(s => s.trim()).filter(Boolean);\n      alternatives.push(...subs);\n    } else {\n      alternatives.push(part.replace(/_OR_MORE/g\x2C 'OR MORE'));\n    }\n  }\n\n  return {\n    restrictionText: restrictionRaw\x2C\n    filter: (dcName) => {\n      const dcStats = effects[dcName];\n      if (!dcStats) return true; // unknown DC\x2C allow\n      const dcKw = (dcStats.keywords || []).map(k => String(k).toUpperCase());\n      const dcNameUpper = (dcName || '').toUpperCase();\n      const isUnique = !!dcStats.unique;\n      const isElite = !!dcStats.elite;\n      const figureCost = dcStats.cost ?? 0;\n      const figures = dcStats.figures ?? 1;\n      const affiliation = (dcStats.affiliation || '').toUpperCase();\n\n      // Check if DC satisfies ANY alternative\n      return alternatives.some(alt => {\n        const altUpper = alt.toUpperCase().replace(/\\([^)]*\\)/g\x2C '').trim();\n\n        // Handle NON- prefix conditions (conjunctive \u2014 all must be met)\n        if (altUpper.includes('NON-')) {\n          if (altUpper.includes('NON-MASSIVE') && dcKw.includes('MASSIVE')) return false;\n          if (altUpper.includes('NON-UNIQUE') && isUnique) return false;\n          // Check remaining positive keywords after stripping NON- conditions and commas\n          let remaining = altUpper.replace(/NON-MASSIVE/g\x2C '').replace(/NON-UNIQUE/g\x2C '').replace(/\x2C/g\x2C '').trim();\n          if (remaining) {\n            // Extract "GROUP WITH N FIGURES" suffix before keyword matching\n            const grpMatch = remaining.match(/^(.+?)\\s+GROUP\\s+WITH\\s+(\\d+)\\s+FIGURES?$/);\n            if (grpMatch) {\n              const reqFigs = parseInt(grpMatch[2]\x2C 10);\n              if (figures !== reqFigs) return false;\n              remaining = grpMatch[1].trim();\n            }\n            if (remaining && !_matchesKeywordPhrase(remaining\x2C dcKw\x2C affiliation)) return false;\n          }\n          return true;\n        }\n        // "UNIQUE ..." check (e.g. "UNIQUE FIGURE"\x2C "UNIQUE GUARDIAN"\x2C "UNIQUE FIGURE WITH FIGURE COST N OR MORE")\n        if (altUpper.startsWith('UNIQUE ')) {\n          if (!isUnique) return false;\n          if (altUpper === 'UNIQUE FIGURE') return true;\n          const costMatch = altUpper.match(/FIGURE COST (\\d+) OR MORE/);\n          if (costMatch && figureCost < parseInt(costMatch[1]\x2C 10)) return false;\n          if (altUpper.includes('UNIQUE FIGURE')) return true;\n          // "UNIQUE GUARDIAN"\x2C "UNIQUE TROOPER"\x2C etc. \u2014 check keyword after UNIQUE\n          const kwPart = altUpper.replace(/^UNIQUE\\s+/\x2C '').trim();\n          if (kwPart && !_matchesKeywordPhrase(kwPart\x2C dcKw\x2C affiliation)) return false;\n          return true;\n        }\n        // "GROUP WITH N FIGURES" check\n        const groupMatch = altUpper.match(/(.+?)\\s+GROUP WITH (\\d+) FIGURES/);\n        if (groupMatch) {\n          const kwPart = groupMatch[1].trim();\n          const reqFigs = parseInt(groupMatch[2]\x2C 10);\n          if (figures !== reqFigs) return false;\n          if (!_matchesKeywordPhrase(kwPart\x2C dcKw\x2C affiliation)) return false;\n          return true;\n        }\n        // Name-based match first (e.g. "DARTH VADER"\x2C "SHORETROOPER"\x2C "AT-ST")\n        // Checked before keyword match so names containing keywords (e.g. "SHORETROOPER" contains "TROOPER") resolve correctly.\n        if (dcNameUpper.includes(altUpper) || altUpper.includes(dcNameUpper.replace(/\\s*\\(.*\\)$/\x2C ''))) return true;\n        // Simple keyword match: "LEADER"\x2C "HUNTER"\x2C "DROID"\x2C "TROOPER"\x2C compound "IMPERIAL TROOPER"\n        if (RESTRICTION_KEYWORDS.some(k => altUpper.includes(k))) {\n          return _matchesKeywordPhrase(altUpper\x2C dcKw\x2C affiliation);\n        }\n        return false;\n      });\n    }\x2C\n  };\n}\n\n/**\n * Check if an attachment card can auto-attach to exactly 1 eligible DC.\n * Handles both name-based ("Zeb Orrelios ONLY") and keyword-based ("LEADER ONLY") restrictions.\n * Excludes DCs that already have an attachment (CRR p.56: one attachment per DC).\n * @param {string} cardName\n * @param {Array} dcList\n * @param {Array} dcMsgIds\n * @param {Set} [alreadyAttached] - Set of dcMsgIds that already have an attachment\n * @returns {string|null} dcMsgId if exactly 1 match\x2C null otherwise\n */\nexport function findAutoAttachTarget(cardName\x2C dcList\x2C dcMsgIds\x2C alreadyAttached) {\n  const effects = getDcEffects();\n  const card = effects[cardName] || effects[`[${cardName}]`];\n  if (!card?.abilityText) return null;\n  const firstLine = card.abilityText.split('\\n')[0].trim();\n  const onlyMatch = firstLine.match(/^(.+?)\\s+ONLY$/i);\n  if (!onlyMatch) return null;\n  const restriction = onlyMatch[1];\n  // Split on " OR " / " or " and strip quotes/parens\n  const alternatives = restriction\n    .replace(/"/g\x2C '')\n    .split(/\\s+(?:OR|or)\\s+/)\n    .map((s) => s.trim().replace(/\\([^)]*\\)/g\x2C '').trim())\n    .filter(Boolean);\n  // If any alternative is a keyword category\x2C auto-attach if exactly 1 DC qualifies\n  const KEYWORDS = ['LEADER'\x2C 'HUNTER'\x2C 'DROID'\x2C 'CREATURE'\x2C 'TROOPER'\x2C 'VEHICLE'\x2C\n    'SMUGGLER'\x2C 'WOOKIEE'\x2C 'WOOKIE'\x2C 'FORCE USER'\x2C 'HEAVY WEAPON'\x2C 'UNIQUE FIGURE'\x2C\n    'NON-UNIQUE'\x2C 'NON-MASSIVE'\x2C 'BRAWLER'\x2C 'SPY'\x2C 'GUARDIAN'\x2C 'IMPERIAL'\x2C 'REBEL'\x2C\n    'SCUM'\x2C 'FIGURE WITH'\x2C 'FIGURE COST'\x2C 'GROUP WITH'\x2C 'MASSIVE'];\n  const isKeyword = alternatives.some((a) =>\n    KEYWORDS.some((k) => a.toUpperCase().includes(k))\x2C\n  );\n  if (isKeyword) {\n    const kwRestriction = getAttachmentRestriction(cardName);\n    if (kwRestriction) {\n      const kwMatches = [];\n      for (let i = 0; i < dcList.length; i++) {\n        if (alreadyAttached?.has(dcMsgIds[i])) continue;\n        if (isFigurelessDc(dcList[i].dcName)) continue;\n        if (kwRestriction.filter(dcList[i].dcName)) kwMatches.push(dcMsgIds[i]);\n      }\n      return kwMatches.length === 1 ? kwMatches[0] : null;\n    }\n    return null;\n  }\n  // Match alternatives against DC names (case-insensitive)\n  const matches = [];\n  for (let i = 0; i < dcList.length; i++) {\n    if (alreadyAttached?.has(dcMsgIds[i])) continue;\n    if (isFigurelessDc(dcList[i].dcName)) continue;\n    const name = (dcList[i].dcName || '').toLowerCase();\n    for (const alt of alternatives) {\n      if (name.includes(alt.toLowerCase())) {\n        matches.push(dcMsgIds[i]);\n        break;\n      }\n    }\n  }\n  return matches.length === 1 ? matches[0] : null;\n}\n\n/**\n * Apply a setup attachment to a DC (shared by manual picker and auto-attach).\n * Handles special cards (Focused on the Kill health boost\x2C Wookiee Avenger deck search).\n */\nexport async function applySetupAttachment(game\x2C playerNum\x2C card\x2C dcMsgId\x2C ctx) {\n  const { dcHealthState\x2C logGameAction\x2C client\x2C updateAttachmentMessageForDc } = ctx;\n  const attachKey = dcAttachmentsKey(playerNum);\n  game[attachKey] = game[attachKey] || {};\n  if (!Array.isArray(game[attachKey][dcMsgId])) game[attachKey][dcMsgId] = [];\n  game[attachKey][dcMsgId].push(stripBrackets(card));\n\n  // Focused on the Kill (IG-88): +5 Health applied at setup when attached\n  if (cardNameEquals(card\x2C 'Focused on the Kill')) {\n    const dcHS = dcHealthState;\n    const hs = dcHS?.get(dcMsgId);\n    if (hs) {\n      for (let fi = 0; fi < hs.length; fi++) {\n        if (hs[fi]) { hs[fi] = [hs[fi][0] + 5\x2C hs[fi][1] + 5]; }\n      }\n      dcHS.set(dcMsgId\x2C hs);\n      const dcList = getDcList(game\x2C playerNum) || [];\n      const dcMsgIds = getDcMessageIds(game\x2C playerNum) || [];\n      const idx = dcMsgIds.indexOf(dcMsgId);\n      if (idx >= 0 && dcList[idx]) dcList[idx].healthState = [...hs];\n    }\n  }\n  // Wookiee Avenger: search deck for "Debts Repaid"\x2C put into hand\x2C draw 1 fewer in starting hand\n  if (cardNameEquals(card\x2C 'Wookiee Avenger')) {\n    const deckKey = ccDeckKey(playerNum);\n    const handKey = ccHandKey(playerNum);\n    const deck = game[deckKey] || [];\n    const dIdx = deck.indexOf('Debts Repaid');\n    if (dIdx >= 0) {\n      deck.splice(dIdx\x2C 1);\n      game[deckKey] = deck;\n      game[handKey] = [...(game[handKey] || [])\x2C 'Debts Repaid'];\n      game.wookieeAvengerDrawPenalty = (game.wookieeAvengerDrawPenalty || 0) + 1;\n      if (logGameAction) await logGameAction(game\x2C client\x2C '**Wookiee Avenger** \u2014 Searched deck for **Debts Repaid**\x2C added to hand. Will draw 1 fewer starting card.'\x2C { phase: 'SETUP'\x2C icon: 'card' });\n    }\n  }\n\n  // Lie in Ambush: set the attached group aside \u2014 it does NOT deploy during deployment phase\n  if (cardNameEquals(card\x2C 'Lie in Ambush')) {\n    const dcList = getDcList(game\x2C playerNum) || [];\n    const dcMsgIds = getDcMessageIds(game\x2C playerNum) || [];\n    const dcIdx = dcMsgIds.indexOf(dcMsgId);\n    if (dcIdx >= 0 && dcList[dcIdx]) {\n      const dcName = dcList[dcIdx].dcName || dcList[dcIdx].displayName;\n      // Compute dgIndex matching getDeployFigureLabels: count same-name figure DCs up to dcIdx\n      let dgIndex = 0;\n      for (let i = 0; i < dcList.length; i++) {\n        const n = dcList[i]?.dcName || dcList[i]?.displayName;\n        if (!n || isFigurelessDc(n)) continue;\n        if (n === dcName) dgIndex++;\n        if (i === dcIdx) break;\n      }\n      const figures = getDcStats(dcName)?.figures ?? 1;\n      const figureKeys = [];\n      for (let f = 0; f < figures; f++) figureKeys.push(`${dcName}-${dgIndex}-${f}`);\n      game.lieInAmbushSetAside = game.lieInAmbushSetAside || {};\n      game.lieInAmbushSetAside[playerNum] = figureKeys;\n    }\n    if (logGameAction) {\n      const hostName = getDcList(game\x2C playerNum)?.[getDcMessageIds(game\x2C playerNum)?.indexOf(dcMsgId)]?.dcName || 'group';\n      await logGameAction(game\x2C client\x2C `\ud83d\udce6 **Lie in Ambush** \u2014 **${hostName}** set aside\x2C out of play. Will deploy later.`\x2C { phase: 'SETUP'\x2C icon: 'card' });\n    }\n  }\n\n  // Squad Upgrade figures (Z-6 Trooper\x2C Mortar Trooper\x2C Riot Trooper): auto-set nickname for the SU figure\n  const SU_FIGURE_CARDS = ['Z-6 Trooper'\x2C 'Mortar Trooper'\x2C 'Riot Trooper'];\n  if (SU_FIGURE_CARDS.some(c => cardNameEquals(c\x2C card))) {\n    const dcList = getDcList(game\x2C playerNum) || [];\n    const dcMsgIds = getDcMessageIds(game\x2C playerNum) || [];\n    const dcIdx = dcMsgIds.indexOf(dcMsgId);\n    if (dcIdx >= 0 && dcList[dcIdx]) {\n      const dcName = dcList[dcIdx].dcName || dcList[dcIdx].displayName;\n      const totals = {};\n      for (let i = 0; i <= dcIdx; i++) {\n        const n = dcList[i]?.dcName || dcList[i]?.displayName || '';\n        totals[n] = (totals[n] || 0) + 1;\n      }\n      const dgIndex = totals[dcName] || 1;\n      const baseFigCount = getDcStats(dcName)?.figures ?? 1;\n      const suFigKey = `${dcName}-${dgIndex}-${baseFigCount}`;\n      game.figureNicknames = game.figureNicknames || {};\n      game.figureNicknames[suFigKey] = card;\n    }\n  }\n\n  if (updateAttachmentMessageForDc) {\n    try { await updateAttachmentMessageForDc(game\x2C playerNum\x2C dcMsgId\x2C client); }\n    catch (err) { console.error('Failed to update attachment message after setup attach:'\x2C err); }\n  }\n}\n\n/**\n * Build options for mission select menus (Select Draw / Selection). Value format: "mapId:variant".\n * @param {() => { id: string\x2C name: string\x2C imagePath?: string }[]} getPlayReadyMaps\n * @param {() => Record<string\x2C Record<string\x2C { name: string }>>} getMissionCardsData\n * @returns {{ value: string\x2C label: string }[]}\n */\nexport function buildPlayableMissionOptions(getPlayReadyMaps\x2C getMissionCardsData) {\n  const playReadyMaps = getPlayReadyMaps?.() ?? [];\n  const missionCards = getMissionCardsData?.() ?? {};\n  const options = [];\n  for (const map of playReadyMaps) {\n    const variants = missionCards[map.id];\n    if (!variants) continue;\n    for (const variant of ['a'\x2C 'b']) {\n      const mission = variants[variant];\n      if (!mission?.name) continue;\n      const variantUpper = variant.toUpperCase();\n      // Prefix variant letter if not already present in the mission name\n      const missionDisplay = /^[AB][.:)]\\s/i.test(mission.name) ? mission.name : `${variantUpper}: ${mission.name}`;\n      const rawLabel = `${map.name} \u2014 ${missionDisplay}`;\n      const label = rawLabel.length > 100 ? rawLabel.slice(0\x2C 97) + '...' : rawLabel;\n      const rawDesc = (mission.endOfRound || mission.setup || '').replace(/\\n/g\x2C ' ').trim();\n      const description = rawDesc ? (rawDesc.length > 100 ? rawDesc.slice(0\x2C 97) + '...' : rawDesc) : undefined;\n      options.push({ value: `${map.id}:${variant}`\x2C label\x2C description });\n    }\n  }\n  return options;\n}\n\n/**\n * F17: Show Map Selection type buttons (Competitive / Random / Select Draw / Selection).\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C getMapTypeButtons\x2C ...\n */\nexport async function handleMapSelection(interaction\x2C ctx) {\n  const { getGame\x2C getMapTypeButtons } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'map_selection_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (interaction.user.id !== game.player1Id && interaction.user.id !== game.player2Id) {\n    await interaction.followUp({ content: 'Only players in this game can select the map.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (game.mapSelected) {\n    await interaction.followUp({ content: `Map already selected: **${game.selectedMap?.name ?? 'Unknown'}**.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const playReadyMaps = ctx.getPlayReadyMaps?.() ?? [];\n  if (playReadyMaps.length === 0) {\n    await interaction.followUp({\n      content: 'No maps have deployment zones configured yet. Add zone data to `data/deployment-zones.json` for at least one map.'\x2C\n      ephemeral: true\x2C\n    }).catch(discordCatch);\n    return;\n  }\n  const tooltipEmbed = ctx.getMapSelectionTooltipEmbed?.();\n  await interaction.followUp({\n    content: 'Choose how to select the map:'\x2C\n    embeds: tooltipEmbed ? [tooltipEmbed] : []\x2C\n    components: [getMapTypeButtons(gameId)]\x2C\n    ephemeral: false\x2C\n  }).catch(discordCatch);\n}\n\n/**\n * F17: Handle map-type button click (Competitive / Random / Select Draw / Selection).\n * For Competitive/Random: rolls the map internally but does NOT reveal the name.\n * For Select Draw/Selection: shows the mission dropdown.\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C getPlayReadyMaps\x2C getTournamentRotation\x2C getMissionCardsData\x2C getMapRegistry\x2C getMapTypeButtons\x2C getMapConfirmButton\x2C getMissionSelectDrawMenu\x2C getMissionSelectionPickMenu\x2C saveGames\n */\nexport async function handleMapTypeChoice(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    getPlayReadyMaps\x2C\n    getTournamentRotation\x2C\n    getMissionCardsData\x2C\n    getMapRegistry\x2C\n    getMapTypeButtons\x2C\n    getMapConfirmButton\x2C\n    getMissionSelectDrawMenu\x2C\n    getMissionSelectionPickMenu\x2C\n    saveGames\x2C\n  } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  // Parse type and gameId from customId: map_type_{type}_{gameId}\n  const afterPrefix = parseCustomId(interaction.customId\x2C 'map_type_');\n  const types = ['competitive'\x2C 'random'\x2C 'select_draw'\x2C 'selection'];\n  let type = null;\n  let gameId = null;\n  for (const t of types) {\n    if (afterPrefix.startsWith(t + '_')) {\n      type = t;\n      gameId = afterPrefix.slice(t.length + 1);\n      break;\n    }\n  }\n  if (!type || !gameId) {\n    await interaction.followUp({ content: 'Invalid selection.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (game.mapSelected) {\n    await interaction.followUp({ content: 'Map already selected.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  // Clear any previous pending selection when switching types\n  delete game.selectedMap;\n  delete game.selectedMission;\n  game.mapSelectionType = type;\n\n  if (type === 'select_draw' || type === 'selection') {\n    const options = buildPlayableMissionOptions(getPlayReadyMaps\x2C getMissionCardsData);\n    if (type === 'select_draw' && options.length < 2) {\n      await interaction.followUp({ content: 'Need at least 2 playable missions for Select Draw. Use **Random** or **Selection**.'\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n    if (options.length === 0) {\n      await interaction.followUp({ content: 'No playable missions. Add mission data and deployment zones for at least one map.'\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n    const content = type === 'select_draw'\n      ? 'Choose at least 2 missions (we\\'ll pick one at random):'\n      : 'Choose one mission:';\n    const missionMenu = type === 'select_draw'\n      ? getMissionSelectDrawMenu(gameId\x2C options)\n      : getMissionSelectionPickMenu(gameId\x2C options);\n    saveGames();\n    await interaction.editReply({ content\x2C embeds: []\x2C components: [getMapTypeButtons(gameId\x2C type)\x2C missionMenu] }).catch(discordCatch);\n    return;\n  }\n\n  // Competitive or Random \u2014 roll the map internally\n  if (type === 'competitive') {\n    const rotation = getTournamentRotation?.();\n    const missionIds = rotation?.missionIds ?? [];\n    if (missionIds.length === 0) {\n      await interaction.followUp({ content: 'No tournament rotation configured. Use **Random** or add missions to `data/tournament-rotation.json`.'\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n    const playReadyMapIds = new Set((getPlayReadyMaps?.() ?? []).map((m) => m.id));\n    const playableFromRotation = missionIds.filter((id) => playReadyMapIds.has(String(id).split(':')[0]));\n    if (playableFromRotation.length === 0) {\n      await interaction.followUp({ content: 'No playable missions in tournament rotation (maps need deployment zones and map-spaces). Use **Random**.'\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n    const missionId = playableFromRotation[Math.floor(Math.random() * playableFromRotation.length)];\n    const [mapId\x2C variant] = String(missionId).split(':');\n    const mapDef = getMapRegistry?.().find((m) => m.id === mapId);\n    const missionData = getMissionCardsData?.()[mapId]?.[variant || 'a'];\n    if (!mapDef || !missionData) {\n      console.error(`[Competitive] Invalid mission: missionId=${missionId} mapId=${mapId} variant=${variant} mapDef=${!!mapDef} missionData=${!!missionData}`);\n      await interaction.followUp({ content: `Invalid mission in rotation (${mapId}:${variant || 'a'}). Use **Random**.`\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n    game.selectedMap = { id: mapDef.id\x2C name: mapDef.name\x2C imagePath: mapDef.imagePath };\n    game.selectedMission = { variant: variant || 'a'\x2C name: missionData.name\x2C fullName: `${mapDef.name} \u2014 ${missionData.name}`\x2C tokenLabel: missionData.tokenLabel || ''\x2C interactLabel: missionData.interactLabel || ''\x2C mechanics: missionData.mechanics || {} };\n  } else {\n    // Random\n    const playReadyMaps = getPlayReadyMaps();\n    if (playReadyMaps.length === 0) {\n      await interaction.followUp({ content: 'No play-ready maps.'\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n    const map = playReadyMaps[Math.floor(Math.random() * playReadyMaps.length)];\n    game.selectedMap = { id: map.id\x2C name: map.name\x2C imagePath: map.imagePath };\n    const missionCards = getMissionCardsData?.()[map.id];\n    const variants = missionCards ? Object.keys(missionCards) : ['a'];\n    const variant = variants[Math.floor(Math.random() * variants.length)];\n    const missionData = missionCards?.[variant];\n    if (missionData) {\n      game.selectedMission = { variant\x2C name: missionData.name\x2C fullName: `${map.name} \u2014 ${missionData.name}`\x2C tokenLabel: missionData.tokenLabel || ''\x2C interactLabel: missionData.interactLabel || ''\x2C mechanics: missionData.mechanics || {} };\n    }\n  }\n\n  // Show confirmation WITHOUT revealing the map name\n  const typeLabel = type === 'competitive' ? 'Competitive \u2014 Random from tournament rotation' : 'Random \u2014 Random map and mission';\n  saveGames();\n  await interaction.editReply({\n    content: `**${typeLabel}**\\nMap selected. Click **Confirm Selection** to reveal and proceed\x2C or pick a different method.`\x2C\n    embeds: []\x2C\n    components: [getMapTypeButtons(gameId\x2C type)\x2C getMapConfirmButton(gameId)]\x2C\n  }).catch(discordCatch);\n}\n\n/**\n * Shared post-map-selection: post to board\x2C log\x2C update setup message\x2C create play areas + hand threads.\n * @param {object} game\n * @param {import('discord.js').Client} client\n * @param {object} ctx - buildBoardMapPayload\x2C logGameAction\x2C getGeneralSetupButtons\x2C createPlayAreaChannels\x2C createBoardChannel\x2C createHandThreads\x2C getHandTooltipEmbed\x2C getSquadSelectEmbed\x2C getHandSquadButtons\x2C saveGames\n */\nasync function finishMapSelectionAfterChoice(game\x2C client\x2C ctx) {\n  const {\n    buildBoardMapPayload\x2C\n    logGameAction\x2C\n    getGeneralSetupButtons\x2C\n    createPlayAreaChannels\x2C\n    createBoardChannel\x2C\n    createHandThreads\x2C\n    getHandTooltipEmbed\x2C\n    getHandSquadButtons\x2C\n    saveGames\x2C\n  } = ctx;\n  const map = game.selectedMap;\n  const mapName = map?.name ?? 'Map';\n  if (game.generalSetupMessageId) {\n    try {\n      const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n      const setupMsg = await generalChannel.messages.fetch(game.generalSetupMessageId);\n      const _setupRow = getGeneralSetupButtons(game);\n      await setupMsg.edit({ components: _setupRow ? [_setupRow] : [] });\n    } catch (err) {\n      console.error('Failed to remove Map Selection button:'\x2C err);\n    }\n  }\n  try {\n    if (!game.p1PlayAreaId || !game.p2PlayAreaId) {\n      const generalCh = await fetchGameChannel(client\x2C game.generalId);\n      const guild = generalCh.guild;\n      const gameCategory = await guild.channels.fetch(game.gameCategoryId || generalCh.parentId);\n      const prefix = `IA${game.gameId}`;\n      const { p1PlayAreaChannel\x2C p2PlayAreaChannel } = await createPlayAreaChannels(\n        guild\x2C gameCategory\x2C prefix\x2C game.player1Id\x2C game.player2Id\n      );\n      game.p1PlayAreaId = p1PlayAreaChannel.id;\n      game.p2PlayAreaId = p2PlayAreaChannel.id;\n    }\n    // Map Updates channel created AFTER play areas so it appears last in the category\n    if (!game.boardId) {\n      const generalCh = await fetchGameChannel(client\x2C game.generalId);\n      const guild = generalCh.guild;\n      const gameCategory = await guild.channels.fetch(game.gameCategoryId || generalCh.parentId);\n      const prefix = `IA${game.gameId}`;\n      const boardChannel = await createBoardChannel(guild\x2C gameCategory\x2C prefix\x2C game.player1Id\x2C game.player2Id);\n      game.boardId = boardChannel.id;\n      if (map) {\n        try {\n          const payload = await buildBoardMapPayload(game.gameId\x2C map\x2C game);\n          await boardChannel.send(payload);\n        } catch (err) {\n          console.error('Failed to post map to Map Updates channel:'\x2C err);\n        }\n      }\n      // Ping Active Player button is already included in the map update standard row\n    } else if (map) {\n      // Board channel already exists (re-entry); post the map to it\n      try {\n        const boardChannel = await fetchGameChannel(client\x2C game.boardId);\n        const payload = await buildBoardMapPayload(game.gameId\x2C map\x2C game);\n        await boardChannel.send(payload);\n      } catch (err) {\n        console.error('Failed to post map to Map Updates channel:'\x2C err);\n      }\n    }\n    if (!game.p1HandId || !game.p2HandId) {\n      await createHandThreads(client\x2C game);\n    }\n    const p1Hand = await fetchGameChannel(client\x2C game.p1HandId);\n    const p2Hand = await fetchGameChannel(client\x2C game.p2HandId);\n    const p1Id = game.player1Id;\n    const p2Id = game.player2Id;\n    {\n      await p1Hand.send({\n        content: `<@${p1Id}>\x2C this is your hand \u2014 submit your squad below!`\x2C\n        allowedMentions: { users: [p1Id] }\x2C\n        embeds: [getHandTooltipEmbed(game\x2C 1)]\x2C\n        components: [getHandSquadButtons(game.gameId\x2C 1)]\x2C\n      });\n      await p2Hand.send({\n        content: `<@${p2Id}>\x2C this is your hand \u2014 submit your squad below!`\x2C\n        allowedMentions: { users: [p2Id] }\x2C\n        embeds: [getHandTooltipEmbed(game\x2C 2)]\x2C\n        components: [getHandSquadButtons(game.gameId\x2C 2)]\x2C\n      });\n    }\n  } catch (err) {\n    console.error('Failed to create/populate Hand threads:'\x2C err);\n  }\n  saveGames();\n}\n\n/**\n * Resolve a missionId ("mapId:variant") to map + mission and set game.selectedMap / selectedMission.\n * @param {object} game\n * @param {string} missionId - e.g. "mos-eisley-outskirts:a"\n * @param {() => { id: string\x2C name: string\x2C imagePath?: string }[]} getMapRegistry\n * @param {() => Record<string\x2C Record<string\x2C { name: string }>>} getMissionCardsData\n * @returns {boolean} true if resolved\n */\nfunction applyMissionToGame(game\x2C missionId\x2C getMapRegistry\x2C getMissionCardsData) {\n  const [mapId\x2C variant] = String(missionId).split(':');\n  const v = variant || 'a';\n  const mapDef = getMapRegistry?.().find((m) => m.id === mapId);\n  const missionData = getMissionCardsData?.()[mapId]?.[v];\n  if (!mapDef || !missionData) return false;\n  game.selectedMap = { id: mapDef.id\x2C name: mapDef.name\x2C imagePath: mapDef.imagePath };\n  game.selectedMission = { variant: v\x2C name: missionData.name\x2C fullName: `${mapDef.name} \u2014 ${missionData.name}`\x2C tokenLabel: missionData.tokenLabel || ''\x2C interactLabel: missionData.interactLabel || ''\x2C mechanics: missionData.mechanics || {} };\n  return true;\n}\n\n/**\n * F17 Select Draw: user chose multiple missions; pick one at random and finish map selection.\n * @param {import('discord.js').StringSelectMenuInteraction} interaction\n * @param {object} ctx - same as handleMapTypeChoice\n */\nexport async function handleMapSelectionDraw(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    getMapRegistry\x2C\n    getMissionCardsData\x2C\n    postPinnedMissionCardFromGameState\x2C\n    client\x2C\n  } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const gameId = parseCustomId(interaction.customId\x2C 'map_selection_draw_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (game.mapSelected) {\n    await interaction.followUp({ content: 'Map already selected.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const values = interaction.values ?? [];\n  const missionId = values[Math.floor(Math.random() * values.length)];\n  if (!applyMissionToGame(game\x2C missionId\x2C getMapRegistry\x2C getMissionCardsData)) {\n    await interaction.followUp({ content: 'Invalid mission. Try again or use Random.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Show confirmation with type buttons highlighted\n  const { getMapConfirmButton\x2C getMapTypeButtons\x2C getMissionSelectDrawMenu } = ctx;\n  const options = buildPlayableMissionOptions(ctx.getPlayReadyMaps\x2C getMissionCardsData);\n  const confirmLabel = game.selectedMission?.fullName || game.selectedMap?.name || 'Map';\n  const components = [getMapTypeButtons(gameId\x2C 'select_draw')\x2C getMissionSelectDrawMenu(gameId\x2C options)\x2C getMapConfirmButton(gameId)];\n  ctx.saveGames();\n  await interaction.editReply({ content: `Drew: **${confirmLabel}**\\nClick **Confirm Selection** to proceed\x2C or re-draw above.`\x2C components }).catch(discordCatch);\n}\n\n/**\n * F17 Selection: user chose one mission; apply and finish map selection.\n * @param {import('discord.js').StringSelectMenuInteraction} interaction\n * @param {object} ctx - same as handleMapTypeChoice\n */\nexport async function handleMapSelectionPick(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    getMapRegistry\x2C\n    getMissionCardsData\x2C\n    postPinnedMissionCardFromGameState\x2C\n    client\x2C\n  } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const gameId = parseCustomId(interaction.customId\x2C 'map_selection_pick_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (game.mapSelected) {\n    await interaction.followUp({ content: 'Map already selected.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const missionId = interaction.values?.[0];\n  if (!missionId || !applyMissionToGame(game\x2C missionId\x2C getMapRegistry\x2C getMissionCardsData)) {\n    await interaction.followUp({ content: 'Invalid mission. Try again or use Random.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Show confirmation with type buttons highlighted and selected mission visible in dropdown\n  const { getMapConfirmButton\x2C getMapTypeButtons\x2C getMissionSelectionPickMenu } = ctx;\n  const options = buildPlayableMissionOptions(ctx.getPlayReadyMaps\x2C getMissionCardsData);\n  const confirmLabel = game.selectedMission?.fullName || game.selectedMap?.name || 'Map';\n  const components = [getMapTypeButtons(gameId\x2C 'selection')\x2C getMissionSelectionPickMenu(gameId\x2C options\x2C missionId)\x2C getMapConfirmButton(gameId)];\n  ctx.saveGames();\n  await interaction.editReply({ content: `Selected: **${confirmLabel}**\\nClick **Confirm Selection** to proceed\x2C or change your pick above.`\x2C components }).catch(discordCatch);\n}\n\n/**\n * F17 Map Confirm: finalize the pending map selection.\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - same as handleMapTypeChoice\n */\nexport async function handleMapConfirm(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    postMissionCardAfterMapSelection\x2C\n    postPinnedMissionCardFromGameState\x2C\n    client\x2C\n  } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const gameId = parseCustomId(interaction.customId\x2C 'map_confirm_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (game.mapSelected) {\n    await interaction.followUp({ content: 'Map already confirmed.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (!game.selectedMap) {\n    await interaction.followUp({ content: 'No map selected yet. Pick a selection type first.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  game.mapSelected = true;\n  setPhase(game\x2C PHASES.INITIATIVE);\n  delete game.mapSelectionType;\n  // Post mission card\n  if (game.selectedMission) {\n    await postPinnedMissionCardFromGameState(game\x2C client);\n  } else {\n    await postMissionCardAfterMapSelection(game\x2C client\x2C game.selectedMap);\n  }\n  await finishMapSelectionAfterChoice(game\x2C client\x2C ctx);\n  const confirmLabel = game.selectedMission?.fullName || game.selectedMap?.name || 'Map';\n  await interaction.editReply({ content: `\u2705 **${confirmLabel}** confirmed!`\x2C components: [] }).catch(discordCatch);\n}\n\n/**\n * F17 Go Back: clear pending map selection and return to the type buttons.\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C getMapTypeButtons\x2C saveGames\n */\nexport async function handleMapGoBack(interaction\x2C ctx) {\n  const { getGame\x2C getMapTypeButtons\x2C getMapSelectionTooltipEmbed } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const gameId = parseCustomId(interaction.customId\x2C 'map_goback_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (game.mapSelected) {\n    await interaction.followUp({ content: 'Map already confirmed.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Clear pending selection\n  delete game.selectedMap;\n  delete game.selectedMission;\n  delete game.mapSelectionType;\n  ctx.saveGames();\n  const tooltipEmbed = getMapSelectionTooltipEmbed?.();\n  await interaction.editReply({\n    content: 'Choose how to select the map:'\x2C\n    embeds: tooltipEmbed ? [tooltipEmbed] : []\x2C\n    components: [getMapTypeButtons(gameId)]\x2C\n  }).catch(discordCatch);\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C runDraftRandom\x2C getGeneralSetupButtons\x2C logGameErrorToBotLogs\x2C extractGameIdFromInteraction\x2C client\x2C saveGames\n */\nexport async function handleDraftRandom(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    runDraftRandom\x2C\n    getGeneralSetupButtons\x2C\n    logGameErrorToBotLogs\x2C\n    extractGameIdFromInteraction\x2C\n    client\x2C\n    saveGames\x2C\n  } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'draft_random_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (interaction.user.id !== game.player1Id && interaction.user.id !== game.player2Id) {\n    await interaction.followUp({ content: 'Only players in this game can use Draft Random.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (game.draftRandomUsed || game.currentRound || game.initiativeDetermined || game.deploymentZoneChosen) {\n    await interaction.followUp({ content: 'Draft Random is only available at game setup.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  try {\n    await runDraftRandom(game\x2C client);\n    game.draftRandomUsed = true;\n    if (game.generalSetupMessageId) {\n      try {\n        const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n        const setupMsg = await generalChannel.messages.fetch(game.generalSetupMessageId);\n        const _setupRow = getGeneralSetupButtons(game);\n      await setupMsg.edit({ components: _setupRow ? [_setupRow] : [] });\n      } catch (err) {\n        console.error('Failed to update setup buttons after Draft Random:'\x2C err);\n      }\n    }\n    saveGames();\n  } catch (err) {\n    console.error('Draft Random error:'\x2C err);\n    await logGameErrorToBotLogs(interaction.client\x2C interaction.guild\x2C extractGameIdFromInteraction(interaction)\x2C err\x2C 'draft_random');\n    await interaction.followUp({ content: `Draft Random failed: ${err.message}`\x2C ephemeral: true }).catch(discordCatch);\n  }\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C clearPreGameSetup\x2C logGameAction\x2C getDeploymentZoneButtons\x2C client\x2C saveGames\n */\nexport async function handleDetermineInitiative(interaction\x2C ctx) {\n  const { getGame\x2C clearPreGameSetup\x2C logGameAction\x2C getDeploymentZoneButtons\x2C client\x2C saveGames } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'determine_initiative_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (interaction.user.id !== game.player1Id && interaction.user.id !== game.player2Id) {\n    await interaction.followUp({ content: 'Only players in this game can determine initiative.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (game.initiativeDetermined) {\n    await interaction.followUp({ content: 'Initiative was already determined.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const missing = [];\n  if (!game.player1Squad) missing.push(`<@${game.player1Id}> (Player 1)`);\n  if (!game.player2Squad) missing.push(`<@${game.player2Id}> (Player 2)`);\n  if (missing.length > 0) {\n    await interaction.followUp({ content: 'Both players must select their squads before initiative can be determined.'\x2C ephemeral: true }).catch(discordCatch);\n    const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n    if (generalChannel) {\n      await generalChannel.send({\n        content: `\u26a0\ufe0f **Initiative blocked** \u2014 Squad selection required first.\\n\\nStill needed: ${missing.join('\x2C ')}`\x2C\n        allowedMentions: { users: snowflakeUsers([...new Set([game.player1Id\x2C game.player2Id])]) }\x2C\n      }).catch(discordCatch);\n    }\n    return;\n  }\n  // G82/M75: Devious Scheme \u2014 check before initiative\n  const hasDcInSquad = (squad\x2C dcName) => (squad?.dcList || []).some(n => {\n    const resolved = typeof n === 'string' ? n.replace(/^\\[|\\]$/g\x2C '') : n;\n    return resolved === dcName || `[${resolved}]` === dcName || resolved === dcName.replace(/^\\[|\\]$/g\x2C '');\n  });\n  const p1HasDS = hasDcInSquad(game.player1Squad\x2C '[Devious Scheme]');\n  const p2HasDS = hasDcInSquad(game.player2Squad\x2C '[Devious Scheme]');\n\n  let winner;\n  let zoneChooser; // who picks deployment zone (normally = initiative winner)\n\n  if (p1HasDS && p2HasDS) {\n    // Both have Devious Scheme \u2014 cards cancel\x2C normal initiative rules\n  } else if (p1HasDS) {\n    // P1 has DS: P2 gets initiative\x2C P1 chooses zone\n    winner = game.player2Id;\n    zoneChooser = game.player1Id;\n  } else if (p2HasDS) {\n    // P2 has DS: P1 gets initiative\x2C P2 chooses zone\n    winner = game.player1Id;\n    zoneChooser = game.player2Id;\n  }\n\n  // Initiative is always determined by random roll\n  if (!winner) {\n    winner = Math.random() < 0.5 ? game.player1Id : game.player2Id;\n  }\n\n  const playerNum = winner === game.player1Id ? 1 : 2;\n  game.initiativePlayerId = winner;\n  game.initiativeDetermined = true;\n  setPhase(game\x2C PHASES.ZONE_SELECTION);\n  // Store zone chooser if different from initiative winner (Devious Scheme)\n  if (zoneChooser && zoneChooser !== winner) {\n    game.deviousSchemeZoneChooser = zoneChooser;\n  }\n  await clearPreGameSetup(game\x2C client);\n\n  if (zoneChooser && zoneChooser !== winner) {\n    // Devious Scheme: split message \u2014 opponent gets initiative\x2C DS player picks zone\n    const dsPlayerNum = zoneChooser === game.player1Id ? 1 : 2;\n    await logGameAction(game\x2C client\x2C `\ud83c\udccf **Devious Scheme** \u2014 <@${zoneChooser}> (Player ${dsPlayerNum}) chooses deployment zone. <@${winner}> (Player ${playerNum}) has initiative and deploys first.`\x2C { allowedMentions: { users: [zoneChooser\x2C winner] }\x2C phase: 'INITIATIVE'\x2C icon: 'initiative' });\n    if (p1HasDS && p2HasDS) {\n      await logGameAction(game\x2C client\x2C `Both players have **[Devious Scheme]** \u2014 cards cancel each other. Normal initiative rules apply.`\x2C { phase: 'INITIATIVE'\x2C icon: 'initiative' });\n    }\n    const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n    const zoneMsg = await generalChannel.send({\n      content: `<@${zoneChooser}> (**Player ${dsPlayerNum}**) \u2014 Pick your deployment zone (Devious Scheme):`\x2C\n      allowedMentions: { users: [zoneChooser] }\x2C\n      components: [getDeploymentZoneButtons(gameId)]\x2C\n    });\n    game.deploymentZoneMessageId = zoneMsg.id;\n  } else {\n    await logGameAction(game\x2C client\x2C `<@${winner}> (**Player ${playerNum}**) won initiative (random roll)! Choose your deployment zone.`\x2C { allowedMentions: { users: [winner] }\x2C phase: 'INITIATIVE'\x2C icon: 'initiative' });\n    const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n    const zoneMsg = await generalChannel.send({\n      content: `<@${winner}> (**Player ${playerNum}**) \u2014 Pick your deployment zone:`\x2C\n      allowedMentions: { users: [winner] }\x2C\n      components: [getDeploymentZoneButtons(gameId)]\x2C\n    });\n    game.deploymentZoneMessageId = zoneMsg.id;\n  }\n  saveGames();\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C logGameAction\x2C getDeployFigureLabels\x2C getDeployButtonRows\x2C getDeploymentMapAttachment\x2C client\x2C saveGames\n */\nexport async function handleDeploymentZone(interaction\x2C ctx) {\n  const { getGame\x2C logGameAction\x2C getDeployFigureLabels\x2C getDeployButtonRows\x2C getDeploymentMapAttachment\x2C pushUndo\x2C getDeploymentZoneButtons\x2C client\x2C saveGames } = ctx;\n  const isRed = interaction.customId.startsWith('deployment_zone_red_');\n  const gameId = parseCustomId(interaction.customId\x2C isRed ? 'deployment_zone_red_' : 'deployment_zone_blue_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  // Devious Scheme: zone chooser may differ from initiative player\n  const zoneChooserId = game.deviousSchemeZoneChooser || game.initiativePlayerId;\n  if (interaction.user.id !== zoneChooserId) {\n    await interaction.followUp({ content: 'Only the designated player can choose the deployment zone.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (game.deploymentZoneChosen) {\n    await interaction.followUp({ content: `Deployment zone already chosen: **${game.deploymentZoneChosen}**.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Push undo snapshot before mutation\n  pushUndo(game\x2C { type: 'deployment_zone'\x2C label: 'Deployment zone selection'\x2C gameId });\n  const zone = isRed ? 'red' : 'blue';\n  const otherZone = zone === 'red' ? 'blue' : 'red';\n  game.deploymentZoneChosen = zone;\n  setPhase(game\x2C PHASES.DEPLOYMENT);\n  // Assign zones based on who chose (DS player or initiative player)\n  const zoneChooserPlayerNum = zoneChooserId === game.player1Id ? 1 : 2;\n  game[`player${zoneChooserPlayerNum}DeploymentZone`] = zone;\n  game[`player${zoneChooserPlayerNum === 1 ? 2 : 1}DeploymentZone`] = otherZone;\n  const zoneLabel = `[${zone.toUpperCase()}] `;\n  await logGameAction(game\x2C client\x2C `<@${zoneChooserId}> (${zoneLabel}**Player ${zoneChooserPlayerNum}**) chose the **${zone}** deployment zone`\x2C { allowedMentions: { users: [zoneChooserId] }\x2C phase: 'INITIATIVE'\x2C icon: 'zone' });\n  if (game.deploymentZoneMessageId) {\n    try {\n      const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n      const zoneMsg = await generalChannel.messages.fetch(game.deploymentZoneMessageId);\n      await zoneMsg.edit({ content: `~~Pick your deployment zone~~ \u2014 **${zone}** chosen.`\x2C components: [] });\n    } catch (err) {\n      console.error('Failed to remove deployment zone buttons:'\x2C err);\n    }\n  }\n  // Check for setup attachments BEFORE deployment (rules: attachments placed first)\n  const { isDcAttachment\x2C resolveDcName } = ctx;\n  const p1DcListRaw = game.player1Squad?.dcList || [];\n  const p2DcListRaw = game.player2Squad?.dcList || [];\n  const p1SetupAttachments = isDcAttachment ? p1DcListRaw.filter((entry) => isDcAttachment(resolveDcName(entry))) : [];\n  const p2SetupAttachments = isDcAttachment ? p2DcListRaw.filter((entry) => isDcAttachment(resolveDcName(entry))) : [];\n\n  if (p1SetupAttachments.length > 0 || p2SetupAttachments.length > 0) {\n    // Attachments exist \u2014 start attachment phase before deployment\n    game.setupAttachmentPhase = true;\n    setPhase(game\x2C PHASES.ATTACHMENT);\n    game.setupAttachmentPending = {\n      1: p1SetupAttachments.map((e) => resolveDcName(e))\x2C\n      2: p2SetupAttachments.map((e) => resolveDcName(e))\x2C\n    };\n    game.setupAttachmentOriginal = {\n      1: [...game.setupAttachmentPending[1]]\x2C\n      2: [...game.setupAttachmentPending[2]]\x2C\n    };\n    game.setupAttachmentApplied = { 1: []\x2C 2: [] };\n    const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n    await generalChannel.send({\n      content: '**Deployment zones chosen.** Place your Skirmish Upgrade card(s) on your Deployment cards (see the **Your Hand** thread in your Play Area). Deployment will begin after upgrades are placed.'\x2C\n    });\n\n    const { dcMessageMeta } = ctx;\n    for (const pn of [1\x2C 2]) {\n      const pending = game.setupAttachmentPending[pn];\n      if (pending.length === 0) {\n        game.setupAttachmentConfirmed = game.setupAttachmentConfirmed || {};\n        game.setupAttachmentConfirmed[pn] = true;\n        continue;\n      }\n      // Auto-attach character-specific attachments\n      const dcList = getDcList(game\x2C pn) || [];\n      const dcMsgIds = getDcMessageIds(game\x2C pn) || [];\n      const attached = new Set((game.setupAttachmentApplied?.[pn] || []).map(a => a.dcMsgId));\n      while (pending.length > 0) {\n        const autoTarget = findAutoAttachTarget(pending[0]\x2C dcList\x2C dcMsgIds\x2C attached);\n        if (!autoTarget) break;\n        const card = pending[0];\n        await applySetupAttachment(game\x2C pn\x2C card\x2C autoTarget\x2C ctx);\n        pending.shift();\n        game.setupAttachmentApplied[pn].push({ card\x2C dcMsgId: autoTarget });\n        attached.add(autoTarget);\n        await logGameAction(game\x2C client\x2C `**${card}** auto-attached to **${dcMessageMeta?.get(autoTarget)?.displayName || 'DC'}** (setup).`\x2C { phase: 'SETUP'\x2C icon: 'card' });\n      }\n      if (pending.length === 0) {\n        await _sendAttachDonePrompt(game\x2C gameId\x2C pn\x2C client);\n        continue;\n      }\n      await _sendAttachmentDropdown(game\x2C gameId\x2C pn\x2C pending[0]\x2C client);\n    }\n    saveGames();\n    return;\n  }\n\n  // No attachments \u2014 proceed directly to deployment\n  // Blitz (Lothal-Wastes-A): special alternating deployment with post-deploy movement\n  if (isBlitzMission(game)) {\n    initBlitzDeployment(game);\n    await sendBlitzTurnPrompt(game\x2C game.blitzDeployment.currentPlayerNum\x2C ctx);\n    saveGames();\n    return;\n  }\n  await _sendInitiativeDeployButtons(game\x2C gameId\x2C ctx);\n  // Store deploy message IDs in the undo entry so they can be cleaned up on undo\n  const undoEntry = game.undoStack?.[game.undoStack.length - 1];\n  if (undoEntry && undoEntry.type === 'deployment_zone') {\n    undoEntry.deployMessageIds = game.initiativeDeployMessageIds || [];\n    undoEntry.deployHandChannelId = game.initiativePlayerId === game.player1Id ? game.p1HandId : game.p2HandId;\n  }\n  saveGames();\n}\n\n/**\n * Send deploy buttons to the initiative player. Extracted so it can be called\n * from both zone selection (no attachments) and post-attachment completion.\n */\nasync function _sendInitiativeDeployButtons(game\x2C gameId\x2C ctx) {\n  const { getDeployFigureLabels\x2C getDeployButtonRows\x2C getDeploymentMapAttachment\x2C client\x2C saveGames } = ctx;\n  const zone = game.deploymentZoneChosen;\n  setPhase(game\x2C PHASES.DEPLOYMENT);\n  const initiativePlayerNum = getInitiativePlayerNum(game);\n  const initiativeHandId = game.initiativePlayerId === game.player1Id ? game.p1HandId : game.p2HandId;\n  const initiativeSquad = getSquad(game\x2C initiativePlayerNum);\n  const initiativeDcList = initiativeSquad?.dcList || [];\n  const { labels: initiativeLabels\x2C metadata: initiativeMetadata } = getDeployFigureLabels(initiativeDcList\x2C game);\n  const deployLabelsKey = _deployLabelsKey(initiativePlayerNum);\n  const deployMetadataKey = _deployMetadataKey(initiativePlayerNum);\n  game[deployLabelsKey] = initiativeLabels;\n  game[deployMetadataKey] = initiativeMetadata;\n  if (!game.figurePositions) game.figurePositions = { 1: {}\x2C 2: {} };\n  try {\n    const initiativeHandChannel = await fetchGameChannel(client\x2C initiativeHandId);\n    const { deployRows\x2C doneRow } = getDeployButtonRows(gameId\x2C initiativePlayerNum\x2C initiativeDcList\x2C zone\x2C game.figurePositions\x2C game);\n    const DEPLOY_ROWS_PER_MSG = 4;\n    game.initiativeDeployMessageIds = game.initiativeDeployMessageIds || [];\n    const initiativePing = `<@${game.initiativePlayerId}>`;\n    const initMapAttachment = await getDeploymentMapAttachment(game\x2C zone);\n    if (deployRows.length === 0) {\n      const payload = {\n        content: `${initiativePing} \u2014 You chose the **${zone}** zone. When finished\x2C click **Deployment Completed** below.`\x2C\n        components: [doneRow]\x2C\n        allowedMentions: { users: [game.initiativePlayerId] }\x2C\n      };\n      if (initMapAttachment) payload.files = [initMapAttachment];\n      const msg = await initiativeHandChannel.send(payload);\n      game.initiativeDeployMessageIds = [msg.id];\n    } else {\n      for (let i = 0; i < deployRows.length; i += DEPLOY_ROWS_PER_MSG) {\n        const chunk = deployRows.slice(i\x2C i + DEPLOY_ROWS_PER_MSG);\n        const isLastChunk = i + DEPLOY_ROWS_PER_MSG >= deployRows.length;\n        const components = isLastChunk ? [...chunk\x2C doneRow] : chunk;\n        const payload = {\n          content: i === 0 ? `${initiativePing} \u2014 You chose the **${zone}** zone. Deploy each figure below (one per row)\x2C then click **Deployment Completed** when finished.` : null\x2C\n          components\x2C\n          allowedMentions: { users: [game.initiativePlayerId] }\x2C\n        };\n        if (i === 0 && initMapAttachment) payload.files = [initMapAttachment];\n        const msg = await initiativeHandChannel.send(payload);\n        game.initiativeDeployMessageIds.push(msg.id);\n      }\n    }\n    game.initiativeDeployMessageId = game.initiativeDeployMessageIds[game.initiativeDeployMessageIds.length - 1];\n  } catch (err) {\n    console.error('Failed to send deploy prompt to initiative player:'\x2C err);\n  }\n}\n\n/**\n * Start deployment phase after attachments are complete. Called from finishSetupAttachments.\n * Exported so it can be passed via ctx.\n */\nexport async function startDeploymentAfterAttachments(game\x2C client\x2C ctx) {\n  const gameId = game.gameId;\n  // Blitz: use alternating deployment instead of standard sequential\n  if (isBlitzMission(game)) {\n    initBlitzDeployment(game);\n    await sendBlitzTurnPrompt(game\x2C game.blitzDeployment.currentPlayerNum\x2C ctx);\n    ctx.saveGames();\n    return;\n  }\n  await _sendInitiativeDeployButtons(game\x2C gameId\x2C ctx);\n  ctx.saveGames();\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C getDeploymentZones\x2C getFigureSize\x2C getFootprintCells\x2C filterValidTopLeftSpaces\x2C getDeploySpaceGridRows\x2C getDeploymentMapAttachment\x2C client\n */\nexport async function handleDeploymentFig(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    getDeploymentZones\x2C\n    getFigureSize\x2C\n    getFootprintCells\x2C\n    filterValidTopLeftSpaces\x2C\n    getDeploySpaceGridRows\x2C\n    getDeploymentMapAttachment\x2C\n    client\x2C\n  } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'deployment_fig_');\n  if (parts.length < 3) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const flatIndex = parseInt(parts[2]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const ownerId = getPlayerId(game\x2C playerNum);\n  if (interaction.user.id !== ownerId) {\n    await interaction.followUp({ content: 'Only the owner of this deck can deploy.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Block while a loadout selection is pending for this player\n  if (game.pendingLoadoutSelection?.playerNum === playerNum) {\n    await interaction.followUp({ content: 'Please select a **Loadout card** first before deploying more figures.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const labels = game[_deployLabelsKey(playerNum)];\n  const label = labels?.[flatIndex];\n  if (!label) {\n    await interaction.followUp({ content: 'Figure not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const mapId = game.selectedMap?.id;\n  const zones = mapId ? getDeploymentZones()[mapId] : null;\n  const initiativePlayerNum = getInitiativePlayerNum(game);\n  const playerZone = playerNum === initiativePlayerNum ? game.deploymentZoneChosen : (game.deploymentZoneChosen === 'red' ? 'blue' : 'red');\n  const deployMeta = game[_deployMetadataKey(playerNum)];\n  const figMeta = deployMeta?.[flatIndex];\n  const figureKey = figMeta ? `${figMeta.dcName}-${figMeta.dgIndex}-${figMeta.figureIndex}` : null;\n  // Block deploying Lie in Ambush set-aside figures\n  if (figureKey && game.lieInAmbushSetAside?.[playerNum]?.includes(figureKey)) {\n    await interaction.followUp({ content: 'This group is set aside via **Lie in Ambush** and cannot deploy during the deployment phase.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const occupied = [];\n  if (game.figurePositions) {\n    for (const p of [1\x2C 2]) {\n      for (const [k\x2C s] of Object.entries(game.figurePositions[p] || {})) {\n        if (p === playerNum && k === figureKey) continue;\n        const dcName = dcNameFromFigureKey(k);\n        const size = game.figureOrientations?.[k] || getFigureSize(dcName);\n        occupied.push(...getFootprintCells(s\x2C size));\n      }\n    }\n  }\n  const zoneSpaces = (zones?.[playerZone] || []).map((s) => String(s).toLowerCase());\n  const dcName = figMeta?.dcName;\n  const figureSize = dcName ? getFigureSize(dcName) : '1x1';\n  const isLarge = figureSize !== '1x1';\n  const needsOrientation = figureSize === '2x3' || figureSize === '1x2';\n  if (zoneSpaces.length > 0 && needsOrientation) {\n    const orientationButtons = figureSize === '2x3'\n      ? [\n          new ButtonBuilder()\n            .setCustomId(`deployment_orient_${gameId}_${playerNum}_${flatIndex}_2x3`)\n            .setLabel('2\\u00d73 (2 wide\x2C 3 tall)')\n            .setStyle(ButtonStyle.Primary)\x2C\n          new ButtonBuilder()\n            .setCustomId(`deployment_orient_${gameId}_${playerNum}_${flatIndex}_3x2`)\n            .setLabel('3\\u00d72 (3 wide\x2C 2 tall)')\n            .setStyle(ButtonStyle.Primary)\x2C\n        ]\n      : [\n          new ButtonBuilder()\n            .setCustomId(`deployment_orient_${gameId}_${playerNum}_${flatIndex}_1x2`)\n            .setLabel('1\\u00d72 (1 wide\x2C 2 tall)')\n            .setStyle(ButtonStyle.Primary)\x2C\n          new ButtonBuilder()\n            .setCustomId(`deployment_orient_${gameId}_${playerNum}_${flatIndex}_2x1`)\n            .setLabel('2\\u00d71 (2 wide\x2C 1 tall)')\n            .setStyle(ButtonStyle.Primary)\x2C\n        ];\n    const orientationRow = new ActionRowBuilder().addComponents(...orientationButtons);\n    await interaction.followUp({\n      content: `Choose orientation for **${label.replace(/^Deploy /\x2C '')}** (large unit):`\x2C\n      components: [orientationRow]\x2C\n      ephemeral: false\x2C\n    }).catch(discordCatch);\n    return;\n  }\n  const { blocking\x2C ignoreBlocking } = getDeployBlockingInfo(game\x2C dcName);\n  // Zone is NOT extended for Massive \u2014 figures must deploy within the zone.\n  // ignoreBlocking lets filterValidTopLeftSpaces allow blocking cells inside the zone.\n  const validSpaces = filterValidTopLeftSpaces(zoneSpaces\x2C occupied\x2C figureSize\x2C getFootprintCells\x2C blocking\x2C ignoreBlocking);\n  if (zoneSpaces.length > 0) {\n    const { rows\x2C available } = getDeploySpaceGridRows(gameId\x2C playerNum\x2C flatIndex\x2C validSpaces\x2C []\x2C playerZone);\n    if (available.length === 0) {\n      await interaction.followUp({ content: 'No spaces left in your deployment zone (all occupied or no valid spot for this size).'\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n    const BTM_PER_MSG = 5;\n    game.deploySpaceGridMessageIds = game.deploySpaceGridMessageIds || {};\n    const gridKey = `${playerNum}_${flatIndex}`;\n    const [fsCols\x2C fsRows] = figureSize.split('x').map(Number);\n    const promptText = isLarge\n      ? `Pick the **top-left square** for **${label.replace(/^Deploy /\x2C '')}** (${figureSize} unit \u2014 ${fsCols} wide\x2C ${fsRows} tall):`\n      : `Pick a space for **${label.replace(/^Deploy /\x2C '')}**:`;\n    const isInitiative = playerNum === initiativePlayerNum;\n    const idsKey = isInitiative ? 'initiativeDeployMessageIds' : 'nonInitiativeDeployMessageIds';\n    const deployMsgIds = game[idsKey] || [];\n    const firstDeployMsgId = deployMsgIds[0];\n    if (firstDeployMsgId) {\n      try {\n        const handId = getHandChannelId(game\x2C playerNum);\n        const handChannel = await fetchGameChannel(client\x2C handId);\n        const deployMsg = await handChannel.messages.fetch(firstDeployMsgId);\n        await deployMsg.edit({ attachments: [] });\n      } catch {}\n    }\n    const mapAttachment = await getDeploymentMapAttachment(game\x2C playerZone);\n    // Always use two-tier row picker for cell selection\n    const zoneStyle = playerZone === 'red' ? ButtonStyle.Danger : ButtonStyle.Primary;\n    const { rows: rowBtns } = buildRowPickerButtons(validSpaces\x2C `deploy_row_${gameId}_${playerNum}_${flatIndex}_`\x2C { style: zoneStyle });\n    const replyPayload = { content: `${promptText}\\nChoose a row:`\x2C components: rowBtns.slice(0\x2C BTM_PER_MSG)\x2C ephemeral: false\x2C fetchReply: true };\n    if (mapAttachment) replyPayload.files = [mapAttachment];\n    const replyMsg = await interaction.followUp(replyPayload).catch(() => null);\n    const gridIds = [];\n    if (replyMsg?.id) gridIds.push(replyMsg.id);\n    game.deploySpaceGridMessageIds[gridKey] = gridIds;\n  } else {\n    // No deployment zones defined for this map \u2014 interaction was already deferred so\n    // showModal() would fail. Fall back to a followUp message instead.\n    await interaction.followUp({\n      content: `No deployment zones found for this map. Please use the deploy command or contact a bothelper.`\x2C\n      ephemeral: true\x2C\n    }).catch(discordCatch);\n  }\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C getDeploymentZones\x2C getFigureSize\x2C getFootprintCells\x2C filterValidTopLeftSpaces\x2C getDeploySpaceGridRows\x2C getDeploymentMapAttachment\x2C client\n */\nexport async function handleDeploymentOrient(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    getDeploymentZones\x2C\n    getFigureSize\x2C\n    getFootprintCells\x2C\n    filterValidTopLeftSpaces\x2C\n    getDeploySpaceGridRows\x2C\n    getDeploymentMapAttachment\x2C\n    client\x2C\n  } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'deployment_orient_');\n  if (parts.length < 4) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const flatIndex = parseInt(parts[2]\x2C 10);\n  const orientation = parts[3];\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const ownerId = getPlayerId(game\x2C playerNum);\n  if (interaction.user.id !== ownerId) {\n    await interaction.followUp({ content: 'Only the owner of this deck can deploy.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const labels = game[_deployLabelsKey(playerNum)];\n  const deployMeta = game[_deployMetadataKey(playerNum)];\n  const label = labels?.[flatIndex];\n  const figMeta = deployMeta?.[flatIndex];\n  if (!label || !figMeta) {\n    await interaction.followUp({ content: 'Figure not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const figureKey = `${figMeta.dcName}-${figMeta.dgIndex}-${figMeta.figureIndex}`;\n  game.pendingDeployOrientation = game.pendingDeployOrientation || {};\n  game.pendingDeployOrientation[`${playerNum}_${flatIndex}`] = orientation;\n  const mapId = game.selectedMap?.id;\n  const zones = mapId ? getDeploymentZones()[mapId] : null;\n  const initiativePlayerNum = getInitiativePlayerNum(game);\n  const playerZone = playerNum === initiativePlayerNum ? game.deploymentZoneChosen : (game.deploymentZoneChosen === 'red' ? 'blue' : 'red');\n  const occupied = [];\n  if (game.figurePositions) {\n    for (const p of [1\x2C 2]) {\n      for (const [k\x2C s] of Object.entries(game.figurePositions[p] || {})) {\n        if (p === playerNum && k === figureKey) continue;\n        const dcName = dcNameFromFigureKey(k);\n        const size = game.figureOrientations?.[k] || getFigureSize(dcName);\n        occupied.push(...getFootprintCells(s\x2C size));\n      }\n    }\n  }\n  const zoneSpaces = (zones?.[playerZone] || []).map((s) => String(s).toLowerCase());\n  const { blocking\x2C ignoreBlocking } = getDeployBlockingInfo(game\x2C figMeta.dcName);\n  const validSpaces = filterValidTopLeftSpaces(zoneSpaces\x2C occupied\x2C orientation\x2C getFootprintCells\x2C blocking\x2C ignoreBlocking);\n  if (validSpaces.length === 0) {\n    delete game.pendingDeployOrientation[`${playerNum}_${flatIndex}`];\n    await interaction.followUp({ content: 'No valid spots for this orientation in your zone. Try the other orientation.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { rows } = getDeploySpaceGridRows(gameId\x2C playerNum\x2C flatIndex\x2C validSpaces\x2C []\x2C playerZone);\n  const BTM_PER_MSG = 5;\n  game.deploySpaceGridMessageIds = game.deploySpaceGridMessageIds || {};\n  const gridKey = `${playerNum}_${flatIndex}`;\n  const gridIds = [];\n  try {\n    const isInitiative = playerNum === initiativePlayerNum;\n    const idsKey = isInitiative ? 'initiativeDeployMessageIds' : 'nonInitiativeDeployMessageIds';\n    const deployMsgIds = game[idsKey] || [];\n    const firstDeployMsgId = deployMsgIds[0];\n    if (firstDeployMsgId) {\n      try {\n        const handId = getHandChannelId(game\x2C playerNum);\n        const handChannel = await fetchGameChannel(client\x2C handId);\n        const deployMsg = await handChannel.messages.fetch(firstDeployMsgId);\n        await deployMsg.edit({ attachments: [] });\n      } catch {}\n    }\n    const mapAttachment = await getDeploymentMapAttachment(game\x2C playerZone);\n    const [oCols\x2C oRows] = orientation.split('x').map(Number);\n    const promptText = `Pick the **top-left square** for **${label.replace(/^Deploy /\x2C '')}** (${orientation} unit \u2014 ${oCols} wide\x2C ${oRows} tall):`;\n    // Always use two-tier row picker for cell selection\n    const zoneStyle = playerZone === 'red' ? ButtonStyle.Danger : ButtonStyle.Primary;\n    const { rows: rowBtns } = buildRowPickerButtons(validSpaces\x2C `deploy_row_${gameId}_${playerNum}_${flatIndex}_`\x2C { style: zoneStyle });\n    const editPayload = { content: `${promptText}\\nChoose a row:`\x2C components: rowBtns.slice(0\x2C BTM_PER_MSG) };\n    if (mapAttachment) editPayload.files = [mapAttachment];\n    await interaction.message.edit(editPayload);\n    if (interaction.message?.id) gridIds.push(interaction.message.id);\n  } catch (err) {\n    console.error('Failed to show deploy grid after orientation:'\x2C err);\n  }\n  game.deploySpaceGridMessageIds[gridKey] = gridIds;\n}\n\n/**\n * Second tier of the deploy row picker: user clicked "Row X" \u2192 show spaces in that row.\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C getDeploymentZones\x2C getFigureSize\x2C getFootprintCells\x2C filterValidTopLeftSpaces\x2C getDeploySpaceGridRows\x2C buildDeployRowButtons\x2C client\n */\nexport async function handleDeployRow(interaction\x2C ctx) {\n  const match = interaction.customId.match(/^deploy_row_([^_]+)_(\\d+)_(\\d+)_(\\d+)$/);\n  if (!match) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C gameId\x2C playerNumStr\x2C flatIndexStr\x2C rowNumStr] = match;\n  const playerNum = parseInt(playerNumStr\x2C 10);\n  const flatIndex = parseInt(flatIndexStr\x2C 10);\n  const rowNum = parseInt(rowNumStr\x2C 10);\n  const { getGame\x2C getDeploymentZones\x2C getFigureSize\x2C getFootprintCells\x2C filterValidTopLeftSpaces\x2C getDeploySpaceGridRows\x2C buildDeployRowButtons\x2C client } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const ownerId = getPlayerId(game\x2C playerNum);\n  if (interaction.user.id !== ownerId) {\n    await interaction.followUp({ content: 'Only the owner of this deck can deploy.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const mapId = game.selectedMap?.id;\n  const zones = mapId ? getDeploymentZones()[mapId] : null;\n  const initiativePlayerNum = getInitiativePlayerNum(game);\n  const playerZone = playerNum === initiativePlayerNum ? game.deploymentZoneChosen : (game.deploymentZoneChosen === 'red' ? 'blue' : 'red');\n  const deployMeta = game[_deployMetadataKey(playerNum)];\n  const figMeta = deployMeta?.[flatIndex];\n  const figureKey = figMeta ? `${figMeta.dcName}-${figMeta.dgIndex}-${figMeta.figureIndex}` : null;\n  const occupied = [];\n  if (game.figurePositions) {\n    for (const p of [1\x2C 2]) {\n      for (const [k\x2C s] of Object.entries(game.figurePositions[p] || {})) {\n        if (p === playerNum && k === figureKey) continue;\n        const dcName = dcNameFromFigureKey(k);\n        const size = game.figureOrientations?.[k] || getFigureSize(dcName);\n        occupied.push(...getFootprintCells(s\x2C size));\n      }\n    }\n  }\n  const zoneSpaces = (zones?.[playerZone] || []).map((s) => String(s).toLowerCase());\n  const dcName = figMeta?.dcName;\n  const figureSize = game.pendingDeployOrientation?.[`${playerNum}_${flatIndex}`] || (dcName ? getFigureSize(dcName) : '1x1');\n  const { blocking\x2C ignoreBlocking } = getDeployBlockingInfo(game\x2C dcName);\n  const validSpaces = filterValidTopLeftSpaces(zoneSpaces\x2C occupied\x2C figureSize\x2C getFootprintCells\x2C blocking\x2C ignoreBlocking);\n  // Filter to only spaces in the chosen row\n  const rowSpaces = validSpaces.filter((s) => {\n    const m = s.match(/^[a-z]+(\\d+)$/i);\n    return m && parseInt(m[1]\x2C 10) === rowNum;\n  });\n  if (rowSpaces.length === 0) {\n    await interaction.followUp({ content: `No available spaces in Row ${rowNum}.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const zoneStyle = playerZone === 'red' ? ButtonStyle.Danger : ButtonStyle.Primary;\n  rowSpaces.sort((a\x2C b) => (a || '').localeCompare(b || ''));\n  const btns = rowSpaces.map((space) =>\n    new ButtonBuilder()\n      .setCustomId(`deploy_pick_${gameId}_${playerNum}_${flatIndex}_${space}`)\n      .setLabel(space.toUpperCase())\n      .setStyle(zoneStyle)\n  );\n  const spaceRows = chunkButtonsToRows(btns);\n  // Add a "back to rows" button\n  const backRow = new ActionRowBuilder().addComponents(\n    new ButtonBuilder()\n      .setCustomId(`deploy_row_back_${gameId}_${playerNum}_${flatIndex}`)\n      .setLabel('Back to Rows')\n      .setStyle(ButtonStyle.Secondary)\n  );\n  const components = [...spaceRows.slice(0\x2C 4)\x2C backRow];\n  // Clear previous grid messages\n  const gridKey = `${playerNum}_${flatIndex}`;\n  const oldGridIds = game.deploySpaceGridMessageIds?.[gridKey] || [];\n  const currentMsgId = interaction.message.id;\n  for (const id of oldGridIds) {\n    if (id === currentMsgId) continue;\n    try {\n      const msg = await interaction.channel.messages.fetch(id);\n      await msg.delete();\n    } catch {}\n  }\n  try {\n    await interaction.message.edit({ content: `**Row ${rowNum}** \u2014 pick a space:`\x2C components });\n  } catch {\n    await interaction.followUp({ content: `**Row ${rowNum}** \u2014 pick a space:`\x2C components\x2C ephemeral: false }).catch(() => null);\n  }\n  game.deploySpaceGridMessageIds = game.deploySpaceGridMessageIds || {};\n  game.deploySpaceGridMessageIds[gridKey] = [interaction.message.id];\n}\n\n/**\n * Handle deploy_row_back_ button: return to the row picker.\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx\n */\nexport async function handleDeployRowBack(interaction\x2C ctx) {\n  const match = interaction.customId.match(/^deploy_row_back_([^_]+)_(\\d+)_(\\d+)$/);\n  if (!match) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C gameId\x2C playerNumStr\x2C flatIndexStr] = match;\n  const playerNum = parseInt(playerNumStr\x2C 10);\n  const flatIndex = parseInt(flatIndexStr\x2C 10);\n  const { getGame\x2C getDeploymentZones\x2C getFigureSize\x2C getFootprintCells\x2C filterValidTopLeftSpaces\x2C buildDeployRowButtons } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const ownerId = getPlayerId(game\x2C playerNum);\n  if (interaction.user.id !== ownerId) {\n    await interaction.followUp({ content: 'Only the owner can deploy.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const mapId = game.selectedMap?.id;\n  const zones = mapId ? getDeploymentZones()[mapId] : null;\n  const initiativePlayerNum = getInitiativePlayerNum(game);\n  const playerZone = playerNum === initiativePlayerNum ? game.deploymentZoneChosen : (game.deploymentZoneChosen === 'red' ? 'blue' : 'red');\n  const deployMeta = game[_deployMetadataKey(playerNum)];\n  const figMeta = deployMeta?.[flatIndex];\n  const figureKey = figMeta ? `${figMeta.dcName}-${figMeta.dgIndex}-${figMeta.figureIndex}` : null;\n  const occupied = [];\n  if (game.figurePositions) {\n    for (const p of [1\x2C 2]) {\n      for (const [k\x2C s] of Object.entries(game.figurePositions[p] || {})) {\n        if (p === playerNum && k === figureKey) continue;\n        const dcName = dcNameFromFigureKey(k);\n        const size = game.figureOrientations?.[k] || getFigureSize(dcName);\n        occupied.push(...getFootprintCells(s\x2C size));\n      }\n    }\n  }\n  const zoneSpaces = (zones?.[playerZone] || []).map((s) => String(s).toLowerCase());\n  const dcName = figMeta?.dcName;\n  const figureSize = game.pendingDeployOrientation?.[`${playerNum}_${flatIndex}`] || (dcName ? getFigureSize(dcName) : '1x1');\n  const { blocking\x2C ignoreBlocking } = getDeployBlockingInfo(game\x2C dcName);\n  const validSpaces = filterValidTopLeftSpaces(zoneSpaces\x2C occupied\x2C figureSize\x2C getFootprintCells\x2C blocking\x2C ignoreBlocking);\n  const labels = game[_deployLabelsKey(playerNum)];\n  const label = labels?.[flatIndex] || 'figure';\n  const isLarge = figureSize !== '1x1';\n  const promptText = isLarge\n    ? `Pick the **top-left square** for **${label.replace(/^Deploy /\x2C '')}** (${figureSize} unit):`\n    : `Pick a space for **${label.replace(/^Deploy /\x2C '')}**:`;\n  const zoneStyle = playerZone === 'red' ? ButtonStyle.Danger : ButtonStyle.Primary;\n  const { rows: rowBtns } = buildRowPickerButtons(validSpaces\x2C `deploy_row_${gameId}_${playerNum}_${flatIndex}_`\x2C { style: zoneStyle });\n  try {\n    await interaction.message.edit({ content: `${promptText}\\nChoose a row:`\x2C components: rowBtns.slice(0\x2C 5) });\n  } catch {\n    await interaction.followUp({ content: `${promptText}\\nChoose a row:`\x2C components: rowBtns.slice(0\x2C 5)\x2C ephemeral: false }).catch(() => null);\n  }\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C logGameAction\x2C pushUndo\x2C updateDeployPromptMessages\x2C buildBoardMapPayload\x2C client\x2C saveGames\n */\nexport async function handleDeployPick(interaction\x2C ctx) {\n  const { getGame\x2C getFigureSize\x2C getFootprintCells\x2C logGameAction\x2C pushUndo\x2C updateDeployPromptMessages\x2C buildBoardMapPayload\x2C client\x2C saveGames } = ctx;\n  const match = interaction.customId.match(/^deploy_pick_([^_]+)_(\\d+)_(\\d+)_(.+)$/);\n  if (!match) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C gameId\x2C playerNumStr\x2C flatIndexStr\x2C space] = match;\n  const playerNum = parseInt(playerNumStr\x2C 10);\n  const flatIndex = parseInt(flatIndexStr\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const ownerId = getPlayerId(game\x2C playerNum);\n  if (interaction.user.id !== ownerId) {\n    await interaction.followUp({ content: 'Only the owner of this deck can deploy.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Block while a loadout selection is pending for this player\n  if (game.pendingLoadoutSelection?.playerNum === playerNum) {\n    await interaction.followUp({ content: 'Please select a **Loadout card** first before deploying more figures.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const deployMeta = game[_deployMetadataKey(playerNum)];\n  const deployLabels = game[_deployLabelsKey(playerNum)];\n  const figMeta = deployMeta?.[flatIndex];\n  const figLabel = deployLabels?.[flatIndex];\n  if (!figMeta || !figLabel) {\n    await interaction.followUp({ content: 'Figure not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const figureKey = `${figMeta.dcName}-${figMeta.dgIndex}-${figMeta.figureIndex}`;\n  // Server-side validation: reject blocking terrain for non-MOBILE/MASSIVE figures\n  const { blocking: _dpBlocking\x2C ignoreBlocking: _dpIgnore } = getDeployBlockingInfo(game\x2C figMeta.dcName);\n  if (!_dpIgnore && _dpBlocking.length > 0) {\n    const figureSize = game.pendingDeployOrientation?.[`${playerNum}_${flatIndex}`] || getFigureSize(figMeta.dcName) || '1x1';\n    const cells = getFootprintCells(space.toLowerCase()\x2C figureSize);\n    const blockSet = new Set(_dpBlocking.map(s => String(s).toLowerCase()));\n    if (cells.some(c => blockSet.has(c))) {\n      await interaction.followUp({ content: 'That space is blocking terrain. Only MOBILE or MASSIVE figures can deploy there.'\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n  }\n  if (!game.figurePositions) game.figurePositions = { 1: {}\x2C 2: {} };\n  if (!game.figurePositions[playerNum]) game.figurePositions[playerNum] = {};\n  game.figurePositions[playerNum][figureKey] = space.toLowerCase();\n  const pendingOrientation = game.pendingDeployOrientation?.[`${playerNum}_${flatIndex}`];\n  if (pendingOrientation) {\n    game.figureOrientations = game.figureOrientations || {};\n    game.figureOrientations[figureKey] = pendingOrientation;\n    delete game.pendingDeployOrientation[`${playerNum}_${flatIndex}`];\n  }\n  saveGames();\n  const spaceUpper = space.toUpperCase();\n  const gridKey = `${playerNum}_${flatIndex}`;\n  const gridMsgIds = game.deploySpaceGridMessageIds?.[gridKey] || [];\n  const clickedMsgId = interaction.message?.id;\n  if (gridMsgIds.length > 0) {\n    try {\n      const handId = getHandChannelId(game\x2C playerNum);\n      const handChannel = await fetchGameChannel(client\x2C handId);\n      for (const msgId of gridMsgIds) {\n        if (msgId === clickedMsgId) continue;\n        try {\n          const msg = await handChannel.messages.fetch(msgId);\n          await msg.delete();\n        } catch {}\n      }\n    } catch (err) {\n      console.error('Failed to delete space grid messages:'\x2C err);\n    }\n    if (game.deploySpaceGridMessageIds) {\n      delete game.deploySpaceGridMessageIds[gridKey];\n    }\n  }\n  const initiativePlayerNum = getInitiativePlayerNum(game);\n  const isInitiative = playerNum === initiativePlayerNum;\n  const confirmIdsKey = isInitiative ? 'initiativeDeployedConfirmIds' : 'nonInitiativeDeployedConfirmIds';\n  if (clickedMsgId) {\n    game[confirmIdsKey] = game[confirmIdsKey] || [];\n    game[confirmIdsKey].push(clickedMsgId);\n  }\n  const deployLogMsg = await logGameAction(game\x2C client\x2C `<@${interaction.user.id}> deployed **${figLabel.replace(/^Deploy /\x2C '')}** at **${spaceUpper}**`\x2C { allowedMentions: { users: [interaction.user.id] }\x2C phase: 'DEPLOYMENT'\x2C icon: 'deploy' });\n  pushUndo(game\x2C {\n    type: 'deploy_pick'\x2C\n    playerNum\x2C\n    figureKey\x2C\n    space: spaceUpper\x2C\n    figLabel: figLabel.replace(/^Deploy /\x2C '')\x2C\n    gameLogMessageId: deployLogMsg?.id\x2C\n  });\n  // Blitz mode: skip full deploy prompt refresh \u2014 Blitz manages its own buttons\n  if (!game.blitzDeployment?.activeGroup) {\n    await updateDeployPromptMessages(game\x2C playerNum\x2C client);\n  }\n  if (game.boardId && game.selectedMap) {\n    try {\n      const boardChannel = await fetchGameChannel(client\x2C game.boardId);\n      const payload = await buildBoardMapPayload(game.gameId\x2C game.selectedMap\x2C game);\n      await boardChannel.send(payload);\n    } catch (err) {\n      console.error('Failed to update map after deployment:'\x2C err);\n    }\n  }\n  await interaction.editReply({\n    content: `\u2713 Deployed **${figLabel.replace(/^Deploy /\x2C '')}** at **${spaceUpper}**.`\x2C\n    components: []\x2C\n    attachments: []\x2C\n  }).catch(discordCatch);\n\n  // Imperial Loadout: if Purge Trooper (Elite) was just deployed\x2C gate further deployment until loadout chosen\n  const dcEff = getDcEffects()?.[figMeta.dcName];\n  if (dcEff?.specialAbilityIds?.includes('imperial_loadout_purge_trooper')) {\n    const loadoutCards = getLoadoutCards();\n    const names = Object.keys(loadoutCards);\n    if (names.length > 0) {\n      game.pendingLoadoutSelection = { figureKey\x2C playerNum };\n      saveGames();\n      const defaultName = names[0];\n      const selectionRow = _getLoadoutSelectionRow(game.gameId\x2C figureKey\x2C names\x2C defaultName);\n      const confirmRow = _getLoadoutConfirmRow(game.gameId\x2C figureKey);\n      const files = _getLoadoutImageAttachment(loadoutCards[defaultName]);\n      try {\n        const handId = getHandChannelId(game\x2C playerNum);\n        const handChannel = await fetchGameChannel(client\x2C handId);\n        await handChannel.send({\n          content: `\u2694\ufe0f **Imperial Loadout** \u2014 Choose a Loadout card for **${figMeta.dcName}** before continuing deployment:`\x2C\n          components: [selectionRow\x2C confirmRow]\x2C\n          files\x2C\n        });\n      } catch (err) {\n        console.error('Failed to send loadout picker:'\x2C err);\n      }\n    }\n  }\n\n  // Shape (Clawdite Shapeshifter): show form picker after deployment\n  const _shapeIds = ['shape_clawdite_elite'\x2C 'shape_clawdite_reg'];\n  if (dcEff?.specialAbilityIds?.some(id => _shapeIds.includes(id))) {\n    const formCards = getFormCards();\n    const takenForms = getFormsChosenByTeamClawdites(game\x2C playerNum\x2C figureKey);\n    const formNames = Object.keys(formCards).filter(n => !takenForms.has(n));\n    if (formNames.length > 0) {\n      const row = new ActionRowBuilder().addComponents(\n        ...formNames.map((name) =>\n          new ButtonBuilder()\n            .setCustomId(`form_pick_${game.gameId}_${figureKey}_${name}`)\n            .setLabel(name)\n            .setStyle(ButtonStyle.Primary)\n        )\n      );\n      try {\n        const handId = getHandChannelId(game\x2C playerNum);\n        const handChannel = await fetchGameChannel(client\x2C handId);\n        await handChannel.send({\n          content: `\ud83d\udd04 **Shape** \u2014 Choose a Form card for **${figMeta.dcName}**:`\x2C\n          components: [row]\x2C\n        });\n      } catch (err) {\n        console.error('Failed to send form picker:'\x2C err);\n      }\n    }\n  }\n\n  // Blitz: check if the active group is now fully deployed\n  if (game.blitzDeployment?.activeGroup) {\n    await checkBlitzGroupComplete(game\x2C playerNum\x2C interaction\x2C ctx);\n  }\n}\n\n/* \u2500\u2500 Loadout picker helpers \u2500\u2500 */\n\nfunction _getLoadoutSelectionRow(gameId\x2C figureKey\x2C names\x2C selectedName) {\n  return new ActionRowBuilder().addComponents(\n    ...names.map((name) =>\n      new ButtonBuilder()\n        .setCustomId(`loadout_select_${gameId}_${figureKey}_${name}`)\n        .setLabel(name)\n        .setStyle(name === selectedName ? ButtonStyle.Success : ButtonStyle.Primary)\n    )\n  );\n}\n\nfunction _getLoadoutConfirmRow(gameId\x2C figureKey) {\n  return new ActionRowBuilder().addComponents(\n    new ButtonBuilder()\n      .setCustomId(`loadout_confirm_${gameId}_${figureKey}`)\n      .setLabel('Confirm Selection')\n      .setStyle(ButtonStyle.Success)\n  );\n}\n\nfunction _getLoadoutImageAttachment(card\x2C name) {\n  if (!card?.imagePath) return [];\n  try {\n    const fileName = name ? `${name.replace(/[^a-zA-Z0-9]/g\x2C '_')}.png` : undefined;\n    return [new AttachmentBuilder(join(getRootDir()\x2C card.imagePath)\x2C fileName ? { name: fileName } : undefined)];\n  } catch { return []; }\n}\n\n/** Parse loadout custom ID after prefix: {gameId}_{figureKey}_{extra} */\nfunction _parseLoadoutId(customId\x2C prefix) {\n  const rest = customId.slice(prefix.length);\n  const gameIdEnd = rest.indexOf('_');\n  if (gameIdEnd < 0) return null;\n  const gameId = rest.slice(0\x2C gameIdEnd);\n  const afterGameId = rest.slice(gameIdEnd + 1);\n  const fkMatch = afterGameId.match(/^(.+-\\d+-\\d+)(?:_(.+))?$/);\n  if (!fkMatch) return null;\n  return { gameId\x2C figureKey: fkMatch[1]\x2C extra: fkMatch[2] ?? null };\n}\n\n/**\n * Handle loadout selection toggle: loadout_select_{gameId}_{figureKey}_{loadoutName}\n * Updates buttons (green = selected) and swaps the card image.\n */\nexport async function handleLoadoutSelect(interaction\x2C ctx) {\n  await interaction.deferUpdate().catch(discordCatch);\n  const { getGame } = ctx;\n  const parsed = _parseLoadoutId(interaction.customId\x2C 'loadout_select_');\n  if (!parsed || !parsed.extra) return;\n  const { gameId\x2C figureKey\x2C extra: loadoutName } = parsed;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n\n  const loadoutCards = getLoadoutCards();\n  const card = loadoutCards[loadoutName];\n  if (!card) return;\n\n  const names = Object.keys(loadoutCards);\n  const selectionRow = _getLoadoutSelectionRow(gameId\x2C figureKey\x2C names\x2C loadoutName);\n  const confirmRow = _getLoadoutConfirmRow(gameId\x2C figureKey);\n  const files = _getLoadoutImageAttachment(card);\n\n  await interaction.message.edit({\n    content: `\u2694\ufe0f **Imperial Loadout** \u2014 Choose a Loadout card for **${dcNameFromFigureKey(figureKey)}**:`\x2C\n    components: [selectionRow\x2C confirmRow]\x2C\n    files\x2C\n    attachments: []\x2C\n  }).catch(discordCatch);\n}\n\n/**\n * Handle loadout confirm: loadout_confirm_{gameId}_{figureKey}\n * Reads the currently-green button to determine which loadout was selected.\n */\nexport async function handleLoadoutConfirm(interaction\x2C ctx) {\n  await interaction.deferUpdate().catch(discordCatch);\n  const { getGame\x2C logGameAction\x2C client\x2C saveGames } = ctx;\n  const parsed = _parseLoadoutId(interaction.customId\x2C 'loadout_confirm_');\n  if (!parsed) return;\n  const { gameId\x2C figureKey } = parsed;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n\n  // Determine selected loadout from the green (Success) button in the first row\n  const selectionRow = interaction.message.components[0];\n  let loadoutName = null;\n  for (const btn of selectionRow.components) {\n    if (btn.style === ButtonStyle.Success) {\n      loadoutName = btn.label;\n      break;\n    }\n  }\n  if (!loadoutName) return;\n\n  const loadoutCards = getLoadoutCards();\n  const card = loadoutCards[loadoutName];\n  if (!card) return;\n\n  setConfig(game\x2C figureKey\x2C 'loadout'\x2C loadoutName);\n\n  // Clear the deployment gate\n  const wasPending = game.pendingLoadoutSelection?.playerNum;\n  delete game.pendingLoadoutSelection;\n  saveGames();\n\n  // Remove the loadout picker from the hand channel\n  await interaction.message.delete().catch(discordCatch);\n\n  // Store loadout as a DC attachment and reorder play area so it appears under the DC\n  const dcName = dcNameFromFigureKey(figureKey);\n  if (wasPending) {\n    try {\n      const dcMsgIds = getDcMessageIds(game\x2C wasPending) || [];\n      const dcMsgId = dcMsgIds.find(id => ctx.dcMessageMeta.get(id)?.dcName === dcName);\n      if (dcMsgId) {\n        const attachKey = dcAttachmentsKey(wasPending);\n        game[attachKey] = game[attachKey] || {};\n        game[attachKey][dcMsgId] = game[attachKey][dcMsgId] || [];\n        game[attachKey][dcMsgId].push(loadoutName);\n        if (ctx.reorderPlayAreaAfterAttachments) {\n          await ctx.reorderPlayAreaAfterAttachments(game\x2C wasPending\x2C client);\n        }\n      }\n    } catch (err) {\n      console.error('Failed to add loadout attachment to play area:'\x2C err);\n    }\n  }\n\n  await logGameAction?.(game\x2C client\x2C `**Imperial Loadout** \u2014 **${dcName}** chose **${loadoutName}**.`\x2C { phase: 'DEPLOYMENT'\x2C icon: 'deploy' });\n\n  // Resume deployment flow if it was gated\n  if (wasPending && ctx.updateDeployPromptMessages) {\n    await ctx.updateDeployPromptMessages(game\x2C wasPending\x2C client);\n  }\n}\n\n/**\n * Handle form card selection (deployment or round-start shift): form_pick_{gameId}_{figureKey}_{formName}\n */\nexport async function handleFormPick(interaction\x2C ctx) {\n  await interaction.deferUpdate().catch(discordCatch);\n  const { getGame\x2C logGameAction\x2C client\x2C saveGames } = ctx;\n  const prefix = 'form_pick_';\n  const rest = interaction.customId.slice(prefix.length);\n  const gameIdEnd = rest.indexOf('_');\n  if (gameIdEnd < 0) return;\n  const gameId = rest.slice(0\x2C gameIdEnd);\n  const afterGameId = rest.slice(gameIdEnd + 1);\n  const fkMatch = afterGameId.match(/^(.+-\\d+-\\d+)_(.+)$/);\n  if (!fkMatch) return;\n  const [\x2C figureKey\x2C formName] = fkMatch;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  const formCards = getFormCards();\n  const card = formCards[formName];\n  if (!card) return;\n\n  // Determine which player owns this figure\n  const ownerPlayerNum = game.figurePositions?.[1]?.[figureKey] != null ? 1\n    : game.figurePositions?.[2]?.[figureKey] != null ? 2 : null;\n\n  // Reject if another Clawdite on the same team already has this form\n  if (ownerPlayerNum) {\n    const takenForms = getFormsChosenByTeamClawdites(game\x2C ownerPlayerNum\x2C figureKey);\n    if (takenForms.has(formName)) {\n      await interaction.message.edit({\n        content: `\u274c **${formName}** is already chosen by another Clawdite on your team. Pick a different form.`\x2C\n        components: interaction.message.components\x2C\n      }).catch(discordCatch);\n      return;\n    }\n  }\n\n  setConfig(game\x2C figureKey\x2C 'form'\x2C formName);\n  saveGames();\n  const { join } = await import('path');\n  const { getRootDir } = await import('../data-loader.js');\n  const files = [];\n  if (card.imagePath) {\n    try { files.push(new AttachmentBuilder(join(getRootDir()\x2C card.imagePath))); } catch {}\n  }\n  const dcName = dcNameFromFigureKey(figureKey);\n  await interaction.message.edit({\n    content: `\u2713 **Form: ${formName}** \u2014 **${dcName}** gains ${formName} abilities.\\n${card.abilityText}`\x2C\n    components: []\x2C\n    files\x2C\n  }).catch(discordCatch);\n  const isRoundShift = (game.currentRound || 0) >= 1 && game.p1ActivationsRemaining != null;\n  await logGameAction?.(game\x2C client\x2C `\ud83d\udd04 **${isRoundShift ? 'Shift' : 'Shape'}** \u2014 **${dcName}** chose **${formName}** form.`\x2C { phase: isRoundShift ? 'ROUND' : 'DEPLOYMENT'\x2C icon: isRoundShift ? 'round' : 'deploy' });\n  if (isRoundShift && (game.pendingStartOfRoundResolve || 0) > 0) {\n    await resolveStartOfRoundEffect(game\x2C ctx);\n  }\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C logGameAction\x2C getDeployFigureLabels\x2C getDeployButtonRows\x2C getDeploymentMapAttachment\x2C getInitiativePlayerZoneLabel\x2C clearPreGameSetup\x2C getCcShuffleDrawButton\x2C buildBoardMapPayload\x2C client\x2C saveGames\x2C isDcAttachment\x2C resolveDcName\x2C isFigurelessDc\n */\nexport async function handleDeploymentDone(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    logGameAction\x2C\n    getDeployFigureLabels\x2C\n    getDeployButtonRows\x2C\n    getDeploymentMapAttachment\x2C\n    getInitiativePlayerZoneLabel\x2C\n    clearPreGameSetup\x2C\n    getCcShuffleDrawButton\x2C\n    buildBoardMapPayload\x2C\n    client\x2C\n    saveGames\x2C\n    isDcAttachment\x2C\n    resolveDcName\x2C\n    isFigurelessDc\x2C\n    finishSetupAttachments\x2C\n  } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'deployment_done_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (interaction.user.id !== game.player1Id && interaction.user.id !== game.player2Id) {\n    await interaction.followUp({ content: 'Only players in this game can use this.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const channelId = interaction.channel?.id;\n  const isP1Hand = channelId === game.p1HandId;\n  const isP2Hand = channelId === game.p2HandId;\n  if (!isP1Hand && !isP2Hand) {\n    await interaction.followUp({ content: 'Use the Deployment Completed button in your **Your Hand** thread (inside your Play Area).'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const initiativePlayerNum = getInitiativePlayerNum(game);\n  const isInitiativeSide = (isP1Hand && initiativePlayerNum === 1) || (isP2Hand && initiativePlayerNum === 2);\n  const otherZone = game.deploymentZoneChosen === 'red' ? 'blue' : 'red';\n\n  if (isInitiativeSide) {\n    if (game.initiativePlayerDeployed) {\n      await interaction.followUp({ content: "You've already marked deployed."\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n    game.initiativePlayerDeployed = true;\n    await logGameAction(game\x2C client\x2C `<@${interaction.user.id}> finished deploying`\x2C { allowedMentions: { users: [interaction.user.id] }\x2C phase: 'DEPLOYMENT'\x2C icon: 'deployed' });\n    const initiativeHandId = game.initiativePlayerId === game.player1Id ? game.p1HandId : game.p2HandId;\n    try {\n      const handChannel = await fetchGameChannel(client\x2C initiativeHandId);\n      const toDelete = [...(game.initiativeDeployMessageIds || [])\x2C ...(game.initiativeDeployedConfirmIds || [])];\n      for (const msgId of toDelete) {\n        try { await (await handChannel.messages.fetch(msgId)).delete(); } catch {}\n      }\n      game.initiativeDeployMessageIds = [];\n      game.initiativeDeployedConfirmIds = [];\n      await handChannel.send({ content: '\u2713 **Deployed.**' });\n    } catch (err) {\n      console.error('Failed to update initiative deploy message:'\x2C err);\n    }\n    if (game.boardId && game.selectedMap) {\n      try {\n        const boardChannel = await fetchGameChannel(client\x2C game.boardId);\n        const payload = await buildBoardMapPayload(game.gameId\x2C game.selectedMap\x2C game);\n        await boardChannel.send(payload);\n      } catch (err) {\n        console.error('Failed to update map after initiative deployment:'\x2C err);\n      }\n    }\n    const nonInitiativeHandId = game.initiativePlayerId === game.player1Id ? game.p2HandId : game.p1HandId;\n    const nonInitiativePlayerNum = opponentPlayerNum(getInitiativePlayerNum(game));\n    const nonInitiativeSquad = getSquad(game\x2C nonInitiativePlayerNum);\n    const nonInitiativeDcList = nonInitiativeSquad?.dcList || [];\n    const { labels: nonInitiativeLabels\x2C metadata: nonInitiativeMetadata } = getDeployFigureLabels(nonInitiativeDcList\x2C game);\n    const deployLabelsKey = _deployLabelsKey(nonInitiativePlayerNum);\n    const deployMetadataKey = _deployMetadataKey(nonInitiativePlayerNum);\n    game[deployLabelsKey] = nonInitiativeLabels;\n    game[deployMetadataKey] = nonInitiativeMetadata;\n    if (!game.figurePositions) game.figurePositions = { 1: {}\x2C 2: {} };\n    try {\n      const nonInitiativePlayerId = getPlayerId(game\x2C nonInitiativePlayerNum);\n      const nonInitiativeHandChannel = await fetchGameChannel(client\x2C nonInitiativeHandId);\n      const { deployRows\x2C doneRow } = getDeployButtonRows(gameId\x2C nonInitiativePlayerNum\x2C nonInitiativeDcList\x2C otherZone\x2C game.figurePositions\x2C game);\n      const DEPLOY_ROWS_PER_MSG = 4;\n      game.nonInitiativeDeployMessageIds = game.nonInitiativeDeployMessageIds || [];\n      game.nonInitiativeDeployedConfirmIds = game.nonInitiativeDeployedConfirmIds || [];\n      const nonInitiativePing = `<@${nonInitiativePlayerId}>`;\n      const nonInitMapAttachment = await getDeploymentMapAttachment(game\x2C otherZone);\n      if (deployRows.length === 0) {\n        const payload = {\n          content: `${nonInitiativePing} \u2014 Your opponent has deployed. Deploy in the **${otherZone}** zone. When finished\x2C click **Deployment Completed** below.`\x2C\n          components: [doneRow]\x2C\n          allowedMentions: { users: [nonInitiativePlayerId] }\x2C\n        };\n        if (nonInitMapAttachment) payload.files = [nonInitMapAttachment];\n        const msg = await nonInitiativeHandChannel.send(payload);\n        game.nonInitiativeDeployMessageIds = [msg.id];\n      } else {\n        for (let i = 0; i < deployRows.length; i += DEPLOY_ROWS_PER_MSG) {\n          const chunk = deployRows.slice(i\x2C i + DEPLOY_ROWS_PER_MSG);\n          const isLastChunk = i + DEPLOY_ROWS_PER_MSG >= deployRows.length;\n          const components = isLastChunk ? [...chunk\x2C doneRow] : chunk;\n          const payload = {\n            content: i === 0 ? `${nonInitiativePing} \u2014 Your opponent has deployed. Deploy each figure in the **${otherZone}** zone below (one per row)\x2C then click **Deployment Completed** when finished.` : null\x2C\n            components\x2C\n            allowedMentions: { users: [nonInitiativePlayerId] }\x2C\n          };\n          if (i === 0 && nonInitMapAttachment) payload.files = [nonInitMapAttachment];\n          const msg = await nonInitiativeHandChannel.send(payload);\n          game.nonInitiativeDeployMessageIds.push(msg.id);\n        }\n      }\n      game.nonInitiativeDeployMessageId = game.nonInitiativeDeployMessageIds[game.nonInitiativeDeployMessageIds.length - 1];\n    } catch (err) {\n      console.error('Failed to send deploy prompt to non-initiative player:'\x2C err);\n    }\n    saveGames();\n    return;\n  }\n\n  if (!game.initiativePlayerDeployed) {\n    await interaction.followUp({ content: 'Wait for the initiative player to deploy first.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (game.nonInitiativePlayerDeployed) {\n    await interaction.followUp({ content: "You've already marked deployed."\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  game.nonInitiativePlayerDeployed = true;\n  const nonInitiativeHandId = game.initiativePlayerId === game.player1Id ? game.p2HandId : game.p1HandId;\n  try {\n    const handChannel = await fetchGameChannel(client\x2C nonInitiativeHandId);\n    const toDelete = [...(game.nonInitiativeDeployMessageIds || [])\x2C ...(game.nonInitiativeDeployedConfirmIds || [])];\n    for (const msgId of toDelete) {\n      try { await (await handChannel.messages.fetch(msgId)).delete(); } catch {}\n    }\n    game.nonInitiativeDeployMessageIds = [];\n    game.nonInitiativeDeployedConfirmIds = [];\n    await handChannel.send({ content: '\u2713 **Deployed.**' });\n  } catch (err) {\n    console.error('Failed to update non-initiative deploy message:'\x2C err);\n  }\n\n  // Phase gate: both players deployed \u2014 wait for both to confirm before advancing\n  const { sendPhaseGateMessages } = ctx;\n  await sendPhaseGateMessages(game\x2C 'deploy_done'\x2C ctx);\n  saveGames();\n}\n\n/**\n * Auto-deploy: place all undeployed figures at entrance spaces (closest to opponent zone centroid).\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C getDeploymentZones\x2C getDeployFigureLabels\x2C getFigureSize\x2C getFootprintCells\x2C filterValidTopLeftSpaces\x2C parseCoord\x2C getDeployButtonRows\x2C buildBoardMapPayload\x2C logGameAction\x2C client\x2C saveGames\n */\nexport async function handleAutoDeploy(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    getDeploymentZones\x2C\n    getDeployFigureLabels\x2C\n    getFigureSize\x2C\n    getFootprintCells\x2C\n    filterValidTopLeftSpaces\x2C\n    parseCoord\x2C\n    getDeployButtonRows\x2C\n    buildBoardMapPayload\x2C\n    logGameAction\x2C\n    client\x2C\n    saveGames\x2C\n  } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'auto_deploy_');\n  if (parts.length < 2) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const ownerId = getPlayerId(game\x2C playerNum);\n  if (interaction.user.id !== ownerId) {\n    await interaction.followUp({ content: 'Only the owner of this deck can deploy.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const mapId = game.selectedMap?.id;\n  const zones = mapId ? getDeploymentZones()[mapId] : null;\n  if (!zones) {\n    await interaction.followUp({ content: 'Deployment zones not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const initiativePlayerNum = getInitiativePlayerNum(game);\n  const playerZone = playerNum === initiativePlayerNum ? game.deploymentZoneChosen : (game.deploymentZoneChosen === 'red' ? 'blue' : 'red');\n  const opponentZone = playerZone === 'red' ? 'blue' : 'red';\n  if (!game.figurePositions) game.figurePositions = { 1: {}\x2C 2: {} };\n  if (!game.figurePositions[playerNum]) game.figurePositions[playerNum] = {};\n  game.figureOrientations = game.figureOrientations || {};\n\n  const squad = getSquad(game\x2C playerNum);\n  const dcList = squad?.dcList || [];\n  const { metadata } = getDeployFigureLabels(dcList\x2C game);\n\n  // Compute centroid of opponent zone to rank spaces by proximity to "entrance"\n  const oppZoneCoords = (zones?.[opponentZone] || []).map((s) => parseCoord(String(s).toLowerCase()));\n  const oppCx = oppZoneCoords.length ? oppZoneCoords.reduce((s\x2C c) => s + c.col\x2C 0) / oppZoneCoords.length : 0;\n  const oppCy = oppZoneCoords.length ? oppZoneCoords.reduce((s\x2C c) => s + c.row\x2C 0) / oppZoneCoords.length : 0;\n\n  // Skip Lie in Ambush set-aside figures\n  const setAsideKeys = new Set(game.lieInAmbushSetAside?.[playerNum] || []);\n\n  let placed = 0;\n  for (const meta of metadata) {\n    const figureKey = `${meta.dcName}-${meta.dgIndex}-${meta.figureIndex}`;\n    if (setAsideKeys.has(figureKey)) continue; // Lie in Ambush \u2014 deploys later\n    if (game.figurePositions[playerNum][figureKey]) continue; // already deployed\n    const occupied = [];\n    for (const p of [1\x2C 2]) {\n      for (const [k\x2C s] of Object.entries(game.figurePositions[p] || {})) {\n        const dcName = dcNameFromFigureKey(k);\n        const size = game.figureOrientations?.[k] || getFigureSize(dcName);\n        occupied.push(...getFootprintCells(s\x2C size));\n      }\n    }\n    const baseSize = getFigureSize(meta.dcName);\n    const size = baseSize === '2x3' ? '2x3' : baseSize;\n    const zoneSpaces = (zones?.[playerZone] || []).map((s) => String(s).toLowerCase());\n    const { blocking\x2C ignoreBlocking } = getDeployBlockingInfo(game\x2C meta.dcName);\n    const validSpaces = filterValidTopLeftSpaces(zoneSpaces\x2C occupied\x2C size\x2C getFootprintCells\x2C blocking\x2C ignoreBlocking);\n    if (!validSpaces.length) continue;\n    validSpaces.sort((a\x2C b) => {\n      const pa = parseCoord(a)\x2C pb = parseCoord(b);\n      const da = Math.abs(pa.col - oppCx) + Math.abs(pa.row - oppCy);\n      const db = Math.abs(pb.col - oppCx) + Math.abs(pb.row - oppCy);\n      return da - db;\n    });\n    game.figurePositions[playerNum][figureKey] = validSpaces[0];\n    if (baseSize === '2x3') game.figureOrientations[figureKey] = size;\n    placed++;\n  }\n\n  // Refresh the deploy buttons to show updated positions\n  const isInitiative = playerNum === initiativePlayerNum;\n  const idsKey = isInitiative ? 'initiativeDeployMessageIds' : 'nonInitiativeDeployMessageIds';\n  const handId = getHandChannelId(game\x2C playerNum);\n  try {\n    const handChannel = await fetchGameChannel(client\x2C handId);\n    // Delete old deploy messages\n    const toDelete = game[idsKey] || [];\n    for (const msgId of toDelete) {\n      try { await (await handChannel.messages.fetch(msgId)).delete(); } catch {}\n    }\n    game[idsKey] = [];\n    // Re-post deploy buttons with updated positions\n    const { deployRows\x2C doneRow } = getDeployButtonRows(gameId\x2C playerNum\x2C dcList\x2C playerZone\x2C game.figurePositions\x2C game);\n    const DEPLOY_ROWS_PER_MSG = 4;\n    const playerId = getPlayerId(game\x2C playerNum);\n    for (let i = 0; i < deployRows.length; i += DEPLOY_ROWS_PER_MSG) {\n      const chunk = deployRows.slice(i\x2C i + DEPLOY_ROWS_PER_MSG);\n      const isLastChunk = i + DEPLOY_ROWS_PER_MSG >= deployRows.length;\n      const components = isLastChunk ? [...chunk\x2C doneRow] : chunk;\n      const msg = await handChannel.send({\n        content: i === 0 ? `Auto-deployed ${placed} figure(s) to the **${playerZone}** zone entrance. You can re-place any figure\x2C then click **Deployment Completed**.` : null\x2C\n        components\x2C\n      });\n      game[idsKey].push(msg.id);\n    }\n  } catch (err) {\n    console.error('Failed to update deploy UI after auto-deploy:'\x2C err);\n  }\n\n  // Post board update\n  if (game.boardId && game.selectedMap) {\n    try {\n      const boardChannel = await fetchGameChannel(client\x2C game.boardId);\n      const payload = await buildBoardMapPayload(game.gameId\x2C game.selectedMap\x2C game);\n      await boardChannel.send(payload);\n    } catch (err) {\n      console.error('Failed to post board map after auto-deploy:'\x2C err?.message ?? err);\n    }\n  }\n\n  await logGameAction(game\x2C client\x2C `<@${interaction.user.id}> auto-deployed ${placed} figure(s) in the ${playerZone} zone`\x2C { phase: 'DEPLOYMENT'\x2C icon: 'deploy' });\n  saveGames();\n  await interaction.followUp({ content: `Auto-deployed ${placed} figure(s) at the ${playerZone} zone entrance.`\x2C ephemeral: true }).catch(discordCatch);\n}\n\n/**\n * Handle setup attachment select: place one attachment CC on chosen DC. When all attachments placed\x2C call finishSetupAttachments.\n * @param {import('discord.js').StringSelectMenuInteraction} interaction\n * @param {object} ctx - getGame\x2C updateAttachmentMessageForDc\x2C StringSelectMenuBuilder\x2C ActionRowBuilder\x2C getCcShuffleDrawButton\x2C clearPreGameSetup\x2C getInitiativePlayerZoneLabel\x2C logGameAction\x2C client\x2C saveGames\x2C finishSetupAttachments\n */\nexport async function handleSetupAttachTo(interaction\x2C ctx) {\n  const { getGame\x2C logGameAction\x2C client\x2C saveGames } = ctx;\n  const match = interaction.customId.match(/^setup_attach_to_([^_]+)_([12])$/);\n  if (!match) return;\n  const [\x2C gameId\x2C playerNumStr] = match;\n  const playerNum = parseInt(playerNumStr\x2C 10);\n  const game = getGame(gameId);\n  if (!game || !game.setupAttachmentPhase || !game.setupAttachmentPending) {\n    await interaction.followUp({ content: 'Game or setup phase not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const ownerId = getPlayerId(game\x2C playerNum);\n  if (interaction.user.id !== ownerId) {\n    await interaction.followUp({ content: 'Only the owner of this hand can place setup attachments.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const pending = game.setupAttachmentPending[playerNum];\n  if (!pending || pending.length === 0) return;\n  const card = pending[0];\n  const dcMsgId = interaction.values[0];\n  if (!dcMsgId) return;\n\n  // Store choice and show confirmation instead of applying immediately\n  game.pendingAttachConfirm = game.pendingAttachConfirm || {};\n  game.pendingAttachConfirm[playerNum] = { card\x2C dcMsgId };\n\n  // Remove the dropdown from the original message\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  const dcDisplayName = ctx.dcMessageMeta?.get(dcMsgId)?.displayName || dcMsgId;\n  const confirmRow = new ActionRowBuilder().addComponents(\n    new ButtonBuilder()\n      .setCustomId(`attach_confirm_${gameId}_${playerNum}`)\n      .setLabel('Confirm')\n      .setStyle(ButtonStyle.Success)\x2C\n    new ButtonBuilder()\n      .setCustomId(`attach_reselect_${gameId}_${playerNum}`)\n      .setLabel('Choose Different Card')\n      .setStyle(ButtonStyle.Secondary)\x2C\n  );\n  const handId = getHandChannelId(game\x2C playerNum);\n  const handChannel = await fetchGameChannel(client\x2C handId);\n  await handChannel.send({\n    content: `Attach **${card}** to **${dcDisplayName}**?`\x2C\n    components: [confirmRow]\x2C\n  });\n  saveGames();\n}\n\n/**\n * Confirm a pending attachment selection \u2014 apply it and proceed.\n */\nexport async function handleAttachConfirm(interaction\x2C ctx) {\n  const { getGame\x2C logGameAction\x2C client\x2C saveGames\x2C finishSetupAttachments } = ctx;\n  const match = interaction.customId.match(/^attach_confirm_([^_]+)_([12])$/);\n  if (!match) return;\n  const [\x2C gameId\x2C playerNumStr] = match;\n  const playerNum = parseInt(playerNumStr\x2C 10);\n  const game = getGame(gameId);\n  if (!game || !game.setupAttachmentPhase || !game.setupAttachmentPending) return;\n  const ownerId = getPlayerId(game\x2C playerNum);\n  if (interaction.user.id !== ownerId) {\n    await interaction.followUp({ content: 'Only the owner of this hand can confirm.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const confirm = game.pendingAttachConfirm?.[playerNum];\n  if (!confirm) {\n    await interaction.followUp({ content: 'No pending attachment to confirm.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { card\x2C dcMsgId } = confirm;\n  delete game.pendingAttachConfirm[playerNum];\n\n  const pending = game.setupAttachmentPending[playerNum];\n  if (!pending || pending.length === 0 || pending[0] !== card) return;\n\n  await applySetupAttachment(game\x2C playerNum\x2C card\x2C dcMsgId\x2C ctx);\n  pending.shift();\n\n  // Track applied attachments for potential redo\n  game.setupAttachmentApplied = game.setupAttachmentApplied || {};\n  game.setupAttachmentApplied[playerNum] = game.setupAttachmentApplied[playerNum] || [];\n  game.setupAttachmentApplied[playerNum].push({ card\x2C dcMsgId });\n\n  // Remove confirm buttons\n  await interaction.message.edit({ content: interaction.message.content\x2C components: [] }).catch(discordCatch);\n\n  const dcDisplayName = ctx.dcMessageMeta?.get(dcMsgId)?.displayName || 'DC';\n  await logGameAction(game\x2C client\x2C `<@${interaction.user.id}> placed **${card}** on **${dcDisplayName}** (setup).`\x2C { phase: 'SETUP'\x2C icon: 'card'\x2C allowedMentions: { users: [interaction.user.id] } });\n\n  // Auto-attach any subsequent attachments (skip DCs that already have one)\n  const dcList = getDcList(game\x2C playerNum) || [];\n  const dcMsgIds = getDcMessageIds(game\x2C playerNum) || [];\n  const attached = new Set((game.setupAttachmentApplied?.[playerNum] || []).map(a => a.dcMsgId));\n  while (pending.length > 0) {\n    const autoTarget = findAutoAttachTarget(pending[0]\x2C dcList\x2C dcMsgIds\x2C attached);\n    if (!autoTarget) break;\n    const autoCard = pending[0];\n    await applySetupAttachment(game\x2C playerNum\x2C autoCard\x2C autoTarget\x2C ctx);\n    pending.shift();\n    game.setupAttachmentApplied[playerNum].push({ card: autoCard\x2C dcMsgId: autoTarget });\n    attached.add(autoTarget);\n    const autoDisplayName = ctx.dcMessageMeta?.get(autoTarget)?.displayName || 'DC';\n    await logGameAction(game\x2C client\x2C `**${autoCard}** auto-attached to **${autoDisplayName}** (setup).`\x2C { phase: 'SETUP'\x2C icon: 'card' });\n  }\n\n  await _proceedAttachmentPhase(game\x2C gameId\x2C playerNum\x2C interaction\x2C ctx);\n}\n\n/**\n * Re-show the attachment dropdown for the current pending card.\n */\nexport async function handleAttachReselect(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client } = ctx;\n  const match = interaction.customId.match(/^attach_reselect_([^_]+)_([12])$/);\n  if (!match) return;\n  const [\x2C gameId\x2C playerNumStr] = match;\n  const playerNum = parseInt(playerNumStr\x2C 10);\n  const game = getGame(gameId);\n  if (!game || !game.setupAttachmentPhase || !game.setupAttachmentPending) return;\n  const ownerId = getPlayerId(game\x2C playerNum);\n  if (interaction.user.id !== ownerId) {\n    await interaction.followUp({ content: 'Only the owner of this hand can do this.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Clear pending confirm\n  if (game.pendingAttachConfirm?.[playerNum]) delete game.pendingAttachConfirm[playerNum];\n\n  // Remove buttons from confirm message\n  await interaction.message.edit({ content: interaction.message.content\x2C components: [] }).catch(discordCatch);\n\n  const pending = game.setupAttachmentPending[playerNum];\n  if (!pending || pending.length === 0) return;\n\n  await _sendAttachmentDropdown(game\x2C gameId\x2C playerNum\x2C pending[0]\x2C client);\n  saveGames();\n}\n\n/**\n * Confirm all attachments are final \u2014 proceed to game start.\n */\nexport async function handleAttachDoneConfirm(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C finishSetupAttachments\x2C client } = ctx;\n  const match = interaction.customId.match(/^attach_done_confirm_([^_]+)_([12])$/);\n  if (!match) return;\n  const [\x2C gameId\x2C playerNumStr] = match;\n  const playerNum = parseInt(playerNumStr\x2C 10);\n  const game = getGame(gameId);\n  if (!game || !game.setupAttachmentPhase) return;\n  const ownerId = getPlayerId(game\x2C playerNum);\n  if (interaction.user.id !== ownerId) {\n    await interaction.followUp({ content: 'Only the owner of this hand can confirm.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  // Remove buttons\n  await interaction.message.edit({ content: interaction.message.content\x2C components: [] }).catch(discordCatch);\n\n  // Mark this player as confirmed\n  game.setupAttachmentConfirmed = game.setupAttachmentConfirmed || {};\n  game.setupAttachmentConfirmed[playerNum] = true;\n\n  const oppNum = opponentPlayerNum(playerNum);\n  const oppPending = (game.setupAttachmentPending?.[oppNum] || []).length;\n  const oppConfirmed = game.setupAttachmentConfirmed?.[oppNum];\n\n  if (oppPending === 0 && oppConfirmed) {\n    // Both done and confirmed \u2014 clean up redo notices\n    if (game.attachRedoNoticeIds?.length) {\n      const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n      if (generalChannel) {\n        for (const nId of game.attachRedoNoticeIds) {\n          await generalChannel.messages.delete(nId).catch(discordCatch);\n        }\n      }\n    }\n    game.setupAttachmentPhase = false;\n    game.setupAttachmentPending = null;\n    game.setupAttachmentApplied = null;\n    game.setupAttachmentOriginal = null;\n    game.setupAttachmentConfirmed = null;\n    game.pendingAttachConfirm = null;\n    game.attachRedoNoticeIds = null;\n    // Phase gate: attachments confirmed \u2014 wait for both to confirm before drawing CCs\n    const { sendPhaseGateMessages } = ctx;\n    await sendPhaseGateMessages(game\x2C 'attach_done'\x2C ctx);\n  } else {\n    const handId = getHandChannelId(game\x2C playerNum);\n    const handChannel = await fetchGameChannel(client\x2C handId);\n    await handChannel.send({ content: 'Attachments confirmed. Waiting for your opponent to finish placing theirs.' });\n  }\n  saveGames();\n}\n\n/**\n * Redo all attachments \u2014 remove applied attachments\x2C restore original pending list.\n */\nexport async function handleAttachDoneRedo(interaction\x2C ctx) {\n  const { getGame\x2C updateAttachmentMessageForDc\x2C logGameAction\x2C saveGames\x2C client } = ctx;\n  const match = interaction.customId.match(/^attach_done_redo_([^_]+)_([12])$/);\n  if (!match) return;\n  const [\x2C gameId\x2C playerNumStr] = match;\n  const playerNum = parseInt(playerNumStr\x2C 10);\n  const game = getGame(gameId);\n  if (!game || !game.setupAttachmentPhase) return;\n  const ownerId = getPlayerId(game\x2C playerNum);\n  if (interaction.user.id !== ownerId) {\n    await interaction.followUp({ content: 'Only the owner of this hand can redo.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  // Remove buttons\n  await interaction.message.edit({ content: interaction.message.content\x2C components: [] }).catch(discordCatch);\n\n  // Reverse all applied attachments\n  const applied = game.setupAttachmentApplied?.[playerNum] || [];\n  const attachKey = dcAttachmentsKey(playerNum);\n  for (const { card\x2C dcMsgId } of applied) {\n    const arr = game[attachKey]?.[dcMsgId];\n    if (Array.isArray(arr)) {\n      const idx = arr.findIndex(c => cardNameEquals(c\x2C card));\n      if (idx >= 0) arr.splice(idx\x2C 1);\n    }\n    // Reverse Focused on the Kill HP bonus\n    if (cardNameEquals(card\x2C 'Focused on the Kill') && ctx.dcHealthState) {\n      const hs = ctx.dcHealthState.get(dcMsgId);\n      if (hs) {\n        for (let fi = 0; fi < hs.length; fi++) {\n          if (hs[fi]) { hs[fi] = [Math.max(0\x2C hs[fi][0] - 5)\x2C Math.max(1\x2C hs[fi][1] - 5)]; }\n        }\n        ctx.dcHealthState.set(dcMsgId\x2C hs);\n        const dcList = getDcList(game\x2C playerNum) || [];\n        const dcMsgIds = getDcMessageIds(game\x2C playerNum) || [];\n        const didx = dcMsgIds.indexOf(dcMsgId);\n        if (didx >= 0 && dcList[didx]) dcList[didx].healthState = [...hs];\n      }\n    }\n    // Reverse Wookiee Avenger \u2014 put Debts Repaid back in deck from hand\n    if (cardNameEquals(card\x2C 'Wookiee Avenger')) {\n      const handKey = ccHandKey(playerNum);\n      const deckKey = ccDeckKey(playerNum);\n      const hand = game[handKey] || [];\n      const drIdx = hand.indexOf('Debts Repaid');\n      if (drIdx >= 0) {\n        hand.splice(drIdx\x2C 1);\n        game[handKey] = hand;\n        game[deckKey] = [...(game[deckKey] || [])\x2C 'Debts Repaid'];\n        game.wookieeAvengerDrawPenalty = Math.max(0\x2C (game.wookieeAvengerDrawPenalty || 0) - 1);\n      }\n    }\n    // Update DC embed to remove attachment display\n    if (updateAttachmentMessageForDc) {\n      try { await updateAttachmentMessageForDc(game\x2C playerNum\x2C dcMsgId\x2C client); } catch {}\n    }\n  }\n\n  // Restore original pending list\n  game.setupAttachmentPending = game.setupAttachmentPending || {};\n  game.setupAttachmentApplied = game.setupAttachmentApplied || {};\n  const original = game.setupAttachmentOriginal?.[playerNum];\n  if (original) {\n    game.setupAttachmentPending[playerNum] = [...original];\n  }\n  game.setupAttachmentApplied[playerNum] = [];\n  if (game.setupAttachmentConfirmed?.[playerNum]) delete game.setupAttachmentConfirmed[playerNum];\n\n  // Notify both players in general channel\n  const p1Id = getPlayerId(game\x2C 1);\n  const p2Id = getPlayerId(game\x2C 2);\n  const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n  if (generalChannel) {\n    const redoNoticeMsg = await generalChannel.send({\n      content: `<@${p1Id}> <@${p2Id}> \u2014 Attachment placements are being redone. Your play areas will reassemble with the correct attachments once complete.`\x2C\n      allowedMentions: { users: [p1Id\x2C p2Id].filter(Boolean) }\x2C\n    }).catch(() => null);\n    if (redoNoticeMsg) {\n      game.attachRedoNoticeIds = game.attachRedoNoticeIds || [];\n      game.attachRedoNoticeIds.push(redoNoticeMsg.id);\n    }\n  }\n  await logGameAction(game\x2C client\x2C `Player ${playerNum} is redoing attachment placements.`\x2C { phase: 'SETUP'\x2C icon: 'card' });\n\n  // Start auto-attach + dropdown flow for the restored list\n  const pending = game.setupAttachmentPending[playerNum];\n  const dcList = getDcList(game\x2C playerNum) || [];\n  const dcMsgIds = getDcMessageIds(game\x2C playerNum) || [];\n  const attached = new Set((game.setupAttachmentApplied?.[playerNum] || []).map(a => a.dcMsgId));\n  while (pending.length > 0) {\n    const autoTarget = findAutoAttachTarget(pending[0]\x2C dcList\x2C dcMsgIds\x2C attached);\n    if (!autoTarget) break;\n    const autoCard = pending[0];\n    await applySetupAttachment(game\x2C playerNum\x2C autoCard\x2C autoTarget\x2C ctx);\n    pending.shift();\n    game.setupAttachmentApplied[playerNum].push({ card: autoCard\x2C dcMsgId: autoTarget });\n    attached.add(autoTarget);\n    const autoDisplayName = ctx.dcMessageMeta?.get(autoTarget)?.displayName || 'DC';\n    await logGameAction(game\x2C client\x2C `**${autoCard}** auto-attached to **${autoDisplayName}** (setup).`\x2C { phase: 'SETUP'\x2C icon: 'card' });\n  }\n\n  if (pending.length > 0) {\n    await _sendAttachmentDropdown(game\x2C gameId\x2C playerNum\x2C pending[0]\x2C client);\n  } else {\n    // All auto-attached again \u2014 show done confirmation\n    await _sendAttachDonePrompt(game\x2C gameId\x2C playerNum\x2C client);\n  }\n  saveGames();\n}\n\n/**\n * Recovery helper: re-send the attachment dropdown for a player who has pending attachments.\n * Exported for use by recover.js.\n */\nexport async function recoverSetupAttachments(game\x2C gameId\x2C playerNum\x2C client) {\n  const pending = game.setupAttachmentPending?.[playerNum] || [];\n  if (pending.length > 0) {\n    await _sendAttachmentDropdown(game\x2C gameId\x2C playerNum\x2C pending[0]\x2C client);\n  }\n}\n\n/** Helper: send the attachment dropdown for a card. Exported for phase-gate.js. */\nexport async function _sendAttachmentDropdown(game\x2C gameId\x2C playerNum\x2C card\x2C client) {\n  const handId = getHandChannelId(game\x2C playerNum);\n  const handChannel = await fetchGameChannel(client\x2C handId);\n  const dcList = getDcList(game\x2C playerNum) || [];\n  const dcMsgIds = getDcMessageIds(game\x2C playerNum) || [];\n  const restriction = getAttachmentRestriction(card);\n  // DCs that already have an attachment cannot receive another (CRR p.56: "Each Deployment card can have only one Attachment")\n  const alreadyAttached = new Set(\n    (game.setupAttachmentApplied?.[playerNum] || []).map(a => a.dcMsgId)\x2C\n  );\n  const options = dcList.slice(0\x2C 25).map((dc\x2C i) => {\n    const dcName = dc.displayName || dc.dcName || `DC ${i + 1}`;\n    if (alreadyAttached.has(dcMsgIds[i])) return null;\n    // Skirmish upgrades cannot be attachment targets\n    if (isFigurelessDc(dc.dcName)) return null;\n    if (restriction && !restriction.filter(dc.dcName)) return null;\n    return { label: dcName.slice(0\x2C 100)\x2C value: (dcMsgIds[i] || String(i)).toString() };\n  }).filter(Boolean);\n  if (options.length === 0) {\n    // No valid targets \u2014 skip this attachment and move on\n    const pending = game.setupAttachmentPending?.[playerNum] || [];\n    if (pending.length > 0) pending.shift();\n    const restrictionNote = restriction ? ` (${restriction.restrictionText} only)` : '';\n    await handChannel.send({ content: `\u26a0\ufe0f **${card}** has no valid Deployment Card targets${restrictionNote}. Skipping.` });\n    return;\n  }\n  const select = new StringSelectMenuBuilder()\n    .setCustomId(`setup_attach_to_${gameId}_${playerNum}`)\n    .setPlaceholder('Attach to which Deployment Card?')\n    .addOptions(options);\n  const restrictionNote = restriction ? ` *(${restriction.restrictionText} only)*` : '';\n  const pending = game.setupAttachmentPending[playerNum] || [];\n  const ownerId = getPlayerId(game\x2C playerNum);\n  const payload = {\n    content: `<@${ownerId}> **Setup \u2014 place Skirmish Upgrade${pending.length > 1 ? ` (${pending.length} remaining)` : ''}:** **${card}**${restrictionNote}. Choose which Deployment Card to attach it to:`\x2C\n    components: [new ActionRowBuilder().addComponents(select)]\x2C\n    allowedMentions: { users: [ownerId] }\x2C\n  };\n  const imgRel = getDcImagePath(card);\n  if (imgRel) {\n    const imgPath = join(rootDir\x2C imgRel);\n    if (existsSync(imgPath)) {\n      payload.files = [new AttachmentBuilder(imgPath)];\n    }\n  }\n  await handChannel.send(payload);\n}\n\n/** Helper: send the "all done" prompt with confirm/redo. Exported for phase-gate.js. */\nexport async function _sendAttachDonePrompt(game\x2C gameId\x2C playerNum\x2C client) {\n  const handId = getHandChannelId(game\x2C playerNum);\n  const handChannel = await fetchGameChannel(client\x2C handId);\n  const oppNum = opponentPlayerNum(playerNum);\n  const oppPending = (game.setupAttachmentPending?.[oppNum] || []).length;\n  const oppConfirmed = game.setupAttachmentConfirmed?.[oppNum];\n  const waitNote = (oppPending > 0 || !oppConfirmed) ? '\\nWaiting for your opponent to finish placing theirs.' : '';\n  const row = new ActionRowBuilder().addComponents(\n    new ButtonBuilder()\n      .setCustomId(`attach_done_confirm_${gameId}_${playerNum}`)\n      .setLabel('Confirm')\n      .setStyle(ButtonStyle.Success)\x2C\n    new ButtonBuilder()\n      .setCustomId(`attach_done_redo_${gameId}_${playerNum}`)\n      .setLabel('Redo Attachments')\n      .setStyle(ButtonStyle.Secondary)\x2C\n  );\n  await handChannel.send({\n    content: `All attachments placed!${waitNote}`\x2C\n    components: [row]\x2C\n  });\n}\n\n/** Helper: after confirming/applying an attachment\x2C proceed to next or show done prompt. */\nasync function _proceedAttachmentPhase(game\x2C gameId\x2C playerNum\x2C interaction\x2C ctx) {\n  const { saveGames\x2C finishSetupAttachments\x2C client } = ctx;\n  const pending = game.setupAttachmentPending[playerNum];\n\n  if (pending.length > 0) {\n    await _sendAttachmentDropdown(game\x2C gameId\x2C playerNum\x2C pending[0]\x2C client);\n    saveGames();\n    return;\n  }\n\n  // This player's attachments are all placed \u2014 show done prompt\n  const oppNum = opponentPlayerNum(playerNum);\n  const oppPending = (game.setupAttachmentPending?.[oppNum] || []).length;\n  const oppConfirmed = game.setupAttachmentConfirmed?.[oppNum];\n\n  if (oppPending === 0 && oppConfirmed) {\n    // Both done \u2014 just need this player's confirm\n    // Show confirm/redo prompt\n    await _sendAttachDonePrompt(game\x2C gameId\x2C playerNum\x2C client);\n  } else {\n    // Opponent not done yet \u2014 show prompt with waiting note\n    await _sendAttachDonePrompt(game\x2C gameId\x2C playerNum\x2C client);\n  }\n  saveGames();\n}\n
