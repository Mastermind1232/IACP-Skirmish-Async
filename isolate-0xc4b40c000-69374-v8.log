code-creation,Script,9,234601,0x3f05b9290e00,106, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/round.js:1:1,0x3e1e4d0b9060,~
script-source,204,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/round.js,/**\n * Round handlers: end_end_of_round_\x2C end_start_of_round_\n */\nimport { EmbedBuilder\x2C ActionRowBuilder\x2C ButtonBuilder\x2C ButtonStyle } from 'discord.js';\nimport { getDcEffects\x2C getMapData\x2C getFormCards\x2C getCcEffectsData\x2C getMapTokensData as _getMapTokensData } from '../data-loader.js';\nimport { getConfig\x2C getFormsChosenByTeamClawdites } from '../game/figure-config.js';\nimport { cleanupRoundStart } from '../game/activation-state.js';\nimport { reduceHp\x2C healHp\x2C healHpDistributed\x2C applyCondition\x2C filterCondition\x2C dcNameFromFigureKey\x2C parseFigureKey\x2C awardKillVp\x2C awardObjectiveVp\x2C deductVp\x2C grantPowerTokens\x2C grantMovementBank\x2C buildFigureButtonLabel\x2C getMaxPowerTokens } from '../game/index.js';\nimport { processFigureDefeat } from '../engine/defeat-handler.js';\nimport { sendPowerTokenOverflowUI } from './combat.js';\nimport { countSpaces } from '../game/spatial.js';\nimport { edgeKey } from '../game/coords.js';\nimport { cardNameIncludes } from '../game/card-names.js';\nimport { getDeploymentZones\x2C getCcEffect } from '../data-loader.js';\nimport { setRoundPhase\x2C ROUND_PHASES } from '../game/phase.js';\nimport {\n  getPlayerId\x2C getDcList\x2C getDcMessageIds\x2C getPlayAreaId\x2C getHandChannelId\x2C\n  getCcHand\x2C getCcDeck\x2C getCcDiscard\x2C getDcAttachments\x2C\n  setActivatedDcIndices\x2C recomputeActivationCounts\x2C\n  ccHandKey\x2C ccDiscardKey\x2C ccDeckKey\x2C\n  opponentPlayerNum\x2C syncHealthStateToList\x2C\n  getInitiativePlayerNum\x2C\n  removeFigurePosition\x2C\n} from '../game/player-helpers.js';\nimport { checkStartOfRoundPassiveRedraws } from '../game/cc-passive-redraw.js';\nimport { FIGURE_LETTERS\x2C chunkButtonsToRows\x2C truncateLabel } from '../discord/components.js';\nimport { discordCatch\x2C withDiscordRetry } from '../error-handling.js';\nimport { requireGame } from '../utils/guards.js';\nimport { parseCustomId\x2C splitCustomId } from '../discord/custom-id.js';\nimport { fetchGameChannel } from '../discord/channel-helpers.js';\n\n/**\n * Stash pending button customIds on game.pendingSorActions so getAvailableActions\n * can surface them for the AI / selfplay without duplicating button-generation logic.\n * @param {object} game\n * @param {Array} buttons - ButtonBuilder instances or objects with customId/custom_id\n * @param {string} label - Human-readable label for the effect\n * @param {number} playerNum - Owning player\n */\nfunction _stashSorActions(game\x2C buttons\x2C label\x2C playerNum) {\n  game.pendingSorActions = game.pendingSorActions || [];\n  const newActions = buttons.map(b => ({\n    type: 'sor_effect'\x2C\n    customId: b.data?.custom_id ?? b.customId ?? b\x2C\n    description: `SOR: ${label}`\x2C\n    playerNum\x2C\n  }));\n  game.pendingSorActions.push(...newActions);\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C replyIfGameEnded\x2C getPlayerZoneLabel\x2C logGameAction\x2C updateHandChannelMessages\x2C saveGames\x2C dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState\x2C isDepletedRemovedFromGame\x2C buildDcEmbedAndFiles\x2C getDcPlayAreaComponents\x2C countTerminalsControlledByPlayer\x2C isFigureInDeploymentZone\x2C checkWinConditions\x2C getMapTokensData\x2C getSpaceController\x2C getMissionRules\x2C runEndOfRoundRules\x2C getFiguresOnOrAdjacentToSpace\x2C runNpcThugActivation\x2C applyNpcDamageToFigure\x2C getMapData\x2C getMapRegistry\x2C filterMapSpacesByBounds\x2C getInitiativePlayerZoneLabel\x2C updateHandVisualMessage\x2C buildHandDisplayPayload\x2C sendRoundActivationPhaseMessage\x2C buildBoardMapPayload\x2C postDevaronDoorButtons\x2C postDevaronCratePushPrompts\x2C postKryknaPushButtons\x2C client\n */\nexport async function handleEndEndOfRound(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    replyIfGameEnded\x2C\n    getPlayerZoneLabel\x2C\n    logGameAction\x2C\n    updateHandChannelMessages\x2C\n    saveGames\x2C\n    dcMessageMeta\x2C\n    dcExhaustedState\x2C\n    dcHealthState\x2C\n    isDepletedRemovedFromGame\x2C\n    renderDcEmbed\x2C\n    getDcPlayAreaComponents\x2C\n    countTerminalsControlledByPlayer\x2C\n    isFigureInDeploymentZone\x2C\n    checkWinConditions\x2C\n    getMapTokensData\x2C\n    getSpaceController\x2C\n    getMissionRules\x2C\n    runEndOfRoundRules\x2C\n    runStartOfRoundRules\x2C\n    getFiguresOnOrAdjacentToSpace\x2C\n    runNpcThugActivation\x2C\n    runNpcKryknaActivation\x2C\n    applyNpcDamageToFigure\x2C\n    getMapData\x2C\n    getMapRegistry\x2C\n    filterMapSpacesByBounds\x2C\n    getInitiativePlayerZoneLabel\x2C\n    updateHandVisualMessage\x2C\n    buildHandDisplayPayload\x2C\n    sendRoundActivationPhaseMessage\x2C\n    buildBoardMapPayload\x2C\n    postDevaronDoorButtons\x2C\n    postDevaronCratePushPrompts\x2C\n    postKryknaPushButtons\x2C\n    client\x2C\n  } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'end_end_of_round_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (await replyIfGameEnded(game\x2C interaction)) return;\n  if (!game.endOfRoundWhoseTurn) {\n    await interaction.followUp({ content: 'Not in End of Round window.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (interaction.user.id !== game.endOfRoundWhoseTurn) {\n    await interaction.followUp({ content: "It's not your turn in the End of Round window."\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const initiativeId = game.initiativePlayerId;\n  const otherId = initiativeId === game.player1Id ? game.player2Id : game.player1Id;\n  if (interaction.user.id === initiativeId) {\n    game.endOfRoundWhoseTurn = otherId;\n    const initNum = initiativeId === game.player1Id ? 1 : 2;\n    const otherNum = 3 - initNum;\n    const otherZone = getPlayerZoneLabel(game\x2C otherId);\n    await logGameAction(game\x2C client\x2C `**End of Round** \u2014 2. Initiative done \u2713. 3. <@${otherId}> (${otherZone}Player ${otherNum}) \u2014 your turn for end-of-round effects. Click **End 'End of Round' window** in your Hand when done.`\x2C { phase: 'ROUND'\x2C icon: 'round'\x2C allowedMentions: { users: [otherId] } });\n    await updateHandChannelMessages(game\x2C client);\n    saveGames();\n    return;\n  }\n  game.endOfRoundWhoseTurn = null;\n\n  // Phase gate: both players confirm before advancing to status phase\n  const { sendPhaseGateMessages: _eorSendGate } = ctx;\n  if (_eorSendGate) {\n    if (interaction?.message) await interaction.message.edit({ components: [] }).catch(discordCatch);\n    await _eorSendGate(game\x2C 'post_end_of_round'\x2C ctx);\n    saveGames();\n    return;\n  }\n  // Fallback: no gate function available\x2C run status phase directly\n  await _runStatusPhaseLogic(game\x2C gameId\x2C interaction\x2C ctx);\n}\n\n/**\n * Extracted status phase logic \u2014 called after post_end_of_round gate clears\n * or directly from handleEndEndOfRound if no gate function is available.\n * Also exported so phase-gate dispatchPhaseAdvance can call it.\n */\nexport async function runStatusPhaseAfterEndOfRound(game\x2C ctx) {\n  const gameId = game.gameId;\n  await _runStatusPhaseLogic(game\x2C gameId\x2C null\x2C ctx);\n}\n\nasync function _runStatusPhaseLogic(game\x2C gameId\x2C interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    replyIfGameEnded\x2C\n    getPlayerZoneLabel\x2C\n    logGameAction\x2C\n    updateHandChannelMessages\x2C\n    saveGames\x2C\n    dcMessageMeta\x2C\n    dcExhaustedState\x2C\n    dcHealthState\x2C\n    isDepletedRemovedFromGame\x2C\n    renderDcEmbed\x2C\n    getDcPlayAreaComponents\x2C\n    countTerminalsControlledByPlayer\x2C\n    isFigureInDeploymentZone\x2C\n    checkWinConditions\x2C\n    getMapTokensData\x2C\n    getSpaceController\x2C\n    getMissionRules\x2C\n    runEndOfRoundRules\x2C\n    runStartOfRoundRules\x2C\n    getFiguresOnOrAdjacentToSpace\x2C\n    runNpcThugActivation\x2C\n    runNpcKryknaActivation\x2C\n    applyNpcDamageToFigure\x2C\n    getMapData: getMapDataFn\x2C\n    getMapRegistry\x2C\n    filterMapSpacesByBounds\x2C\n    getInitiativePlayerZoneLabel\x2C\n    updateHandVisualMessage\x2C\n    buildHandDisplayPayload\x2C\n    sendRoundActivationPhaseMessage\x2C\n    buildBoardMapPayload\x2C\n    postDevaronDoorButtons\x2C\n    postDevaronCratePushPrompts\x2C\n    postKryknaPushButtons\x2C\n    postFluctuationSwapButtons\x2C\n    client\x2C\n  } = ctx;\n\n  game.dcFinishedPinged = {};\n  game.pendingEndTurn = {};\n  // G102: Ready (un-exhaust) all Skirmish Upgrades BEFORE End of Round effects\x2C\n  // so cards like Zillo Technique can be used during EOR triggers.\n  if (game.exhaustedSkirmishUpgrades) {\n    for (const msgId of Object.keys(game.exhaustedSkirmishUpgrades)) {\n      delete game.exhaustedSkirmishUpgrades[msgId];\n    }\n  }\n  // Stun is NOT cleared at end of round \u2014 figure must spend 1 action to remove it (rules: STUNNED L2759-2762).\n  // Weakened is NOT cleared here \u2014 rules say "discarded at the end of a figure's activation" only.\n  // Disarm permanent Weakened lock: clear at end of round (Disarm card leaves play at end of round).\n  game.disarmPermanentWeakened = {};\n\n  // \u2550\u2550 STEP 1: Ready Cards (rules: STATUS PHASE IN A SKIRMISH L2714-2715) \u2550\u2550\n  // SU ready already done above (L170-176). Now ready all DCs (un-exhaust).\n  for (const [msgId\x2C meta] of dcMessageMeta) {\n    if (meta.gameId !== gameId) continue;\n    if (isDepletedRemovedFromGame(game\x2C msgId)) continue;\n    dcExhaustedState.set(msgId\x2C false);\n    if (game.movementBank?.[msgId]) delete game.movementBank[msgId];\n    if (game.dcActionsData?.[msgId]) delete game.dcActionsData[msgId];\n    if (game.exhaustedSkirmishUpgrades?.[msgId]) delete game.exhaustedSkirmishUpgrades[msgId];\n    try {\n      const chId = getPlayAreaId(game\x2C meta.playerNum);\n      const ch = await fetchGameChannel(client\x2C chId);\n      const msg = await ch.messages.fetch(msgId);\n      const { embed\x2C files } = await renderDcEmbed(game\x2C msgId\x2C ctx\x2C { exhausted: false });\n      const components = getDcPlayAreaComponents(msgId\x2C false\x2C game\x2C meta.dcName);\n      await msg.edit({ embeds: [embed]\x2C files\x2C components }).catch(discordCatch);\n    } catch (err) {\n      console.error('Failed to ready DC embed:'\x2C err);\n    }\n  }\n  // Regenerate the board map so condition icons and updated health are reflected\n  if (buildBoardMapPayload && game.boardId && game.selectedMap) {\n    try {\n      const boardChannel = await fetchGameChannel(client\x2C game.boardId);\n      const payload = await buildBoardMapPayload(gameId\x2C game.selectedMap\x2C game);\n      await withDiscordRetry(() => boardChannel.send(payload));\n    } catch (err) {\n      console.error('Failed to refresh board at end of round:'\x2C err);\n    }\n  }\n  for (const pn of [1\x2C 2]) {\n    setActivatedDcIndices(game\x2C pn\x2C []);\n    recomputeActivationCounts(game\x2C pn);\n  }\n\n  // \u2550\u2550 STEP 2: Draw Command Cards (rules: STATUS PHASE IN A SKIRMISH L2716-2717) \u2550\u2550\n  const mapId = game.selectedMap?.id;\n  const p1Terminals = mapId ? countTerminalsControlledByPlayer(game\x2C 1\x2C mapId) : 0;\n  const p2Terminals = mapId ? countTerminalsControlledByPlayer(game\x2C 2\x2C mapId) : 0;\n  // Rebel High Command: draw 1 additional CC at end of each round\n  const p1HasRHC = (getDcList(game\x2C 1) || []).some(dc => (dc.dcName || dc) === '[Rebel High Command]');\n  const p2HasRHC = (getDcList(game\x2C 2) || []).some(dc => (dc.dcName || dc) === '[Rebel High Command]');\n  let p1DrawCount = 1 + p1Terminals + (p1HasRHC ? 1 : 0);\n  let p2DrawCount = 1 + p2Terminals + (p2HasRHC ? 1 : 0);\n  // Channel the Force: draw 1 fewer\x2C then search deck for FORCE USER CC\n  const p1HasCtF = (getDcList(game\x2C 1) || []).some(dc => (dc.dcName || dc) === '[Channel the Force]');\n  const p2HasCtF = (getDcList(game\x2C 2) || []).some(dc => (dc.dcName || dc) === '[Channel the Force]');\n  // Check if not already exhausted\n  const _ctfExhCheck = (pn) => {\n    const dcList = getDcList(game\x2C pn) || [];\n    const dcMsgIds = getDcMessageIds(game\x2C pn) || [];\n    for (let i = 0; i < dcList.length; i++) {\n      if ((dcList[i]?.dcName || dcList[i]) === '[Channel the Force]') {\n        const mid = dcMsgIds[i];\n        if (mid && !cardNameIncludes(game.exhaustedSkirmishUpgrades?.[mid]\x2C 'Channel the Force')) return mid;\n      }\n    }\n    return null;\n  };\n  const p1CtFMsgId = p1HasCtF ? _ctfExhCheck(1) : null;\n  const p2CtFMsgId = p2HasCtF ? _ctfExhCheck(2) : null;\n  if (p1CtFMsgId && p1DrawCount > 0) p1DrawCount = Math.max(0\x2C p1DrawCount - 1);\n  if (p2CtFMsgId && p2DrawCount > 0) p2DrawCount = Math.max(0\x2C p2DrawCount - 1);\n  const hadCutLines = !!game.noCommandDrawThisRound;\n  if (game.noCommandDrawThisRound) {\n    p1DrawCount = 0;\n    p2DrawCount = 0;\n    game.noCommandDrawThisRound = false;\n  }\n\n  // Data Theft: return stolen card to opponent's discard if still in hand at end of round\n  if (game.dataTheftStolenCard) {\n    const dt = game.dataTheftStolenCard;\n    const dtHandKey = ccHandKey(dt.playerNum);\n    const dtOppNum = opponentPlayerNum(dt.playerNum);\n    const dtOppDiscardKey = ccDiscardKey(dtOppNum);\n    const dtHand = game[dtHandKey] || [];\n    const dtIdx = dtHand.indexOf(dt.cardName);\n    if (dtIdx >= 0) {\n      dtHand.splice(dtIdx\x2C 1);\n      game[dtHandKey] = dtHand;\n      game[dtOppDiscardKey] = (game[dtOppDiscardKey] || []).concat([dt.cardName]);\n      await logGameAction(game\x2C client\x2C `\ud83d\udccb **Data Theft** \u2014 **${dt.cardName}** returned to opponent's discard (unplayed).`\x2C { phase: 'ROUND' });\n    }\n    game.dataTheftStolenCard = null;\n  }\n\n  const p1Deck = game.player1CcDeck || [];\n  const p2Deck = game.player2CcDeck || [];\n  const p1Drawn = [];\n  const p2Drawn = [];\n  for (let i = 0; i < p1DrawCount && p1Deck.length > 0; i++) {\n    const drawn = p1Deck.shift();\n    p1Drawn.push(drawn);\n  }\n  game.player1CcHand = [...(game.player1CcHand || [])\x2C ...p1Drawn];\n  game.player1CcDeck = p1Deck;\n  for (let i = 0; i < p2DrawCount && p2Deck.length > 0; i++) {\n    const drawn = p2Deck.shift();\n    p2Drawn.push(drawn);\n  }\n  game.player2CcHand = [...(game.player2CcHand || [])\x2C ...p2Drawn];\n  game.player2CcDeck = p2Deck;\n\n  // Channel the Force: search deck for FORCE USER CC\x2C add to hand\x2C shuffle\x2C suffer Strain\n  for (const _ctfPn of [1\x2C 2]) {\n    const _ctfMid = _ctfPn === 1 ? p1CtFMsgId : p2CtFMsgId;\n    if (!_ctfMid || hadCutLines) continue;\n    // Exhaust the card\n    game.exhaustedSkirmishUpgrades = game.exhaustedSkirmishUpgrades || {};\n    game.exhaustedSkirmishUpgrades[_ctfMid] = [...(game.exhaustedSkirmishUpgrades[_ctfMid] || [])\x2C 'Channel the Force'];\n    // Find FORCE USER cards in deck\n    const _ctfDeckKey = _ctfPn === 1 ? 'player1CcDeck' : 'player2CcDeck';\n    const _ctfDeck = game[_ctfDeckKey] || [];\n    const _ctfCcEffData = getCcEffectsData?.()?.cards || {};\n    const _ctfForceCards = [];\n    for (let ci = 0; ci < _ctfDeck.length; ci++) {\n      const ccName = _ctfDeck[ci];\n      const ccEff = _ctfCcEffData[ccName];\n      const playableBy = String(ccEff?.playableBy || '').toUpperCase();\n      if (playableBy.includes('FORCE USER')) _ctfForceCards.push({ name: ccName\x2C deckIdx: ci });\n    }\n    if (_ctfForceCards.length === 0) {\n      await logGameAction(game\x2C client\x2C `**Channel the Force** \u2014 P${_ctfPn} searched deck but found no FORCE USER Command cards.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n      continue;\n    }\n    // Dedupe by card name for button display\n    const _ctfUnique = [...new Map(_ctfForceCards.map(c => [c.name\x2C c])).values()];\n    const handChId = getHandChannelId(game\x2C _ctfPn);\n    if (handChId) {\n      try {\n        const handCh = await fetchGameChannel(client\x2C handChId);\n        const btns = _ctfUnique.slice(0\x2C 20).map((c\x2C i) =>\n          new ButtonBuilder()\n            .setCustomId(`ctf_pick_${gameId}_${_ctfPn}_${i}`)\n            .setLabel(truncateLabel(c.name))\n            .setStyle(ButtonStyle.Primary)\n        );\n        const rows = chunkButtonsToRows(btns);\n        game[`pendingChannelTheForce_p${_ctfPn}`] = { cards: _ctfUnique };\n        await handCh.send({\n          content: `**Channel the Force** \u2014 Choose a FORCE USER Command card from your deck to add to your hand:`\x2C\n          components: rows.slice(0\x2C 5)\x2C\n        });\n      } catch (err) {\n        console.error('Channel the Force pick error:'\x2C err);\n      }\n    }\n  }\n\n  // \u2550\u2550 STEP 3: End of Round Effects (rules: STATUS PHASE IN A SKIRMISH L2718) \u2550\u2550\n  // DC ability EoR effects\n  const dcEffects = getDcEffects();\n  // Regenerate (Bossk): recover 2 HP and discard Bleed at end of round\n  for (const [msgId\x2C meta] of dcMessageMeta) {\n    if (meta.gameId !== gameId) continue;\n    if (isDepletedRemovedFromGame(game\x2C msgId)) continue;\n    const eff = dcEffects[meta.dcName] || dcEffects[meta.dcName?.replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n    if (!(eff?.specialAbilityIds || []).includes('regenerate_bossk')) continue;\n    const { totalRecovered } = healHpDistributed(dcHealthState\x2C game\x2C msgId\x2C 2\x2C meta.playerNum);\n    if (totalRecovered > 0) {\n      await logGameAction(game\x2C client\x2C `\u267b\ufe0f **Regenerate** \u2014 **${meta.dcName}** recovered ${totalRecovered} HP.`\x2C { phase: 'ROUND'\x2C icon: 'round' });\n    }\n    // Discard Bleed\n    for (const fk of Object.keys(game.figureConditions || {})) {\n      if (!fk.startsWith(meta.dcName + '-')) continue;\n      filterCondition(game\x2C fk\x2C 'Bleed');\n    }\n  }\n  // Hardy (Trandoshan Hunter Elite): discard all HARMFUL conditions at end of round\n  for (const [msgId\x2C meta] of dcMessageMeta) {\n    if (meta.gameId !== gameId) continue;\n    if (isDepletedRemovedFromGame(game\x2C msgId)) continue;\n    const _hardyEff = dcEffects[meta.dcName] || dcEffects[meta.dcName?.replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n    if (!(_hardyEff?.passives || []).includes('Hardy')) continue;\n    const HARMFUL = ['Bleed'\x2C 'Stun'\x2C 'Weaken'];\n    let cleared = false;\n    for (const fk of Object.keys(game.figureConditions || {})) {\n      if (!fk.startsWith(meta.dcName + '-')) continue;\n      const before = game.figureConditions[fk]?.length || 0;\n      for (const h of HARMFUL) filterCondition(game\x2C fk\x2C h);\n      if ((game.figureConditions[fk]?.length || 0) < before) cleared = true;\n    }\n    if (cleared) {\n      await logGameAction(game\x2C client\x2C `\ud83d\udcaa **Hardy** \u2014 **${meta.dcName}** discarded all harmful conditions at end of round.`\x2C { phase: 'ROUND'\x2C icon: 'round' });\n    }\n  }\n\n  // What's Yours is Mine (Hondo): at end of round\x2C if in opponent's deployment zone\x2C steal 2 VP\n  {\n    const _wymEff = getDcEffects() || {};\n    for (const pn of [1\x2C 2]) {\n      const dcList = getDcList(game\x2C pn) || [];\n      const msgIds = getDcMessageIds(game\x2C pn) || [];\n      for (let i = 0; i < dcList.length; i++) {\n        const dc = dcList[i];\n        if (!dc || dc.defeated) continue;\n        const eff = _wymEff[dc.dcName] || _wymEff[dc.dcName?.replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n        if (!(eff?.specialAbilityIds || []).includes('whats_yours_is_mine_hondo')) continue;\n        const mid = msgIds[i];\n        if (!mid) continue;\n        const ownerId = getPlayerId(game\x2C pn);\n        const oppNum = opponentPlayerNum(pn);\n        // Auto-check if any figure of this DC is in the opponent's deployment zone\n        const mapId = game.selectedMap?.id;\n        if (mapId && isFigureInDeploymentZone) {\n          // Check if any figure of this DC is in the OPPONENT's deployment zone\n          const _wymFigPos = game.figurePositions?.[pn] || {};\n          let _wymInOppZone = false;\n          for (const fk of Object.keys(_wymFigPos)) {\n            if (!fk.startsWith(dc.dcName + '-')) continue;\n            if (!_wymFigPos[fk]) continue;\n            // isFigureInDeploymentZone checks if figure is in their OWN zone\x2C so we need to check oppNum's zone manually\n            const _wymZoneData = getDeploymentZones()[mapId];\n            if (!_wymZoneData) break;\n            const _wymInitPn = getInitiativePlayerNum(game);\n            const _wymOppZone = oppNum === _wymInitPn ? game.deploymentZoneChosen : (game.deploymentZoneChosen === 'red' ? 'blue' : 'red');\n            const _wymOppSpaces = new Set((_wymZoneData[_wymOppZone] || []).map(s => String(s).toLowerCase()));\n            if (_wymOppSpaces.has(String(_wymFigPos[fk]).toLowerCase())) { _wymInOppZone = true; break; }\n          }\n          if (_wymInOppZone) {\n            // Steal 2 VP: deduct from opponent\x2C add to owner\n            const _wymOppVpKey = oppNum === 1 ? 'player1VP' : 'player2VP';\n            const _wymSteal = Math.min(2\x2C game[_wymOppVpKey]?.total || 0);\n            deductVp(game\x2C oppNum\x2C _wymSteal);\n            awardObjectiveVp(game\x2C pn\x2C _wymSteal);\n            await logGameAction(game\x2C client\x2C `\ud83d\udcb0 **What's Yours is Mine** \u2014 **${dc.displayName || dc.dcName}** is in the opponent's deployment zone! Stole **${_wymSteal} VP** from Player ${oppNum}.`\x2C { phase: 'ROUND'\x2C icon: 'round' });\n            await checkWinConditions(game\x2C client);\n          } else {\n            await logGameAction(game\x2C client\x2C `\ud83d\udcb0 **What's Yours is Mine** \u2014 **${dc.displayName || dc.dcName}** is not in the opponent's deployment zone. No VP stolen.`\x2C { phase: 'ROUND'\x2C icon: 'round' });\n          }\n        }\n      }\n    }\n  }\n\n  // Self-Destruct Probe: prompt each player who has a live Probe Droid DC\n  const _sdpEffs = getDcEffects();\n  for (const [_pNum\x2C _getDcIds\x2C _getDcListF] of [[1\x2C () => game.p1DcMessageIds\x2C () => game.p1DcList]\x2C [2\x2C () => game.p2DcMessageIds\x2C () => game.p2DcList]]) {\n    const _sdpIds = _getDcIds() || [];\n    const _sdpList = _getDcListF() || [];\n    for (let _i = 0; _i < _sdpIds.length; _i++) {\n      const _probeMsgId = _sdpIds[_i];\n      if (!_probeMsgId) continue;\n      const _probeDc = _sdpList[_i];\n      if (!_probeDc || _probeDc.defeated) continue;\n      const _probeEff = _sdpEffs[_probeDc.dcName] || _sdpEffs[_probeDc.dcName?.replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n      if (!(_probeEff?.specialAbilityIds || []).includes('self_destruct_probe')) continue;\n      const _probeOwnerId = getPlayerId(game\x2C _pNum);\n      const _sdpRow = new ActionRowBuilder().addComponents(\n        new ButtonBuilder().setCustomId(`self_destruct_probe_use_${gameId}_${_probeMsgId}`).setLabel('Use Self-Destruct').setStyle(ButtonStyle.Danger)\x2C\n        new ButtonBuilder().setCustomId(`self_destruct_probe_skip_${gameId}_${_probeMsgId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary)\x2C\n      );\n      await logGameAction(game\x2C client\x2C `<@${_probeOwnerId}> **Self-Destruct** (${_probeDc.displayName || _probeDc.dcName}) \u2014 use at end of round?`\x2C {\n        components: [_sdpRow]\x2C\n        allowedMentions: { users: [_probeOwnerId] }\x2C\n      });\n    }\n  }\n\n  // Apply end-of-round self damage (e.g. Blaze of Glory)\n  const eorSelfDamage = game.endOfRoundSelfDamage;\n  if (eorSelfDamage && typeof eorSelfDamage === 'object') {\n    for (const playerNum of [1\x2C 2]) {\n      const entry = eorSelfDamage[playerNum];\n      if (!entry || typeof entry.damage !== 'number') continue;\n      const msgId = entry.msgId;\n      if (!msgId || !dcMessageMeta.get(msgId)) continue;\n      const { wasDefeated: _eorDied } = reduceHp(dcHealthState\x2C game\x2C msgId\x2C 0\x2C entry.damage\x2C playerNum);\n      const meta = dcMessageMeta.get(msgId);\n      const displayName = meta?.displayName || meta?.dcName || 'Figure';\n      await logGameAction(game\x2C client\x2C `**End of round:** ${displayName} suffered ${entry.damage} Damage (e.g. Blaze of Glory).`\x2C { phase: 'ROUND'\x2C icon: 'round' });\n      if (_eorDied) {\n        const _eorDcName = meta?.dcName || 'Figure';\n        const _eorDgMatch = (meta?.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/);\n        const _eorDgIdx = _eorDgMatch ? _eorDgMatch[1] : '0';\n        const _eorFigKey = `${_eorDcName.replace(/\\s*\\[.*\\]\\s*$/\x2C '').trim()}-${_eorDgIdx}-0`;\n        const _eorDcIds = getDcMessageIds(game\x2C playerNum) || [];\n        const _eorIdx = _eorDcIds.indexOf(msgId);\n        await processFigureDefeat(game\x2C {\n          defeatedPlayerNum: playerNum\x2C\n          figureKey: _eorFigKey\x2C\n          attackerPlayerNum: playerNum\x2C\n          msgId\x2C\n          dcIdx: _eorIdx\x2C\n          dcName: _eorDcName\x2C\n          displayName\x2C\n          source: 'Blaze of Glory'\x2C\n          awardVp: false\x2C\n        }\x2C {\n          removeFigurePosition\x2C\n          calculateKillVp: () => 0\x2C\n          awardKillVp\x2C\n          dcNameFromFigureKey\x2C\n          logGameAction\x2C\n          client\x2C\n          checkWinConditions\x2C\n        });\n      }\n    }\n    game.endOfRoundSelfDamage = {};\n  }\n  // Second Chance: end-of-round \u2014 recover 2 Damage for any DC that still has Second Chance\x2C then discard\n  if (game.secondChanceDcMsgId && typeof game.secondChanceDcMsgId === 'object') {\n    for (const [msgId\x2C pn] of Object.entries(game.secondChanceDcMsgId)) {\n      const meta = dcMessageMeta.get(msgId);\n      if (!meta) continue;\n      const healthState = dcHealthState.get(msgId);\n      if (!healthState) continue;\n      for (let fi = 0; fi < healthState.length; fi++) {\n        const hp = healthState[fi];\n        if (!Array.isArray(hp)) continue;\n        const [cur\x2C max] = hp;\n        const damage = (max ?? cur) - (cur ?? 0);\n        if (damage <= 0) continue;\n        const heal = Math.min(2\x2C damage);\n        healthState[fi] = [(cur ?? 0) + heal\x2C max];\n        dcHealthState.set(msgId\x2C healthState);\n        syncHealthStateToList(game\x2C pn\x2C msgId\x2C healthState);\n        await logGameAction(game\x2C client\x2C `**Second Chance** (end of round) \u2014 **${meta.displayName || meta.dcName}** recovered ${heal} Damage. Card discarded.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n        break; // only heal first damaged figure\n      }\n    }\n    game.secondChanceDcMsgId = {};\n  }\n  // Adrenaline: deal 5 Damage then revert +5 maxHp bonus for each boosted WOOKIEE\n  if (game.adrenalineBonuses && typeof game.adrenalineBonuses === 'object') {\n    for (const [msgId\x2C info] of Object.entries(game.adrenalineBonuses)) {\n      const pn = info.playerNum;\n      if (!dcMessageMeta.get(msgId)) continue;\n      const healthState = dcHealthState.get(msgId);\n      if (!healthState) continue;\n      for (let fi = 0; fi < healthState.length; fi++) {\n        if (!Array.isArray(healthState[fi])) continue;\n        const [cur\x2C max] = healthState[fi];\n        const curHp = cur ?? max ?? 0;\n        const maxHp = max ?? cur ?? 0;\n        // 1. Suffer 5 damage\n        const afterDamage = Math.max(0\x2C curHp - 5);\n        // 2. Revert the +5 max HP bonus\n        const newMax = Math.max(0\x2C maxHp - 5);\n        // Clamp current to new max\n        const newCur = Math.min(afterDamage\x2C newMax);\n        healthState[fi] = [newCur\x2C newMax];\n      }\n      dcHealthState.set(msgId\x2C healthState);\n      // Sync to dcList\n      const dcIds = getDcMessageIds(game\x2C pn) || [];\n      const dcListArr = getDcList(game\x2C pn) || [];\n      const idx = dcIds.indexOf(msgId);\n      if (idx >= 0 && dcListArr[idx]) dcListArr[idx].healthState = [...healthState];\n      // Check for defeat