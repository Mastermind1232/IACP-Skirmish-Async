code-creation,Script,9,310366,0x3f05b92a1f98,324, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/map-renderer.js:1:1,0x33c468593968,~
script-source,262,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/map-renderer.js,/**\n * Renders IA Skirmish maps with coordinate grid overlay (a1\x2C b2\x2C etc.)\n * Uses Vassal grid params from map-registry.json\n */\n\nimport { createCanvas\x2C loadImage\x2C registerFont } from 'canvas';\nimport { readFileSync\x2C existsSync } from 'fs';\nimport { join\x2C dirname\x2C resolve } from 'path';\nimport { fileURLToPath } from 'url';\nimport { parseCoord } from './game/coords.js';\n\nconst __dirname = dirname(fileURLToPath(import.meta.url));\nconst rootDir = join(__dirname\x2C '..');\n\n// Register DejaVu Sans for reliable text rendering (sans-serif often fails on headless/servers)\nconst FONT_FAMILY = 'DejaVu Sans';\ntry {\n  const ttfDir = resolve(rootDir\x2C 'node_modules'\x2C 'dejavu-fonts-ttf'\x2C 'ttf');\n  const sansPath = resolve(ttfDir\x2C 'DejaVuSans.ttf');\n  const boldPath = resolve(ttfDir\x2C 'DejaVuSans-Bold.ttf');\n  if (existsSync(sansPath)) {\n    registerFont(sansPath\x2C { family: FONT_FAMILY\x2C weight: 'normal' });\n  }\n  if (existsSync(boldPath)) {\n    registerFont(boldPath\x2C { family: FONT_FAMILY\x2C weight: 'bold' });\n  }\n} catch (err) {\n  console.warn('Map renderer: could not register DejaVu fonts\x2C falling back to sans-serif:'\x2C err.message);\n}\n\n/** Try subfolder first (e.g. tokens/ maps/)\x2C then root. pathOrFilename can be "vassal_extracted/images/X" or "X.gif". */\nfunction resolveImagePath(pathOrFilename\x2C subfolder) {\n  const filename = pathOrFilename.split(/[/\\\\]/).pop() || pathOrFilename;\n  const base = join(rootDir\x2C 'vassal_extracted'\x2C 'images');\n  const inSub = join(base\x2C subfolder\x2C filename);\n  if (existsSync(inSub)) return join('vassal_extracted'\x2C 'images'\x2C subfolder\x2C filename).replace(/\\\\/g\x2C '/');\n  const inRoot = join(base\x2C filename);\n  if (existsSync(inRoot)) return join('vassal_extracted'\x2C 'images'\x2C filename).replace(/\\\\/g\x2C '/');\n  return pathOrFilename;\n}\n\nlet registryCache = null;\nlet tokenImagesConfig = null;\nlet mapSpacesCache = null;\n\n/** Returns a lowercase Set of on-map coordinates for grid label filtering. */\nfunction getOnMapCoordSet(mapId) {\n  if (!mapSpacesCache) {\n    try {\n      mapSpacesCache = JSON.parse(readFileSync(join(rootDir\x2C 'data'\x2C 'map-spaces.json')\x2C 'utf8'));\n    } catch {\n      mapSpacesCache = { maps: {} };\n    }\n  }\n  const raw = mapSpacesCache?.maps?.[mapId];\n  const spaces = raw?.spaces || [];\n  return new Set(spaces.map((s) => String(s).toLowerCase()));\n}\n\nfunction getTokenImagesConfig() {\n  try {\n    tokenImagesConfig = JSON.parse(readFileSync(join(rootDir\x2C 'data'\x2C 'token-images.json')\x2C 'utf8'));\n  } catch {\n    tokenImagesConfig = tokenImagesConfig || {};\n  }\n  return tokenImagesConfig;\n}\n\nfunction getRegistry() {\n  if (!registryCache) {\n    const path = join(rootDir\x2C 'data'\x2C 'map-registry.json');\n    registryCache = JSON.parse(readFileSync(path\x2C 'utf8'));\n  }\n  return registryCache;\n}\n\n/** Clear in-memory caches so next render uses fresh data (e.g. after git pull). Call from Refresh All. */\nexport function clearMapRendererCache() {\n  registryCache = null;\n  tokenImagesConfig = null;\n  mapSpacesCache = null;\n}\n\nfunction getMap(mapId) {\n  const { maps } = getRegistry();\n  return maps.find((m) => m.id === mapId) || maps.find((m) => m.name.toLowerCase().includes(mapId.toLowerCase()));\n}\n\n/** Column index \u2192 letter (0\u2192A\x2C 1\u2192B\x2C ...\x2C 25\u2192Z\x2C 26\u2192AA) */\nfunction colToLetter(col) {\n  if (col < 26) return String.fromCharCode(65 + col);\n  return colToLetter(Math.floor(col / 26) - 1) + colToLetter(col % 26);\n}\n\n/**\n * Renders a map with coordinate grid overlay.\n * @param {string} mapId - Map ID from registry (e.g. 'training-ground')\n * @param {Object} options\n * @param {Array<{id: string\x2C coord: string\x2C label?: string\x2C color?: string}>} [options.figures] - Figure positions\n * @param {boolean} [options.showGrid=true] - Draw coordinate labels\n * @param {number} [options.maxWidth] - Scale down if wider (for Discord 8MB limit)\n * @returns {Promise<Buffer>} PNG buffer\n */\n\nexport async function renderMap(mapId\x2C options = {}) {\n  const { figures = []\x2C tokens = {}\x2C showGrid = true\x2C maxWidth = 1200\x2C cropToZone = null\x2C gridStyle = 'default'\x2C showGridOnlyOnCoords = null } = options;\n  const mapDef = getMap(mapId);\n  if (!mapDef) throw new Error(`Map not found: ${mapId}`);\n\n  const mapPath = resolveImagePath(mapDef.imagePath\x2C 'maps');\n  const imagePath = join(rootDir\x2C mapPath);\n  const { dx\x2C dy\x2C x0\x2C y0 } = mapDef.grid;\n\n  let img;\n  if (existsSync(imagePath)) {\n    img = await loadImage(imagePath);\n  } else {\n    // Placeholder: gray canvas with "Map image not found"\n    const w = 800;\n    const h = 600;\n    const canvas = createCanvas(w\x2C h);\n    const ctx = canvas.getContext('2d');\n    ctx.fillStyle = '#444';\n    ctx.fillRect(0\x2C 0\x2C w\x2C h);\n    ctx.fillStyle = '#fff';\n    ctx.font = `24px "${FONT_FAMILY}"`;\n    ctx.textAlign = 'center';\n    ctx.fillText(`${mapDef.name}`\x2C w / 2\x2C h / 2 - 20);\n    ctx.fillText('(Map image not found \u2013 add to vassal_extracted/images/)'\x2C w / 2\x2C h / 2 + 20);\n    return canvas.toBuffer('image/png');\n  }\n\n  const origW = img.width;\n  const origH = img.height;\n  const scale = maxWidth && origW > maxWidth ? maxWidth / origW : 1;\n  const w = Math.round(origW * scale);\n  const h = Math.round(origH * scale);\n\n  const canvas = createCanvas(w\x2C h);\n  const ctx = canvas.getContext('2d');\n  ctx.imageSmoothingEnabled = true;\n  ctx.imageSmoothingQuality = 'high';\n  ctx.drawImage(img\x2C 0\x2C 0\x2C w\x2C h);\n\n  const s = scale;\n  const sx0 = x0 * s;\n  const sdx = dx * s;\n  const sdy = dy * s;\n  const sy0 = y0 * s;\n\n  const numCols = Math.floor((w - sx0) / sdx);\n  const numRows = Math.floor((h - sy0) / sdy);\n\n  // Grid coordinate labels: drawn early so figures/tokens render on top of them.\n  if (showGrid) {\n    const useBlackGrid = gridStyle === 'black';\n    const onMapCoords = getOnMapCoordSet(mapId);\n    const coordFilter = showGridOnlyOnCoords\n      ? new Set((Array.isArray(showGridOnlyOnCoords) ? showGridOnlyOnCoords : []).map((c) => String(c).toLowerCase()))\n      : null;\n    ctx.fillStyle = useBlackGrid ? '#8B35C8' : 'rgba(107\x2C33\x2C168\x2C0.85)';\n    ctx.strokeStyle = useBlackGrid ? 'rgba(255\x2C255\x2C255\x2C0.85)' : 'rgba(255\x2C255\x2C255\x2C0.9)';\n    ctx.lineWidth = useBlackGrid ? 2.5 : 2;\n    ctx.font = `bold ${Math.max(8\x2C Math.round(10 * scale))}px "${FONT_FAMILY}"`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n\n    for (let row = 0; row < numRows; row++) {\n      for (let col = 0; col < numCols; col++) {\n        const label = colToLetter(col) + (row + 1);\n        const coordKey = label.toLowerCase();\n        if (!onMapCoords.has(coordKey)) continue;\n        if (coordFilter && !coordFilter.has(coordKey)) continue;\n        const gx = sx0 + col * sdx + sdx / 2;\n        const gy = sy0 + row * sdy + sdy / 2;\n        ctx.strokeText(label\x2C gx\x2C gy);\n        ctx.fillText(label\x2C gx\x2C gy);\n      }\n    }\n  }\n\n  // Draw named area labels (room names like "Command Center")\n  for (const area of tokens.namedAreas || []) {\n    if (!area.name || !area.cells?.length) continue;\n    const parsed = area.cells.map(parseCoord).filter(p => p.col >= 0 && p.row >= 0);\n    if (parsed.length === 0) continue;\n    // Compute centroid of all area cell centers\n    let acx = 0;\n    let acy = 0;\n    for (const p of parsed) {\n      acx += sx0 + p.col * sdx + sdx / 2;\n      acy += sy0 + p.row * sdy + sdy / 2;\n    }\n    acx /= parsed.length;\n    acy /= parsed.length;\n    const areaFontSize = Math.round(Math.min(sdx\x2C sdy) * 0.42);\n    const areaLabel = area.name.length > 20 ? area.name.slice(0\x2C 19) + '\\u2026' : area.name;\n    ctx.font = `bold ${areaFontSize}px "${FONT_FAMILY}"`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    const areaMetrics = ctx.measureText(areaLabel);\n    const aPadH = Math.max(5\x2C Math.round(areaFontSize * 0.3));\n    const aPadV = Math.max(3\x2C Math.round(areaFontSize * 0.2));\n    const aBoxW = areaMetrics.width + aPadH * 2;\n    const aBoxH = areaFontSize + aPadV * 2;\n    const aBoxX = acx - aBoxW / 2;\n    const aBoxY = acy - aBoxH / 2;\n    ctx.fillStyle = 'rgba(0\x2C0\x2C0\x2C0.55)';\n    ctx.fillRect(aBoxX\x2C aBoxY\x2C aBoxW\x2C aBoxH);\n    ctx.lineWidth = Math.max(2\x2C Math.round(areaFontSize * 0.1));\n    ctx.strokeStyle = '#000000';\n    ctx.strokeText(areaLabel\x2C acx\x2C acy);\n    ctx.fillStyle = '#CE93D8'; // Light purple\n    ctx.fillText(areaLabel\x2C acx\x2C acy);\n  }\n\n  // Draw map tokens using game box images from vassal_extracted/images/tokens\n  const tokenSize = Math.min(sdx\x2C sdy) * 0.9;\n  const tc = getTokenImagesConfig();\n  const imagesDir = join(rootDir\x2C 'vassal_extracted'\x2C 'images');\n\n  const CRATE_LABEL_SIZE_SCALE = 0.95; // crates + label ~5% smaller\n\n  const drawTokenAt = async (coord\x2C imageFilename\x2C fallbackStyle\x2C fallbackShape = 'square'\x2C label = null\x2C sizeScale = 1) => {\n    const { col\x2C row } = parseCoord(coord);\n    if (col < 0 || row < 0 || col >= numCols || row >= numRows) return;\n    const cx = sx0 + col * sdx + sdx / 2;\n    const cy = sy0 + row * sdy + sdy / 2;\n    const size = tokenSize * sizeScale;\n    const resolved = imageFilename ? resolveImagePath(join('vassal_extracted'\x2C 'images'\x2C imageFilename)\x2C 'tokens') : null;\n    const imgPath = resolved ? join(rootDir\x2C resolved) : null;\n    if (imgPath && existsSync(imgPath)) {\n      try {\n        const tokenImg = await loadImage(imgPath);\n        const tw = tokenImg.width;\n        const th = tokenImg.height;\n        const tScale = Math.min(size / tw\x2C size / th);\n        const dw = Math.round(tw * tScale);\n        const dh = Math.round(th * tScale);\n        ctx.drawImage(tokenImg\x2C cx - dw / 2\x2C cy - dh / 2\x2C dw\x2C dh);\n      } catch (err) {\n        console.error('Token image load failed:'\x2C imageFilename\x2C err);\n        ctx.fillStyle = fallbackStyle;\n        ctx.strokeStyle = 'rgba(0\x2C0\x2C0\x2C0.6)';\n        ctx.lineWidth = 1;\n        if (fallbackShape === 'circle') {\n          ctx.beginPath();\n          ctx.arc(cx\x2C cy\x2C size / 2\x2C 0\x2C Math.PI * 2);\n          ctx.fill();\n          ctx.stroke();\n        } else {\n          ctx.fillRect(cx - size / 2\x2C cy - size / 2\x2C size\x2C size);\n          ctx.strokeRect(cx - size / 2\x2C cy - size / 2\x2C size\x2C size);\n        }\n      }\n    } else {\n      ctx.fillStyle = fallbackStyle;\n      ctx.strokeStyle = 'rgba(0\x2C0\x2C0\x2C0.6)';\n      ctx.lineWidth = 1;\n      if (fallbackShape === 'circle') {\n        ctx.beginPath();\n        ctx.arc(cx\x2C cy\x2C size / 2\x2C 0\x2C Math.PI * 2);\n        ctx.fill();\n        ctx.stroke();\n      } else {\n        ctx.fillRect(cx - size / 2\x2C cy - size / 2\x2C size\x2C size);\n        ctx.strokeRect(cx - size / 2\x2C cy - size / 2\x2C size\x2C size);\n      }\n    }\n    if (label) {\n      const fontSize = Math.max(9\x2C Math.round(11 * scale * sizeScale));\n      ctx.font = `bold ${fontSize}px "${FONT_FAMILY}"`;\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      const paddingH = Math.max(4\x2C Math.round(6 * scale * sizeScale));\n      const paddingV = Math.max(2\x2C Math.round(3 * scale * sizeScale));\n      const metrics = ctx.measureText(label);\n      const boxW = metrics.width + paddingH * 2;\n      const boxH = fontSize + paddingV * 2;\n      const labelY = cy + size / 2 - boxH / 2;\n      const boxX = cx - boxW / 2;\n      const boxY = labelY - boxH / 2;\n      ctx.fillStyle = '#000000';\n      ctx.fillRect(boxX\x2C boxY\x2C boxW\x2C boxH);\n      ctx.fillStyle = '#FFEB3B';\n      ctx.fillText(label\x2C cx\x2C labelY);\n    }\n  };\n\n  // Pre-load all token images in parallel\x2C then draw sequentially (canvas ctx is not thread-safe).\n  const tokenDrawQueue = [];\n  for (const coord of tokens.terminals || []) {\n    tokenDrawQueue.push({ coord\x2C image: tc.terminals\x2C fallback: 'rgba(79\x2C195\x2C247\x2C0.8)'\x2C shape: 'square' });\n  }\n  for (const token of tokens.missionA || []) {\n    const coord = typeof token === 'string' ? token : token.coord;\n    const label = typeof token === 'string' ? 'Token' : (token.label || 'Token');\n    const image = (typeof token === 'object' && token.image) || tc.missionA;\n    tokenDrawQueue.push({ coord\x2C image\x2C fallback: 'rgba(120\x2C120\x2C120\x2C0.9)'\x2C shape: 'circle'\x2C label\x2C sizeScale: CRATE_LABEL_SIZE_SCALE });\n  }\n  for (const token of tokens.missionB || []) {\n    const coord = typeof token === 'string' ? token : token.coord;\n    const label = typeof token === 'string' ? 'Token' : (token.label || 'Token');\n    const image = (typeof token === 'object' && token.image) || tc.missionB;\n    tokenDrawQueue.push({ coord\x2C image\x2C fallback: 'rgba(255\x2C183\x2C77\x2C0.8)'\x2C shape: 'square'\x2C label\x2C sizeScale: CRATE_LABEL_SIZE_SCALE });\n  }\n  const anc = tc.ancillary || {};\n  for (const coord of tokens.smoke || []) {\n    tokenDrawQueue.push({ coord\x2C image: anc.smoke\x2C fallback: 'rgba(150\x2C150\x2C150\x2C0.7)'\x2C shape: 'circle' });\n  }\n  for (const coord of tokens.rubble || []) {\n    tokenDrawQueue.push({ coord\x2C image: anc.rubble\x2C fallback: 'rgba(100\x2C80\x2C60\x2C0.9)'\x2C shape: 'square' });\n  }\n  for (const coord of tokens.energyShield || []) {\n    tokenDrawQueue.push({ coord\x2C image: anc.energyShield\x2C fallback: 'rgba(100\x2C200\x2C255\x2C0.7)'\x2C shape: 'circle' });\n  }\n  for (const coord of tokens.device || []) {\n    tokenDrawQueue.push({ coord\x2C image: anc.device\x2C fallback: 'rgba(80\x2C120\x2C180\x2C0.9)'\x2C shape: 'square' });\n  }\n  for (const coord of tokens.napalm || []) {\n    tokenDrawQueue.push({ coord\x2C image: anc.napalm\x2C fallback: 'rgba(200\x2C80\x2C40\x2C0.9)'\x2C shape: 'circle' });\n  }\n  // Load all images in parallel\n  const preloadedTokenImages = await Promise.all(tokenDrawQueue.map(async (t) => {\n    const resolved = t.image ? resolveImagePath(join('vassal_extracted'\x2C 'images'\x2C t.image)\x2C 'tokens') : null;\n    const imgPath = resolved ? join(rootDir\x2C resolved) : null;\n    let img = null;\n    if (imgPath && existsSync(imgPath)) {\n      try { img = await loadImage(imgPath); } catch { /* use fallback */ }\n    }\n    return { ...t\x2C loadedImg: img };\n  }));\n  // Draw sequentially with pre-loaded images\n  for (const t of preloadedTokenImages) {\n    const { col\x2C row } = parseCoord(t.coord);\n    if (col < 0 || row < 0 || col >= numCols || row >= numRows) continue;\n    const cx = sx0 + col * sdx + sdx / 2;\n    const cy = sy0 + row * sdy + sdy / 2;\n    const size = tokenSize * (t.sizeScale || 1);\n    if (t.loadedImg) {\n      const tw = t.loadedImg.width;\n      const th = t.loadedImg.height;\n      const tScale = Math.min(size / tw\x2C size / th);\n      const dw = Math.round(tw * tScale);\n      const dh = Math.round(th * tScale);\n      ctx.drawImage(t.loadedImg\x2C cx - dw / 2\x2C cy - dh / 2\x2C dw\x2C dh);\n    } else {\n      ctx.fillStyle = t.fallback;\n      ctx.strokeStyle = 'rgba(0\x2C0\x2C0\x2C0.6)';\n      ctx.lineWidth = 1;\n      if (t.shape === 'circle') {\n        ctx.beginPath();\n        ctx.arc(cx\x2C cy\x2C size / 2\x2C 0\x2C Math.PI * 2);\n        ctx.fill();\n        ctx.stroke();\n      } else {\n        ctx.fillRect(cx - size / 2\x2C cy - size / 2\x2C size\x2C size);\n        ctx.strokeRect(cx - size / 2\x2C cy - size / 2\x2C size\x2C size);\n      }\n    }\n    if (t.label) {\n      const fontSize = Math.max(9\x2C Math.round(11 * scale * (t.sizeScale || 1)));\n      ctx.font = `bold ${fontSize}px "${FONT_FAMILY}"`;\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      const paddingH = Math.max(4\x2C Math.round(6 * scale * (t.sizeScale || 1)));\n      const paddingV = Math.max(2\x2C Math.round(3 * scale * (t.sizeScale || 1)));\n      const metrics = ctx.measureText(t.label);\n      const boxW = metrics.width + paddingH * 2;\n      const boxH = fontSize + paddingV * 2;\n      const labelY = cy + size / 2 - boxH / 2;\n      const boxX = cx - boxW / 2;\n      const boxY = labelY - boxH / 2;\n      ctx.fillStyle = '#000000';\n      ctx.fillRect(boxX\x2C boxY\x2C boxW\x2C boxH);\n      ctx.fillStyle = '#FFEB3B';\n      ctx.fillText(t.label\x2C cx\x2C labelY);\n    }\n  }\n\n  // Strain markers: draw strain token image + orange count badge on signal markers\n  const strainMarkers = tokens.strainMarkers || [];\n  if (strainMarkers.length > 0) {\n    const strainImagePath = join(rootDir\x2C 'vassal_extracted'\x2C 'images'\x2C 'tokens'\x2C 'Counter--Strain.gif');\n    let strainImg = null;\n    if (existsSync(strainImagePath)) {\n      try { strainImg = await loadImage(strainImagePath); } catch { /* fallback */ }\n    }\n    const strainSize = tokenSize * 0.5;\n    for (const sm of strainMarkers) {\n      const { col\x2C row } = parseCoord(sm.coord);\n      if (col < 0 || row < 0 || col >= numCols || row >= numRows) continue;\n      // Position in bottom-right quadrant of the cell\n      const cx = sx0 + col * sdx + sdx * 0.72;\n      const cy = sy0 + row * sdy + sdy * 0.72;\n      if (strainImg) {\n        const tw = strainImg.width;\n        const th = strainImg.height;\n        const tScale = Math.min(strainSize / tw\x2C strainSize / th);\n        const dw = Math.round(tw * tScale);\n        const dh = Math.round(th * tScale);\n        ctx.drawImage(strainImg\x2C cx - dw / 2\x2C cy - dh / 2\x2C dw\x2C dh);\n      } else {\n        ctx.fillStyle = 'rgba(100\x2C149\x2C237\x2C0.8)';\n        ctx.beginPath();\n        ctx.arc(cx\x2C cy\x2C strainSize / 2\x2C 0\x2C Math.PI * 2);\n        ctx.fill();\n      }\n      // Orange count badge with black background\n      const badgeFontSize = Math.max(9\x2C Math.round(12 * scale));\n      const countLabel = String(sm.count);\n      ctx.font = `bold ${badgeFontSize}px "${FONT_FAMILY}"`;\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      const bm = ctx.measureText(countLabel);\n      const badgeR = Math.max(badgeFontSize * 0.65\x2C (bm.width + 6) / 2);\n      const bx = cx + strainSize * 0.35;\n      const by = cy - strainSize * 0.35;\n      ctx.fillStyle = '#000000';\n      ctx.beginPath();\n      ctx.arc(bx\x2C by\x2C badgeR + 1\x2C 0\x2C Math.PI * 2);\n      ctx.fill();\n      ctx.fillStyle = '#FF8C00';\n      ctx.fillText(countLabel\x2C bx\x2C by);\n    }\n  }\n\n  const doorEdges = tokens.doors || [];\n  const grouped = new Map();\n  for (const edge of doorEdges) {\n    if (!edge || edge.length < 2) continue;\n    const a = parseCoord(edge[0]);\n    const b = parseCoord(edge[1]);\n    if (a.col < 0 || a.row < 0 || b.col < 0 || b.row < 0) continue;\n    const horizontalBoundary = a.col === b.col;\n    const boundaryRow = Math.min(a.row\x2C b.row);\n    const boundaryCol = Math.min(a.col\x2C b.col);\n    const key = horizontalBoundary ? `h_${boundaryRow}` : `v_${boundaryCol}`;\n    const col = horizontalBoundary ? a.col : a.row;\n    if (!grouped.has(key)) grouped.set(key\x2C []);\n    grouped.get(key).push({ edge\x2C col\x2C horizontalBoundary });\n  }\n\n  const drawDoorSpan = async (items) => {\n    if (!items?.length) return;\n    const { horizontalBoundary } = items[0];\n    // Derive column/row range from actual edge coords (grouping used row as "col" for vertical doors)\n    const allCols = new Set();\n    const allRows = new Set();\n    for (const item of items) {\n      const p0 = parseCoord(item.edge[0]);\n      const p1 = parseCoord(item.edge[1]);\n      allCols.add(p0.col).add(p1.col);\n      allRows.add(p0.row).add(p1.row);\n    }\n    const minCol = Math.min(...allCols);\n    const maxCol = Math.max(...allCols);\n    const minRow = Math.min(...allRows);\n    const maxRow = Math.max(...allRows);\n    const boundaryRow = minRow;\n    const boundaryCol = minCol;\n    const leftX = sx0 + minCol * sdx;\n    const rightX = sx0 + (maxCol + 1) * sdx;\n    const topY = sy0 + minRow * sdy;\n    const bottomY = sy0 + (maxRow + 1) * sdy;\n    // Place door on the grid line (boundary): horizontal = line between the two rows; vertical = between the two columns\n    const midX = horizontalBoundary ? (leftX + rightX) / 2 : leftX + sdx;\n    const midY = horizontalBoundary ? topY + sdy : (topY + bottomY) / 2;\n    const spanWidth = (maxCol - minCol + 1) * sdx;\n    const spanHeight = (maxRow - minRow + 1) * sdy;\n    const doorW = horizontalBoundary ? spanWidth : spanHeight;\n    const doorH = horizontalBoundary ? spanHeight : spanWidth;\n    const dw = Math.round(doorW);\n    const dh = Math.round(doorH);\n    const imageFilename = tc.doors || 'Token--Door.png';\n    const resolved = resolveImagePath(join('vassal_extracted'\x2C 'images'\x2C imageFilename)\x2C 'tokens');\n    const imgPath = join(rootDir\x2C resolved);\n    ctx.save();\n    ctx.translate(midX\x2C midY);\n    if (!horizontalBoundary) ctx.rotate(Math.PI / 2);\n    const hw = dw / 2;\n    const hh = dh / 2;\n    // White backfill: only ~15% into adjacent cells (not full cell height)\n    const backfillH = Math.max(4\x2C Math.round(dh * 0.15));\n    const hhBf = backfillH / 2;\n    ctx.fillStyle = 'rgba(255\x2C255\x2C255\x2C0.95)';\n    ctx.fillRect(-hw\x2C -hhBf\x2C dw\x2C backfillH);\n    if (existsSync(imgPath)) {\n      try {\n        const tokenImg = await loadImage(imgPath);\n        const tw = tokenImg.width;\n        const th = tokenImg.height;\n        // Scale to cover so door graphic fills the white block (image may have internal padding)\n        const tScale = Math.max(dw / tw\x2C backfillH / th);\n        const iw = Math.round(tw * tScale);\n        const ih = Math.round(th * tScale);\n        ctx.save();\n        ctx.beginPath();\n        ctx.rect(-hw\x2C -hhBf\x2C dw\x2C backfillH);\n        ctx.clip();\n        ctx.drawImage(tokenImg\x2C -iw / 2\x2C -ih / 2\x2C iw\x2C ih);\n        ctx.restore();\n      } catch (err) {\n        console.error('Door image load failed:'\x2C imageFilename\x2C err);\n        ctx.fillStyle = 'rgba(101\x2C67\x2C33\x2C0.95)';\n        ctx.fillRect(-hw * 0.8\x2C -hhBf\x2C hw * 1.6\x2C backfillH);\n      }\n    } else {\n      ctx.fillStyle = 'rgba(101\x2C67\x2C33\x2C0.95)';\n      ctx.fillRect(-hw * 0.8\x2C -hhBf\x2C hw * 1.6\x2C backfillH);\n    }\n    ctx.strokeStyle = '#ffffff';\n    ctx.lineWidth = 2;\n    ctx.strokeRect(-hw\x2C -hhBf\x2C dw\x2C backfillH);\n    ctx.restore();\n  };\n\n  for (const [\x2C items] of grouped) {\n    const sorted = [...items].sort((a\x2C b) => a.col - b.col);\n    let span = [sorted[0]];\n    for (let i = 1; i < sorted.length; i++) {\n      if (sorted[i].col <= sorted[i - 1].col + 1) {\n        span.push(sorted[i]);\n      } else {\n        await drawDoorSpan(span);\n        span = [sorted[i]];\n      }\n    }\n    await drawDoorSpan(span);\n  }\n\n  // Figure markers: drawn AFTER tokens/doors so figures render on top\n  // Circular clip to hide white background; size-scaled to fill footprint\n  // Coord is top-left for large units; center the figure on its footprint\n  const baseTokenSize = Math.min(Math.max(52\x2C 64 * scale)\x2C sdx * 0.95\x2C sdy * 0.95);\n  // Helper: draw a rounded rectangle path centered at (cx\x2C cy) with half-dimensions hw\x2C hh\n  function roundedRectPath(cx\x2C cy\x2C hw\x2C hh\x2C r) {\n    const x = cx - hw\x2C y = cy - hh\x2C w = hw * 2\x2C h = hh * 2;\n    const cr = Math.min(r\x2C hw\x2C hh);\n    ctx.beginPath();\n    ctx.moveTo(x + cr\x2C y);\n    ctx.lineTo(x + w - cr\x2C y);\n    ctx.arcTo(x + w\x2C y\x2C x + w\x2C y + cr\x2C cr);\n    ctx.lineTo(x + w\x2C y + h - cr);\n    ctx.arcTo(x + w\x2C y + h\x2C x + w - cr\x2C y + h\x2C cr);\n    ctx.lineTo(x + cr\x2C y + h);\n    ctx.arcTo(x\x2C y + h\x2C x\x2C y + h - cr\x2C cr);\n    ctx.lineTo(x\x2C y + cr);\n    ctx.arcTo(x\x2C y\x2C x + cr\x2C y\x2C cr);\n    ctx.closePath();\n  }\n  for (const fig of figures) {\n    const coord = fig.coord?.toLowerCase?.() || fig.coord;\n    if (!coord) continue;\n    const letter = coord.match(/[a-z]+/)?.[0] || '';\n    const num = parseInt(coord.match(/\\d+/)?.[0] || '0'\x2C 10);\n    const col = letter\n      ? [...letter.toUpperCase()].reduce((acc\x2C c) => acc * 26 + (c.charCodeAt(0) - 64)\x2C 0) - 1\n      : -1;\n    const row = num - 1;\n    if (row < 0 || col < 0) continue;\n    const size = (fig.figureSize || '1x1').toLowerCase();\n    const [cols = 1\x2C rows = 1] = size.split('x').map(Number);\n    const centerCol = col + cols / 2;\n    const centerRow = row + rows / 2;\n    const cx = sx0 + centerCol * sdx;\n    const cy = sy0 + centerRow * sdy;\n    // For square footprints use a circle; for rectangular use a rounded rect matching footprint\n    const isSquare = cols === rows;\n    const fillFactor = 0.9;\n    const clipW = isSquare ? baseTokenSize * (cols === 1 ? 0.92 : cols * 1.05) / 2 : cols * sdx * fillFactor / 2;\n    const clipH = isSquare ? baseTokenSize * (rows === 1 ? 0.92 : rows * 1.05) / 2 : rows * sdy * fillFactor / 2;\n    const clipRadius = isSquare ? clipW : Math.min(clipW\x2C clipH);\n    const cornerRadius = Math.max(8\x2C Math.round(12 * scale));\n    let drewImage = false;\n    if (fig.imagePath) {\n      const figPath = join(rootDir\x2C fig.imagePath);\n      if (existsSync(figPath)) {\n        try {\n          const figImg = await loadImage(figPath);\n          const tw = figImg.width;\n          const th = figImg.height;\n          const tScale = Math.min((clipW * 2) / tw\x2C (clipH * 2) / th);\n          const dw = Math.round(tw * tScale);\n          const dh = Math.round(th * tScale);\n          const isLarge = cols > 1 || rows > 1;\n          const outlineGap = isLarge ? Math.max(2\x2C Math.round(3 * scale)) : -6;\n          const outlineWidth = isLarge ? Math.max(2\x2C Math.round(3 * scale)) : 10;\n          // Draw colored outline outside the figure\n          ctx.strokeStyle = fig.color || '#fff';\n          ctx.lineWidth = outlineWidth;\n          if (isSquare) {\n            ctx.beginPath();\n            ctx.arc(cx\x2C cy\x2C clipRadius + outlineGap + outlineWidth / 2\x2C 0\x2C Math.PI * 2);\n            ctx.stroke();\n          } else {\n            roundedRectPath(cx\x2C cy\x2C clipW + outlineGap + outlineWidth / 2\x2C clipH + outlineGap + outlineWidth / 2\x2C cornerRadius + outlineGap);\n            ctx.stroke();\n          }\n          // Clip and draw figure image inside\n          ctx.save();\n          if (isSquare) {\n            ctx.beginPath();\n            ctx.arc(cx\x2C cy\x2C clipRadius\x2C 0\x2C Math.PI * 2);\n            ctx.closePath();\n          } else {\n            roundedRectPath(cx\x2C cy\x2C clipW\x2C clipH\x2C cornerRadius);\n          }\n          ctx.clip();\n          // Rotate image 90\xb0 when orientation is swapped vs base size (e.g. 3x2 vs base 2x3)\n          // OR when image aspect ratio mismatches clip area (e.g. landscape image in portrait 1x2 clip)\n          const baseSize = (fig.baseSize || size).toLowerCase();\n          const [baseCols = 1\x2C baseRows = 1] = baseSize.split('x').map(Number);\n          const orientationSwapped = baseCols !== baseRows && cols === baseRows && rows === baseCols;\n          const imageIsLandscape = tw > th;\n          const aspectMismatch = !isSquare && (imageIsLandscape !== (clipW > clipH));\n          if (orientationSwapped || aspectMismatch) {\n            ctx.translate(cx\x2C cy);\n            ctx.rotate(Math.PI / 2);\n            // Re-scale image to fit the rotated clip area (swap width/height for scaling)\n            const rScale = Math.min((clipH * 2) / tw\x2C (clipW * 2) / th);\n            const rw = Math.round(tw * rScale);\n            const rh = Math.round(th * rScale);\n            ctx.drawImage(figImg\x2C -rw / 2\x2C -rh / 2\x2C rw\x2C rh);\n          } else {\n            ctx.drawImage(figImg\x2C cx - dw / 2\x2C cy - dh / 2\x2C dw\x2C dh);\n          }\n          ctx.restore();\n          drewImage = true;\n        } catch (err) {\n          console.error('Map figure image load failed:'\x2C fig.imagePath\x2C err);\n        }\n      }\n    }\n    if (fig.label) {\n      const fontSize = Math.max(10\x2C Math.round(12 * scale));\n      ctx.font = `bold ${fontSize}px "${FONT_FAMILY}"`;\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      const labelY = cy + clipH * 0.6;\n      ctx.strokeStyle = 'rgba(0\x2C0\x2C0\x2C0.9)';\n      ctx.lineWidth = 3;\n      ctx.strokeText(fig.label\x2C cx\x2C labelY);\n      ctx.fillStyle = fig.color || '#fff';\n      ctx.fillText(fig.label\x2C cx\x2C labelY);\n    }\n    if (!drewImage) {\n      console.error(`Map figure image missing for DC "${fig.dcName || '?'}" at ${fig.coord} - run: node scripts/extract-figure-images.js`);\n      ctx.fillStyle = fig.color || '#f00';\n      ctx.beginPath();\n      ctx.arc(cx\x2C cy\x2C Math.max(4\x2C 8 * scale)\x2C 0\x2C Math.PI * 2);\n      ctx.fill();\n      ctx.strokeStyle = fig.color || '#fff';\n      ctx.lineWidth = 2;\n      ctx.stroke();\n    }\n    // Power Tokens: up to 3 slots at top-left of unit\n    const powerTokenTypes = (fig.powerTokens || []).slice(0\x2C 3);\n    const ptSize = Math.max(12\x2C clipRadius * (powerTokenTypes.length > 2 ? 0.33 : 0.396));\n    const ptConfig = getTokenImagesConfig().powerTokens || {};\n    const figX0 = cx - clipW;\n    const figY0 = cy - clipH;\n    // Pre-load power token images in parallel\n    const ptLoadPromises = [];\n    for (let i = 0; i < powerTokenTypes.length; i++) {\n      const ptType = powerTokenTypes[i];\n      if (ptType) {\n        const filename = ptConfig[ptType] || ptConfig.Surge;\n        if (filename) {\n          const resolved = resolveImagePath(join('vassal_extracted'\x2C 'images'\x2C filename)\x2C 'tokens');\n          const imgPath = join(rootDir\x2C resolved);\n          if (existsSync(imgPath)) {\n            ptLoadPromises.push(loadImage(imgPath).then((img) => ({ i\x2C img })).catch(() => null));\n          } else { ptLoadPromises.push(Promise.resolve(null)); }\n        }\n      }\n    }\n    const ptResults = await Promise.all(ptLoadPromises);\n    ctx.imageSmoothingEnabled = true;\n    ctx.imageSmoothingQuality = 'high';\n    for (const result of ptResults) {\n      if (!result) continue;\n      const px = figX0 - ptSize * 0.15 + result.i * (ptSize * 0.9);\n      const py = figY0;\n      const tw = result.img.width;\n      const th = result.img.height;\n      const tScale = Math.min(ptSize / tw\x2C ptSize / th);\n      const dw = Math.round(tw * tScale);\n      const dh = Math.round(th * tScale);\n      ctx.drawImage(result.img\x2C px\x2C py\x2C dw\x2C dh);\n    }\n    ctx.imageSmoothingEnabled = false;\n    // Pre-load condition icon images in parallel\x2C then draw sequentially (stacking leftward)\n    const conditionIcons = (fig.conditions || []).slice(0\x2C 5);\n    if (conditionIcons.length > 0) {\n      const iconSize = Math.max(11\x2C Math.min(clipW\x2C clipH) * 0.39);\n      // Game state stores short verbs (Focus\x2C Stun\x2C etc.); GIF files use participles (Focused\x2C Stunned\x2C etc.)\n      const COND_FILE_NAME = { Focus: 'Focused'\x2C Stun: 'Stunned'\x2C Bleed: 'Bleeding'\x2C Weaken: 'Weakened'\x2C Hide: 'Hidden' };\n      const condImgPromises = conditionIcons.map((cond) => {\n        const condIconFile = `Condition Marker--${COND_FILE_NAME[cond] || cond}.gif`;\n        const condIconPath = join(rootDir\x2C 'vassal_extracted'\x2C 'images'\x2C 'conditions'\x2C condIconFile);\n        if (existsSync(condIconPath)) {\n          return loadImage(condIconPath).catch(() => null);\n        }\n        return Promise.resolve(null);\n      });\n      const condImgs = await Promise.all(condImgPromises);\n      let ciX = cx + clipW + iconSize * 0.15;\n      const ciY = cy - clipH;\n      for (const condImg of condImgs) {\n        if (!condImg) continue;\n        ciX -= iconSize;\n        ctx.drawImage(condImg\x2C ciX\x2C ciY\x2C iconSize\x2C iconSize);\n        ciX -= iconSize * 0.05;\n      }\n    }\n    // Damage badge \u2014 bottom-center\x2C only shown when damage > 0\n    if (fig.damage > 0) {\n      const dmgFontSize = Math.max(10\x2C Math.round(13 * scale));\n      const dmgText = String(fig.damage);\n      ctx.font = `bold ${dmgFontSize}px "${FONT_FAMILY}"`;\n      const dmgW = ctx.measureText(dmgText).width;\n      const badgeR = Math.max(dmgW / 2 + 4\x2C dmgFontSize * 0.7);\n      const badgeX = cx;\n      const badgeY = cy + clipH * 0.6;\n      // Red circle background\n      ctx.fillStyle = 'rgba(200\x2C 30\x2C 30\x2C 0.9)';\n      ctx.beginPath();\n      ctx.arc(badgeX\x2C badgeY\x2C badgeR\x2C 0\x2C Math.PI * 2);\n      ctx.fill();\n      ctx.strokeStyle = 'rgba(0\x2C0\x2C0\x2C0.7)';\n      ctx.lineWidth = 1.5;\n      ctx.stroke();\n      // White damage number\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      ctx.fillStyle = '#fff';\n      ctx.fillText(dmgText\x2C badgeX\x2C badgeY);\n    }\n  }\n\n  // Player zone labels: draw player Discord names over their deployment zones\n  const playerLabels = options.playerLabels || [];\n  for (const { label\x2C zone } of playerLabels) {\n    if (!label || !zone || zone.length === 0) continue;\n    const parsed = zone.map(parseCoord).filter((p) => p.col >= 0 && p.row >= 0);\n    if (parsed.length === 0) continue;\n\n    // Compute centroid of all zone cell centers\n    let cx = 0;\n    let cy = 0;\n    for (const p of parsed) {\n      cx += sx0 + p.col * sdx + sdx / 2;\n      cy += sy0 + p.row * sdy + sdy / 2;\n    }\n    cx /= parsed.length;\n    cy /= parsed.length;\n\n    // Font sized to ~2.5 cells wide for typical name\n    const fontSize = Math.round(Math.min(sdx\x2C sdy) * 0.55);\n    const displayLabel = label.length > 12 ? label.slice(0\x2C 11) + '\\u2026' : label;\n    ctx.font = `bold ${fontSize}px "${FONT_FAMILY}"`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n\n    const metrics = ctx.measureText(displayLabel);\n    const padH = Math.max(6\x2C Math.round(fontSize * 0.3));\n    const padV = Math.max(4\x2C Math.round(fontSize * 0.2));\n    const boxW = metrics.width + padH * 2;\n    const boxH = fontSize + padV * 2;\n    const boxX = cx - boxW / 2;\n    const boxY = cy - boxH / 2;\n\n    // Semi-transparent dark background\n    ctx.fillStyle = 'rgba(0\x2C0\x2C0\x2C0.65)';\n    ctx.fillRect(boxX\x2C boxY\x2C boxW\x2C boxH);\n\n    // Yellow text with black outline\n    ctx.lineWidth = Math.max(2\x2C Math.round(fontSize * 0.1));\n    ctx.strokeStyle = '#000000';\n    ctx.strokeText(displayLabel\x2C cx\x2C cy);\n    ctx.fillStyle = '#FFE033';\n    ctx.fillText(displayLabel\x2C cx\x2C cy);\n  }\n\n  // Optionally crop to deployment zone for zoomed-in view\n  if (cropToZone && Array.isArray(cropToZone) && cropToZone.length > 0) {\n    const parsed = cropToZone.map((c) => parseCoord(c)).filter((p) => p.col >= 0 && p.row >= 0);\n    if (parsed.length > 0) {\n      const cols = parsed.map((p) => p.col);\n      const rows = parsed.map((p) => p.row);\n      const minCol = Math.max(0\x2C Math.min(...cols) - 1);\n      const maxCol = Math.min(numCols - 1\x2C Math.max(...cols) + 1);\n      const minRow = Math.max(0\x2C Math.min(...rows) - 1);\n      const maxRow = Math.min(numRows - 1\x2C Math.max(...rows) + 1);\n      const srcX = sx0 + minCol * sdx;\n      const srcY = sy0 + minRow * sdy;\n      const srcW = (maxCol - minCol + 1) * sdx;\n      const srcH = (maxRow - minRow + 1) * sdy;\n      const ZOOM_MAX_WIDTH = 800;\n      const zoomScale = srcW > 0 ? Math.min(2\x2C ZOOM_MAX_WIDTH / srcW) : 1;\n      const outW = Math.round(srcW * zoomScale);\n      const outH = Math.round(srcH * zoomScale);\n      const cropCanvas = createCanvas(outW\x2C outH);\n      const cropCtx = cropCanvas.getContext('2d');\n      cropCtx.imageSmoothingEnabled = true;\n      cropCtx.imageSmoothingQuality = 'high';\n      cropCtx.drawImage(canvas\x2C srcX\x2C srcY\x2C srcW\x2C srcH\x2C 0\x2C 0\x2C outW\x2C outH);\n      return cropCanvas.toBuffer('image/png');\n    }\n  }\n\n  return canvas.toBuffer('image/png');\n}\n\n/**\n * Get list of available map IDs\n */\nexport function getMapIds() {\n  return getRegistry().maps.map((m) => m.id);\n}\n
