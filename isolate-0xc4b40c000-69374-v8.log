code-creation,Script,9,265091,0x3f05b9293958,64, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/cc-hand.js:1:1,0x1d6be1728560,~
script-source,216,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/cc-hand.js,/**\n * CC-hand + modals: squad_modal_\x2C deploy_modal_\x2C cc_attach_to_\x2C cc_play_select_\x2C cc_discard_select_\x2C\n * deck_illegal_play_\x2C deck_illegal_redo_\x2C cc_shuffle_draw_\x2C cc_play_\x2C cc_draw_\x2C cc_search_discard_\x2C\n * cc_close_discard_\x2C cc_discard_\x2C squad_select_\n */\nimport {\n  ActionRowBuilder\x2C\n  ButtonBuilder\x2C\n  ButtonStyle\x2C\n  StringSelectMenuBuilder\x2C\n  StringSelectMenuOptionBuilder\x2C\n  ModalBuilder\x2C\n  TextInputBuilder\x2C\n  TextInputStyle\x2C\n  EmbedBuilder\x2C\n  ThreadAutoArchiveDuration\x2C\n} from 'discord.js';\nimport { parseCustomId\x2C splitCustomId } from '../discord/custom-id.js';\nimport { COLORS } from '../discord/colors.js';\nimport { canActAsPlayer } from '../utils/can-act-as-player.js';\nimport { applyAbilityResult } from '../discord/apply-ability-result.js';\nimport { normalizeSquadInput } from '../game/validation.js';\nimport { getDcEffects\x2C getDcKeywords\x2C getMapData\x2C getFigureSize } from '../data-loader.js';\nimport { getFootprintCells } from '../game/coords.js';\nimport { checkHandDiscardPassiveReshuffle } from '../game/cc-passive-redraw.js';\nimport { awardObjectiveVp } from '../game/index.js';\nimport {\n  getPlayerId\x2C getHandChannelId\x2C getSquad\x2C getCcDiscard\x2C getCcDeck\x2C getCcHand\x2C\n  getDiscardThreadId\x2C\n  ccHandKey\x2C ccDiscardKey\x2C ccDeckKey\x2C ccDrawnKey\x2C ccAttachmentsKey\x2C vpKey as vpKeyFn\x2C\n  opponentPlayerNum\x2C\n  getInitiativePlayerNum\x2C\n  dcMatchesPlayableBy\x2C\n} from '../game/player-helpers.js';\nimport { discordCatch\x2C withDiscordRetry } from '../error-handling.js';\nimport { fetchGameChannel\x2C sanitizeMentions } from '../discord/channel-helpers.js';\nimport { requireGame\x2C requirePlayer } from '../utils/guards.js';\nimport { chunkButtonsToRows\x2C buildRowPickerButtons\x2C cleanupSpacePick } from '../discord/components.js';\n\n/**\n * C14: After a CC is played\x2C check if opponent has Comm Disruption in hand\n * and prompt them to play it reactively.\n * @param {object} game - Game state\n * @param {string} gameId - Game ID\n * @param {number} playerNum - Player who just played a CC\n * @param {string} card - Name of the CC that was just played\n * @param {object} client - Discord client\n * @param {Function} logGameAction\n * @param {Function} saveGames\n */\nasync function promptCommDisruption(game\x2C gameId\x2C playerNum\x2C card\x2C client\x2C logGameAction\x2C saveGames) {\n  // Don't prompt for Comm Disruption itself or Negation\n  if (card === 'Comm Disruption' || card === 'Negation') return;\n  const oppNum = opponentPlayerNum(playerNum);\n  const oppHand = getCcHand(game\x2C oppNum) || [];\n  if (!oppHand.includes('Comm Disruption')) return;\n  // Check SPY group count for the opponent (Comm Disruption player)\n  const dcEffectsData = getDcEffects() || {};\n  const oppDcList = (oppNum === 1 ? game.p1DcList : game.p2DcList) || [];\n  const spyCount = oppDcList.filter((dc) => {\n    if (!dc || dc.defeated) return false;\n    const kws = (dcEffectsData[dc.dcName]?.keywords || []).map((k) => String(k).toUpperCase());\n    return kws.includes('SPY');\n  }).length;\n  if (spyCount <= 0) return;\n  // Get the played card's cost\n  const getCcEffect = (await import('../data-loader.js')).getCcEffect;\n  const playedEffect = getCcEffect(card);\n  const playedCost = typeof playedEffect?.cost === 'number' ? playedEffect.cost : 0;\n  if (playedCost > spyCount) return; // can't cancel \u2014 cost too high\n  // Prompt the opponent in their hand channel\n  const oppHandId = getHandChannelId(game\x2C oppNum);\n  if (!oppHandId) return;\n  try {\n    const oppHandChannel = await fetchGameChannel(client\x2C oppHandId);\n    const oppId = getPlayerId(game\x2C oppNum);\n    game.pendingCommDisruptionPrompt = { targetPlayerNum: oppNum\x2C playedCard: card\x2C playedBy: playerNum\x2C gameId };\n    const row = new ActionRowBuilder().addComponents(\n      new ButtonBuilder().setCustomId(`comm_disruption_play_${gameId}`).setLabel('Play Comm Disruption').setStyle(ButtonStyle.Danger)\x2C\n      new ButtonBuilder().setCustomId(`comm_disruption_skip_${gameId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary)\x2C\n    );\n    await withDiscordRetry(() => oppHandChannel.send(sanitizeMentions({\n      content: `<@${oppId}> Your opponent played **${card}** (cost ${playedCost}). You have **${spyCount}** friendly SPY group${spyCount !== 1 ? 's' : ''}. Play **Comm Disruption** to cancel it?`\x2C\n      components: [row]\x2C\n      allowedMentions: { users: [oppId] }\x2C\n    })));\n    saveGames();\n  } catch (err) {\n    // Non-fatal: if we can't prompt\x2C the game continues\n    console.error('[Comm Disruption] Failed to prompt opponent:'\x2C err.message);\n  }\n}\n\n/** @param {import('discord.js').ModalSubmitInteraction} interaction */\nexport async function handleSquadModal(interaction\x2C ctx) {\n  const { getGame\x2C validateDeckLegal\x2C sendSquadConfirmation } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'squad_modal_');\n  const gameId = parts[0];\n  const playerNum = parts[1];\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { useReply: true });\n  if (!game) return;\n  if (!game.mapSelected) {\n    await interaction.reply({ content: 'Map selection must be completed before you can submit your squad.'\x2C ephemeral: true });\n    return;\n  }\n  const isP1 = playerNum === '1';\n  const pn = isP1 ? 1 : 2;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pn\x2C canActAsPlayer\x2C 'Only the player for this hand can submit.'\x2C { useReply: true })) return;\n  const name = interaction.fields.getTextInputValue('squad_name').trim() || 'Unnamed Squad';\n  const dcText = interaction.fields.getTextInputValue('squad_dc').trim();\n  const ccText = interaction.fields.getTextInputValue('squad_cc').trim();\n  const dcList = dcText ? dcText.split('\\n').map((s) => s.trim()).filter(Boolean) : [];\n  const ccList = ccText ? ccText.split('\\n').map((s) => s.trim()).filter(Boolean) : [];\n  const squad = { name\x2C dcList\x2C ccList\x2C dcCount: dcList.length\x2C ccCount: ccList.length };\n  normalizeSquadInput(squad);\n  const validation = validateDeckLegal(squad);\n  await sendSquadConfirmation(game\x2C isP1\x2C squad\x2C validation\x2C interaction.client);\n  await interaction.reply({ content: `Parsed **${name}** (${dcList.length} DCs\x2C ${ccList.length} CCs). Review your list in the hand channel and confirm.`\x2C ephemeral: true });\n}\n\n/** @param {import('discord.js').ModalSubmitInteraction} interaction */\nexport async function handleDeployModal(interaction\x2C ctx) {\n  const { getGame\x2C getDeploymentZones\x2C updateDeployPromptMessages\x2C logGameAction\x2C saveGames } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'deploy_modal_');\n  if (parts.length < 3) {\n    await interaction.reply({ content: 'Invalid modal.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const flatIndex = parseInt(parts[2]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { useReply: true });\n  if (!game) return;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner of this deck can deploy.'\x2C { useReply: true })) return;\n  const deployMeta = playerNum === 1 ? game.player1DeployMetadata : game.player2DeployMetadata;\n  const deployLabels = playerNum === 1 ? game.player1DeployLabels : game.player2DeployLabels;\n  const figMeta = deployMeta?.[flatIndex];\n  const figLabel = deployLabels?.[flatIndex];\n  if (!figMeta || !figLabel) {\n    await interaction.reply({ content: 'Figure not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const space = (interaction.fields.getTextInputValue('deploy_space') || '').trim().toLowerCase();\n  if (!space) {\n    await interaction.reply({ content: 'Please enter a space (e.g. A1).'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const mapId = game.selectedMap?.id;\n  const zones = mapId ? getDeploymentZones()[mapId] : null;\n  if (zones) {\n    const initiativePlayerNum = getInitiativePlayerNum(game);\n    const playerZone = playerNum === initiativePlayerNum ? game.deploymentZoneChosen : (game.deploymentZoneChosen === 'red' ? 'blue' : 'red');\n    const validSpaces = (zones[playerZone] || []).map((s) => String(s).toLowerCase());\n    if (validSpaces.length > 0 && !validSpaces.includes(space)) {\n      await interaction.reply({ content: `**${space.toUpperCase()}** is not in your deployment zone. Check the map for valid cells (e.g. A1\x2C B2).`\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n  }\n  const figureKey = `${figMeta.dcName}-${figMeta.dgIndex}-${figMeta.figureIndex}`;\n  // Block non-MOBILE/non-MASSIVE figures from deploying on blocking terrain\n  const ms = getMapData(game.selectedMap?.id);\n  const blockingArr = ms?.blocking || [];\n  if (blockingArr.length > 0) {\n    const dcKws = getDcKeywords(game)?.[figMeta.dcName] || [];\n    const kwUpper = dcKws.map(k => String(k).toUpperCase());\n    const canIgnoreBlocking = kwUpper.includes('MOBILE') || kwUpper.includes('MASSIVE');\n    if (!canIgnoreBlocking) {\n      const figSize = getFigureSize(figMeta.dcName) || '1x1';\n      const cells = getFootprintCells(space\x2C figSize);\n      const blockSet = new Set(blockingArr.map(s => String(s).toLowerCase()));\n      if (cells.some(c => blockSet.has(String(c).toLowerCase()))) {\n        await interaction.reply({ content: `**${space.toUpperCase()}** is blocking terrain. Only MOBILE or MASSIVE figures can deploy there.`\x2C ephemeral: true }).catch(discordCatch);\n        return;\n      }\n    }\n  }\n  if (!game.figurePositions) game.figurePositions = { 1: {}\x2C 2: {} };\n  if (!game.figurePositions[playerNum]) game.figurePositions[playerNum] = {};\n  game.figurePositions[playerNum][figureKey] = space;\n  saveGames();\n  await logGameAction(game\x2C interaction.client\x2C `<@${interaction.user.id}> deployed **${figLabel.replace(/^Deploy /\x2C '')}** at **${space.toUpperCase()}**`\x2C { allowedMentions: { users: [interaction.user.id] }\x2C phase: 'DEPLOYMENT'\x2C icon: 'deploy' });\n  await updateDeployPromptMessages(game\x2C playerNum\x2C interaction.client);\n  await interaction.reply({ content: `Deployed **${figLabel.replace(/^Deploy /\x2C '')}** at **${space.toUpperCase()}**.`\x2C ephemeral: true }).catch(discordCatch);\n}\n\n/** @param {import('discord.js').StringSelectMenuInteraction} interaction */\nexport async function handleCcAttachTo(interaction\x2C ctx) {\n  const { getGame\x2C getCcEffect\x2C buildHandDisplayPayload\x2C updateAttachmentMessageForDc\x2C updateHandVisualMessage\x2C updateDiscardPileMessage\x2C logGameAction\x2C saveGames } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'cc_attach_to_');\n  const game = getGame(gameId);\n  const pending = game?.pendingCcAttachment;\n  if (!game || !pending) {\n    await interaction.reply({ content: 'No attachment pending or game not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { playerNum\x2C card } = pending;\n  const channelId = interaction.channel?.id;\n  const isP1Hand = channelId === game.p1HandId;\n  const isP2Hand = channelId === game.p2HandId;\n  if ((isP1Hand && playerNum !== 1) || (isP2Hand && playerNum !== 2)) {\n    await interaction.reply({ content: 'Use this in your **Your Hand** thread (inside your Play Area).'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const dcMsgId = interaction.values[0];\n  const handKey = ccHandKey(playerNum);\n  const discardKey = ccDiscardKey(playerNum);\n  const hand = game[handKey] || [];\n  const idx = hand.indexOf(card);\n  if (idx < 0) {\n    delete game.pendingCcAttachment;\n    await interaction.reply({ content: "That card is no longer in your hand."\x2C ephemeral: true }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n  await interaction.deferUpdate();\n  hand.splice(idx\x2C 1);\n  game[handKey] = hand;\n  const attachKey = ccAttachmentsKey(playerNum);\n  game[attachKey] = game[attachKey] || {};\n  if (!Array.isArray(game[attachKey][dcMsgId])) game[attachKey][dcMsgId] = [];\n  game[attachKey][dcMsgId].push(card);\n  delete game.pendingCcAttachment;\n  await updateAttachmentMessageForDc(game\x2C playerNum\x2C dcMsgId\x2C interaction.client);\n  const handChannel = await fetchGameChannel(interaction.client\x2C isP1Hand ? game.p1HandId : game.p2HandId);\n  const handMessages = await handChannel.messages.fetch({ limit: 20 });\n  const handMsg = handMessages.find((m) => m.author.bot && (m.content?.includes('Hand:') || m.content?.includes('Hand (')) && (m.components?.length > 0 || m.embeds?.some((e) => e.title?.includes('Command Cards'))));\n  const deck = playerNum === 1 ? (game.player1CcDeck || []) : (game.player2CcDeck || []);\n  if (handMsg) {\n    const handPayload = buildHandDisplayPayload(hand\x2C deck\x2C gameId\x2C game\x2C playerNum);\n    const effectData = getCcEffect(card);\n    const effectReminder = effectData?.effect ? `\\n**Apply effect:** ${effectData.effect}` : '';\n    handPayload.content = `**Command Cards** \u2014 Played **${card}** (Attachment).${effectReminder}\\n\\n` + handPayload.content;\n    await handMsg.edit({\n      content: handPayload.content\x2C\n      embeds: handPayload.embeds\x2C\n      files: handPayload.files || []\x2C\n      components: handPayload.components\x2C\n    }).catch(discordCatch);\n  }\n  await interaction.message.delete().catch(discordCatch);\n  await updateHandVisualMessage(game\x2C playerNum\x2C interaction.client);\n  await updateDiscardPileMessage(game\x2C playerNum\x2C interaction.client);\n  await logGameAction(game\x2C interaction.client\x2C `<@${interaction.user.id}> played **${card}** as an attachment.`\x2C { phase: 'ACTION'\x2C icon: 'card'\x2C allowedMentions: { users: [interaction.user.id] } });\n  saveGames();\n}\n\n/** After dropdown selection: show card preview + PLAY CARD / DO SOMETHING ELSE confirmation. */\nexport async function handleCcPlaySelect(interaction\x2C ctx) {\n  const { getGame\x2C getCommandCardImagePath\x2C saveGames } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'cc_play_select_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { useReply: true });\n  if (!game) return;\n  const channelId = interaction.channel?.id;\n  const isP1Hand = channelId === game.p1HandId;\n  if (!isP1Hand && channelId !== game.p2HandId) {\n    await interaction.reply({ content: 'Use this in your **Your Hand** thread (inside your Play Area).'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const playerNum = isP1Hand ? 1 : 2;\n  const hand = game[ccHandKey(playerNum)] || [];\n  const card = interaction.values[0];\n  if (!hand.includes(card)) {\n    await interaction.reply({ content: "That card isn't in your hand."\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  game.pendingCcConfirmation = { playerNum\x2C card\x2C ts: Date.now() };\n  saveGames();\n  const { existsSync } = await import('fs');\n  const { AttachmentBuilder } = await import('discord.js');\n  const embed = new EmbedBuilder().setTitle(card).setDescription(`Play **${card}**?`).setColor(COLORS.DARK_EMBED);\n  const files = [];\n  if (getCommandCardImagePath) {\n    const imgPath = getCommandCardImagePath(card);\n    if (imgPath && existsSync(imgPath)) {\n      const ext = imgPath.toLowerCase().endsWith('.png') ? 'png' : 'jpg';\n      const fileName = `cc-confirm-${(card || '').replace(/[^a-zA-Z0-9]/g\x2C '')}.${ext}`;\n      files.push(new AttachmentBuilder(imgPath\x2C { name: fileName }));\n      embed.setImage(`attachment://${fileName}`);\n    }\n  }\n  const row = new ActionRowBuilder().addComponents(\n    new ButtonBuilder().setCustomId(`cc_confirm_play_${gameId}`).setLabel('PLAY CARD').setStyle(ButtonStyle.Success)\x2C\n    new ButtonBuilder().setCustomId(`cc_cancel_play_${gameId}`).setLabel('DO SOMETHING ELSE').setStyle(ButtonStyle.Danger)\x2C\n  );\n  await interaction.deferUpdate().catch(discordCatch);\n  await interaction.message.delete().catch(discordCatch);\n  const handId = getHandChannelId(game\x2C playerNum);\n  const handChannel = await fetchGameChannel(interaction.client\x2C handId);\n  await withDiscordRetry(() => handChannel.send({ embeds: [embed]\x2C files\x2C components: [row] }));\n}\n\n/** PLAY CARD confirmed \u2014 execute the actual play. */\nexport async function handleCcConfirmPlay(interaction\x2C ctx) {\n  const { getGame\x2C getCcEffect\x2C isCcAttachment\x2C isCcPlayableNow\x2C isCcPlayLegalByRestriction\x2C buildHandDisplayPayload\x2C updateHandVisualMessage\x2C updateDiscardPileMessage\x2C logGameAction\x2C saveGames\x2C getIllegalCcPlayButtons\x2C getCommandCardImagePath\x2C client } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'cc_confirm_play_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!game.pendingCcConfirmation) {\n    await interaction.followUp({ content: 'No card pending. Try playing again.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const CONFIRM_TTL_MS = 10 * 60 * 1000;\n  if (Date.now() - (game.pendingCcConfirmation.ts || 0) > CONFIRM_TTL_MS) {\n    delete game.pendingCcConfirmation;\n    saveGames();\n    await interaction.followUp({ content: 'Card selection expired \u2014 please re-select from your hand.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { playerNum\x2C card } = game.pendingCcConfirmation;\n  // 5H: Verify the interacting user is the player who initiated this CC play\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Not your card to confirm.')) return;\n  delete game.pendingCcConfirmation;\n\n  // Signal Jammer intercept: cancel this CC and discard both it and Signal Jammer\n  if (game.signalJammerActive && card !== 'Signal Jammer') {\n    const jammerOwnerNum = game.signalJammerActive.playerNum;\n    game.signalJammerActive = null;\n    const playedHandKey = ccHandKey(playerNum);\n    const playedDiscardKey = ccDiscardKey(playerNum);\n    const playedHand = game[playedHandKey] || [];\n    const playedIdx = playedHand.indexOf(card);\n    if (playedIdx >= 0) {\n      playedHand.splice(playedIdx\x2C 1);\n      game[playedHandKey] = playedHand;\n      game[playedDiscardKey] = [...(game[playedDiscardKey] || [])\x2C card];\n    }\n    const jammerDiscardKey = ccDiscardKey(jammerOwnerNum);\n    game[jammerDiscardKey] = [...(game[jammerDiscardKey] || [])\x2C 'Signal Jammer'];\n    await logGameAction(game\x2C client\x2C `**Signal Jammer** cancelled **${card}** \u2014 both cards discarded.`\x2C { phase: 'ACTION'\x2C icon: 'card' });\n    await interaction.message.delete().catch(discordCatch);\n    saveGames();\n    return;\n  }\n\n  const isP1Hand = playerNum === 1;\n  const handKey = ccHandKey(playerNum);\n  const discardKey = ccDiscardKey(playerNum);\n  const hand = game[handKey] || [];\n  const idx = hand.indexOf(card);\n  if (idx < 0) {\n    await interaction.followUp({ content: "That card isn't in your hand anymore."\x2C ephemeral: true }).catch(discordCatch);\n    await interaction.message.delete().catch(discordCatch);\n    saveGames();\n    return;\n  }\n  if (!isCcPlayableNow(game\x2C playerNum\x2C card)) {\n    await interaction.followUp({ content: "That card can't be played right now (wrong timing)."\x2C ephemeral: true }).catch(discordCatch);\n    await interaction.message.delete().catch(discordCatch);\n    saveGames();\n    return;\n  }\n  const restriction = isCcPlayLegalByRestriction(game\x2C playerNum\x2C card);\n  if (!restriction.legal) {\n    game.pendingIllegalCcPlay = { playerNum\x2C card\x2C reason: restriction.reason };\n    const handId = getHandChannelId(game\x2C playerNum);\n    const handChannel = await fetchGameChannel(client\x2C handId);\n    const msg = await withDiscordRetry(() => handChannel.send({\n      content: `\u26a0\ufe0f The bot thinks playing **${card}** is illegal: ${restriction.reason}\\n\\nChoose **Ignore and play** to play it anyway\x2C or **Unplay card** to cancel.`\x2C\n      components: [getIllegalCcPlayButtons(gameId)]\x2C\n    }));\n    game.pendingIllegalCcPlay.messageId = msg.id;\n    await interaction.message.delete().catch(discordCatch);\n    saveGames();\n    return;\n  }\n  // Assassinate / mutual-exclude CC lock: block further CCs during this attack\n  const _cbt = game.combat || game.pendingCombat;\n  if (_cbt?.ccLockedOut) {\n    game.pendingIllegalCcPlay = { playerNum\x2C card\x2C reason: 'A card with "no other Command cards this attack" (e.g. Assassinate) was already played.' };\n    const handId = getHandChannelId(game\x2C playerNum);\n    const handChannel = await fetchGameChannel(client\x2C handId);\n    const msg = await withDiscordRetry(() => handChannel.send({\n      content: `\u26a0\ufe0f **${card}** cannot be played: a mutual-exclude CC (Assassinate) is active this attack.\\n\\nChoose **Ignore and play** to override\x2C or **Unplay card** to cancel.`\x2C\n      components: [getIllegalCcPlayButtons(gameId)]\x2C\n    }));\n    game.pendingIllegalCcPlay.messageId = msg.id;\n    await interaction.message.delete().catch(discordCatch);\n    saveGames();\n    return;\n  }\n  // Track how many CCs played during this attack (for "first CC" conditions like Assassinate)\n  if (_cbt) _cbt.attackCcCount = (_cbt.attackCcCount || 0) + 1;\n  // Fast Learner (Mara Jade): if CC was played via Fast Learner bypass\x2C mark ability as used for the round\n  if (restriction.fastLearner) {\n    const dcList2 = playerNum === 1 ? (game.p1DcList || []) : (game.p2DcList || []);\n    for (const dc of dcList2) {\n      const dn = typeof dc === 'object' ? (dc.dcName || dc.displayName) : dc;\n      const eff = getDcEffects()?.[dn];\n      if ((eff?.specialAbilityIds || []).includes('adaptive_skills_mara_jade')) {\n        game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n        game.roundFigureAbilityUsed[`${dn}_fast_learner`] = true;\n        break;\n      }\n    }\n  }\n  if (isCcAttachment(card)) {\n    const dcMsgIds = playerNum === 1 ? (game.p1DcMessageIds || []) : (game.p2DcMessageIds || []);\n    const dcList = playerNum === 1 ? (game.p1DcList || []) : (game.p2DcList || []);\n    if (dcMsgIds.length === 0 || dcList.length === 0) {\n      await interaction.followUp({ content: 'No Deployment cards to attach to.'\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n    game.pendingCcAttachment = { playerNum\x2C card };\n    // Filter DCs by playableBy restriction\n    const ccEffect = getCcEffect(card);\n    const playableBy = (ccEffect?.playableBy || '').trim();\n    const hasRestriction = playableBy && playableBy.toLowerCase() !== 'any figure';\n    let options = dcList.slice(0\x2C 25).map((d\x2C i) => ({\n      label: (d.displayName || d.dcName || `DC ${i + 1}`).slice(0\x2C 100)\x2C\n      value: dcMsgIds[i] || String(i)\x2C\n      dcName: typeof d === 'object' ? (d.dcName || d.displayName) : d\x2C\n      displayName: typeof d === 'object' ? (d.displayName || d.dcName) : d\x2C\n    })).filter((o) => o.value);\n    if (hasRestriction) {\n      options = options.filter(o => dcMatchesPlayableBy(\n        o.dcName\x2C playableBy\x2C getDcEffects\x2C getDcKeywords\x2C game\x2C o.displayName\n      ));\n    }\n    // Remove internal fields before building select menu\n    options = options.map(({ label\x2C value }) => ({ label\x2C value }));\n    if (options.length === 0) {\n      await interaction.followUp({ content: `No eligible Deployment Cards for **${card}** (playable by: ${playableBy}).`\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n    const select = new StringSelectMenuBuilder()\n      .setCustomId(`cc_attach_to_${gameId}`)\n      .setPlaceholder('Attach to which Deployment Card?')\n      .addOptions(options);\n    // Build CC card image if available\n    const followUpPayload = {\n      content: `**${card}** is an Attachment. Choose which Deployment Card to attach it to:`\x2C\n      components: [new ActionRowBuilder().addComponents(select)]\x2C\n      ephemeral: false\x2C\n    };\n    if (getCommandCardImagePath) {\n      const { existsSync } = await import('fs');\n      const { AttachmentBuilder } = await import('discord.js');\n      const imgPath = getCommandCardImagePath(card);\n      if (imgPath && existsSync(imgPath)) {\n        const ext = imgPath.toLowerCase().endsWith('.png') ? 'png' : 'jpg';\n        const fileName = `cc-attach-${(card || '').replace(/[^a-zA-Z0-9]/g\x2C '')}.${ext}`;\n        followUpPayload.files = [new AttachmentBuilder(imgPath\x2C { name: fileName })];\n      }\n    }\n    await interaction.followUp(followUpPayload).catch(discordCatch);\n    return;\n  }\n  const effectData = getCcEffect(card);\n  const cost = typeof effectData?.cost === 'number' ? effectData.cost : 0;\n  const abilityId = effectData?.abilityId ?? card;\n\n  // For cost > 0 with an ability: try to resolve before moving the card. If we can't apply (timing/context)\x2C\n  // prompt "We don't think you can do this right now" with [Play anyway] / [Unplay] so the card isn't consumed.\n  if (cost !== 0 && ctx.resolveAbility) {\n    const result = ctx.resolveAbility(abilityId\x2C { game\x2C playerNum\x2C cardName: card\x2C dcMessageMeta: ctx.dcMessageMeta\x2C dcHealthState: ctx.dcHealthState\x2C dcExhaustedState: ctx.dcExhaustedState\x2C combat: game.combat || game.pendingCombat });\n    if (result.requiresChoice && result.choiceOptions?.length > 0) {\n      // Choice required: we must commit the play first\x2C then send choice buttons.\n      hand.splice(idx\x2C 1);\n      game[handKey] = hand;\n      game[discardKey] = game[discardKey] || [];\n      game[discardKey].push(card);\n      // C57: De Wanna Wanga passive reshuffle\n      { const _dww = checkHandDiscardPassiveReshuffle(game\x2C playerNum\x2C card);\n        if (_dww.reshuffled && logGameAction) await logGameAction(game\x2C interaction.client\x2C `**De Wanna Wanga** (passive) \u2014 Shuffled back into command deck.`\x2C { phase: 'ROUND'\x2C icon: 'card' }); }\n      const handChannel = await fetchGameChannel(interaction.client\x2C isP1Hand ? game.p1HandId : game.p2HandId);\n      const handMessages = await handChannel.messages.fetch({ limit: 20 });\n      const handMsg = handMessages.find((m) => m.author.bot && (m.content?.includes('Hand:') || m.content?.includes('Hand (')) && (m.components?.length > 0 || m.embeds?.some((e) => e.title?.includes('Command Cards'))));\n      const deck = playerNum === 1 ? (game.player1CcDeck || []) : (game.player2CcDeck || []);\n      if (handMsg) {\n        const handPayload = buildHandDisplayPayload(game[handKey]\x2C deck\x2C gameId\x2C game\x2C playerNum);\n        const effectReminder = effectData?.effect ? `\\n**Apply effect:** ${effectData.effect}` : '';\n        handPayload.content = `**Command Cards** \u2014 Played **${card}**.${effectReminder}\\n\\n` + handPayload.content;\n        await handMsg.edit({ content: handPayload.content\x2C embeds: handPayload.embeds\x2C files: handPayload.files || []\x2C components: handPayload.components }).catch(discordCatch);\n      }\n      await interaction.message.delete().catch(discordCatch);\n      await updateHandVisualMessage(game\x2C playerNum\x2C interaction.client);\n      await updateDiscardPileMessage(game\x2C playerNum\x2C interaction.client);\n      const effectDesc = effectData?.effect ? `\\n> *${effectData.effect}*` : '';\n      await logGameAction(game\x2C interaction.client\x2C `<@${interaction.user.id}> played command card **${card}**.${effectDesc}`\x2C { phase: 'ACTION'\x2C icon: 'card'\x2C allowedMentions: { users: [interaction.user.id] } });\n      if (ctx.pushUndo) ctx.pushUndo(game\x2C { type: 'cc_play'\x2C gameId\x2C playerNum\x2C card });\n      game.pendingCcChoice = { abilityId\x2C choiceOptions: result.choiceOptions\x2C gameId\x2C playerNum\x2C card\x2C ...(result.choiceValues ? { choiceValues: result.choiceValues } : {}) };\n      const btns = result.choiceOptions.map((opt) => {\n        const label = String(opt).slice(0\x2C 80);\n        return new ButtonBuilder().setCustomId(`cc_choice_${gameId}_${opt}`).setLabel(label).setStyle(ButtonStyle.Secondary);\n      });\n      const rows = chunkButtonsToRows(btns);\n      await handChannel.send({ content: `**Choose one** (for **${card}**):`\x2C components: rows }).catch(discordCatch);\n      // C14: Comm Disruption \u2014 prompt opponent if they have it in hand\n      await promptCommDisruption(game\x2C gameId\x2C playerNum\x2C card\x2C interaction.client\x2C logGameAction\x2C saveGames);\n      saveGames();\n      return;\n    }\n    if (result.requiresSpaceChoice && Array.isArray(result.validSpaces) && result.validSpaces.length > 0) {\n      // Space choice required: commit play\x2C then send space grid + map (reusable pick-a-space pattern).\n      const { getBoardStateForMovement\x2C getMapAttachmentForSpaces } = ctx;\n      if (!getBoardStateForMovement || !getMapAttachmentForSpaces) {\n        await interaction.followUp({ content: 'Space choice not supported (missing helpers). Resolve manually.'\x2C ephemeral: true }).catch(discordCatch);\n        return;\n      }\n      hand.splice(idx\x2C 1);\n      game[handKey] = hand;\n      game[discardKey] = game[discardKey] || [];\n      game[discardKey].push(card);\n      // C57: De Wanna Wanga passive reshuffle\n      { const _dww = checkHandDiscardPassiveReshuffle(game\x2C playerNum\x2C card);\n        if (_dww.reshuffled && logGameAction) await logGameAction(game\x2C interaction.client\x2C `**De Wanna Wanga** (passive) \u2014 Shuffled back into command deck.`\x2C { phase: 'ROUND'\x2C icon: 'card' }); }\n      const handChannel = await fetchGameChannel(interaction.client\x2C isP1Hand ? game.p1HandId : game.p2HandId);\n      const handMessages = await handChannel.messages.fetch({ limit: 20 });\n      const handMsg = handMessages.find((m) => m.author.bot && (m.content?.includes('Hand:') || m.content?.includes('Hand (')) && (m.components?.length > 0 || m.embeds?.some((e) => e.title?.includes('Command Cards'))));\n      const deck = playerNum === 1 ? (game.player1CcDeck || []) : (game.player2CcDeck || []);\n      if (handMsg) {\n        const handPayload = buildHandDisplayPayload(game[handKey]\x2C deck\x2C gameId\x2C game\x2C playerNum);\n        const effectReminder = effectData?.effect ? `\\n**Apply effect:** ${effectData.effect}` : '';\n        handPayload.content = `**Command Cards** \u2014 Played **${card}**.${effectReminder}\\n\\n` + handPayload.content;\n        await handMsg.edit({ content: handPayload.content\x2C embeds: handPayload.embeds\x2C files: handPayload.files || []\x2C components: handPayload.components }).catch(discordCatch);\n      }\n      await interaction.message.delete().catch(discordCatch);\n      await updateHandVisualMessage(game\x2C playerNum\x2C interaction.client);\n      await updateDiscardPileMessage(game\x2C playerNum\x2C interaction.client);\n      const effectDesc2 = effectData?.effect ? `\\n> *${effectData.effect}*` : '';\n      await logGameAction(game\x2C interaction.client\x2C `<@${interaction.user.id}> played command card **${card}**.${effectDesc2}`\x2C { phase: 'ACTION'\x2C icon: 'card'\x2C allowedMentions: { users: [interaction.user.id] } });\n      if (ctx.pushUndo) ctx.pushUndo(game\x2C { type: 'cc_play'\x2C gameId\x2C playerNum\x2C card });\n      game.pendingCcSpaceChoice = { abilityId\x2C gameId\x2C playerNum\x2C card\x2C validSpaces: result.validSpaces\x2C chosenFigureKey: result.chosenFigureKey ?? null };\n      const boardState = getBoardStateForMovement(game\x2C null);\n      const ccMapSpaces = boardState?.mapSpaces || { spaces: result.validSpaces };\n      const ccHeader = `**Pick a space** (for **${card}**)`;\n      const ccContextKey = gameId;\n      game.pendingSpacePick = game.pendingSpacePick || {};\n      game.pendingSpacePick[ccContextKey] = {\n        validSpaces: result.validSpaces\x2C\n        cellPrefix: `cc_space_${gameId}_`\x2C\n        mapSpaces: ccMapSpaces\x2C\n        headerText: ccHeader\x2C\n      };\n      const { rows: ccRowBtns } = buildRowPickerButtons(result.validSpaces\x2C `space_row_${ccContextKey}_`);\n      const mapAttachment = await getMapAttachmentForSpaces(game\x2C result.validSpaces);\n      const payload = { content: `${ccHeader}:\\nChoose a row:`\x2C components: ccRowBtns.slice(0\x2C 5)\x2C fetchReply: true };\n      if (mapAttachment) payload.files = [mapAttachment];\n      await handChannel.send(payload).catch(discordCatch);\n      // C14: Comm Disruption \u2014 prompt opponent if they have it in hand\n      await promptCommDisruption(game\x2C gameId\x2C playerNum\x2C card\x2C interaction.client\x2C logGameAction\x2C saveGames);\n      saveGames();\n      return;\n    }\n    if (result.applied) {\n      // Effect applied: resolveAbility already mutated game (e.g. drew cards); remove played card from current hand and add to discard.\n      const handNow = (game[handKey] || []).slice();\n      const idxNow = handNow.indexOf(card);\n      if (idxNow >= 0) handNow.splice(idxNow\x2C 1);\n      game[handKey] = handNow;\n      game[discardKey] = (game[discardKey] || []).concat(card);\n      const handChannel = await fetchGameChannel(interaction.client\x2C isP1Hand ? game.p1HandId : game.p2HandId);\n      const handMessages = await handChannel.messages.fetch({ limit: 20 });\n      const handMsg = handMessages.find((m) => m.author.bot && (m.content?.includes('Hand:') || m.content?.includes('Hand (')) && (m.components?.length > 0 || m.embeds?.some((e) => e.title?.includes('Command Cards'))));\n      const deck = playerNum === 1 ? (game.player1CcDeck || []) : (game.player2CcDeck || []);\n      if (handMsg) {\n        const handPayload = buildHandDisplayPayload(game[handKey]\x2C deck\x2C gameId\x2C game\x2C playerNum);\n        const effectReminder = effectData?.effect ? `\\n**Apply effect:** ${effectData.effect}` : '';\n        handPayload.content = `**Command Cards** \u2014 Played **${card}**.${effectReminder}\\n\\n` + handPayload.content;\n        await handMsg.edit({ content: handPayload.content\x2C embeds: handPayload.embeds\x2C files: handPayload.files || []\x2C components: handPayload.components }).catch(discordCatch);\n      }\n      await interaction.message.delete().catch(discordCatch);\n      await updateHandVisualMessage(game\x2C playerNum\x2C interaction.client);\n      await updateDiscardPileMessage(game\x2C playerNum\x2C interaction.client);\n      const effectDesc3 = effectData?.effect ? `\\n> *${effectData.effect}*` : '';\n      const logMsg = await logGameAction(game\x2C interaction.client\x2C `<@${interaction.user.id}> played command card **${card}**.${effectDesc3}`\x2C { phase: 'ACTION'\x2C icon: 'card'\x2C allowedMentions: { users: [interaction.user.id] } });\n      await applyAbilityResult(result\x2C { game\x2C playerNum\x2C client: interaction.client\x2C ctx });\n      if (result.requiresPowerTokenChoice && game.pendingPowerTokenGrant?.channelId === null) {\n        const handChannelId2 = getHandChannelId(game\x2C playerNum);\n        if (handChannelId2) {\n          game.pendingPowerTokenGrant.channelId = handChannelId2;\n          const ptCh = await fetchGameChannel(interaction.client\x2C handChannelId2);\n          if (ptCh) {\n            const { grants } = game.pendingPowerTokenGrant;\n            const totalCount = grants.reduce((sum\x2C g) => sum + g.count\x2C 0);\n            const figNames = [...new Set(grants.map(g => g.figName))].join('\x2C ');\n            const btns = ['Damage'\x2C 'Surge'\x2C 'Block'\x2C 'Evade'].map(t =>\n              new ButtonBuilder().setCustomId(`power_token_choice_${gameId}_${t.toLowerCase()}`).setLabel(t).setStyle(ButtonStyle.Secondary)\n            );\n            await ptCh.send({\n              content: `**Choose power token type** for **${figNames}** (${totalCount > 1 ? `${totalCount} tokens` : '1 token'}):`\x2C\n              components: [new ActionRowBuilder().addComponents(btns)]\x2C\n            }).catch(discordCatch);\n          }\n        }\n      }\n      if (ctx.pushUndo) ctx.pushUndo(game\x2C { type: 'cc_play'\x2C gameId\x2C playerNum\x2C card\x2C gameLogMessageId: logMsg?.id });\n      if (result.revealToPlayer) {\n        await interaction.followUp({ content: result.revealToPlayer\x2C ephemeral: true }).catch(discordCatch);\n      }\n      // Behind Enemy Lines reorder: if result has requiresReorder\x2C post card-order picker buttons\n      if (result.requiresReorder?.cards?.length > 1) {\n        const _belCards = result.requiresReorder.cards;\n        const _belDeckKey = result.requiresReorder.deckKey;\n        game.pendingBELReorder = { deckKey: _belDeckKey\x2C cards: _belCards\x2C picked: []\x2C playerNum\x2C gameId };\n        const _belBtns = _belCards.map((c\x2C i) =>\n          new ButtonBuilder()\n            .setCustomId(`bel_reorder_1_${gameId}_${i}`)\n            .setLabel(`1st: ${c}`.slice(0\x2C 80))\n            .setStyle(ButtonStyle.Primary)\n        );\n        const _belHandId = getHandChannelId(game\x2C playerNum);\n        const _belHandCh = await fetchGameChannel(interaction.client\x2C _belHandId);\n        await _belHandCh.send({\n          content: `**Behind Enemy Lines** \u2014 Choose which card goes **on top** of the opponent's deck:`\x2C\n          components: [new ActionRowBuilder().addComponents(..._belBtns.slice(0\x2C 5))]\x2C\n        }).catch(discordCatch);\n      }\n      // Windfall: award VP to windfall owner when a cost > 0 card is played (skip when Windfall itself is played)\n      if (game.windfallActive && cost > 0 && card !== 'Windfall') {\n        const wfNum = game.windfallActive.playerNum;\n        const wfKey = vpKeyFn(wfNum);\n        game[wfKey] = game[wfKey] || { total: 0\x2C kills: 0\x2C objectives: 0 };\n        game[wfKey].total = (game[wfKey].total || 0) + cost;\n        await logGameAction(game\x2C interaction.client\x2C `**Windfall**: P${wfNum} gains +${cost} VP.`\x2C { icon: 'card' });\n      }\n      // C14: Comm Disruption \u2014 prompt opponent if they have it in hand\n      await promptCommDisruption(game\x2C gameId\x2C playerNum\x2C card\x2C interaction.client\x2C logGameAction\x2C saveGames);\n      saveGames();\n      return;\n    }\n    if (!result.applied && result.manualMessage) {\n      // Timing/context mismatch: don't move the card; ping in hand with Play anyway / Unplay (same as illegal-CC flow).\n      game.pendingIllegalCcPlay = { playerNum\x2C card\x2C reason: result.manualMessage\x2C fromContext: true };\n      const handId = getHandChannelId(game\x2C playerNum);\n      const handChannel = await fetchGameChannel(client\x2C handId);\n      const msg = await withDiscordRetry(() => handChannel.send({\n        content: `We don't think you can do this right now: ${result.manualMessage}\\n\\nChoose **Ignore and play** to play it anyway (resolve manually)\x2C or **Unplay** to cancel.`\x2C\n        components: [getIllegalCcPlayButtons(gameId)]\x2C\n      }));\n      game.pendingIllegalCcPlay.messageId = msg.id;\n      await interaction.message.delete().catch(discordCatch);\n      saveGames();\n      return;\n    }\n  }\n\n  // Cost 0 (negation flow) or no resolveAbility / effect didn't need pre-check: move card first\x2C then resolve/log as before.\n  hand.splice(idx\x2C 1);\n  game[handKey] = hand;\n  game[discardKey] = game[discardKey] || [];\n  game[discardKey].push(card);\n  // C57: De Wanna Wanga passive \u2014 once per round\x2C when discarded from hand\x2C shuffle into deck instead\n  const _dwwResult = checkHandDiscardPassiveReshuffle(game\x2C playerNum\x2C card);\n  if (_dwwResult.reshuffled && logGameAction) {\n    await logGameAction(game\x2C interaction.client\x2C `**De Wanna Wanga** (passive) \u2014 Shuffled back into command deck instead of staying in discard.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  }\n  const handChannel = await fetchGameChannel(interaction.client\x2C isP1Hand ? game.p1HandId : game.p2HandId);\n  const handMessages = await handChannel.messages.fetch({ limit: 20 });\n  const handMsg = handMessages.find((m) => m.author.bot && (m.content?.includes('Hand:') || m.content?.includes('Hand (')) && (m.components?.length > 0 || m.embeds?.some((e) => e.title?.includes('Command Cards'))));\n  const deck = playerNum === 1 ? (game.player1CcDeck || []) : (game.player2CcDeck || []);\n  if (handMsg) {\n    const handPayload = buildHandDisplayPayload(hand\x2C deck\x2C gameId\x2C game\x2C playerNum);\n    const effectReminder = effectData?.effect ? `\\n**Apply effect:** ${effectData.effect}` : '';\n    handPayload.content = `**Command Cards** \u2014 Played **${card}**.${effectReminder}\\n\\n` + handPayload.content;\n    await handMsg.edit({\n      content: handPayload.content\x2C\n      embeds: handPayload.embeds\x2C\n      files: handPayload.files || []\x2C\n      components: handPayload.components\x2C\n    }).catch(discordCatch);\n  }\n  await interaction.message.delete().catch(discordCatch);\n  await updateHandVisualMessage(game\x2C playerNum\x2C interaction.client);\n  await updateDiscardPileMessage(game\x2C playerNum\x2C interaction.client);\n  const effectDesc4 = effectData?.effect ? `\\n> *${effectData.effect}*` : '';\n  const logMsg = await logGameAction(game\x2C interaction.client\x2C `<@${interaction.user.id}> played command card **${card}**.${effectDesc4}`\x2C { phase: 'ACTION'\x2C icon: 'card'\x2C allowedMentions: { users: [interaction.user.id] } });\n  if (cost === 0 && ctx.getNegationResponseButtons) {\n    game.pendingNegation = { playedBy: playerNum\x2C card\x2C fromDc: false\x2C handChannelId: handChannel.id };\n    const oppNum = opponentPlayerNum(playerNum);\n    const oppHandId = getHandChannelId(game\x2C oppNum);\n    const oppHandChannel = await fetchGameChannel(interaction.client\x2C oppHandId);\n    if (oppHandChannel) {\n      const oppId = getPlayerId(game\x2C oppNum);\n      await oppHandChannel.send(sanitizeMentions({\n        content: `Your opponent played **${card}** (cost 0). You may play **Negation** to cancel it.`\x2C\n        components: [ctx.getNegationResponseButtons(gameId)]\x2C\n        allowedMentions: { users: [oppId] }\x2C\n      })).catch(discordCatch);\n    }\n    await logGameAction(game\x2C interaction.client\x2C `Waiting for opponent to respond to **${card}**...`\x2C { phase: 'ACTION'\x2C icon: 'hourglass' });\n    const waitingMsg = await withDiscordRetry(() => handChannel.send({\n      content: `\u23f3 **${card}** played \u2014 waiting for opponent to respond (Negation window open). You'll be notified here when it resolves.`\x2C\n    })).catch(() => null);\n    if (waitingMsg) game.pendingNegation.waitingMsgId = waitingMsg.id;\n    if (ctx.pushUndo) ctx.pushUndo(game\x2C { type: 'cc_play'\x2C gameId\x2C playerNum\x2C card\x2C gameLogMessageId: logMsg?.id });\n    // C14: Comm Disruption \u2014 prompt opponent if they have it in hand\n    await promptCommDisruption(game\x2C gameId\x2C playerNum\x2C card\x2C interaction.client\x2C logGameAction\x2C saveGames);\n    saveGames();\n    return;\n  }\n  if (ctx.resolveAbility) {\n    const result = ctx.resolveAbility(abilityId\x2C { game\x2C playerNum\x2C cardName: card\x2C dcMessageMeta: ctx.dcMessageMeta\x2C dcHealthState: ctx.dcHealthState\x2C dcExhaustedState: ctx.dcExhaustedState\x2C combat: game.combat || game.pendingCombat });\n    await applyAbilityResult(result\x2C { game\x2C playerNum\x2C client: interaction.client\x2C ctx });\n    if (result.revealToPlayer) {\n      await interaction.followUp({ content: result.revealToPlayer\x2C ephemeral: true }).catch(discordCatch);\n    }\n  }\n  // Windfall: award VP to windfall owner when a cost > 0 card is played (skip when Windfall itself is played)\n  if (game.windfallActive && cost > 0 && card !== 'Windfall') {\n    const wfNum = game.windfallActive.playerNum;\n    const wfKey = vpKeyFn(wfNum);\n    game[wfKey] = game[wfKey] || { total: 0\x2C kills: 0\x2C objectives: 0 };\n    game[wfKey].total = (game[wfKey].total || 0) + cost;\n    await logGameAction(game\x2C interaction.client\x2C `**Windfall**: P${wfNum} gains +${cost} VP.`\x2C { icon: 'card' });\n  }\n  if (ctx.pushUndo) {\n    ctx.pushUndo(game\x2C { type: 'cc_play'\x2C gameId\x2C playerNum\x2C card\x2C gameLogMessageId: logMsg?.id });\n  }\n  // C14: Comm Disruption \u2014 prompt opponent if they have it in hand\n  await promptCommDisruption(game\x2C gameId\x2C playerNum\x2C card\x2C interaction.client\x2C logGameAction\x2C saveGames);\n  saveGames();\n}\n\n/** DO SOMETHING ELSE \u2014 cancel the pending play. */\nexport async function handleCcCancelPlay(interaction\x2C ctx) {\n  const { getGame\x2C saveGames } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'cc_cancel_play_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  // 5H: Verify the interacting user owns this pending confirmation\n  if (game.pendingCcConfirmation?.playerNum) {\n    if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C game.pendingCcConfirmation.playerNum\x2C canActAsPlayer\x2C 'Not your card to cancel.')) return;\n  }\n  delete game.pendingCcConfirmation;\n  await interaction.message.delete().catch(discordCatch);\n  saveGames();\n}\n\n/**\n * C14: Handler for "Play Comm Disruption" button.\n * Plays Comm Disruption from the opponent's hand to cancel the played card.\n */\nexport async function handleCommDisruptionPlay(interaction\x2C ctx) {\n  const { getGame\x2C getCcEffect\x2C buildHandDisplayPayload\x2C updateHandVisualMessage\x2C updateDiscardPileMessage\x2C logGameAction\x2C saveGames\x2C client } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'comm_disruption_play_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const pending = game.pendingCommDisruptionPrompt;\n  if (!pending) {\n    await interaction.followUp({ content: 'No Comm Disruption prompt pending.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { targetPlayerNum\x2C playedCard\x2C playedBy } = pending;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C targetPlayerNum\x2C canActAsPlayer\x2C 'Only the prompted player can respond.')) return;\n  delete game.pendingCommDisruptionPrompt;\n\n  // Remove Comm Disruption from hand and add to discard\n  const handKey = ccHandKey(targetPlayerNum);\n  const discardKey = ccDiscardKey(targetPlayerNum);\n  const hand = (game[handKey] || []).slice();\n  const cdIdx = hand.indexOf('Comm Disruption');\n  if (cdIdx < 0) {\n    await interaction.followUp({ content: 'Comm Disruption is no longer in your hand.'\x2C ephemeral: true }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n  hand.splice(cdIdx\x2C 1);\n  game[handKey] = hand;\n  game[discardKey] = (game[discardKey] || []).concat('Comm Disruption');\n\n  // Also discard the played card from the opponent's discard (cancel its effects)\n  // The card is already in the opponent's discard \u2014 we note the cancellation\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  await updateHandVisualMessage(game\x2C targetPlayerNum\x2C interaction.client);\n  await updateDiscardPileMessage(game\x2C targetPlayerNum\x2C interaction.client);\n  await logGameAction(game\x2C interaction.client\x2C `**Comm Disruption** \u2014 <@${interaction.user.id}> cancelled **${playedCard}**! Discard that card and cancel its effects.`\x2C { phase: 'ACTION'\x2C icon: 'card'\x2C allowedMentions: { users: [interaction.user.id] } });\n  saveGames();\n}\n\n/**\n * C14: Handler for "Skip" Comm Disruption button.\n */\nexport async function handleCommDisruptionSkip(interaction\x2C ctx) {\n  const { getGame\x2C saveGames } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'comm_disruption_skip_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  delete game.pendingCommDisruptionPrompt;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  saveGames();\n}\n\n/**\n * Resolve a CC play: remove from hand\x2C add to discard\x2C update messages\x2C log. Used by normal play and illegal_cc_ignore.\n * @param {object} game - Game state\n * @param {number} playerNum - 1 or 2\n * @param {string} card - CC name\n * @param {object} ctx - buildHandDisplayPayload\x2C updateHandVisualMessage\x2C updateDiscardPileMessage\x2C logGameAction\x2C getCcEffect\x2C client\n */\nasync function resolveCcPlay(game\x2C playerNum\x2C card\x2C ctx) {\n  const { buildHandDisplayPayload\x2C updateHandVisualMessage\x2C updateDiscardPileMessage\x2C logGameAction\x2C getCcEffect\x2C client\x2C resolveAbility\x2C dcMessageMeta\x2C dcHealthState } = ctx;\n  const handKey = ccHandKey(playerNum);\n  const discardKey = ccDiscardKey(playerNum);\n  const hand = (game[handKey] || []).slice();\n  const idx = hand.indexOf(card);\n  if (idx >= 0) hand.splice(idx\x2C 1);\n  game[handKey] = hand;\n  game[discardKey] = game[discardKey] || [];\n  game[discardKey].push(card);\n  const handId = getHandChannelId(game\x2C playerNum);\n  const handChannel = await fetchGameChannel(client\x2C handId);\n  const handMessages = await handChannel.messages.fetch({ limit: 20 });\n  const handMsg = handMessages.find((m) => m.author.bot && (m.content?.includes('Hand:') || m.content?.includes('Hand (')) && (m.components?.length > 0 || m.embeds?.some((e) => e.title?.includes('Command Cards'))));\n  const deck = getCcDeck(game\x2C playerNum) || [];\n  const effectData = getCcEffect(card);\n  if (handMsg) {\n    const handPayload = buildHandDisplayPayload(hand\x2C deck\x2C game.gameId\x2C game\x2C playerNum);\n    const effectReminder = effectData?.effect ? `\\n**Apply effect:** ${effectData.effect}` : '';\n    handPayload.content = `**Command Cards** \u2014 Played **${card}**.${effectReminder}\\n\\n` + handPayload.content;\n    await handMsg.edit({\n      content: handPayload.content\x2C\n      embeds: handPayload.embeds\x2C\n      files: handPayload.files || []\x2C\n      components: handPayload.components\x2C\n    }).catch(discordCatch);\n  }\n  await updateHandVisualMessage(game\x2C playerNum\x2C client);\n  await updateDiscardPileMessage(game\x2C playerNum\x2C client);\n  const effectDesc = effectData?.effect ? `\\n> *${effectData.effect}*` : '';\n  await logGameAction(game\x2C client\x2C `Played command card **${card}**.${effectDesc}`\x2C { phase: 'ACTION'\x2C icon: 'card' });\n  if (resolveAbility) {\n    const abilityId = effectData?.abilityId ?? card;\n    const result = resolveAbility(abilityId\x2C { game\x2C playerNum\x2C cardName: card\x2C dcMessageMeta\x2C dcHealthState\x2C combat: game.combat || game.pendingCombat });\n    await applyAbilityResult(result\x2C { game\x2C playerNum\x2C client\x2C ctx });\n  }\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction \u2014 space button for pick-a-space CC (e.g. Smoke Grenade\x2C placement). */\nexport async function handleCcSpacePick(interaction\x2C ctx) {\n  const match = interaction.customId.match(/^cc_space_([^_]+)_(.+)$/);\n  if (!match) {\n    await interaction.followUp({ content: 'Invalid space choice.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C gameId\x2C space] = match;\n  const chosenSpace = String(space).toLowerCase();\n  const { getGame\x2C resolveAbility\x2C dcMessageMeta\x2C dcHealthState\x2C dcExhaustedState\x2C logGameAction\x2C updateHandVisualMessage\x2C updateDiscardPileMessage\x2C updateDcActionsMessage\x2C buildBoardMapPayload\x2C client\x2C saveGames } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  cleanupSpacePick(game\x2C gameId);\n  const pending = game.pendingCcSpaceChoice;\n  if (!pending || pending.gameId !== gameId) {\n    await interaction.followUp({ content: 'No pending space choice for this game.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const playerNum = pending.playerNum;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the player who played the card can choose.')) return;\n  const validLower = (pending.validSpaces || []).map((s) => String(s).toLowerCase());\n  if (!validLower.includes(chosenSpace)) {\n    await interaction.followUp({ content: 'That space is not a valid choice.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const result = resolveAbility(pending.abilityId\x2C {\n    game\x2C\n    playerNum\x2C\n    dcMessageMeta\x2C\n    dcHealthState\x2C\n    dcExhaustedState\x2C\n    chosenSpace\x2C\n    chosenFigureKey: pending.chosenFigureKey ?? null\x2C\n    combat: game.combat || game.pendingCombat\x2C\n  });\n  delete game.pendingCcSpaceChoice;\n  await applyAbilityResult(result\x2C { game\x2C playerNum\x2C client\x2C ctx });\n  // Power token type-choice prompt (e.g. Looking for a Fight push phase)\n  if (result.requiresPowerTokenChoice && game.pendingPowerTokenGrant?.channelId === null) {\n    const handChannelId2 = getHandChannelId(game\x2C playerNum);\n    if (handChannelId2) {\n      game.pendingPowerTokenGrant.channelId = handChannelId2;\n      const ptCh = await fetchGameChannel(client\x2C handChannelId2);\n      if (ptCh) {\n        const { grants } = game.pendingPowerTokenGrant;\n        const totalCount = grants.reduce((sum\x2C g) => sum + g.count\x2C 0);\n        const figNames = [...new Set(grants.map(g => g.figName))].join('\x2C ');\n        const btns = ['Damage'\x2C 'Surge'\x2C 'Block'\x2C 'Evade'].map(t =>\n          new ButtonBuilder().setCustomId(`power_token_choice_${gameId}_${t.toLowerCase()}`).setLabel(t).setStyle(ButtonStyle.Secondary)\n        );\n        await ptCh.send({\n          content: `**Choose power token type** for **${figNames}** (${totalCount > 1 ? `${totalCount} tokens` : '1 token'}):`\x2C\n          components: [new ActionRowBuilder().addComponents(btns)]\x2C\n        }).catch(discordCatch);\n      }\n    }\n  }\n  try {\n    await interaction.message.edit({ content: 'Space chosen.'\x2C components: [] }).catch(discordCatch);\n  } catch {}\n  saveGames();\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction \u2014 choice button for choose-one CC (e.g. Retaliation). */\nexport async function handleCcChoice(interaction\x2C ctx) {\n  const { getGame\x2C resolveAbility\x2C dcMessageMeta\x2C dcHealthState\x2C dcExhaustedState\x2C logGameAction\x2C updateHandVisualMessage\x2C updateDiscardPileMessage\x2C updateDcActionsMessage\x2C buildDcEmbedAndFiles\x2C getConditionsForDcMessage\x2C getDcPlayAreaComponents\x2C getBoardStateForMovement\x2C getMapAttachmentForSpaces\x2C client\x2C saveGames } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'cc_choice_');\n  const gameId = parts[0];\n  const chosenLabel = parts.slice(1).join('_');\n  if (!gameId) {\n    await interaction.followUp({ content: 'Invalid choice.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const pending = game.pendingCcChoice;\n  if (!pending || pending.gameId !== gameId) {\n    await interaction.followUp({ content: 'No pending choice for this game.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const playerNum = pending.playerNum;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the player who played the card can choose.')) return;\n  // Match by label (new-style) or fall back to numeric index (old buttons still in flight)\n  let choiceIndex = pending.choiceOptions?.findIndex(opt => String(opt) === chosenLabel);\n  if (choiceIndex < 0 && /^\\d+$/.test(chosenLabel)) {\n    choiceIndex = parseInt(chosenLabel\x2C 10);\n  }\n  if (choiceIndex == null || choiceIndex < 0 || choiceIndex >= (pending.choiceOptions?.length ?? 0)) {\n    await interaction.followUp({ content: 'Invalid option.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const chosenOption = pending.choiceOptions?.[choiceIndex];\n  const result = resolveAbility(pending.abilityId\x2C {\n    game\x2C\n    playerNum\x2C\n    dcMessageMeta\x2C\n    dcHealthState\x2C\n    dcExhaustedState\x2C\n    choiceIndex\x2C\n    chosenOption\x2C\n    chosenFigureKey: pending.choiceValues?.[choiceIndex] ?? null\x2C\n    combat: game.combat || game.pendingCombat\x2C\n  });\n  delete game.pendingCcChoice;\n  const aarResult = await applyAbilityResult(result\x2C { game\x2C playerNum\x2C client\x2C ctx });\n  if (!aarResult.handled && aarResult.requiresSpaceChoice && Array.isArray(result.validSpaces) && result.validSpaces.length > 0) {\n    if (!getBoardStateForMovement || !getMapAttachmentForSpaces) {\n      await logGameAction(game\x2C client\x2C 'CC effect: Space choice not supported. Resolve manually.'\x2C { phase: 'ACTION'\x2C icon: 'card' });\n      saveGames();\n      return;\n    }\n    game.pendingCcSpaceChoice = {\n      abilityId: pending.abilityId\x2C\n      gameId\x2C\n      playerNum\x2C\n      card: pending.card\x2C\n      validSpaces: result.validSpaces\x2C\n      chosenFigureKey: result.chosenFigureKey ?? pending.choiceValues?.[choiceIndex] ?? null\x2C\n    };\n    const handChannelId = getHandChannelId(game\x2C playerNum);\n    const handCh = await fetchGameChannel(client\x2C handChannelId);\n    if (handCh) {\n      const boardState2 = getBoardStateForMovement(game\x2C null);\n      const cc2MapSpaces = boardState2?.mapSpaces || { spaces: result.validSpaces };\n      const cc2Header = `**Pick a space** (for **${pending.card ?? pending.abilityId}**)`;\n      const cc2ContextKey = gameId;\n      game.pendingSpacePick = game.pendingSpacePick || {};\n      game.pendingSpacePick[cc2ContextKey] = {\n        validSpaces: result.validSpaces\x2C\n        cellPrefix: `cc_space_${gameId}_`\x2C\n        mapSpaces: cc2MapSpaces\x2C\n        headerText: cc2Header\x2C\n      };\n      const { rows: cc2RowBtns } = buildRowPickerButtons(result.validSpaces\x2C `space_row_${cc2ContextKey}_`);\n      const mapAttachment2 = await getMapAttachmentForSpaces(game\x2C result.validSpaces);\n      const payload2 = { content: `${cc2Header}:\\nChoose a row:`\x2C components: cc2RowBtns.slice(0\x2C 5) };\n      if (mapAttachment2) payload2.files = [mapAttachment2];\n      await handCh.send(payload2).catch(discordCatch);\n    }\n    try {\n      await interaction.message.edit({ content: 'Figure chosen. Now pick a space.'\x2C components: [] }).catch(discordCatch);\n    } catch {}\n    saveGames();\n    return;\n  }\n  // Power token type-choice prompt (e.g. Looking for a Fight grants 1 token after Move/Push choice)\n  if (result.requiresPowerTokenChoice && game.pendingPowerTokenGrant?.channelId === null) {\n    const handChannelId2 = getHandChannelId(game\x2C playerNum);\n    if (handChannelId2) {\n      game.pendingPowerTokenGrant.channelId = handChannelId2;\n      const ptCh = await fetchGameChannel(client\x2C handChannelId2);\n      if (ptCh) {\n        const { grants } = game.pendingPowerTokenGrant;\n        const totalCount = grants.reduce((sum\x2C g) => sum + g.count\x2C 0);\n        const figNames = [...new Set(grants.map(g => g.figName))].join('\x2C ');\n        const btns = ['Damage'\x2C 'Surge'\x2C 'Block'\x2C 'Evade'].map(t =>\n          new ButtonBuilder().setCustomId(`power_token_choice_${gameId}_${t.toLowerCase()}`).setLabel(t).setStyle(ButtonStyle.Secondary)\n        );\n        await ptCh.send({\n          content: `**Choose power token type** for **${figNames}** (${totalCount > 1 ? `${totalCount} tokens` : '1 token'}):`\x2C\n          components: [new ActionRowBuilder().addComponents(btns)]\x2C\n        }).catch(discordCatch);\n      }\n    }\n  }\n  try {\n    await interaction.message.edit({ content: 'Choice resolved.'\x2C components: [] }).catch(discordCatch);\n  } catch {}\n  saveGames();\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction \u2014 "Ignore and play" for pending illegal CC. */\nexport async function handleIllegalCcIgnore(interaction\x2C ctx) {\n  const { getGame\x2C buildHandDisplayPayload\x2C updateHandVisualMessage\x2C updateDiscardPileMessage\x2C logGameAction\x2C getCcEffect\x2C client\x2C saveGames } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'illegal_cc_ignore_');\n  const game = getGame(gameId);\n  if (!game || !game.pendingIllegalCcPlay) {\n    await interaction.followUp({ content: 'No pending play to resolve.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { playerNum\x2C card\x2C messageId } = game.pendingIllegalCcPlay;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the player who played the card can choose.')) return;\n  await resolveCcPlay(game\x2C playerNum\x2C card\x2C ctx);\n  delete game.pendingIllegalCcPlay;\n  if (messageId && interaction.channel?.id) {\n    try {\n      const msg = await interaction.channel.messages.fetch(messageId);\n      await msg.edit({ content: 'Play resolved.'\x2C components: [] }).catch(discordCatch);\n    } catch {}\n  }\n  saveGames();\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction \u2014 "Play Negation" to cancel opponent's cost-0 CC. */\nexport async function handleNegationPlay(interaction\x2C ctx) {\n  const { getGame\x2C buildHandDisplayPayload\x2C updateHandVisualMessage\x2C updateDiscardPileMessage\x2C logGameAction\x2C getCcEffect\x2C client\x2C saveGames } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'negation_play_');\n  const game = getGame(gameId);\n  if (!game || !game.pendingNegation) {\n    await interaction.followUp({ content: 'No pending play to negate.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { playedBy\x2C card\x2C waitingMsgId\x2C handChannelId } = game.pendingNegation;\n  const oppNum = opponentPlayerNum(playedBy);\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C oppNum\x2C canActAsPlayer\x2C 'Only the opponent can play Negation.')) return;\n  const handKey = ccHandKey(oppNum);\n  const discardKey = ccDiscardKey(oppNum);\n  const hand = game[handKey] || [];\n  const idx = hand.indexOf('Negation');\n  if (idx < 0) {\n    await interaction.followUp({ content: "You don't have Negation in your hand."\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  hand.splice(idx\x2C 1);\n  game[handKey] = hand;\n  game[discardKey] = game[discardKey] || [];\n  game[discardKey].push('Negation');\n  delete game.pendingNegation;\n  await updateHandVisualMessage(game\x2C oppNum\x2C client);\n  await updateDiscardPileMessage(game\x2C oppNum\x2C client);\n  await interaction.message.edit({ content: `**Negation** cancelled **${card}**.`\x2C components: [] }).catch(discordCatch);\n  const negPlayerId = getPlayerId(game\x2C oppNum);\n  await logGameAction(game\x2C client\x2C `<@${negPlayerId}> played **Negation** \u2014 cancelled **${card}**.`\x2C { phase: 'ACTION'\x2C icon: 'card'\x2C allowedMentions: { users: [negPlayerId] } });\n  // Notify the player whose card was cancelled\n  if (waitingMsgId && handChannelId) {\n    const playingHandChannel = await fetchGameChannel(client\x2C handChannelId);\n    if (playingHandChannel) {\n      const waitingMsg = await playingHandChannel.messages.fetch(waitingMsgId).catch(() => null);\n      const playedById = getPlayerId(game\x2C playedBy);\n      if (waitingMsg) await waitingMsg.edit({ content: `\u274c Your **${card}** was cancelled by your opponent's **Negation**. <@${playedById}>` }).catch(discordCatch);\n    }\n  }\n  saveGames();\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction \u2014 "Let it resolve" for pending cost-0 CC. */\nexport async function handleNegationLetResolve(interaction\x2C ctx) {\n  const { getGame\x2C buildHandDisplayPayload\x2C updateHandVisualMessage\x2C updateDiscardPileMessage\x2C logGameAction\x2C getCcEffect\x2C client\x2C saveGames\x2C resolveAbility\x2C dcMessageMeta\x2C dcHealthState\x2C updateDcActionsMessage\x2C updateAttachmentMessageForDc\x2C isCcAttachment\x2C ensureMovementBankMessage\x2C updateMovementBankMessage } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'negation_let_resolve_');\n  const game = getGame(gameId);\n  if (!game || !game.pendingNegation) {\n    await interaction.followUp({ content: 'No pending play to resolve.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { playedBy\x2C card\x2C fromDc\x2C msgId\x2C wasAttachment\x2C waitingMsgId\x2C handChannelId } = game.pendingNegation;\n  const oppNum = opponentPlayerNum(playedBy);\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C oppNum\x2C canActAsPlayer\x2C 'Only the opponent can choose to let it resolve.')) return;\n  delete game.pendingNegation;\n  await interaction.message.edit({ content: `**${card}** resolves.`\x2C components: [] }).catch(discordCatch);\n  if (fromDc && msgId && wasAttachment && updateAttachmentMessageForDc && isCcAttachment?.(card)) {\n    const attachKey = ccAttachmentsKey(playedBy);\n    const discardKey = ccDiscardKey(playedBy);\n    const discard = game[discardKey] || [];\n    const idx = discard.indexOf(card);\n    if (idx >= 0) {\n      discard.splice(idx\x2C 1);\n      game[discardKey] = discard;\n    }\n    game[attachKey] = game[attachKey] || {};\n    if (!Array.isArray(game[attachKey][msgId])) game[attachKey][msgId] = [];\n    game[attachKey][msgId].push(card);\n    await updateAttachmentMessageForDc(game\x2C playedBy\x2C msgId\x2C client);\n  }\n  if (resolveAbility) {\n    const effectData = getCcEffect(card);\n    const abilityId = effectData?.abilityId ?? card;\n    const result = resolveAbility(abilityId\x2C { game\x2C playerNum: playedBy\x2C cardName: card\x2C dcMessageMeta\x2C dcHealthState\x2C combat: game.combat || game.pendingCombat\x2C msgId });\n    await applyAbilityResult(result\x2C { game\x2C playerNum: playedBy\x2C msgId: fromDc ? msgId : undefined\x2C client\x2C ctx });\n  }\n  // Notify the player whose card resolved\n  if (waitingMsgId && handChannelId) {\n    const playingHandChannel = await fetchGameChannel(client\x2C handChannelId);\n    if (playingHandChannel) {\n      const waitingMsg = await playingHandChannel.messages.fetch(waitingMsgId).catch(() => null);\n      const playedById = getPlayerId(game\x2C playedBy);\n      if (waitingMsg) await waitingMsg.edit({ content: `\u2705 **${card}** resolved! <@${playedById}>` }).catch(discordCatch);\n    }\n  }\n  saveGames();\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction \u2014 "Play Celebration" to gain 4 VP. */\nexport async function handleCelebrationPlay(interaction\x2C ctx) {\n  const { getGame\x2C buildHandDisplayPayload\x2C updateHandVisualMessage\x2C updateDiscardPileMessage\x2C logGameAction\x2C client\x2C saveGames } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'celebration_play_');\n  const game = getGame(gameId);\n  if (!game || !game.pendingCelebration) {\n    await interaction.followUp({ content: 'No Celebration window open.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { attackerPlayerNum } = game.pendingCelebration;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C attackerPlayerNum\x2C canActAsPlayer\x2C 'Only the player who defeated the figure can play Celebration.')) return;\n  const handKey = ccHandKey(attackerPlayerNum);\n  const discardKey = ccDiscardKey(attackerPlayerNum);\n  const hand = game[handKey] || [];\n  const idx = hand.indexOf('Celebration');\n  if (idx < 0) {\n    await interaction.followUp({ content: "You don't have Celebration in your hand."\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  hand.splice(idx\x2C 1);\n  game[handKey] = hand;\n  game[discardKey] = game[discardKey] || [];\n  game[discardKey].push('Celebration');\n  awardObjectiveVp(game\x2C attackerPlayerNum\x2C 4);\n  delete game.pendingCelebration;\n  await updateHandVisualMessage(game\x2C attackerPlayerNum\x2C client);\n  await updateDiscardPileMessage(game\x2C attackerPlayerNum\x2C client);\n  await interaction.message.edit({ content: `**Celebration** \u2014 +4 VP.`\x2C components: [] }).catch(discordCatch);\n  const celPlayerId = getPlayerId(game\x2C attackerPlayerNum);\n  await logGameAction(game\x2C client\x2C `<@${celPlayerId}> played **Celebration** \u2014 gained 4 VP.`\x2C { phase: 'ACTION'\x2C icon: 'card'\x2C allowedMentions: { users: [celPlayerId] } });\n  if (ctx.checkWinConditions) await ctx.checkWinConditions(game\x2C client);\n  saveGames();\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction \u2014 "Pass" on Celebration. */\nexport async function handleCelebrationPass(interaction\x2C ctx) {\n  const { getGame\x2C logGameAction\x2C client\x2C saveGames } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'celebration_pass_');\n  const game = getGame(gameId);\n  if (!game || !game.pendingCelebration) {\n    await interaction.followUp({ content: 'No Celebration window open.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { attackerPlayerNum } = game.pendingCelebration;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C attackerPlayerNum\x2C canActAsPlayer\x2C 'Only the player who defeated the figure can pass.')) return;\n  delete game.pendingCelebration;\n  await interaction.message.edit({ content: 'Passed on Celebration.'\x2C components: [] }).catch(discordCatch);\n  saveGames();\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction \u2014 "Unplay card" for pending illegal CC. */\nexport async function handleIllegalCcUnplay(interaction\x2C ctx) {\n  const { getGame\x2C client\x2C saveGames } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'illegal_cc_unplay_');\n  const game = getGame(gameId);\n  if (!game || !game.pendingIllegalCcPlay) {\n    await interaction.followUp({ content: 'No pending play to cancel.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { playerNum\x2C messageId } = game.pendingIllegalCcPlay;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the player who played the card can choose.')) return;\n  delete game.pendingIllegalCcPlay;\n  if (messageId && interaction.channel?.id) {\n    try {\n      const msg = await interaction.channel.messages.fetch(messageId);\n      await msg.edit({ content: 'Cancelled \u2014 card not played.'\x2C components: [] }).catch(discordCatch);\n    } catch {}\n  }\n  saveGames();\n}\n\n/** @param {import('discord.js').StringSelectMenuInteraction} interaction */\nexport async function handleCcDiscardSelect(interaction\x2C ctx) {\n  const { getGame\x2C buildHandDisplayPayload\x2C updateHandVisualMessage\x2C updateDiscardPileMessage\x2C logGameAction\x2C saveGames } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'cc_discard_select_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { useReply: true });\n  if (!game) return;\n  const channelId = interaction.channel?.id;\n  const isP1Hand = channelId === game.p1HandId;\n  const isP2Hand = channelId === game.p2HandId;\n  if (!isP1Hand && channelId !== game.p2HandId) {\n    await interaction.reply({ content: 'Use this in your **Your Hand** thread (inside your Play Area).'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const playerNum = isP1Hand ? 1 : 2;\n  const handKey = ccHandKey(playerNum);\n  const discardKey = ccDiscardKey(playerNum);\n  const hand = game[handKey] || [];\n  const card = interaction.values[0];\n  const idx = hand.indexOf(card);\n  if (idx < 0) {\n    await interaction.reply({ content: "That card isn't in your hand."\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  await interaction.deferUpdate();\n  hand.splice(idx\x2C 1);\n  game[handKey] = hand;\n  game[discardKey] = game[discardKey] || [];\n  game[discardKey].push(card);\n  const handChannel = await fetchGameChannel(interaction.client\x2C isP1Hand ? game.p1HandId : game.p2HandId);\n  const handMessages = await handChannel.messages.fetch({ limit: 20 });\n  const handMsg = handMessages.find((m) => m.author.bot && (m.content?.includes('Hand:') || m.content?.includes('Hand (')));\n  const deck = playerNum === 1 ? (game.player1CcDeck || []) : (game.player2CcDeck || []);\n  if (handMsg) {\n    const handPayload = buildHandDisplayPayload(hand\x2C deck\x2C gameId\x2C game\x2C playerNum);\n    handPayload.content = `**Discard CC** \u2014 Discarded **${card}**.\\n\\n` + handPayload.content;\n    await handMsg.edit({\n      content: handPayload.content\x2C\n      embeds: handPayload.embeds\x2C\n      files: handPayload.files || []\x2C\n      components: handPayload.components\x2C\n    }).catch(discordCatch);\n  }\n  await interaction.message.delete().catch(discordCatch);\n  await updateHandVisualMessage(game\x2C playerNum\x2C interaction.client);\n  await updateDiscardPileMessage(game\x2C playerNum\x2C interaction.client);\n  await logGameAction(game\x2C interaction.client\x2C `<@${interaction.user.id}> discarded **${card}**`\x2C { allowedMentions: { users: [interaction.user.id] }\x2C icon: 'card' });\n  saveGames();\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction */\nexport async function handleSquadConfirm(interaction\x2C ctx) {\n  const { getGame\x2C pendingSquadConfirm\x2C PENDING_ILLEGAL_TTL_MS\x2C applySquadSubmission } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'squad_confirm_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const isP1 = playerNum === 1;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner of this hand can confirm.')) return;\n  const key = `${gameId}_${playerNum}`;\n  const pending = pendingSquadConfirm.get(key);\n  if (!pending || (Date.now() - pending.timestamp > PENDING_ILLEGAL_TTL_MS)) {\n    pendingSquadConfirm.delete(key);\n    await interaction.followUp({ content: 'This squad confirmation has expired. Please submit your squad again.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  pendingSquadConfirm.delete(key);\n  await applySquadSubmission(game\x2C isP1\x2C pending.squad\x2C interaction.client);\n  await interaction.message.edit({ content: interaction.message.content\x2C components: [] }).catch(discordCatch);\n  await interaction.followUp({ content: `Squad **${pending.squad.name || 'Unnamed'}** confirmed.`\x2C ephemeral: true }).catch(discordCatch);\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction */\nexport async function handleSquadCancel(interaction\x2C ctx) {\n  const { getGame\x2C pendingSquadConfirm } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'squad_cancel_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner of this hand can cancel.')) return;\n  const key = `${gameId}_${playerNum}`;\n  pendingSquadConfirm.delete(key);\n  await interaction.message.edit({ content: 'Squad submission cancelled. Paste your list or upload a .vsav file to try again.'\x2C components: [] }).catch(discordCatch);\n  await interaction.followUp({ content: 'Cancelled. Paste or upload again to resubmit.'\x2C ephemeral: true }).catch(discordCatch);\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction */\nexport async function handleDeckIllegalPlay(interaction\x2C ctx) {\n  const { getGame\x2C pendingIllegalSquad\x2C PENDING_ILLEGAL_TTL_MS\x2C applySquadSubmission } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'deck_illegal_play_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const isP1 = playerNum === 1;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner of this hand can choose Play It Anyway.')) return;\n  const key = `${gameId}_${playerNum}`;\n  const pending = pendingIllegalSquad.get(key);\n  if (!pending || (Date.now() - pending.timestamp > PENDING_ILLEGAL_TTL_MS)) {\n    pendingIllegalSquad.delete(key);\n    await interaction.followUp({ content: 'This deck choice has expired. Please submit your squad again.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  pendingIllegalSquad.delete(key);\n  await applySquadSubmission(game\x2C isP1\x2C pending.squad\x2C interaction.client);\n  await interaction.followUp({ content: `Squad **${pending.squad.name || 'Unnamed'}** accepted (Play It Anyway).`\x2C ephemeral: true }).catch(discordCatch);\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction */\nexport async function handleDeckIllegalRedo(interaction\x2C ctx) {\n  const { getGame\x2C pendingIllegalSquad\x2C getHandTooltipEmbed\x2C saveGames } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'deck_illegal_redo_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const isP1 = playerNum === 1;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner of this hand can choose Redo.')) return;\n  const key = `${gameId}_${playerNum}`;\n  pendingIllegalSquad.delete(key);\n  if (isP1) game.player1Squad = null;\n  else game.player2Squad = null;\n  if (game.bothReadyPosted) game.bothReadyPosted = false;\n  const handChannelId = isP1 ? game.p1HandId : game.p2HandId;\n  const handChannel = await fetchGameChannel(interaction.client\x2C handChannelId);\n  const handMessages = await handChannel.messages.fetch({ limit: 15 });\n  const botMsg = handMessages.find((m) => m.author.bot && m.embeds?.some((e) => e.title?.includes('Your Hand')));\n  if (botMsg) {\n    await botMsg.edit({\n      embeds: [getHandTooltipEmbed(game\x2C playerNum)]\x2C\n      components: []\x2C\n    }).catch(discordCatch);\n  }\n  saveGames();\n  await interaction.message.edit({ content: 'Squad cleared. Paste your list or upload a .vsav file below to resubmit.'\x2C components: [] }).catch(discordCatch);\n  await interaction.followUp({ content: 'Your squad has been cleared. Paste your army list or upload a .vsav file in this thread to resubmit.'\x2C ephemeral: true }).catch(discordCatch);\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction */\nexport async function handleCcShuffleDraw(interaction\x2C ctx) {\n  const { getGame\x2C shuffleArray\x2C buildHandDisplayPayload\x2C updateHandVisualMessage\x2C updatePlayAreaDcButtons\x2C sendRoundActivationPhaseMessage\x2C runStartOfRoundDcEffects\x2C logGameAction\x2C saveGames\x2C client } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'cc_shuffle_draw_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const channelId = interaction.channel?.id;\n  const isP1Hand = channelId === game.p1HandId;\n  const isP2Hand = channelId === game.p2HandId;\n  if (!isP1Hand && !isP2Hand) {\n    await interaction.followUp({ content: 'Use this in your **Your Hand** thread (inside your Play Area).'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const playerNum = isP1Hand ? 1 : 2;\n  const squad = getSquad(game\x2C playerNum);\n  const ccList = squad?.ccList || [];\n  const drawnKey = ccDrawnKey(playerNum);\n  if (game[drawnKey]) {\n    await interaction.followUp({ content: "You've already drawn your starting hand."\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // I Know Everything (Moff Gideon): before drawing\x2C opponent searches this player's deck\n  const oppNum = opponentPlayerNum(playerNum);\n  const oppDcList = oppNum === 1 ? (game.p1DcList || []) : (game.p2DcList || []);\n  const oppHasGideon = oppDcList.some(d => (d?.dcName || d) === 'Moff Gideon');\n  if (oppHasGideon && !game.iKnowEverythingResolved) {\n    const attachKey2 = ccAttachmentsKey(playerNum);\n    const placed2 = (attachKey2 && game[attachKey2] && Object.values(game[attachKey2]).flat()) || [];\n    const availableCards = ccList.filter(c => !placed2.includes(c));\n    if (availableCards.length >= 2) {\n      // Pick 2 random cards to reveal\n      const shuffledCopy = [...availableCards];\n      shuffleArray(shuffledCopy);\n      const revealed = [shuffledCopy[0]\x2C shuffledCopy[1]];\n      game.pendingIKnowEverything = { targetPlayerNum: playerNum\x2C gideonPlayerNum: oppNum\x2C cards: revealed\x2C gameId };\n      const oppPlayerId = getPlayerId(game\x2C oppNum);\n      const cardLabels = revealed.map((c\x2C i) => `**${i + 1}.** ${c}`).join('\\n');\n      const keepRow = new ActionRowBuilder().addComponents(\n        new ButtonBuilder().setCustomId(`ike_keep_${gameId}_0`).setLabel(`Keep: ${revealed[0].slice(0\x2C 70)}`).setStyle(ButtonStyle.Primary)\x2C\n        new ButtonBuilder().setCustomId(`ike_keep_${gameId}_1`).setLabel(`Keep: ${revealed[1].slice(0\x2C 70)}`).setStyle(ButtonStyle.Primary)\x2C\n      );\n      await logGameAction(game\x2C client\x2C `\ud83d\udd75\ufe0f **I Know Everything** \u2014 **Moff Gideon** reveals 2 cards from <@${getPlayerId(game\x2C playerNum)}>'s Command deck:\\n${cardLabels}\\n\\n<@${getPlayerId(game\x2C playerNum)}> \u2014 Choose which card to **keep** (the other is removed from the game):`\x2C { components: [keepRow]\x2C allowedMentions: { users: [getPlayerId(game\x2C playerNum)] } });\n      saveGames();\n      return;\n    }\n    // Not enough cards\x2C skip I Know Everything\n    game.iKnowEverythingResolved = true;\n  }\n\n  const attachKey = ccAttachmentsKey(playerNum);\n  const placed = (game[attachKey] && Object.values(game[attachKey]).flat()) || [];\n  const deck = ccList.filter((c) => !placed.includes(c));\n  shuffleArray(deck);\n  let hand = deck.splice(0\x2C 3);\n  const deckKey = ccDeckKey(playerNum);\n  const handKey = ccHandKey(playerNum);\n  if (game.testScenarioPrimaryCard && playerNum === 1 && !hand.includes(game.testScenarioPrimaryCard)) {\n    const replaced = hand[0];\n    hand = [game.testScenarioPrimaryCard\x2C hand[1]\x2C hand[2]].filter(Boolean);\n    if (replaced) deck.push(replaced);\n    const pcIdx = deck.indexOf(game.testScenarioPrimaryCard);\n    if (pcIdx >= 0) deck.splice(pcIdx\x2C 1);\n  }\n  game[deckKey] = deck;\n  game[handKey] = hand;\n  game[drawnKey] = true;\n  const playerId = getPlayerId(game\x2C playerNum);\n  await logGameAction(game\x2C client\x2C `<@${playerId}> shuffled and drew 3 Command Cards.`\x2C { phase: 'DEPLOYMENT'\x2C icon: 'card'\x2C allowedMentions: { users: [playerId] } });\n  const handPayload = buildHandDisplayPayload(hand\x2C deck\x2C gameId\x2C game\x2C playerNum);\n  await interaction.message.edit({\n    content: handPayload.content\x2C\n    embeds: handPayload.embeds\x2C\n    files: handPayload.files || []\x2C\n    components: handPayload.components\x2C\n  }).catch(discordCatch);\n  // Store hand message ID for reliable future edits\n  if (playerNum === 1) game.p1HandMessageId = interaction.message.id;\n  else game.p2HandMessageId = interaction.message.id;\n  await updateHandVisualMessage(game\x2C playerNum\x2C client);\n  if (game.player1CcDrawn && game.player2CcDrawn) {\n    await updatePlayAreaDcButtons(game\x2C client);\n    const { sendPhaseGateMessages } = ctx;\n    await sendPhaseGateMessages(game\x2C 'cc_drawn'\x2C ctx);\n  }\n  saveGames();\n}\n\n/**\n * Handle I Know Everything choice (ike_keep_ button).\n * The targeted player picks which card to keep; the other is removed from the game.\n * Then triggers the shuffle/draw for that player.\n */\nexport async function handleIKnowEverythingKeep(interaction\x2C ctx) {\n  const { getGame\x2C shuffleArray\x2C buildHandDisplayPayload\x2C updateHandVisualMessage\x2C updatePlayAreaDcButtons\x2C sendRoundActivationPhaseMessage\x2C runStartOfRoundDcEffects\x2C logGameAction\x2C saveGames\x2C client } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const match = interaction.customId.match(/^ike_keep_(.+)_(\\d)$/);\n  if (!match) return;\n  const [\x2C gameId\x2C keepIdxStr] = match;\n  const keepIdx = parseInt(keepIdxStr\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game || !game.pendingIKnowEverything) {\n    await interaction.followUp({ content: 'No pending I Know Everything choice.'\x2C ephemeral: true }).catch(discordCatch); return;\n  }\n  const pending = game.pendingIKnowEverything;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pending.targetPlayerNum\x2C canActAsPlayer\x2C 'Only the targeted player can choose.')) return;\n\n  const keptCard = pending.cards[keepIdx];\n  const removedCard = pending.cards[1 - keepIdx];\n  const playerNum = pending.targetPlayerNum;\n\n  // Remove the unchosen card from the squad's CC list\n  const squad = getSquad(game\x2C playerNum);\n  if (squad?.ccList) {\n    const rmIdx = squad.ccList.indexOf(removedCard);\n    if (rmIdx >= 0) squad.ccList.splice(rmIdx\x2C 1);\n  }\n\n  delete game.pendingIKnowEverything;\n  game.iKnowEverythingResolved = true;\n\n  await logGameAction(game\x2C client\x2C `\ud83d\udd75\ufe0f **I Know Everything** \u2014 Kept **${keptCard}**. **${removedCard}** removed from the game.`\x2C { phase: 'DEPLOYMENT'\x2C icon: 'card' });\n  try { await interaction.message.edit({ components: [] }); } catch {}\n\n  // Now perform the shuffle and draw for the targeted player\n  const ccList = squad?.ccList || [];\n  const attachKey = ccAttachmentsKey(playerNum);\n  const placed = (game[attachKey] && Object.values(game[attachKey]).flat()) || [];\n  const deck = ccList.filter(c => !placed.includes(c));\n  shuffleArray(deck);\n  let hand = deck.splice(0\x2C 3);\n  const deckKey = ccDeckKey(playerNum);\n  const handKey = ccHandKey(playerNum);\n  game[deckKey] = deck;\n  game[handKey] = hand;\n  const drawnKey = ccDrawnKey(playerNum);\n  game[drawnKey] = true;\n  const playerId = getPlayerId(game\x2C playerNum);\n  await logGameAction(game\x2C client\x2C `<@${playerId}> shuffled and drew 3 Command Cards.`\x2C { phase: 'DEPLOYMENT'\x2C icon: 'card'\x2C allowedMentions: { users: [playerId] } });\n\n  // Update hand display in the player's hand thread\n  const handChannelId = getHandChannelId(game\x2C playerNum);\n  if (handChannelId) {\n    try {\n      const handChannel = await fetchGameChannel(client\x2C handChannelId);\n      const handPayload = buildHandDisplayPayload(hand\x2C deck\x2C gameId\x2C game\x2C playerNum);\n      await withDiscordRetry(() => handChannel.send(handPayload));\n    } catch {}\n  }\n  await updateHandVisualMessage(game\x2C playerNum\x2C client);\n  if (game.player1CcDrawn && game.player2CcDrawn) {\n    await updatePlayAreaDcButtons(game\x2C client);\n    const { sendPhaseGateMessages } = ctx;\n    await sendPhaseGateMessages(game\x2C 'cc_drawn'\x2C ctx);\n  }\n  saveGames();\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction */\nexport async function handleCcPlay(interaction\x2C ctx) {\n  const { getGame\x2C getPlayableCcFromHand } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'cc_play_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const channelId = interaction.channel?.id;\n  const isP1Hand = channelId === game.p1HandId;\n  const isP2Hand = channelId === game.p2HandId;\n  if (!isP1Hand && !isP2Hand) {\n    await interaction.followUp({ content: 'Use this in your **Your Hand** thread (inside your Play Area).'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const playerNum = isP1Hand ? 1 : 2;\n  const hand = playerNum === 1 ? (game.player1CcHand || []) : (game.player2CcHand || []);\n  if (hand.length === 0) {\n    await interaction.followUp({ content: 'No cards in hand to play.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const playable = getPlayableCcFromHand(game\x2C playerNum\x2C hand);\n  if (playable.length === 0) {\n    await interaction.followUp({\n      content: "No command cards can be played right now (wrong timing). Play cards during your activation\x2C at start/end of round\x2C or during an attack as appropriate."\x2C\n      ephemeral: true\x2C\n    }).catch(discordCatch);\n    return;\n  }\n  const select = new StringSelectMenuBuilder()\n    .setCustomId(`cc_play_select_${gameId}`)\n    .setPlaceholder('Choose a card to play')\n    .addOptions(playable.slice(0\x2C 25).map((c) => new StringSelectMenuOptionBuilder().setLabel(c).setValue(c)));\n  await interaction.followUp({\n    content: '**Play CC** \u2014 Select a card:'\x2C\n    components: [new ActionRowBuilder().addComponents(select)]\x2C\n    ephemeral: false\x2C\n  });\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction */\nexport async function handleCcDraw(interaction\x2C ctx) {\n  const { getGame\x2C buildHandDisplayPayload\x2C updateHandVisualMessage\x2C logGameAction\x2C saveGames\x2C client } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'cc_draw_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const channelId = interaction.channel?.id;\n  const isP1Hand = channelId === game.p1HandId;\n  const isP2Hand = channelId === game.p2HandId;\n  if (!isP1Hand && !isP2Hand) {\n    await interaction.followUp({ content: 'Use this in your **Your Hand** thread (inside your Play Area).'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const playerNum = isP1Hand ? 1 : 2;\n  const deckKey = ccDeckKey(playerNum);\n  const handKey = ccHandKey(playerNum);\n  let deck = (game[deckKey] || []).slice();\n  const hand = (game[handKey] || []).slice();\n  if (deck.length === 0) {\n    await interaction.followUp({ content: 'No cards in deck to draw.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const card = deck.shift();\n  hand.push(card);\n  game[deckKey] = deck;\n  game[handKey] = hand;\n  const handPayload = buildHandDisplayPayload(hand\x2C deck\x2C gameId\x2C game\x2C playerNum);\n  handPayload.content = `**Draw CC** \u2014 Drew **${card}**.\\n\\n` + handPayload.content;\n  await interaction.message.edit({\n    content: handPayload.content\x2C\n    embeds: handPayload.embeds\x2C\n    files: handPayload.files || []\x2C\n    components: handPayload.components\x2C\n  }).catch(discordCatch);\n  await updateHandVisualMessage(game\x2C playerNum\x2C client);\n  await logGameAction(game\x2C client\x2C `<@${interaction.user.id}> drew **${card}**`\x2C { allowedMentions: { users: [interaction.user.id] }\x2C icon: 'card' });\n  saveGames();\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction */\nexport async function handleCcSearchDiscard(interaction\x2C ctx) {\n  const { getGame\x2C buildDiscardPileDisplayPayload\x2C updateDiscardPileMessage\x2C saveGames\x2C client } = ctx;\n  const match = interaction.customId.match(/^cc_search_discard_([^_]+)_(\\d+)$/);\n  if (!match) return;\n  const [\x2C gameId\x2C playerNumStr] = match;\n  const playerNum = parseInt(playerNumStr\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const channelId = interaction.channel?.id;\n  const isP1Area = channelId === game.p1PlayAreaId;\n  const isP2Area = channelId === game.p2PlayAreaId;\n  if ((!isP1Area && !isP2Area) || (isP1Area && playerNum !== 1) || (isP2Area && playerNum !== 2)) {\n    await interaction.followUp({ content: 'Use this in your Play Area.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner of this Play Area can search their discard pile.')) return;\n  const existingThreadId = getDiscardThreadId(game\x2C playerNum);\n  if (existingThreadId) {\n    try {\n      const existing = await fetchGameChannel(client\x2C existingThreadId);\n      if (existing) {\n        await interaction.followUp({ content: 'Discard pile thread is already open. Close it first.'\x2C ephemeral: true }).catch(discordCatch);\n        return;\n      }\n    } catch { /* thread was deleted */ }\n    if (playerNum === 1) delete game.p1DiscardThreadId;\n    else delete game.p2DiscardThreadId;\n  }\n  const discard = getCcDiscard(game\x2C playerNum) || [];\n  const threadName = `Discard Pile (${discard.length} cards)`;\n  const thread = await interaction.message.startThread({\n    name: threadName.slice(0\x2C 100)\x2C\n    autoArchiveDuration: ThreadAutoArchiveDuration.OneWeek\x2C\n  });\n  if (playerNum === 1) game.p1DiscardThreadId = thread.id;\n  else game.p2DiscardThreadId = thread.id;\n  const chunks = buildDiscardPileDisplayPayload(discard);\n  const closeRow = new ActionRowBuilder().addComponents(\n    new ButtonBuilder()\n      .setCustomId(`cc_close_discard_${gameId}_${playerNum}`)\n      .setLabel('Close Discard Pile')\n      .setStyle(ButtonStyle.Danger)\n  );\n  if (chunks.length === 0) {\n    await thread.send({\n      content: 'Discard pile is empty.'\x2C\n      embeds: [new EmbedBuilder().setTitle('Command Cards in Discard Pile').setDescription('*Empty*').setColor(COLORS.DARK_EMBED)]\x2C\n      components: [closeRow]\x2C\n    });\n  } else {\n    for (let i = 0; i < chunks.length; i++) {\n      const isLast = i === chunks.length - 1;\n      await thread.send({\n        embeds: chunks[i].embeds\x2C\n        files: chunks[i].files\x2C\n        components: isLast ? [closeRow] : []\x2C\n      });\n    }\n  }\n  await updateDiscardPileMessage(game\x2C playerNum\x2C client);\n  saveGames();\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction */\nexport async function handleCcCloseDiscard(interaction\x2C ctx) {\n  const { getGame\x2C updateDiscardPileMessage\x2C saveGames\x2C client } = ctx;\n  const match = interaction.customId.match(/^cc_close_discard_([^_]+)_(\\d+)$/);\n  if (!match) return;\n  const [\x2C gameId\x2C playerNumStr] = match;\n  const playerNum = parseInt(playerNumStr\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const threadId = getDiscardThreadId(game\x2C playerNum);\n  if (!threadId) {\n    await interaction.followUp({ content: 'No discard pile thread is open.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner can close the discard pile thread.')) return;\n  try {\n    const thread = await fetchGameChannel(client\x2C threadId);\n    await thread.delete();\n  } catch (err) {\n    console.error('Failed to delete discard pile thread:'\x2C err);\n  }\n  if (playerNum === 1) delete game.p1DiscardThreadId;\n  else delete game.p2DiscardThreadId;\n  await updateDiscardPileMessage(game\x2C playerNum\x2C client);\n  saveGames();\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction */\nexport async function handleCcDiscard(interaction\x2C ctx) {\n  const { getGame } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'cc_discard_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const channelId = interaction.channel?.id;\n  const isP1Hand = channelId === game.p1HandId;\n  const isP2Hand = channelId === game.p2HandId;\n  if (!isP1Hand && !isP2Hand) {\n    await interaction.followUp({ content: 'Use this in your **Your Hand** thread (inside your Play Area).'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const playerNum = isP1Hand ? 1 : 2;\n  const hand = playerNum === 1 ? (game.player1CcHand || []) : (game.player2CcHand || []);\n  if (hand.length === 0) {\n    await interaction.followUp({ content: 'No cards in hand to discard.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const select = new StringSelectMenuBuilder()\n    .setCustomId(`cc_discard_select_${gameId}`)\n    .setPlaceholder('Choose a card to discard')\n    .addOptions(hand.slice(0\x2C 25).map((c) => new StringSelectMenuOptionBuilder().setLabel(c).setValue(c)));\n  await interaction.followUp({\n    content: '**Discard CC** \u2014 Select a card to discard:'\x2C\n    components: [new ActionRowBuilder().addComponents(select)]\x2C\n    ephemeral: false\x2C\n  });\n}\n\n/** @param {import('discord.js').ButtonInteraction} interaction */\nexport async function handleSquadSelect(interaction\x2C ctx) {\n  const { getGame } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'squad_select_');\n  const gameId = parts[0];\n  const playerNum = parts[1];\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { useReply: true });\n  if (!game) return;\n  if (!game.mapSelected) {\n    await interaction.followUp({ content: 'Map selection must be completed before you can select your squad.'\x2C ephemeral: true });\n    return;\n  }\n  const isP1 = playerNum === '1';\n  const pn = isP1 ? 1 : 2;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pn\x2C canActAsPlayer\x2C 'Only the owner of this hand can select a squad.')) return;\n  const modal = new ModalBuilder()\n    .setCustomId(`squad_modal_${gameId}_${playerNum}`)\n    .setTitle('Submit Squad');\n  modal.addComponents(\n    new ActionRowBuilder().addComponents(\n      new TextInputBuilder()\n        .setCustomId('squad_name')\n        .setLabel('Squad name')\n        .setStyle(TextInputStyle.Short)\n        .setPlaceholder("e.g. Vader's Fist")\n        .setRequired(false)\n    )\x2C\n    new ActionRowBuilder().addComponents(\n      new TextInputBuilder()\n        .setCustomId('squad_dc')\n        .setLabel('Deployment Cards (one per line\x2C max 40 pts)')\n        .setStyle(TextInputStyle.Paragraph)\n        .setPlaceholder('Darth Vader\\nStormtrooper\\nStormtrooper\\n...')\n        .setRequired(true)\n    )\x2C\n    new ActionRowBuilder().addComponents(\n      new TextInputBuilder()\n        .setCustomId('squad_cc')\n        .setLabel('Command Cards (one per line\x2C exactly 15)')\n        .setStyle(TextInputStyle.Paragraph)\n        .setPlaceholder('Force Lightning\\nBurst Fire\\n...')\n        .setRequired(true)\n    )\n  );\n  await interaction.showModal(modal);\n}\n
