script-source,163,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/movement.js,/**\n * Movement logic: board state\x2C profile\x2C cache\x2C reachable spaces\x2C path cost. No Discord.\n */\nimport {\n  parseCoord\x2C\n  normalizeCoord\x2C\n  colRowToCoord\x2C\n  edgeKey\x2C\n  toLowerSet\x2C\n  parseSizeString\x2C\n  sizeToString\x2C\n  getFootprintCells\x2C\n  shiftCoord\x2C\n  rotateSizeString\x2C\n} from './coords.js';\nimport {\n  getMapData\x2C\n  getMapRegistry\x2C\n  getMapTokensData\x2C\n  getDcKeywords\x2C\n  getFigureSize\x2C\n  isDcCompanion\x2C\n} from '../data-loader.js';\nimport { getDcList\x2C getDcMessageIds\x2C getDcAttachments\x2C opponentPlayerNum\x2C pushFigure } from './player-helpers.js';\nimport { dcNameFromFigureKey } from './dc-helpers.js';\n\n// ---------------------------------------------------------------------------\n// Wasskah Hunting Ground: breakable walls (blue-line edges on the map diagram).\n// Per mission rules: "Walls between spaces containing difficult terrain\n// (indicated by blue lines on the map diagram) do not block movement\x2C\n// adjacency\x2C line of sight\x2C or counting spaces."\n// Each entry is [spaceA\x2C spaceB] \u2014 the two spaces on either side of a\n// blue-line wall edge.  When BOTH spaces contain difficult terrain (including\n// rubble tokens)\x2C the wall is passable.\n// ---------------------------------------------------------------------------\nconst WASSKAH_BREAKABLE_WALLS = [\n  // Upper-left building \u2014 south wall (row 8 \u2192 9 boundary)\n  ['e8'\x2C 'e9']\x2C\n  ['f8'\x2C 'f9']\x2C\n  // Upper-left building \u2014 east wall (col F \u2192 G boundary)\n  ['f6'\x2C 'g6']\x2C\n  ['f7'\x2C 'g7']\x2C\n  // Central building cluster \u2014 west walls\n  ['h9'\x2C 'h10']\x2C\n  ['h13'\x2C 'h14']\x2C\n  // Central building cluster \u2014 east walls\n  ['n9'\x2C 'o9']\x2C\n  ['n13'\x2C 'o13']\x2C\n  // Lower-left building \u2014 north wall (row 16 \u2192 15 boundary)\n  ['i15'\x2C 'i16']\x2C\n  ['j15'\x2C 'j16']\x2C\n  // Lower-left building \u2014 east wall\n  ['l17'\x2C 'm17']\x2C\n  ['l18'\x2C 'm18']\x2C\n  // Lower-right building \u2014 north wall\n  ['o18'\x2C 'o19']\x2C\n  ['p18'\x2C 'p19']\x2C\n  // Lower-right building \u2014 west wall\n  ['n19'\x2C 'n20']\x2C\n  ['n21'\x2C 'n22']\x2C\n];\n\n/**\n * Build a Set of edgeKey strings for breakable walls that are currently passable\n * because both adjacent spaces contain difficult terrain.\n * @param {object} game - game state (for map id\x2C rubble tokens\x2C terrain)\n * @param {object} mapSpaces - the map's spatial data ({ terrain })\n * @returns {Set<string>} set of edgeKey strings for currently-broken walls\n */\nexport function getBrokenWallEdges(game\x2C mapSpaces) {\n  if (game?.selectedMap?.id !== 'wasskah-hunting-ground') return new Set();\n  // Collect all difficult-terrain spaces: map terrain + rubble tokens (both storage locations)\n  const difficultSet = new Set();\n  for (const [coord\x2C type] of Object.entries(mapSpaces?.terrain || {})) {\n    if (String(type).toLowerCase() === 'difficult') difficultSet.add(normalizeCoord(coord));\n  }\n  // game.rubbleTokens (Flame Trooper Incinerate)\n  if (Array.isArray(game.rubbleTokens)) {\n    for (const rc of game.rubbleTokens) difficultSet.add(normalizeCoord(rc));\n  }\n  // game.ancillaryTokens.rubble (Demolish\x2C Boulder Barrage\x2C Reduce to Rubble)\n  if (Array.isArray(game.ancillaryTokens?.rubble)) {\n    for (const rc of game.ancillaryTokens.rubble) difficultSet.add(normalizeCoord(rc));\n  }\n  const broken = new Set();\n  for (const [a\x2C b] of WASSKAH_BREAKABLE_WALLS) {\n    if (difficultSet.has(a) && difficultSet.has(b)) {\n      broken.add(edgeKey(a\x2C b));\n    }\n  }\n  return broken;\n}\n\n/**\n * Return impassableEdges filtered to exclude currently-broken Wasskah walls.\n * Safe to call for any map \u2014 returns the original array unchanged for non-Wasskah maps.\n * @param {object} game\n * @param {object} mapSpaces - { impassableEdges\x2C terrain\x2C ... }\n * @returns {Array} filtered impassableEdges array\n */\nexport function getEffectiveImpassableEdges(game\x2C mapSpaces) {\n  const edges = mapSpaces?.impassableEdges || [];\n  const broken = getBrokenWallEdges(game\x2C mapSpaces);\n  if (broken.size === 0) return edges;\n  return edges.filter((e) => !broken.has(edgeKey(e[0]\x2C e[1])));\n}\n\n/**\n * Return a copy of mapSpaces with impassableEdges filtered for Wasskah breakable walls.\n * Useful for standalone LOS checks that pass mapSpaces directly.\n * Returns the original object unchanged for non-Wasskah maps or when no walls are broken.\n */\nexport function getEffectiveMapSpaces(game\x2C mapSpaces) {\n  if (!mapSpaces) return mapSpaces;\n  const filtered = getEffectiveImpassableEdges(game\x2C mapSpaces);\n  if (filtered === mapSpaces?.impassableEdges) return mapSpaces;\n  return { ...mapSpaces\x2C impassableEdges: filtered };\n}\n\nexport function isWithinGridBounds(coord\x2C gridBounds) {\n  if (!gridBounds || (gridBounds.maxCol == null && gridBounds.maxRow == null)) return true;\n  const { col\x2C row } = parseCoord(coord);\n  if (col < 0 || row < 0) return false;\n  if (gridBounds.maxCol != null && col > gridBounds.maxCol) return false;\n  if (gridBounds.maxRow != null && row > gridBounds.maxRow) return false;\n  return true;\n}\n\nexport function filterMapSpacesByBounds(rawMapSpaces\x2C gridBounds) {\n  if (!gridBounds || (gridBounds.maxCol == null && gridBounds.maxRow == null)) return rawMapSpaces;\n  const inBounds = (c) => isWithinGridBounds(c\x2C gridBounds);\n  const spaces = (rawMapSpaces.spaces || []).filter(inBounds);\n  const spaceSet = new Set(spaces.map((s) => normalizeCoord(s)));\n  const adjacency = {};\n  for (const [coord\x2C neighbors] of Object.entries(rawMapSpaces.adjacency || {})) {\n    if (!inBounds(coord)) continue;\n    adjacency[normalizeCoord(coord)] = (neighbors || []).filter((n) => spaceSet.has(normalizeCoord(n))).map((n) => normalizeCoord(n));\n  }\n  const terrain = {};\n  for (const [coord\x2C type] of Object.entries(rawMapSpaces.terrain || {})) {\n    if (inBounds(coord)) terrain[normalizeCoord(coord)] = String(type || 'normal').toLowerCase();\n  }\n  const blocking = (rawMapSpaces.blocking || []).filter(inBounds);\n  const movementBlockingEdges = (rawMapSpaces.movementBlockingEdges || []).filter(\n    ([a\x2C b]) => spaceSet.has(normalizeCoord(a)) && spaceSet.has(normalizeCoord(b))\n  );\n  const impassableEdges = (rawMapSpaces.impassableEdges || []).filter(\n    ([a\x2C b]) => spaceSet.has(normalizeCoord(a)) && spaceSet.has(normalizeCoord(b))\n  );\n  return {\n    ...rawMapSpaces\x2C\n    spaces\x2C\n    adjacency\x2C\n    terrain\x2C\n    blocking\x2C\n    movementBlockingEdges\x2C\n    impassableEdges\x2C\n  };\n}\n\n/**\n * Get map spaces filtered by the map's gridBounds (convenience wrapper).\n * @param {string} mapId\n * @returns {object} Filtered map spaces with adjacency\x2C terrain\x2C etc.\n */\nexport function getBoundedMapSpaces(mapId) {\n  const rawMapSpaces = getMapData(mapId);\n  if (!rawMapSpaces) return rawMapSpaces;\n  const mapDef = getMapRegistry().find((m) => m.id === mapId);\n  return filterMapSpacesByBounds(rawMapSpaces\x2C mapDef?.gridBounds);\n}\n\nexport function getOccupiedSpacesForMovement(game\x2C excludeFigureKey = null) {\n  const occupied = [];\n  const poses = game.figurePositions || { 1: {}\x2C 2: {} };\n  for (const p of [1\x2C 2]) {\n    for (const [k\x2C coord] of Object.entries(poses[p] || {})) {\n      if (k === excludeFigureKey) continue;\n      // G39: Companion figures can share spaces \u2014 don't block movement\n      const dcName = dcNameFromFigureKey(k);\n      if (isDcCompanion(dcName)) continue;\n      const size = game.figureOrientations?.[k] || getFigureSize(dcName);\n      occupied.push(...getFootprintCells(coord\x2C size));\n    }\n  }\n  return occupied;\n}\n\nexport function getHostileOccupiedSpacesForMovement(game\x2C excludeFigureKey = null) {\n  const hostile = [];\n  const poses = game.figurePositions || { 1: {}\x2C 2: {} };\n  const movingPlayerNum = excludeFigureKey\n    ? (poses[1]?.[excludeFigureKey] != null ? 1 : 2)\n    : null;\n  if (movingPlayerNum == null) return hostile;\n  const other = opponentPlayerNum(movingPlayerNum);\n  for (const [k\x2C coord] of Object.entries(poses[other] || {})) {\n    const dcName = dcNameFromFigureKey(k);\n    const size = game.figureOrientations?.[k] || getFigureSize(dcName);\n    hostile.push(...getFootprintCells(coord\x2C size));\n  }\n  return hostile;\n}\n\n/**\n * Get all figures on or adjacent to a given coordinate (1x1 space).\n * Used by Blast when the target's position may already be removed (defeat)\x2C\n * and by Cleave for attacker-based eligibility.\n */\nexport function getFiguresAdjacentToCoord(game\x2C coord\x2C mapId\x2C excludeFigureKey) {\n  if (!coord || !mapId) return [];\n  const rawMapSpaces = getMapData(mapId);\n  if (!rawMapSpaces?.adjacency) return [];\n  const mapDef = getMapRegistry().find((m) => m.id === mapId);\n  const mapSpaces = filterMapSpacesByBounds(rawMapSpaces\x2C mapDef?.gridBounds);\n  const adjacency = mapSpaces.adjacency || {};\n  const normCoord = normalizeCoord(coord);\n  const adjacentSet = new Set();\n  for (const n of adjacency[normCoord] || []) adjacentSet.add(normalizeCoord(n));\n  adjacentSet.add(normCoord);\n  const poses = game?.figurePositions || { 1: {}\x2C 2: {} };\n  const out = [];\n  for (const p of [1\x2C 2]) {\n    for (const [figureKey\x2C fCoord] of Object.entries(poses[p] || {})) {\n      if (figureKey === excludeFigureKey) continue;\n      const dcName = dcNameFromFigureKey(figureKey);\n      const size = game.figureOrientations?.[figureKey] || getFigureSize(dcName);\n      const cells = getFootprintCells(fCoord\x2C size).map((c) => normalizeCoord(c));\n      if (cells.some((cell) => adjacentSet.has(cell))) out.push({ figureKey\x2C playerNum: p });\n    }\n  }\n  return out;\n}\n\n/** F6 Blast: Figures with at least one space adjacent to the target figure. Returns [{ figureKey\x2C playerNum }\x2C ...]. */\nexport function getFiguresAdjacentToTarget(game\x2C targetFigureKey\x2C mapId) {\n  const poses = game?.figurePositions || { 1: {}\x2C 2: {} };\n  let targetCoord = null;\n  let targetPlayerNum = null;\n  for (const p of [1\x2C 2]) {\n    if (poses[p]?.[targetFigureKey]) {\n      targetCoord = poses[p][targetFigureKey];\n      targetPlayerNum = p;\n      break;\n    }\n  }\n  if (!targetCoord || !mapId) return [];\n  const rawMapSpaces = getMapData(mapId);\n  if (!rawMapSpaces?.adjacency) return [];\n  const mapDef = getMapRegistry().find((m) => m.id === mapId);\n  const mapSpaces = filterMapSpacesByBounds(rawMapSpaces\x2C mapDef?.gridBounds);\n  const adjacency = mapSpaces.adjacency || {};\n  const targetDcName = dcNameFromFigureKey(targetFigureKey);\n  const targetSize = game.figureOrientations?.[targetFigureKey] || getFigureSize(targetDcName);\n  const targetCells = getFootprintCells(targetCoord\x2C targetSize).map((c) => normalizeCoord(c));\n  const adjacentSet = new Set();\n  for (const c of targetCells) {\n    for (const n of adjacency[c] || []) adjacentSet.add(normalizeCoord(n));\n  }\n  const out = [];\n  for (const p of [1\x2C 2]) {\n    for (const [figureKey\x2C coord] of Object.entries(poses[p] || {})) {\n      if (figureKey === targetFigureKey) continue;\n      const dcName = dcNameFromFigureKey(figureKey);\n      const size = game.figureOrientations?.[figureKey] || getFigureSize(dcName);\n      const cells = getFootprintCells(coord\x2C size).map((c) => normalizeCoord(c));\n      if (cells.some((cell) => adjacentSet.has(cell))) out.push({ figureKey\x2C playerNum: p });\n    }\n  }\n  return out;\n}\n\nexport function getMovementKeywords(dcName\x2C game) {\n  const raw = getDcKeywords(game)?.[dcName] || [];\n  return new Set(raw.map((k) => String(k).toLowerCase()));\n}\n\nexport function getBoardStateForMovement(game\x2C excludeFigureKey = null) {\n  if (!game?.selectedMap?.id) return null;\n  const rawMapSpaces = getMapData(game.selectedMap.id);\n  if (!rawMapSpaces) return null;\n  const mapDef = getMapRegistry().find((m) => m.id === game.selectedMap.id);\n  const mapSpaces = filterMapSpacesByBounds(rawMapSpaces\x2C mapDef?.gridBounds);\n  const occupiedSet = new Set(\n    getOccupiedSpacesForMovement(game\x2C excludeFigureKey).map((s) => normalizeCoord(s))\n  );\n  const hostileOccupiedSet = new Set(\n    getHostileOccupiedSpacesForMovement(game\x2C excludeFigureKey).map((s) => normalizeCoord(s))\n  );\n  const blockingSet = toLowerSet(mapSpaces.blocking || []);\n  const spacesSet = toLowerSet(mapSpaces.spaces || []);\n  const terrain = {};\n  for (const [coord\x2C type] of Object.entries(mapSpaces.terrain || {})) {\n    terrain[normalizeCoord(coord)] = String(type || 'normal').toLowerCase();\n  }\n  // Rubble tokens (Flame Trooper Incinerate): treat as difficult terrain\n  if (Array.isArray(game.rubbleTokens)) {\n    for (const rc of game.rubbleTokens) {\n      const nc = normalizeCoord(rc);\n      if (!terrain[nc] || terrain[nc] === 'normal') terrain[nc] = 'difficult';\n    }\n  }\n  // Rubble tokens (Demolish\x2C Boulder Barrage\x2C Reduce to Rubble): also difficult terrain\n  if (Array.isArray(game.ancillaryTokens?.rubble)) {\n    for (const rc of game.ancillaryTokens.rubble) {\n      const nc = normalizeCoord(rc);\n      if (!terrain[nc] || terrain[nc] === 'normal') terrain[nc] = 'difficult';\n    }\n  }\n  const adjacency = {};\n  for (const [coord\x2C neighbors] of Object.entries(mapSpaces.adjacency || {})) {\n    adjacency[normalizeCoord(coord)] = (neighbors || []).map((n) => normalizeCoord(n));\n  }\n  const movementBlockingSet = new Set(\n    (mapSpaces.movementBlockingEdges || []).map((edge) => edgeKey(edge[0]\x2C edge[1]))\n  );\n  // Wasskah breakable walls: filter out edges that are passable due to difficult terrain\n  const effectiveImpassable = getEffectiveImpassableEdges(game\x2C mapSpaces);\n  for (const edge of effectiveImpassable) {\n    if (edge?.length >= 2) movementBlockingSet.add(edgeKey(edge[0]\x2C edge[1]));\n  }\n  const mapData = getMapTokensData()[game.selectedMap.id];\n  const openedSet = new Set((game.openedDoors || []).map((k) => String(k).toLowerCase()));\n  for (const edge of mapData?.doors || []) {\n    if (edge?.length >= 2) {\n      const ek = edgeKey(edge[0]\x2C edge[1]);\n      if (!openedSet.has(ek)) movementBlockingSet.add(ek);\n    }\n  }\n  // G64: Track cells occupied by Massive figures (Massive cannot enter other Massive)\n  const massiveOccupiedSet = new Set();\n  const poses = game.figurePositions || { 1: {}\x2C 2: {} };\n  for (const p of [1\x2C 2]) {\n    for (const [k\x2C coord] of Object.entries(poses[p] || {})) {\n      if (k === excludeFigureKey) continue;\n      const dn = dcNameFromFigureKey(k);\n      const kws = getDcKeywords(game)?.[dn] || [];\n      if (kws.some((kw) => String(kw).toUpperCase() === 'MASSIVE')) {\n        const sz = game.figureOrientations?.[k] || getFigureSize(dn);\n        for (const cell of getFootprintCells(coord\x2C sz)) massiveOccupiedSet.add(normalizeCoord(cell));\n      }\n    }\n  }\n  return { mapSpaces\x2C adjacency\x2C terrain\x2C blockingSet\x2C occupiedSet\x2C hostileOccupiedSet\x2C movementBlockingSet\x2C spacesSet\x2C massiveOccupiedSet };\n}\n\nexport function getMovementProfile(dcName\x2C figureKey\x2C game) {\n  const baseSize = getFigureSize(dcName) || '1x1';\n  const storedSize = game.figureOrientations?.[figureKey] || baseSize;\n  const { cols\x2C rows } = parseSizeString(storedSize);\n  const keywords = getMovementKeywords(dcName\x2C game);\n  const isMassive = keywords.has('massive');\n  const isMobile = keywords.has('mobile');\n  let hasEfficientTravel = keywords.has('efficient travel');\n  // Check round flag from Efficient Travel CC card\n  if (!hasEfficientTravel && figureKey) {\n    for (const pn of [1\x2C 2]) {\n      if (figureKey in (game.figurePositions?.[pn] || {})) {\n        if (game.roundEfficientTravel?.[pn]) hasEfficientTravel = true;\n        break;\n      }\n    }\n  }\n  // Survivalist (Skirmish Upgrade): ignore difficult terrain and hostile figure movement costs\n  let hasSurvivalist = false;\n  if (figureKey && game) {\n    const _svDcName = dcNameFromFigureKey(figureKey);\n    for (const pn of [1\x2C 2]) {\n      if (!(figureKey in (game.figurePositions?.[pn] || {}))) continue;\n      const _svList = getDcList(game\x2C pn) || [];\n      const _svIds = getDcMessageIds(game\x2C pn) || [];\n      for (let i = 0; i < _svList.length; i++) {\n        if (_svList[i]?.dcName !== _svDcName) continue;\n        const _svAtt = getDcAttachments(game\x2C pn)?.[_svIds[i]];\n        if (_svAtt?.includes('Survivalist')) hasSurvivalist = true;\n        break;\n      }\n      break;\n    }\n  }\n  // Mortar Trooper Haul: treat blocking and impassable terrain as difficult terrain\n  let hasMortarHaul = false;\n  if (figureKey && game) {\n    const _mhDcName = dcNameFromFigureKey(figureKey);\n    for (const pn of [1\x2C 2]) {\n      if (!(figureKey in (game.figurePositions?.[pn] || {}))) continue;\n      const _mhList = getDcList(game\x2C pn) || [];\n      const _mhIds = getDcMessageIds(game\x2C pn) || [];\n      for (let i = 0; i < _mhList.length; i++) {\n        if (_mhList[i]?.dcName !== _mhDcName) continue;\n        const _mhAtt = getDcAttachments(game\x2C pn)?.[_mhIds[i]];\n        if (_mhAtt?.includes('Mortar Trooper')) hasMortarHaul = true;\n        break;\n      }\n      break;\n    }\n  }\n  return {\n    size: storedSize\x2C\n    cols\x2C\n    rows\x2C\n    isLarge: cols !== 1 || rows !== 1\x2C\n    allowDiagonal: cols === 1 && rows === 1\x2C\n    canRotate: cols !== rows\x2C\n    isMassive\x2C\n    isMobile\x2C\n    ignoreDifficult: isMassive || isMobile || hasEfficientTravel || hasSurvivalist\x2C\n    ignoreBlocking: isMassive || isMobile\x2C\n    ignoreFigureCost: isMassive || isMobile || hasEfficientTravel || hasSurvivalist\x2C\n    canEndOnOccupied: isMassive\x2C\n    treatBlockingAsDifficult: hasMortarHaul\x2C\n    keywords\x2C\n  };\n}\n\nexport function buildTempBoardState(mapSpaces\x2C occupiedSet\x2C hostileOccupiedSet = null\x2C game = null) {\n  if (!mapSpaces) return null;\n  const blockingSet = toLowerSet(mapSpaces.blocking || []);\n  const spacesSet = toLowerSet(mapSpaces.spaces || []);\n  const terrain = {};\n  for (const [coord\x2C type] of Object.entries(mapSpaces.terrain || {})) {\n    terrain[normalizeCoord(coord)] = String(type || 'normal').toLowerCase();\n  }\n  const adjacency = {};\n  for (const [coord\x2C neighbors] of Object.entries(mapSpaces.adjacency || {})) {\n    adjacency[normalizeCoord(coord)] = (neighbors || []).map((n) => normalizeCoord(n));\n  }\n  const movementBlockingSet = new Set(\n    (mapSpaces.movementBlockingEdges || []).map((edge) => edgeKey(edge[0]\x2C edge[1]))\n  );\n  // Wasskah breakable walls: filter out edges passable due to difficult terrain\n  const effectiveImpassable = game ? getEffectiveImpassableEdges(game\x2C mapSpaces) : (mapSpaces.impassableEdges || []);\n  for (const edge of effectiveImpassable) {\n    if (edge?.length >= 2) movementBlockingSet.add(edgeKey(edge[0]\x2C edge[1]));\n  }\n  const board = {\n    mapSpaces\x2C\n    adjacency\x2C\n    terrain\x2C\n    blockingSet\x2C\n    occupiedSet: new Set((occupiedSet || []).map((s) => normalizeCoord(s)))\x2C\n    movementBlockingSet\x2C\n    spacesSet\x2C\n  };\n  if (hostileOccupiedSet != null) {\n    board.hostileOccupiedSet = new Set((hostileOccupiedSet || []).map((s) => normalizeCoord(s)));\n  }\n  return board;\n}\n\nexport function movementStateKey(coord\x2C size) {\n  return `${normalizeCoord(coord)}|${size}`;\n}\n\nexport function getNormalizedFootprint(topLeft\x2C size) {\n  return getFootprintCells(topLeft\x2C size).map((c) => normalizeCoord(c));\n}\n\nfunction canMoveDiagonally(start\x2C dx\x2C dy\x2C board) {\n  if (!dx || !dy) return true;\n  const startLower = normalizeCoord(start);\n  const { col\x2C row } = parseCoord(startLower);\n  const aNorm = normalizeCoord(colRowToCoord(col + dx\x2C row));  // lateral corner (same row)\n  const bNorm = normalizeCoord(colRowToCoord(col\x2C row + dy));  // vertical corner (same col)\n  const destNorm = normalizeCoord(colRowToCoord(col + dx\x2C row + dy));\n  const aExists = board.spacesSet.has(aNorm);\n  const bExists = board.spacesSet.has(bNorm);\n  // Fully sealed corner \u2014 both sides absent\x2C cannot cut through\n  if (!aExists && !bExists) return false;\n  // IA corner-cut rule: diagonal is allowed if at least one full path (corner \u2192 dest) is open.\n  // First half: start \u2192 corner (adjacency encodes impassable walls; movementBlockingSet catches doors)\n  const adjList = board.adjacency?.[startLower] || [];\n  const adjSet = new Set(adjList);\n  const aFirstOpen = aExists && adjSet.has(aNorm) && !board.movementBlockingSet.has(edgeKey(startLower\x2C aNorm));\n  const bFirstOpen = bExists && adjSet.has(bNorm) && !board.movementBlockingSet.has(edgeKey(startLower\x2C bNorm));\n  // Second half: corner \u2192 dest (must not be walled off from the corner)\n  const aSecondOpen =\n    aFirstOpen &&\n    !board.movementBlockingSet.has(edgeKey(aNorm\x2C destNorm)) &&\n    (!board.adjacency?.[aNorm] || (board.adjacency[aNorm] || []).includes(destNorm));\n  const bSecondOpen =\n    bFirstOpen &&\n    !board.movementBlockingSet.has(edgeKey(bNorm\x2C destNorm)) &&\n    (!board.adjacency?.[bNorm] || (board.adjacency[bNorm] || []).includes(destNorm));\n  return aSecondOpen || bSecondOpen;\n}\n\nfunction getNeighborStates(state\x2C board\x2C profile) {\n  const neighbors = [];\n  const moveVectors = [\n    { dx: 1\x2C dy: 0 }\x2C\n    { dx: -1\x2C dy: 0 }\x2C\n    { dx: 0\x2C dy: 1 }\x2C\n    { dx: 0\x2C dy: -1 }\x2C\n  ];\n  if (profile.allowDiagonal) {\n    moveVectors.push(\n      { dx: 1\x2C dy: 1 }\x2C\n      { dx: 1\x2C dy: -1 }\x2C\n      { dx: -1\x2C dy: 1 }\x2C\n      { dx: -1\x2C dy: -1 }\n    );\n  }\n  // When adjacency data is present for this cell\x2C use it to restrict moves to genuinely\n  // connected cells. This handles maps where walls are encoded as adjacency restrictions\n  // rather than (or in addition to) movementBlockingEdges.\n  const adjForCell = board.adjacency?.[state.topLeft];\n  const adjSet = adjForCell ? new Set(adjForCell) : null;\n\n  for (const vec of moveVectors) {\n    const isDiagonal = !!(vec.dx && vec.dy);\n    if (isDiagonal && profile.isLarge) continue;\n    if (isDiagonal && !canMoveDiagonally(state.topLeft\x2C vec.dx\x2C vec.dy\x2C board)) continue;\n    const nextTopLeft = shiftCoord(state.topLeft\x2C vec.dx\x2C vec.dy);\n    if (!nextTopLeft || !board.spacesSet.has(nextTopLeft)) continue;\n    // For orthogonal moves\x2C adjacency is the source of truth for wall encoding.\n    // For diagonal moves\x2C canMoveDiagonally handles corner logic (adjacency data may not\n    // list diagonal targets that are reachable by the IA corner-cut rule).\n    if (!isDiagonal && adjSet && !adjSet.has(nextTopLeft)) continue;\n    neighbors.push({ type: 'move'\x2C topLeft: nextTopLeft\x2C size: state.size\x2C dx: vec.dx\x2C dy: vec.dy });\n  }\n  if (profile.canRotate) {\n    const rotatedSize = rotateSizeString(state.size);\n    neighbors.push({ type: 'rotate'\x2C topLeft: state.topLeft\x2C size: rotatedSize\x2C dx: 0\x2C dy: 0 });\n  }\n  return neighbors;\n}\n\nfunction evaluateMovementStep(current\x2C neighbor\x2C board\x2C profile) {\n  const nextFootprint = getNormalizedFootprint(neighbor.topLeft\x2C neighbor.size);\n  if (!nextFootprint.length) return null;\n  for (const cell of nextFootprint) {\n    if (!board.spacesSet.has(cell)) return null;\n  }\n  if (!profile.ignoreBlocking && !profile.treatBlockingAsDifficult) {\n    for (const cell of nextFootprint) {\n      if (board.blockingSet.has(cell)) return null;\n    }\n  }\n  const prevFootprint = current.footprint;\n  const prevSet = new Set(prevFootprint);\n  // Large figures must keep at least half their footprint in previously occupied cells each step\n  if (profile.isLarge) {\n    const overlapCount = nextFootprint.filter((c) => prevSet.has(c)).length;\n    if (overlapCount < Math.ceil(nextFootprint.length / 2)) return null;\n  }\n  if (neighbor.type === 'rotate') {\n    const overlapping = nextFootprint.some((c) => board.occupiedSet.has(c));\n    if (overlapping && !profile.canEndOnOccupied) return null;\n    return {\n      cost: 1\x2C\n      occupied: overlapping\x2C\n      canEnd: !overlapping || profile.canEndOnOccupied\x2C\n      footprint: nextFootprint\x2C\n    };\n  }\n  const entering = nextFootprint.filter((cell) => !prevSet.has(cell));\n  if (!entering.length) return null;\n  const dx = neighbor.dx;\n  const dy = neighbor.dy;\n  if (board.movementBlockingSet.size > 0) {\n    const backDx = dx ? -Math.sign(dx) : 0;\n    const backDy = dy ? -Math.sign(dy) : 0;\n    for (const cell of entering) {\n      const { col\x2C row } = parseCoord(cell);\n      const prevCoord = colRowToCoord(col + backDx\x2C row + backDy);\n      if (!prevSet.has(normalizeCoord(prevCoord))) continue;\n      if (board.movementBlockingSet.has(edgeKey(cell\x2C prevCoord))) return null;\n    }\n  }\n  const enteringBlockingCells = !profile.ignoreBlocking ? entering.filter((cell) => board.blockingSet.has(cell)) : [];\n  // Mortar Trooper Haul: blocking/impassable become difficult instead of impassable\n  if (enteringBlockingCells.length > 0 && !profile.treatBlockingAsDifficult) return null;\n  const enteringDifficult =\n    !profile.ignoreDifficult &&\n    (entering.some((cell) => (board.terrain[cell] || 'normal') === 'difficult') || (profile.treatBlockingAsDifficult && enteringBlockingCells.length > 0));\n  const enteringOccupied = entering.some((cell) => board.occupiedSet.has(cell));\n  const enteringHostile = board.hostileOccupiedSet\n    ? entering.some((cell) => board.hostileOccupiedSet.has(cell))\n    : enteringOccupied;\n  const baseCost = 1;\n  let extraCost = 0;\n  if (enteringDifficult) extraCost += 1;\n  if (enteringHostile && !profile.ignoreFigureCost) extraCost += 1;\n  return {\n    cost: baseCost + extraCost\x2C\n    occupied: enteringOccupied\x2C\n    canEnd: !enteringOccupied || profile.canEndOnOccupied\x2C\n    footprint: nextFootprint\x2C\n  };\n}\n\nexport function computeMovementCache(startCoord\x2C mpLimit\x2C board\x2C profile) {\n  const startTopLeft = normalizeCoord(startCoord);\n  if (!board?.spacesSet?.has(startTopLeft)) return { nodes: new Map()\x2C cells: new Map()\x2C parent: new Map()\x2C maxMp: mpLimit };\n  const startKey = movementStateKey(startTopLeft\x2C profile.size);\n  const queue = [\n    {\n      key: startKey\x2C\n      topLeft: startTopLeft\x2C\n      size: profile.size\x2C\n      cost: 0\x2C\n      footprint: getNormalizedFootprint(startTopLeft\x2C profile.size)\x2C\n    }\x2C\n  ];\n  const bestCost = new Map([[startKey\x2C 0]]);\n  const nodes = new Map();\n  const cells = new Map();\n  const parent = new Map();\n  while (queue.length > 0) {\n    queue.sort((a\x2C b) => a.cost - b.cost);\n    const current = queue.shift();\n    if (current.cost > mpLimit) continue;\n    // G64: Massive figures cannot enter spaces occupied by other Massive figures\n    const hitsMassive = profile.isMassive && board.massiveOccupiedSet &&\n      current.footprint.some((cell) => board.massiveOccupiedSet.has(cell));\n    if (hitsMassive) continue; // skip entirely \u2014 cannot pass through or end here\n    const isOccupied = current.footprint.some((cell) => board.occupiedSet.has(cell));\n    const canEnd = !isOccupied || profile.canEndOnOccupied;\n    nodes.set(current.key\x2C { ...current\x2C isOccupied\x2C canEnd });\n    // Only record the topLeft cell\x2C never non-topLeft footprint cells.\n    // Recording all footprint cells causes permanent poisoning: a cell that is a\n    // non-topLeft member of a cheaper placement (lower cost) can never be updated\n    // when that same cell is the topLeft of a more-expensive placement\x2C because\n    // the cost comparison (newCost < cheaperCost) always fails.  This would make\n    // destinations invisible for any multi-tile figure move beyond the first step\n    // in a straight line.\n    if (canEnd && current.cost > 0) {\n      const prev = cells.get(current.topLeft);\n      if (!prev || current.cost < prev.cost) {\n        cells.set(current.topLeft\x2C {\n          cost: current.cost\x2C\n          topLeft: current.topLeft\x2C\n          size: current.size\x2C\n        });\n      }\n    }\n    const neighbors = getNeighborStates(current\x2C board\x2C profile);\n    for (const neighbor of neighbors) {\n      const step = evaluateMovementStep(current\x2C neighbor\x2C board\x2C profile);\n      if (!step) continue;\n      const newCost = current.cost + step.cost;\n      if (newCost > mpLimit) continue;\n      const neighborKey = movementStateKey(neighbor.topLeft\x2C neighbor.size);\n      if (bestCost.has(neighborKey) && bestCost.get(neighborKey) <= newCost) continue;\n      bestCost.set(neighborKey\x2C newCost);\n      parent.set(neighborKey\x2C current.key);\n      queue.push({\n        key: neighborKey\x2C\n        topLeft: neighbor.topLeft\x2C\n        size: neighbor.size\x2C\n        cost: newCost\x2C\n        footprint: step.footprint\x2C\n      });\n    }\n  }\n  return { nodes\x2C cells\x2C parent\x2C maxMp: mpLimit };\n}\n\nexport function getSpacesAtCost(cache\x2C mpCost) {\n  const matches = [];\n  for (const [cell\x2C info] of cache.cells.entries()) {\n    if (info.cost === mpCost) matches.push(cell);\n  }\n  return matches;\n}\n\nexport function getMovementTarget(cache\x2C coord) {\n  return cache.cells.get(normalizeCoord(coord)) || null;\n}\n\nexport function getMovementPath(cache\x2C startCoord\x2C destTopLeft\x2C destSize\x2C profile) {\n  if (!cache?.parent) return [];\n  const startKey = movementStateKey(normalizeCoord(startCoord)\x2C profile.size);\n  const destKey = movementStateKey(normalizeCoord(destTopLeft)\x2C destSize || profile.size);\n  const path = [];\n  let key = destKey;\n  while (key) {\n    const node = cache.nodes.get(key);\n    if (!node) break;\n    path.unshift(node.topLeft);\n    if (key === startKey) break;\n    key = cache.parent.get(key);\n  }\n  return path;\n}\n\nexport function ensureMovementCache(moveState\x2C startCoord\x2C mpLimit\x2C board\x2C profile) {\n  const cached = moveState.movementCache;\n  if (!cached || (moveState.cacheMaxMp || 0) < mpLimit || !(cached.cells instanceof Map)) {\n    moveState.movementCache = computeMovementCache(startCoord\x2C mpLimit\x2C board\x2C profile);\n    moveState.cacheMaxMp = mpLimit;\n  }\n  return moveState.movementCache;\n}\n\nexport function getReachableSpaces(startCoord\x2C mp\x2C mapSpaces\x2C occupiedSet) {\n  const board = buildTempBoardState(mapSpaces\x2C occupiedSet);\n  if (!board || mp <= 0) return [];\n  const profile = {\n    size: '1x1'\x2C\n    cols: 1\x2C\n    rows: 1\x2C\n    isLarge: false\x2C\n    allowDiagonal: true\x2C\n    canRotate: false\x2C\n    isMassive: false\x2C\n    isMobile: false\x2C\n    ignoreDifficult: false\x2C\n    ignoreBlocking: false\x2C\n    ignoreFigureCost: false\x2C\n    canEndOnOccupied: false\x2C\n  };\n  const cache = computeMovementCache(startCoord\x2C mp\x2C board\x2C profile);\n  return [...cache.cells.keys()];\n}\n\nexport function getPathCost(startCoord\x2C destCoord\x2C mapSpaces\x2C occupiedSet) {\n  const board = buildTempBoardState(mapSpaces\x2C occupiedSet);\n  if (!board) return Infinity;\n  const profile = {\n    size: '1x1'\x2C\n    cols: 1\x2C\n    rows: 1\x2C\n    isLarge: false\x2C\n    allowDiagonal: true\x2C\n    canRotate: false\x2C\n    isMassive: false\x2C\n    isMobile: false\x2C\n    ignoreDifficult: false\x2C\n    ignoreBlocking: false\x2C\n    ignoreFigureCost: false\x2C\n    canEndOnOccupied: false\x2C\n  };\n  const cache = computeMovementCache(startCoord\x2C 50\x2C board\x2C profile);\n  const target = cache.cells.get(normalizeCoord(destCoord));\n  return target ? target.cost : Infinity;\n}\n\n/**\n * Find figures whose footprint overlaps with the given footprint set.\n * Returns friendly overlaps first\x2C then enemy.\n */\nexport function collectOverlappingFigures(game\x2C movingPlayerNum\x2C movingFigureKey\x2C footprint) {\n  const overlapsFriendly = [];\n  const overlapsEnemy = [];\n  for (const p of [1\x2C 2]) {\n    const poses = game.figurePositions?.[p] || {};\n    for (const [key\x2C coord] of Object.entries(poses)) {\n      if (key === movingFigureKey) continue;\n      const dcName = dcNameFromFigureKey(key);\n      const size = game.figureOrientations?.[key] || getFigureSize(dcName);\n      const cells = getNormalizedFootprint(coord\x2C size);\n      const intersects = cells.some((cell) => footprint.has(cell));\n      if (!intersects) continue;\n      const entry = { playerNum: p\x2C figureKey: key\x2C dcName };\n      if (p === movingPlayerNum) overlapsFriendly.push(entry);\n      else overlapsEnemy.push(entry);\n    }\n  }\n  return [...overlapsFriendly\x2C ...overlapsEnemy];\n}\n\n/**\n * BFS to push a figure to the nearest valid (unoccupied\x2C non-blocked) space.\n */\nexport function pushFigureToNearestValid(game\x2C playerNum\x2C figureKey\x2C forbiddenSet) {\n  const coord = game.figurePositions?.[playerNum]?.[figureKey];\n  if (!coord) return false;\n  const dcName = dcNameFromFigureKey(figureKey);\n  const board = getBoardStateForMovement(game\x2C figureKey);\n  if (!board) return false;\n  const profile = getMovementProfile(dcName\x2C figureKey\x2C game);\n  const startTopLeft = normalizeCoord(coord);\n  const queue = [startTopLeft];\n  const visited = new Set([movementStateKey(startTopLeft\x2C profile.size)]);\n  while (queue.length > 0) {\n    const topLeft = queue.shift();\n    const footprint = new Set(getNormalizedFootprint(topLeft\x2C profile.size));\n    const overlapForbidden = [...footprint].some((cell) => forbiddenSet.has(cell));\n    const overlapOther = [...footprint].some((cell) => board.occupiedSet.has(cell));\n    const blocked = !profile.ignoreBlocking && [...footprint].some((cell) => board.blockingSet.has(cell));\n    if (!overlapForbidden && !overlapOther && !blocked) {\n      pushFigure(game\x2C playerNum\x2C figureKey\x2C topLeft);\n      return true;\n    }\n    const moveVectors = [\n      { dx: 1\x2C dy: 0 }\x2C\n      { dx: -1\x2C dy: 0 }\x2C\n      { dx: 0\x2C dy: 1 }\x2C\n      { dx: 0\x2C dy: -1 }\x2C\n    ];\n    for (const vec of moveVectors) {\n      const nextTopLeft = shiftCoord(topLeft\x2C vec.dx\x2C vec.dy);\n      if (!board.spacesSet.has(nextTopLeft)) continue;\n      if (board.movementBlockingSet && board.movementBlockingSet.has(edgeKey(topLeft\x2C nextTopLeft))) continue;\n      const stateKey = movementStateKey(nextTopLeft\x2C profile.size);\n      if (visited.has(stateKey)) continue;\n      visited.add(stateKey);\n      queue.push(nextTopLeft);\n    }\n  }\n  return false;\n}\n\n// \u2500\u2500 Iterative massive displacement engine \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Shared by Discord interactive flow and headless non-interactive flow.\n// Rules source: RULES_REFERENCE.md lines 1906-1909\n//   - figures pushed least spaces (controller's choice if tied)\n//   - friendly figures first\x2C then other players push their figures\n//   - valid destinations recalculated after each individual displacement\n\n/**\n * Initialize iterative massive displacement state. Pure \u2014 no side effects.\n * @returns {object|null} pending state\x2C or null if no overlaps\n */\nexport function initMassiveDisplacement(game\x2C movingPlayerNum\x2C movingFigureKey\x2C footprintSet) {\n  const overlaps = collectOverlappingFigures(game\x2C movingPlayerNum\x2C movingFigureKey\x2C footprintSet);\n  if (overlaps.length === 0) return null;\n  const friendly = overlaps.filter(e => e.playerNum === movingPlayerNum);\n  const enemy = overlaps.filter(e => e.playerNum !== movingPlayerNum);\n  return {\n    movingPlayerNum\x2C\n    movingFigureKey\x2C\n    footprint: [...footprintSet]\x2C\n    friendlyQueue: friendly\x2C\n    enemyQueue: enemy\x2C\n    phase: friendly.length > 0 ? 'friendly' : 'enemy'\x2C\n    currentIndex: 0\x2C\n    totalDisplaced: overlaps.length\x2C\n  };\n}\n\n/**\n * Resolve displacements iteratively. Auto-resolves 0/1-space cases (mutates\n * game.figurePositions)\x2C stops when a figure has 2+ valid spaces (needs choice).\n *\n * When multiple unresolved entries remain in the active phase and the current\n * entry requires a space choice\x2C first returns needsFigurePick so the controller\n * can choose displacement ORDER. Once applyFigurePick locks in the ordering for\n * the current index\x2C a subsequent call returns needsChoice for that figure.\n *\n * Each call recalculates valid spaces with CURRENT board state before resolving.\n *\n * @returns {object}\n *   .autoResolved: [{entry\x2C prevPos\x2C newPos\x2C bfs}] \u2014 figures auto-placed this call\n *   .needsFigurePick: null | {pickable:Entry[]\x2C controllerPlayerNum}\n *   .needsChoice: null | {entry\x2C validSpaces\x2C controllerPlayerNum}\n *   .done: boolean \u2014 true when all figures in both queues resolved\n */\nexport function resolveNextDisplacements(game\x2C pending) {\n  const forbiddenSet = new Set(pending.footprint);\n  const autoResolved = [];\n\n  while (true) {\n    const queue = pending.phase === 'friendly' ? pending.friendlyQueue : pending.enemyQueue;\n    if (pending.currentIndex >= queue.length) {\n      // Advance from friendly \u2192 enemy phase\x2C or finish\n      if (pending.phase === 'friendly' && pending.enemyQueue.length > 0) {\n        pending.phase = 'enemy';\n        pending.currentIndex = 0;\n        pending._figurePickLockedIdx = -1;\n        continue;\n      }\n      return { autoResolved\x2C needsFigurePick: null\x2C needsChoice: null\x2C done: true };\n    }\n\n    const entry = queue[pending.currentIndex];\n    // Recalculate valid spaces with current board state\n    const validSpaces = getValidDisplacementSpaces(game\x2C entry.figureKey\x2C entry.playerNum\x2C forbiddenSet);\n\n    if (validSpaces.length === 0) {\n      // BFS fallback \u2014 no adjacent spaces\n      const prevPos = game.figurePositions?.[entry.playerNum]?.[entry.figureKey];\n      pushFigureToNearestValid(game\x2C entry.playerNum\x2C entry.figureKey\x2C forbiddenSet);\n      const newPos = game.figurePositions?.[entry.playerNum]?.[entry.figureKey];\n      autoResolved.push({ entry\x2C prevPos\x2C newPos\x2C bfs: true });\n      pending.currentIndex++;\n      continue;\n    }\n\n    if (validSpaces.length === 1) {\n      // Single option \u2014 auto-place\n      const prevPos = game.figurePositions?.[entry.playerNum]?.[entry.figureKey];\n      pushFigure(game\x2C entry.playerNum\x2C entry.figureKey\x2C validSpaces[0]);\n      autoResolved.push({ entry\x2C prevPos\x2C newPos: validSpaces[0]\x2C bfs: false });\n      pending.currentIndex++;\n      continue;\n    }\n\n    // 2+ valid spaces \u2014 caller must choose.\n    // Friendly phase: massive controller picks. Enemy phase: enemy player picks.\n    // In 2-player Skirmish all entries in the enemy queue share the same\n    // playerNum\x2C so using the current entry's playerNum is safe.\n    const controllerPlayerNum = pending.phase === 'friendly'\n      ? pending.movingPlayerNum\n      : entry.playerNum;\n\n    const unresolvedCount = queue.length - pending.currentIndex;\n    const orderLocked = pending._figurePickLockedIdx === pending.currentIndex;\n    if (unresolvedCount >= 2 && !orderLocked) {\n      // Ask the controller which figure to displace next before picking a space.\n      const pickable = queue.slice(pending.currentIndex);\n      return {\n        autoResolved\x2C\n        needsFigurePick: { pickable\x2C controllerPlayerNum }\x2C\n        needsChoice: null\x2C\n        done: false\x2C\n      };\n    }\n\n    return {\n      autoResolved\x2C\n      needsFigurePick: null\x2C\n      needsChoice: { entry\x2C validSpaces\x2C controllerPlayerNum }\x2C\n      done: false\x2C\n    };\n  }\n}\n\n/**\n * Lock in the controller's chosen figure ORDER for the current index by\n * swapping the chosen entry into queue[currentIndex]. Does NOT advance the\n * index \u2014 a subsequent resolveNextDisplacements call returns needsChoice for\n * that figure so the controller can then pick its destination space.\n * @returns {boolean} true if pick applied\x2C false if figureKey not pickable\n */\nexport function applyFigurePick(pending\x2C figureKey) {\n  const queue = pending.phase === 'friendly' ? pending.friendlyQueue : pending.enemyQueue;\n  let targetIdx = -1;\n  for (let i = pending.currentIndex; i < queue.length; i++) {\n    if (queue[i].figureKey === figureKey) { targetIdx = i; break; }\n  }\n  if (targetIdx < 0) return false;\n  if (targetIdx !== pending.currentIndex) {\n    const tmp = queue[pending.currentIndex];\n    queue[pending.currentIndex] = queue[targetIdx];\n    queue[targetIdx] = tmp;\n  }\n  pending._figurePickLockedIdx = pending.currentIndex;\n  return true;\n}\n\n/**\n * Apply a player's displacement choice for the current pending figure.\n * Call after resolveNextDisplacements returns needsChoice.\n */\nexport function applyDisplacementChoice(game\x2C pending\x2C chosenSpace) {\n  const queue = pending.phase === 'friendly' ? pending.friendlyQueue : pending.enemyQueue;\n  const entry = queue[pending.currentIndex];\n  if (!entry) return null;\n  const prevPos = game.figurePositions?.[entry.playerNum]?.[entry.figureKey];\n  pushFigure(game\x2C entry.playerNum\x2C entry.figureKey\x2C chosenSpace);\n  pending.currentIndex++;\n  pending._figurePickLockedIdx = -1;\n  return { entry\x2C prevPos\x2C newPos: chosenSpace };\n}\n\n/**\n * Non-interactive massive displacement (headless / AI).\n * Uses the iterative engine \u2014 when 2+ spaces\x2C picks the first deterministically.\n * Preserves the same iterative recalculation semantics as the interactive path.\n */\nexport async function resolveMassivePush(game\x2C profile\x2C figureKey\x2C playerNum\x2C newFootprint\x2C client\x2C logGameAction) {\n  if (!profile.canEndOnOccupied) return;\n  const footprintSet = new Set(newFootprint);\n  const pending = initMassiveDisplacement(game\x2C playerNum\x2C figureKey\x2C footprintSet);\n  if (!pending) return;\n\n  // Resolve all displacements iteratively\n  while (true) {\n    const result = resolveNextDisplacements(game\x2C pending);\n    // Log auto-resolved figures\n    for (const r of result.autoResolved) {\n      const from = r.prevPos ? String(r.prevPos).toUpperCase() : '?';\n      const to = r.newPos ? String(r.newPos).toUpperCase() : '?';\n      const suffix = r.bfs ? ' (no adjacent spaces)' : '';\n      if (logGameAction) {\n        await logGameAction(game\x2C client\x2C `**${r.entry.dcName}** displaced **${from}** \u2192 **${to}** by massive figure${suffix}.`\x2C { icon: 'move'\x2C phase: 'ROUND' });\n      }\n    }\n    if (result.done) break;\n    // Non-interactive: when order matters\x2C pick first pickable deterministically.\n    if (result.needsFigurePick) {\n      applyFigurePick(pending\x2C result.needsFigurePick.pickable[0].figureKey);\n      continue;\n    }\n    // Non-interactive: pick first valid space (deterministic)\n    const choice = result.needsChoice;\n    const applied = applyDisplacementChoice(game\x2C pending\x2C choice.validSpaces[0]);\n    if (applied && logGameAction) {\n      const from = applied.prevPos ? String(applied.prevPos).toUpperCase() : '?';\n      const to = String(choice.validSpaces[0]).toUpperCase();\n      await logGameAction(game\x2C client\x2C `**${choice.entry.dcName}** displaced **${from}** \u2192 **${to}** by massive figure.`\x2C { icon: 'move'\x2C phase: 'ROUND' });\n    }\n  }\n\n  // G66-G68: lock voluntary movement for rest of phase\n  game.massiveMovementLocked = game.massiveMovementLocked || {};\n  game.massiveMovementLocked[figureKey] = true;\n  if (logGameAction) {\n    await logGameAction(game\x2C client\x2C `Massive figure pushed ${pending.totalDisplaced} figure(s) aside. Movement locked for this phase.`\x2C { icon: 'move'\x2C phase: 'ROUND' });\n  }\n}\n\n/**\n * Get valid adjacent spaces where a displaced figure can be placed.\n * Returns only empty\x2C non-blocked spaces adjacent to the figure's current position.\n * @param {object} game\n * @param {string} figureKey\n * @param {number} playerNum\n * @param {Set<string>} forbiddenSet - massive figure's footprint cells\n * @returns {string[]} array of valid coord strings\n */\nexport function getValidDisplacementSpaces(game\x2C figureKey\x2C playerNum\x2C forbiddenSet) {\n  const coord = game.figurePositions?.[playerNum]?.[figureKey];\n  if (!coord) return [];\n  const mapId = game.selectedMap?.id;\n  if (!mapId) return [];\n  const mapData = getMapData(mapId);\n  if (!mapData?.adjacency) return [];\n  const adjacent = mapData.adjacency[normalizeCoord(coord)] || [];\n  // Build occupiedSet from full footprints\x2C excluding the figure being displaced\n  const occupiedSet = new Set();\n  for (const p of [1\x2C 2]) {\n    for (const [k\x2C c] of Object.entries(game.figurePositions?.[p] || {})) {\n      if (!c) continue;\n      if (p === playerNum && k === figureKey) continue;\n      const dcName = dcNameFromFigureKey(k);\n      const size = game.figureOrientations?.[k] || getFigureSize(dcName);\n      for (const cell of getNormalizedFootprint(c\x2C size)) {\n        occupiedSet.add(cell);\n      }\n    }\n  }\n  return adjacent.filter((s) => !occupiedSet.has(normalizeCoord(s)) && !forbiddenSet.has(normalizeCoord(s)));\n}\n
