script-source,177,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/utils/can-act-as-player.js,import { getPlayerId } from '../game/player-helpers.js';\n\n/**\n * Check if a user can perform actions as a given player.\n * In test games where P2 is the bot\x2C P1 can act as both sides.\n * In test games with a real P2\x2C each player acts only as themselves.\n * @param {object} game - Game state\n * @param {string} userId - Discord user ID\n * @param {number} playerNum - 1 or 2\n * @returns {boolean}\n */\nexport function canActAsPlayer(game\x2C userId\x2C playerNum) {\n  const ownerId = getPlayerId(game\x2C playerNum);\n  if (userId === ownerId) return true;\n  if (game.isTestGame && game.testP2IsBot && userId === game.player1Id) return true;\n  return false;\n}\n
