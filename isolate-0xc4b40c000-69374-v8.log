script-source,206,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/movement-interrupts.js,/**\n * Post-move interrupt detection for Command Cards that trigger during movement:\n *   C23 \u2014 Parting Blow (BRAWLER): when hostile exits adjacent space\n *   C15 \u2014 Dirty Trick (SMUGGLER or HUNTER): when hostile enters adjacent space\n *   C43 \u2014 Disengage (Mak Eshka'rey): when hostile enters space within 3 spaces\n *\n * These functions walk the reconstructed movement path and check for interrupt\n * opportunities\x2C then return structured trigger data for the handler to post\n * notifications/buttons.\n */\nimport { normalizeCoord\x2C getFootprintCells\x2C edgeKey } from './coords.js';\nimport { getMapData\x2C getMapTokensData\x2C getDcEffects } from '../data-loader.js';\nimport { dcNameFromFigureKey } from './dc-helpers.js';\nimport { getCcHand\x2C getPlayerId\x2C opponentPlayerNum\x2C getDcMessageIds\x2C getDcList } from './player-helpers.js';\nimport { countSpaces } from './spatial.js';\nimport { cardNameIncludes } from './card-names.js';\n\n/**\n * Check whether a DC name has any of the given trait keywords (case-insensitive).\n * @param {string} dcName\n * @param {string[]} traits - e.g. ['BRAWLER']\n * @returns {boolean}\n */\nfunction dcHasTrait(dcName\x2C traits) {\n  const effects = getDcEffects();\n  const entry = effects?.[dcName];\n  if (!entry) return false;\n  const kws = (entry.keywords || []).map(k => String(k).toUpperCase());\n  return traits.some(t => kws.includes(t.toUpperCase()));\n}\n\n/**\n * Check whether a player has a specific CC name in hand.\n * @param {object} game\n * @param {number} playerNum\n * @param {string} cardName - exact card name\x2C e.g. 'Parting Blow'\n * @returns {boolean}\n */\nfunction hasCardInHand(game\x2C playerNum\x2C cardName) {\n  const hand = getCcHand(game\x2C playerNum) || [];\n  return hand.some(c => c === cardName);\n}\n\n/**\n * Walk the movement path and detect interrupt opportunities for C23\x2C C15\x2C C43.\n *\n * @param {object} game - game state\n * @param {number} movingPlayerNum - player who moved\n * @param {string} movingFigureKey - figure key that moved\n * @param {string[]} path - array of coordinate strings (from getMovementPath)\n * @returns {Array<{type: string\x2C cardName: string\x2C candidatePlayerNum: number\x2C candidateFigureKey: string\x2C candidateDcName: string\x2C triggerSpace: string\x2C description: string}>}\n */\nexport function detectPostMoveInterrupts(game\x2C movingPlayerNum\x2C movingFigureKey\x2C path) {\n  if (!path || path.length < 2) return [];\n\n  const mapId = game.selectedMap?.id;\n  const rawMapSpaces = mapId ? getMapData(mapId) : null;\n  const adjacency = rawMapSpaces?.adjacency || {};\n  const _miAllDoors = (mapId && getMapTokensData) ? (getMapTokensData()[mapId]?.doors || []) : [];\n  const _miOpenedSet = new Set((game.openedDoors || []).map(k => String(k).toLowerCase()));\n  const _miClosedDoorEdges = new Set(\n    _miAllDoors\n      .filter(e => { const a = String(e[0]).toLowerCase()\x2C b = String(e[1]).toLowerCase(); return !_miOpenedSet.has(`${a}|${b}`) && !_miOpenedSet.has(`${b}|${a}`); })\n      .map(e => edgeKey(e[0]\x2C e[1]))\n  );\n  const oppNum = opponentPlayerNum(movingPlayerNum);\n  const hostilePositions = game.figurePositions?.[oppNum] || {};\n  const triggers = [];\n  let partingBlowTriggered = false;\n\n  // Pre-compute hostile figure info\n  const hostileFigures = [];\n  for (const [hfk\x2C hPos] of Object.entries(hostilePositions)) {\n    if (!hPos) continue;\n    const hDcName = dcNameFromFigureKey(hfk);\n    const hSize = game.figureOrientations?.[hfk] || '1x1';\n    const hCells = getFootprintCells(hPos\x2C hSize).map(c => normalizeCoord(c));\n    hostileFigures.push({ figureKey: hfk\x2C dcName: hDcName\x2C cells: hCells\x2C pos: hPos });\n  }\n\n  for (let i = 0; i < path.length - 1; i++) {\n    const exitingSpace = normalizeCoord(path[i]);\n    const enteringSpace = normalizeCoord(path[i + 1]);\n    const exitAdj = new Set((adjacency[exitingSpace] || []).map(n => normalizeCoord(n)));\n    const enterAdj = new Set((adjacency[enteringSpace] || []).map(n => normalizeCoord(n)));\n\n    for (const hf of hostileFigures) {\n      // --- C23: Parting Blow (BRAWLER\x2C once per move) ---\n      if (!partingBlowTriggered) {\n        const wasAdjacent = hf.cells.some(c => exitAdj.has(c) || c === exitingSpace);\n        const stillAdjacent = hf.cells.some(c => enterAdj.has(c) || c === enteringSpace);\n        if (wasAdjacent && !stillAdjacent) {\n          if (dcHasTrait(hf.dcName\x2C ['BRAWLER']) && hasCardInHand(game\x2C oppNum\x2C 'Parting Blow')) {\n            partingBlowTriggered = true;\n            const displayName = hf.dcName.replace(/_/g\x2C ' ');\n            triggers.push({\n              type: 'partingBlow'\x2C\n              cardName: 'Parting Blow'\x2C\n              candidatePlayerNum: oppNum\x2C\n              candidateFigureKey: hf.figureKey\x2C\n              candidateDcName: hf.dcName\x2C\n              triggerSpace: exitingSpace\x2C\n              description: `**${displayName}** (Brawler) \u2014 hostile exited adjacent space **${exitingSpace.toUpperCase()}**. Parting Blow opportunity.`\x2C\n            });\n          }\n        }\n      }\n\n      // --- C15: Dirty Trick (SMUGGLER or HUNTER\x2C entering adjacent) ---\n      {\n        const nowAdjacent = hf.cells.some(c => enterAdj.has(c) || c === enteringSpace);\n        const wasAdjacentBefore = hf.cells.some(c => exitAdj.has(c) || c === exitingSpace);\n        // Only trigger when entering adjacency (not already adjacent)\n        if (nowAdjacent && !wasAdjacentBefore) {\n          if (dcHasTrait(hf.dcName\x2C ['SMUGGLER'\x2C 'HUNTER']) && hasCardInHand(game\x2C oppNum\x2C 'Dirty Trick')) {\n            const displayName = hf.dcName.replace(/_/g\x2C ' ');\n            // Avoid duplicate triggers for the same figure in the same move\n            const alreadyTriggered = triggers.some(t => t.type === 'dirtyTrick' && t.candidateFigureKey === hf.figureKey);\n            if (!alreadyTriggered) {\n              triggers.push({\n                type: 'dirtyTrick'\x2C\n                cardName: 'Dirty Trick'\x2C\n                candidatePlayerNum: oppNum\x2C\n                candidateFigureKey: hf.figureKey\x2C\n                candidateDcName: hf.dcName\x2C\n                triggerSpace: enteringSpace\x2C\n                description: `**${displayName}** (Smuggler/Hunter) \u2014 hostile entered adjacent space **${enteringSpace.toUpperCase()}**. Dirty Trick opportunity.`\x2C\n              });\n            }\n          }\n        }\n      }\n\n      // --- C43: Disengage (Mak Eshka'rey\x2C entering within 3 spaces) ---\n      {\n        // Only check for Mak specifically\n        if (hf.dcName === "Mak Eshka'rey") {\n          const distAfter = countSpaces(rawMapSpaces\x2C enteringSpace\x2C hf.pos\x2C _miClosedDoorEdges);\n          const distBefore = countSpaces(rawMapSpaces\x2C exitingSpace\x2C hf.pos\x2C _miClosedDoorEdges);\n          // Trigger when entering within 3 spaces (was further\x2C now within)\n          if (distAfter <= 3 && distBefore > 3) {\n            if (hasCardInHand(game\x2C oppNum\x2C 'Disengage')) {\n              const alreadyTriggered = triggers.some(t => t.type === 'disengage' && t.candidateFigureKey === hf.figureKey);\n              if (!alreadyTriggered) {\n                triggers.push({\n                  type: 'disengage'\x2C\n                  cardName: 'Disengage'\x2C\n                  candidatePlayerNum: oppNum\x2C\n                  candidateFigureKey: hf.figureKey\x2C\n                  candidateDcName: hf.dcName\x2C\n                  triggerSpace: enteringSpace\x2C\n                  description: `**Mak Eshka'rey** \u2014 hostile entered within 3 spaces (at **${enteringSpace.toUpperCase()}**). Disengage opportunity.`\x2C\n                });\n              }\n            }\n          }\n        }\n      }\n    }\n\n    // --- Overwatch: hostile enters space on/adjacent to Overwatch token ---\n    for (const [owMsgId\x2C owSpace] of Object.entries(game.overwatchTokenPosition || {})) {\n      const normOwSpace = normalizeCoord(owSpace);\n      // Check entering space is on or adjacent to token\n      const isOnOrAdj = enteringSpace === normOwSpace || enterAdj.has(normOwSpace);\n      if (!isOnOrAdj) continue;\n      // Check was NOT already on or adjacent (only trigger on entering the zone)\n      const wasOnOrAdj = exitingSpace === normOwSpace || exitAdj.has(normOwSpace);\n      if (wasOnOrAdj) continue;\n      // Determine owner of this Overwatch\n      let owPlayerNum = null;\n      if ((getDcMessageIds(game\x2C 1) || []).includes(owMsgId)) owPlayerNum = 1;\n      else if ((getDcMessageIds(game\x2C 2) || []).includes(owMsgId)) owPlayerNum = 2;\n      if (!owPlayerNum || owPlayerNum === movingPlayerNum) continue;\n      // Check not already exhausted\n      if (cardNameIncludes(game.exhaustedSkirmishUpgrades?.[owMsgId]\x2C 'Overwatch')) continue;\n      // Avoid duplicate triggers for same token in same move\n      if (triggers.some(t => t.type === 'overwatch' && t.owMsgId === owMsgId)) continue;\n      // Find DC name\n      const owDcList = getDcList(game\x2C owPlayerNum) || [];\n      const owMsgIds = getDcMessageIds(game\x2C owPlayerNum) || [];\n      const owIdx = owMsgIds.indexOf(owMsgId);\n      const owDcName = owIdx >= 0 ? (owDcList[owIdx]?.dcName || 'E-Web Engineer') : 'E-Web Engineer';\n      const owDisplayName = owIdx >= 0 ? (owDcList[owIdx]?.displayName || owDcName) : owDcName;\n      triggers.push({\n        type: 'overwatch'\x2C\n        cardName: 'Overwatch'\x2C\n        candidatePlayerNum: owPlayerNum\x2C\n        candidateFigureKey: null\x2C\n        candidateDcName: owDcName\x2C\n        triggerSpace: enteringSpace\x2C\n        description: `**${owDisplayName}** (Overwatch) \u2014 hostile entered space on/adjacent to Overwatch token at **${normOwSpace.toUpperCase()}**. Interrupt attack opportunity.`\x2C\n        owMsgId\x2C\n        owTokenSpace: normOwSpace\x2C\n      });\n    }\n  }\n\n  return triggers;\n}\n
