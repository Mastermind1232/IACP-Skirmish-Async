code-creation,Script,9,300124,0x3f05b92a1130,52, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/engine/combat-bridge.js:1:1,0x33c468581b58,~
script-source,254,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/engine/combat-bridge.js,/**\n * Combat orchestrator functions extracted from index.js.\n * Each function receives an explicit `deps` object carrying closed-over values.\n */\n\nimport { processFigureDefeat } from './defeat-handler.js';\nimport { cardNameIncludes } from '../game/card-names.js';\nimport { chunkButtonsToRows } from '../discord/components.js';\nimport { fetchCombatThread\x2C fetchGameChannel\x2C sanitizeMentions } from '../discord/channel-helpers.js';\nimport { countGameSpaces } from '../game/board-helpers.js';\n\n/**\n * Apply NPC (thug / Krykna / non-player-card) damage to a figure.\n * Handles HP reduction\x2C defeat\x2C VP award\x2C and game log.\n */\nexport async function applyNpcDamageToFigure(game\x2C playerNum\x2C figureKey\x2C damage\x2C sourceLabel\x2C deps) {\n  const { logGameAction\x2C client\x2C dcHealthState\x2C dcMessageMeta\x2C\n    dcNameFromFigureKey\x2C parseFigureKey\x2C reduceHp\x2C\n    opponentPlayerNum\x2C getDcMessageIds\x2C getDcList } = deps;\n\n  const dcName = dcNameFromFigureKey(figureKey);\n  const { dgIndex\x2C figureIndex } = parseFigureKey(figureKey);\n\n  // Locate the DC message for this figure\n  let msgId = null;\n  for (const [mid\x2C meta] of dcMessageMeta) {\n    if (meta.gameId !== game.gameId || meta.playerNum !== playerNum) continue;\n    if (meta.dcName !== dcName) continue;\n    const dn = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/);\n    const metaDg = dn ? String(dn[1]) : '1';\n    if (metaDg === String(dgIndex)) { msgId = mid; break; }\n  }\n\n  if (msgId) {\n    const { newHp\x2C maxHp\x2C wasDefeated } = reduceHp(dcHealthState\x2C game\x2C msgId\x2C figureIndex\x2C damage\x2C playerNum);\n    if (dcHealthState.get(msgId)?.[figureIndex]) {\n      if (wasDefeated) {\n        const oppPN = opponentPlayerNum(playerNum);\n        const dcIds = getDcMessageIds(game\x2C playerNum);\n        const dcIdx = (dcIds || []).indexOf(msgId);\n        await processFigureDefeat(game\x2C {\n          defeatedPlayerNum: playerNum\x2C\n          figureKey\x2C\n          attackerPlayerNum: oppPN\x2C\n          msgId\x2C\n          dcIdx\x2C\n          dcName\x2C\n          displayName: dcName\x2C\n          source: sourceLabel\x2C\n        }\x2C deps);\n      } else {\n        await logGameAction(game\x2C client\x2C `**${sourceLabel}:** **${dcName}** suffered **${damage} damage** (${newHp}/${maxHp} HP remaining).`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n      }\n    }\n  } else {\n    await logGameAction(game\x2C client\x2C `**${sourceLabel}:** **${dcName}** suffered **${damage} damage** (HP not found in memory \u2014 update DC card manually).`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  }\n}\n\n/**\n * Apply direct (non-combat) damage to a figure (reactions\x2C post-combat effects\x2C etc.).\n * Handles HP reduction\x2C death\x2C VP award to the opponent\x2C and thread logging.\n */\nexport async function applyDirectDamageToFigure(game\x2C playerNum\x2C figKey\x2C msgId\x2C damage\x2C client\x2C thread\x2C sourceName\x2C deps) {\n  const { dcHealthState\x2C reduceHp\x2C dcNameFromFigureKey\x2C discordCatch\x2C\n    getDcMessageIds\x2C getDcList\x2C opponentPlayerNum } = deps;\n\n  if (!msgId) return;\n  const figMatch = figKey.match(/-\\d+-(\\d+)$/);\n  const figIdx = figMatch ? parseInt(figMatch[1]\x2C 10) : 0;\n  const { newHp\x2C wasDefeated } = reduceHp(dcHealthState\x2C game\x2C msgId\x2C figIdx\x2C damage\x2C playerNum);\n  const figName = dcNameFromFigureKey(figKey);\n  if (thread) await thread.send(`**${sourceName}** \u2014 ${figName} suffers **${damage} Damage**.`).catch(discordCatch);\n  const dcIds = getDcMessageIds(game\x2C playerNum);\n  const idx = (dcIds || []).indexOf(msgId);\n  if (wasDefeated && idx >= 0) {\n    const oppPN = opponentPlayerNum(playerNum);\n    const dcList = getDcList(game\x2C playerNum);\n    await processFigureDefeat(game\x2C {\n      defeatedPlayerNum: playerNum\x2C\n      figureKey: figKey\x2C\n      attackerPlayerNum: oppPN\x2C\n      msgId\x2C\n      dcIdx: idx\x2C\n      dcName: dcList[idx]?.dcName\x2C\n      displayName: figName\x2C\n      source: sourceName\x2C\n    }\x2C deps);\n    if (thread) await thread.send(`**${sourceName}** \u2014 ${figName} was **defeated**!`).catch(discordCatch);\n  }\n}\n\n/**\n * Send a Bleeding damage prompt to the given channel.\n * Offers "Take 1 damage" or "Prevent (discard CC)".\n */\nexport async function sendBleedingPrompt(game\x2C channel\x2C figureKey\x2C playerNum\x2C displayName\x2C deps) {\n  const { ccDeckKey\x2C ButtonBuilder\x2C ButtonStyle\x2C ActionRowBuilder\x2C discordCatch } = deps;\n\n  const deckKey = ccDeckKey(playerNum);\n  const deckCount = (game[deckKey] || []).length;\n  const acceptBtn = new ButtonBuilder()\n    .setCustomId(`bleed_accept_${game.gameId}_${playerNum}_${figureKey}`)\n    .setLabel('Take 1 damage')\n    .setStyle(ButtonStyle.Danger);\n  const preventBtn = new ButtonBuilder()\n    .setCustomId(`bleed_prevent_${game.gameId}_${playerNum}_${figureKey}`)\n    .setLabel(`Prevent (discard CC\x2C ${deckCount} left)`)\n    .setStyle(ButtonStyle.Primary)\n    .setDisabled(deckCount === 0);\n  const row = new ActionRowBuilder().addComponents(acceptBtn\x2C preventBtn);\n  await channel.send({\n    content: `\\u{1FA78} **Bleeding** \u2014 **${displayName}** suffers 1 damage after resolving their action. Take damage or discard top CC to prevent?`\x2C\n    components: [row]\x2C\n  }).catch(discordCatch);\n}\n\n/**\n * Resolve combat after rolls (and optional surge).\n * Applies damage\x2C VP\x2C updates embeds/board\x2C clears pendingCombat.\n */\nexport async function resolveCombatAfterRolls(game\x2C combat\x2C client\x2C deps) {\n  const {\n    logGameAction\x2C dcNameFromFigureKey\x2C parseFigureKey\x2C opponentPlayerNum\x2C\n    getDcEffects\x2C getDcEffect\x2C getMapData\x2C computeCombatResult\x2C\n    getBoardStateForMovement\x2C getEffectiveFigureSize\x2C getFootprintCells\x2C normalizeCoord\x2C\n    getPlayerId\x2C findDcMessageIdForFigure\x2C findFigureheadFigure\x2C\n    ButtonBuilder\x2C ButtonStyle\x2C ActionRowBuilder\x2C\n    applyDamageAndFinishCombat: _applyDamageAndFinishCombat\x2C\n    discordCatch\x2C\n  } = deps;\n\n  // Beatdown / nextAttacksBonusHits: consume one charge and add bonus to this attack\n  const pending = game.nextAttacksBonusHits?.[combat.attackerPlayerNum];\n  if (pending && pending.count > 0 && pending.bonus > 0) {\n    combat.bonusHits = (combat.bonusHits || 0) + pending.bonus;\n    pending.count -= 1;\n    if (pending.count <= 0) delete game.nextAttacksBonusHits[combat.attackerPlayerNum];\n  }\n  // Size Advantage / nextAttacksBonusConditions: consume and add conditions to defender\n  const condPending = game.nextAttacksBonusConditions?.[combat.attackerPlayerNum];\n  if (condPending && condPending.count > 0 && condPending.conditions?.length) {\n    combat.bonusConditions = combat.bonusConditions || [];\n    combat.bonusConditions.push(...condPending.conditions);\n    condPending.count -= 1;\n    if (condPending.count <= 0) delete game.nextAttacksBonusConditions[combat.attackerPlayerNum];\n  }\n  const defenderPlayerNum = opponentPlayerNum(combat.attackerPlayerNum);\n  // Snapshot target position before damage resolution can remove it (used by Heavy Fire\x2C etc.)\n  if (combat.target?.figureKey && !combat._savedTargetPos) {\n    combat._savedTargetPos = game.figurePositions?.[defenderPlayerNum]?.[combat.target.figureKey] || null;\n  }\n  const roundBlock = game.roundDefenseBonusBlock?.[defenderPlayerNum] || 0;\n  const roundEvade = game.roundDefenseBonusEvade?.[defenderPlayerNum] || 0;\n  if (roundBlock) combat.bonusBlock = (combat.bonusBlock || 0) + roundBlock;\n  if (roundEvade) combat.bonusEvade = (combat.bonusEvade || 0) + roundEvade;\n  const roundAccPenalty = game.roundDefenseAccuracyPenalty?.[defenderPlayerNum] || 0;\n  if (roundAccPenalty) combat.defenderAccuracyPenalty = (combat.defenderAccuracyPenalty || 0) + roundAccPenalty;\n  // Choose a Side (SCUM): +1 Block only for defenders with MOBILE keyword\n  const mobileBlock = game.roundMobileDefenseBonusBlock?.[defenderPlayerNum] || 0;\n  if (mobileBlock && combat.target?.figureKey) {\n    const _defDcName = dcNameFromFigureKey(combat.target.figureKey);\n    const _defKws = (getDcEffects()?.[_defDcName]?.keywords || []).map((k) => String(k).toUpperCase());\n    if (_defKws.includes('MOBILE')) combat.bonusBlock = (combat.bonusBlock || 0) + mobileBlock;\n  }\n  const perEvade = game.roundDefenderBonusBlockPerEvade?.[defenderPlayerNum] || 0;\n  if (perEvade && combat.defenseRoll) combat.bonusBlock = (combat.bonusBlock || 0) + (combat.defenseRoll.evade || 0) * perEvade;\n  // Harsh Environment: exterior spaces -1 Evade; interior spaces +1 Block (applied once per combat resolution)\n  if (game.harshEnvironmentActive && !combat.harshEnvApplied) {\n    const _heMapId = game.selectedMap?.id;\n    const _heMsData = _heMapId ? getMapData(_heMapId) : null;\n    const _heFigKey = combat.target?.figureKey;\n    const _hePos = _heFigKey ? (game.figurePositions?.[defenderPlayerNum]?.[_heFigKey]) : null;\n    if (_heMsData && _hePos) {\n      combat.harshEnvApplied = true;\n      const _heExterior = !!_heMsData.exterior?.[_hePos];\n      if (_heExterior) {\n        combat.bonusEvade = (combat.bonusEvade || 0) - 1;\n        await logGameAction(game\x2C client\x2C `\\u26A1 **Harsh Environment** \\u2014 **${combat.target.label}** on exterior space: \\u22121 Evade.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n      } else {\n        combat.bonusBlock = (combat.bonusBlock || 0) + 1;\n        await logGameAction(game\x2C client\x2C `\\u26A1 **Harsh Environment** \\u2014 **${combat.target.label}** on interior space: +1 Block.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n      }\n    }\n  }\n  // Cavalry Charge: round TROOPER attack hit bonus\n  const trooperHitBonus = game.roundTrooperAttackHitBonus?.[combat.attackerPlayerNum] || 0;\n  if (trooperHitBonus) {\n    const attackerEff = getDcEffect(combat.attackerDcName);\n    const attackerKws = (attackerEff?.keywords || []).map((k) => String(k).toUpperCase());\n    if (attackerKws.includes('TROOPER')) combat.bonusHits = (combat.bonusHits || 0) + trooperHitBonus;\n  }\n  // Query (HK-47): if +1 Hit was applied but defender became Bleeding from surges\x2C remove the bonus\n  if (combat.queryBonusHitApplied && (combat.surgeConditions || []).includes('Bleed')) {\n    combat.bonusHits = Math.max(0\x2C (combat.bonusHits || 0) - 1);\n    combat.queryBonusHitApplied = false;\n    await logGameAction(game\x2C client\x2C '**Query** \u2014 +1 Hit removed (defender became Bleeding).'\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  }\n  let { hit\x2C damage\x2C resultText } = computeCombatResult(combat);\n  const totalBlast = (combat.surgeBlast || 0) + (combat.bonusBlast || 0);\n  const attackerPlayerNum = combat.attackerPlayerNum;\n  // Store target + adjacent spaces for Reduce to Rubble (only when attack hit)\n  if (hit && game.selectedMap?.id) {\n    const targetCoord = game.figurePositions?.[defenderPlayerNum]?.[combat.target.figureKey];\n    if (targetCoord) {\n      const board = getBoardStateForMovement(game\x2C null);\n      if (board?.adjacency) {\n        const targetDcName = dcNameFromFigureKey(combat.target.figureKey);\n        const targetSize = getEffectiveFigureSize(game\x2C combat.target.figureKey\x2C targetDcName);\n        const targetCells = getFootprintCells(targetCoord\x2C targetSize || '1x1').map((c) => normalizeCoord(c));\n        const rubbleSet = new Set(targetCells);\n        for (const c of targetCells) {\n          for (const n of board.adjacency[c] || []) rubbleSet.add(normalizeCoord(n));\n        }\n        game.lastAttackTargetSpacesForRubble = [...rubbleSet];\n        game.lastAttackAttackerPlayerNum = attackerPlayerNum;\n      }\n    }\n  }\n  const ownerId = getPlayerId(game\x2C attackerPlayerNum);\n  const targetMsgId = findDcMessageIdForFigure(game.gameId\x2C defenderPlayerNum\x2C combat.target.figureKey);\n  const { figureIndex: targetFigIndex } = parseFigureKey(combat.target.figureKey);\n\n  // Figurehead (Murne Rin): before friendly figure suffers damage\x2C may redirect to self (prevent 1)\n  if (damage > 0 && hit) {\n    const fhResult = findFigureheadFigure(game\x2C defenderPlayerNum\x2C combat.target.figureKey);\n    if (fhResult) {\n      const fhOwnerId = getPlayerId(game\x2C defenderPlayerNum);\n      const fhThread = await fetchCombatThread(client\x2C combat.combatThreadId);\n      game.pendingFigurehead = {\n        damage\x2C hit\x2C resultText\x2C totalBlast\x2C\n        defenderPlayerNum\x2C attackerPlayerNum\x2C ownerId\x2C\n        targetMsgId\x2C targetFigIndex\x2C\n        fhFigKey: fhResult.figureKey\x2C fhMsgId: fhResult.msgId\x2C fhFigIndex: fhResult.figIndex\x2C\n        fhLabel: fhResult.label\x2C\n      };\n      await fhThread.send(sanitizeMentions({\n        content: `<@${fhOwnerId}> \u2014 **Figurehead**: **${combat.target.label}** is about to suffer **${damage} damage**. Murne Rin suffers **${Math.max(0\x2C damage - 1)} damage** instead (prevents 1)?`\x2C\n        components: [new ActionRowBuilder().addComponents(\n          new ButtonBuilder().setCustomId(`figurehead_use_${game.gameId}`).setLabel('Use Figurehead').setStyle(ButtonStyle.Danger)\x2C\n          new ButtonBuilder().setCustomId(`figurehead_skip_${game.gameId}`).setLabel('Skip').setStyle(ButtonStyle.Primary)\x2C\n        )]\x2C\n        allowedMentions: { users: [fhOwnerId] }\x2C\n      }));\n      return;\n    }\n  }\n  await _applyDamageAndFinishCombat(game\x2C combat\x2C { damage\x2C hit\x2C resultText\x2C totalBlast\x2C defenderPlayerNum\x2C attackerPlayerNum\x2C ownerId\x2C targetMsgId\x2C targetFigIndex }\x2C client);\n}\n\n/**\n * Apply damage\x2C conditions\x2C defeat logic\x2C and finish combat resolution.\n * Called from resolveCombatAfterRolls and handleFigureheadDecision.\n */\nexport async function applyDamageAndFinishCombat(game\x2C combat\x2C { damage\x2C hit\x2C resultText\x2C totalBlast\x2C defenderPlayerNum\x2C attackerPlayerNum\x2C ownerId\x2C targetMsgId\x2C targetFigIndex }\x2C client\x2C deps) {\n  const {\n    logGameAction\x2C saveGames\x2C dcHealthState\x2C dcMessageMeta\x2C\n    dcNameFromFigureKey\x2C parseFigureKey\x2C opponentPlayerNum\x2C discordCatch\x2C\n    reduceHp\x2C healHp\x2C removeFigurePosition\x2C\n    calculateKillVp\x2C awardKillVp\x2C awardObjectiveVp\x2C vpKey\x2C\n    getDcList\x2C getDcMessageIds\x2C getDcStats\x2C getDcEffects\x2C getDcEffect\x2C getDcKeywords\x2C\n    getPlayerId\x2C getMapData\x2C getEffectiveMapSpaces\x2C\n    isWithinN\x2C hasLineOfSight\x2C\n    getFiguresAdjacentToTarget\x2C getFiguresAdjacentToCoord\x2C getFiguresOnOrAdjacentToSpace\x2C\n    getEffectiveFigureSize\x2C getFootprintCells\x2C getFigureSize\x2C\n    findDcMessageIdForFigure\x2C lookupFigureDcIndex\x2C getFigureLabel\x2C\n    getCcHand\x2C getCcEffectsData\x2C getCcEffect\x2C\n    ccHandKey\x2C ccDiscardKey\x2C ccDeckKey\x2C ccAttachmentsKey\x2C\n    _applyCondition\x2C filterCondition\x2C isConditionImmune\x2C HARMFUL_CONDITIONS\x2C\n    isDcUnique\x2C getActivatedDcIndices\x2C\n    isDbConfigured\x2C achievementsChannelId\x2C checkAndGrantAchievements\x2C checkAndPostAchievements\x2C postAchievementNotification\x2C\n    checkNefariousGains\x2C checkWinConditions\x2C checkHuntDissent\x2C\n    checkFriendlyDefeatedPassiveRedraws\x2C\n    decrementActivationIfGroupDefeated\x2C updateAttachmentMessageForDc\x2C\n    grantMovementBank\x2C grantPowerTokens\x2C getDiceData\x2C\n    ButtonBuilder\x2C ButtonStyle\x2C ActionRowBuilder\x2C\n    getCelebrationButtons\x2C getCleaveTargetButtons\x2C\n    applyNpcDamageToFigure: _applyNpcDamageToFigure\x2C\n    checkPostCombatSurges: _checkPostCombatSurges\x2C\n    finishCombatResolution: _finishCombatResolution\x2C\n    normalizeCoord\x2C\n  } = deps;\n\n  const thread = await fetchCombatThread(client\x2C combat.combatThreadId);\n  const targetDcName = dcNameFromFigureKey(combat.target.figureKey);\n  // Store applied damage on combat object for post-combat checks (Return Fire\x2C etc.)\n  combat._appliedDamage = damage;\n  // Store last attack metadata for post-attack CC effect handlers\n  game.lastAttackAttackerMsgId = combat.attackerMsgId ?? null;\n  game.lastAttackAttackerFigureIndex = combat.attackerFigureIndex ?? 0;\n  game.lastAttackTargetFigureKey = combat.target?.figureKey ?? null;\n  // Track that an attack was performed during this activation (for On a Diplomatic Mission\x2C etc.)\n  if (combat.attackerMsgId) {\n    game.attackPerformedThisActivation = game.attackPerformedThisActivation || {};\n    game.attackPerformedThisActivation[combat.attackerMsgId] = true;\n  }\n\n  // NPC target (thug / Krykna / Crate): apply damage directly\x2C skip dcHealthState\n  if (combat.target?.isNpc) {\n    // Crate target (Devaron B)\n    if (combat.target.npcType === 'crate') {\n      const origCoord = combat.target.crateOrigCoord;\n      if (origCoord && game.cratePositions?.[origCoord] !== undefined) {\n        game.crateHealth = game.crateHealth || {};\n        if (typeof game.crateHealth[origCoord] !== 'number') game.crateHealth[origCoord] = 5;\n        if (damage > 0 && hit) {\n          game.crateHealth[origCoord] = Math.max(0\x2C game.crateHealth[origCoord] - damage);\n          const curCoord = String(game.cratePositions[origCoord] || origCoord).toUpperCase();\n          resultText += ` \u2014 Crate @ ${curCoord}: ${game.crateHealth[origCoord]}/5 HP remaining.`;\n          if (game.crateHealth[origCoord] <= 0) {\n            resultText += ` **Crate DESTROYED! Adjacent figures suffer 2 Damage.**`;\n            const curCoordLow = String(game.cratePositions[origCoord] || origCoord).toLowerCase();\n            delete game.cratePositions[origCoord];\n            await logGameAction(game\x2C client\x2C `\\u{1F4A5} Crate at **${curCoord}** destroyed! All adjacent figures suffer 2 Damage.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n            for (const pn of [1\x2C 2]) {\n              for (const figKey of getFiguresOnOrAdjacentToSpace(game\x2C pn\x2C curCoordLow\x2C 'devaron-garrison')) {\n                await _applyNpcDamageToFigure(game\x2C pn\x2C figKey\x2C 2\x2C 'Crate explosion'\x2C logGameAction\x2C client\x2C dcHealthState\x2C dcMessageMeta);\n              }\n            }\n            await checkWinConditions(game\x2C client);\n          }\n        }\n      }\n      // Wave 3: Blast from crate-target attack \u2014 apply to adjacent figures/objects\n      const _crateBlastAmt = (combat.surgeBlast || 0) + (combat.bonusBlast || 0);\n      if (_crateBlastAmt > 0 && hit && damage > 0 && game.selectedMap?.id) {\n        const _crateBlastCoord = String(game.cratePositions?.[origCoord] || origCoord).toLowerCase();\n        const _crateBlastAdj = getFiguresAdjacentToCoord(game\x2C _crateBlastCoord\x2C game.selectedMap.id\x2C null);\n        for (const { figureKey: _cbFk\x2C playerNum: _cbPn } of _crateBlastAdj) {\n          const _cbMsgId = findDcMessageIdForFigure(game.gameId\x2C _cbPn\x2C _cbFk);\n          if (!_cbMsgId) continue;\n          const { figureIndex: _cbFigIdx } = parseFigureKey(_cbFk);\n          const { newHp: _cbNewHp\x2C wasDefeated: _cbDied } = reduceHp(dcHealthState\x2C game\x2C _cbMsgId\x2C _cbFigIdx\x2C _crateBlastAmt\x2C _cbPn);\n          const _cbName = dcNameFromFigureKey(_cbFk);\n          await logGameAction(game\x2C client\x2C `\\u{1F4A5} **Blast ${_crateBlastAmt}** \\u2014 **${_cbName}** suffers ${_crateBlastAmt} damage.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n          if (_cbDied) {\n            const { idx: _cbIdx } = lookupFigureDcIndex(game\x2C _cbPn\x2C _cbFk);\n            const _cbDcName = dcNameFromFigureKey(_cbFk);\n            await processFigureDefeat(game\x2C {\n              defeatedPlayerNum: _cbPn\x2C figureKey: _cbFk\x2C\n              attackerPlayerNum\x2C attackerFigureKey: combat.attackerFigureKey\x2C\n              msgId: _cbMsgId\x2C dcIdx: _cbIdx\x2C dcName: _cbDcName\x2C displayName: _cbName\x2C source: 'Blast'\x2C\n            }\x2C { ...deps\x2C client });\n          }\n        }\n      }\n      await thread.send({ content: resultText || '(No effect)'\x2C components: [] });\n      delete game.pendingCombat;\n      saveGames();\n      return;\n    }\n    // Thug / Krykna\n    const npcArray = combat.target.npcType === 'thug' ? game.npcThugs : game.npcKrykna;\n    const npc = npcArray?.[combat.target.npcIndex];\n    if (npc && !npc.defeated) {\n      if (damage > 0 && hit) {\n        npc.hp = Math.max(0\x2C npc.hp - damage);\n        resultText += ` \u2014 ${combat.target.label}: ${npc.hp}/${npc.maxHp} HP remaining.`;\n        if (npc.hp <= 0) {\n          npc.defeated = true;\n          awardObjectiveVp(game\x2C attackerPlayerNum\x2C 2);\n          resultText += ` **${combat.target.label} defeated! +2 VP**`;\n          // Krykna claim: track on game state for end-of-round deploy option\n          if (combat.target.npcType === 'krykna') {\n            game.claimedKrykna = game.claimedKrykna || { 1: 0\x2C 2: 0 };\n            game.claimedKrykna[attackerPlayerNum] = (game.claimedKrykna[attackerPlayerNum] || 0) + 1;\n          }\n          await logGameAction(game\x2C client\x2C `<@${ownerId}> defeated **${combat.target.label}** (+2 VP)`\x2C { allowedMentions: { users: [ownerId] }\x2C phase: 'ROUND'\x2C icon: 'attack' });\n          await checkWinConditions(game\x2C client);\n        }\n      }\n    }\n    await thread.send({ content: resultText || '(No effect)'\x2C components: [] });\n    delete game.pendingCombat;\n    saveGames();\n    return;\n  }\n\n  // Track figures damaged by this group's activation (for Aim: Rebel Trooper Elite\x2C etc.)\n  if (damage > 0 && combat.attackerMsgId && combat.target?.figureKey) {\n    game.activationDamagedFigures = game.activationDamagedFigures || {};\n    game.activationDamagedFigures[combat.attackerMsgId] = game.activationDamagedFigures[combat.attackerMsgId] || [];\n    if (!game.activationDamagedFigures[combat.attackerMsgId].includes(combat.target.figureKey)) {\n      game.activationDamagedFigures[combat.attackerMsgId].push(combat.target.figureKey);\n    }\n  }\n\n  // [COMBAT-TRACE] Selfplay diagnostic \u2014 log per-combat resolution details\n  if (game.selfPlay) {\n    const _ctDefHs = dcHealthState.get(targetMsgId);\n    const _ctDefHp = _ctDefHs?.[targetFigIndex];\n    const _ctPrevHp = Array.isArray(_ctDefHp) ? _ctDefHp[0] : '?';\n    const _ctMaxHp = Array.isArray(_ctDefHp) ? _ctDefHp[1] : '?';\n    const _ctRoll = combat.attackRoll || {};\n    const _ctDef = combat.defenseRoll || {};\n    console.log(`[COMBAT-TRACE] ${combat.attackerDcName} \u2192 ${targetDcName} | hit=${hit} dmg=${damage} | atk=[${_ctRoll.dmg}d\x2C${_ctRoll.acc}a\x2C${_ctRoll.surge}s] def=[${_ctDef.block}b\x2C${_ctDef.evade}e\x2C${_ctDef.dodge ? 'D' : '-'}] | surge_dmg=${combat.surgeDamage || 0} pierce=${(combat.surgePierce || 0) + (combat.bonusPierce || 0)} | hp=${_ctPrevHp}/${_ctMaxHp}\u2192${hit ? Math.max(0\x2C _ctPrevHp - damage) : _ctPrevHp} | defeated=${hit && _ctPrevHp > 0 && (_ctPrevHp - damage) <= 0 ? 'YES' : 'no'}`);\n  }\n\n  // Wave 3: Save target position before potential defeat (Blast needs coord after target removed from figurePositions)\n  const _targetCoordBeforeDefeat = game.figurePositions?.[defenderPlayerNum]?.[combat.target?.figureKey];\n\n  let _fdNeedsEmbedRefresh = false;\n  if (damage > 0 && targetMsgId) {\n    // Extra Protection re-entry guard: damage was already applied in the first pass.\n    // extraProtectionTriggeredThisCombat is set before the first-pass return;\n    // pendingExtraProtection is deleted by the handler before re-calling us.\n    const _epReentry = !!(game.extraProtectionTriggeredThisCombat && !game.pendingExtraProtection);\n    let newCur;\n    if (_epReentry) {\n      const _epHpState = dcHealthState.get(targetMsgId)?.[targetFigIndex];\n      newCur = Array.isArray(_epHpState) ? _epHpState[0] : 0;\n    } else {\n      ({ newHp: newCur } = reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C targetFigIndex\x2C damage\x2C defenderPlayerNum));\n    }\n    if (dcHealthState.get(targetMsgId)?.[targetFigIndex]) {\n      // Achievement: Devastator (10+ damage in a single attack)\n      if (damage >= 10 && !_epReentry && isDbConfigured() && achievementsChannelId) {\n        const _devUserId = getPlayerId(game\x2C attackerPlayerNum);\n        checkAndPostAchievements(checkAndGrantAchievements\x2C postAchievementNotification\x2C client\x2C achievementsChannelId\x2C _devUserId\x2C 'single_attack_damage'\x2C damage)\n          .catch((err) => console.error('[Achievements] Devastator check failed:'\x2C err.message));\n      }\n      const dcMessageIds = getDcMessageIds(game\x2C defenderPlayerNum);\n      const dcList = getDcList(game\x2C defenderPlayerNum);\n      const idx = (dcMessageIds || []).indexOf(targetMsgId);\n      // G22: Surge conditions (Bleed\x2C Stun\x2C Weaken\x2C etc.) only apply when the attack deals damage.\n      // This block is already inside `if (damage > 0 && targetMsgId)`\x2C but we add an explicit\n      // guard as defense-in-depth so conditions are never applied if damage is 0.\n      // Also skip on Extra Protection re-entry since conditions were already applied.\n      if (damage > 0 && !_epReentry) {\n        let allConditions = [...(combat.surgeConditions || [])\x2C ...(combat.bonusConditions || [])];\n        // Condition Immunity: filter out harmful conditions for immune figures\n        if (allConditions.length && isConditionImmune(game\x2C combat.target.figureKey)) {\n          const blocked = allConditions.filter((c) => HARMFUL_CONDITIONS.includes(c));\n          allConditions = allConditions.filter((c) => !HARMFUL_CONDITIONS.includes(c));\n          if (blocked.length) {\n            await logGameAction(game\x2C client\x2C `**Condition Immunity** \u2014 **${combat.target.label}** is immune to ${blocked.join('\x2C ')}.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n          }\n        }\n        // I30 Fireproof: Flame Trooper figures cannot be Bleeding\n        if (allConditions.includes('Bleed') && combat.defenderFireproof) {\n          allConditions = allConditions.filter(c => c !== 'Bleed');\n          await logGameAction(game\x2C client\x2C `**Fireproof** \u2014 **${combat.target.label}** is immune to Bleed.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n        }\n        for (const _ac of allConditions) _applyCondition(game\x2C combat.target.figureKey\x2C _ac);\n        // Punishing Strike (Skirmish Upgrade): when one of your figures applies a HARMFUL condition\x2C\n        // exhaust to discard that condition and apply a different HARMFUL condition instead.\n        const _psHarmful = allConditions.filter((c) => HARMFUL_CONDITIONS.includes(c));\n        if (_psHarmful.length > 0) {\n          const _psAtkDcList = getDcList(game\x2C attackerPlayerNum) || [];\n          const _psHasPS = _psAtkDcList.some(dc => dc.dcName === '[Punishing Strike]');\n          const _psExhKey = `ps_army_p${attackerPlayerNum}`;\n          const _psAlreadyExhausted = cardNameIncludes(game.exhaustedSkirmishUpgrades?.[_psExhKey]\x2C 'Punishing Strike');\n          if (_psHasPS && !_psAlreadyExhausted) {\n            // Show prompt for each harmful condition applied (use first one)\n            const _psCond = _psHarmful[0];\n            const _psOtherConds = HARMFUL_CONDITIONS.filter(c => c !== _psCond);\n            const _psBtns = _psOtherConds.map(c =>\n              new ButtonBuilder().setCustomId(`ps_replace_${game.gameId}_${combat.target.figureKey}_${_psCond}_${c}`).setLabel(`Replace with ${c}`).setStyle(ButtonStyle.Primary)\n            );\n            _psBtns.push(new ButtonBuilder().setCustomId(`ps_replace_${game.gameId}_${combat.target.figureKey}_${_psCond}_skip`).setLabel('Skip').setStyle(ButtonStyle.Secondary));\n            const _psRow = new ActionRowBuilder().addComponents(_psBtns);\n            game.pendingPunishingStrike = { attackerPlayerNum\x2C targetFigureKey: combat.target.figureKey\x2C originalCondition: _psCond };\n            await thread.send({ content: `**Punishing Strike** \u2014 **${combat.target.label}** was applied **${_psCond}**. Exhaust Punishing Strike to replace it with a different harmful condition?`\x2C components: [_psRow] }).catch(discordCatch);\n          }\n        }\n      }\n      // Skip post-damage effects on Extra Protection re-entry \u2014 they already fired in the first pass.\n      if (!_epReentry) {\n      // Furious Charge: if defender's player played this CC\x2C and suffered >= threshold damage\x2C grant Focus\n      if (game.conditionalFocusIfDamagedGte?.playerNum === defenderPlayerNum && damage >= game.conditionalFocusIfDamagedGte.threshold) {\n        if (_applyCondition(game\x2C combat.target.figureKey\x2C 'Focus')) {\n          await logGameAction(game\x2C client\x2C `**Furious Charge** \u2014 **${combat.target.label}** is now **Focused** (suffered ${damage} Damage).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n        }\n        game.conditionalFocusIfDamagedGte = null;\n      }\n      // Stun Batons (Riot Trooper E/R): after attack\x2C if target suffered damage\x2C target suffers 1 Strain\n      if (damage > 0) {\n        const _sbAttDcName = combat.attackerDcName || '';\n        const _sbAttEff = getDcEffects()?.[_sbAttDcName];\n        if ((_sbAttEff?.passives || []).includes('Stun Batons')) {\n          // Flame Trooper Fireproof: cannot suffer Strain\n          const _sbTargetUpgrades = game.p1DcAttachments?.[targetMsgId] || game.p2DcAttachments?.[targetMsgId] || [];\n          if (cardNameIncludes(_sbTargetUpgrades\x2C 'Flame Trooper')) {\n            await logGameAction(game\x2C client\x2C `**Fireproof** \u2014 **${combat.target.label}** is immune to Strain from Stun Batons.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n          } else {\n          game.figureConditions = game.figureConditions || {};\n          game.figureConditions[combat.target.figureKey] = game.figureConditions[combat.target.figureKey] || [];\n          // Strain = 1 direct HP damage (apply via health reduction)\n          const _sbResult = reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C targetFigIndex\x2C 1\x2C defenderPlayerNum);\n          newCur = _sbResult.newHp;\n          await logGameAction(game\x2C client\x2C `\\u26A1 **Stun Batons** \u2014 **${combat.target.label}** suffers 1 Strain (1 HP damage).`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n          }\n        }\n      }\n      // Critical Hit (Mak): if target suffered damage\x2C target cannot play CCs this round\n      if (damage > 0 && combat.surgeCriticalHit) {\n        game.criticalHitBlockedPlayer = defenderPlayerNum;\n        await logGameAction(game\x2C client\x2C `\\u{1F3AF} **Critical Hit** \u2014 **${combat.target.label}** cannot play Command cards for the rest of this round.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n      }\n      // Self-Preservation (Hired Gun Elite): when you suffer damage\x2C become Focused\n      if (newCur > 0) {\n        const _spDcName = idx >= 0 ? dcList[idx]?.dcName : dcNameFromFigureKey(combat.target.figureKey);\n        const _spEff = getDcEffects()?.[_spDcName];\n        if ((_spEff?.passives || []).includes('Self-Preservation')) {\n          if (_applyCondition(game\x2C combat.target.figureKey\x2C 'Focus')) {\n            await logGameAction(game\x2C client\x2C `\\u{1F6E1}\\uFE0F **Self-Preservation** \u2014 **${_spDcName}** became **Focused** (suffered damage).`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n          }\n        }\n      }\n      // Fury of Kashyyyk (army-wide): when a friendly WOOKIEE suffers 3+ damage\x2C become Focused\n      if (damage >= 3 && newCur > 0) {\n        const _fokDefDcList = getDcList(game\x2C defenderPlayerNum) || [];\n        const _fokHasFury = _fokDefDcList.some(dc => dc.dcName === '[Fury of Kashyyyk]');\n        if (_fokHasFury) {\n          const _fokTargetName = dcNameFromFigureKey(combat.target.figureKey);\n          const _fokTargetKws = (getDcKeywords(game)[_fokTargetName] || []).map(k => String(k).toUpperCase());\n          if (_fokTargetKws.includes('WOOKIEE')) {\n            if (_applyCondition(game\x2C combat.target.figureKey\x2C 'Focus')) {\n              await logGameAction(game\x2C client\x2C `**Fury of Kashyyyk** \u2014 **${_fokTargetName}** became **Focused** (suffered ${damage} Damage).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n            }\n          }\n        }\n      }\n      } // end !_epReentry guard for post-damage effects\n      // Extra Protection (Onar Koma CC): when a friendly figure within 2 spaces suffers 3+ damage\n      // and survives\x2C prompt the defending player to play Extra Protection (move 2 + free attack).\n      if (damage >= 3 && newCur > 0 && !game.extraProtectionTriggeredThisCombat) {\n        const _epHand = getCcHand(game\x2C defenderPlayerNum) || [];\n        const _epCardIdx = _epHand.indexOf('Extra Protection');\n        if (_epCardIdx >= 0) {\n          // Check if Onar Koma is alive and within 2 spaces of the damaged figure\n          const _epTargetPos = game.figurePositions?.[defenderPlayerNum]?.[combat.target.figureKey];\n          if (_epTargetPos && game.selectedMap?.id) {\n            const _epFriendlyFigs = game.figurePositions?.[defenderPlayerNum] || {};\n            for (const [_epFk\x2C _epPos] of Object.entries(_epFriendlyFigs)) {\n              if (_epFk === combat.target.figureKey) continue; // "another" friendly figure\n              const _epDcName = dcNameFromFigureKey(_epFk);\n              if (_epDcName !== 'Onar Koma') continue;\n              // Check within 2 spaces (BFS adjacency)\n              if (!isWithinN(_epPos\x2C _epTargetPos\x2C 2\x2C game.selectedMap.id)) continue;\n              // Find Onar's msgId for movement grant\n              const _epOnarMsgId = findDcMessageIdForFigure(game.gameId\x2C defenderPlayerNum\x2C _epFk);\n              if (!_epOnarMsgId) continue;\n              // All conditions met \u2014 prompt the player\n              game.extraProtectionTriggeredThisCombat = true;\n              game.pendingExtraProtection = {\n                targetFigKey: combat.target.figureKey\x2C targetMsgId\x2C targetFigIndex\x2C\n                damage\x2C playerNum: defenderPlayerNum\x2C\n                onarFigKey: _epFk\x2C onarMsgId: _epOnarMsgId\x2C onarDcName: _epDcName\x2C\n                // Store combat flow state for re-entry\n                hit\x2C resultText\x2C totalBlast\x2C defenderPlayerNum\x2C attackerPlayerNum\x2C ownerId\x2C\n              };\n              const _epOwnerId = game[`player${defenderPlayerNum}Id`];\n              const _epDamagedLabel = combat.target.label || dcNameFromFigureKey(combat.target.figureKey);\n              const _epRow = new ActionRowBuilder().addComponents(\n                new ButtonBuilder().setCustomId(`extra_protection_play_${game.gameId}`).setLabel('Play Extra Protection (move 2 + attack)').setStyle(ButtonStyle.Primary)\x2C\n                new ButtonBuilder().setCustomId(`extra_protection_skip_${game.gameId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary)\x2C\n              );\n              await logGameAction(game\x2C client\x2C `<@${_epOwnerId}> **Extra Protection** \u2014 **${_epDamagedLabel}** suffered ${damage} Damage. **${_epDcName}** is within 2 spaces and may play Extra Protection (move up to 2 spaces\x2C then perform an attack).`\x2C { components: [_epRow]\x2C allowedMentions: { users: [_epOwnerId] } });\n              saveGames();\n              return;\n            }\n          }\n        }\n      }\n      // Guerilla (Rebel Pathfinder E/R\x2C Alliance Ranger E): after attack\x2C if defender defeated\x2C attacker becomes Hidden\n      if (newCur <= 0) {\n        const _guerAttEff = getDcEffects()?.[combat.attackerDcName];\n        if ((_guerAttEff?.abilityText || '').includes('Guerilla') || (_guerAttEff?.abilityText || '').includes('guerilla')) {\n          if (_applyCondition(game\x2C combat.attackerFigureKey\x2C 'Hide')) {\n            await logGameAction(game\x2C client\x2C `\\u{1F977} **Guerilla** \u2014 **${combat.attackerDcName}** became **Hidden** (defender defeated).`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n          }\n        }\n      }\n      // Jets (Sabine Wren): after attack\x2C if target within 2 spaces\x2C gain 1 MP\n      if (combat.attackerDcName === 'Sabine Wren' && combat.distanceToTarget != null && combat.distanceToTarget <= 2) {\n        const _jetsMsgId = combat.attackerMsgId;\n        if (_jetsMsgId && game.movementBank?.[_jetsMsgId]) {\n          game.movementBank[_jetsMsgId].total = (game.movementBank[_jetsMsgId].total || 0) + 1;\n          game.movementBank[_jetsMsgId].remaining = (game.movementBank[_jetsMsgId].remaining || 0) + 1;\n          await logGameAction(game\x2C client\x2C `\\u{1F680} **Jets** \u2014 **Sabine Wren** gains 1 MP (target within 2 spaces).`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n        }\n      }\n      // Fly-By (Jet Trooper Elite): after attack\x2C gain 2 MP if target was within 2 spaces\n      {\n        const _fbAtkEff = getDcEffects()?.[combat.attackerDcName];\n        if ((_fbAtkEff?.passives || []).includes('Fly-By') && combat.distanceToTarget != null && combat.distanceToTarget <= 2) {\n          const _fbMsgId = combat.attackerMsgId;\n          if (_fbMsgId) {\n            grantMovementBank(game\x2C _fbMsgId\x2C 2);\n            await logGameAction(game\x2C client\x2C `\\u{1F680} **Fly-By** \u2014 **${combat.attackerDcName}** gains 2 MP (target within 2 spaces).`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n          }\n        }\n      }\n      // Jets (Jet Trooper Regular): after attack\x2C gain 1 MP if target within 2 spaces\n      {\n        const _jtAtkEff = getDcEffects()?.[combat.attackerDcName];\n        if ((_jtAtkEff?.passives || []).includes('Jets') && combat.distanceToTarget != null && combat.distanceToTarget <= 2) {\n          const _jtMsgId = combat.attackerMsgId;\n          if (_jtMsgId) {\n            grantMovementBank(game\x2C _jtMsgId\x2C 1);\n            await logGameAction(game\x2C client\x2C `\\u{1F680} **Jets** \u2014 **${combat.attackerDcName}** gains 1 MP (target within 2 spaces).`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n          }\n        }\n      }\n      // Leg Hydraulics (Tress Hacnua): handled via specialAbilityIds check below (not passives) to avoid double-granting\n      // Locked and Loaded (Migs Mayfeld): after attack\x2C gain 2 Power Tokens (max 3 total)\n      {\n        const _llAtkEff = getDcEffects()?.[combat.attackerDcName];\n        if ((_llAtkEff?.passives || []).includes('Locked and Loaded')) {\n          const _llFk = combat.attackerFigureKey;\n          if (_llFk) {\n            game.figurePowerTokens = game.figurePowerTokens || {};\n            game.figurePowerTokens[_llFk] = game.figurePowerTokens[_llFk] || [];\n            const _llCurrent = game.figurePowerTokens[_llFk].length;\n            const _llGain = Math.min(2\x2C 3 - _llCurrent);\n            if (_llGain > 0) {\n              game.pendingPowerTokenGrant = { grants: [{ figureKey: _llFk\x2C figName: combat.attackerDcName\x2C count: _llGain }]\x2C channelId: combat.combatThreadId\x2C playerNum: attackerPlayerNum };\n              const _llBtns = ['Damage'\x2C 'Surge'\x2C 'Block'\x2C 'Evade'].map(t =>\n                new ButtonBuilder().setCustomId(`power_token_choice_${game.gameId}_${t.toLowerCase()}`).setLabel(t).setStyle(ButtonStyle.Secondary)\n              );\n              await thread.send({\n                content: `\\u{1F52B} **Locked and Loaded** \u2014 **${combat.attackerDcName}** gains ${_llGain} Power Token${_llGain > 1 ? 's' : ''} (${_llCurrent} \\u2192 ${_llCurrent + _llGain}\x2C max 3). Choose type:`\x2C\n                components: [new ActionRowBuilder().addComponents(_llBtns)]\x2C\n              }).catch(discordCatch);\n            } else {\n              await logGameAction(game\x2C client\x2C `\\u{1F52B} **Locked and Loaded** \u2014 **${combat.attackerDcName}** already at max 3 Power Tokens; no tokens gained.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n            }\n          }\n        }\n      }\n      // Open-Minded (Del Meeko): after attack\x2C gain 1 MP or 1 Power Token (choice)\n      {\n        const _omAtkEff = getDcEffects()?.[combat.attackerDcName];\n        if ((_omAtkEff?.passives || []).includes('Open-Minded')) {\n          const _omMsgId = combat.attackerMsgId;\n          const _omFk = combat.attackerFigureKey;\n          if (_omMsgId && _omFk) {\n            const _omBtns = [\n              new ButtonBuilder().setCustomId(`act_passive_${game.gameId}_${_omMsgId}_openminded_mp`).setLabel('Gain 1 MP').setStyle(ButtonStyle.Primary)\x2C\n              new ButtonBuilder().setCustomId(`act_passive_${game.gameId}_${_omMsgId}_openminded_token`).setLabel('Gain 1 Power Token').setStyle(ButtonStyle.Secondary)\x2C\n            ];\n            await thread.send({\n              content: `\\u{1F9E0} **Open-Minded** \u2014 **${combat.attackerDcName}**: Choose one:`\x2C\n              components: [new ActionRowBuilder().addComponents(_omBtns)]\x2C\n            }).catch(discordCatch);\n          }\n        }\n      }\n      // Nimble (Asajj Ventress): after attack resolves\x2C defender gains 2 MP per Block result\n      {\n        const _nimDcName = idx >= 0 ? dcList[idx]?.dcName : dcNameFromFigureKey(combat.target.figureKey);\n        const _nimEff = getDcEffects()?.[_nimDcName];\n        if ((_nimEff?.specialAbilityIds || []).includes('nimble_asajj') && combat.defenseRoll) {\n          const _nimTotalBlock = combat.defenseRoll.block || 0;\n          if (_nimTotalBlock > 0) {\n            const _nimMp = _nimTotalBlock * 2;\n            const _nimMsgId = targetMsgId;\n            if (_nimMsgId) {\n              grantMovementBank(game\x2C _nimMsgId\x2C _nimMp);\n            }\n            await logGameAction(game\x2C client\x2C `\\u{1F98E} **Nimble** \u2014 **${_nimDcName}** gained ${_nimMp} MP (${_nimTotalBlock} Block result${_nimTotalBlock !== 1 ? 's' : ''} \\u00D7 2).`\x2C { phase: 'ROUND'\x2C icon: 'attack' }).catch(discordCatch);\n          }\n        }\n      }\n      // Slippery (Alliance Smuggler E/R): after attack resolves\x2C defender gains 2 MP\n      {\n        const _slipDcName = idx >= 0 ? dcList[idx]?.dcName : dcNameFromFigureKey(combat.target.figureKey);\n        const _slipEff = getDcEffects()?.[_slipDcName];\n        if ((_slipEff?.specialAbilityIds || []).some(id => id === 'slippery_smuggler_elite' || id === 'slippery_smuggler_reg')) {\n          const _slipMsgId = targetMsgId;\n          if (_slipMsgId) {\n            grantMovementBank(game\x2C _slipMsgId\x2C 2);\n          }\n          await logGameAction(game\x2C client\x2C `\\u{1F3C3} **Slippery** \u2014 **${_slipDcName}** gains 2 MP after being attacked.`\x2C { phase: 'ROUND'\x2C icon: 'attack' }).catch(discordCatch);\n        }\n      }\n      // Leg Hydraulics (Tress Hacnua): after resolving an attack\x2C attacker gains 1 MP\n      {\n        const _lhAtkDcName = combat.attackerDcName || dcNameFromFigureKey(combat.attackerFigureKey);\n        const _lhEff = getDcEffects()?.[_lhAtkDcName];\n        if ((_lhEff?.specialAbilityIds || []).includes('leg_hydraulics_tress') && combat.attackerMsgId) {\n          grantMovementBank(game\x2C combat.attackerMsgId\x2C 1);\n          await logGameAction(game\x2C client\x2C `\\u{1F9BF} **Leg Hydraulics** \u2014 **${_lhAtkDcName}** gains 1 MP after attacking.`\x2C { phase: 'ROUND'\x2C icon: 'attack' }).catch(discordCatch);\n        }\n      }\n      // Loku Recon Token: Set Your Sights \u2014 after Loku's attack resolves\x2C place recon token on target\n      {\n        const _lkAtkDcName = combat.attackerDcName || dcNameFromFigureKey(combat.attackerFigureKey);\n        const _lkAtkEff = getDcEffects()?.[_lkAtkDcName];\n        if ((_lkAtkEff?.specialAbilityIds || []).includes('set_your_sights_loku') && combat.target?.figureKey) {\n          game.reconToken = { figureKey: combat.target.figureKey\x2C playerNum: combat.attackerPlayerNum };\n          await logGameAction(game\x2C client\x2C `\\u{1F3AF} **Set Your Sights** \u2014 Recon token placed on **${dcNameFromFigureKey(combat.target.figureKey)}**.`\x2C { phase: 'ROUND'\x2C icon: 'attack' }).catch(discordCatch);\n        }\n      }\n      // Force Deflection (Yoda): after attack targeting Yoda or adjacent friendly REBEL resolves\x2C\n      // attacker suffers Damage = number of attack dice rolled. Limit once per round.\n      {\n        const _fdDefDcName = idx >= 0 ? dcList[idx]?.dcName : dcNameFromFigureKey(combat.target.figureKey);\n        const _fdDefEff = getDcEffects()?.[_fdDefDcName];\n        const _fdDefIsTarget = (_fdDefEff?.specialAbilityIds || []).includes('force_deflection_yoda');\n        let _fdYodaFigKey = null;\n        if (_fdDefIsTarget) {\n          // Yoda is the defender \u2014 use Yoda's own figure key for round tracking\n          _fdYodaFigKey = combat.target.figureKey;\n        } else {\n          // Check if any Yoda figure on defender's team is adjacent to the target space AND defender is REBEL\n          const _fdDefAffil = _fdDefEff?.affiliation || '';\n          if (_fdDefAffil === 'Rebel') {\n            const _fdFriendlyFigs = game.figurePositions?.[defenderPlayerNum] || {};\n            const _fdTargetCoord = _fdFriendlyFigs[combat.target.figureKey];\n            if (_fdTargetCoord) {\n              for (const [fk\x2C fCoord] of Object.entries(_fdFriendlyFigs)) {\n                if (fk === combat.target.figureKey) continue;\n                const fDcName = dcNameFromFigureKey(fk);\n                const fEff = getDcEffects()?.[fDcName];\n                if (!(fEff?.specialAbilityIds || []).includes('force_deflection_yoda')) continue;\n                // Check adjacency (within 1 space)\n                if (isWithinN(fCoord\x2C _fdTargetCoord\x2C 1\x2C game.selectedMap?.id)) {\n                  _fdYodaFigKey = fk;\n                  break;\n                }\n              }\n            }\n          }\n        }\n        if (_fdYodaFigKey) {\n          game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n          const _fdKey = `${_fdYodaFigKey}_force_deflection`;\n          if (!game.roundFigureAbilityUsed[_fdKey]) {\n            game.roundFigureAbilityUsed[_fdKey] = true;\n            const _fdDiceCount = combat.attackDiceResults?.length || 0;\n            if (_fdDiceCount > 0 && combat.attackerMsgId) {\n              const _fdAtkFigIdx = combat.attackerFigureIndex ?? 0;\n              const { newHp: _fdAtkNew\x2C prevHp: _fdAtkPrev\x2C wasDefeated: _fdAtkDefeated } = reduceHp(dcHealthState\x2C game\x2C combat.attackerMsgId\x2C _fdAtkFigIdx\x2C _fdDiceCount\x2C attackerPlayerNum);\n              if (_fdAtkPrev > 0) {\n                _fdNeedsEmbedRefresh = true;\n                const _fdYodaDcName = dcNameFromFigureKey(_fdYodaFigKey);\n                await logGameAction(game\x2C client\x2C `\\u{1F535} **Force Deflection** \u2014 **${_fdYodaDcName}** deflects! **${combat.attackerDcName}** suffers **${_fdDiceCount} Damage** (${_fdDiceCount} attack dice rolled). HP: ${_fdAtkPrev} \\u2192 ${_fdAtkNew}.`\x2C { phase: 'ROUND'\x2C icon: 'attack' }).catch(discordCatch);\n                // Check if attacker was defeated by Force Deflection\n                if (_fdAtkDefeated) {\n                  const _fdAtkDcIds = getDcMessageIds(game\x2C attackerPlayerNum);\n                  const _fdAtkDcIdx = (_fdAtkDcIds || []).indexOf(combat.attackerMsgId);\n                  await processFigureDefeat(game\x2C {\n                    defeatedPlayerNum: attackerPlayerNum\x2C\n                    figureKey: combat.attackerFigureKey\x2C\n                    attackerPlayerNum: defenderPlayerNum\x2C\n                    attackerFigureKey: combat.target.figureKey\x2C\n                    msgId: combat.attackerMsgId\x2C\n                    dcIdx: _fdAtkDcIdx\x2C\n                    dcName: combat.attackerDcName\x2C\n                    source: 'Force Deflection'\x2C\n                  }\x2C deps);\n                }\n              }\n            }\n          }\n        }\n      }\n      // Distracting Fire (Rebel Pathfinder Elite): after an attack resolves\x2C if any enemy\n      // Rebel Pathfinder with distracting_fire has LOS to the attacker\x2C deal 1 Damage to attacker.\n      {\n        const _dfAtkPos = game.figurePositions?.[attackerPlayerNum]?.[combat.attackerFigureKey];\n        if (_dfAtkPos && combat.attackerMsgId && game.selectedMap?.id) {\n          const _dfMapSp = getEffectiveMapSpaces(game\x2C getMapData(game.selectedMap.id));\n          // Scan the defender's side for alive Rebel Pathfinder figures\n          const _dfFriendlyFigs = game.figurePositions?.[defenderPlayerNum] || {};\n          for (const [_dfFk\x2C _dfPos] of Object.entries(_dfFriendlyFigs)) {\n            const _dfDcName = dcNameFromFigureKey(_dfFk);\n            const _dfEff = getDcEffects()?.[_dfDcName];\n            if (!(_dfEff?.specialAbilityIds || []).includes('distracting_fire_rebel_pathfinder')) continue;\n            // Check LOS from Pathfinder to attacker\n            const _dfAtkCoord = String(_dfAtkPos).toLowerCase();\n            const _dfPathCoord = String(_dfPos).toLowerCase();\n            if (!hasLineOfSight(_dfPathCoord\x2C _dfAtkCoord\x2C _dfMapSp\x2C null)) continue;\n            // Deal 1 Damage to the attacker\n            const _dfAtkFigIdx = combat.attackerFigureIndex ?? 0;\n            const { newHp: _dfAtkNew\x2C prevHp: _dfAtkPrev\x2C wasDefeated: _dfAtkDefeated } = reduceHp(dcHealthState\x2C game\x2C combat.attackerMsgId\x2C _dfAtkFigIdx\x2C 1\x2C attackerPlayerNum);\n            if (_dfAtkPrev > 0) {\n              _fdNeedsEmbedRefresh = true;\n              await logGameAction(game\x2C client\x2C `**Distracting Fire** \u2014 **${_dfDcName}** has LOS to attacker **${combat.attackerDcName}**! Attacker suffers **1 Damage**. HP: ${_dfAtkPrev} \\u2192 ${_dfAtkNew}.`\x2C { phase: 'ROUND'\x2C icon: 'attack' }).catch(discordCatch);\n              if (_dfAtkDefeated) {\n                const _dfAtkDcIds = getDcMessageIds(game\x2C attackerPlayerNum);\n                const _dfAtkDcIdx = (_dfAtkDcIds || []).indexOf(combat.attackerMsgId);\n                await processFigureDefeat(game\x2C {\n                  defeatedPlayerNum: attackerPlayerNum\x2C\n                  figureKey: combat.attackerFigureKey\x2C\n                  attackerPlayerNum: defenderPlayerNum\x2C\n                  attackerFigureKey: combat.target.figureKey\x2C\n                  msgId: combat.attackerMsgId\x2C\n                  dcIdx: _dfAtkDcIdx\x2C\n                  dcName: combat.attackerDcName\x2C\n                  source: 'Distracting Fire'\x2C\n                }\x2C deps);\n              }\n            }\n            break; // Only one Distracting Fire trigger per attack\n          }\n        }\n      }\n      // You Will Not Deny Me: prevent Fifth Brother from being defeated (restore HP to 1)\n      if (newCur <= 0 && game.youWillNotDenyMeActive?.playerNum === defenderPlayerNum) {\n        const _ywndmDcName = idx >= 0 ? dcList[idx]?.dcName : dcNameFromFigureKey(combat.target.figureKey);\n        if (_ywndmDcName?.toLowerCase().includes('fifth')) {\n          const { newHp: _ywndmNew } = healHp(dcHealthState\x2C game\x2C targetMsgId\x2C targetFigIndex\x2C 1\x2C defenderPlayerNum);\n          newCur = _ywndmNew;\n          // Do NOT null the flag here \u2014 effect persists until a hostile is defeated\n          await logGameAction(game\x2C client\x2C `**You Will Not Deny Me** \u2014 Fifth Brother cannot be defeated! HP restored to 1.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n        }\n      }\n      // Second Chance: CC attachment \u2014 before defeated\x2C recover 2 Damage and discard the card\n      if (newCur <= 0 && game.secondChanceDcMsgId?.[targetMsgId] === defenderPlayerNum) {\n        const { newHp: _scNew } = healHp(dcHealthState\x2C game\x2C targetMsgId\x2C targetFigIndex\x2C 2\x2C defenderPlayerNum);\n        newCur = _scNew;\n        delete game.secondChanceDcMsgId[targetMsgId];\n        await logGameAction(game\x2C client\x2C `**Second Chance** triggered! Recovered 2 Damage (HP \\u2192 ${newCur}). Card discarded.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n      }\n      // Sustained by Rage (Maul): cannot be defeated if has not activated this round \u2014 set HP to 1\n      let _sbrImmune = false;\n      if (newCur <= 0) {\n        const _sbrDcName = idx >= 0 ? dcList[idx]?.dcName : dcNameFromFigureKey(combat.target.figureKey);\n        const _sbrEff = getDcEffects()?.[_sbrDcName];\n        if ((_sbrEff?.specialAbilityIds || []).includes('sustained_by_rage')) {\n          const _sbrActivatedIndices = getActivatedDcIndices(game\x2C defenderPlayerNum) || [];\n          if (idx >= 0 && !_sbrActivatedIndices.includes(idx)) {\n            _sbrImmune = true;\n            const { newHp: _sbrNew } = healHp(dcHealthState\x2C game\x2C targetMsgId\x2C targetFigIndex\x2C 1\x2C defenderPlayerNum);\n            newCur = _sbrNew;\n            await logGameAction(game\x2C client\x2C `**Sustained by Rage** \u2014 **${_sbrDcName}** cannot be defeated (has not activated this round)! HP set to 1.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n          }\n        }\n      }\n      // Self-Destruct Protocol: pre-defeat interrupt \u2014 prompt owner to use ability before defeat\n      if (newCur <= 0 && !game.selfDestructProtocolTriggered?.[targetMsgId]) {\n        const _sdpDcName2 = idx >= 0 ? dcList?.[idx]?.dcName : dcNameFromFigureKey(combat.target.figureKey);\n        const _sdpEff2 = getDcEffects()?.[_sdpDcName2];\n        if ((_sdpEff2?.specialAbilityIds || []).includes('self_destruct_protocol')) {\n          game.selfDestructProtocolTriggered = game.selfDestructProtocolTriggered || {};\n          game.selfDestructProtocolTriggered[targetMsgId] = true;\n          game.pendingSelfDestruct = { targetMsgId\x2C defenderPlayerNum\x2C attackerPlayerNum\x2C damage\x2C hit\x2C resultText\x2C totalBlast\x2C ownerId\x2C targetFigIndex };\n          const _sdpOwnerId2 = game[`player${defenderPlayerNum}Id`];\n          const _sdpRow2 = new ActionRowBuilder().addComponents(\n            new ButtonBuilder().setCustomId(`self_destruct_protocol_use_${game.gameId}_${targetMsgId}`).setLabel('Use Self-Destruct').setStyle(ButtonStyle.Danger)\x2C\n            new ButtonBuilder().setCustomId(`self_destruct_protocol_skip_${game.gameId}_${targetMsgId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary)\x2C\n          );\n          await logGameAction(game\x2C client\x2C `<@${_sdpOwnerId2}> **Self-Destruct Protocol** \u2014 **${combat.target.label || _sdpDcName2}** is about to be defeated! Roll 1 red die\x2C apply Hits to adjacent figures\x2C then the figure is defeated.`\x2C { components: [_sdpRow2]\x2C allowedMentions: { users: [_sdpOwnerId2] } });\n          saveGames();\n          return;\n        }\n      }\n      // Parting Shot (Greedo\x2C Hired Gun): pre-defeat interrupt \u2014 may perform an attack before being defeated\n      if (newCur <= 0 && !_sbrImmune && !game.partingShotTriggered?.[targetMsgId]) {\n        const _psDcName = idx >= 0 ? dcList?.[idx]?.dcName : dcNameFromFigureKey(combat.target.figureKey);\n        const _psEff = getDcEffects()?.[_psDcName];\n        const _psSIds = _psEff?.specialAbilityIds || [];\n        const _psHas = _psSIds.some(id => id.startsWith('parting_shot_'));\n        if (_psHas) {\n          game.partingShotTriggered = game.partingShotTriggered || {};\n          game.partingShotTriggered[targetMsgId] = true;\n          const _psOwnerId = game[`player${defenderPlayerNum}Id`];\n          await logGameAction(game\x2C client\x2C `<@${_psOwnerId}> \\u26A0\\uFE0F **Parting Shot** \u2014 **${combat.target.label || _psDcName}** is about to be defeated! You may interrupt to perform an attack before defeat. Use the DC's Attack action to fire your parting shot\x2C then click End Turn to proceed with defeat.`\x2C { allowedMentions: { users: [_psOwnerId] } });\n        }\n      }\n      // Last Resort (Skirmish Upgrade): pre-defeat interrupt \u2014 roll 1 red die\x2C adjacent figures suffer Hits as damage\n      if (newCur <= 0 && !_sbrImmune && !game.lastResortTriggered?.[targetMsgId]) {\n        const _lrUpgrades = game.p1DcAttachments?.[targetMsgId] || game.p2DcAttachments?.[targetMsgId] || [];\n        if (cardNameIncludes(_lrUpgrades\x2C 'Last Resort')) {\n          game.lastResortTriggered = game.lastResortTriggered || {};\n          game.lastResortTriggered[targetMsgId] = true;\n          game.pendingLastResort = { targetMsgId\x2C defenderPlayerNum\x2C attackerPlayerNum\x2C damage\x2C hit\x2C resultText\x2C totalBlast\x2C ownerId\x2C targetFigIndex };\n          const _lrOwnerId = game[`player${defenderPlayerNum}Id`];\n          const _lrRow = new ActionRowBuilder().addComponents(\n            new ButtonBuilder().setCustomId(`last_resort_use_${game.gameId}_${targetMsgId}`).setLabel('Use Last Resort').setStyle(ButtonStyle.Danger)\x2C\n            new ButtonBuilder().setCustomId(`last_resort_skip_${game.gameId}_${targetMsgId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary)\x2C\n          );\n          await logGameAction(game\x2C client\x2C `<@${_lrOwnerId}> **Last Resort** \u2014 **${combat.target.label}** is about to be defeated! Deplete to roll 1 red die \u2014 adjacent figures suffer Hits as Damage.`\x2C { components: [_lrRow]\x2C allowedMentions: { users: [_lrOwnerId] } });\n          saveGames();\n          return;\n        }\n      }\n      // Executor (Royal Guard Champion): when a friendly figure is defeated within 3 spaces\x2C\n      // RGC may interrupt to move 2 spaces + perform a free attack. Limit once per round.\n      if (newCur <= 0 && !_sbrImmune && !game.executorTriggered?.[targetMsgId]) {\n        const _exDefeatedPos = game.figurePositions?.[defenderPlayerNum]?.[combat.target.figureKey];\n        if (_exDefeatedPos && game.selectedMap?.id) {\n          const _exFriendlyFigs = game.figurePositions?.[defenderPlayerNum] || {};\n          for (const [_exFk\x2C _exPos] of Object.entries(_exFriendlyFigs)) {\n            if (_exFk === combat.target.figureKey) continue;\n            const _exDcName = dcNameFromFigureKey(_exFk);\n            const _exEff = getDcEffects()?.[_exDcName];\n            if (!(_exEff?.specialAbilityIds || []).includes('executor')) continue;\n            // Check within 3 spaces\n            if (!isWithinN(_exPos\x2C _exDefeatedPos\x2C 3\x2C game.selectedMap.id)) continue;\n            // Limit once per round\n            const _exRoundKey = `${_exFk}_executor`;\n            if (game.roundFigureAbilityUsed?.[_exRoundKey]) continue;\n            // Find RGC's msgId\n            const _exRgcMsgId = findDcMessageIdForFigure(game.gameId\x2C defenderPlayerNum\x2C _exFk);\n            if (!_exRgcMsgId) continue;\n            // Trigger the interrupt\n            game.executorTriggered = game.executorTriggered || {};\n            game.executorTriggered[targetMsgId] = true;\n            game.pendingExecutorInterrupt = {\n              rgcFigKey: _exFk\x2C rgcMsgId: _exRgcMsgId\x2C rgcPlayerNum: defenderPlayerNum\x2C\n              rgcDcName: _exDcName\x2C defeatedLabel: combat.target.label\x2C\n              targetMsgId\x2C defenderPlayerNum\x2C attackerPlayerNum\x2C\n              damage\x2C hit\x2C resultText\x2C totalBlast\x2C ownerId\x2C targetFigIndex\x2C\n            };\n            const _exOwnerId = game[`player${defenderPlayerNum}Id`];\n            const _exRow = new ActionRowBuilder().addComponents(\n              new ButtonBuilder().setCustomId(`executor_use_${game.gameId}_${_exRgcMsgId}`).setLabel('Use Executor').setStyle(ButtonStyle.Primary)\x2C\n              new ButtonBuilder().setCustomId(`executor_skip_${game.gameId}_${_exRgcMsgId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary)\x2C\n            );\n            await logGameAction(game\x2C client\x2C `<@${_exOwnerId}> **Executor** \u2014 **${_exDcName}** may interrupt (friendly **${combat.target.label}** defeated within 3 spaces). Move up to 2 spaces\x2C then perform an attack.`\x2C { components: [_exRow]\x2C allowedMentions: { users: [_exOwnerId] } });\n            saveGames();\n            return;\n          }\n        }\n      }\n      if (newCur <= 0 && !_sbrImmune && !(game.youWillNotDenyMeActive?.playerNum === defenderPlayerNum && ((idx >= 0 ? dcList[idx]?.dcName : dcNameFromFigureKey(combat.target.figureKey))?.toLowerCase().includes('fifth')))) {\n        // PRE-DEFEAT: Combat-specific context for CC timing validation (Of No Importance\x2C etc.)\n        game.lastDefeatInfo = { playerNum: defenderPlayerNum\x2C figureKey: combat.target.figureKey\x2C dcName: targetDcName };\n        // CANONICAL DEFEAT CORE \u2014 handles: position removal\x2C conditions\x2C device tokens\x2C\n        // VP (including attachment VP)\x2C defeat log\x2C activation decrement\x2C CC attachment cleanup\x2C\n        // passive redraws\x2C Nefarious Gains\x2C Hunt Dissent\x2C Heroic Effort\x2C Scavenged Weaponry.\n        // Win conditions skipped: combat-specific post-defeat effects may modify VP first.\n        const { vp } = await processFigureDefeat(game\x2C {\n          defeatedPlayerNum: defenderPlayerNum\x2C\n          figureKey: combat.target.figureKey\x2C\n          attackerPlayerNum\x2C\n          attackerFigureKey: combat.attackerFigureKey\x2C\n          msgId: targetMsgId\x2C\n          dcIdx: idx\x2C\n          dcName: targetDcName\x2C\n          displayName: combat.target.label\x2C\n          skipWinConditions: true\x2C\n        }\x2C { ...deps\x2C client });\n        const _vpK = vpKey(attackerPlayerNum);\n        // Achievement: activation kill streak (Double Kill / Triple Kill / PENTAKILL)\n        if (combat.attackerMsgId) {\n          game.activationKills = game.activationKills || {};\n          game.activationKills[combat.attackerMsgId] = (game.activationKills[combat.attackerMsgId] || 0) + 1;\n          if (isDbConfigured() && achievementsChannelId) {\n            const _akUserId = getPlayerId(game\x2C attackerPlayerNum);\n            checkAndPostAchievements(checkAndGrantAchievements\x2C postAchievementNotification\x2C client\x2C achievementsChannelId\x2C _akUserId\x2C 'activation_kills'\x2C game.activationKills[combat.attackerMsgId])\n              .catch((err) => console.error('[Achievements] activation_kills check failed:'\x2C err.message));\n          }\n        }\n        // Of No Importance: reduce VP gained when CC owner's own non-unique figure is defeated\n        if (game.nextDefeatedFriendlyVpReduction?.playerNum === defenderPlayerNum) {\n          const _noImportDcName = idx >= 0 ? dcList[idx]?.dcName : null;\n          if (_noImportDcName && !isDcUnique(_noImportDcName)) {\n            const _reduceAmt = game.nextDefeatedFriendlyVpReduction.amount || 0;\n            const _reduced = Math.min(_reduceAmt\x2C vp);\n            game[_vpK].kills = Math.max(0\x2C game[_vpK].kills - _reduced);\n            game[_vpK].total = Math.max(0\x2C game[_vpK].total - _reduced);\n            resultText += ` (\\u2212${_reduced} VP: Of No Importance)`;\n            await logGameAction(game\x2C client\x2C `**Of No Importance** \u2014 VP reduced by ${_reduced}.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n          }\n          game.nextDefeatedFriendlyVpReduction = null;\n        }\n        // Price on Their Heads: award bounty VP to setter when target group is defeated\n        const _priceBounty = game.priceBounties?.[combat.target.label];\n        if (_priceBounty) {\n          const _bountyAmt = typeof _priceBounty === 'object' ? _priceBounty.amount : _priceBounty;\n          const _bountySetterNum = typeof _priceBounty === 'object' ? _priceBounty.playerNum : attackerPlayerNum;\n          awardObjectiveVp(game\x2C _bountySetterNum\x2C _bountyAmt);\n          delete game.priceBounties[combat.target.label];\n          const _bountyVpK = vpKey(_bountySetterNum);\n          await logGameAction(game\x2C client\x2C `**Price on Their Heads** \u2014 +${_bountyAmt} VP bounty awarded to P${_bountySetterNum} (${game[_bountyVpK].total} total).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n        }\n        // Paid in Beskar: grant Block tokens when hostile is defeated within range\n        if (game.whenDefeatHostileWithin3GainBlockTokens) {\n          const _beskarData = game.whenDefeatHostileWithin3GainBlockTokens;\n          const _beskarDist = combat.distanceToTarget ?? 0;\n          const _beskarRange = _beskarData.range ?? 3;\n          if (_beskarDist <= _beskarRange) {\n            const _beskarTokens = _beskarData.tokens ?? 1;\n            const _beskarFigKey = combat.attackerFigureKey;\n            grantPowerTokens(game\x2C _beskarFigKey\x2C 'Block'\x2C _beskarTokens);\n            await logGameAction(game\x2C client\x2C `**Paid in Beskar** \u2014 +${_beskarTokens} Block Token${_beskarTokens !== 1 ? 's' : ''} granted to ${combat.attackerDisplayName}.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n          }\n          game.whenDefeatHostileWithin3GainBlockTokens = null;\n        }\n        // Worth Every Credit: bonus VP when hostile is defeated this activation\n        if (game.nextHostileDefeatVpBonus?.[attackerPlayerNum]) {\n          const _wecData = game.nextHostileDefeatVpBonus[attackerPlayerNum];\n          const _wecAmt = typeof _wecData === 'object' ? (_wecData.amount ?? 2) : _wecData;\n          awardObjectiveVp(game\x2C attackerPlayerNum\x2C _wecAmt);\n          delete game.nextHostileDefeatVpBonus[attackerPlayerNum];\n          await logGameAction(game\x2C client\x2C `**Worth Every Credit** \u2014 +${_wecAmt} bonus VP (${game[_vpK].total} total).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n        }\n        // You Will Not Deny Me: on any hostile defeat\x2C Fifth Brother recovers 2 HP \u2192 card goes to game box\n        if (game.youWillNotDenyMeActive) {\n          const _ywndmData = game.youWillNotDenyMeActive;\n          const _fifthKey = Object.keys(game.figurePositions?.[_ywndmData.playerNum] || {}).find(k => dcNameFromFigureKey(k).toLowerCase().includes('fifth brother'));\n          if (_fifthKey) {\n            const _fifthMsgId = (() => { for (const [mid\x2C mm] of dcMessageMeta) { if (mm.playerNum === _ywndmData.playerNum && mm.dcName?.toLowerCase().includes('fifth')) return mid; } return null; })();\n            if (_fifthMsgId) {\n              const { healed: _fifthHealed } = healHp(dcHealthState\x2C game\x2C _fifthMsgId\x2C 0\x2C 2\x2C _ywndmData.playerNum);\n              if (_fifthHealed > 0) {\n                await logGameAction(game\x2C client\x2C `**You Will Not Deny Me** \u2014 Fifth Brother recovered 2 HP after hostile defeat. Card returns to game box.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n              }\n              game.youWillNotDenyMeActive = null;\n              // Move card to game box\n              game.gameBox = game.gameBox || [];\n              game.gameBox.push('You Will Not Deny Me');\n            }\n          }\n        }\n        // Apex Predator: recover HP when a hostile within range is defeated this activation\n        if (game.recoverOnHostileDefeat?.[attackerPlayerNum]) {\n          const _apData = game.recoverOnHostileDefeat[attackerPlayerNum];\n          const _apRange = _apData.range ?? 2;\n          const _apDist = combat.distanceToTarget ?? 0;\n          if (_apDist <= _apRange) {\n            const _apMsgId = _apData.msgId ?? combat.attackerMsgId;\n            const _apAmt = _apData.amount ?? 2;\n            if (_apMsgId) {\n              const _apFigIdx = combat.attackerFigureIndex ?? 0;\n              const { healed: _apHealed } = healHp(dcHealthState\x2C game\x2C _apMsgId\x2C _apFigIdx\x2C _apAmt\x2C attackerPlayerNum);\n              if (_apHealed > 0) {\n                await logGameAction(game\x2C client\x2C `**Apex Predator** \u2014 Recovered ${_apAmt} HP after defeating hostile within ${_apRange}.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n              }\n            }\n          }\n          delete game.recoverOnHostileDefeat[attackerPlayerNum];\n        }\n        // Last Stand (Stormtrooper Elite): when defeated\x2C another figure in the group becomes Focused\n        const _lsDcName = idx >= 0 ? dcList[idx]?.dcName : dcNameFromFigureKey(combat.target.figureKey);\n        const _lsEff = getDcEffects()?.[_lsDcName];\n        if ((_lsEff?.passives || []).includes('Last Stand')) {\n          const _lsDgMatch = (combat.target.figureKey || '').match(/-(\\d+)-\\d+$/);\n          const _lsDgIdx = _lsDgMatch ? _lsDgMatch[1] : '1';\n          const _lsPrefix = `${_lsDcName}-${_lsDgIdx}-`;\n          const _lsAlive = Object.keys(game.figurePositions?.[defenderPlayerNum] || {}).filter(k => k.startsWith(_lsPrefix) && k !== combat.target.figureKey);\n          if (_lsAlive.length > 0) {\n            const _lsTarget = _lsAlive[0];\n            if (_applyCondition(game\x2C _lsTarget\x2C 'Focus')) {\n              const _lsName = dcNameFromFigureKey(_lsTarget);\n              await logGameAction(game\x2C client\x2C `\\u26A1 **Last Stand** \u2014 **${_lsName}** becomes **Focused** (another figure in the group was defeated).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n            }\n          }\n        }\n        // Nefarious Gains \u2014 now handled by processFigureDefeat\n        // Imperial Citadel: when a friendly Imperial figure is defeated\x2C transfer its Power Tokens to the Citadel card\n        {\n          const _icDefDcName = idx >= 0 ? dcList[idx]?.dcName : dcNameFromFigureKey(combat.target.figureKey);\n          const _icDefEff = getDcEffects()?.[_icDefDcName];\n          if (_icDefEff?.affiliation === 'Imperial') {\n            const _icDcList = getDcList(game\x2C defenderPlayerNum) || [];\n            if (_icDcList.some(dc => dc.dcName === '[Imperial Citadel]')) {\n              const _icTokens = game.figurePowerTokens?.[combat.target.figureKey] || [];\n              if (_icTokens.length > 0) {\n                game.imperialCitadelTokens = game.imperialCitadelTokens || { damage: 0\x2C block: 0\x2C hit: 0\x2C surge: 0\x2C evade: 0 };\n                for (const t of _icTokens) {\n                  const tLower = String(t).toLowerCase();\n                  game.imperialCitadelTokens[tLower] = (game.imperialCitadelTokens[tLower] || 0) + 1;\n                }\n                const _icCount = _icTokens.length;\n                delete game.figurePowerTokens[combat.target.figureKey];\n                await logGameAction(game\x2C client\x2C `**Imperial Citadel** \u2014 ${_icCount} Power Token${_icCount !== 1 ? 's' : ''} transferred from defeated **${_icDefDcName}** to the Citadel.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n              }\n            }\n          }\n        }\n        // Hunt Dissent \u2014 now handled by processFigureDefeat\n        // Into the Force (Obi-Wan): when defeated\x2C a friendly figure becomes Focused\n        if (_lsDcName === 'Obi-Wan Kenobi') {\n          const _obiAlive = Object.keys(game.figurePositions?.[defenderPlayerNum] || {}).filter(k => !k.startsWith('Obi-Wan Kenobi-'));\n          if (_obiAlive.length > 0) {\n            const _obiTarget = _obiAlive[0];\n            if (_applyCondition(game\x2C _obiTarget\x2C 'Focus')) {\n              const _obiName = dcNameFromFigureKey(_obiTarget);\n              await logGameAction(game\x2C client\x2C `\\u2728 **Into the Force** \u2014 **${_obiName}** becomes **Focused** (Obi-Wan was defeated).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n            }\n          }\n        }\n        // Vengeance (Royal Guard Regular): when adjacent friendly non-GUARDIAN defeated\x2C become Focused\n        {\n          const _defPos = _targetCoordBeforeDefeat;\n          if (_defPos) {\n            const _defDcEff = getDcEffects()?.[_lsDcName];\n            const _defKws = (_defDcEff?.keywords || []).map(k => k.toUpperCase());\n            const _defIsGuardian = _defKws.includes('GUARDIAN');\n            if (!_defIsGuardian) {\n              const _ms = getMapData(game.selectedMap?.id);\n              const _defAdj = (_ms?.adjacency?.[String(_defPos).toLowerCase()] || []).map(a => String(a).toLowerCase());\n              for (const [rgFk\x2C rgPos] of Object.entries(game.figurePositions?.[defenderPlayerNum] || {})) {\n                if (!rgPos || rgFk === combat.target.figureKey) continue;\n                if (!_defAdj.includes(String(rgPos).toLowerCase())) continue;\n                const rgDcName = dcNameFromFigureKey(rgFk);\n                if (rgDcName !== 'Royal Guard (Regular)' && rgDcName !== 'Royal Guard (Elite)') continue;\n                if (_applyCondition(game\x2C rgFk\x2C 'Focus')) {\n                  const vLabel = rgDcName === 'Royal Guard (Elite)' ? 'Forward Vengeance' : 'Vengeance';\n                  await logGameAction(game\x2C client\x2C `\\u2694\\uFE0F **${vLabel}** \u2014 **${rgDcName}** becomes **Focused** (adjacent friendly defeated).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n                }\n              }\n            }\n          }\n        }\n        // This is the Way (The Armorer): when attacker defeats defender\x2C attacker gains 1 Block Token\n        {\n          const _armorerOnBoard = Object.keys(game.figurePositions?.[attackerPlayerNum] || {}).some(fk => fk.startsWith('The Armorer-'));\n          if (_armorerOnBoard) {\n            const _armorerGranted = grantPowerTokens(game\x2C combat.attackerFigureKey\x2C 'Block'\x2C 1\x2C 2);\n            if (_armorerGranted > 0) {\n              await logGameAction(game\x2C client\x2C `\\u{1F6E1}\\uFE0F **This is the Way** \u2014 **${combat.attackerDcName}** gains 1 **Block Token** (defeated hostile).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n            }\n          }\n        }\n        // Bounty (Fennec Shand): when defeated\x2C opponent (= attacker) gains 2 VP\n        {\n          const _bountyDcName = _lsDcName;\n          const _bountyEff = getDcEffects()?.[_bountyDcName];\n          if ((_bountyEff?.passives || []).includes('Bounty')) {\n            awardObjectiveVp(game\x2C attackerPlayerNum\x2C 2);\n            const _bountyVpK2 = vpKey(attackerPlayerNum);\n            await logGameAction(game\x2C client\x2C `\\u{1F4B0} **Bounty** \u2014 **${_bountyDcName}** was defeated. Opponent (P${attackerPlayerNum}) gains **2 VP** (${game[_bountyVpK2].total} total).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n          }\n        }\n        // Brutal Tactics (Saw Gerrerra): when a hostile figure is defeated\x2C each hostile within 3 of that figure becomes Weakened\n        {\n          const _btPlayerNum = attackerPlayerNum; // attacker's side has Saw\n          const _btAllFigs = Object.keys(game.figurePositions?.[_btPlayerNum] || {});\n          const _btHasSaw = _btAllFigs.some(fk => {\n            const dcN = dcNameFromFigureKey(fk);\n            return (getDcEffects()?.[dcN]?.passives || []).includes('Brutal Tactics');\n          });\n          if (_btHasSaw) {\n            // defeated figure's position (use saved coord \u2014 figure already removed from figurePositions)\n            const _btDefPos = _targetCoordBeforeDefeat;\n            if (_btDefPos) {\n              const _btEnemyPos = game.figurePositions?.[defenderPlayerNum] || {};\n              let _btWeakened = 0;\n              for (const [fk\x2C pos] of Object.entries(_btEnemyPos)) {\n                if (!pos || fk === (combat.target.figureKey || '')) continue;\n                const dist = countGameSpaces(game\x2C _btDefPos\x2C pos);\n                if (dist <= 3) {\n                  if (isConditionImmune(game\x2C fk)) continue; // Condition Immunity: skip Weaken\n                  if (_applyCondition(game\x2C fk\x2C 'Weaken')) {\n                    _btWeakened++;\n                  }\n                }\n              }\n              if (_btWeakened > 0) {\n                await logGameAction(game\x2C client\x2C `\\u2694\\uFE0F **Brutal Tactics** \u2014 ${_btWeakened} hostile figure${_btWeakened !== 1 ? 's' : ''} within 3 spaces of the defeated figure became **Weakened**.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n              }\n            }\n          }\n        }\n        // Useful Hide (Tauntaun Rider): when defeated\x2C distribute up to 2 Evade Tokens among friendly figures within 3 spaces\n        if (_lsDcName === 'Tauntaun Rider') {\n          const _uhDefeatPos = combat._savedTargetPos;\n          const _uhFriendly = Object.entries(game.figurePositions?.[defenderPlayerNum] || {})\n            .filter(([k\x2C pos]) => k !== (combat.target.figureKey || '') && pos && _uhDefeatPos && countGameSpaces(game\x2C _uhDefeatPos\x2C pos) <= 3)\n            .map(([k]) => k);\n          if (_uhFriendly.length > 0) {\n            let _uhGranted = 0;\n            const _uhRecipients = [];\n            for (let _uhi = 0; _uhi < Math.min(2\x2C _uhFriendly.length); _uhi++) {\n              const _uhTarget = _uhFriendly[_uhi];\n              const count = grantPowerTokens(game\x2C _uhTarget\x2C 'Evade'\x2C 1\x2C 2);\n              if (count > 0) {\n                _uhGranted += count;\n                _uhRecipients.push(dcNameFromFigureKey(_uhTarget));\n              }\n            }\n            if (_uhGranted > 0) {\n              await logGameAction(game\x2C client\x2C `\\u{1F3AD} **Useful Hide** \u2014 **Tauntaun Rider** was defeated. Distributed ${_uhGranted} **Evade Token${_uhGranted !== 1 ? 's' : ''}** to ${_uhRecipients.join('\x2C ')}.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n            }\n          }\n        }\n        // Passive Redraws\x2C defeat log\x2C activation decrement\x2C CC attachment cleanup \u2014 now handled by processFigureDefeat\n        resultText += ` \u2014 **${combat.target.label} defeated!** +${vp} VP`;\n        // Clean up pending sub-states referencing this DC (prevents orphaned states after defeat)\n        if (targetMsgId) {\n          if (game.pendingDcAbilityChoice) {\n            for (const k of Object.keys(game.pendingDcAbilityChoice)) {\n              if (k.startsWith(`${targetMsgId}_`)) delete game.pendingDcAbilityChoice[k];\n            }\n            if (Object.keys(game.pendingDcAbilityChoice).length === 0) delete game.pendingDcAbilityChoice;\n          }\n          if (game.pendingPounceSpaceChoice?.[targetMsgId]) {\n            delete game.pendingPounceSpaceChoice[targetMsgId];\n            if (Object.keys(game.pendingPounceSpaceChoice).length === 0) delete game.pendingPounceSpaceChoice;\n          }\n        }\n        await checkWinConditions(game\x2C client);\n        // Celebration: after unique hostile defeated\x2C offer attacker a chance to play it\n        const defeatedDcName = idx >= 0 ? dcList[idx]?.dcName : null;\n        if (isDcUnique(defeatedDcName)) {\n          game.pendingCelebration = { attackerPlayerNum\x2C combatThreadId: combat.combatThreadId };\n          await thread.send(sanitizeMentions({\n            content: `<@${ownerId}> \u2014 You defeated a unique figure. Play **Celebration** to gain 4 VP?`\x2C\n            components: [getCelebrationButtons(game.gameId)]\x2C\n            allowedMentions: { users: [ownerId] }\x2C\n          })).catch(discordCatch);\n        }\n        // Auto-prompt for defeat-triggered reaction cards\n        try {\n          const ccCards = getCcEffectsData?.()?.cards || {};\n          const _defeatTimings = new Set([\n            'whenHostileFigureDefeatedNotYourActivation'\x2C\n            'whenHostileFigureWithin3SpacesDefeated'\x2C\n            'afterUniqueHostileDefeated'\x2C\n          ]);\n          const _ownDefeatTimings = new Set([\n            'whenOneOfYourFiguresDefeated'\x2C\n          ]);\n          // Notify attacker about hostile-defeat reactions in hand\n          const atkHand = getCcHand(game\x2C attackerPlayerNum) || [];\n          const atkDefeatCards = [...new Set(atkHand)].filter(c => ccCards[c]?.timing && _defeatTimings.has(ccCards[c].timing));\n          if (atkDefeatCards.length) {\n            await thread.send(sanitizeMentions({ content: `<@${ownerId}> \u2014 Hostile defeated! You have ${atkDefeatCards.length} reaction card(s) playable now. Check your Hand channel.`\x2C allowedMentions: { users: [ownerId] } })).catch(discordCatch);\n          }\n          // Notify defender about own-figure-defeat reactions in hand\n          const defId = getPlayerId(game\x2C defenderPlayerNum);\n          const defHand = getCcHand(game\x2C defenderPlayerNum) || [];\n          const defDefeatCards = [...new Set(defHand)].filter(c => ccCards[c]?.timing && _ownDefeatTimings.has(ccCards[c].timing));\n          if (defDefeatCards.length) {\n            await thread.send(sanitizeMentions({ content: `<@${defId}> \u2014 Your figure was defeated! You have ${defDefeatCards.length} reaction card(s) playable now. Check your Hand channel.`\x2C allowedMentions: { users: [defId] } })).catch(discordCatch);\n          }\n        } catch (_defeatPromptErr) {\n          console.error('Defeat reaction prompt error:'\x2C _defeatPromptErr?.message ?? _defeatPromptErr);\n        }\n      }\n    }\n    if (combat.superchargeStrainAfterAttackCount > 0 && combat.attackerMsgId != null) {\n      reduceHp(dcHealthState\x2C game\x2C combat.attackerMsgId\x2C combat.attackerFigureIndex ?? 0\x2C combat.superchargeStrainAfterAttackCount || 0\x2C combat.attackerPlayerNum);\n    }\n    // The Darksaber: convert Blast X \u2192 Cleave X during Darksaber Strike attack (before blast applies)\n    let effectiveBlast = totalBlast;\n    if (combat.darksaberBlastToCleave && (combat.surgeBlast || 0) > 0) {\n      combat.surgeCleave = (combat.surgeCleave || 0) + combat.surgeBlast;\n      const _dsConvertedBlast = combat.surgeBlast;\n      combat.surgeBlast = 0;\n      effectiveBlast = (combat.surgeBlast || 0) + (combat.bonusBlast || 0);\n      await logGameAction(game\x2C client\x2C `**The Darksaber** \u2014 Blast ${_dsConvertedBlast} converted to Cleave ${_dsConvertedBlast}.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n    }\n    // Flame Trooper attachment upgrades (for Blast Fireproof check below; also computed at function level for Incinerate)\n    const _ftAtkUpgradesBlast = combat.attackerMsgId ? (game.p1DcAttachments?.[combat.attackerMsgId] || game.p2DcAttachments?.[combat.attackerMsgId] || []) : [];\n    if (effectiveBlast > 0 && hit && damage > 0 && game.selectedMap?.id) {\n      // Wave 3: Use saved target coord (target may be defeated/removed from figurePositions by now)\n      const adjacent = _targetCoordBeforeDefeat\n        ? getFiguresAdjacentToCoord(game\x2C _targetCoordBeforeDefeat\x2C game.selectedMap.id\x2C combat.target.figureKey)\n        : [];\n      for (const { figureKey: blastFigureKey\x2C playerNum: blastPlayerNum } of adjacent) {\n        // Flame Trooper Fireproof: own Blast does not affect friendly figures\n        if (blastPlayerNum === attackerPlayerNum && _ftAtkUpgradesBlast.includes('Flame Trooper')) continue;\n        const blastMsgId = findDcMessageIdForFigure(game.gameId\x2C blastPlayerNum\x2C blastFigureKey);\n        if (!blastMsgId) continue;\n        const { figureIndex: blastFigIndex } = parseFigureKey(blastFigureKey);\n        const { newHp: newBCur\x2C wasDefeated: blastDefeated } = reduceHp(dcHealthState\x2C game\x2C blastMsgId\x2C blastFigIndex\x2C effectiveBlast\x2C blastPlayerNum);\n        const { dcList: blastDcList\x2C idx: blastIdx } = lookupFigureDcIndex(game\x2C blastPlayerNum\x2C blastFigureKey);\n        // Fury of Kashyyyk (army-wide): when a friendly WOOKIEE suffers 3+ damage\x2C become Focused\n        if (effectiveBlast >= 3 && newBCur > 0) {\n          const _fokBlastDcList = getDcList(game\x2C blastPlayerNum) || [];\n          if (_fokBlastDcList.some(dc => dc.dcName === '[Fury of Kashyyyk]')) {\n            const _fokBlastName = dcNameFromFigureKey(blastFigureKey);\n            const _fokBlastKws = (getDcKeywords(game)[_fokBlastName] || []).map(k => String(k).toUpperCase());\n            if (_fokBlastKws.includes('WOOKIEE')) {\n              if (_applyCondition(game\x2C blastFigureKey\x2C 'Focus')) {\n                await logGameAction(game\x2C client\x2C `**Fury of Kashyyyk** \u2014 **${_fokBlastName}** became **Focused** (suffered ${effectiveBlast} Blast Damage).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n              }\n            }\n          }\n        }\n        if (blastDefeated) {\n          const blastLabel = blastDcList[blastIdx]?.displayName || blastFigureKey;\n          const blastDcName = blastDcList[blastIdx]?.dcName;\n          const { vp } = await processFigureDefeat(game\x2C {\n            defeatedPlayerNum: blastPlayerNum\x2C\n            figureKey: blastFigureKey\x2C\n            attackerPlayerNum\x2C\n            attackerFigureKey: combat.attackerFigureKey\x2C\n            msgId: blastMsgId\x2C\n            dcIdx: blastIdx\x2C\n            dcName: blastDcName\x2C\n            displayName: blastLabel\x2C\n            source: 'Blast'\x2C\n          }\x2C { ...deps\x2C client });\n          // Achievement: count blast kills for activation streak\n          if (combat.attackerMsgId) {\n            game.activationKills = game.activationKills || {};\n            game.activationKills[combat.attackerMsgId] = (game.activationKills[combat.attackerMsgId] || 0) + 1;\n            if (isDbConfigured() && achievementsChannelId) {\n              const _akUserId2 = getPlayerId(game\x2C attackerPlayerNum);\n              checkAndPostAchievements(checkAndGrantAchievements\x2C postAchievementNotification\x2C client\x2C achievementsChannelId\x2C _akUserId2\x2C 'activation_kills'\x2C game.activationKills[combat.attackerMsgId])\n                .catch((err) => console.error('[Achievements] blast activation_kills check failed:'\x2C err.message));\n            }\n          }\n          // Celebration: prompt if unique figure defeated via Blast\n          if (!game.pendingCelebration && isDcUnique(blastDcName)) {\n            game.pendingCelebration = { attackerPlayerNum\x2C combatThreadId: combat.combatThreadId };\n            await thread.send(sanitizeMentions({\n              content: `<@${ownerId}> \u2014 You defeated a unique figure (Blast). Play **Celebration** to gain 4 VP?`\x2C\n              components: [getCelebrationButtons(game.gameId)]\x2C\n              allowedMentions: { users: [ownerId] }\x2C\n            })).catch(discordCatch);\n          }\n        }\n      }\n      // Wave 3: Blast also damages adjacent crates (objects)\n      if (_targetCoordBeforeDefeat && game.cratePositions) {\n        const _blastMapId = game.selectedMap.id;\n        const rawMapSpaces = getMapData(_blastMapId);\n        const adjacency = rawMapSpaces?.adjacency || {};\n        const _blastTargetNorm = String(_targetCoordBeforeDefeat).toLowerCase();\n        const _blastTargetAdj = new Set((adjacency[_blastTargetNorm] || []).map(c => String(c).toLowerCase()));\n        _blastTargetAdj.add(_blastTargetNorm);\n        for (const [origCoord\x2C curCoord] of Object.entries(game.cratePositions)) {\n          const crateNorm = String(curCoord).toLowerCase();\n          if (!_blastTargetAdj.has(crateNorm)) continue;\n          game.crateHealth = game.crateHealth || {};\n          if (typeof game.crateHealth[origCoord] !== 'number') game.crateHealth[origCoord] = 5;\n          game.crateHealth[origCoord] = Math.max(0\x2C game.crateHealth[origCoord] - effectiveBlast);\n          await logGameAction(game\x2C client\x2C `\\u{1F4A5} **Blast ${effectiveBlast}** \\u2014 Crate @ ${String(curCoord).toUpperCase()} suffers ${effectiveBlast} damage (${game.crateHealth[origCoord]}/5 HP).`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n          if (game.crateHealth[origCoord] <= 0) {\n            delete game.cratePositions[origCoord];\n            await logGameAction(game\x2C client\x2C `\\u{1F4A5} Crate at **${String(curCoord).toUpperCase()}** destroyed by Blast!`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n            await checkWinConditions(game\x2C client);\n          }\n        }\n      }\n    }\n  } else if (hit && damage === 0) {\n    await logGameAction(game\x2C client\x2C `<@${ownerId}> attacked **${combat.target.label}** \u2014 blocked`\x2C { allowedMentions: { users: [ownerId] }\x2C phase: 'ROUND'\x2C icon: 'attack' });\n  } else if (!hit) {\n    await logGameAction(game\x2C client\x2C `<@${ownerId}> attacked **${combat.target.label}** \u2014 miss`\x2C { allowedMentions: { users: [ownerId] }\x2C phase: 'ROUND'\x2C icon: 'attack' });\n  } else if (damage > 0) {\n    await logGameAction(game\x2C client\x2C `<@${ownerId}> dealt **${damage}** damage to **${combat.target.label}**`\x2C { allowedMentions: { users: [ownerId] }\x2C phase: 'ROUND'\x2C icon: 'attack' });\n  }\n  // Recover keyword: heal attacker even if attack dealt 0 damage (rules: RECOVER)\n  const _sbrBlockRecover = getDcEffects()?.[combat.attackerDcName]?.specialAbilityIds?.includes('sustained_by_rage');\n  if (combat.surgeRecover > 0 && combat.attackerMsgId != null && !_sbrBlockRecover) {\n    healHp(dcHealthState\x2C game\x2C combat.attackerMsgId\x2C combat.attackerFigureIndex ?? 0\x2C combat.surgeRecover || 0\x2C combat.attackerPlayerNum);\n  }\n  // Discard consumed conditions post-combat\n  if (combat.attackerFigureKey) {\n    const _hadFocus = (game.figureConditions?.[combat.attackerFigureKey] || []).includes('Focus');\n    filterCondition(game\x2C combat.attackerFigureKey\x2C 'Focus');  // Focus consumed after attacking\n    if (_hadFocus) await logGameAction(game\x2C client\x2C `\\u{1F3AF} **Focus** consumed on **${combat.attackerDcName}** \\u2014 used in this attack.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n    const _atkHidden = (game.figureConditions?.[combat.attackerFigureKey] || []).includes('Hide');\n    filterCondition(game\x2C combat.attackerFigureKey\x2C 'Hide');   // Attacker loses Hidden after resolving an attack\n    if (_atkHidden) await logGameAction(game\x2C client\x2C `\\uD83D\\uDC7B **Hidden** removed from **${combat.attackerDcName}** \\u2014 resolved an attack.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  }\n  if (combat.target?.figureKey) {\n    const _defHidden = (game.figureConditions?.[combat.target.figureKey] || []).includes('Hide');\n    filterCondition(game\x2C combat.target.figureKey\x2C 'Hide');    // Defender loses Hidden after being attacked\n    if (_defHidden) await logGameAction(game\x2C client\x2C `\\uD83D\\uDC7B **Hidden** removed from **${combat.target.label}** \\u2014 was targeted by an attack.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  }\n  // Burst Fire: apply Stun to all figures adjacent to target if target suffered damage\n  if (game.burstFirePendingMsgId?.[combat.attackerMsgId]) {\n    const _bfPending = game.burstFirePendingMsgId[combat.attackerMsgId];\n    delete game.burstFirePendingMsgId[combat.attackerMsgId];\n    if (damage > 0 && combat.target?.figureKey) {\n      const _bfMapId = game.selectedMap?.id;\n      const _bfMs = _bfMapId ? getMapData(_bfMapId) : null;\n      const _bfTargetPos = game.figurePositions?.[defenderPlayerNum]?.[combat.target.figureKey];\n      if (_bfMs && _bfTargetPos) {\n        // Collect all spaces adjacent to the target's footprint (handles multi-space figures)\n        const _bfTargetDcName = dcNameFromFigureKey(combat.target.figureKey);\n        const _bfTargetSize = getFigureSize(_bfTargetDcName) || '1x1';\n        const _bfTargetCells = getFootprintCells(_bfTargetPos\x2C _bfTargetSize);\n        const _bfAdjSet = new Set();\n        for (const _bfCell of _bfTargetCells) {\n          for (const _bfA of (_bfMs.adjacency?.[_bfCell] || [])) _bfAdjSet.add(_bfA);\n        }\n        // Remove the target's own cells from adjacency\n        for (const _bfCell of _bfTargetCells) _bfAdjSet.delete(_bfCell);\n        for (const _bfPn of [1\x2C 2]) {\n          for (const [_bfFk\x2C _bfPos] of Object.entries(game.figurePositions?.[_bfPn] || {})) {\n            // Check if any cell of this figure's footprint is adjacent to the target\n            const _bfFkDcName = dcNameFromFigureKey(_bfFk);\n            const _bfFkSize = getFigureSize(_bfFkDcName) || '1x1';\n            const _bfFkCells = getFootprintCells(_bfPos\x2C _bfFkSize);\n            if (!_bfFkCells.some(c => _bfAdjSet.has(c))) continue;\n            if (_bfFk === combat.target.figureKey) continue;\n            if (isConditionImmune(game\x2C _bfFk)) continue; // Condition Immunity: skip Stun\n            if (_applyCondition(game\x2C _bfFk\x2C 'Stun')) {\n              const _bfDcName = dcNameFromFigureKey(_bfFk);\n              await logGameAction(game\x2C client\x2C `\\uD83D\\uDCA5 **Burst Fire** \\u2014 **${_bfDcName}** (adjacent) is now **Stunned**.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n            }\n          }\n        }\n      }\n    }\n  }\n  // Crippling Blow: Stun defender if attack didn't miss\n  if (game.cripplingBlowPending?.[combat.attackerMsgId]) {\n    delete game.cripplingBlowPending[combat.attackerMsgId];\n    if (hit && combat.target?.figureKey) {\n      if (!isConditionImmune(game\x2C combat.target.figureKey)) {\n        if (_applyCondition(game\x2C combat.target.figureKey\x2C 'Stun')) {\n          await logGameAction(game\x2C client\x2C `\\u26A1 **Crippling Blow** \u2014 **${combat.target.label || dcNameFromFigureKey(combat.target.figureKey)}** is now **Stunned**.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n        }\n      } else {\n        await logGameAction(game\x2C client\x2C `**Crippling Blow** \u2014 **${combat.target.label || dcNameFromFigureKey(combat.target.figureKey)}** is immune to Stun.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n      }\n    }\n  }\n  // Disruptor Rifle: if attack didn't miss and defender at exactly 1 HP\x2C deal 1 more damage\n  if (game.disruptorRiflePending?.[combat.attackerMsgId]) {\n    delete game.disruptorRiflePending[combat.attackerMsgId];\n    if (hit && targetMsgId) {\n      const _drHS = dcHealthState.get(targetMsgId) || [];\n      const _drEntry = _drHS[targetFigIndex];\n      if (_drEntry) {\n        const [_drCur] = _drEntry;\n        if (_drCur === 1) {\n          reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C targetFigIndex\x2C 1\x2C defenderPlayerNum);\n          await logGameAction(game\x2C client\x2C `\\u{1F480} **Disruptor Rifle** \u2014 **${combat.target?.label || ''}** had 1 HP remaining \u2014 suffers 1 additional Damage and is **defeated**.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n          // Process defeat through canonical pipeline\n          const { idx: _drIdx } = lookupFigureDcIndex(game\x2C defenderPlayerNum\x2C combat.target.figureKey);\n          await processFigureDefeat(game\x2C {\n            defeatedPlayerNum: defenderPlayerNum\x2C\n            figureKey: combat.target.figureKey\x2C\n            attackerPlayerNum\x2C\n            attackerFigureKey: combat.attackerFigureKey\x2C\n            msgId: targetMsgId\x2C\n            dcIdx: _drIdx\x2C\n            dcName: targetDcName\x2C\n            displayName: combat.target.label\x2C\n            source: 'Disruptor Rifle'\x2C\n          }\x2C { ...deps\x2C client });\n        }\n      }\n    }\n  }\n  // Tonfa Strike: grant second free attack after first resolves\n  if (game.tonfaStrikeSecondAttack?.[combat.attackerMsgId]) {\n    delete game.tonfaStrikeSecondAttack[combat.attackerMsgId];\n    game.freeAttackBonusPending = game.freeAttackBonusPending || {};\n    game.freeAttackBonusPending[combat.attackerMsgId] = true;\n    await thread.send('**Tonfa Strike** \u2014 You may perform an additional attack (use Attack button).');\n  }\n  // Barrage (CT-1701): after first attack resolves\x2C grant second free attack (defender +1 white die\x2C within 3 of first target)\n  if (game.barrageSecondAttack?.[combat.attackerMsgId]) {\n    delete game.barrageSecondAttack[combat.attackerMsgId];\n    game.freeAttackBonusPending = game.freeAttackBonusPending || {};\n    game.freeAttackBonusPending[combat.attackerMsgId] = true;\n    // Store first target's position so second attack target must be within 3 spaces\n    const _barrageTargetPos = game.figurePositions?.[defenderPlayerNum]?.[combat.target?.figureKey];\n    if (_barrageTargetPos) {\n      game.barrageTargetSpace = game.barrageTargetSpace || {};\n      game.barrageTargetSpace[combat.attackerMsgId] = _barrageTargetPos;\n    }\n    // Mark that the next attack from this figure adds 1 white die to defense pool\n    game.barrageDefenseBonus = game.barrageDefenseBonus || {};\n    game.barrageDefenseBonus[combat.attackerMsgId] = true;\n    await thread.send('**Barrage** \u2014 You may perform a second attack (target within 3 of first target\x2C defender +1 white die). Use the **Attack** button.');\n  }\n  // Imperial Loadout post-attack effects\n  if (combat.loadoutPostAttack) {\n    const _lpa = combat.loadoutPostAttack;\n    // Electro-pulse (Electrohammer): each other figure adjacent to target suffers 1 Damage\n    if (_lpa === 'electro_pulse' && combat.target?.figureKey) {\n      const _epTargetPos = game.figurePositions?.[defenderPlayerNum]?.[combat.target.figureKey];\n      if (_epTargetPos) {\n        const _epLines = [];\n        for (const [pNum\x2C poses] of [[1\x2C game.figurePositions?.[1] || {}]\x2C [2\x2C game.figurePositions?.[2] || {}]]) {\n          for (const [fk\x2C pos] of Object.entries(poses)) {\n            // Exclude the target itself \u2014 figureKey alone isn't unique across\n            // players since the same dcName can appear on both sides.\n            if (pNum === defenderPlayerNum && fk === combat.target.figureKey) continue;\n            if (countGameSpaces(game\x2C pos\x2C _epTargetPos) !== 1) continue;\n            const _epFkDcName = dcNameFromFigureKey(fk);\n            const _epMid = getDcMessageIds(game\x2C pNum) || [];\n            const _epDcL = getDcList(game\x2C pNum);\n            const { dgIndex: _epDgIdx\x2C figureIndex: _epFigIdx } = parseFigureKey(fk);\n            const _epMsgId = _epMid.find((mid\x2C idx) => _epDcL?.[idx]?.dcName === _epFkDcName && _epDcL?.[idx]?.dgIndex === _epDgIdx);\n            if (_epMsgId) {\n              reduceHp(dcHealthState\x2C game\x2C _epMsgId\x2C _epFigIdx\x2C 1\x2C pNum);\n            }\n            _epLines.push(`**${_epFkDcName}** suffers 1 Damage`);\n          }\n        }\n        if (_epLines.length > 0) {\n          await logGameAction(game\x2C client\x2C `\\u26A1 **Electro-pulse** \u2014 Adjacent figures:\\n${_epLines.join('\\n')}`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n        }\n      }\n    }\n    // Quick Strike (Electrostaff): if defender rerolled/modified dice\x2C defender suffers 1 Damage\n    if (_lpa === 'quick_strike' && hit && combat.target?.figureKey && targetMsgId) {\n      const _qsModified = combat.defenderRerolledOrModified;\n      if (_qsModified) {\n        reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C targetFigIndex\x2C 1\x2C defenderPlayerNum);\n        await logGameAction(game\x2C client\x2C `\\u26A1 **Quick Strike** \u2014 Defender modified dice/results: **${combat.target.label}** suffers 1 Damage.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n      }\n    }\n    // Flurry of Blows (Electrobatons): free melee attack with 1 green die + +1 Hit\x2C limit once per activation\n    if (_lpa === 'flurry_of_blows' && hit && combat.attackerMsgId) {\n      const _fobKey = `flurryOfBlows_${combat.attackerMsgId}`;\n      if (!game.roundFigureAbilityUsed?.[_fobKey]) {\n        if (!game.roundFigureAbilityUsed) game.roundFigureAbilityUsed = {};\n        game.roundFigureAbilityUsed[_fobKey] = true;\n        game.freeAttackBonusPending = game.freeAttackBonusPending || {};\n        game.freeAttackBonusPending[combat.attackerMsgId] = true;\n        game.pendingOverrideAttackDice = game.pendingOverrideAttackDice || {};\n        game.pendingOverrideAttackDice[combat.attackerMsgId] = { dice: ['green']\x2C type: 'melee'\x2C bonusHits: 1 };\n        await thread.send('**Flurry of Blows** \u2014 You may perform a Melee attack using 1 green die (+1 Hit). Use the Attack button.');\n      }\n    }\n  }\n  // Clawdite Streetrat Assassin's Blade post-attack: choose an adjacent hostile\x2C roll 1 red die\x2C deal Hits\n  if (combat.formPostAttack === 'assassins_blade' && combat.attackerFigureKey) {\n    const _abAttackerPos = game.figurePositions?.[attackerPlayerNum]?.[combat.attackerFigureKey];\n    if (_abAttackerPos) {\n      // Find adjacent hostile figures\n      const _abAdjacentHostiles = [];\n      for (const [_abFk\x2C _abPos] of Object.entries(game.figurePositions?.[defenderPlayerNum] || {})) {\n        if (!_abPos) continue;\n        if (countGameSpaces(game\x2C _abAttackerPos\x2C _abPos) === 1) _abAdjacentHostiles.push({ fk: _abFk\x2C pos: _abPos });\n      }\n      if (_abAdjacentHostiles.length === 0) {\n        await thread.send(`\\u{1F5E1}\\uFE0F **Assassin's Blade** \u2014 No adjacent hostile figures.`).catch(discordCatch);\n      } else {\n        const _abDiceData = getDiceData();\n        const _abRedFaces = _abDiceData?.attack?.red || [];\n        if (_abRedFaces.length > 0) {\n          const _abRoll = _abRedFaces[Math.floor(Math.random() * _abRedFaces.length)];\n          const _abHits = (_abRoll.damage || 0);\n          const _abRollStr = Object.entries(_abRoll).filter(([k\x2Cv]) => v > 0 && k !== 'blank').map(([k\x2Cv]) => `${v} ${k}`).join('\x2C ') || 'blank';\n          if (_abAdjacentHostiles.length === 1 && _abHits > 0) {\n            // Auto-apply to the only adjacent hostile\n            const { fk: _abFk2 } = _abAdjacentHostiles[0];\n            const _abDcName = dcNameFromFigureKey(_abFk2);\n            for (const [_abMsgId\x2C _abMeta] of dcMessageMeta) {\n              if (_abMeta.gameId !== game.gameId || _abMeta.playerNum !== defenderPlayerNum || _abMeta.dcName !== _abDcName) continue;\n              const _abFigIdx = parseFigureKey(_abFk2).figureIndex;\n              reduceHp(dcHealthState\x2C game\x2C _abMsgId\x2C _abFigIdx\x2C _abHits\x2C defenderPlayerNum);\n              break;\n            }\n            await thread.send(`\\u{1F5E1}\\uFE0F **Assassin's Blade** \u2014 Rolled 1 red die: **${_abRollStr}**. **${_abDcName}** suffers **${_abHits} Damage**.`).catch(discordCatch);\n            await logGameAction(game\x2C client\x2C `\\u{1F5E1}\\uFE0F **Assassin's Blade** \u2014 **${_abDcName}** suffers **${_abHits} Damage**.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n          } else if (_abHits > 0) {\n            // Multiple adjacent hostiles \u2014 show picker buttons\n            game.pendingAssassinsBlade = { hits: _abHits\x2C rollStr: _abRollStr\x2C defenderPlayerNum\x2C attackerPlayerNum };\n            const _abBtns = _abAdjacentHostiles.map(({ fk }) => {\n              const name = dcNameFromFigureKey(fk);\n              return new ButtonBuilder()\n                .setCustomId(`ab_blade_pick_${game.gameId}_${fk}`)\n                .setLabel(name)\n                .setStyle(ButtonStyle.Danger);\n            });\n            const _abRows = [];\n            for (let _r = 0; _r < _abBtns.length; _r += 5) _abRows.push(new ActionRowBuilder().addComponents(_abBtns.slice(_r\x2C _r + 5)));\n            await thread.send({ content: `\\u{1F5E1}\\uFE0F **Assassin's Blade** \u2014 Rolled 1 red die: **${_abRollStr}** (${_abHits} Damage). Choose an adjacent hostile figure:`\x2C components: _abRows }).catch(discordCatch);\n          } else {\n            await thread.send(`\\u{1F5E1}\\uFE0F **Assassin's Blade** \u2014 Rolled 1 red die: **${_abRollStr}**. No hits.`).catch(discordCatch);\n          }\n        }\n      }\n    }\n  }\n  // Suppressive Fire (Skirmish Upgrade): exhaust after Ranged attack \u2192 Weaken target + 2 MP to SMALL friendly within 3\n  const _sfUpgrades = combat.attackerMsgId ? (game.p1DcAttachments?.[combat.attackerMsgId] || game.p2DcAttachments?.[combat.attackerMsgId] || []) : [];\n  const _sfExh = game.exhaustedSkirmishUpgrades?.[combat.attackerMsgId] || [];\n  if (cardNameIncludes(_sfUpgrades\x2C 'Suppressive Fire') && !cardNameIncludes(_sfExh\x2C 'Suppressive Fire') && combat.isRanged && damage > 0) {\n    game.exhaustedSkirmishUpgrades = game.exhaustedSkirmishUpgrades || {};\n    game.exhaustedSkirmishUpgrades[combat.attackerMsgId] = [..._sfExh\x2C 'Suppressive Fire'];\n    // Apply Weaken to the target\n    const _sfTargetFk = combat.target?.figureKey;\n    if (_sfTargetFk && !isConditionImmune(game\x2C _sfTargetFk)) {\n      _applyCondition(game\x2C _sfTargetFk\x2C 'Weaken');\n    }\n    const _sfTargetName = dcNameFromFigureKey(combat.target?.figureKey) || combat.defenderDcName;\n    // Find SMALL friendly figures within 3 spaces of attacker for MP grant\n    const _sfAttackerPos = game.figurePositions?.[attackerPlayerNum]?.[combat.attackerFigureKey];\n    const _sfSmallFriendlies = [];\n    if (_sfAttackerPos) {\n      const _sfEffects = getDcEffects();\n      for (const [_sfFk\x2C _sfPos] of Object.entries(game.figurePositions?.[attackerPlayerNum] || {})) {\n        if (!_sfPos || _sfFk === combat.attackerFigureKey) continue;\n        if (countGameSpaces(game\x2C _sfAttackerPos\x2C _sfPos) > 3) continue;\n        // SMALL check: skip LARGE and MASSIVE figures\n        const _sfDcName = dcNameFromFigureKey(_sfFk);\n        const _sfKwds = (_sfEffects[_sfDcName]?.keywords || []).map(k => String(k).toUpperCase());\n        if (_sfKwds.includes('LARGE') || _sfKwds.includes('MASSIVE')) continue;\n        // Find msgId for this figure's DC\n        const _sfFigMsgId = findDcMessageIdForFigure(game.gameId\x2C attackerPlayerNum\x2C _sfFk);\n        if (_sfFigMsgId) _sfSmallFriendlies.push({ fk: _sfFk\x2C msgId: _sfFigMsgId\x2C dcName: _sfDcName });\n      }\n    }\n    if (_sfSmallFriendlies.length === 1) {\n      // Auto-grant 2 MP to the only eligible friendly\n      const _sfF = _sfSmallFriendlies[0];\n      grantMovementBank(game\x2C _sfF.msgId\x2C 2);\n      await thread.send(`**Suppressive Fire** \u2014 Exhausted: **${_sfTargetName}** becomes Weakened. **${_sfF.dcName}** gains **2 MP**.`).catch(discordCatch);\n      await logGameAction(game\x2C client\x2C `**Suppressive Fire** \u2014 **${_sfTargetName}** Weakened; **${_sfF.dcName}** gains 2 MP.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n    } else if (_sfSmallFriendlies.length > 1) {\n      // Show picker buttons\n      game.pendingSuppressiveFireMp = { attackerPlayerNum };\n      const _sfBtns = _sfSmallFriendlies.map(({ fk\x2C dcName }) =>\n        new ButtonBuilder().setCustomId(`sf_mp_pick_${game.gameId}_${fk}`).setLabel(dcName).setStyle(ButtonStyle.Primary)\n      );\n      const _sfRows = [];\n      for (let _r = 0; _r < _sfBtns.length; _r += 5) _sfRows.push(new ActionRowBuilder().addComponents(_sfBtns.slice(_r\x2C _r + 5)));\n      await thread.send({ content: `**Suppressive Fire** \u2014 Exhausted: **${_sfTargetName}** becomes Weakened. Choose a SMALL friendly figure within 3 spaces to gain 2 MP:`\x2C components: _sfRows }).catch(discordCatch);\n      await logGameAction(game\x2C client\x2C `**Suppressive Fire** \u2014 **${_sfTargetName}** Weakened after Ranged attack.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n    } else {\n      await thread.send(`**Suppressive Fire** \u2014 Exhausted: **${_sfTargetName}** becomes Weakened. No eligible SMALL friendly figures within 3 spaces for MP grant.`).catch(discordCatch);\n      await logGameAction(game\x2C client\x2C `**Suppressive Fire** \u2014 **${_sfTargetName}** Weakened after Ranged attack.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n    }\n  }\n  // Flame Trooper Incinerate: after attacking\x2C each figure that suffered damage suffers 1 Strain (HP loss). Place Rubble in target space.\n  const _ftAtkUpgrades = combat.attackerMsgId ? (game.p1DcAttachments?.[combat.attackerMsgId] || game.p2DcAttachments?.[combat.attackerMsgId] || []) : [];\n  const _ftBlastRefreshMsgIds = [];\n  if (cardNameIncludes(_ftAtkUpgrades\x2C 'Flame Trooper') && hit) {\n    // Apply 1 Strain (1 HP loss) to target if it suffered damage and survived\n    if (damage > 0 && targetMsgId) {\n      // Fireproof: target immune to Strain if it also has Flame Trooper attachment\n      const _ftTargetUpgrades = game.p1DcAttachments?.[targetMsgId] || game.p2DcAttachments?.[targetMsgId] || [];\n      if (cardNameIncludes(_ftTargetUpgrades\x2C 'Flame Trooper')) {\n        await thread.send('**Incinerate** \u2014 Target is **Fireproof**\x2C immune to Strain.').catch(discordCatch);\n      } else {\n        const _ftHsBefore = dcHealthState.get(targetMsgId);\n        if (_ftHsBefore?.[targetFigIndex]?.[0] > 0) {\n            const { newHp: _ftNew\x2C wasDefeated: _ftDefeated } = reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C targetFigIndex\x2C 1\x2C defenderPlayerNum);\n            await thread.send(`**Incinerate** \u2014 **${combat.target.label}** suffers 1 Strain (1 HP damage).`).catch(discordCatch);\n            if (_ftDefeated || _ftNew <= 0) {\n              const { idx: _ftIdx } = lookupFigureDcIndex(game\x2C defenderPlayerNum\x2C combat.target.figureKey);\n              await processFigureDefeat(game\x2C {\n                defeatedPlayerNum: defenderPlayerNum\x2C\n                figureKey: combat.target.figureKey\x2C\n                attackerPlayerNum\x2C\n                attackerFigureKey: combat.attackerFigureKey\x2C\n                msgId: targetMsgId\x2C\n                dcIdx: _ftIdx\x2C\n                dcName: combat.defenderDcName\x2C\n                source: 'Incinerate'\x2C\n              }\x2C deps);\n            }\n        }\n      }\n    }\n    // Blast damage also triggers Incinerate Strain on adjacent damaged figures \u2014 auto-apply\n    if (effectiveBlast > 0 && game.selectedMap?.id) {\n      const _ftBlastAdj = _targetCoordBeforeDefeat\n        ? getFiguresAdjacentToCoord(game\x2C _targetCoordBeforeDefeat\x2C game.selectedMap.id\x2C combat.target.figureKey)\n        : [];\n      for (const { figureKey: _ftBlastFk\x2C playerNum: _ftBlastPn } of _ftBlastAdj) {\n        // Fireproof: skip friendly figures with Flame Trooper attachment\n        if (_ftBlastPn === attackerPlayerNum && cardNameIncludes(_ftAtkUpgrades\x2C 'Flame Trooper')) continue;\n        const _ftBlastMsgId = findDcMessageIdForFigure(game.gameId\x2C _ftBlastPn\x2C _ftBlastFk);\n        if (!_ftBlastMsgId) continue;\n        // Fireproof: target immune to Strain if it also has Flame Trooper attachment\n        const _ftBlastUpgrades = game.p1DcAttachments?.[_ftBlastMsgId] || game.p2DcAttachments?.[_ftBlastMsgId] || [];\n        if (cardNameIncludes(_ftBlastUpgrades\x2C 'Flame Trooper')) continue;\n        const { figureIndex: _ftBlastFigIdx } = parseFigureKey(_ftBlastFk);\n        const _ftBlastHsBefore = dcHealthState.get(_ftBlastMsgId);\n        if (!_ftBlastHsBefore?.[_ftBlastFigIdx] || _ftBlastHsBefore[_ftBlastFigIdx][0] <= 0) continue;\n        const { newHp: _ftBlastNew\x2C wasDefeated: _ftBlastDied } = reduceHp(dcHealthState\x2C game\x2C _ftBlastMsgId\x2C _ftBlastFigIdx\x2C 1\x2C _ftBlastPn);\n        const _ftBlastName = dcNameFromFigureKey(_ftBlastFk);\n        await thread.send(`**Incinerate** \u2014 **${_ftBlastName}** suffers 1 Strain from Blast.`).catch(discordCatch);\n        _ftBlastRefreshMsgIds.push(_ftBlastMsgId);\n        if (_ftBlastDied || _ftBlastNew <= 0) {\n          const _ftBlastVpRecipient = _ftBlastPn === attackerPlayerNum ? defenderPlayerNum : attackerPlayerNum;\n          const { idx: _ftBlastIdx } = lookupFigureDcIndex(game\x2C _ftBlastPn\x2C _ftBlastFk);\n          await processFigureDefeat(game\x2C {\n            defeatedPlayerNum: _ftBlastPn\x2C\n            figureKey: _ftBlastFk\x2C\n            attackerPlayerNum: _ftBlastVpRecipient\x2C\n            attackerFigureKey: combat.attackerFigureKey\x2C\n            msgId: _ftBlastMsgId\x2C\n            dcIdx: _ftBlastIdx\x2C\n            dcName: _ftBlastName\x2C\n            source: 'Incinerate (Blast)'\x2C\n          }\x2C deps);\n        }\n      }\n    }\n    // Place Rubble token in target space (if attack didn't miss)\n    if (combat.target?.figureKey) {\n      const _ftTargetPos = game.figurePositions?.[defenderPlayerNum]?.[combat.target.figureKey];\n      if (_ftTargetPos) {\n        game.rubbleTokens = game.rubbleTokens || [];\n        const _ftCoord = String(_ftTargetPos).toLowerCase();\n        if (!game.rubbleTokens.includes(_ftCoord)) {\n          game.rubbleTokens.push(_ftCoord);\n        }\n        await thread.send(`**Incinerate** \u2014 Rubble token placed at **${String(_ftTargetPos).toUpperCase()}**.`).catch(discordCatch);\n      }\n    }\n  }\n\n  const embedRefreshMsgIds = new Set(damage > 0 && targetMsgId ? [targetMsgId] : []);\n  if (combat.surgeRecover > 0 && combat.attackerMsgId != null) embedRefreshMsgIds.add(combat.attackerMsgId);\n  // Force Deflection embed refresh (flag set earlier in pre-defeat section)\n  if (_fdNeedsEmbedRefresh && combat.attackerMsgId) embedRefreshMsgIds.add(combat.attackerMsgId);\n  // Incinerate Blast Strain embed refreshes (collected earlier)\n  if (_ftBlastRefreshMsgIds?.length) for (const _mid of _ftBlastRefreshMsgIds) embedRefreshMsgIds.add(_mid);\n\n  // Concentrated Fire: apply Stun to the attacker figure after attack resolves\n  if (game.applySelfStunAfterAttackPlayerNum?.[attackerPlayerNum] && combat.attackerMsgId) {\n    delete game.applySelfStunAfterAttackPlayerNum[attackerPlayerNum];\n    const _cfaFigKey = combat.attackerFigureKey;\n    if (_cfaFigKey && !isConditionImmune(game\x2C _cfaFigKey)) {\n      if (_applyCondition(game\x2C _cfaFigKey\x2C 'Stun')) {\n        const _cfaDcName = dcNameFromFigureKey(_cfaFigKey);\n        await logGameAction(game\x2C client\x2C `**Concentrated Fire** \u2014 **${_cfaDcName}** is now **Stunned**.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n        embedRefreshMsgIds.add(combat.attackerMsgId);\n      }\n    }\n  }\n  // Wild Fury: after final free attack\x2C apply postActivationConditions (Stun + Bleed) to attacker figure\n  if (game.pendingPostAttackConditions?.[combat.attackerMsgId] && combat.attackerFigureKey) {\n    let _ppaConditions = game.pendingPostAttackConditions[combat.attackerMsgId];\n    delete game.pendingPostAttackConditions[combat.attackerMsgId];\n    if (Array.isArray(_ppaConditions) && _ppaConditions.length > 0) {\n      // Condition Immunity: filter out harmful conditions for immune figures\n      if (isConditionImmune(game\x2C combat.attackerFigureKey)) {\n        _ppaConditions = _ppaConditions.filter((c) => !HARMFUL_CONDITIONS.includes(c));\n      }\n      if (_ppaConditions.length > 0) {\n        for (const _ppaC of _ppaConditions) {\n          _applyCondition(game\x2C combat.attackerFigureKey\x2C _ppaC);\n        }\n        const _ppaDcName = dcNameFromFigureKey(combat.attackerFigureKey);\n        await logGameAction(game\x2C client\x2C `**Wild Fury** \u2014 **${_ppaDcName}** is now **${_ppaConditions.join(' + ')}**.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n        embedRefreshMsgIds.add(combat.attackerMsgId);\n      }\n    }\n  }\n  // Dying Lunge / Final Stand: attacker defeats itself after the attack resolves\n  if (game.selfDefeatsAfterAttackMsgId?.[combat.attackerMsgId] && combat.attackerMsgId) {\n    delete game.selfDefeatsAfterAttackMsgId[combat.attackerMsgId];\n    const _sdaMsgId = combat.attackerMsgId;\n    const _sdaFigKey = combat.attackerFigureKey;\n    const _sdaFigIdx = combat.attackerFigureIndex ?? 0;\n    if (_sdaFigKey) {\n      const _sdaPrevHs = dcHealthState.get(_sdaMsgId);\n      if (_sdaPrevHs?.[_sdaFigIdx]) {\n        const _sdaMaxHp = _sdaPrevHs[_sdaFigIdx][1] ?? _sdaPrevHs[_sdaFigIdx][0] ?? 99;\n        reduceHp(dcHealthState\x2C game\x2C _sdaMsgId\x2C _sdaFigIdx\x2C _sdaMaxHp\x2C attackerPlayerNum);\n        const _sdaDcIds = getDcMessageIds(game\x2C attackerPlayerNum);\n        const _sdaIdx = (_sdaDcIds || []).indexOf(_sdaMsgId);\n        embedRefreshMsgIds.add(_sdaMsgId);\n        await processFigureDefeat(game\x2C {\n          defeatedPlayerNum: attackerPlayerNum\x2C\n          figureKey: _sdaFigKey\x2C\n          attackerPlayerNum: defenderPlayerNum\x2C\n          msgId: _sdaMsgId\x2C\n          dcIdx: _sdaIdx\x2C\n          dcName: combat.attackerDcName\x2C\n          source: 'Dying Lunge'\x2C\n        }\x2C deps);\n      }\n    }\n  }\n\n  // --- Named surge post-combat effects ---\n  if (hit && targetMsgId) {\n    // Harass: defender suffers N Strain after a non-miss\n    if ((combat.surgeHarass || 0) > 0) {\n      reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C targetFigIndex\x2C combat.surgeHarass\x2C defenderPlayerNum);\n      embedRefreshMsgIds.add(targetMsgId);\n      await logGameAction(game\x2C client\x2C `**Harass** \u2014 **${combat.target.label}** suffers **${combat.surgeHarass}** Strain`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n    }\n    // Suppression: target suffers Strain = min(block + evade + [1 if dodge]\x2C 2)\n    if (combat.surgeSuppressionStrain) {\n      const supRoll = combat.defenseRoll || {};\n      const supAmt = Math.min((supRoll.block || 0) + (supRoll.evade || 0) + (supRoll.dodge ? 1 : 0)\x2C 2);\n      if (supAmt > 0) {\n        reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C targetFigIndex\x2C supAmt\x2C defenderPlayerNum);\n        embedRefreshMsgIds.add(targetMsgId);\n        await logGameAction(game\x2C client\x2C `**Suppression** \u2014 **${combat.target.label}** suffers **${supAmt}** Strain (${supRoll.block || 0} block\x2C ${supRoll.evade || 0} evade${supRoll.dodge ? '\x2C 1 dodge' : ''})`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n      }\n    }\n  }\n  // Mandalorian Steel: if defender spent a Block Token this attack\x2C recover 1 Damage on the defending figure\n  if (combat.defenderSpentBlock && game.mandaAsteelPlayerNum === defenderPlayerNum && targetMsgId) {\n    const { healed } = healHp(dcHealthState\x2C game\x2C targetMsgId\x2C targetFigIndex\x2C 1\x2C defenderPlayerNum);\n    if (healed > 0) {\n      embedRefreshMsgIds.add(targetMsgId);\n      await logGameAction(game\x2C client\x2C `**Mandalorian Steel** \u2014 **${combat.target.label}** spent a Block Token; recovered 1 Damage`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n    }\n  }\n\n  // Stalk Prey: attacker gains +2 MP and +1 Damage Token after attack resolves\n  if (hit && combat.surgeStalkPrey && combat.attackerMsgId) {\n    game.movementBank = game.movementBank || {};\n    const spBank = game.movementBank[combat.attackerMsgId] || { total: 0\x2C remaining: 0 };\n    spBank.total = (spBank.total ?? 0) + 2;\n    spBank.remaining = (spBank.remaining ?? 0) + 2;\n    game.movementBank[combat.attackerMsgId] = spBank;\n    grantPowerTokens(game\x2C combat.attackerFigureKey\x2C 'Damage'\x2C 1);\n    await logGameAction(game\x2C client\x2C `**Stalk Prey** \u2014 **${combat.attackerDcName}** gained +2 MP and +1 Damage Token`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n    await deps.ensureMovementBankMessage(game\x2C combat.attackerMsgId\x2C client);\n    embedRefreshMsgIds.add(combat.attackerMsgId);\n    delete combat.surgeStalkPrey;\n  }\n  // Squad Command: Focus an adjacent friendly TROOPER\n  if (hit && combat.surgeSquadCommand && game.selectedMap?.id && combat.attackerFigureKey) {\n    const sqAdj = getFiguresAdjacentToTarget(game\x2C combat.attackerFigureKey\x2C game.selectedMap.id);\n    for (const { figureKey: sqFk\x2C playerNum: sqPn } of sqAdj) {\n      if (sqPn !== attackerPlayerNum) continue;\n      const sqDcName = dcNameFromFigureKey(sqFk);\n      const sqEff = getDcEffect(sqDcName);\n      const sqKws = (sqEff?.keywords || []).map((k) => String(k).toUpperCase());\n      if (!sqKws.includes('TROOPER')) continue;\n      if (_applyCondition(game\x2C sqFk\x2C 'Focus')) {\n        const sqMsgId = findDcMessageIdForFigure(game.gameId\x2C sqPn\x2C sqFk);\n        if (sqMsgId) embedRefreshMsgIds.add(sqMsgId);\n        await logGameAction(game\x2C client\x2C `**Squad Command** \u2014 **${sqDcName}** is now **Focused**`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n      }\n    }\n  }\n\n  // Bleed: attacker prompted to take 1 damage or prevent by discarding CC after Attack action\n  // (skipped if player spent a surge to prevent Bleed during the surge window)\n  // I30 Fireproof: attacker with Flame Trooper cannot be Bleeding\n  if (combat.attackerConds?.includes('Bleed') && !combat.surgePreventBleed && !combat.attackerFireproof) {\n    const bleedThread = await fetchCombatThread(client\x2C combat.combatThreadId);\n    await deps.sendBleedingPrompt(game\x2C bleedThread\x2C combat.attackerFigureKey\x2C combat.attackerPlayerNum\x2C combat.attackerDisplayName);\n  }\n  // Deflection: after attack resolves\x2C attacker suffers N damage\n  // unconditional = always fires after attack; conditional (legacy) = only if defender took 0 damage\n  const deflectDmg = game.deflectionPending?.[defenderPlayerNum];\n  const deflectUnconditional = game.deflectionUnconditional?.[defenderPlayerNum];\n  if (deflectDmg && deflectDmg > 0 && hit && (deflectUnconditional || damage === 0)) {\n    delete game.deflectionPending[defenderPlayerNum];\n    delete game.deflectionUnconditional?.[defenderPlayerNum];\n    const attMsgId = combat.attackerMsgId;\n    const attFigIdx = combat.attackerFigureIndex ?? 0;\n    if (attMsgId) {\n      const { maxHp: deflectMax } = reduceHp(dcHealthState\x2C game\x2C attMsgId\x2C attFigIdx\x2C deflectDmg\x2C attackerPlayerNum);\n      if (deflectMax > 0) {\n        embedRefreshMsgIds.add(attMsgId);\n        const defOwnerId = getPlayerId(game\x2C defenderPlayerNum);\n        await logGameAction(game\x2C client\x2C `<@${defOwnerId}> **Deflection** \u2014 Attacker suffers **${deflectDmg} Damage**.`\x2C { allowedMentions: { users: [defOwnerId] }\x2C phase: 'ROUND'\x2C icon: 'card' });\n      }\n    }\n  }\n  // Embed refresh for Blast damage already applied earlier in this function\n  if (totalBlast > 0 && hit && game.selectedMap?.id) {\n    const blastAdjacent = _targetCoordBeforeDefeat\n      ? getFiguresAdjacentToCoord(game\x2C _targetCoordBeforeDefeat\x2C game.selectedMap.id\x2C combat.target.figureKey)\n      : [];\n    for (const { figureKey: bk\x2C playerNum: bp } of blastAdjacent) {\n      const mid = findDcMessageIdForFigure(game.gameId\x2C bp\x2C bk);\n      if (mid) embedRefreshMsgIds.add(mid);\n    }\n  }\n  // Cover Fire (CT-1701): after resolving an attack\x2C distribute 1 Block Token to a friendly figure within 3 spaces.\n  // If the attack hit\x2C may discard 1 condition or Power Token from the target. Limit once per round.\n  const _cfAttEff = getDcEffects()?.[combat.attackerDcName || ''];\n  const _cfKey = `coverFire_${combat.attackerMsgId}`;\n  if ((_cfAttEff?.passives || []).includes('Cover Fire') && combat.attackerMsgId && !game.roundFigureAbilityUsed?.[_cfKey]) {\n    game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n    game.roundFigureAbilityUsed[_cfKey] = true;\n    const _cfAttPos = game.figurePositions?.[attackerPlayerNum]?.[combat.attackerFigureKey];\n    const _cfMapId = game.selectedMap?.id;\n    if (_cfAttPos && _cfMapId) {\n      // Find all friendly figures within 3 spaces\n      const _cfFriendlies = [];\n      for (const [fk\x2C pos] of Object.entries(game.figurePositions?.[attackerPlayerNum] || {})) {\n        if (!pos) continue;\n        if (countGameSpaces(game\x2C _cfAttPos\x2C pos) <= 3) _cfFriendlies.push({ fk\x2C pos });\n      }\n      if (_cfFriendlies.length === 1) {\n        // Auto-grant to the only option\n        grantPowerTokens(game\x2C _cfFriendlies[0].fk\x2C 'Block'\x2C 1);\n        const _cfName = dcNameFromFigureKey(_cfFriendlies[0].fk);\n        await logGameAction(game\x2C client\x2C `\\u{1F6E1}\\uFE0F **Cover Fire** \u2014 **${_cfName}** gained 1 Block Token.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n        const _cfMid = findDcMessageIdForFigure(game.gameId\x2C attackerPlayerNum\x2C _cfFriendlies[0].fk);\n        if (_cfMid) embedRefreshMsgIds.add(_cfMid);\n      } else if (_cfFriendlies.length > 1) {\n        // Picker buttons for Block token target\n        const _cfBtns = _cfFriendlies.slice(0\x2C 20).map(({ fk }) => {\n          const _cfLabel = dcNameFromFigureKey(fk);\n          return new ButtonBuilder()\n            .setCustomId(`cover_fire_block_${game.gameId}_${attackerPlayerNum}_${fk}`)\n            .setLabel(_cfLabel.slice(0\x2C 80))\n            .setStyle(ButtonStyle.Primary);\n        });\n        const _cfRows = chunkButtonsToRows(_cfBtns);\n        game.pendingCoverFire = { gameId: game.gameId\x2C attackerPlayerNum\x2C attackerMsgId: combat.attackerMsgId\x2C hit: !!(hit && damage > 0)\x2C targetFigureKey: combat.target?.figureKey\x2C targetMsgId\x2C targetFigIndex\x2C defenderPlayerNum\x2C combat: { combatThreadId: combat.combatThreadId\x2C resultText }\x2C embedRefreshMsgIds: [...embedRefreshMsgIds] };\n        await thread.send(sanitizeMentions({ content: `\\u{1F6E1}\\uFE0F **Cover Fire** \u2014 <@${ownerId}> Choose a friendly figure within 3 spaces to receive 1 Block Token:`\x2C allowedMentions: { users: [ownerId] }\x2C components: _cfRows }));\n        // Don't return \u2014 the Block token choice is async but we continue combat resolution\n      }\n    }\n    // If hit and damage > 0\x2C offer to discard a condition or power token from the target\n    if (hit && damage > 0 && combat.target?.figureKey) {\n      const _cfTargetConds = (game.figureConditions?.[combat.target.figureKey] || []).filter(c => c !== 'Bleed' || c); // all conditions\n      const _cfTargetTokens = game.figurePowerTokens?.[combat.target.figureKey] || [];\n      const _cfRemovables = [..._cfTargetConds.map(c => ({ type: 'condition'\x2C value: c }))\x2C ..._cfTargetTokens.map(t => ({ type: 'token'\x2C value: t }))];\n      if (_cfRemovables.length > 0) {\n        const _cfRemBtns = _cfRemovables.slice(0\x2C 20).map(({ type\x2C value }\x2C i) => {\n          const label = type === 'condition' ? `Discard ${value}` : `Discard ${value} Token`;\n          return new ButtonBuilder()\n            .setCustomId(`cover_fire_discard_${game.gameId}_${type}_${i}_${combat.target.figureKey}`)\n            .setLabel(label.slice(0\x2C 80))\n            .setStyle(ButtonStyle.Danger);\n        });\n        _cfRemBtns.push(new ButtonBuilder().setCustomId(`cover_fire_discard_skip_${game.gameId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary));\n        const _cfRemRows = chunkButtonsToRows(_cfRemBtns);\n        await thread.send(sanitizeMentions({ content: `\\u{1F6E1}\\uFE0F **Cover Fire** \u2014 <@${ownerId}> You may discard 1 condition or Power Token from **${combat.target.label}**:`\x2C allowedMentions: { users: [ownerId] }\x2C components: _cfRemRows }));\n      }\n    }\n  }\n\n  // Wave 3: Cleave \u2014 eligible targets are those the attacker COULD target for this attack (not adjacent to target).\n  // Melee: adjacent to attacker. Ranged: within LOS + Accuracy of attacker. Includes objects (crates).\n  // Rules: RULES_REFERENCE.md Lines 859-873.\n  const effectiveCleave = (combat.surgeCleave || 0) + (combat.passiveCleave || 0);\n  if (hit && damage > 0 && effectiveCleave > 0 && game.selectedMap?.id) {\n    const _clvMapId = game.selectedMap.id;\n    const attackerPos = game.figurePositions?.[attackerPlayerNum]?.[combat.attackerFigureKey];\n    const cleaveTargets = [];\n    if (attackerPos) {\n      if (!combat.isRanged) {\n        // Melee: adjacent to attacker\n        const adjToAttacker = getFiguresAdjacentToCoord(game\x2C attackerPos\x2C _clvMapId\x2C combat.attackerFigureKey);\n        for (const c of adjToAttacker) {\n          if (c.playerNum !== defenderPlayerNum) continue;\n          if (c.figureKey === combat.target?.figureKey) continue;\n          cleaveTargets.push(c);\n        }\n        // Melee crates: adjacent to attacker\n        if (game.cratePositions) {\n          const rawMs = getMapData(_clvMapId);\n          const adj = rawMs?.adjacency || {};\n          const atkNorm = String(attackerPos).toLowerCase();\n          const atkAdj = new Set((adj[atkNorm] || []).map(c => String(c).toLowerCase()));\n          atkAdj.add(atkNorm);\n          for (const [origCoord\x2C curCoord] of Object.entries(game.cratePositions)) {\n            if (atkAdj.has(String(curCoord).toLowerCase())) {\n              const hp = game.crateHealth?.[origCoord] ?? 5;\n              cleaveTargets.push({ figureKey: `crate_${origCoord}`\x2C playerNum: null\x2C isCrate: true\x2C crateOrigCoord: origCoord\x2C crateCoord: curCoord\x2C label: `Crate @ ${String(curCoord).toUpperCase()} (${hp}/5 HP)` });\n            }\n          }\n        }\n      } else {\n        // Ranged: within Accuracy + LOS of attacker\n        const totalAcc = (combat.attackRoll?.acc || 0) + (combat.surgeAccuracy || 0) + (combat.bonusAccuracy || 0);\n        const _clvMapSpaces = getEffectiveMapSpaces(game\x2C _clvMapId);\n        for (const pn of [defenderPlayerNum]) {\n          for (const [fk\x2C fCoord] of Object.entries(game.figurePositions?.[pn] || {})) {\n            if (fk === combat.target?.figureKey) continue;\n            if (!isWithinN(attackerPos\x2C fCoord\x2C totalAcc\x2C _clvMapId) || !hasLineOfSight(attackerPos\x2C fCoord\x2C _clvMapSpaces\x2C null)) continue;\n            cleaveTargets.push({ figureKey: fk\x2C playerNum: pn });\n          }\n        }\n        // Ranged crates: within Accuracy of attacker\n        if (game.cratePositions) {\n          for (const [origCoord\x2C curCoord] of Object.entries(game.cratePositions)) {\n            if (isWithinN(attackerPos\x2C String(curCoord).toLowerCase()\x2C totalAcc\x2C _clvMapId)) {\n              const hp = game.crateHealth?.[origCoord] ?? 5;\n              cleaveTargets.push({ figureKey: `crate_${origCoord}`\x2C playerNum: null\x2C isCrate: true\x2C crateOrigCoord: origCoord\x2C crateCoord: curCoord\x2C label: `Crate @ ${String(curCoord).toUpperCase()} (${hp}/5 HP)` });\n            }\n          }\n        }\n      }\n    }\n    if (cleaveTargets.length > 0) {\n      const targetsWithLabels = cleaveTargets.map((c) => {\n        if (c.isCrate) return c;\n        const { msgId\x2C label } = getFigureLabel(game\x2C c.playerNum\x2C c.figureKey\x2C c.figureKey);\n        return { figureKey: c.figureKey\x2C playerNum: c.playerNum\x2C label };\n      });\n      game.pendingCleave = {\n        gameId: game.gameId\x2C\n        combatThreadId: combat.combatThreadId\x2C\n        surgeCleave: effectiveCleave\x2C\n        attackerPlayerNum\x2C\n        ownerId\x2C\n        targets: targetsWithLabels\x2C\n        resultText\x2C\n        combat\x2C\n        initialEmbedRefreshMsgIds: [...embedRefreshMsgIds]\x2C\n      };\n      const cleaveRows = getCleaveTargetButtons(game.gameId\x2C targetsWithLabels);\n      await thread.send(sanitizeMentions({\n        content: `**Cleave (${effectiveCleave} damage):** <@${ownerId}> \\u2014 Choose one eligible target to apply cleave damage:`\x2C\n        allowedMentions: { users: [ownerId] }\x2C\n        components: cleaveRows\x2C\n      }));\n      return;\n    }\n  }\n  const fkTriggered = await _checkPostCombatSurges(game\x2C combat\x2C resultText\x2C embedRefreshMsgIds\x2C thread\x2C ownerId\x2C defenderPlayerNum);\n  if (!fkTriggered) await _finishCombatResolution(game\x2C combat\x2C resultText\x2C embedRefreshMsgIds\x2C client);\n}\n\n/**\n * Check for post-combat surge effects that need UI interaction\x2C before finishCombatResolution.\n * Returns true if a pending interaction was triggered (caller should NOT call finishCombatResolution yet).\n * Returns false if nothing triggered (caller should call finishCombatResolution).\n */\nexport async function checkPostCombatSurges(game\x2C combat\x2C resultText\x2C embedRefreshMsgIds\x2C thread\x2C ownerId\x2C defenderPlayerNum\x2C deps) {\n  const {\n    logGameAction\x2C dcNameFromFigureKey\x2C getFigureLabel\x2C getFigureSize\x2C\n    getMapData\x2C getPlayerId\x2C getCcHand\x2C getCcEffect\x2C getCcEffectsData\x2C\n    getDcEffects\x2C getFiguresAdjacentToTarget\x2C\n    _applyCondition\x2C HARMFUL_CONDITIONS\x2C isConditionImmune\x2C\n    ccHandKey\x2C ccDiscardKey\x2C ccDeckKey\x2C\n    ButtonBuilder\x2C ButtonStyle\x2C ActionRowBuilder\x2C\n    getFightingKnifeTargetButtons\x2C\n    discordCatch\x2C\n    updateMovementBankMessage\x2C\n    client\x2C\n  } = deps;\n\n  const hit = !resultText.includes('**Miss**');\n  // Fighting Knife (Verena Talos): after non-miss\x2C choose adjacent hostile\x2C roll 1 red die\x2C apply hits\n  if (hit && combat.surgeFightingKnife && combat.attackerFigureKey && game.selectedMap?.id) {\n    const adjHostiles = getFiguresAdjacentToTarget(game\x2C combat.attackerFigureKey\x2C game.selectedMap.id)\n      .filter((c) => c.playerNum === defenderPlayerNum);\n    if (adjHostiles.length > 0) {\n      const targetsWithLabels = adjHostiles.map((c) => {\n        const { msgId: mid\x2C label } = getFigureLabel(game\x2C c.playerNum\x2C c.figureKey);\n        return { figureKey: c.figureKey\x2C playerNum: c.playerNum\x2C label\x2C msgId: mid };\n      });\n      game.pendingFightingKnife = {\n        gameId: game.gameId\x2C\n        combatThreadId: combat.combatThreadId\x2C\n        attackerPlayerNum: combat.attackerPlayerNum\x2C\n        ownerId\x2C\n        targets: targetsWithLabels\x2C\n        resultText\x2C\n        combat\x2C\n        initialEmbedRefreshMsgIds: [...embedRefreshMsgIds]\x2C\n      };\n      const rows = getFightingKnifeTargetButtons(game.gameId\x2C targetsWithLabels);\n      await thread.send(sanitizeMentions({\n        content: `<@${ownerId}> **Fighting Knife** \u2014 Choose an adjacent hostile figure to roll 1 red die:`\x2C\n        allowedMentions: { users: [ownerId] }\x2C\n        components: rows\x2C\n      })).catch(discordCatch);\n      return true;\n    }\n  }\n  // Concussive Bolt (4-LOM): after non-miss on SMALL target\x2C push target 1 space (attacker picks direction)\n  if (hit && combat.surgeConcussiveBolt && combat.target?.figureKey && game.selectedMap?.id) {\n    const targetDcName = dcNameFromFigureKey(combat.target.figureKey);\n    const targetSize = getFigureSize(targetDcName);\n    if (targetSize === '1x1') {\n      const targetPos = game.figurePositions?.[defenderPlayerNum]?.[combat.target.figureKey];\n      const ms = getMapData(game.selectedMap.id);\n      const adjSpaces = (ms?.adjacency?.[String(targetPos).toLowerCase()] || []).map((s) => String(s).toLowerCase());\n      if (adjSpaces.length > 0) {\n        const { msgId: targetMsgId\x2C label: targetLabel } = getFigureLabel(game\x2C defenderPlayerNum\x2C combat.target.figureKey\x2C targetDcName);\n        game.pendingConcussiveBolt = {\n          gameId: game.gameId\x2C\n          combatThreadId: combat.combatThreadId\x2C\n          attackerPlayerNum: combat.attackerPlayerNum\x2C\n          defenderPlayerNum\x2C\n          ownerId\x2C\n          figureKey: combat.target.figureKey\x2C\n          figureLabel: String(targetLabel).slice(0\x2C 80)\x2C\n          currentPos: targetPos\x2C\n          adjSpaces\x2C\n          resultText\x2C\n          combat\x2C\n          initialEmbedRefreshMsgIds: [...embedRefreshMsgIds]\x2C\n        };\n        const btns = adjSpaces.slice(0\x2C 4).map((sp) =>\n          new ButtonBuilder().setCustomId(`concussive_bolt_push_${game.gameId}_${sp}`).setLabel(sp.toUpperCase()).setStyle(ButtonStyle.Danger)\n        );\n        btns.push(new ButtonBuilder().setCustomId(`concussive_bolt_skip_${game.gameId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary));\n        await thread.send(sanitizeMentions({\n          content: `<@${ownerId}> **Concussive Bolt** \u2014 Push **${targetLabel}** 1 space. Choose a destination:`\x2C\n          allowedMentions: { users: [ownerId] }\x2C\n          components: [new ActionRowBuilder().addComponents(btns)]\x2C\n        })).catch(discordCatch);\n        return true;\n      }\n    }\n  }\n  // Spread the Pain (Dengar): after non-miss\x2C apply each chosen HARMFUL condition to a figure on/adjacent to target\n  if (hit && combat.spreadThePainConditions?.length > 0 && combat.target?.figureKey && game.selectedMap?.id) {\n    const conditions = [...combat.spreadThePainConditions];\n    const targetPos = game.figurePositions?.[defenderPlayerNum]?.[combat.target.figureKey];\n    if (targetPos) {\n      const ms = getMapData(game.selectedMap.id);\n      const adjacency = ms?.adjacency || {};\n      const candSpaces = new Set([String(targetPos).toLowerCase()\x2C ...(adjacency[String(targetPos).toLowerCase()] || []).map((s) => String(s).toLowerCase())]);\n      const figuresAtSpaces = [];\n      for (const p of [1\x2C 2]) {\n        for (const [figKey\x2C figPos] of Object.entries(game.figurePositions?.[p] || {})) {\n          if (candSpaces.has(String(figPos).toLowerCase())) {\n            const { msgId: mid\x2C label } = getFigureLabel(game\x2C p\x2C figKey\x2C undefined\x2C 70);\n            figuresAtSpaces.push({ figureKey: figKey\x2C playerNum: p\x2C label\x2C msgId: mid });\n          }\n        }\n      }\n      if (figuresAtSpaces.length > 0) {\n        const firstCond = conditions[0];\n        game.pendingSpreadThePain = {\n          gameId: game.gameId\x2C\n          combatThreadId: combat.combatThreadId\x2C\n          attackerPlayerNum: combat.attackerPlayerNum\x2C\n          defenderPlayerNum\x2C\n          ownerId\x2C\n          conditions\x2C\n          conditionIdx: 0\x2C\n          resultText\x2C\n          combat\x2C\n          initialEmbedRefreshMsgIds: [...embedRefreshMsgIds]\x2C\n        };\n        const btns = figuresAtSpaces.slice(0\x2C 4).map((f) =>\n          new ButtonBuilder()\n            .setCustomId(`spread_pain_fig_${game.gameId}_${f.figureKey}`)\n            .setLabel(f.label)\n            .setStyle(f.playerNum === defenderPlayerNum ? ButtonStyle.Danger : ButtonStyle.Secondary)\n        );\n        btns.push(new ButtonBuilder().setCustomId(`spread_pain_skip_${game.gameId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary));\n        await thread.send(sanitizeMentions({\n          content: `<@${ownerId}> **Spread the Pain** \u2014 Apply **${firstCond}** to a figure at or adjacent to target (${String(targetPos).toUpperCase()}):`\x2C\n          allowedMentions: { users: [ownerId] }\x2C\n          components: [new ActionRowBuilder().addComponents(btns)]\x2C\n        })).catch(discordCatch);\n        return true;\n      }\n    }\n  }\n  // Post-attack reactions: check if defender has Payback\x2C Dangerous Prey\x2C or Right Back At Ya!\n  const defenderHand = getCcHand(game\x2C defenderPlayerNum) || [];\n  const REACTION_CARDS = [\n    { name: 'Payback'\x2C targetDcName: 'Dengar' }\x2C\n    { name: 'Dangerous Prey'\x2C targetDcName: 'Bossk' }\x2C\n    { name: "Right Back At Ya!"\x2C targetDcName: 'Ahsoka Tano' }\x2C\n  ];\n  combat.promptedReactions = combat.promptedReactions || new Set();\n  for (const { name\x2C targetDcName } of REACTION_CARDS) {\n    if (combat.promptedReactions.has(name)) continue;\n    if (!defenderHand.includes(name)) continue;\n    const targetFigKey = combat.target?.figureKey || '';\n    if (!targetFigKey.startsWith(targetDcName + '-')) continue;\n    // Prompt the defender for this reaction\n    combat.promptedReactions.add(name);\n    const defOwnerId = getPlayerId(game\x2C defenderPlayerNum);\n    // Tentatively remove from hand to prevent double-prompt; restored on skip\n    const handKey = ccHandKey(defenderPlayerNum);\n    const cardIdx = (game[handKey] || []).indexOf(name);\n    if (cardIdx >= 0) game[handKey].splice(cardIdx\x2C 1);\n    game.pendingReaction = {\n      gameId: game.gameId\x2C\n      combatThreadId: combat.combatThreadId\x2C\n      attackerPlayerNum: combat.attackerPlayerNum\x2C\n      defenderPlayerNum\x2C\n      ownerId: defOwnerId\x2C\n      cardName: name\x2C\n      targetDcName\x2C\n      targetFigKey\x2C\n      attackerFigKey: combat.attackerFigureKey\x2C\n      attackerMsgId: combat.attackerMsgId\x2C\n      resultText\x2C\n      combat\x2C\n      initialEmbedRefreshMsgIds: [...embedRefreshMsgIds]\x2C\n    };\n    const btnUse = new ButtonBuilder()\n      .setCustomId(`reaction_use_${game.gameId}`)\n      .setLabel(`React: ${name}`)\n      .setStyle(ButtonStyle.Danger);\n    const btnSkip = new ButtonBuilder()\n      .setCustomId(`reaction_skip_${game.gameId}`)\n      .setLabel('Skip')\n      .setStyle(ButtonStyle.Secondary);\n    await thread.send(sanitizeMentions({\n      content: `<@${defOwnerId}> \u2014 You have **${name}** in hand! React to this attack?`\x2C\n      allowedMentions: { users: [defOwnerId] }\x2C\n      components: [new ActionRowBuilder().addComponents(btnUse\x2C btnSkip)]\x2C\n    })).catch(discordCatch);\n    return true;\n  }\n  // Agitate (Cam Droid): on hit\x2C defender's group must activate next\x2C if able\n  if (hit && combat.surgeAgitate && combat.target?.figureKey) {\n    const defenderDcName = dcNameFromFigureKey(combat.target.figureKey);\n    game.agitateNextActivation = { playerNum: defenderPlayerNum\x2C dcName: defenderDcName };\n    const defLabel = combat.target.label || defenderDcName;\n    await thread.send(`**Agitate** \u2014 **${defLabel}**'s group must be the next to activate this round\x2C if able.`).catch(discordCatch);\n  }\n  // Fell Swoop (Davith Elso): after attack\x2C become Hidden\x2C gain 2 MP\x2C free attack. Limit once per round.\n  if (combat.surgeFellSwoop && combat.attackerFigureKey) {\n    game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n    const fsKey = `${combat.attackerFigureKey}_fell_swoop`;\n    if (!game.roundFigureAbilityUsed[fsKey]) {\n      game.roundFigureAbilityUsed[fsKey] = true;\n      _applyCondition(game\x2C combat.attackerFigureKey\x2C 'Hide');\n      grantMovementBank(game\x2C combat.attackerMsgId\x2C 2);\n      if (game.movementBank?.[combat.attackerMsgId]) {\n        updateMovementBankMessage(game\x2C combat.attackerMsgId\x2C client).catch(discordCatch);\n      }\n      game.fellSwoopFreeAttack = game.fellSwoopFreeAttack || {};\n      game.fellSwoopFreeAttack[combat.attackerMsgId] = true;\n      const attName = combat.attackerDisplayName || dcNameFromFigureKey(combat.attackerFigureKey);\n      await thread.send(`**Fell Swoop** \u2014 **${attName}** becomes **Hidden** and gains **2 Movement Points**. Use Move in the DC thread\x2C then click Attack for a free Fell Swoop attack (costs no action).`).catch(discordCatch);\n    }\n  }\n  // Mastery (Second Sister): redraw a FORCE USER CC of cost \u2264 1 from discard. Limit once per round.\n  if (combat.surgeMastery && combat.attackerFigureKey) {\n    game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n    const mastKey = `${combat.attackerFigureKey}_mastery`;\n    if (!game.roundFigureAbilityUsed[mastKey]) {\n      game.roundFigureAbilityUsed[mastKey] = true;\n      // Rest in Peace: block discard-pile retrieval\n      if (game.restInPeaceActive) {\n        await thread.send('**Mastery** \u2014 Blocked by **Rest in Peace** (cannot retrieve from discard piles this round).').catch(discordCatch);\n      } else {\n        const mastPlayerNum = combat.attackerPlayerNum;\n        const mastDiscardKey = ccDiscardKey(mastPlayerNum);\n        const mastDiscard = game[mastDiscardKey] || [];\n        const mastEligible = mastDiscard.filter((cardName) => {\n          const entry = getCcEffect(cardName);\n          return entry && (entry.cost ?? 99) <= 1 && String(entry.playableBy || '').toUpperCase().includes('FORCE USER');\n        });\n        if (mastEligible.length === 0) {\n          await thread.send(`**Mastery** \u2014 No eligible FORCE USER Command cards (cost \\u2264 1) in your discard pile.`).catch(discordCatch);\n        } else {\n          game.pendingMastery = { gameId: game.gameId\x2C attackerPlayerNum: mastPlayerNum\x2C discardKey: mastDiscardKey\x2C eligible: mastEligible\x2C resultText\x2C combat\x2C initialEmbedRefreshMsgIds: [...embedRefreshMsgIds]\x2C defenderPlayerNum };\n          const mastOwnerId = getPlayerId(game\x2C mastPlayerNum);\n          const mastBtns = mastEligible.slice(0\x2C 4).map((cardName\x2C i) =>\n            new ButtonBuilder().setCustomId(`mastery_pick_${game.gameId}_${i}`).setLabel(cardName.slice(0\x2C 80)).setStyle(ButtonStyle.Primary)\n          );\n          mastBtns.push(new ButtonBuilder().setCustomId(`mastery_skip_${game.gameId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary));\n          await thread.send(sanitizeMentions({\n            content: `<@${mastOwnerId}> **Mastery** \u2014 Choose a FORCE USER CC (cost \\u2264 1) from your discard pile to return to hand:`\x2C\n            allowedMentions: { users: [mastOwnerId] }\x2C\n            components: [new ActionRowBuilder().addComponents(mastBtns)]\x2C\n          })).catch(discordCatch);\n          return true;\n        }\n      }\n    }\n  }\n  // Interrogate (Agent Blaise): look at opponent's hand\x2C choose a CC; may discard equal/greater cost to force discard.\n  if (combat.surgeInterrogate) {\n    const intAttackerPlayerNum = combat.attackerPlayerNum;\n    const intOpponentPlayerNum = defenderPlayerNum;\n    const intOpponentHandKey = ccHandKey(intOpponentPlayerNum);\n    const intOpponentHand = game[intOpponentHandKey] || [];\n    if (intOpponentHand.length === 0) {\n      await thread.send(`**Interrogate** \u2014 Opponent's hand is empty; no card to choose.`).catch(discordCatch);\n    } else {\n      game.pendingInterrogate = { gameId: game.gameId\x2C attackerPlayerNum: intAttackerPlayerNum\x2C opponentPlayerNum: intOpponentPlayerNum\x2C opponentHandSnapshot: [...intOpponentHand]\x2C chosenCardName: null\x2C resultText\x2C combat\x2C initialEmbedRefreshMsgIds: [...embedRefreshMsgIds]\x2C defenderPlayerNum };\n      const intOwnerId = getPlayerId(game\x2C intAttackerPlayerNum);\n      const intBtns = intOpponentHand.slice(0\x2C 4).map((cardName\x2C i) =>\n        new ButtonBuilder().setCustomId(`interrogate_pick_${game.gameId}_${i}`).setLabel(cardName.slice(0\x2C 80)).setStyle(ButtonStyle.Danger)\n      );\n      await thread.send(sanitizeMentions({\n        content: `<@${intOwnerId}> **Interrogate** \u2014 \\u26A0\\uFE0F *Opponent: look away!* Pick the card you want to target:`\x2C\n        allowedMentions: { users: [intOwnerId] }\x2C\n        components: [new ActionRowBuilder().addComponents(intBtns)]\x2C\n      })).catch(discordCatch);\n      return true;\n    }\n  }\n  // Military Efficiency (Leia Organa): shuffle 1 CC from discard back into deck\n  if (combat.surgeMilitaryEfficiency && combat.attackerPlayerNum) {\n    const mePlayerNum = combat.attackerPlayerNum;\n    const meDiscardKey = ccDiscardKey(mePlayerNum);\n    const meDeckKey = ccDeckKey(mePlayerNum);\n    const meDiscard = game[meDiscardKey] || [];\n    if (meDiscard.length === 0) {\n      await thread.send(`**Military Efficiency** \u2014 No cards in discard pile to return.`).catch(discordCatch);\n    } else {\n      // Shuffle the most-recently-discarded card back into the deck\n      const meCard = meDiscard[meDiscard.length - 1];\n      game[meDiscardKey] = meDiscard.slice(0\x2C -1);\n      const meDeck = [...(game[meDeckKey] || [])];\n      const meInsertIdx = Math.floor(Math.random() * (meDeck.length + 1));\n      meDeck.splice(meInsertIdx\x2C 0\x2C meCard);\n      game[meDeckKey] = meDeck;\n      await thread.send(`**Military Efficiency** \u2014 **${meCard}** shuffled from discard back into your Command deck.`).catch(discordCatch);\n      await logGameAction(game\x2C client\x2C `**Military Efficiency** \u2014 **${meCard}** shuffled back into P${mePlayerNum}'s Command deck.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n    }\n  }\n  return false;\n}\n\n/**\n * Send result to thread\x2C clear combat/roll UI\x2C refresh DC embeds and board.\n */\nexport async function finishCombatResolution(game\x2C combat\x2C resultText\x2C embedRefreshMsgIds\x2C client\x2C deps) {\n  const {\n    logGameAction\x2C saveGames\x2C dcHealthState\x2C dcMessageMeta\x2C dcExhaustedState\x2C\n    dcNameFromFigureKey\x2C parseFigureKey\x2C opponentPlayerNum\x2C discordCatch\x2C\n    reduceHp\x2C healHp\x2C\n    getDcList\x2C getDcMessageIds\x2C getDcStats\x2C getDcEffect\x2C getDcEffects\x2C getDcKeywords\x2C\n    getPlayerId\x2C getPlayAreaId\x2C getMapData\x2C\n    isWithinN\x2C hasLineOfSight\x2C\n    findDcMessageIdForFigure\x2C getFigureLabel\x2C\n    getCcHand\x2C getCcEffectsData\x2C\n    _applyCondition\x2C\n    grantMovementBank\x2C grantPowerTokens\x2C\n    renderDcEmbed\x2C\n    buildBoardMapPayload\x2C\n    updateDcActionsMessage\x2C ensureMovementBankMessage\x2C updateMovementBankMessage\x2C\n    sendPowerTokenOverflowUI\x2C\n    applyIndiscriminateFireSplash\x2C\n    ButtonBuilder\x2C ButtonStyle\x2C ActionRowBuilder\x2C\n    syncHealthStateToList\x2C\n  } = deps;\n\n  const thread = await fetchCombatThread(client\x2C combat.combatThreadId);\n  await thread.send(resultText);\n  // Lure of the Dark Side: after attack resolves\x2C hostile figure suffers strain (damage to HP)\n  if (combat.isLure && combat.lurePostAttackStrain > 0 && combat.attackerFigureKey) {\n    const lureFk = combat.attackerFigureKey;\n    const lurePn = combat.attackerPlayerNum;\n    const lureMsgId = findDcMessageIdForFigure(game.gameId\x2C lurePn\x2C lureFk);\n    if (lureMsgId) {\n      const { figureIndex: lureFi } = parseFigureKey(lureFk);\n      reduceHp(dcHealthState\x2C game\x2C lureMsgId\x2C lureFi\x2C combat.lurePostAttackStrain\x2C lurePn);\n    }\n    await thread.send(`**Lure of the Dark Side** \u2014 **${combat.attackerDcName}** suffers ${combat.lurePostAttackStrain} Strain.`).catch(discordCatch);\n    await logGameAction(game\x2C client\x2C `**Lure of the Dark Side** \u2014 **${combat.attackerDcName}** suffers ${combat.lurePostAttackStrain} Strain after the attack.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  }\n  // Hit and Run: add pending MP when attack resolves\n  const pending = game.hitAndRunPendingMp;\n  if (pending && pending.msgId === combat.attackerMsgId && pending.amount > 0) {\n    const n = pending.amount;\n    game.movementBank = game.movementBank || {};\n    const bank = game.movementBank[pending.msgId] || { total: 0\x2C remaining: 0 };\n    bank.total = (bank.total ?? 0) + n;\n    bank.remaining = (bank.remaining ?? 0) + n;\n    game.movementBank[pending.msgId] = bank;\n    const ownerId = getPlayerId(game\x2C combat.attackerPlayerNum);\n    await logGameAction(game\x2C client\x2C `Hit and Run: <@${ownerId}> gained **${n}** movement point${n === 1 ? '' : 's'} after the attack.`\x2C { allowedMentions: { users: [ownerId] }\x2C phase: 'ACTION'\x2C icon: 'card' });\n    await ensureMovementBankMessage(game\x2C pending.msgId\x2C client);\n    delete game.hitAndRunPendingMp;\n  }\n  // --- Post-combat ability prompts (before clearing pendingCombat) ---\n  const pcAttEff = getDcEffect(combat.attackerDcName);\n  const pcAttIds = pcAttEff?.specialAbilityIds || [];\n  const pcOwnerId = getPlayerId(game\x2C combat.attackerPlayerNum);\n  // Sidewinder (Jyn Odan): suffer 1 Strain to move 2 after attack (once/round)\n  if (pcAttIds.includes('sidewinder') && combat.attackerMsgId != null) {\n    const swKey = combat.attackerFigureKey + '_sidewinder';\n    if (!game.roundFigureAbilityUsed?.[swKey]) {\n      await thread.send(sanitizeMentions({\n        content: `<@${pcOwnerId}> **Sidewinder** \u2014 Suffer 1 Strain to move up to 2 spaces? (once per round)`\x2C\n        allowedMentions: { users: [pcOwnerId] }\x2C\n        components: [new ActionRowBuilder().addComponents(\n          new ButtonBuilder().setCustomId(`sidewinder_apply_${game.gameId}_${combat.attackerMsgId}_${combat.attackerFigureIndex ?? 0}`).setLabel('Suffer 1 Strain \\u2192 +2 MP').setStyle(ButtonStyle.Secondary)\x2C\n          new ButtonBuilder().setCustomId(`sidewinder_skip_${game.gameId}`).setLabel('Skip').setStyle(ButtonStyle.Primary)\x2C\n        )]\x2C\n      })).catch(discordCatch);\n    }\n  }\n  // Boltslinger (Vinto Hreeda): deal 1 Dmg to another hostile within 3 after attack\n  if (pcAttIds.includes('boltslinger') && game.selectedMap?.id && combat.attackerFigureKey) {\n    const blDefPlayerNum = opponentPlayerNum(combat.attackerPlayerNum);\n    const atkPos = game.figurePositions?.[combat.attackerPlayerNum]?.[combat.attackerFigureKey];\n    const defFigs = game.figurePositions?.[blDefPlayerNum] || {};\n    const boltslingerTargets = [];\n    for (const [fk\x2C pos] of Object.entries(defFigs)) {\n      if (fk === combat.target?.figureKey) continue;\n      if (!isWithinN(atkPos\x2C pos\x2C 3\x2C game.selectedMap.id)) continue;\n      const { label: blLabel } = getFigureLabel(game\x2C blDefPlayerNum\x2C fk);\n      boltslingerTargets.push({ figureKey: fk\x2C playerNum: blDefPlayerNum\x2C label: blLabel });\n    }\n    if (boltslingerTargets.length > 0) {\n      game.pendingBoltslinger = { gameId: game.gameId\x2C attackerPlayerNum: combat.attackerPlayerNum\x2C combatThreadId: combat.combatThreadId\x2C targets: boltslingerTargets };\n      const btns = boltslingerTargets.slice(0\x2C 4).map((t\x2C i) =>\n        new ButtonBuilder().setCustomId(`boltslinger_target_${game.gameId}_${i}`).setLabel(t.label).setStyle(ButtonStyle.Danger)\n      );\n      btns.push(new ButtonBuilder().setCustomId(`boltslinger_skip_${game.gameId}`).setLabel('Skip').setStyle(ButtonStyle.Primary));\n      await thread.send(sanitizeMentions({\n        content: `<@${pcOwnerId}> **Boltslinger** \u2014 Choose a hostile within 3 spaces to deal 1 Damage (verify LOS):`\x2C\n        allowedMentions: { users: [pcOwnerId] }\x2C\n        components: [new ActionRowBuilder().addComponents(btns)]\x2C\n      })).catch(discordCatch);\n    }\n  }\n  // Indiscriminate Fire (Bossk): after attack\x2C if not a miss\x2C choose 1 non-red attack die;\n  // each figure within 2 spaces of target (other than the defender) suffers Damage = Hits and Strain = Surges on that die.\n  if (pcAttIds.includes('indiscriminate_fire') && !resultText.includes('**Miss**') && game.selectedMap?.id && combat.target?.figureKey) {\n    const ifDefPlayerNum = opponentPlayerNum(combat.attackerPlayerNum);\n    const targetPos = game.figurePositions?.[ifDefPlayerNum]?.[combat.target.figureKey];\n    const rolledDice = combat.attackRoll?.dice || [];\n    const nonRedDice = rolledDice.filter((d) => (d.color || '').toLowerCase() !== 'red');\n    if (nonRedDice.length > 0 && targetPos) {\n      const splashTargets = [];\n      for (const pn of [1\x2C 2]) {\n        const figs = game.figurePositions?.[pn] || {};\n        for (const [fk\x2C pos] of Object.entries(figs)) {\n          if (fk === combat.target.figureKey) continue;\n          if (!isWithinN(pos\x2C targetPos\x2C 2\x2C game.selectedMap.id)) continue;\n          const { label: lbl } = getFigureLabel(game\x2C pn\x2C fk);\n          splashTargets.push({ figureKey: fk\x2C playerNum: pn\x2C label: lbl });\n        }\n      }\n      if (nonRedDice.length === 1) {\n        await applyIndiscriminateFireSplash(game\x2C combat.attackerPlayerNum\x2C combat.combatThreadId\x2C nonRedDice[0]\x2C splashTargets\x2C thread\x2C deps);\n      } else {\n        game.pendingIndiscriminateFire = { attackerPlayerNum: combat.attackerPlayerNum\x2C combatThreadId: combat.combatThreadId\x2C targets: splashTargets\x2C availableDice: nonRedDice };\n        const ifBtns = nonRedDice.slice(0\x2C 5).map((d\x2C i) =>\n          new ButtonBuilder().setCustomId(`indiscriminate_die_${game.gameId}_${i}`).setLabel(`${String(d.color).slice(0\x2C 1).toUpperCase()}${String(d.color).slice(1)} (${d.dmg}dmg/${d.surge}\\u21AF)`).setStyle(ButtonStyle.Secondary)\n        );\n        ifBtns.push(new ButtonBuilder().setCustomId(`indiscriminate_skip_${game.gameId}`).setLabel('Skip').setStyle(ButtonStyle.Primary));\n        await thread.send(sanitizeMentions({\n          content: `<@${pcOwnerId}> **Indiscriminate Fire** \u2014 Choose 1 non-red attack die for splash:`\x2C\n          allowedMentions: { users: [pcOwnerId] }\x2C\n          components: [new ActionRowBuilder().addComponents(ifBtns)]\x2C\n        })).catch(discordCatch);\n      }\n    }\n  }\n\n  // Heavy Fire (Skirmish Upgrade): after a friendly VEHICLE or HEAVY WEAPON resolves an attack\x2C\n  // for each die in that figure's printed attack pool\x2C you may choose 1 hostile figure within 2 spaces\n  // of the target space. Each chosen figure suffers 1 Damage. Then\x2C for each chosen figure\x2C the\n  // figure that attacked gains 1 HARMFUL condition of your opponent's choice.\n  if (game.selectedMap?.id && combat.target?.figureKey && combat.attackerDcName) {\n    const _hfPlayerNum = combat.attackerPlayerNum;\n    const _hfDcList = getDcList(game\x2C _hfPlayerNum) || [];\n    const _hfDcMsgIds = getDcMessageIds(game\x2C _hfPlayerNum) || [];\n    const _hfIdx = _hfDcList.findIndex(dc => dc.dcName === '[Heavy Fire]');\n    if (_hfIdx >= 0) {\n      const _hfMsgId = _hfDcMsgIds[_hfIdx];\n      const _hfExhausted = _hfMsgId ? (dcExhaustedState.get(_hfMsgId) ?? false) : true;\n      if (!_hfExhausted) {\n        // Check if attacker is VEHICLE or HEAVY WEAPON\n        const _hfAttKws = (getDcKeywords(game)[combat.attackerDcName] || []).map(k => String(k).toUpperCase());\n        if (_hfAttKws.includes('VEHICLE') || _hfAttKws.includes('HEAVY WEAPON')) {\n          // Count printed attack dice\n          const _hfAttEff = getDcEffect(combat.attackerDcName);\n          const _hfPrintedDice = _hfAttEff?.attack?.dice || [];\n          const _hfDiceCount = _hfPrintedDice.length;\n          if (_hfDiceCount > 0) {\n            // Find hostile figures within 2 spaces of target space\n            const _hfDefPN = opponentPlayerNum(_hfPlayerNum);\n            const _hfTargetPos = game.figurePositions?.[_hfDefPN]?.[combat.target.figureKey] || combat._savedTargetPos;\n            if (_hfTargetPos) {\n              const _hfHostiles = [];\n              const _hfDefFigs = game.figurePositions?.[_hfDefPN] || {};\n              for (const [fk\x2C pos] of Object.entries(_hfDefFigs)) {\n                if (!isWithinN(pos\x2C _hfTargetPos\x2C 2\x2C game.selectedMap.id)) continue;\n                const { label: lbl } = getFigureLabel(game\x2C _hfDefPN\x2C fk);\n                _hfHostiles.push({ figureKey: fk\x2C playerNum: _hfDefPN\x2C label: lbl });\n              }\n              if (_hfHostiles.length > 0) {\n                const _hfOwnerId = getPlayerId(game\x2C _hfPlayerNum);\n                const _hfBtns = [\n                  new ButtonBuilder().setCustomId(`heavy_fire_use_${game.gameId}`).setLabel(`Use Heavy Fire (${_hfDiceCount} target${_hfDiceCount !== 1 ? 's' : ''})`).setStyle(ButtonStyle.Danger)\x2C\n                  new ButtonBuilder().setCustomId(`heavy_fire_skip_${game.gameId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary)\x2C\n                ];\n                game.pendingHeavyFire = {\n                  attackerPlayerNum: _hfPlayerNum\x2C\n                  attackerFigureKey: combat.attackerFigureKey\x2C\n                  attackerDcName: combat.attackerDcName\x2C\n                  attackerMsgId: combat.attackerMsgId\x2C\n                  combatThreadId: combat.combatThreadId\x2C\n                  hfMsgId: _hfMsgId\x2C\n                  diceCount: _hfDiceCount\x2C\n                  hostiles: _hfHostiles\x2C\n                  chosenTargets: []\x2C\n                  conditionsOwed: 0\x2C\n                };\n                await thread.send(sanitizeMentions({\n                  content: `<@${_hfOwnerId}> **Heavy Fire** \u2014 Your **${combat.attackerDcName}** resolved an attack (printed pool: ${_hfDiceCount} dice). Exhaust Heavy Fire to deal 1 Damage to up to ${_hfDiceCount} hostile figure${_hfDiceCount !== 1 ? 's' : ''} within 2 spaces of the target?`\x2C\n                  allowedMentions: { users: [_hfOwnerId] }\x2C\n                  components: [new ActionRowBuilder().addComponents(_hfBtns)]\x2C\n                })).catch(discordCatch);\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n\n  // Havoc Shot (Fenn Signis): after attack that didn't miss\x2C suffer 1 Strain \u2192 up to 2 figures within 2 of target in LOS suffer 1 Damage\n  if (pcAttIds.includes('havoc_shot') && !resultText.includes('**Miss**') && game.selectedMap?.id && combat.target?.figureKey) {\n    const _hsTargetPos = game.figurePositions?.[combat.defenderPlayerNum ?? opponentPlayerNum(combat.attackerPlayerNum)]?.[combat.target.figureKey] || combat._savedTargetPos;\n    const _hsAtkPos = game.figurePositions?.[combat.attackerPlayerNum]?.[combat.attackerFigureKey];\n    if (_hsTargetPos && _hsAtkPos) {\n      const _hsMapSpaces = getMapData(game.selectedMap.id);\n      const _hsAllFigCoords = new Set();\n      for (const [\x2C fp] of Object.entries(game.figurePositions?.[1] || {})) if (fp) _hsAllFigCoords.add(String(fp).toLowerCase());\n      for (const [\x2C fp] of Object.entries(game.figurePositions?.[2] || {})) if (fp) _hsAllFigCoords.add(String(fp).toLowerCase());\n      const _hsEligible = [];\n      for (const pn of [1\x2C 2]) {\n        for (const [fk\x2C pos] of Object.entries(game.figurePositions?.[pn] || {})) {\n          if (!pos || fk === combat.attackerFigureKey) continue;\n          if (!isWithinN(pos\x2C _hsTargetPos\x2C 2\x2C game.selectedMap.id)) continue;\n          if (!hasLineOfSight(String(_hsAtkPos).toLowerCase()\x2C String(pos).toLowerCase()\x2C _hsMapSpaces\x2C _hsAllFigCoords)) continue;\n          const { label: lbl } = getFigureLabel(game\x2C pn\x2C fk);\n          _hsEligible.push({ figureKey: fk\x2C playerNum: pn\x2C label: lbl });\n        }\n      }\n      if (_hsEligible.length > 0) {\n        game.pendingHavocShot = {\n          gameId: game.gameId\x2C\n          attackerPlayerNum: combat.attackerPlayerNum\x2C\n          attackerMsgId: combat.attackerMsgId\x2C\n          attackerFigureKey: combat.attackerFigureKey\x2C\n          attackerFigureIndex: combat.attackerFigureIndex ?? 0\x2C\n          combatThreadId: combat.combatThreadId\x2C\n          targets: _hsEligible\x2C\n          chosen: []\x2C\n          maxPicks: 2\x2C\n        };\n        const _hsBtns = [\n          new ButtonBuilder().setCustomId(`havoc_shot_use_${game.gameId}`).setLabel('Use Havoc Shot (1 Strain)').setStyle(ButtonStyle.Danger)\x2C\n          new ButtonBuilder().setCustomId(`havoc_shot_skip_${game.gameId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary)\x2C\n        ];\n        await thread.send(sanitizeMentions({\n          content: `<@${pcOwnerId}> **Havoc Shot** \u2014 Suffer 1 Strain to deal 1 Damage to up to 2 figures within 2 spaces of the target in your LOS?`\x2C\n          allowedMentions: { users: [pcOwnerId] }\x2C\n          components: [new ActionRowBuilder().addComponents(_hsBtns)]\x2C\n        })).catch(discordCatch);\n      }\n    }\n  }\n\n  // Deflect (Luke Skywalker JK): after ranged attack resolves\x2C hostile in LOS suffers 1 Damage\n  if (combat.isRanged && combat.target?.figureKey && game.selectedMap?.id) {\n    const _dflDefPN = combat.defenderPlayerNum ?? opponentPlayerNum(combat.attackerPlayerNum);\n    const _dflAtkPN = combat.attackerPlayerNum;\n    // Check defender and adjacent friendlies for deflect\n    const _dflMapSpaces = getMapData(game.selectedMap.id);\n    const _dflAllFigCoords = new Set();\n    for (const [\x2C fp] of Object.entries(game.figurePositions?.[1] || {})) if (fp) _dflAllFigCoords.add(String(fp).toLowerCase());\n    for (const [\x2C fp] of Object.entries(game.figurePositions?.[2] || {})) if (fp) _dflAllFigCoords.add(String(fp).toLowerCase());\n    // Gather all figures on the defender's team that have deflect and are either the target or adjacent to the target\n    const _dflTargetPos = game.figurePositions?.[_dflDefPN]?.[combat.target.figureKey];\n    const _dflCandidates = [];\n    if (_dflTargetPos) {\n      for (const [fk\x2C pos] of Object.entries(game.figurePositions?.[_dflDefPN] || {})) {\n        if (!pos) continue;\n        const dName = dcNameFromFigureKey(fk);\n        const dEff = getDcEffect(dName);\n        if (!(dEff?.specialAbilityIds || []).includes('deflect')) continue;\n        // Must be the target or adjacent to the target\n        const isSelf = fk === combat.target.figureKey;\n        const isAdj = !isSelf && isWithinN(pos\x2C _dflTargetPos\x2C 1\x2C game.selectedMap.id);\n        if (!isSelf && !isAdj) continue;\n        _dflCandidates.push({ figureKey: fk\x2C pos\x2C dcName: dName });\n      }\n    }\n    for (const _dflCand of _dflCandidates) {\n      // Find hostiles in this figure's LOS\n      const _dflHostiles = [];\n      for (const [fk\x2C pos] of Object.entries(game.figurePositions?.[_dflAtkPN] || {})) {\n        if (!pos) continue;\n        if (!hasLineOfSight(String(_dflCand.pos).toLowerCase()\x2C String(pos).toLowerCase()\x2C _dflMapSpaces\x2C _dflAllFigCoords)) continue;\n        const { label: lbl } = getFigureLabel(game\x2C _dflAtkPN\x2C fk);\n        _dflHostiles.push({ figureKey: fk\x2C playerNum: _dflAtkPN\x2C label: lbl });\n      }\n      if (_dflHostiles.length === 0) continue;\n      const _dflOwnerId = getPlayerId(game\x2C _dflDefPN);\n      if (_dflHostiles.length === 1) {\n        // Auto-apply to the only hostile in LOS\n        const _dflTgt = _dflHostiles[0];\n        const _dflTgtMsgId = findDcMessageIdForFigure(game.gameId\x2C _dflTgt.playerNum\x2C _dflTgt.figureKey);\n        if (_dflTgtMsgId) {\n          const { figureIndex: _dflFigIdx } = parseFigureKey(_dflTgt.figureKey);\n          reduceHp(dcHealthState\x2C game\x2C _dflTgtMsgId\x2C _dflFigIdx\x2C 1\x2C _dflTgt.playerNum);\n          embedRefreshMsgIds.add(_dflTgtMsgId);\n        }\n        await thread.send(`**Deflect** \u2014 **${_dflCand.dcName}**: **${_dflTgt.label}** suffers 1 Damage.`).catch(discordCatch);\n        await logGameAction(game\x2C client\x2C `**Deflect** \u2014 **${_dflCand.dcName}** redirects 1 Damage to **${_dflTgt.label}**.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n      } else {\n        // Multiple hostiles \u2014 show picker\n        game.pendingDeflect = {\n          gameId: game.gameId\x2C\n          deflectorPlayerNum: _dflDefPN\x2C\n          deflectorFigureKey: _dflCand.figureKey\x2C\n          deflectorDcName: _dflCand.dcName\x2C\n          combatThreadId: combat.combatThreadId\x2C\n          hostiles: _dflHostiles\x2C\n        };\n        const _dflBtns = _dflHostiles.slice(0\x2C 4).map((t\x2C i) =>\n          new ButtonBuilder().setCustomId(`deflect_pick_${game.gameId}_${i}`).setLabel(t.label.slice(0\x2C 80)).setStyle(ButtonStyle.Danger)\n        );\n        _dflBtns.push(new ButtonBuilder().setCustomId(`deflect_skip_${game.gameId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary));\n        const _dflRows = chunkButtonsToRows(_dflBtns);\n        await thread.send(sanitizeMentions({\n          content: `<@${_dflOwnerId}> **Deflect** \u2014 **${_dflCand.dcName}** may redirect 1 Damage to a hostile in LOS:`\x2C\n          allowedMentions: { users: [_dflOwnerId] }\x2C\n          components: _dflRows\x2C\n        })).catch(discordCatch);\n      }\n      break; // Only one Deflect trigger per attack\n    }\n  }\n\n  // Missile Salvo: after each salvo attack\x2C record target + show remaining die buttons\n  if (combat.attackerMsgId && game.pendingMissileSalvo?.[combat.attackerMsgId]) {\n    const ms = game.pendingMissileSalvo[combat.attackerMsgId];\n    if (combat.target?.figureKey) ms.targetsFired = [...(ms.targetsFired || [])\x2C combat.target.figureKey];\n    if (ms.diceAvailable?.length > 0) {\n      const salvoOwnerId = getPlayerId(game\x2C combat.attackerPlayerNum);\n      const colorStyle = { blue: ButtonStyle.Primary\x2C red: ButtonStyle.Danger\x2C yellow: ButtonStyle.Secondary };\n      const salvoBtns = ms.diceAvailable.map((c) =>\n        new ButtonBuilder().setCustomId(`missile_salvo_die_${c}_${game.gameId}_${combat.attackerMsgId}`).setLabel(`${c.charAt(0).toUpperCase() + c.slice(1)} Die`).setStyle(colorStyle[c] || ButtonStyle.Secondary)\n      );\n      salvoBtns.push(new ButtonBuilder().setCustomId(`missile_salvo_done_${game.gameId}_${combat.attackerMsgId}`).setLabel('End Salvo').setStyle(ButtonStyle.Success));\n      await thread.send(sanitizeMentions({\n        content: `<@${salvoOwnerId}> **Missile Salvo** \u2014 ${ms.diceAvailable.length} shot${ms.diceAvailable.length !== 1 ? 's' : ''} remaining. Choose a die for your next attack (different target):`\x2C\n        components: [new ActionRowBuilder().addComponents(salvoBtns)]\x2C\n        allowedMentions: { users: [salvoOwnerId] }\x2C\n      })).catch(discordCatch);\n    } else {\n      delete game.pendingMissileSalvo[combat.attackerMsgId];\n      await thread.send('**Missile Salvo** \u2014 All shots fired. Salvo complete.').catch(discordCatch);\n    }\n  }\n\n  // Auto-prompt for post-attack reaction cards (Counter Attack\x2C Dangerous Prey\x2C Payback\x2C etc.)\n  try {\n    const _ccCardsAll = getCcEffectsData?.()?.cards || {};\n    const _postAtkTimings = new Set([\n      'afterAttackTargetingYouResolved'\x2C\n      'afterAttack'\x2C\n      'afterDamage'\x2C\n      'afterYouResolveAttackTargetingFigure'\x2C\n    ]);\n    // Defender: cards triggered by being attacked\n    const _defPostPn = combat.defenderPlayerNum ?? opponentPlayerNum(combat.attackerPlayerNum);\n    const _defPostId = getPlayerId(game\x2C _defPostPn);\n    const _defPostHand = getCcHand(game\x2C _defPostPn) || [];\n    const _defPostCards = [...new Set(_defPostHand)].filter(c => _ccCardsAll[c]?.timing && _postAtkTimings.has(_ccCardsAll[c].timing));\n    if (_defPostCards.length) {\n      await thread.send(sanitizeMentions({ content: `<@${_defPostId}> \u2014 Attack resolved! You have ${_defPostCards.length} reaction card(s) playable now. Check your Hand channel.`\x2C allowedMentions: { users: [_defPostId] } })).catch(discordCatch);\n    }\n    // Attacker: cards triggered by resolving an attack (includes Opportunistic \u2014 hostile suffered damage)\n    const _atkPostTimings = new Set(['afterAttack'\x2C 'afterYouResolveAttackTargetingFigure'\x2C 'afterYouResolveAttackThatDidNotMissDueToAccuracy'\x2C 'afterHostileFigureSuffersDamage']);\n    const _atkPostId = getPlayerId(game\x2C combat.attackerPlayerNum);\n    const _atkPostHand = getCcHand(game\x2C combat.attackerPlayerNum) || [];\n    const _atkPostCards = [...new Set(_atkPostHand)].filter(c => _ccCardsAll[c]?.timing && _atkPostTimings.has(_ccCardsAll[c].timing));\n    if (_atkPostCards.length) {\n      await thread.send(sanitizeMentions({ content: `<@${_atkPostId}> \u2014 Attack resolved! You have ${_atkPostCards.length} reaction card(s) playable now. Check your Hand channel.`\x2C allowedMentions: { users: [_atkPostId] } })).catch(discordCatch);\n    }\n  } catch (_postAtkErr) {\n    console.error('Post-attack reaction prompt error:'\x2C _postAtkErr?.message ?? _postAtkErr);\n  }\n\n  // Return Fire (Han Solo / Migs Mayfeld): after attack targeting this figure resolves\x2C interrupt free attack\n  {\n    const _rfDefPN = combat.defenderPlayerNum ?? opponentPlayerNum(combat.attackerPlayerNum);\n    const _rfDefFk = combat.target?.figureKey;\n    const _rfDefDcName = _rfDefFk ? dcNameFromFigureKey(_rfDefFk) : null;\n    const _rfDefEff = _rfDefDcName ? getDcEffect(_rfDefDcName) : null;\n    const _rfDefIds = _rfDefEff?.specialAbilityIds || [];\n    const _rfHasReturnFire = _rfDefIds.includes('return_fire') || _rfDefIds.includes('return_fire_migs');\n    if (_rfHasReturnFire && _rfDefFk && game.figurePositions?.[_rfDefPN]?.[_rfDefFk]) {\n      const _rfKey = `returnFire_${_rfDefFk}`;\n      if (!game.roundFigureAbilityUsed?.[_rfKey]) {\n        // Han Solo's return_fire requires 0 damage unless Rogue Smuggler upgrade overrides\n        let _rfCanFire = true;\n        if (_rfDefIds.includes('return_fire') && !_rfDefIds.includes('return_fire_migs')) {\n          const _rfDamage = combat._appliedDamage ?? 0;\n          const _rfDefMsgId = findDcMessageIdForFigure(game.gameId\x2C _rfDefPN\x2C _rfDefFk);\n          const _rfUpgrades = _rfDefMsgId ? (game.p1DcAttachments?.[_rfDefMsgId] || game.p2DcAttachments?.[_rfDefMsgId] || []) : [];\n          const _rfHasRogue = cardNameIncludes(_rfUpgrades\x2C 'Rogue Smuggler');\n          if (_rfDamage > 0 && !_rfHasRogue) _rfCanFire = false;\n        }\n        if (_rfCanFire) {\n          game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n          game.roundFigureAbilityUsed[_rfKey] = true;\n          // Set free attack bonus for the defender\n          const _rfDefMsgId = findDcMessageIdForFigure(game.gameId\x2C _rfDefPN\x2C _rfDefFk);\n          if (_rfDefMsgId) {\n            game.freeAttackBonusPending = game.freeAttackBonusPending || {};\n            game.freeAttackBonusPending[_rfDefMsgId] = true;\n            game.forcedAttackTarget = game.forcedAttackTarget || {};\n            game.forcedAttackTarget[_rfDefMsgId] = combat.attackerFigureKey;\n            const _rfOwnerId = getPlayerId(game\x2C _rfDefPN);\n            const _rfLabel = _rfDefIds.includes('return_fire_migs') ? 'Return Fire (Migs)' : 'Return Fire';\n            await thread.send(sanitizeMentions({\n              content: `<@${_rfOwnerId}> **${_rfLabel}** \u2014 Interrupt: perform a free attack targeting **${combat.attackerDcName}**! Use the **Attack** button on your DC card.`\x2C\n              allowedMentions: { users: [_rfOwnerId] }\x2C\n            })).catch(discordCatch);\n            await logGameAction(game\x2C client\x2C `**${_rfLabel}** \u2014 **${_rfDefDcName}** may interrupt to attack **${combat.attackerDcName}**.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n          }\n        }\n      }\n    }\n  }\n\n  // Defensive Fire (Bo-Katan): after resolving a ranged attack (as attacker)\x2C gain 1 Block Token\n  if (combat.isRanged && combat.attackerFigureKey) {\n    const _dfbEff = getDcEffect(combat.attackerDcName);\n    if ((_dfbEff?.specialAbilityIds || []).includes('defensive_fire_bokatan')) {\n      grantPowerTokens(game\x2C combat.attackerFigureKey\x2C 'Block'\x2C 1);\n      await thread.send(`**Defensive Fire** \u2014 **${combat.attackerDcName}** gains 1 **Block Token** after ranged attack.`).catch(discordCatch);\n      await logGameAction(game\x2C client\x2C `**Defensive Fire** \u2014 **${combat.attackerDcName}** gains 1 Block Token.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n    }\n  }\n  // Dual-Wield Pistols (Bo-Katan): after resolving a ranged attack\x2C free ranged attack once/round\n  if (combat.isRanged && combat.attackerFigureKey && combat.attackerMsgId) {\n    const _dwpEff = getDcEffect(combat.attackerDcName);\n    if ((_dwpEff?.specialAbilityIds || []).includes('dual_wield_pistols_bokatan')) {\n      const _dwpKey = `dualWieldPistols_${combat.attackerFigureKey}`;\n      if (!game.roundFigureAbilityUsed?.[_dwpKey]) {\n        game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n        game.roundFigureAbilityUsed[_dwpKey] = true;\n        game.freeAttackBonusPending = game.freeAttackBonusPending || {};\n        game.freeAttackBonusPending[combat.attackerMsgId] = true;\n        await thread.send(`**Dual-Wield Pistols** \u2014 **${combat.attackerDcName}** may perform a free Ranged attack! Use the **Attack** button.`).catch(discordCatch);\n        await logGameAction(game\x2C client\x2C `**Dual-Wield Pistols** \u2014 **${combat.attackerDcName}** earns a free Ranged attack.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n      }\n    }\n  }\n\n  // Wanton Destruction (Saw Gerrera): after ANY friendly attack resolves\x2C discard 1 CC \u2192 up to 2 figures (not defender) within 2 of target suffer 1 Damage\n  if (combat.target?.figureKey && game.selectedMap?.id) {\n    const _wdAtkPN = combat.attackerPlayerNum;\n    const _wdDefPN = combat.defenderPlayerNum ?? opponentPlayerNum(_wdAtkPN);\n    const _wdDcList = getDcList(game\x2C _wdAtkPN) || [];\n    const _wdEffects = getDcEffects();\n    for (let _wdI = 0; _wdI < _wdDcList.length; _wdI++) {\n      const _wdDc = _wdDcList[_wdI];\n      if (!_wdDc || _wdDc.defeated) continue;\n      const _wdEff = _wdEffects[_wdDc.dcName];\n      if (!((_wdEff?.specialAbilityIds || []).includes('wanton_destruction_saw'))) continue;\n      // Check Saw is alive (has a figure on the board)\n      const _wdFigs = game.figurePositions?.[_wdAtkPN] || {};\n      const _wdAlive = Object.keys(_wdFigs).some(fk => fk.startsWith(_wdDc.dcName + '-') && _wdFigs[fk]);\n      if (!_wdAlive) continue;\n      // Check player has at least 1 CC in hand\n      const _wdHand = getCcHand(game\x2C _wdAtkPN) || [];\n      if (_wdHand.length === 0) continue;\n      // Find eligible figures within 2 spaces of target (both teams\x2C excluding defender)\n      const _wdTargetPos = game.figurePositions?.[_wdDefPN]?.[combat.target.figureKey] || combat._savedTargetPos;\n      if (!_wdTargetPos) continue;\n      const _wdEligible = [];\n      for (const pn of [1\x2C 2]) {\n        for (const [fk\x2C pos] of Object.entries(game.figurePositions?.[pn] || {})) {\n          if (!pos || fk === combat.target.figureKey) continue;\n          if (!isWithinN(pos\x2C _wdTargetPos\x2C 2\x2C game.selectedMap.id)) continue;\n          const { label: lbl } = getFigureLabel(game\x2C pn\x2C fk);\n          _wdEligible.push({ figureKey: fk\x2C playerNum: pn\x2C label: lbl });\n        }\n      }\n      if (_wdEligible.length === 0) continue;\n      const _wdOwnerId = getPlayerId(game\x2C _wdAtkPN);\n      game.pendingWantonDestruction = {\n        gameId: game.gameId\x2C\n        ownerPlayerNum: _wdAtkPN\x2C\n        combatThreadId: combat.combatThreadId\x2C\n        targets: _wdEligible\x2C\n        chosen: []\x2C\n        maxPicks: 2\x2C\n      };\n      const _wdBtns = [\n        new ButtonBuilder().setCustomId(`wanton_use_${game.gameId}`).setLabel('Use (discard 1 CC)').setStyle(ButtonStyle.Danger)\x2C\n        new ButtonBuilder().setCustomId(`wanton_skip_${game.gameId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary)\x2C\n      ];\n      await thread.send(sanitizeMentions({\n        content: `<@${_wdOwnerId}> **Wanton Destruction** \u2014 **${_wdDc.dcName}**: Discard 1 CC to deal 1 Damage to up to 2 figures within 2 spaces of the target?`\x2C\n        allowedMentions: { users: [_wdOwnerId] }\x2C\n        components: [new ActionRowBuilder().addComponents(_wdBtns)]\x2C\n      })).catch(discordCatch);\n      break;\n    }\n  }\n\n  delete game.pendingCombat;\n  delete game.pendingCleave;\n  if (combat.rollMessageId) {\n    try {\n      const rollMsg = await thread.messages.fetch(combat.rollMessageId);\n      await rollMsg.edit({ components: [] }).catch(discordCatch);\n    } catch {}\n  }\n  // Autofire chain attack: grant free attack restricted to within 3 of target\n  if (combat.autofireChainPending && combat.attackerMsgId) {\n    game.fellSwoopFreeAttack = game.fellSwoopFreeAttack || {};\n    game.fellSwoopFreeAttack[combat.attackerMsgId] = true;\n    if (combat.autofireChainTargetSpace) {\n      game.autofireChainTargetSpace = game.autofireChainTargetSpace || {};\n      game.autofireChainTargetSpace[combat.attackerMsgId] = combat.autofireChainTargetSpace;\n    }\n    await logGameAction(game\x2C client\x2C `**Autofire** \u2014 Chain attack available! Target must be within 3 of the original target space.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  }\n  // The Darksaber: "then you may perform an attack" \u2014 grant second free attack\n  if (game.darksaberSecondAttack?.[combat.attackerMsgId]) {\n    delete game.darksaberSecondAttack[combat.attackerMsgId];\n    game.freeAttackBonusPending = game.freeAttackBonusPending || {};\n    game.freeAttackBonusPending[combat.attackerMsgId] = { from: 'Darksaber Strike' };\n    // Clear the override so the second attack uses normal dice\n    if (game.pendingOverrideAttackDice?.[combat.attackerMsgId]) delete game.pendingOverrideAttackDice[combat.attackerMsgId];\n    await thread.send('**The Darksaber** \u2014 You may now perform a normal attack (use Attack button).').catch(discordCatch);\n  }\n  // Focus Fire: after first attack\x2C enforce same target for second attack\n  if (game.focusFireActive?.[combat.attackerMsgId]) {\n    const ff = game.focusFireActive[combat.attackerMsgId];\n    ff.attacksRemaining -= 1;\n    if (ff.attacksRemaining > 0) {\n      // Store first target \u2014 second attack must hit the same figure\n      game.forcedAttackTarget = game.forcedAttackTarget || {};\n      game.forcedAttackTarget[combat.attackerMsgId] = combat.defenderFigureKey;\n      game.freeAttackBonusPending = game.freeAttackBonusPending || {};\n      game.freeAttackBonusPending[combat.attackerMsgId] = { from: 'Focus Fire' };\n      await thread.send(`**Focus Fire** \u2014 1 attack remaining. Must target the **same figure**. Use the Attack button.`).catch(discordCatch);\n    } else {\n      delete game.focusFireActive[combat.attackerMsgId];\n    }\n  }\n  // Multi-Fire: after first attack\x2C enforce different target + apply -1 Hit for second attack\n  if (game.multiFireActive?.[combat.attackerMsgId]) {\n    const mf = game.multiFireActive[combat.attackerMsgId];\n    mf.attacksRemaining -= 1;\n    if (mf.attacksRemaining > 0) {\n      mf.firstTargetFigureKey = combat.defenderFigureKey;\n      // Block same target for second attack\n      game.multiFireBlockedTarget = game.multiFireBlockedTarget || {};\n      game.multiFireBlockedTarget[combat.attackerMsgId] = combat.defenderFigureKey;\n      // Apply -1 Hit to second attack too\n      game.pendingOverrideAttackDice = game.pendingOverrideAttackDice || {};\n      game.pendingOverrideAttackDice[combat.attackerMsgId] = { bonusHits: -1 };\n      game.freeAttackBonusPending = game.freeAttackBonusPending || {};\n      game.freeAttackBonusPending[combat.attackerMsgId] = { from: 'Multi-Fire' };\n      await thread.send(`**Multi-Fire** \u2014 1 attack remaining. Must target a **different figure** (\\u22121 Hit). Use the Attack button.`).catch(discordCatch);\n    } else {\n      delete game.multiFireActive[combat.attackerMsgId];\n      if (game.multiFireBlockedTarget?.[combat.attackerMsgId]) delete game.multiFireBlockedTarget[combat.attackerMsgId];\n    }\n  }\n  // Saber Orbit (Second Sister): re-apply override dice for remaining chained attacks\n  if (game.saberOrbitAttacksRemaining?.[combat.attackerMsgId] > 0) {\n    game.saberOrbitAttacksRemaining[combat.attackerMsgId] -= 1;\n    const soRemaining = game.saberOrbitAttacksRemaining[combat.attackerMsgId];\n    if (soRemaining > 0) {\n      // Re-set the override dice for the next Saber Orbit attack\n      game.pendingOverrideAttackDice = game.pendingOverrideAttackDice || {};\n      game.pendingOverrideAttackDice[combat.attackerMsgId] = { dice: ['red']\x2C type: 'melee'\x2C pierce: 0\x2C bonusAccuracy: 0 };\n      await thread.send(`**Saber Orbit** \u2014 ${soRemaining} attack${soRemaining !== 1 ? 's' : ''} remaining (1 red die\x2C Melee). Use the Attack button.`).catch(discordCatch);\n    } else {\n      delete game.saberOrbitAttacksRemaining[combat.attackerMsgId];\n      await thread.send('**Saber Orbit** \u2014 All attacks resolved.').catch(discordCatch);\n    }\n  }\n\n  // Bladestorm: after attack resolves\x2C all hostiles within N spaces of attacker suffer AoE damage\n  if (combat.postAttackAoeDamage > 0 && combat.hit) {\n    const aoeDmg = combat.postAttackAoeDamage;\n    const aoeRange = combat.postAttackAoeRange || 2;\n    const atkFk = combat.attackerFigureKey;\n    const atkPos = game.figurePositions?.[combat.attackerPlayerNum]?.[atkFk];\n    const defPn = combat.defenderPlayerNum;\n    if (atkPos) {\n      const aoeParts = [];\n      for (const [fk\x2C coord] of Object.entries(game.figurePositions?.[defPn] || {})) {\n        if (!coord || fk === combat.defenderFigureKey) continue;\n        const dist = countGameSpaces(game\x2C atkPos\x2C coord);\n        if (dist > aoeRange) continue;\n        const fMsgId = findDcMessageIdForFigure(game.gameId\x2C defPn\x2C fk);\n        if (!fMsgId) continue;\n        const hs = dcHealthState.get(fMsgId) || [];\n        const fkMatch = fk.match(/-(\\d+)-(\\d+)$/);\n        const figIdx = fkMatch ? parseInt(fkMatch[2]\x2C 10) : 0;\n        const hp = hs[figIdx];\n        if (hp) {\n          const [cur\x2C max] = hp;\n          const newCur = Math.max(0\x2C (cur ?? max) - aoeDmg);\n          hs[figIdx] = [newCur\x2C max];\n          dcHealthState.set(fMsgId\x2C hs);\n          syncHealthStateToList(game\x2C defPn\x2C fMsgId\x2C hs);\n          aoeParts.push(`**${dcNameFromFigureKey(fk)}** ${aoeDmg} Dmg (${cur ?? max}\\u2192${newCur})`);\n          if (!embedRefreshMsgIds.includes(fMsgId)) embedRefreshMsgIds.push(fMsgId);\n        }\n      }\n      if (aoeParts.length > 0) {\n        await thread.send(`**Bladestorm** \u2014 Hostiles within ${aoeRange} spaces: ${aoeParts.join('\x2C ')}`).catch(discordCatch);\n      }\n    }\n  }\n  // Blood Feud: check if defender's DC has a persistent Blood Feud marker \u2192 auto +1 Hit\n  if (combat.hit && game.bloodFeudTargets?.[combat.defenderMsgId] && game.bloodFeudTargets[combat.defenderMsgId] === combat.attackerPlayerNum) {\n    // Already applied during CC play for the first attack; for subsequent attacks the bonus is applied in combat.js pre-roll\n  }\n\n  for (const msgId of embedRefreshMsgIds) {\n    try {\n      const meta = dcMessageMeta.get(msgId);\n      if (meta) {\n        const channelId = getPlayAreaId(game\x2C meta.playerNum);\n        const channel = await fetchGameChannel(client\x2C channelId);\n        if (!channel) continue;\n        const dcMsg = await channel.messages.fetch(msgId);\n        const { embed\x2C files } = await renderDcEmbed(game\x2C msgId\x2C deps);\n        await dcMsg.edit({ embeds: [embed]\x2C files }).catch(discordCatch);\n      }\n    } catch (err) {\n      console.error('Failed to update DC embed:'\x2C err);\n    }\n  }\n  if (game.boardId && game.selectedMap) {\n    try {\n      const boardChannel = await fetchGameChannel(client\x2C game.boardId);\n      const payload = await buildBoardMapPayload(game.gameId\x2C game.selectedMap\x2C game);\n      await boardChannel.send(payload);\n    } catch (err) {\n      console.error('Failed to update map after attack:'\x2C err);\n    }\n  }\n  // Refresh activation thread minimap after combat (conditions/actions may have changed)\n  if (combat.attackerMsgId) {\n    await updateDcActionsMessage(game\x2C combat.attackerMsgId\x2C client).catch(discordCatch);\n  }\n  // G73: Power Token Overflow \u2014 if any tokens were granted beyond the cap during combat\n  // resolution\x2C prompt the owning player to discard down.\n  if (game.pendingPowerTokenOverflow?.length > 0 && thread) {\n    // Determine the owning player from the first overflow entry's figureKey\n    const _ptOvEntry = game.pendingPowerTokenOverflow[0];\n    const _ptOvPlayerNum = Object.entries(game.figurePositions || {}).find(([\x2C figs]) => figs?.[_ptOvEntry.figureKey])?.[0];\n    const attackerPlayerNum = combat.attackerPlayerNum;\n    const _ptOvPN = _ptOvPlayerNum ? parseInt(_ptOvPlayerNum\x2C 10) : attackerPlayerNum;\n    await sendPowerTokenOverflowUI(game\x2C game.gameId\x2C thread\x2C _ptOvPN\x2C saveGames);\n  }\n}\n
