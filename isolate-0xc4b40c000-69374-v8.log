code-creation,Script,9,174137,0x3f05b92842e8,76, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/spatial.js:1:1,0x3c1234ea38d0,~
script-source,171,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/spatial.js,/**\n * Pure spatial utilities for Imperial Assault grid.\n * Zero Discord dependency\x2C zero game mutation.\n * Manhattan distance\x2C LOS\x2C BFS adjacency\x2C figure enumeration.\n */\nimport { parseCoord\x2C colRowToCoord\x2C getFootprintCells } from './coords.js';\n\n/**\n * Manhattan distance between two coords.\n * Returns 999 if either coord is unparseable.\n * @param {string} coord1\n * @param {string} coord2\n * @returns {number}\n */\nexport function getRange(coord1\x2C coord2) {\n  const a = parseCoord(coord1);\n  const b = parseCoord(coord2);\n  if (a.col < 0 || a.row < 0 || b.col < 0 || b.row < 0) return 999;\n  return Math.abs(a.col - b.col) + Math.abs(a.row - b.row);\n}\n\n/**\n * Whether two coords are exactly adjacent (Manhattan distance === 1).\n * @param {string} coord1\n * @param {string} coord2\n * @returns {boolean}\n */\nexport function isAdjacentCoords(coord1\x2C coord2) {\n  return getRange(coord1\x2C coord2) === 1;\n}\n\n/**\n * Whether two coords are within range (Manhattan distance <= range).\n * @param {string} coord1\n * @param {string} coord2\n * @param {number} range\n * @returns {boolean}\n */\nexport function isWithinRange(coord1\x2C coord2\x2C range) {\n  return getRange(coord1\x2C coord2) <= range;\n}\n\n// \u2500\u2500 LOS helpers (private) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfunction impassableEdgeToWallSegment(c1\x2C c2) {\n  const a = parseCoord(String(c1).toLowerCase());\n  const b = parseCoord(String(c2).toLowerCase());\n  if (a.col < 0 || b.col < 0) return null;\n  const dc = b.col - a.col;\n  const dr = b.row - a.row;\n  if (Math.abs(dc) + Math.abs(dr) !== 1) return null;\n  if (dr === 0) {\n    const x = Math.min(a.col\x2C b.col) + 0.5;\n    return { x1: x\x2C y1: a.row - 0.5\x2C x2: x\x2C y2: a.row + 0.5 };\n  } else {\n    const y = Math.min(a.row\x2C b.row) + 0.5;\n    return { x1: a.col - 0.5\x2C y1: y\x2C x2: a.col + 0.5\x2C y2: y };\n  }\n}\n\nfunction segmentsStrictlyIntersect(x1\x2C y1\x2C x2\x2C y2\x2C x3\x2C y3\x2C x4\x2C y4) {\n  const d1x = x2 - x1\x2C d1y = y2 - y1;\n  const d2x = x4 - x3\x2C d2y = y4 - y3;\n  const denom = d1x * d2y - d1y * d2x;\n  if (Math.abs(denom) < 1e-10) return false;\n  const t = ((x3 - x1) * d2y - (y3 - y1) * d2x) / denom;\n  const u = ((x3 - x1) * d1y - (y3 - y1) * d1x) / denom;\n  const EPS = 1e-6;\n  return t > EPS && t < 1 - EPS && u > EPS && u < 1 - EPS;\n}\n\nfunction getCellsAlongLine(x1\x2C y1\x2C x2\x2C y2) {\n  const dx = x2 - x1\x2C dy = y2 - y1;\n  const len = Math.sqrt(dx * dx + dy * dy);\n  const seen = new Set();\n  const result = [];\n  const steps = Math.max(Math.ceil(len * 4)\x2C 1);\n  for (let i = 0; i <= steps; i++) {\n    const t = i / steps;\n    const col = Math.round(x1 + t * dx);\n    const row = Math.round(y1 + t * dy);\n    const key = `${col}\x2C${row}`;\n    if (!seen.has(key)) { seen.add(key); result.push([col\x2C row]); }\n  }\n  return result;\n}\n\n// Grid corners are at half-integer coordinates (col+0.5\x2C row+0.5).\n// Returns every corner the open segment threads (excludes endpoints themselves).\n// Only diagonal-slope rays thread corners; axis-aligned rays never do.\nfunction getThreadedCorners(x1\x2C y1\x2C x2\x2C y2) {\n  const dx = x2 - x1\x2C dy = y2 - y1;\n  const EPS = 1e-9;\n  const corners = [];\n  const xMin = Math.min(x1\x2C x2)\x2C xMax = Math.max(x1\x2C x2);\n  const yMin = Math.min(y1\x2C y2)\x2C yMax = Math.max(y1\x2C y2);\n  const kMin = Math.ceil(xMin - 0.5 - EPS);\n  const kMax = Math.floor(xMax - 0.5 + EPS);\n  const lMin = Math.ceil(yMin - 0.5 - EPS);\n  const lMax = Math.floor(yMax - 0.5 + EPS);\n  for (let k = kMin; k <= kMax; k++) {\n    for (let l = lMin; l <= lMax; l++) {\n      const cx = k + 0.5\x2C cy = l + 0.5;\n      let t;\n      if (Math.abs(dx) >= Math.abs(dy)) {\n        if (Math.abs(dx) < EPS) continue;\n        t = (cx - x1) / dx;\n      } else {\n        t = (cy - y1) / dy;\n      }\n      if (t <= EPS || t >= 1 - EPS) continue;\n      const px = x1 + t * dx\x2C py = y1 + t * dy;\n      if (Math.abs(px - cx) > 1e-6 || Math.abs(py - cy) > 1e-6) continue;\n      corners.push([cx\x2C cy]);\n    }\n  }\n  return corners;\n}\n\n// \u2500\u2500 LOS (public) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Corner-to-corner LOS check per IA rules.\n * LOS exists if ANY line from a corner of coord1 to a corner of coord2\n * is unobstructed by blocking terrain or solid walls (impassable edges).\n * @param {string} coord1\n * @param {string} coord2\n * @param {object} mapSpaces - { blocking\x2C impassableEdges }\n * @param {Set<string>|null} [figureBlockingCoords] - additional blocking coords (large figures)\n * @returns {boolean}\n */\nexport function hasLineOfSight(coord1\x2C coord2\x2C mapSpaces\x2C figureBlockingCoords) {\n  const blockingSet = new Set((mapSpaces?.blocking || []).map((s) => String(s).toLowerCase()));\n  const impassableEdges = mapSpaces?.impassableEdges || [];\n  const a = parseCoord(coord1);\n  const b = parseCoord(coord2);\n  if (a.col < 0 || a.row < 0 || b.col < 0 || b.row < 0) return false;\n  if (a.col === b.col && a.row === b.row) return true;\n\n  const walls = [];\n  for (const edge of impassableEdges) {\n    const seg = impassableEdgeToWallSegment(edge[0]\x2C edge[1]);\n    if (seg) walls.push(seg);\n  }\n\n  const INSET = 0.49;\n  const corners = (col\x2C row) => [\n    [col - INSET\x2C row - INSET]\x2C\n    [col + INSET\x2C row - INSET]\x2C\n    [col - INSET\x2C row + INSET]\x2C\n    [col + INSET\x2C row + INSET]\x2C\n  ];\n\n  const aCorners = corners(a.col\x2C a.row);\n  const bCorners = corners(b.col\x2C b.row);\n\n  // IACP LOS rule: from any single point on the attacker's space\x2C must see\n  // at least 2 corners of the target's space.  We test from each attacker\n  // corner as representative points.\n  for (const [ax\x2C ay] of aCorners) {\n    let visibleTargetCorners = 0;\n    for (const [bx\x2C by] of bCorners) {\n      let wallBlocked = false;\n      for (const w of walls) {\n        if (segmentsStrictlyIntersect(ax\x2C ay\x2C bx\x2C by\x2C w.x1\x2C w.y1\x2C w.x2\x2C w.y2)) {\n          wallBlocked = true;\n          break;\n        }\n      }\n      if (wallBlocked) continue;\n      const cells = getCellsAlongLine(ax\x2C ay\x2C bx\x2C by);\n      let spaceBlocked = false;\n      for (const [col\x2C row] of cells) {\n        if (col === a.col && row === a.row) continue;\n        if (col === b.col && row === b.row) continue;\n        if (blockingSet.has(colRowToCoord(col\x2C row))) { spaceBlocked = true; break; }\n        if (figureBlockingCoords?.has(colRowToCoord(col\x2C row))) { spaceBlocked = true; break; }\n      }\n      if (!spaceBlocked) {\n        // CRR p.22 / p.28: LOS cannot trace through a corner where\n        // \u22652 obstacles (walls\x2C blocking terrain\x2C energy shields) intersect.\n        // Only diagonal-slope rays thread half-integer grid corners.\n        let cornerBlocked = false;\n        for (const [cx\x2C cy] of getThreadedCorners(ax\x2C ay\x2C bx\x2C by)) {\n          let count = 0;\n          const k = Math.round(cx - 0.5)\x2C l = Math.round(cy - 0.5);\n          for (const [cc\x2C cr] of [[k\x2C l]\x2C [k + 1\x2C l]\x2C [k\x2C l + 1]\x2C [k + 1\x2C l + 1]]) {\n            if (cc === a.col && cr === a.row) continue;\n            if (cc === b.col && cr === b.row) continue;\n            const coord = colRowToCoord(cc\x2C cr);\n            if (blockingSet.has(coord) || figureBlockingCoords?.has(coord)) count++;\n          }\n          for (const w of walls) {\n            if ((Math.abs(w.x1 - cx) < 1e-6 && Math.abs(w.y1 - cy) < 1e-6) ||\n                (Math.abs(w.x2 - cx) < 1e-6 && Math.abs(w.y2 - cy) < 1e-6)) count++;\n          }\n          if (count >= 2) { cornerBlocked = true; break; }\n        }\n        if (!cornerBlocked) visibleTargetCorners++;\n      }\n      if (visibleTargetCorners >= 2) return true;\n    }\n  }\n  return false;\n}\n\n// \u2500\u2500 Figure enumeration \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Collect all figure coordinates from both players (normalized to lowercase).\n * Used as the blocking-figure list for LOS checks.\n * @param {object} game\n * @returns {Set<string>}\n */\nexport function getAllFigureCoords(game) {\n  const coords = new Set();\n  for (const [\x2C fp] of Object.entries(game.figurePositions?.[1] || {})) if (fp) coords.add(String(fp).toLowerCase());\n  for (const [\x2C fp] of Object.entries(game.figurePositions?.[2] || {})) if (fp) coords.add(String(fp).toLowerCase());\n  return coords;\n}\n\n// \u2500\u2500 BFS adjacency \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * BFS adjacency check: can you walk from coordA to coordB in <= maxDist steps\n * using the map's adjacency graph?\n * @param {object} mapSpaces - { adjacency: { [coord]: string[] } }\n * @param {string} coordA\n * @param {string} coordB\n * @param {number} maxDist\n * @returns {boolean}\n */\nexport function isWithinSpaces(mapSpaces\x2C coordA\x2C coordB\x2C maxDist) {\n  if (!mapSpaces?.adjacency || !coordA || !coordB) return false;\n  const a = coordA.toLowerCase()\x2C b = coordB.toLowerCase();\n  if (a === b) return true;\n  const visited = new Set([a]);\n  let frontier = [a];\n  for (let d = 1; d <= maxDist; d++) {\n    const next = [];\n    for (const c of frontier) {\n      for (const adj of (mapSpaces.adjacency[c] || [])) {\n        const s = String(adj).toLowerCase();\n        if (s === b) return true;\n        if (!visited.has(s)) { visited.add(s); next.push(s); }\n      }\n    }\n    frontier = next;\n    if (!frontier.length) break;\n  }\n  return false;\n}\n\n/**\n * Counting-spaces distance: BFS shortest-path on the map adjacency graph.\n * Returns the number of movement steps a small figure would need.\n * Respects walls/blocking terrain (pre-excluded from adjacency graph).\n * Optionally blocks closed-door edges via blockedEdges set.\n * @param {object} mapSpaces - { adjacency: { [coord]: string[] } }\n * @param {string} coordA - source coord\n * @param {string} coordB - target coord\n * @param {Set<string>|null} [blockedEdges] - edgeKey-format strings for closed doors\n * @param {number} [maxDist=50] - BFS depth cap\n * @returns {number} distance (0 if same\x2C Infinity if unreachable)\n */\nexport function countSpaces(mapSpaces\x2C coordA\x2C coordB\x2C blockedEdges = null\x2C maxDist = 50) {\n  if (!mapSpaces?.adjacency || !coordA || !coordB) return Infinity;\n  const a = coordA.toLowerCase()\x2C b = coordB.toLowerCase();\n  if (a === b) return 0;\n  const visited = new Set([a]);\n  let frontier = [a];\n  for (let d = 1; d <= maxDist; d++) {\n    const next = [];\n    for (const c of frontier) {\n      for (const adj of (mapSpaces.adjacency[c] || [])) {\n        const s = String(adj).toLowerCase();\n        if (blockedEdges) {\n          const ek = [c\x2C s].sort().join('|');\n          if (blockedEdges.has(ek)) continue;\n        }\n        if (s === b) return d;\n        if (!visited.has(s)) { visited.add(s); next.push(s); }\n      }\n    }\n    frontier = next;\n    if (!frontier.length) break;\n  }\n  return Infinity;\n}\n\n// \u2500\u2500 Figure enumeration \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Get all figure keys within Manhattan range of a coord.\n * Accounts for large figure footprints \u2014 distance is computed to the closest footprint cell.\n * @param {object} game - game state with figurePositions\x2C figureOrientations\n * @param {string} coord - center coord\n * @param {number} range - max Manhattan distance\n * @param {number|null} [playerNum] - filter to specific player (null = both)\n * @returns {Array<{figureKey: string\x2C playerNum: number\x2C coord: string\x2C distance: number}>}\n */\nexport function getFiguresWithinRange(game\x2C coord\x2C range\x2C playerNum = null) {\n  const results = [];\n  const players = playerNum ? [playerNum] : [1\x2C 2];\n  for (const pn of players) {\n    const poses = game.figurePositions?.[pn] || {};\n    for (const [fk\x2C fCoord] of Object.entries(poses)) {\n      if (!fCoord) continue;\n      // For large figures\x2C compute distance to closest footprint cell\n      const size = game.figureOrientations?.[fk];\n      let d;\n      if (size && size !== '1x1') {\n        const cells = getFootprintCells(fCoord\x2C size);\n        d = Math.min(...cells.map(c => getRange(coord\x2C c)));\n      } else {\n        d = getRange(coord\x2C fCoord);\n      }\n      if (d <= range) results.push({ figureKey: fk\x2C playerNum: pn\x2C coord: fCoord\x2C distance: d });\n    }\n  }\n  return results;\n}\n\n/**\n * Get all figure keys adjacent (Manhattan distance === 1) to a coord.\n * @param {object} game\n * @param {string} coord\n * @param {number|null} [playerNum]\n * @returns {Array<{figureKey: string\x2C playerNum: number\x2C coord: string}>}\n */\nexport function getFiguresAdjacentTo(game\x2C coord\x2C playerNum = null) {\n  return getFiguresWithinRange(game\x2C coord\x2C 1\x2C playerNum)\n    .filter((f) => f.distance === 1);\n}\n
