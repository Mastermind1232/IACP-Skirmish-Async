script-source,197,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/headless/fake-interaction.js,/**\n * Fake Discord Interaction for headless testing.\n * Captures all replies/followUps for later inspection.\n *\n * Provides enough Discord API surface for all handlers to run:\n *   - channel.messages.fetch(id) \u2192 returns a fake message with edit()\x2C startThread()\n *   - message.startThread() \u2192 returns a fake thread channel with send()\n *   - channel.send() \u2192 returns a fake message\n *   - interaction.deferUpdate/followUp/editReply/reply \u2192 capture output\n */\n\nlet _globalMsgCounter = 0;\n\nfunction createFakeMessage(id\x2C channel) {\n  const msg = {\n    id\x2C\n    channel\x2C\n    content: ''\x2C\n    embeds: []\x2C\n    components: []\x2C\n    attachments: new Map()\x2C\n    author: { bot: true\x2C id: 'fake-bot' }\x2C\n    edit: async (payload) => {\n      if (typeof payload === 'string') {\n        msg.content = payload;\n      } else {\n        Object.assign(msg\x2C payload);\n      }\n      return msg;\n    }\x2C\n    startThread: async (opts = {}) => {\n      const threadId = `thread-${id}`;\n      const thread = createFakeChannel(threadId);\n      thread.name = opts.name || threadId;\n      thread.isThread = () => true;\n      thread.parent = channel;\n      thread.parentId = channel.id;\n      return thread;\n    }\x2C\n    delete: async () => {}\x2C\n    react: async () => {}\x2C\n    pin: async () => {}\x2C\n    unpin: async () => {}\x2C\n  };\n  return msg;\n}\n\nexport function createFakeChannel(channelId = 'fake-channel-1') {\n  const sentMessages = [];\n  const messageStore = new Map();\n\n  const channel = {\n    id: channelId\x2C\n    name: channelId\x2C\n    messages: {\n      fetch: async (idOrOpts) => {\n        // fetch(id) \u2192 single message; fetch() \u2192 Map of all\n        if (typeof idOrOpts === 'string') {\n          if (!messageStore.has(idOrOpts)) {\n            // Auto-create missing messages so handlers don't crash\n            const msg = createFakeMessage(idOrOpts\x2C channel);\n            messageStore.set(idOrOpts\x2C msg);\n          }\n          return messageStore.get(idOrOpts);\n        }\n        // Return a Map-like object with Collection methods (find\x2C filter)\n        // so code expecting Discord Collection works\n        const result = new Map(messageStore);\n        result.find = (fn) => {\n          for (const v of result.values()) {\n            if (fn(v)) return v;\n          }\n          return undefined;\n        };\n        result.filter = (fn) => {\n          const filtered = new Map();\n          for (const [k\x2C v] of result) {\n            if (fn(v\x2C k)) filtered.set(k\x2C v);\n          }\n          return filtered;\n        };\n        return result;\n      }\x2C\n    }\x2C\n    send: async (payload) => {\n      const id = `fake-msg-${++_globalMsgCounter}`;\n      const msg = createFakeMessage(id\x2C channel);\n      if (typeof payload === 'string') {\n        msg.content = payload;\n      } else if (payload) {\n        Object.assign(msg\x2C payload);\n      }\n      messageStore.set(id\x2C msg);\n      sentMessages.push(msg);\n      return msg;\n    }\x2C\n    bulkDelete: async () => {}\x2C\n    _sentMessages: sentMessages\x2C\n    _messageStore: messageStore\x2C\n    isThread: () => false\x2C\n    isTextBased: () => true\x2C\n    delete: async () => {}\x2C\n    parent: null\x2C\n    parentId: null\x2C\n    type: 0\x2C\n    guild: { id: 'fake-guild' }\x2C\n  };\n\n  return channel;\n}\n\nexport function createFakeInteraction(customId\x2C userId\x2C options = {}) {\n  const sentMessages = [];\n  const channel = options.channel || createFakeChannel();\n\n  const interaction = {\n    customId\x2C\n    user: { id: userId\x2C username: options.username || 'TestPlayer' }\x2C\n    member: { id: userId }\x2C\n    message: createFakeMessage(options.messageId || 'fake-msg'\x2C channel)\x2C\n    channel\x2C\n    channelId: channel.id\x2C\n    guild: options.guild || {\n      id: 'fake-guild'\x2C\n      channels: { fetch: async () => channel }\x2C\n      members: { fetch: async (id) => ({ id\x2C displayName: `Player_${id}` }) }\x2C\n    }\x2C\n    values: options.values || []\x2C\n    fields: options.fields || { getTextInputValue: () => '' }\x2C\n\n    // Interaction methods \u2014 capture instead of sending to Discord\n    deferUpdate: async () => { sentMessages.push({ type: 'deferUpdate' }); }\x2C\n    deferReply: async (opts) => { sentMessages.push({ type: 'deferReply'\x2C ...opts }); }\x2C\n    followUp: async (payload) => {\n      const msg = { type: 'followUp'\x2C ...(typeof payload === 'string' ? { content: payload } : payload) };\n      sentMessages.push(msg);\n      return msg;\n    }\x2C\n    editReply: async (payload) => {\n      const msg = { type: 'editReply'\x2C ...(typeof payload === 'string' ? { content: payload } : payload) };\n      sentMessages.push(msg);\n      return msg;\n    }\x2C\n    reply: async (payload) => {\n      const msg = { type: 'reply'\x2C ...(typeof payload === 'string' ? { content: payload } : payload) };\n      sentMessages.push(msg);\n      return msg;\n    }\x2C\n    update: async (payload) => {\n      const msg = { type: 'update'\x2C ...(typeof payload === 'string' ? { content: payload } : payload) };\n      sentMessages.push(msg);\n      return msg;\n    }\x2C\n    showModal: async (modal) => {\n      sentMessages.push({ type: 'showModal'\x2C ...modal });\n    }\x2C\n\n    // Type checks (pretend to be a button by default)\n    isButton: () => options.type !== 'select' && options.type !== 'modal'\x2C\n    isStringSelectMenu: () => options.type === 'select'\x2C\n    isModalSubmit: () => options.type === 'modal'\x2C\n    isChatInputCommand: () => false\x2C\n    isAutocomplete: () => false\x2C\n\n    // Options for slash commands\n    options: {\n      getInteger: () => null\x2C\n      getString: () => null\x2C\n      getUser: () => null\x2C\n      getSubcommand: () => null\x2C\n    }\x2C\n\n    // Client reference (for handlers that use interaction.client.channels.fetch)\n    client: options.client || null\x2C\n\n    // Captured output\n    sentMessages\x2C\n  };\n\n  return interaction;\n}\n
