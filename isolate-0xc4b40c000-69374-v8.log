script-source,166,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/abilities.js,/**\n * F1 Ability library: lookup by id\x2C resolve surge (code-per-ability). No Discord.\n * Surge resolution uses combat.parseSurgeEffect; DCs still reference keys in dc-effects (surgeAbilities array).\n */\nimport { getAbilityLibrary\x2C getDcEffects\x2C getDiceData\x2C getCcEffect\x2C getCcEffectsData\x2C getMapData\x2C getMapTokensData } from '../data-loader.js';\nimport { parseCoord\x2C normalizeCoord\x2C getFootprintCells\x2C edgeKey } from './coords.js';\nimport { dcNameFromFigureKey\x2C parseFigureKey\x2C getMaxPowerTokens\x2C figureChoiceLabels } from './dc-helpers.js';\nimport { grantPowerTokens } from './game-helpers.js';\nimport { reduceHp\x2C healHp } from './damage-helpers.js';\nimport { awardObjectiveVp\x2C deductVp } from './vp-helpers.js';\nimport { countGameSpaces } from './board-helpers.js';\n\n\n/**\n * Decrement a figure's HP in a healthState array.\n * @param {Array} hs - healthState array for the DC (from dcHealthState.get(msgId))\n * @param {number} figIdx - figure index within the group\n * @param {number} amount - damage/strain to apply\n * @returns {{ prev: number\x2C cur: number\x2C max: number } | null} - HP change info\x2C or null if no figure\n */\nfunction decrementFigureHealth(hs\x2C figIdx\x2C amount) {\n  if (!hs?.[figIdx]) return null;\n  const [cur\x2C max] = hs[figIdx];\n  const prev = cur ?? max;\n  const newCur = Math.max(0\x2C prev - amount);\n  hs[figIdx] = [newCur\x2C max ?? newCur];\n  return { prev\x2C cur: newCur\x2C max: max ?? newCur };\n}\n\n/**\n * Get uppercased keywords for a DC by name.\n * @param {string} dcName - DC name (e.g. from dcNameFromFigureKey)\n * @returns {string[]} - uppercased keyword array (e.g. ['MOBILE'\x2C 'TROOPER'])\n */\nfunction getKeywordsUpper(dcName) {\n  return (getDcEffects()?.[dcName]?.keywords || []).map(k => String(k).toUpperCase());\n}\n\n/** Look up DC stats by name (handles display variants). */\nfunction getStatsForDc(dcName) {\n  const map = getDcEffects() || {};\n  const base = (dcName || '').replace(/\\s*\\[.*\\]\\s*$/\x2C '').trim();\n  return map[base] || map[dcName] || (() => {\n    const key = Object.keys(map).find((k) => k.toLowerCase() === (base || dcName || '').toLowerCase());\n    return key ? map[key] : {};\n  })();\n}\nimport { applyCondition\x2C resetCondition\x2C filterCondition\x2C isConditionImmune\x2C HARMFUL_CONDITIONS } from './conditions.js';\nimport { parseSurgeEffect } from './combat.js';\nimport { getFiguresAdjacentToTarget\x2C getBoardStateForMovement\x2C getMovementProfile\x2C getReachableSpaces\x2C getEffectiveMapSpaces } from './movement.js';\nimport { getDcList\x2C getDcMessageIds\x2C getPlayerId\x2C getCcDiscard\x2C getSquad\x2C ccHandKey\x2C ccDiscardKey\x2C ccDeckKey\x2C vpKey\x2C armyCostModifierKey\x2C activatedDcIndicesKey\x2C opponentPlayerNum\x2C syncHealthStateToList\x2C pushFigure } from './player-helpers.js';\nimport { hasLineOfSight } from './spatial.js';\nimport { checkDeckDiscardPassiveRedraws } from './cc-passive-redraw.js';\n\n\n/**\n * Compute BFS shortest path between two spaces\x2C then detect hostile figures\n * whose adjacency the pushed figure exits along the way.\n * Used by Force Push\x2C Force Throw\x2C Wrist Cord\x2C etc. to log intermediate spaces\n * and warn about Parting Blow / similar triggers.\n *\n * @param {object} game\n * @param {string} fromPos - starting position (will be normalized)\n * @param {string} toPos - destination position (will be normalized)\n * @param {number} pushedFigurePlayerNum - which player owns the pushed figure\n * @returns {{ pathStr: string\x2C warnings: Array<{name:string\x2C space:string}> }}\n */\nfunction computePushPathAndWarnings(game\x2C fromPos\x2C toPos\x2C pushedFigurePlayerNum) {\n  const result = { pathStr: ''\x2C warnings: [] };\n  const mapId = game.selectedMap?.id;\n  const rawMapSpaces = mapId ? getMapData(mapId) : null;\n  if (!fromPos || !rawMapSpaces) return result;\n  const adjacency = rawMapSpaces.adjacency || {};\n  const startNorm = normalizeCoord(fromPos);\n  const destNorm = normalizeCoord(toPos);\n  if (startNorm === destNorm) return result;\n\n  // BFS to find shortest path (ignoring occupied spaces \u2014 pushed figures pass through)\n  const visited = new Map(); // coord \u2192 parent coord\n  visited.set(startNorm\x2C null);\n  const queue = [startNorm];\n  let found = false;\n  while (queue.length > 0 && !found) {\n    const cur = queue.shift();\n    for (const neighbor of (adjacency[cur] || []).map(n => normalizeCoord(n))) {\n      if (visited.has(neighbor)) continue;\n      visited.set(neighbor\x2C cur);\n      if (neighbor === destNorm) { found = true; break; }\n      queue.push(neighbor);\n    }\n  }\n  // Reconstruct path\n  const path = [];\n  if (found) {\n    let node = destNorm;\n    while (node !== null) {\n      path.unshift(node);\n      node = visited.get(node) ?? null;\n    }\n  }\n  if (path.length > 2) {\n    const intermediates = path.slice(1\x2C -1);\n    result.pathStr = ` via ${intermediates.map(c => `**${c.toUpperCase()}**`).join(' \\u2192 ')}`;\n  }\n\n  // Check at each space along the path if the pushed figure exits adjacency to any hostile figure\n  if (path.length >= 2) {\n    const hostilePn = pushedFigurePlayerNum === 1 ? 2 : 1;\n    const hostilePositions = game.figurePositions?.[hostilePn] || {};\n    const seenKeys = new Set();\n    for (let i = 0; i < path.length - 1; i++) {\n      const exitingSpace = path[i];\n      const enteringSpace = path[i + 1];\n      const exitAdj = new Set((adjacency[exitingSpace] || []).map(n => normalizeCoord(n)));\n      const enterAdj = new Set((adjacency[enteringSpace] || []).map(n => normalizeCoord(n)));\n      for (const [hfk\x2C hPos] of Object.entries(hostilePositions)) {\n        if (!hPos) continue;\n        const hPosNorm = normalizeCoord(hPos);\n        const hDcName = dcNameFromFigureKey(hfk);\n        const hSize = game.figureOrientations?.[hfk] || '1x1';\n        const hCells = getFootprintCells(hPosNorm\x2C hSize).map(c => normalizeCoord(c));\n        const isAdjacentBefore = hCells.some(c => exitAdj.has(c));\n        if (!isAdjacentBefore) continue;\n        const isAdjacentAfter = hCells.some(c => enterAdj.has(c) || c === enteringSpace);\n        if (!isAdjacentAfter) {\n          const warnKey = `${hfk}@${exitingSpace}`;\n          if (seenKeys.has(warnKey)) continue;\n          seenKeys.add(warnKey);\n          const warnName = hDcName.replace(/_/g\x2C ' ');\n          result.warnings.push({ name: warnName\x2C space: exitingSpace.toUpperCase() });\n        }\n      }\n    }\n  }\n  return result;\n}\n\n/** Get ability metadata by id. Returns { type\x2C surgeCost?\x2C label?\x2C ... } or null. */\nexport function getAbility(id) {\n  const lib = getAbilityLibrary();\n  return (lib?.abilities && lib.abilities[id]) || null;\n}\n\n/**\n * Resolve a surge ability id (same as key in dc-effects surgeAbilities) to modifiers.\n * Code-per-ability: surge effects are resolved via parseSurgeEffect (combat).\n * @param {string} abilityId - e.g. "damage 1"\x2C "pierce 2"\x2C "damage 1\x2C stun"\n * @returns {{ damage: number\x2C pierce: number\x2C accuracy: number\x2C conditions: string[] }}\n */\nexport function resolveSurgeAbility(abilityId) {\n  return parseSurgeEffect(abilityId);\n}\n\n/**\n * Display label for a surge ability. Uses ability library when present\x2C else raw id (for composites not in library).\n * @param {string} abilityId\n * @returns {string}\n */\nexport function getSurgeAbilityLabel(abilityId) {\n  const entry = getAbility(abilityId);\n  if (entry?.label) return entry.label;\n  // Strip double-surge prefix for display\n  return String(abilityId || '').replace(/^double:/\x2C '');\n}\n\n/**\n * Draw N command cards from deck to hand.\n * @param {object} game - Game state\n * @param {number} playerNum - 1 or 2\n * @param {number} n - Number of cards to draw\n * @returns {string[]} - Cards drawn (may be fewer if deck has fewer than n cards)\n */\nfunction drawCcCards(game\x2C playerNum\x2C n) {\n  const deckKey = ccDeckKey(playerNum);\n  const handKey = ccHandKey(playerNum);\n  const deck = (game[deckKey] || []).slice();\n  const hand = (game[handKey] || []).slice();\n  const drew = [];\n  for (let i = 0; i < n && deck.length > 0; i++) {\n    const card = deck.shift();\n    hand.push(card);\n    drew.push(card);\n  }\n  game[deckKey] = deck;\n  game[handKey] = hand;\n  return drew;\n}\n\n/**\n * Add N movement points to a figure's movement bank.\n * Initializes game.movementBank and the per-msgId entry if needed.\n * @param {object} game - Game state\n * @param {string} msgId - DC message ID\n * @param {number} n - Movement points to add\n */\nfunction addMovementPoints(game\x2C msgId\x2C n) {\n  game.movementBank = game.movementBank || {};\n  const bank = game.movementBank[msgId] || { total: 0\x2C remaining: 0 };\n  bank.total = (bank.total ?? 0) + n;\n  bank.remaining = (bank.remaining ?? 0) + n;\n  game.movementBank[msgId] = bank;\n}\n\n/**\n * F3/F4: Resolve a non-surge ability by id (DC special or CC effect). Code-per-ability; most return manual.\n * @param {string|null|undefined} abilityId - Library id or synthetic key (e.g. dc_special:DCName:0 or CC card name).\n * @param {object} context - { game\x2C ... } plus optional msgId\x2C meta\x2C playerNum\x2C cardName\x2C specialLabel.\n * @returns {{ applied: boolean\x2C manualMessage?: string\x2C drewCards?: string[]\x2C freeAction?: boolean\x2C grantsAction?: boolean\x2C requiresSpaceChoice?: boolean\x2C validSpaces?: string[] }}\n *   freeAction: true \u2014 ability costs no action; the caller will restore the action point that was decremented.\n */\nexport function resolveAbility(abilityId\x2C context) {\n  let entry = abilityId ? getAbility(abilityId) : null;\n  if (!entry || entry.type === 'surge') {\n    return { applied: false\x2C manualMessage: 'Resolve manually (see rules).' };\n  }\n\n  // ccEffect: chooseOne \u2014 player must pick one option; when choiceIndex is provided\x2C resolve that option\n  if (entry.type === 'ccEffect' && Array.isArray(entry.chooseOne) && entry.chooseOne.length > 0) {\n    const choiceIndex = context.choiceIndex;\n    if (choiceIndex == null || choiceIndex < 0 || choiceIndex >= entry.chooseOne.length) {\n      const choiceOptions = entry.chooseOne.map((o\x2C i) => o.label || `Option ${i + 1}`);\n      return {\n        applied: false\x2C\n        requiresChoice: true\x2C\n        choiceOptions\x2C\n        choiceCount: entry.chooseOne.length\x2C\n        manualMessage: `Choose one: ${choiceOptions.join('\x2C ')}.`\x2C\n      };\n    }\n    const chosen = entry.chooseOne[choiceIndex];\n    entry = { type: 'ccEffect'\x2C ...chosen };\n  }\n\n  // ccEffect: informational / log-only (e.g. Collect Intel \u2014 look at opponent hand)\n  if (entry.type === 'ccEffect' && entry.informational && (entry.logMessage != null || entry.label)) {\n    return {\n      applied: true\x2C\n      logMessage: entry.logMessage || entry.label || 'Resolve manually (see rules).'\x2C\n    };\n  }\n\n  // dcSpecial: chooseOne \u2014 player picks an option (e.g. Dual-Bladed Fury); resolve chosen option on second call\n  if (entry.type === 'dcSpecial' && Array.isArray(entry.chooseOne) && entry.chooseOne.length > 0) {\n    const choiceIndex = context.choiceIndex;\n    if (choiceIndex == null || choiceIndex < 0 || choiceIndex >= entry.chooseOne.length) {\n      const choiceOptions = entry.chooseOne.map((o\x2C i) => o.label || `Option ${i + 1}`);\n      return { applied: false\x2C requiresChoice: true\x2C choiceOptions\x2C choiceCount: entry.chooseOne.length };\n    }\n    // Second call: resolve chosen sub-entry\n    const chosen = entry.chooseOne[choiceIndex];\n    // Apply Focus to self\n    const { game\x2C msgId\x2C meta\x2C playerNum } = context;\n    const parts = [];\n    if (chosen.applyFocusToSelf && game && meta) {\n      const figureKeys = getFigureKeysForDcMsg(game\x2C playerNum\x2C meta);\n      for (const fk of figureKeys) {\n        applyCondition(game\x2C fk\x2C 'Focus');\n      }\n      parts.push('Became **Focused**');\n    }\n    // Grant bonus cleave for next attack via surge\n    if (typeof chosen.nextAttackCleave === 'number' && chosen.nextAttackCleave > 0 && game && playerNum) {\n      game.nextAttackBonusSurgeAbilities = game.nextAttackBonusSurgeAbilities || {};\n      const existing = game.nextAttackBonusSurgeAbilities[playerNum] || [];\n      game.nextAttackBonusSurgeAbilities[playerNum] = [...existing\x2C `cleave ${chosen.nextAttackCleave}`];\n    }\n    // Grant Reach for next attack (melee range extended to 2)\n    if (chosen.nextAttackReach && game && playerNum) {\n      game.nextAttackReach = game.nextAttackReach || {};\n      game.nextAttackReach[playerNum] = true;\n    }\n    if (chosen.nextAttackReach || chosen.nextAttackCleave) parts.push(`Next attack gains **${chosen.nextAttackReach ? 'Reach + ' : ''}Cleave ${chosen.nextAttackCleave || 0}** (attack targets up to 2 spaces away if Reach)`);\n    return { applied: true\x2C logMessage: `**${entry.label}**: ${parts.join(' and ')}.`\x2C refreshDcEmbed: !!chosen.applyFocusToSelf };\n  }\n\n  // dcSpecial: shuffleOneDiscardToDeck (Military Efficiency) \u2014 after attack\x2C shuffle 1 CC from discard back to deck\n  if (entry.type === 'dcSpecial' && entry.shuffleOneDiscardToDeck) {\n    const { game\x2C playerNum } = context;\n    if (!game || !playerNum) return { applied: false\x2C manualMessage: entry.label || 'Resolve manually (see rules).' };\n    if (game.restInPeaceActive) return { applied: true\x2C logMessage: '**Military Efficiency** \u2014 Blocked by **Rest in Peace** (cannot retrieve from discard this round).' };\n    const discardKey = ccDiscardKey(playerNum);\n    const deckKey = ccDeckKey(playerNum);\n    const discard = game[discardKey] || [];\n    if (discard.length === 0) return { applied: true\x2C logMessage: '**Military Efficiency** \u2014 No cards in discard to return.' };\n    // Shuffle the most-recently-discarded card back (auto-picks last discarded)\n    const toReturn = discard[discard.length - 1];\n    const newDiscard = discard.slice(0\x2C -1);\n    const deck = [...(game[deckKey] || [])];\n    const insertIdx = Math.floor(Math.random() * (deck.length + 1));\n    deck.splice(insertIdx\x2C 0\x2C toReturn);\n    game[discardKey] = newDiscard;\n    game[deckKey] = deck;\n    return { applied: true\x2C logMessage: `**Military Efficiency** \u2014 **${toReturn}** shuffled from discard back into your Command deck.`\x2C refreshDiscard: true };\n  }\n\n  // dcSpecial: pushTargetWithinRange (Force Throw\x2C Wrist Cord\x2C Mandalorian Whip) \u2014 pick a target\x2C then pick landing space\x2C then push.\n  // Phase 1 (no targetFigureKey): enumerate valid targets \u2192 requiresChoice.\n  // Phase 2 (targetFigureKey set\x2C no chosenSpace): enumerate valid landing spaces \u2192 requiresSpaceChoice.\n  // Phase 3 (targetFigureKey + chosenSpace set): apply position update.\n  if (entry.type === 'dcSpecial' && entry.pushTargetWithinRange && typeof entry.pushTargetWithinRange === 'object') {\n    const { range = 3\x2C requiresSmall = false\x2C requiresLos = false\x2C hostileOnly = false } = entry.pushTargetWithinRange;\n    const { mustAdjacentToActivator = false\x2C maxDistanceFromTarget } = entry.pushLandingEffect || {};\n    const { game\x2C playerNum\x2C meta\x2C msgId\x2C dcMessageMeta\x2C dcHealthState\x2C hasLineOfSight: losCheck\x2C getRange: getRng\x2C getMapData: getMs\x2C targetFigureKey\x2C chosenSpace } = context;\n    if (!game || !playerNum || !meta) return { applied: false\x2C manualMessage: `Resolve **${entry.label}** manually.` };\n    const enemyNum = opponentPlayerNum(playerNum);\n    const label = entry.label || 'Push';\n    // Resolve which player owns a given figure key (needed when targeting friendly or any figure)\n    const _findOwner = (fk) => {\n      if (game.figurePositions?.[1]?.[fk] != null) return 1;\n      if (game.figurePositions?.[2]?.[fk] != null) return 2;\n      return enemyNum; // fallback\n    };\n\n    // Phase 3: apply push to chosen space\n    if (targetFigureKey && chosenSpace) {\n      // Spiked Boots: cannot be pushed except by MASSIVE figures\n      const _pushTargetDcName = dcNameFromFigureKey(targetFigureKey);\n      const _pushTargetStats = getStatsForDc(_pushTargetDcName);\n      const _pushTargetSIds = _pushTargetStats?.specialAbilityIds || [];\n      if (_pushTargetSIds.includes('spiked_boots_snowtrooper')) {\n        const pusherDcName = meta?.dcName || '';\n        const pusherStats = getStatsForDc(pusherDcName);\n        const pusherKws = (pusherStats?.keywords || []).map(k => String(k).toUpperCase());\n        if (!pusherKws.includes('MASSIVE')) {\n          return { applied: false\x2C manualMessage: `**Spiked Boots** \u2014 **${_pushTargetDcName}** cannot be pushed except by MASSIVE figures.` };\n        }\n      }\n      const targetOwner = _findOwner(targetFigureKey);\n      const { prevPos } = pushFigure(game\x2C targetOwner\x2C targetFigureKey\x2C chosenSpace) || { prevPos: null };\n      // Deduct MP cost if applicable\n      if (entry.mpCostToActivate && game.movementBank?.[msgId]) {\n        game.movementBank[msgId].remaining = Math.max(0\x2C game.movementBank[msgId].remaining - entry.mpCostToActivate);\n      }\n      const dcDisplay = meta?.displayName || meta?.dcName || label;\n      const targetName = dcNameFromFigureKey(targetFigureKey);\n      // Post-push free attack (Mandalorian Whip): grant free attack targeting the pushed figure\n      if (entry.postPushFreeAttack) {\n        game.freeAttackBonusPending = game.freeAttackBonusPending || {};\n        game.freeAttackBonusPending[msgId] = true;\n        game.forcedAttackTarget = game.forcedAttackTarget || {};\n        game.forcedAttackTarget[msgId] = targetFigureKey;\n      }\n      // Compute path and adjacency-exit warnings for the push\n      const { pathStr: _pushPathStr\x2C warnings: _pushWarnings } = computePushPathAndWarnings(game\x2C prevPos\x2C chosenSpace\x2C targetOwner);\n      let _pushLogMsg = `**${label}** \u2014 **${dcDisplay}** pushed **${targetName}** from ${prevPos?.toUpperCase() ?? '?'} to ${String(chosenSpace).toUpperCase()}${_pushPathStr}.${entry.postPushFreeAttack ? ' Now attack that figure (free action).' : ''}`;\n      if (_pushWarnings.length > 0) {\n        const _warnList = _pushWarnings.map(w => `**${w.name}** (exited adj at ${w.space})`).join('\x2C ');\n        _pushLogMsg += `\\n\u26a0\ufe0f Exits adjacency to: ${_warnList} \u2014 opponent may play **Parting Blow** or similar interrupts.`;\n      }\n      return {\n        applied: true\x2C\n        logMessage: _pushLogMsg\x2C\n        refreshBoard: true\x2C\n        refreshMovementBank: !!entry.mpCostToActivate\x2C\n        activeMsgId: msgId\x2C\n      };\n    }\n\n    // Phase 2: target chosen \u2014 enumerate valid landing spaces\n    if (targetFigureKey && !chosenSpace) {\n      const targetOwnerP2 = _findOwner(targetFigureKey);\n      const targetPos = game.figurePositions?.[targetOwnerP2]?.[targetFigureKey];\n      if (!targetPos) return { applied: false\x2C manualMessage: `**${label}** \u2014 target figure has no position.` };\n      const activatingKeys = getFigureKeysForDcMsg(game\x2C playerNum\x2C meta);\n      const attackerKey = activatingKeys[game.dcActionsData?.[msgId]?.selectedFigure ?? 0] || activatingKeys[0];\n      const attackerPos = attackerKey ? game.figurePositions?.[playerNum]?.[attackerKey] : null;\n      const mapSpaces = getMs ? getMs(game.selectedMap?.id) : null;\n      if (!mapSpaces) return { applied: false\x2C manualMessage: `**${label}** \u2014 map data not available. Resolve manually.` };\n      // All occupied positions except the target (it can vacate its own space)\n      const occupiedSet = new Set([\n        ...Object.values(game.figurePositions?.[1] || {})\x2C\n        ...Object.values(game.figurePositions?.[2] || {})\x2C\n      ].filter(Boolean));\n      occupiedSet.delete(targetPos);\n      const validSpaces = [];\n      const _allCoords = mapSpaces.spaces || Object.keys(mapSpaces.adjacency || {});\n      for (const coord of _allCoords) {\n        if (occupiedSet.has(coord)) continue;\n        if (maxDistanceFromTarget != null) {\n          if (countGameSpaces(game\x2C targetPos\x2C coord) > maxDistanceFromTarget) continue;\n        }\n        if (mustAdjacentToActivator && attackerPos) {\n          if (countGameSpaces(game\x2C attackerPos\x2C coord) !== 1) continue;\n        }\n        validSpaces.push(coord);\n      }\n      if (validSpaces.length === 0) return { applied: false\x2C manualMessage: `**${label}** \u2014 no valid landing spaces. Resolve manually.` };\n      return { applied: false\x2C requiresSpaceChoice: true\x2C validSpaces\x2C targetFigureKey\x2C spaceChoiceLabel: `**${label}** \u2014 Pick a landing space for **${dcNameFromFigureKey(targetFigureKey)}**:` };\n    }\n\n    // Phase 1: enumerate valid SMALL targets within range (hostile only if hostileOnly flag set)\n    const activatingKeys = getFigureKeysForDcMsg(game\x2C playerNum\x2C meta);\n    const attackerKey = activatingKeys[game.dcActionsData?.[msgId]?.selectedFigure ?? 0] || activatingKeys[0];\n    const attackerPos = attackerKey ? game.figurePositions?.[playerNum]?.[attackerKey] : null;\n    const mapSpaces = getMs ? getMs(game.selectedMap?.id) : null;\n    const validTargets = [];\n    // Build candidate pool: hostile only\x2C or both sides\n    const _candidateEntries = [];\n    _candidateEntries.push(...Object.entries(game.figurePositions?.[enemyNum] || {}));\n    if (!hostileOnly) {\n      // Include friendly figures\x2C but exclude the activating figure itself\n      for (const [fk\x2C coord] of Object.entries(game.figurePositions?.[playerNum] || {})) {\n        if (fk === attackerKey) continue;\n        _candidateEntries.push([fk\x2C coord]);\n      }\n    }\n    for (const [fk\x2C coord] of _candidateEntries) {\n      if (!coord) continue;\n      // SMALL check: figures with LARGE or MASSIVE keywords are not small\n      const targetDcName = dcNameFromFigureKey(fk);\n      const targetStats = getStatsForDc(targetDcName);\n      const kwds = (targetStats?.keywords || []).map((k) => String(k).toUpperCase());\n      if (requiresSmall && (kwds.includes('LARGE') || kwds.includes('MASSIVE'))) continue;\n      // Spiked Boots: cannot be pushed except by MASSIVE figures\n      const _pushTargetSIdsP1 = targetStats?.specialAbilityIds || [];\n      if (_pushTargetSIdsP1.includes('spiked_boots_snowtrooper')) {\n        const _pusherDcName = meta?.dcName || '';\n        const _pusherStats = getStatsForDc(_pusherDcName);\n        const _pusherKws = (_pusherStats?.keywords || []).map(k => String(k).toUpperCase());\n        if (!_pusherKws.includes('MASSIVE')) continue;\n      }\n      // Range check\n      if (attackerPos && countGameSpaces(game\x2C attackerPos\x2C coord) > range) continue;\n      // LOS check\n      if (requiresLos && losCheck && attackerPos && mapSpaces) {\n        if (!losCheck(attackerPos\x2C coord\x2C mapSpaces)) continue;\n      }\n      validTargets.push(fk);\n    }\n    if (validTargets.length === 0) return { applied: false\x2C manualMessage: `**${label}** \u2014 no valid SMALL targets in range. Resolve manually if applicable.` };\n    // Deduct strain cost on activation (paid when ability is triggered\x2C not when target is resolved)\n    let strainApplied = false;\n    if (entry.strainCostToSelf > 0 && dcHealthState && msgId) {\n      const selectedFig = game.dcActionsData?.[msgId]?.selectedFigure ?? 0;\n      const healthState = dcHealthState.get(msgId) || [];\n      if (healthState[selectedFig]) {\n        const [cur\x2C max] = healthState[selectedFig];\n        const newCur = Math.max(0\x2C (cur ?? max) - entry.strainCostToSelf);\n        healthState[selectedFig] = [newCur\x2C max ?? newCur];\n        dcHealthState.set(msgId\x2C healthState);\n        syncHealthStateToList(game\x2C playerNum\x2C msgId\x2C healthState);\n        strainApplied = true;\n      }\n    }\n    return {\n      applied: false\x2C\n      requiresChoice: true\x2C\n      choiceOptions: figureChoiceLabels(validTargets)\x2C\n      targetFigureKeys: validTargets\x2C\n      refreshDcEmbed: strainApplied\x2C\n    };\n  }\n\n  // dcSpecial: targetHostileFigure (Force Choke\x2C Force Lightning) \u2014 pick enemy target\x2C apply damage/strain/condition\n  // First call: returns requiresChoice with enemy figure list; second call: applies effect to chosen figure.\n  if (entry.type === 'dcSpecial' && entry.targetHostileFigure && typeof entry.targetHostileFigure === 'object') {\n    const { damage = 0\x2C strain = 0\x2C applyCondition: condToApply\x2C requiresLos = false\x2C range: maxRange = 999\x2C splashDamageNote\x2C splashDamage = 0\x2C splashConditions = [] } = entry.targetHostileFigure;\n    const { game\x2C playerNum\x2C meta\x2C msgId\x2C dcMessageMeta\x2C dcHealthState\x2C hasLineOfSight: losCheck\x2C getRange: getRng\x2C getMapData: getMs\x2C choiceIndex\x2C targetFigureKey } = context;\n    if (!game || !playerNum) return { applied: false\x2C manualMessage: entry.logMessage || `Resolve ${entry.label} manually.` };\n    const enemyPlayerNum = opponentPlayerNum(playerNum);\n    const enemyPositions = game.figurePositions?.[enemyPlayerNum] || {};\n    // Second call: apply effect to the chosen figure\n    if (choiceIndex != null && targetFigureKey) {\n      const targetMsgId = findMsgIdForFigureKey(game\x2C enemyPlayerNum\x2C targetFigureKey\x2C dcMessageMeta);\n      const parts = [];\n      const totalDmg = damage + strain;\n      if (totalDmg > 0 && dcHealthState && targetMsgId) {\n        const healthState = dcHealthState.get(targetMsgId) || [];\n        const fkMatch = targetFigureKey.match(/-(\\d+)-(\\d+)$/);\n        const figIdx = fkMatch ? parseInt(fkMatch[2]\x2C 10) : 0;\n        const entryHp = healthState[figIdx];\n        if (entryHp) {\n          const [cur\x2C max] = entryHp;\n          const newCur = Math.max(0\x2C (cur ?? max) - totalDmg);\n          healthState[figIdx] = [newCur\x2C max ?? newCur];\n          dcHealthState.set(targetMsgId\x2C healthState);\n          syncHealthStateToList(game\x2C enemyPlayerNum\x2C targetMsgId\x2C healthState);\n          const dmgStr = damage > 0 && strain > 0 ? `${damage} Damage + ${strain} Strain` : damage > 0 ? `${damage} Damage` : `${strain} Strain`;\n          parts.push(`suffered ${dmgStr} (HP: ${cur ?? max} \u2192 ${newCur})`);\n        } else {\n          parts.push(`(HP not tracked \u2014 apply ${damage > 0 ? `${damage} Damage` : ''}${strain > 0 ? ` ${strain} Strain` : ''} manually)`);\n        }\n      } else if (totalDmg > 0) {\n        const dmgStr = damage > 0 && strain > 0 ? `${damage} Damage + ${strain} Strain` : damage > 0 ? `${damage} Damage` : `${strain} Strain`;\n        parts.push(`(apply ${dmgStr} manually)`);\n      }\n      if (condToApply) {\n        if (applyCondition(game\x2C targetFigureKey\x2C condToApply)) {\n          parts.push(`became **${condToApply}**`);\n        }\n      }\n      const dcName = dcNameFromFigureKey(targetFigureKey);\n      // Splash damage: apply splashDamage to all figures adjacent to the chosen target\n      const splashParts = [];\n      if (splashDamage > 0 || splashConditions.length > 0) {\n        const mapId = game.selectedMap?.id;\n        if (mapId) {\n          const adjacent = getFiguresAdjacentToTarget(game\x2C targetFigureKey\x2C mapId);\n          for (const { figureKey: adjFk\x2C playerNum: adjPnum } of adjacent) {\n            const adjMsgId = findMsgIdForFigureKey(game\x2C adjPnum\x2C adjFk\x2C dcMessageMeta);\n            const adjName = dcNameFromFigureKey(adjFk);\n            if (splashDamage > 0 && dcHealthState && adjMsgId) {\n              const adjHs = dcHealthState.get(adjMsgId) || [];\n              const adjFkMatch = adjFk.match(/-(\\d+)-(\\d+)$/);\n              const adjFigIdx = adjFkMatch ? parseInt(adjFkMatch[2]\x2C 10) : 0;\n              const adjEntry = adjHs[adjFigIdx];\n              if (adjEntry) {\n                const [aCur\x2C aMax] = adjEntry;\n                const aNew = Math.max(0\x2C (aCur ?? aMax) - splashDamage);\n                adjHs[adjFigIdx] = [aNew\x2C aMax ?? aNew];\n                dcHealthState.set(adjMsgId\x2C adjHs);\n                syncHealthStateToList(game\x2C adjPnum\x2C adjMsgId\x2C adjHs);\n                splashParts.push(`**${adjName}** ${splashDamage} Damage (${aCur ?? aMax}\u2192${aNew})`);\n              } else {\n                splashParts.push(`**${adjName}** (apply ${splashDamage} Damage manually)`);\n              }\n            } else if (splashDamage > 0) {\n              splashParts.push(`**${adjName}** (apply ${splashDamage} Damage manually)`);\n            }\n            if (splashConditions.length > 0) {\n              const adjToAdd = splashConditions.filter((c) => applyCondition(game\x2C adjFk\x2C c));\n              if (adjToAdd.length > 0) {\n                splashParts.push(`**${adjName}** gains ${adjToAdd.join('\x2C ')}`);\n              }\n            }\n          }\n        }\n      }\n      const splashLog = splashParts.length > 0 ? `\\nSplash \u2014 ${splashParts.join('; ')}` : splashDamageNote ? `\\n> ${splashDamageNote}` : '';\n      // selfCondition: apply a condition to the activating figure (e.g. Invasive Procedure \u2192 Focus self)\n      let selfCondLog = '';\n      if (entry.selfCondition) {\n        const figureKeys = meta ? getFigureKeysForDcMsg(game\x2C playerNum\x2C meta) : [];\n        const selfKey = figureKeys[game.dcActionsData?.[msgId]?.selectedFigure ?? 0] || figureKeys[0];\n        if (selfKey) {\n          applyCondition(game\x2C selfKey\x2C entry.selfCondition);\n          selfCondLog = ` You became **${entry.selfCondition}ed**.`;\n        }\n      }\n      return { applied: true\x2C freeAction: !!entry.freeAction\x2C logMessage: `**${entry.label}** \u2014 **${dcName}** ${parts.join('\x2C ') || 'targeted'}.${splashLog}${selfCondLog}`\x2C refreshDcEmbed: true };\n    }\n    // First call: enumerate valid enemy targets with range/LOS filter\n    const activatingKeys = meta ? getFigureKeysForDcMsg(game\x2C playerNum\x2C meta) : [];\n    const selectedFig = game.dcActionsData?.[msgId]?.selectedFigure ?? 0;\n    const attackerKey = activatingKeys.find((k) => k.endsWith(`-${selectedFig}`)) || activatingKeys[0];\n    const attackerPos = attackerKey ? (game.figurePositions?.[playerNum]?.[attackerKey]) : null;\n    const mapSpaces = getMs ? getMs(game.selectedMap?.id) : null;\n    // Terminal adjacency: activator must be on/adjacent to token (System Shock)\n    const _thfActTokenType = entry.targetHostileFigure.activatorMustBeAdjacentToToken;\n    if (_thfActTokenType && attackerPos) {\n      const mapId = game.selectedMap?.id;\n      const mapTokens = mapId ? (getMapTokensData()?.[mapId]) : null;\n      const tokenPositions = mapTokens?.[_thfActTokenType + 's'] || [];\n      if (tokenPositions.length > 0) {\n        const posLower = String(attackerPos).toLowerCase();\n        const adjSpaces = mapSpaces?.adjacency?.[attackerPos] || [];\n        const isNear = tokenPositions.some(t => String(t).toLowerCase() === posLower) ||\n                       tokenPositions.some(t => adjSpaces.includes(t));\n        if (!isNear) return { applied: false\x2C manualMessage: `**${entry.label}** \u2014 You must be on or adjacent to a ${_thfActTokenType}.` };\n      }\n    }\n    // Terminal adjacency: filter targets to on/adjacent to token (System Shock)\n    const _thfTgtTokenType = entry.targetHostileFigure.targetMustBeAdjacentToToken;\n    let _tgtTokenPositions = [];\n    if (_thfTgtTokenType) {\n      const mapId = game.selectedMap?.id;\n      const mapTokens = mapId ? (getMapTokensData()?.[mapId]) : null;\n      _tgtTokenPositions = mapTokens?.[_thfTgtTokenType + 's'] || [];\n    }\n    const validTargets = [];\n    for (const [fk\x2C coord] of Object.entries(enemyPositions)) {\n      if (!coord) continue;\n      if (attackerPos && maxRange < 999) {\n        const dist = countGameSpaces(game\x2C attackerPos\x2C coord);\n        if (dist > maxRange) continue;\n      }\n      if (requiresLos && losCheck && attackerPos && mapSpaces) {\n        if (!losCheck(attackerPos\x2C coord\x2C mapSpaces)) continue;\n      }\n      // Token adjacency filter (System Shock: target must be on/adjacent to terminal)\n      if (_thfTgtTokenType && _tgtTokenPositions.length > 0) {\n        const coordLower = String(coord).toLowerCase();\n        const adjCoords = mapSpaces?.adjacency?.[coord] || [];\n        const isNear = _tgtTokenPositions.some(t => String(t).toLowerCase() === coordLower) ||\n                       _tgtTokenPositions.some(t => adjCoords.includes(t));\n        if (!isNear) continue;\n      }\n      validTargets.push({ fk\x2C name: dcNameFromFigureKey(fk) });\n    }\n    if (validTargets.length === 0) {\n      // I36: If ability has selfCondition (e.g. Invasive Procedure)\x2C apply it even with no targets\n      if (entry.selfCondition && attackerKey) {\n        applyCondition(game\x2C attackerKey\x2C entry.selfCondition);\n        return { applied: true\x2C freeAction: !!entry.freeAction\x2C logMessage: `**${entry.label}** \u2014 No adjacent targets. You became **${entry.selfCondition}ed**.`\x2C refreshDcEmbed: true };\n      }\n      return { applied: false\x2C manualMessage: `No valid targets in range/LOS. Apply **${entry.label}** manually.` };\n    }\n    return { applied: false\x2C requiresChoice: true\x2C choiceOptions: validTargets.map((t) => t.name)\x2C targetFigureKeys: validTargets.map((t) => t.fk) };\n  }\n\n  // dcSpecial: targetFriendlyFigureAdjacent (Gifted Mechanic) \u2014 pick adjacent friendly figure with trait\x2C apply effect to both\n  if (entry.type === 'dcSpecial' && entry.targetFriendlyFigureAdjacent && typeof entry.targetFriendlyFigureAdjacent === 'object') {\n    const { traits = []\x2C recoverSelf = 0\x2C recoverTarget = 0\x2C hitTokenSelf = 0\x2C hitTokenTarget = 0\x2C powerTokenTarget = 0 } = entry.targetFriendlyFigureAdjacent;\n    const { game\x2C playerNum\x2C meta\x2C msgId\x2C dcMessageMeta\x2C dcHealthState\x2C choiceIndex\x2C targetFigureKey } = context;\n    if (!game || !playerNum || !meta) return { applied: false\x2C manualMessage: `Resolve ${entry.label} manually.` };\n    const mapId = game.selectedMap?.id;\n    const activatingKeys = getFigureKeysForDcMsg(game\x2C playerNum\x2C meta);\n    // Helper: add Hit tokens to a figure key \u2014 overflow handled by grantPowerTokens\n    function addHitToken(fk\x2C n) {\n      if (n <= 0) return;\n      grantPowerTokens(game\x2C fk\x2C 'Damage'\x2C n);\n    }\n    // Second call: apply effects to self + chosen target\n    if (choiceIndex != null && targetFigureKey) {\n      const parts = [];\n      // Recover self\n      if (recoverSelf > 0 && dcHealthState) {\n        const selectedFig = game.dcActionsData?.[msgId]?.selectedFigure ?? 0;\n        const { healed: recovered } = healHp(dcHealthState\x2C game\x2C msgId\x2C selectedFig\x2C recoverSelf\x2C playerNum);\n        if (recovered > 0) parts.push(`you recovered ${recovered} Damage`);\n      }\n      // Recover target\n      if (recoverTarget > 0 && dcHealthState) {\n        const targetMsgId = findMsgIdForFigureKey(game\x2C playerNum\x2C targetFigureKey\x2C dcMessageMeta);\n        if (targetMsgId) {\n          const figIdx = parseFigureKey(targetFigureKey).figureIndex;\n          healHp(dcHealthState\x2C game\x2C targetMsgId\x2C figIdx\x2C recoverTarget\x2C playerNum);\n        }\n        parts.push(`${dcNameFromFigureKey(targetFigureKey)} recovered ${recoverTarget} Damage`);\n      }\n      // Hit tokens\n      if (hitTokenSelf > 0) { const sfk = activatingKeys[0]; if (sfk) { addHitToken(sfk\x2C hitTokenSelf); parts.push(`you gained ${hitTokenSelf} Damage Token`); } }\n      if (hitTokenTarget > 0) { addHitToken(targetFigureKey\x2C hitTokenTarget); parts.push(`${dcNameFromFigureKey(targetFigureKey)} gained ${hitTokenTarget} Damage Token`); }\n      // Power Token grant (player chooses type via pendingPowerTokenGrant)\n      if (powerTokenTarget > 0) {\n        const tName = dcNameFromFigureKey(targetFigureKey);\n        game.pendingPowerTokenGrant = { grants: [{ figureKey: targetFigureKey\x2C figName: tName\x2C count: powerTokenTarget }]\x2C channelId: null\x2C playerNum };\n        parts.push(`${tName} gains ${powerTokenTarget} Power Token \u2014 choose type`);\n        return { applied: true\x2C requiresPowerTokenChoice: true\x2C logMessage: `**${entry.label}** \u2014 ${parts.join('\x2C ')}.`\x2C refreshDcEmbed: true };\n      }\n      return { applied: true\x2C logMessage: `**${entry.label}** \u2014 ${parts.join('\x2C ')}.`\x2C refreshDcEmbed: true };\n    }\n    // First call: enumerate adjacent friendly figures matching traits\n    const adjacentSet = new Set();\n    for (const fk of activatingKeys) {\n      if (!mapId) continue;\n      const adj = getFiguresAdjacentToTarget(game\x2C fk\x2C mapId);\n      for (const { figureKey\x2C playerNum: p } of adj) {\n        if (p === playerNum && !activatingKeys.includes(figureKey)) adjacentSet.add(figureKey);\n      }\n    }\n    const dcEffs = getDcEffects() || {};\n    const validTargets = [...adjacentSet].filter((fk) => {\n      const dn = dcNameFromFigureKey(fk);\n      const kws = (dcEffs[dn]?.keywords || []).map((k) => String(k).toUpperCase());\n      return traits.length === 0 || traits.some((t) => kws.includes(t.toUpperCase()));\n    }).map((fk) => ({ fk\x2C name: dcNameFromFigureKey(fk) }));\n    if (validTargets.length === 0) {\n      return { applied: false\x2C manualMessage: `No adjacent friendly ${traits.join('/')} found. Resolve **${entry.label}** manually.` };\n    }\n    return { applied: false\x2C requiresChoice: true\x2C choiceOptions: validTargets.map((t) => t.name)\x2C targetFigureKeys: validTargets.map((t) => t.fk) };\n  }\n\n  // dcSpecial: applyHideToFriendlyWithinRange (Field Report) \u2014 apply Hide condition to qualifying friendly figures within range\n  if (entry.type === 'dcSpecial' && entry.applyHideToFriendlyWithinRange && typeof entry.applyHideToFriendlyWithinRange === 'object') {\n    const { range: maxRange = 4\x2C maxDiceCount = 2\x2C maxTargets = 2 } = entry.applyHideToFriendlyWithinRange;\n    const { game\x2C playerNum\x2C meta\x2C msgId\x2C getRange: getRng } = context;\n    if (!game || !playerNum || !meta) return { applied: false\x2C manualMessage: `Resolve ${entry.label} manually.` };\n    const activatingKeys = getFigureKeysForDcMsg(game\x2C playerNum\x2C meta);\n    const selectedFig = game.dcActionsData?.[msgId]?.selectedFigure ?? 0;\n    const attackerKey = activatingKeys.find((k) => k.endsWith(`-${selectedFig}`)) || activatingKeys[0];\n    const attackerPos = attackerKey ? game.figurePositions?.[playerNum]?.[attackerKey] : null;\n    const allFriendlyPositions = game.figurePositions?.[playerNum] || {};\n    const dcEffs = getDcEffects() || {};\n    const candidates = [];\n    for (const [fk\x2C coord] of Object.entries(allFriendlyPositions)) {\n      if (!coord || activatingKeys.includes(fk)) continue;\n      if (attackerPos) {\n        const dist = countGameSpaces(game\x2C attackerPos\x2C coord);\n        if (dist > maxRange) continue;\n      }\n      const dn = dcNameFromFigureKey(fk);\n      const dcStats = dcEffs[dn];\n      const diceCount = dcStats?.attack?.dice?.length ?? (dcStats?.attack ? 1 : 0);\n      if (diceCount > maxDiceCount) continue;\n      candidates.push(fk);\n    }\n    if (candidates.length === 0) return { applied: true\x2C logMessage: `**${entry.label}** \u2014 No qualifying friendly figures within ${maxRange} spaces (\u2264${maxDiceCount} attack dice).` };\n    const toHide = candidates.slice(0\x2C maxTargets);\n    const skipped = candidates.length > maxTargets ? ` (${candidates.length - maxTargets} additional candidates not hidden \u2014 choose manually if needed)` : '';\n    const hidden = [];\n    for (const fk of toHide) {\n      if (applyCondition(game\x2C fk\x2C 'Hide')) { hidden.push(dcNameFromFigureKey(fk)); }\n    }\n    if (hidden.length === 0) return { applied: true\x2C logMessage: `**${entry.label}** \u2014 Qualifying figures already Hidden.` };\n    return { applied: true\x2C logMessage: `**${entry.label}** \u2014 **${hidden.join('**\x2C **')}** became **Hidden**.${skipped}`\x2C refreshDcEmbed: true };\n  }\n\n  // battlefield_leadership (Leia Organa): pick a friendly figure within 3 spaces; it gets a free attack\n  if (abilityId === 'battlefield_leadership') {\n    const { game\x2C playerNum\x2C meta\x2C msgId\x2C choiceIndex\x2C targetFigureKey\x2C findDcMessageIdForFigure\x2C getRange: getRng } = context;\n    if (!game || !playerNum) return { applied: false\x2C manualMessage: 'Resolve **Battlefield Leadership** manually.' };\n    // Phase 2: figure chosen \u2014 set pending flag and return applied\n    if (choiceIndex != null && targetFigureKey) {\n      const chosenMsgId = findDcMessageIdForFigure ? findDcMessageIdForFigure(game.gameId\x2C playerNum\x2C targetFigureKey) : null;\n      if (chosenMsgId) {\n        game.pendingBattlefieldLeadership = { forMsgId: chosenMsgId\x2C chosenFigureKey: targetFigureKey\x2C triggeredByMsgId: msgId };\n      }\n      const chosenName = dcNameFromFigureKey(targetFigureKey);\n      return { applied: true\x2C logMessage: `**Battlefield Leadership** \u2014 **${chosenName}** may interrupt to move up to 1 space and perform a free attack (no action cost). Use their **Attack** button.` };\n    }\n    // Phase 1: enumerate friendly figures within 3 spaces (not Leia herself)\n    const figureKeys = getFigureKeysForDcMsg(game\x2C playerNum\x2C meta);\n    const activatingKey = figureKeys[game.dcActionsData?.[msgId]?.selectedFigure ?? 0] || figureKeys[0];\n    const activatingPos = activatingKey ? game.figurePositions?.[playerNum]?.[activatingKey] : null;\n    if (!activatingPos) return { applied: false\x2C manualMessage: '**Battlefield Leadership** \u2014 Leia has no position on the board. Resolve manually.' };\n    const validTargets = [];\n    for (const [fk\x2C pos] of Object.entries(game.figurePositions?.[playerNum] || {})) {\n      if (fk === activatingKey || !pos) continue;\n      if (countGameSpaces(game\x2C activatingPos\x2C pos) > 3) continue;\n      validTargets.push(fk);\n    }\n    if (validTargets.length === 0) return { applied: false\x2C manualMessage: '**Battlefield Leadership** \u2014 No other friendly figures within 3 spaces.' };\n    return {\n      applied: false\x2C\n      requiresChoice: true\x2C\n      choiceOptions: figureChoiceLabels(validTargets)\x2C\n      targetFigureKeys: validTargets\x2C\n    };\n  }\n\n  // emperor_interrupt (Emperor Palpatine): choose a friendly figure within 4 spaces; it gets a free attack\n  if (abilityId === 'emperor_interrupt') {\n    const { game\x2C playerNum\x2C meta\x2C msgId\x2C choiceIndex\x2C targetFigureKey\x2C findDcMessageIdForFigure\x2C getRange: getRng } = context;\n    if (!game || !playerNum) return { applied: false\x2C manualMessage: 'Resolve **Emperor** manually.' };\n    if (choiceIndex != null && targetFigureKey) {\n      const chosenMsgId = findDcMessageIdForFigure ? findDcMessageIdForFigure(game.gameId\x2C playerNum\x2C targetFigureKey) : null;\n      if (chosenMsgId) {\n        game.pendingEmperorInterrupt = { forMsgId: chosenMsgId\x2C chosenFigureKey: targetFigureKey\x2C triggeredByMsgId: msgId };\n      }\n      const chosenName = dcNameFromFigureKey(targetFigureKey);\n      return { applied: true\x2C logMessage: `**Emperor** \u2014 **${chosenName}** may interrupt to perform a free attack (no action cost). Use their **Attack** button.` };\n    }\n    const figureKeys = getFigureKeysForDcMsg(game\x2C playerNum\x2C meta);\n    const activatingKey = figureKeys[game.dcActionsData?.[msgId]?.selectedFigure ?? 0] || figureKeys[0];\n    const activatingPos = activatingKey ? game.figurePositions?.[playerNum]?.[activatingKey] : null;\n    if (!activatingPos) return { applied: false\x2C manualMessage: '**Emperor** \u2014 No position on the board. Resolve manually.' };\n    const validTargets = [];\n    for (const [fk\x2C pos] of Object.entries(game.figurePositions?.[playerNum] || {})) {\n      if (fk === activatingKey || !pos) continue;\n      if (countGameSpaces(game\x2C activatingPos\x2C pos) > 4) continue;\n      validTargets.push(fk);\n    }\n    if (validTargets.length === 0) return { applied: false\x2C manualMessage: '**Emperor** \u2014 No other friendly figures within 4 spaces.' };\n    return {\n      applied: false\x2C\n      requiresChoice: true\x2C\n      choiceOptions: figureChoiceLabels(validTargets)\x2C\n      targetFigureKeys: validTargets\x2C\n    };\n  }\n\n  // You Have Something I Want (Moff Gideon): choose hostile with token within 4\x2C transfer or 3 damage\n  if (abilityId === 'you_have_something_i_want_gideon') {\n    const { game\x2C playerNum\x2C meta\x2C msgId\x2C dcMessageMeta\x2C dcHealthState\x2C choiceIndex\x2C targetFigureKey\x2C getRange: getRng } = context;\n    if (!game || !playerNum || !meta || !msgId) return { applied: false\x2C manualMessage: 'Resolve **You Have Something I Want** manually.' };\n\n    // Phase 2: target+token chosen \u2192 set up opponent decision\n    if (choiceIndex != null) {\n      const options = game.yhsiwOptions || [];\n      const chosen = options[choiceIndex];\n      if (!chosen) return { applied: false\x2C manualMessage: 'Invalid choice.' };\n      const { figureKey: targetFk\x2C token\x2C playerNum: oppNum } = chosen;\n\n      // Get Moff Gideon's figure key\n      const actionsData = game.dcActionsData?.[msgId];\n      const selectedFig = actionsData?.selectedFigure ?? 0;\n      const dgMatch = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/);\n      const dgIndex = dgMatch ? dgMatch[1] : '1';\n      const gideonFk = `${meta.dcName}-${dgIndex}-${selectedFig}`;\n\n      // Store pending YHSIW for opponent to respond\n      game.pendingYHSIW = {\n        targetFk\x2C token\x2C gideonFk\x2C gideonPlayerNum: playerNum\x2C oppPlayerNum: oppNum\x2C\n        msgId\x2C gameId: game.gameId\x2C\n      };\n      delete game.yhsiwOptions;\n\n      return {\n        applied: true\x2C\n        freeAction: true\x2C\n        yhsiwPending: true\x2C\n        logMessage: `**You Have Something I Want** \u2014 **Moff Gideon** targets **${dcNameFromFigureKey(targetFk)}**'s **${token}** token. Opponent must choose: **transfer** the token or **suffer 3 Damage**.`\x2C\n      };\n    }\n\n    // Phase 1: enumerate hostile figures within 4 spaces with power/condition tokens\n    const actionsData = game.dcActionsData?.[msgId];\n    const selectedFig = actionsData?.selectedFigure ?? 0;\n    const dgMatch = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/);\n    const dgIndex = dgMatch ? dgMatch[1] : '1';\n    const gideonFk = `${meta.dcName}-${dgIndex}-${selectedFig}`;\n    const gideonPos = game.figurePositions?.[playerNum]?.[gideonFk];\n    if (!gideonPos) return { applied: false\x2C freeAction: true\x2C manualMessage: 'Moff Gideon position unknown.' };\n\n    const oppNum = opponentPlayerNum(playerNum);\n    const oppPositions = game.figurePositions?.[oppNum] || {};\n\n    const targets = [];\n    for (const [fk\x2C pos] of Object.entries(oppPositions)) {\n      if (!pos) continue;\n      const dist = countGameSpaces(game\x2C gideonPos\x2C pos);\n      if (dist > 4) continue;\n      // Power tokens\n      const powerTokens = game.figurePowerTokens?.[fk] || [];\n      for (const token of [...new Set(powerTokens)]) {\n        targets.push({ fk\x2C token\x2C pn: oppNum\x2C label: `${dcNameFromFigureKey(fk)} \u2014 ${token} Token` });\n      }\n      // Condition tokens\n      const conditions = game.figureConditions?.[fk] || [];\n      for (const cond of conditions) {\n        targets.push({ fk\x2C token: cond\x2C pn: oppNum\x2C label: `${dcNameFromFigureKey(fk)} \u2014 ${cond}` });\n      }\n    }\n\n    if (targets.length === 0) return { applied: false\x2C freeAction: true\x2C manualMessage: 'No hostile figures within 4 spaces have Power Tokens or condition tokens.' };\n\n    // Store options for Phase 2 lookup\n    game.yhsiwOptions = targets.map(t => ({ figureKey: t.fk\x2C token: t.token\x2C playerNum: t.pn }));\n\n    return {\n      applied: false\x2C\n      requiresChoice: true\x2C\n      choiceOptions: targets.map(t => t.label)\x2C\n      targetFigureKeys: targets.map(t => t.fk)\x2C\n    };\n  }\n\n  // tempt (Emperor Palpatine): choose any figure within 4 spaces; 1 damage + 1 Damage Token\n  if (abilityId === 'tempt') {\n    const { game\x2C playerNum\x2C meta\x2C msgId\x2C choiceIndex\x2C targetFigureKey\x2C dcMessageMeta\x2C dcHealthState\x2C getRange: getRng } = context;\n    if (!game || !playerNum) return { applied: false\x2C manualMessage: 'Resolve **Tempt** manually.' };\n    const enemyNum = opponentPlayerNum(playerNum);\n    if (choiceIndex != null && targetFigureKey) {\n      const chosenName = dcNameFromFigureKey(targetFigureKey);\n      // Determine which player owns the target figure (Tempt can target friendly or hostile)\n      const targetOwnerNum = game.figurePositions?.[playerNum]?.[targetFigureKey] ? playerNum : enemyNum;\n      // Apply 1 HP damage via reduceHp (canonical damage path \u2014 handles syncDcList + totalDamageReceived)\n      let hpNote = '';\n      let defeated = false;\n      const targetMsgId = findMsgIdForFigureKey(game\x2C targetOwnerNum\x2C targetFigureKey\x2C dcMessageMeta);\n      if (dcHealthState && targetMsgId) {\n        const { figureIndex: figIdx } = parseFigureKey(targetFigureKey);\n        const { prevHp\x2C newHp\x2C wasDefeated } = reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C figIdx\x2C 1\x2C targetOwnerNum);\n        hpNote = ` (HP: ${prevHp} \u2192 ${newHp})`;\n        if (wasDefeated) {\n          defeated = true;\n        }\n      }\n      // Grant 1 Damage Token to target (skip if defeated)\n      if (!defeated) grantPowerTokens(game\x2C targetFigureKey\x2C 'Damage'\x2C 1);\n      const tokenNote = defeated ? '' : ' and gains 1 Damage Token';\n      const temptResult = { applied: true\x2C logMessage: `**Tempt** \u2014 **${chosenName}** suffers 1 Damage${hpNote}${tokenNote}.`\x2C refreshDcEmbed: true\x2C refreshBoard: defeated };\n      if (defeated) {\n        temptResult.defeatedFigures = [{ figureKey: targetFigureKey\x2C defeatedPlayerNum: targetOwnerNum\x2C attackerPlayerNum: opponentPlayerNum(targetOwnerNum)\x2C source: 'Tempt' }];\n      }\n      return temptResult;\n    }\n    // Enumerate all figures (friendly + hostile) within 4 spaces except self\n    const figureKeys = getFigureKeysForDcMsg(game\x2C playerNum\x2C meta);\n    const activatingKey = figureKeys[game.dcActionsData?.[msgId]?.selectedFigure ?? 0] || figureKeys[0];\n    const activatingPos = activatingKey ? game.figurePositions?.[playerNum]?.[activatingKey] : null;\n    if (!activatingPos) return { applied: false\x2C manualMessage: '**Tempt** \u2014 No position on the board. Resolve manually.' };\n    const validTargets = [];\n    for (const pn of [playerNum\x2C enemyNum]) {\n      for (const [fk\x2C pos] of Object.entries(game.figurePositions?.[pn] || {})) {\n        if (fk === activatingKey || !pos) continue;\n        if (countGameSpaces(game\x2C activatingPos\x2C pos) > 4) continue;\n        validTargets.push(fk);\n      }\n    }\n    if (validTargets.length === 0) return { applied: false\x2C manualMessage: '**Tempt** \u2014 No figures within 4 spaces.' };\n    return {\n      applied: false\x2C\n      requiresChoice: true\x2C\n      choiceOptions: figureChoiceLabels(validTargets)\x2C\n      targetFigureKeys: validTargets\x2C\n    };\n  }\n\n  // on_my_mark (Gideon Argus): choose a friendly figure \u2014 it becomes Focused\n  if (abilityId === 'on_my_mark') {\n    const { game\x2C playerNum\x2C meta\x2C msgId\x2C choiceIndex\x2C targetFigureKey } = context;\n    if (!game || !playerNum) return { applied: false\x2C manualMessage: 'Resolve **On My Mark** manually.' };\n    if (choiceIndex != null && targetFigureKey) {\n      applyCondition(game\x2C targetFigureKey\x2C 'Focus');\n      const chosenName = dcNameFromFigureKey(targetFigureKey);\n      return { applied: true\x2C logMessage: `**On My Mark** \u2014 **${chosenName}** is now **Focused** (+1 green die on next attack).`\x2C refreshDcEmbed: true };\n    }\n    const figureKeys = getFigureKeysForDcMsg(game\x2C playerNum\x2C meta);\n    const activatingKey = figureKeys[game.dcActionsData?.[msgId]?.selectedFigure ?? 0] || figureKeys[0];\n    const validTargets = Object.keys(game.figurePositions?.[playerNum] || {}).filter(fk => fk !== activatingKey && game.figurePositions[playerNum][fk]);\n    if (validTargets.length === 0) return { applied: false\x2C manualMessage: '**On My Mark** \u2014 No other friendly figures on the board.' };\n    return {\n      applied: false\x2C\n      requiresChoice: true\x2C\n      choiceOptions: figureChoiceLabels(validTargets)\x2C\n      targetFigureKeys: validTargets\x2C\n    };\n  }\n\n  // tactical_maneuver (Gideon Argus): choose a friendly figure \u2014 it gains 2 MP\n  if (abilityId === 'tactical_maneuver') {\n    const { game\x2C playerNum\x2C meta\x2C msgId\x2C choiceIndex\x2C targetFigureKey\x2C findDcMessageIdForFigure } = context;\n    if (!game || !playerNum) return { applied: false\x2C manualMessage: 'Resolve **Tactical Maneuver** manually.' };\n    if (choiceIndex != null && targetFigureKey) {\n      const chosenMsgId = findDcMessageIdForFigure ? findDcMessageIdForFigure(game.gameId\x2C playerNum\x2C targetFigureKey) : null;\n      if (chosenMsgId) {\n        addMovementPoints(game\x2C chosenMsgId\x2C 2);\n      }\n      const chosenName = dcNameFromFigureKey(targetFigur