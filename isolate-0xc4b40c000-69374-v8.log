code-creation,Script,9,145282,0x3f05b9282bd8,158, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/post-deploy.js:1:1,0xb1f465faab8,~
script-source,160,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/post-deploy.js,/**\n * Post-deploy ability ordering and execution system.\n * After deployment (round 1)\x2C players choose the order of their post-deploy abilities.\n * Initiative player resolves first\x2C then the other player.\n */\nimport { ActionRowBuilder\x2C ButtonBuilder\x2C ButtonStyle } from 'discord.js';\nimport { getDcEffects\x2C getDcStats\x2C getMapData\x2C getDeploymentZones\x2C getFigureSize } from '../data-loader.js';\nimport { dcNameFromFigureKey\x2C applyCondition\x2C grantPowerTokens\x2C buildFigureButtonLabel } from '../game/index.js';\nimport {\n  getPlayerId\x2C getDcList\x2C getDcMessageIds\x2C getDcAttachments\x2C\n  getInitiativePlayerNum\x2C opponentPlayerNum\x2C getHandChannelId\x2C\n} from '../game/player-helpers.js';\nimport { bottomLeftCoord\x2C normalizeCoord\x2C getFootprintCells\x2C parseSizeString } from '../game/coords.js';\nimport { countSpaces } from '../game/spatial.js';\nimport { edgeKey } from '../game/coords.js';\nimport { getMapTokensData } from '../data-loader.js';\nimport { discordCatch } from '../error-handling.js';\nimport { sendPowerTokenOverflowUI } from './combat.js';\nimport { requireGame } from '../utils/guards.js';\nimport { buildRowPickerButtons\x2C chunkButtonsToRows\x2C cleanupSpacePick } from '../discord/components.js';\nimport { splitCustomId } from '../discord/custom-id.js';\nimport { fetchGameChannel } from '../discord/channel-helpers.js';\n\n// Module-level storage for companion DC embed deps (keyed by gameId).\n// Set by runPostDeployPhase when ctx includes embed deps\x2C consumed by resolveAutoAbility\x2C\n// cleaned up in finishPostDeploy.\nconst _companionEmbedDeps = new Map();\n\n// Module-level storage for the post-deploy completion callback (keyed by gameId).\n// Stored here instead of on `game` because callbacks are functions \u2014 JSON.stringify\n// would silently strip them on save\x2C stranding the game post-restart. If this map\n// is empty on finishPostDeploy (e.g. process restart)\x2C the refresh safety net in\n// refreshAllGameComponents re-posts CC draw prompts from pure state.\nconst _postDeployCallbacks = new Map();\n\n/**\n * Stash pending button customIds on the postDeployQueue so getAvailableActions\n * can surface them for the AI / selfplay without duplicating button-generation logic.\n */\nfunction _stashPendingActions(game\x2C buttons\x2C label) {\n  if (!game.postDeployQueue) return;\n  game.postDeployQueue.pendingActions = buttons.map(b => ({\n    type: 'post_deploy_active'\x2C\n    customId: b.data.custom_id\x2C\n    description: `Post-deploy: ${label}`\x2C\n  }));\n}\n\n// \u2500\u2500 Ability scanning \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Scan a single player's deployed figures and skirmish upgrades for post-deploy abilities.\n * Returns an array of ability descriptors.\n */\nfunction scanPlayerPostDeployAbilities(game\x2C playerNum) {\n  const abilities = [];\n  const dcEffects = getDcEffects() || {};\n\n  const figPositions = game.figurePositions?.[playerNum] || {};\n  const figEntries = Object.entries(figPositions);\n\n  // Scan deployed figures for DC passives and specialAbilityIds\n  for (const [fk\x2C pos] of figEntries) {\n    if (!pos) continue;\n    const dcName = dcNameFromFigureKey(fk);\n    const eff = dcEffects[dcName] || dcEffects[dcName?.replace(/\\s*\\(Elite\\)\\s*$/\x2C '')];\n    if (!eff) continue;\n    const passives = eff.passives || [];\n    const sIds = eff.specialAbilityIds || [];\n\n    if (passives.includes('Beskar Armor')) {\n      abilities.push({ abilityId: 'beskar_armor'\x2C label: 'Beskar Armor'\x2C dcName\x2C figureKey: fk\x2C playerNum\x2C interactive: false\x2C type: 'token' });\n    }\n    if (passives.includes('Stealthy')) {\n      abilities.push({ abilityId: 'stealthy'\x2C label: 'Stealthy'\x2C dcName\x2C figureKey: fk\x2C playerNum\x2C interactive: false\x2C type: 'condition' });\n    }\n    if (passives.includes('Ambush')) {\n      abilities.push({ abilityId: 'ambush'\x2C label: 'Ambush'\x2C dcName\x2C figureKey: fk\x2C playerNum\x2C interactive: false\x2C type: 'condition' });\n    }\n    if (passives.includes('In The Shadows')) {\n      abilities.push({ abilityId: 'in_the_shadows'\x2C label: 'In The Shadows'\x2C dcName\x2C figureKey: fk\x2C playerNum\x2C interactive: false\x2C type: 'condition' });\n    }\n    if (passives.includes('Forward Emplacement')) {\n      const speed = eff.speed || 0;\n      if (speed > 0) {\n        abilities.push({ abilityId: 'forward_emplacement'\x2C label: 'Forward Emplacement'\x2C dcName\x2C figureKey: fk\x2C playerNum\x2C interactive: true\x2C type: 'movement'\x2C mp: speed });\n      }\n    }\n    if (passives.includes('Smooth Landing')) {\n      // Bodhi + each adjacent friendly gains 1 MP \u2014 all need to move immediately\n      // Use multi-cell adjacency: check ALL cells of both trigger and candidate figures\n      const ms = getMapData(game.selectedMap?.id);\n      const adjacency = ms?.adjacency || {};\n      // Build set of all cells adjacent to any cell of the triggering figure's footprint\n      const triggerSize = game.figureOrientations?.[fk] || getFigureSize(dcName) || '1x1';\n      const triggerCells = getFootprintCells(pos\x2C triggerSize).map(c => normalizeCoord(c));\n      const adjSet = new Set();\n      for (const tc of triggerCells) {\n        for (const n of (adjacency[tc] || [])) adjSet.add(normalizeCoord(n));\n      }\n      const moveFigures = [{ figureKey: fk\x2C dcName\x2C mp: 1 }];\n      const done = new Set([fk]);\n      for (const [afk\x2C apos] of figEntries) {\n        if (!apos || done.has(afk)) continue;\n        // Get all cells the candidate figure occupies\n        const aDcName = dcNameFromFigureKey(afk);\n        const aSize = game.figureOrientations?.[afk] || getFigureSize(aDcName) || '1x1';\n        const aCells = getFootprintCells(apos\x2C aSize).map(c => normalizeCoord(c));\n        // Adjacent if ANY cell of candidate is adjacent to ANY cell of trigger\n        if (!aCells.some(c => adjSet.has(c))) continue;\n        done.add(afk);\n        moveFigures.push({ figureKey: afk\x2C dcName: aDcName\x2C mp: 1 });\n      }\n      abilities.push({ abilityId: 'smooth_landing'\x2C label: 'Smooth Landing'\x2C dcName\x2C figureKey: fk\x2C playerNum\x2C interactive: true\x2C type: 'multi_movement'\x2C moveFigures });\n    }\n    if (passives.includes('Security Detail')) {\n      const leaders = [];\n      for (const [lfk\x2C lpos] of figEntries) {\n        if (!lpos) continue;\n        const ldn = dcNameFromFigureKey(lfk);\n        const leff = dcEffects[ldn];\n        if ((leff?.keywords || []).some(k => k.toUpperCase() === 'LEADER')) {\n          leaders.push({ figureKey: lfk\x2C dcName: ldn });\n        }\n      }\n      const isInteractive = leaders.length > 1;\n      abilities.push({ abilityId: 'security_detail'\x2C label: 'Security Detail'\x2C dcName\x2C figureKey: fk\x2C playerNum\x2C interactive: isInteractive\x2C type: 'token'\x2C leaders });\n    }\n    if (passives.includes('Infiltration')) {\n      const dgMatch = fk.match(/^(.+)-(\\d+)-(\\d+)$/);\n      if (dgMatch) {\n        const [\x2C baseName\x2C dgIdx] = dgMatch;\n        const prefix = `${baseName}-${dgIdx}-`;\n        const dgFigures = Object.keys(figPositions).filter(k => k.startsWith(prefix) && figPositions[k]);\n        if (!abilities.some(a => a.abilityId === 'infiltration' && a.dcName === dcName && a.playerNum === playerNum)) {\n          abilities.push({ abilityId: 'infiltration'\x2C label: 'Infiltration'\x2C dcName\x2C figureKey: fk\x2C figureKeys: dgFigures\x2C playerNum\x2C interactive: true\x2C type: 'movement'\x2C mpPerFigure: 6 });\n        }\n      }\n    }\n    // Strike Team: check specialAbilityIds\n    if (sIds.includes('strike_team_cassian') && !abilities.some(a => a.abilityId === 'strike_team' && a.playerNum === playerNum)) {\n      abilities.push({ abilityId: 'strike_team'\x2C label: 'Strike Team'\x2C dcName\x2C figureKey: fk\x2C playerNum\x2C interactive: true\x2C type: 'complex' });\n    }\n    // Ko-Tun Arms Distribution post-deploy: pick 1 friendly within 3 spaces \u2192 gain 1 Power Token\n    if (sIds.includes('arms_distribution_kotun') && !game[`armsDistDeployFired_p${playerNum}`]) {\n      abilities.push({ abilityId: 'arms_distribution_deploy'\x2C label: 'Arms Distribution (Deploy)'\x2C dcName\x2C figureKey: fk\x2C playerNum\x2C interactive: true\x2C type: 'token_pick' });\n    }\n  }\n\n  // Direct DC companion deployment (e.g.\x2C Jarrod Kelvin \u2192 J4X-7\x2C Iden Versio \u2192 Dio)\n  // These have companion as a string on the DC itself (not via attachment)\n  const dcList = getDcList(game\x2C playerNum) || [];\n  const msgIds = getDcMessageIds(game\x2C playerNum) || [];\n  for (let i = 0; i < dcList.length; i++) {\n    const dc = dcList[i];\n    if (!dc || dc.defeated) continue;\n    const mid = msgIds[i];\n    const eff = dcEffects[dc.dcName];\n    if (!eff || typeof eff.companion !== 'string') continue;\n    // Skip if already deployed (attachment-based or direct)\n    if (game[`companionDeployed_${mid}`]) continue;\n    // Skip if the companion is already in figurePositions (e.g.\x2C via attachment path)\n    const companionName = eff.companion;\n    const alreadyPlaced = Object.keys(figPositions).some(k => k.startsWith(companionName + '-'));\n    if (alreadyPlaced) continue;\n    const hostFk = Object.keys(figPositions).find(k => k.startsWith(dc.dcName + '-'));\n    if (hostFk) {\n      abilities.push({\n        abilityId: 'companion_deploy'\x2C label: `Deploy ${companionName}`\x2C\n        dcName: dc.dcName\x2C figureKey: hostFk\x2C msgId: mid\x2C playerNum\x2C\n        companionName\x2C interactive: false\x2C type: 'companion'\x2C\n      });\n    }\n  }\n\n  // Scan skirmish upgrades (figureless DCs with attachments)\n  const attachments = getDcAttachments(game\x2C playerNum) || {};\n\n  for (let i = 0; i < dcList.length; i++) {\n    const dc = dcList[i];\n    if (!dc) continue;\n    const dcName = dc.dcName;\n    const eff = dcEffects[dcName] || dcEffects[`[${dcName}]`] || dcEffects[dcName?.replace(/^\\[|\\]$/g\x2C '')];\n    if (!eff) continue;\n\n    // Extra Armor\n    if (dcName.includes('Extra Armor') && !game[`extraArmorFired_p${playerNum}`]) {\n      abilities.push({ abilityId: 'extra_armor'\x2C label: 'Extra Armor'\x2C dcName\x2C playerNum\x2C interactive: true\x2C type: 'token_distribute'\x2C total: 4 });\n    }\n  }\n\n  // Scavenged Walker (attachment) \u2014 check all DCs for this attachment\n  for (let i = 0; i < msgIds.length; i++) {\n    const mid = msgIds[i];\n    const atts = attachments[mid] || [];\n    if (atts.includes('Scavenged Walker')) {\n      const dc = dcList[i];\n      if (!dc || dc.defeated) continue;\n      const fk = Object.keys(figPositions).find(k => k.startsWith(dc.dcName + '-'));\n      if (fk && !game[`scavengedWalkerDeployMoveFired_${mid}`]) {\n        abilities.push({ abilityId: 'scavenged_walker_move'\x2C label: 'Scavenged Walker'\x2C dcName: dc.dcName\x2C figureKey: fk\x2C msgId: mid\x2C playerNum\x2C interactive: true\x2C type: 'movement'\x2C optional: true });\n      }\n    }\n    // Cross Training (attachment): after deployment\x2C this group becomes Hidden\n    if (atts.some(a => a.toLowerCase() === 'cross training')) {\n      const dc = dcList[i];\n      if (dc && !dc.defeated) {\n        // Find all deployed figures in the same deployment group\n        const dgMatch = Object.keys(figPositions).find(k => k.startsWith(dc.dcName + '-'));\n        if (dgMatch) {\n          const dgPrefix = dgMatch.match(/^(.+-\\d+)-/)?.[1]; // e.g. "Snowtrooper (Elite)-1"\n          if (dgPrefix) {\n            const groupFigures = Object.keys(figPositions).filter(k => k.startsWith(dgPrefix + '-') && figPositions[k]);\n            for (const gfk of groupFigures) {\n              abilities.push({ abilityId: 'cross_training_hidden'\x2C label: 'Cross Training'\x2C dcName: dc.dcName\x2C figureKey: gfk\x2C playerNum\x2C interactive: false\x2C type: 'condition' });\n            }\n          }\n        }\n      }\n    }\n    // Companion deployment via attachment (e.g.\x2C [Clan of Two] \u2192 The Child)\n    for (const attName of atts) {\n      const attData = dcEffects[attName] || dcEffects[`[${attName}]`];\n      if (attData && typeof attData.companion === 'string' && !game[`companionDeployed_${mid}`]) {\n        const dc = dcList[i];\n        if (!dc || dc.defeated) continue;\n        const hostFk = Object.keys(figPositions).find(k => k.startsWith(dc.dcName + '-'));\n        if (hostFk) {\n          // Check if the ability text allows adjacent placement (e.g. "your space or an adjacent space")\n          const allowsAdjacent = (attData.abilityText || '').toLowerCase().includes('adjacent space');\n          abilities.push({\n            abilityId: 'companion_deploy'\x2C label: `Deploy ${attData.companion}`\x2C\n            dcName: dc.dcName\x2C figureKey: hostFk\x2C msgId: mid\x2C playerNum\x2C\n            companionName: attData.companion\x2C\n            interactive: allowsAdjacent\x2C type: 'companion'\x2C\n            companionAllowsAdjacent: allowsAdjacent\x2C\n          });\n        }\n      }\n    }\n  }\n\n  return abilities;\n}\n\n/**\n * Group abilities by DC so the picker is cleaner. Consolidate auto-apply abilities\n * from the same DC into one entry.\n */\nfunction consolidateAbilities(abilities) {\n  const consolidated = [];\n  const autoByFk = new Map();\n\n  for (const ab of abilities) {\n    if (!ab.interactive) {\n      const key = ab.figureKey;\n      if (!autoByFk.has(key)) autoByFk.set(key\x2C []);\n      autoByFk.get(key).push(ab);\n    } else {\n      consolidated.push(ab);\n    }\n  }\n\n  for (const [fk\x2C group] of autoByFk) {\n    consolidated.push(...group);\n  }\n\n  return consolidated;\n}\n\n// \u2500\u2500 Auto-apply resolution \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function resolveAutoAbility(game\x2C ability\x2C client\x2C logGameAction) {\n  const { abilityId\x2C dcName\x2C figureKey\x2C playerNum } = ability;\n\n  switch (abilityId) {\n    case 'beskar_armor': {\n      grantPowerTokens(game\x2C figureKey\x2C 'Block'\x2C 2);\n      await logGameAction(game\x2C client\x2C `\ud83d\udee1\ufe0f **Beskar Armor** \u2014 **${dcName}** gains **2 Block Tokens** after deployment.`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n      break;\n    }\n    case 'stealthy': {\n      applyCondition(game\x2C figureKey\x2C 'Hide');\n      await logGameAction(game\x2C client\x2C `\ud83e\udd77 **Stealthy** \u2014 **${dcName}** becomes **Hidden** at start of mission.`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n      break;\n    }\n    case 'ambush': {\n      applyCondition(game\x2C figureKey\x2C 'Hide');\n      await logGameAction(game\x2C client\x2C `\ud83e\udd77 **Ambush** \u2014 **${dcName}** becomes **Hidden** after deployment.`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n      break;\n    }\n    case 'in_the_shadows': {\n      applyCondition(game\x2C figureKey\x2C 'Hide');\n      await logGameAction(game\x2C client\x2C `\ud83e\udd77 **In The Shadows** \u2014 **${dcName}** becomes **Hidden** after deployment.`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n      break;\n    }\n    case 'cross_training_hidden': {\n      applyCondition(game\x2C figureKey\x2C 'Hide');\n      await logGameAction(game\x2C client\x2C `\ud83e\udd77 **Cross Training** \u2014 **${dcName}** becomes **Hidden** after deployment.`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n      break;\n    }\n    case 'security_detail': {\n      // Auto-resolve: pick the only LEADER\n      const leaders = ability.leaders || [];\n      if (leaders.length > 0) {\n        const leader = leaders[0];\n        grantPowerTokens(game\x2C leader.figureKey\x2C 'Block'\x2C 1);\n        await logGameAction(game\x2C client\x2C `\ud83d\udee1\ufe0f **Security Detail** \u2014 **${leader.dcName}** gains **1 Block Token** (from ${dcName}).`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n      }\n      break;\n    }\n    case 'companion_deploy': {\n      // Place companion at host figure's position\n      const companionName = ability.companionName;\n      const hostPos = game.figurePositions?.[playerNum]?.[figureKey];\n      if (hostPos && companionName) {\n        const companionKey = `${companionName}-0-0`;\n        if (!game.figurePositions[playerNum]) game.figurePositions[playerNum] = {};\n        game.figurePositions[playerNum][companionKey] = hostPos;\n        game[`companionDeployed_${ability.msgId}`] = true;\n        // Track companion \u2192 host relationship for activation\n        game.companionHostMap = game.companionHostMap || {};\n        game.companionHostMap[companionKey] = { hostFigureKey: figureKey\x2C playerNum };\n        await logGameAction(game\x2C client\x2C `\ud83d\udc76 **${companionName}** deployed at **${dcName}**'s position (${hostPos}).`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n        // Create DC embed for companion in Play Area\n        const embedDeps = _companionEmbedDeps.get(game.gameId);\n        if (embedDeps) {\n          try {\n            await _createCompanionDcEmbed(game\x2C companionName\x2C playerNum\x2C ability.msgId\x2C client\x2C embedDeps);\n          } catch (err) {\n            console.error(`[post-deploy] Failed to create companion DC embed for ${companionName}:`\x2C err.message);\n          }\n        }\n      }\n      break;\n    }\n  }\n}\n\n// \u2500\u2500 Companion DC embed creation \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Create a DC embed for a companion figure in the player's Play Area.\n * Mirrors the pattern from populatePlayAreas in setup-bridge.js.\n */\nasync function _createCompanionDcEmbed(game\x2C companionName\x2C playerNum\x2C hostMsgId\x2C client\x2C deps) {\n  const {\n    buildDcEmbedAndFiles\x2C dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState\x2C\n    getDcPlayAreaComponents\x2C getNicknamesForDcMessage\x2C\n  } = deps;\n\n  const playAreaId = playerNum === 1 ? game.p1PlayAreaId : game.p2PlayAreaId;\n  if (!playAreaId) return;\n\n  const stats = getDcStats(companionName);\n  const health = stats?.health ?? '?';\n  const figures = stats?.figures ?? 1;\n  const healthState = Array.from({ length: figures }\x2C () => [health\x2C health]);\n  const displayName = companionName;\n  const dcInfo = { dcName: companionName\x2C displayName };\n\n  const { embed\x2C files } = await buildDcEmbedAndFiles(\n    companionName\x2C false\x2C displayName\x2C healthState\x2C undefined\x2C []\x2C null\x2C null\x2C\n    getNicknamesForDcMessage(game\x2C dcInfo)\x2C\n  );\n\n  const playArea = await fetchGameChannel(client\x2C playAreaId);\n  const msg = await playArea.send({ embeds: [embed]\x2C files });\n\n  dcMessageMeta.set(msg.id\x2C { gameId: game.gameId\x2C playerNum\x2C dcName: companionName\x2C displayName });\n  dcExhaustedState.set(msg.id\x2C false);\n  dcHealthState.set(msg.id\x2C healthState);\n\n  const components = getDcPlayAreaComponents(msg.id\x2C false\x2C game\x2C companionName);\n  await msg.edit({ components });\n\n  // Store companion message ID at the host DC's index\n  const hostMsgIds = playerNum === 1 ? game.p1DcMessageIds : game.p2DcMessageIds;\n  const companionMsgIds = playerNum === 1 ? game.p1DcCompanionMessageIds : game.p2DcCompanionMessageIds;\n  const hostIdx = hostMsgIds?.indexOf(hostMsgId);\n  if (hostIdx >= 0 && companionMsgIds) {\n    companionMsgIds[hostIdx] = msg.id;\n  }\n}\n\n// \u2500\u2500 Movement prompt for post-deploy figures \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Start movement for the next figure in a multi-movement flow.\n * Used by Smooth Landing\x2C Forward Emplacement\x2C Strike Team (after adj pick).\n * For smooth_landing: shows a picker so the player chooses which figure moves next.\n * For other abilities: uses currentFigureIdx to auto-advance.\n */\nasync function _startNextMovement(game\x2C gameId\x2C client\x2C ctx) {\n  const { logGameAction\x2C saveGames } = ctx;\n  const q = game.postDeployQueue;\n  if (!q) return;\n  q.pendingActions = null; // Clear stash \u2014 movement system handles its own buttons\n  const active = q.activeAbility;\n  if (!active || !active.moveFigures) return;\n\n  // For smooth_landing with player-chosen order: show picker when >1 figures remain\n  if (active.abilityId === 'smooth_landing' && !active._pickedFigureKey) {\n    // Filter to remaining figures (not yet resolved)\n    const remaining = active.moveFigures.filter(f => !active._resolvedFigures?.includes(f.figureKey));\n    if (remaining.length === 0) {\n      // All figures done\n      q.activeAbility = null;\n      await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames);\n      if (saveGames) saveGames();\n      return;\n    }\n    if (remaining.length === 1) {\n      // Only one left \u2014 auto-pick it\n      active._pickedFigureKey = remaining[0].figureKey;\n    } else {\n      // Show picker buttons for remaining figures\n      const playerNum = active.playerNum;\n      const ownerId = getPlayerId(game\x2C playerNum);\n      const btns = remaining.slice(0\x2C 20).map(f => new ButtonBuilder()\n        .setCustomId(`pd_sl_pick_${gameId}_${playerNum}_${f.figureKey}`)\n        .setLabel(buildFigureButtonLabel(f.figureKey\x2C game))\n        .setStyle(ButtonStyle.Primary)\n      );\n      _stashPendingActions(game\x2C btns\x2C 'Smooth Landing');\n      const rows = chunkButtonsToRows(btns);\n      const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n      if (generalChannel) {\n        await generalChannel.send({\n          content: `\ud83d\udeec **Smooth Landing** \u2014 <@${ownerId}>\x2C choose which figure moves next (${remaining.length} remaining):`\x2C\n          components: rows\x2C\n          allowedMentions: { users: [ownerId] }\x2C\n        }).catch(() => null);\n      }\n      if (saveGames) saveGames();\n      return;\n    }\n  }\n\n  // Determine which figure to move\n  let fig;\n  if (active._pickedFigureKey) {\n    fig = active.moveFigures.find(f => f.figureKey === active._pickedFigureKey);\n    delete active._pickedFigureKey;\n  } else {\n    const idx = active.currentFigureIdx || 0;\n    if (idx >= active.moveFigures.length) {\n      q.activeAbility = null;\n      await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames);\n      if (saveGames) saveGames();\n      return;\n    }\n    fig = active.moveFigures[idx];\n  }\n\n  if (!fig) {\n    q.activeAbility = null;\n    await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames);\n    if (saveGames) saveGames();\n    return;\n  }\n\n  await _startMovementForFigure(game\x2C gameId\x2C client\x2C ctx\x2C fig);\n}\n\n/**\n * Start movement UI for a specific figure. Extracted from _startNextMovement\n * so it can be called by both the auto-advance and picker flows.\n */\nasync function _startMovementForFigure(game\x2C gameId\x2C client\x2C ctx\x2C fig) {\n  const { logGameAction\x2C saveGames\x2C dcMessageMeta\x2C getBoardStateForMovement\x2C getMovementProfile\x2C computeMovementCache\x2C getMovementMinimapAttachment } = ctx;\n  const q = game.postDeployQueue;\n  if (!q) return;\n  const active = q.activeAbility;\n  if (!active) return;\n\n  const { figureKey\x2C dcName\x2C mp } = fig;\n  const playerNum = active.playerNum;\n  const pos = game.figurePositions?.[playerNum]?.[figureKey];\n  const ownerId = getPlayerId(game\x2C playerNum);\n\n  if (!pos) {\n    // Figure has no position \u2014 advance\n    await _advanceAfterFigure(game\x2C gameId\x2C client\x2C ctx\x2C figureKey);\n    return;\n  }\n\n  // Find msgId for this figure's DC\n  let msgId = null;\n  for (const [mid\x2C meta] of dcMessageMeta) {\n    if (meta.dcName === dcName && meta.playerNum === playerNum) { msgId = mid; break; }\n  }\n  if (!msgId) {\n    await logGameAction(game\x2C client\x2C `\u26a0\ufe0f Could not find play area message for **${dcName}** \u2014 skipping movement.`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n    await _advanceAfterFigure(game\x2C gameId\x2C client\x2C ctx\x2C figureKey);\n    return;\n  }\n\n  const boardState = getBoardStateForMovement(game\x2C figureKey);\n  if (!boardState) {\n    await _advanceAfterFigure(game\x2C gameId\x2C client\x2C ctx\x2C figureKey);\n    return;\n  }\n  const profile = getMovementProfile(dcName\x2C figureKey\x2C game);\n  const cache = computeMovementCache(pos\x2C mp\x2C boardState\x2C profile);\n\n  // Fix 1: When no valid movement spaces\x2C show a Stay button instead of auto-skipping\n  if (cache.cells.size === 0) {\n    const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n    if (!generalChannel) {\n      await _advanceAfterFigure(game\x2C gameId\x2C client\x2C ctx\x2C figureKey);\n      return;\n    }\n    const stayBtn = new ButtonBuilder()\n      .setCustomId(`pd_move_stay_${gameId}_${playerNum}_${figureKey}`)\n      .setLabel('Stay (Skip Movement)')\n      .setStyle(ButtonStyle.Secondary);\n    _stashPendingActions(game\x2C [stayBtn]\x2C active.abilityLabel || 'Post-Deploy');\n    await generalChannel.send({\n      content: `\ud83d\udeec **${active.abilityLabel || 'Post-Deploy'}** \u2014 <@${ownerId}>\x2C **${dcName}** has no valid movement spaces (${mp} MP). Figure may stay in place.`\x2C\n      components: [new ActionRowBuilder().addComponents(stayBtn)]\x2C\n      allowedMentions: { users: [ownerId] }\x2C\n    }).catch(() => null);\n    if (saveGames) saveGames();\n    return;\n  }\n\n  // Set up movement via the movement engine\n  const dgMatch = figureKey.match(/^(.+)-(\\d+)-(\\d+)$/);\n  const figureIndex = dgMatch ? parseInt(dgMatch[3]\x2C 10) : 0;\n  game.moveInProgress = game.moveInProgress || {};\n  const moveKey = `${msgId}_${figureIndex}`;\n  game.moveInProgress[moveKey] = {\n    figureKey\x2C\n    playerNum\x2C\n    mpRemaining: mp\x2C\n    displayName: dcName\x2C\n    msgId\x2C\n    movementProfile: profile\x2C\n    boardState\x2C\n    movementCache: cache\x2C\n    cacheMaxMp: mp\x2C\n    startCoord: pos\x2C\n    pendingMp: null\x2C\n    distanceMessageId: null\x2C\n    postDeployReturn: true\x2C\n  };\n\n  const buttonSpaces = [...cache.cells.keys()];\n  const isMultiTile = profile.size && profile.size !== '1x1';\n  game.moveGridMessageIds = game.moveGridMessageIds || {};\n\n  // Build labelMap for multi-tile figures (show bottom-left coords)\n  const labelMap = {};\n  if (isMultiTile) {\n    for (const s of buttonSpaces) {\n      const n = normalizeCoord(s);\n      labelMap[n] = bottomLeftCoord(n\x2C profile.size).toUpperCase();\n    }\n  }\n  const multiTileNote = isMultiTile ? `\\n\ud83d\udcd0 Buttons show **bottom-left corner** of each valid placement.` : '';\n  const rowDisplayOffset = isMultiTile ? parseSizeString(profile.size).rows - 1 : 0;\n  const minimapCells = isMultiTile\n    ? buttonSpaces.map((tl) => bottomLeftCoord(tl\x2C profile.size))\n    : buttonSpaces;\n  const minimap = getMovementMinimapAttachment ? await getMovementMinimapAttachment(game\x2C msgId\x2C figureKey\x2C minimapCells) : null;\n\n  const totalFigs = active.moveFigures.length;\n  const resolvedCount = active._resolvedFigures?.length || 0;\n  const remainingCount = totalFigs - resolvedCount;\n  const figLabel = totalFigs > 1 ? ` (${remainingCount} remaining)` : '';\n\n  // Store pendingSpacePick for generic row\u2192cell handler\n  const moveContextKey = `${gameId}_${moveKey}`;\n  const moveHeader = `\ud83d\udeec **${active.abilityLabel || 'Post-Deploy'}**${figLabel} \u2014 <@${ownerId}>\x2C move **${dcName}** (**${mp}** MP):${multiTileNote}`;\n  const moveActionBtns = [\n    { customId: `pd_move_skip_${gameId}_${playerNum}_${moveKey}`\x2C label: 'Skip Movement'\x2C style: ButtonStyle.Secondary }\x2C\n  ];\n  game.pendingSpacePick = game.pendingSpacePick || {};\n  game.pendingSpacePick[moveContextKey] = {\n    validSpaces: buttonSpaces\x2C\n    cellPrefix: `move_pick_${msgId}_${figureIndex}_`\x2C\n    mapSpaces: boardState.mapSpaces\x2C\n    labelMap\x2C\n    headerText: moveHeader\x2C\n    actionButtons: moveActionBtns\x2C\n    rowDisplayOffset\x2C\n  };\n  const { rows: moveRowBtns } = buildRowPickerButtons(buttonSpaces\x2C `space_row_${moveContextKey}_`\x2C { rowDisplayOffset });\n  const actionBtns = moveActionBtns.map(b =>\n    new ButtonBuilder().setCustomId(b.customId).setLabel(b.label).setStyle(b.style)\n  );\n  const actionRow = new ActionRowBuilder().addComponents(...actionBtns);\n\n  // Find the game-log channel to post the movement UI\n  const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n  if (!generalChannel) {\n    await _advanceAfterFigure(game\x2C gameId\x2C client\x2C ctx\x2C figureKey);\n    return;\n  }\n\n  const payload = {\n    content: `${moveHeader}\\nChoose a row:`\x2C\n    components: [...moveRowBtns.slice(0\x2C 4)\x2C actionRow]\x2C\n    allowedMentions: { users: [ownerId] }\x2C\n  };\n  if (minimap) payload.files = [minimap];\n\n  const gridMsg = await generalChannel.send(payload).catch(() => null);\n  game.moveGridMessageIds[moveKey] = gridMsg?.id ? [gridMsg.id] : [];\n\n  if (saveGames) saveGames();\n}\n\n/**\n * Single entry point: advance after a figure finishes movement (or is skipped).\n * Handles all ability types \u2014 smooth_landing (resolved-figure tracking + picker)\x2C\n * strike_team (index-based + token distribution transition)\x2C and others (index-based).\n * @param {string} figureKey \u2014 REQUIRED: the figure that just finished.\n */\nasync function _advanceAfterFigure(game\x2C gameId\x2C client\x2C ctx\x2C figureKey) {\n  const { logGameAction\x2C saveGames } = ctx;\n  const q = game.postDeployQueue;\n  if (!q) return;\n  const active = q.activeAbility;\n\n  // No active ability or no moveFigures \u2192 ability is done\n  if (!active || !active.moveFigures) {\n    if (active) q.activeAbility = null;\n    await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames);\n    if (saveGames) saveGames();\n    return;\n  }\n\n  if (active.abilityId === 'smooth_landing') {\n    // Resolved-figure tracking: mark this figure done\x2C show picker for remaining\n    active._resolvedFigures = active._resolvedFigures || [];\n    if (figureKey && !active._resolvedFigures.includes(figureKey)) {\n      active._resolvedFigures.push(figureKey);\n    }\n    const remaining = active.moveFigures.filter(f => !active._resolvedFigures.includes(f.figureKey));\n    if (remaining.length === 0) {\n      q.activeAbility = null;\n      await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames);\n      if (saveGames) saveGames();\n      return;\n    }\n    await _startNextMovement(game\x2C gameId\x2C client\x2C ctx);\n  } else {\n    // Index-based advance (Forward Emplacement\x2C Strike Team\x2C Scavenged Walker\x2C etc.)\n    active.currentFigureIdx = (active.currentFigureIdx || 0) + 1;\n    if (active.currentFigureIdx >= active.moveFigures.length) {\n      // All figures moved \u2014 check if Strike Team needs token distribution next\n      if (active.abilityId === 'strike_team' && active.tokenRemaining > 0) {\n        active.step = 'tokens';\n        active.moveFigures = null;\n        await _postStrikeTeamTokenPicker(game\x2C gameId\x2C active.playerNum\x2C client\x2C logGameAction);\n      } else {\n        q.activeAbility = null;\n        await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames);\n      }\n    } else {\n      await _startNextMovement(game\x2C gameId\x2C client\x2C ctx);\n    }\n  }\n}\n\n// \u2500\u2500 Interactive ability posting \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function postInteractiveAbility(game\x2C gameId\x2C ability\x2C client\x2C ctx) {\n  const { logGameAction\x2C saveGames\x2C dcMessageMeta\x2C getBoardStateForMovement\x2C getMovementProfile\x2C computeMovementCache\x2C getMovementMinimapAttachment } = ctx;\n  const ownerId = getPlayerId(game\x2C ability.playerNum);\n\n  switch (ability.abilityId) {\n    case 'security_detail': {\n      const leaders = ability.leaders || [];\n      const btns = leaders.map(l => new ButtonBuilder()\n        .setCustomId(`pd_security_pick_${gameId}_${ability.playerNum}_${ability.figureKey}_${l.figureKey}`)\n        .setLabel(l.dcName)\n        .setStyle(ButtonStyle.Primary)\n      );\n      _stashPendingActions(game\x2C btns\x2C 'Security Detail');\n      const rows = chunkButtonsToRows(btns);\n      await logGameAction(game\x2C client\x2C `\ud83d\udee1\ufe0f **Security Detail** (${ability.dcName}) \u2014 <@${ownerId}>\x2C choose which **LEADER** gains 1 Block Token:`\x2C {\n        components: rows\x2C\n        allowedMentions: { users: [ownerId] }\x2C\n      });\n      break;\n    }\n    case 'smooth_landing': {\n      // Log the ability\x2C then start sequential movement for each figure\n      const labels = ability.moveFigures.map(f => f.dcName);\n      await logGameAction(game\x2C client\x2C `\ud83d\udeec **Smooth Landing** \u2014 ${labels.join('\x2C ')} gain${labels.length === 1 ? 's' : ''} **1 MP** after deployment. Resolve movement now.`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n      game.postDeployQueue.activeAbility = {\n        abilityId: 'smooth_landing'\x2C\n        abilityLabel: 'Smooth Landing'\x2C\n        moveFigures: ability.moveFigures\x2C\n        currentFigureIdx: 0\x2C\n        playerNum: ability.playerNum\x2C\n      };\n      await _startNextMovement(game\x2C gameId\x2C client\x2C ctx);\n      break;\n    }\n    case 'forward_emplacement': {\n      await logGameAction(game\x2C client\x2C `\ud83c\udfd7\ufe0f **Forward Emplacement** \u2014 **${ability.dcName}** gains **${ability.mp} MP** after deployment. Resolve movement now.`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n      game.postDeployQueue.activeAbility = {\n        abilityId: 'forward_emplacement'\x2C\n        abilityLabel: 'Forward Emplacement'\x2C\n        moveFigures: [{ figureKey: ability.figureKey\x2C dcName: ability.dcName\x2C mp: ability.mp }]\x2C\n        currentFigureIdx: 0\x2C\n        playerNum: ability.playerNum\x2C\n      };\n      await _startNextMovement(game\x2C gameId\x2C client\x2C ctx);\n      break;\n    }\n    case 'strike_team': {\n      // Step 1: Grant Cassian 2 MP\n      const stMoveFigures = [{ figureKey: ability.figureKey\x2C dcName: ability.dcName\x2C mp: 2 }];\n\n      // Find adjacent friendlies\n      const pos = game.figurePositions?.[ability.playerNum]?.[ability.figureKey];\n      const ms = getMapData(game.selectedMap?.id);\n      const adj = pos ? (ms?.adjacency?.[String(pos).toLowerCase()] || []).map(a => String(a).toLowerCase()) : [];\n      const adjFriendlies = [];\n      for (const [afk\x2C apos] of Object.entries(game.figurePositions?.[ability.playerNum] || {})) {\n        if (!apos || afk === ability.figureKey) continue;\n        if (adj.includes(String(apos).toLowerCase())) {\n          adjFriendlies.push({ figureKey: afk\x2C dcName: dcNameFromFigureKey(afk) });\n        }\n      }\n\n      if (adjFriendlies.length === 0) {\n        // No adjacent friendlies \u2014 Cassian moves alone\x2C then Hit tokens\n        await logGameAction(game\x2C client\x2C `\u26a1 **Strike Team** \u2014 **${ability.dcName}** gains **2 MP**. No adjacent friendly figures for additional MP.`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n        game.postDeployQueue.activeAbility = {\n          abilityId: 'strike_team'\x2C\n          abilityLabel: 'Strike Team'\x2C\n          step: 'movement'\x2C\n          moveFigures: stMoveFigures\x2C\n          currentFigureIdx: 0\x2C\n          playerNum: ability.playerNum\x2C\n          figureKey: ability.figureKey\x2C\n          tokenRemaining: 4\x2C\n          alreadyReceived: []\x2C\n        };\n        await _startNextMovement(game\x2C gameId\x2C client\x2C ctx);\n      } else if (adjFriendlies.length === 1) {\n        // Only one adjacent \u2014 auto-pick\x2C then let player choose movement order\n        const friend = adjFriendlies[0];\n        await logGameAction(game\x2C client\x2C `\u26a1 **Strike Team** \u2014 **${ability.dcName}** and **${friend.dcName}** each gain **2 MP**.`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n        game.postDeployQueue.activeAbility = {\n          abilityId: 'strike_team'\x2C\n          abilityLabel: 'Strike Team'\x2C\n          step: 'order_pick'\x2C\n          cassianMoveFigure: stMoveFigures[0]\x2C\n          friendMoveFigure: { figureKey: friend.figureKey\x2C dcName: friend.dcName\x2C mp: 2 }\x2C\n          playerNum: ability.playerNum\x2C\n          figureKey: ability.figureKey\x2C\n          tokenRemaining: 4\x2C\n          alreadyReceived: []\x2C\n        };\n        const orderBtns = [\n          new ButtonBuilder().setCustomId(`pd_strike_order_${gameId}_${ability.playerNum}_cassian`).setLabel(`Move ${ability.dcName} first`).setStyle(ButtonStyle.Primary)\x2C\n          new ButtonBuilder().setCustomId(`pd_strike_order_${gameId}_${ability.playerNum}_friend`).setLabel(`Move ${friend.dcName} first`).setStyle(ButtonStyle.Primary)\x2C\n        ];\n        _stashPendingActions(game\x2C orderBtns\x2C 'Strike Team');\n        await logGameAction(game\x2C client\x2C `\u26a1 **Strike Team** \u2014 <@${ownerId}>\x2C choose who moves first:`\x2C {\n          components: [new ActionRowBuilder().addComponents(orderBtns)]\x2C\n          allowedMentions: { users: [ownerId] }\x2C\n        });\n      } else {\n        // Multiple adjacent \u2014 player picks\n        game.postDeployQueue.activeAbility = {\n          abilityId: 'strike_team'\x2C\n          abilityLabel: 'Strike Team'\x2C\n          step: 'adj_pick'\x2C\n          cassianMoveFigure: stMoveFigures[0]\x2C\n          tokenRemaining: 4\x2C\n          playerNum: ability.playerNum\x2C\n          figureKey: ability.figureKey\x2C\n          alreadyReceived: []\x2C\n        };\n        const btns = adjFriendlies.map(f => new ButtonBuilder()\n          .setCustomId(`pd_strike_adj_${gameId}_${ability.playerNum}_${f.figureKey}`)\n          .setLabel(f.dcName)\n          .setStyle(ButtonStyle.Primary)\n        );\n        _stashPendingActions(game\x2C btns\x2C 'Strike Team');\n        const rows = chunkButtonsToRows(btns);\n        await logGameAction(game\x2C client\x2C `\u26a1 **Strike Team** \u2014 **${ability.dcName}** gains **2 MP**. <@${ownerId}>\x2C choose an adjacent friendly figure to also gain **2 MP**:`\x2C {\n          components: rows\x2C\n          allowedMentions: { users: [ownerId] }\x2C\n          phase: 'ROUND'\x2C icon: 'deployed'\x2C\n        });\n      }\n      break;\n    }\n    case 'infiltration': {\n      const figures = ability.figureKeys || [ability.figureKey];\n      game.postDeployQueue.activeAbility = {\n        abilityId: 'infiltration'\x2C\n        abilityLabel: 'Infiltration'\x2C\n        moveFigures: figures.map(fk => ({ figureKey: fk\x2C dcName: dcNameFromFigureKey(fk)\x2C mp: ability.mpPerFigure || 6 }))\x2C\n        currentFigureIdx: 0\x2C\n        playerNum: ability.playerNum\x2C\n        dcName: ability.dcName\x2C\n      };\n      // Start movement for first figure\n      await _startNextMovement(game\x2C gameId\x2C client\x2C ctx);\n      break;\n    }\n    case 'extra_armor': {\n      game[`extraArmorFired_p${ability.playerNum}`] = true;\n      const allFks = Object.keys(game.figurePositions?.[ability.playerNum] || {});\n      if (allFks.length > 0) {\n        game.figurePowerTokens = game.figurePowerTokens || {};\n        game[`pendingExtraArmor_p${ability.playerNum}`] = { remaining: 4\x2C total: 4\x2C allocation: {} };\n        game.postDeployQueue.activeAbility = { abilityId: 'extra_armor'\x2C playerNum: ability.playerNum\x2C remaining: 4 };\n        const btns = allFks.slice(0\x2C 20).map(fk => new ButtonBuilder()\n          .setCustomId(`extra_armor_pick_${gameId}_${ability.playerNum}_${fk}`)\n          .setLabel(buildFigureButtonLabel(fk\x2C game))\n          .setStyle(ButtonStyle.Primary)\n        );\n        _stashPendingActions(game\x2C btns\x2C 'Extra Armor');\n        const rows = chunkButtonsToRows(btns);\n        await logGameAction(game\x2C client\x2C `\ud83d\udee1\ufe0f **Extra Armor** \u2014 <@${ownerId}>\x2C distribute **4 Block Tokens** among your figures (4 remaining). Check your hand channel.`\x2C {\n          allowedMentions: { users: [ownerId] }\x2C\n        });\n        // Send buttons to player's hand channel so only they can interact\n        const handChId = getHandChannelId(game\x2C ability.playerNum);\n        try {\n          const handCh = await fetchGameChannel(client\x2C handChId);\n          const sent = await handCh.send({\n            content: '\ud83d\udee1\ufe0f **Extra Armor** \u2014 Choose a figure to give **1 Block Token** (4 remaining):'\x2C\n            components: rows\x2C\n          });\n          game[`pendingExtraArmor_p${ability.playerNum}`].handMsgId = sent.id;\n          game[`pendingExtraArmor_p${ability.playerNum}`].handChId = handChId;\n        } catch (err) {\n          console.error('Extra Armor hand channel send failed:'\x2C err);\n        }\n      }\n      break;\n    }\n    case 'arms_distribution_deploy': {\n      game[`armsDistDeployFired_p${ability.playerNum}`] = true;\n      // Find all friendly figures within 3 spaces of Ko-Tun (graph distance)\n      const kotunPos = game.figurePositions?.[ability.playerNum]?.[ability.figureKey];\n      const _adMapId = game.selectedMap?.id;\n      const _adMs = _adMapId ? getMapData(_adMapId) : null;\n      const _adAllDoors = _adMapId ? (getMapTokensData()?.[_adMapId]?.doors || []) : [];\n      const _adOpenedSet = new Set((game.openedDoors || []).map(k => String(k).toLowerCase()));\n      const _adClosedDoorEdges = new Set(\n        _adAllDoors\n          .filter(e => { const a = String(e[0]).toLowerCase()\x2C b = String(e[1]).toLowerCase(); return !_adOpenedSet.has(`${a}|${b}`) && !_adOpenedSet.has(`${b}|${a}`); })\n          .map(e => edgeKey(e[0]\x2C e[1]))\n      );\n      const eligible = [];\n      for (const [fk\x2C fpos] of Object.entries(game.figurePositions?.[ability.playerNum] || {})) {\n        if (!fpos) continue;\n        const dist = countSpaces(_adMs\x2C kotunPos\x2C fpos\x2C _adClosedDoorEdges);\n        if (dist <= 3) {\n          eligible.push(fk);\n        }\n      }\n      if (eligible.length === 0) {\n        await logGameAction(game\x2C client\x2C `\ud83c\udfaf **Arms Distribution (Deploy)** \u2014 No friendly figures within 3 spaces of **${ability.dcName}**.`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n        game.postDeployQueue.activeAbility = null; game.postDeployQueue.pendingActions = null;\n        await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction);\n        break;\n      }\n      game.postDeployQueue.activeAbility = {\n        abilityId: 'arms_distribution_deploy'\x2C\n        playerNum: ability.playerNum\x2C\n        figureKey: ability.figureKey\x2C\n        dcName: ability.dcName\x2C\n        eligibleFigures: eligible\x2C\n        step: 'pick_figure'\x2C\n      };\n      const btns = eligible.slice(0\x2C 20).map(fk => new ButtonBuilder()\n        .setCustomId(`pd_arms_dist_fig_${gameId}_${ability.playerNum}_${fk}`)\n        .setLabel(buildFigureButtonLabel(fk\x2C game))\n        .setStyle(ButtonStyle.Primary)\n      );\n      _stashPendingActions(game\x2C btns\x2C 'Arms Distribution');\n      const rows = chunkButtonsToRows(btns);\n      await logGameAction(game\x2C client\x2C `\ud83c\udfaf **Arms Distribution (Deploy)** \u2014 <@${ownerId}>\x2C choose **1 friendly figure** within 3 spaces of **${ability.dcName}** to gain **1 Power Token**:`\x2C {\n        components: rows.slice(0\x2C 5)\x2C\n        allowedMentions: { users: [ownerId] }\x2C\n      });\n      break;\n    }\n    case 'companion_deploy': {\n      // Interactive companion deploy \u2014 player chooses host space or adjacent space\n      const companionName = ability.companionName;\n      const hostPos = game.figurePositions?.[ability.playerNum]?.[ability.figureKey];\n      if (!hostPos || !companionName) break;\n      const hostNorm = normalizeCoord(hostPos);\n\n      // Get all cells adjacent to the host figure (multi-cell aware)\n      const ms = getMapData(game.selectedMap?.id);\n      const adjacency = ms?.adjacency || {};\n      const hostSize = game.figureOrientations?.[ability.figureKey] || getFigureSize(ability.dcName) || '1x1';\n      const hostCells = getFootprintCells(hostPos\x2C hostSize).map(c => normalizeCoord(c));\n      const adjSet = new Set();\n      for (const hc of hostCells) {\n        for (const n of (adjacency[hc] || [])) {\n          const nn = normalizeCoord(n);\n          // Exclude cells the host itself occupies\n          if (!hostCells.includes(nn)) adjSet.add(nn);\n        }\n      }\n      // Filter out spaces occupied by any figure\n      const allPositions = new Set();\n      for (const pn of [1\x2C 2]) {\n        for (const [fk\x2C fpos] of Object.entries(game.figurePositions?.[pn] || {})) {\n          if (!fpos) continue;\n          const fSize = game.figureOrientations?.[fk] || getFigureSize(dcNameFromFigureKey(fk)) || '1x1';\n          for (const c of getFootprintCells(fpos\x2C fSize)) allPositions.add(normalizeCoord(c));\n        }\n      }\n      const adjSpaces = [...adjSet].filter(s => !allPositions.has(s));\n\n      // Build buttons: host space first\x2C then adjacent\n      // Only gameId\x2C playerNum\x2C and space are needed \u2014 companion info lives in activeAbility\n      const btns = [];\n      btns.push(new ButtonBuilder()\n        .setCustomId(`pd_comp_space_${gameId}_${ability.playerNum}_${hostNorm}`)\n        .setLabel(`Host space (${hostNorm.toUpperCase()})`)\n        .setStyle(ButtonStyle.Primary)\n      );\n      for (const adjSpace of adjSpaces.slice(0\x2C 19)) {\n        btns.push(new ButtonBuilder()\n          .setCustomId(`pd_comp_space_${gameId}_${ability.playerNum}_${adjSpace}`)\n          .setLabel(adjSpace.toUpperCase())\n          .setStyle(ButtonStyle.Secondary)\n        );\n      }\n      const rows = chunkButtonsToRows(btns);\n\n      game.postDeployQueue.activeAbility = {\n        abilityId: 'companion_deploy'\x2C\n        playerNum: ability.playerNum\x2C\n        figureKey: ability.figureKey\x2C\n        dcName: ability.dcName\x2C\n        companionName\x2C\n        msgId: ability.msgId\x2C\n      };\n      _stashPendingActions(game\x2C btns\x2C `Deploy ${companionName}`);\n\n      await logGameAction(game\x2C client\x2C `\ud83d\udc76 **Deploy ${companionName}** \u2014 <@${ownerId}>\x2C choose a space to deploy **${companionName}** (${ability.dcName}'s space or an adjacent space):`\x2C {\n        components: rows\x2C\n        allowedMentions: { users: [ownerId] }\x2C\n      });\n      break;\n    }\n    case 'scavenged_walker_move': {\n      game[`scavengedWalkerDeployMoveFired_${ability.msgId}`] = true;\n      // Use the unified movement flow\n      const dcEffectsData = getDcEffects() || {};\n      const walkerEff = dcEffectsData[ability.dcName];\n      const walkerMp = walkerEff?.speed || 4;\n      game.postDeployQueue.activeAbility = {\n        abilityId: 'scavenged_walker_move'\x2C\n        abilityLabel: 'Scavenged Walker'\x2C\n        moveFigures: [{ figureKey: ability.figureKey\x2C dcName: ability.dcName\x2C mp: walkerMp }]\x2C\n        currentFigureIdx: 0\x2C\n        playerNum: ability.playerNum\x2C\n        msgId: ability.msgId\x2C\n        optional: true\x2C\n      };\n      await renderWalkerMovePrompt(game\x2C gameId\x2C client\x2C { logGameAction });\n      break;\n    }\n  }\n}\n\n// \u2500\u2500 Strike Team: Damage Token distribution \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function _postStrikeTeamTokenPicker(game\x2C gameId\x2C playerNum\x2C client\x2C logGameAction) {\n  const active = game.postDeployQueue?.activeAbility;\n  if (!active || active.abilityId !== 'strike_team') return;\n\n  const ownerId = getPlayerId(game\x2C playerNum);\n  const dzData = getDeploymentZones();\n  const mapId = game.selectedMap?.id;\n  const zone = playerNum === 1 ? game.player1DeploymentZone : game.player2DeploymentZone;\n  const dzSpaces = (dzData?.[mapId]?.[zone] || []).map(s => String(s).toLowerCase());\n  const dzSet = new Set(dzSpaces);\n\n  // Find friendlies outside deployment zone (exclude figures that already received a token)\n  const alreadyReceivedSet = new Set(active.alreadyReceived || []);\n  const outsideZone = [];\n  for (const [fk\x2C pos] of Object.entries(game.figurePositions?.[playerNum] || {})) {\n    if (!pos) continue;\n    if (alreadyReceivedSet.has(fk)) continue;\n    if (!dzSet.has(String(pos).toLowerCase())) {\n      outsideZone.push({ figureKey: fk\x2C dcName: dcNameFromFigureKey(fk) });\n    }\n  }\n\n  if (outsideZone.length === 0 || active.tokenRemaining <= 0) {\n    await logGameAction(game\x2C client\x2C `\u26a1 **Strike Team** \u2014 No friendly figures outside deployment zone (or no tokens remaining).`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n    game.postDeployQueue.activeAbility = null; game.postDeployQueue.pendingActions = null;\n    await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction);\n    return;\n  }\n\n  const btns = outsideZone.slice(0\x2C 20).map(f => new ButtonBuilder()\n    .setCustomId(`pd_strike_token_${gameId}_${playerNum}_${f.figureKey}`)\n    .setLabel(buildFigureButtonLabel(f.figureKey\x2C game))\n    .setStyle(ButtonStyle.Primary)\n  );\n  btns.push(new ButtonBuilder()\n    .setCustomId(`pd_strike_token_done_${gameId}_${playerNum}`)\n    .setLabel(`Done (${active.tokenRemaining} remaining)`)\n    .setStyle(ButtonStyle.Secondary)\n  );\n  _stashPendingActions(game\x2C btns\x2C 'Strike Team');\n  const rows = chunkButtonsToRows(btns);\n  await logGameAction(game\x2C client\x2C `\u26a1 **Strike Team** \u2014 <@${ownerId}>\x2C choose up to **${active.tokenRemaining}** friendly figure(s) outside your deployment zone to gain **1 Damage Token** each:`\x2C {\n    components: rows\x2C\n    allowedMentions: { users: [ownerId] }\x2C\n  });\n}\n\n// \u2500\u2500 Ability picker \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames) {\n  const q = game.postDeployQueue;\n  if (!q) return;\n\n  const abilities = q.abilities || [];\n  if (abilities.length === 0) {\n    await advanceToNextPlayer(game\x2C gameId\x2C client\x2C logGameAction);\n    return;\n  }\n\n  const ownerId = getPlayerId(game\x2C q.currentPlayerNum);\n  const playerLabel = `Player ${q.currentPlayerNum}`;\n\n  // If only auto-apply abilities remain\x2C resolve them all\n  const hasInteractive = abilities.some(a => a.interactive);\n  if (!hasInteractive) {\n    for (const ab of abilities) {\n      await resolveAutoAbility(game\x2C ab\x2C client\x2C logGameAction);\n      if (game.pendingPowerTokenOverflow?.length > 0) {\n        const _ovCh = await fetchGameChannel(client\x2C game.generalId);\n        if (_ovCh) await sendPowerTokenOverflowUI(game\x2C gameId\x2C _ovCh\x2C ab.playerNum\x2C saveGames);\n      }\n    }\n    q.abilities = [];\n    await advanceToNextPlayer(game\x2C gameId\x2C client\x2C logGameAction);\n    return;\n  }\n\n  // Auto-resolve all non-interactive abilities before showing buttons\n  const autoAbilities = abilities.filter(a => !a.interactive);\n  const interactiveAbilities = abilities.filter(a => a.interactive);\n  for (const ab of autoAbilities) {\n    await resolveAutoAbility(game\x2C ab\x2C client\x2C logGameAction);\n    if (game.pendingPowerTokenOverflow?.length > 0) {\n      const _ovCh = await fetchGameChannel(client\x2C game.generalId);\n      if (_ovCh) await sendPowerTokenOverflowUI(game\x2C gameId\x2C _ovCh\x2C ab.playerNum\x2C saveGames);\n    }\n  }\n  q.abilities = interactiveAbilities;\n\n  if (interactiveAbilities.length === 0) {\n    q.abilities = [];\n    await advanceToNextPlayer(game\x2C gameId\x2C client\x2C logGameAction);\n    return;\n  }\n\n  q.awaitingOrder = true;\n  await renderPostDeployChooserPrompt(game\x2C gameId\x2C client\x2C { logGameAction });\n}\n\n/**\n * Render-from-state: post the "After Deployment" ability chooser from pure\n * game state (postDeployQueue.abilities\x2C already filtered to interactive).\n * Records the resulting msg into game.promptMessageIds.postDeployChooser.\n */\nexport async function renderPostDeployChooserPrompt(game\x2C gameId\x2C client\x2C ctx) {\n  const q = game.postDeployQueue;\n  if (!q) return;\n  const interactiveAbilities = (q.abilities || []).filter((a) => a.interactive);\n  if (interactiveAbilities.length === 0) return;\n  const ownerId = getPlayerId(game\x2C q.currentPlayerNum);\n  const playerLabel = `Player ${q.currentPlayerNum}`;\n  const btns = interactiveAbilities.map((ab\x2C idx) =>\n    new ButtonBuilder()\n      .setCustomId(`pd_pick_${gameId}_${q.currentPlayerNum}_${idx}`)\n      .setLabel(`${ab.label} \u2014 ${ab.dcName}`)\n      .setStyle(ButtonStyle.Primary)\n  );\n  const rows = chunkButtonsToRows(btns);\n  const logGameAction = ctx?.logGameAction;\n  if (!logGameAction) return;\n  const sent = await logGameAction(game\x2C client\x2C `\ud83d\udccb **After Deployment** \u2014 <@${ownerId}> (${playerLabel})\x2C choose which ability to resolve next (${interactiveAbilities.length} remaining):`\x2C {\n    components: rows\x2C\n    allowedMentions: { users: [ownerId] }\x2C\n  });\n  if (sent?.id) {\n    const { recordPromptMessage\x2C signatureFor } = await import('../engine/prompt-reconciler.js');\n    recordPromptMessage(game\x2C 'postDeployChooser'\x2C sent.channelId || sent.channel?.id\x2C sent.id\x2C signatureFor('postDeployChooser'\x2C game));\n  }\n}\n\n/**\n * Render-from-state: post the Scavenged Walker "Perform Move / Skip" prompt\n * from game.postDeployQueue.activeAbility. Records msg into\n * game.promptMessageIds.walkerMove.\n */\nexport async function renderWalkerMovePrompt(game\x2C gameId\x2C client\x2C ctx) {\n  const active = game.postDeployQueue?.activeAbility;\n  if (!active || active.abilityId !== 'scavenged_walker_move') return;\n  const fig = active.moveFigures?.[0];\n  if (!fig) return;\n  const msgId = active.msgId || '';\n  const ownerId = getPlayerId(game\x2C active.playerNum);\n  const btns = [\n    new ButtonBuilder().setCustomId(`pd_walker_move_${gameId}_${active.playerNum}_${msgId}`).setLabel('Perform Move').setStyle(ButtonStyle.Primary)\x2C\n    new ButtonBuilder().setCustomId(`pd_walker_skip_${gameId}_${active.playerNum}_${msgId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary)\x2C\n  ];\n  _stashPendingActions(game\x2C btns\x2C 'Scavenged Walker');\n  const logGameAction = ctx?.logGameAction;\n  if (!logGameAction) return;\n  const sent = await logGameAction(game\x2C client\x2C `\ud83d\udeb6 **Scavenged Walker** \u2014 <@${ownerId}>\x2C **${fig.dcName}** may perform a move after deployment:`\x2C {\n    components: [new ActionRowBuilder().addComponents(btns)]\x2C\n    allowedMentions: { users: [ownerId] }\x2C\n  });\n  if (sent?.id) {\n    const { recordPromptMessage\x2C signatureFor } = await import('../engine/prompt-reconciler.js');\n    recordPromptMessage(game\x2C 'walkerMove'\x2C sent.channelId || sent.channel?.id\x2C sent.id\x2C signatureFor('walkerMove'\x2C game));\n  }\n}\n\n// \u2500\u2500 Player advancement \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function advanceToNextPlayer(game\x2C gameId\x2C client\x2C logGameAction) {\n  const q = game.postDeployQueue;\n  if (!q) return;\n\n  if (q.nextPlayerAbilities && q.nextPlayerAbilities.length > 0) {\n    q.currentPlayerNum = opponentPlayerNum(q.currentPlayerNum);\n    q.abilities = q.nextPlayerAbilities;\n    q.nextPlayerAbilities = null;\n    q.awaitingOrder = false;\n    q.activeAbility = null;\n    await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction);\n  } else {\n    await finishPostDeploy(game\x2C gameId\x2C client\x2C logGameAction);\n  }\n}\n\nasync function finishPostDeploy(game\x2C gameId\x2C client\x2C logGameAction) {\n  delete game.postDeployQueue;\n  game.postDeployEffectsFired = true;\n  _companionEmbedDeps.delete(gameId);\n  const cb = _postDeployCallbacks.get(gameId);\n  _postDeployCallbacks.delete(gameId);\n  // Legacy migration: drop stale serialized callback artifact so DB doesn't keep it.\n  if (game._postDeployCallback) delete game._postDeployCallback;\n  if (cb) {\n    await cb();\n    return;\n  }\n  // Callback missing (process restarted between runPostDeployPhase and\n  // finishPostDeploy). For the cc_draw transition\x2C post shuffle/draw prompts\n  // directly from pure state so the game can still advance without a manual\n  // Refresh. Refresh path has its own safety net for the belt-and-suspenders case.\n  if (game.phase === 'cc_draw' && !game.ccShuffleDrawPromptsPosted) {\n    try {\n      const [{ sendCcShuffleDrawPrompts }\x2C { getCcShuffleDrawButton }\x2C { getInitiativePlayerZoneLabel }] = await Promise.all([\n        import('../engine/cc-draw-prompts.js')\x2C\n        import('../discord/components.js')\x2C\n        import('../discord/embeds.js')\x2C\n      ]);\n      await sendCcShuffleDrawPrompts(game\x2C client\x2C {\n        getCcShuffleDrawButton\x2C getInitiativePlayerZoneLabel\x2C\n      });\n    } catch (err) {\n      console.error('finishPostDeploy: CC prompt auto-recovery failed'\x2C err);\n    }\n  }\n  // Draft Random restart-strand fallback: post-deploy finished but callback\n  // (which sets ACTIVATION phase + posts the round message) was dropped. Pure\n  // state says we're in ROUND_ACTIVE/START_OF_ROUND with no activation message\n  // posted \u2014 advance to ACTIVATION. Message posting itself relies on the\n  // refresh safety net (which has the full dep graph); bot auto-refresh on\n  // startup means this state is visible before user interactions fire.\n  if (\n    game.phase === 'round_active'\n    && game.roundPhase === 'start_of_round'\n    && !game.activationPhaseMessagePosted\n  ) {\n    try {\n      const { setRoundPhase\x2C ROUND_PHASES } = await import('../game/phase.js');\n      setRoundPhase(game\x2C ROUND_PHASES.ACTIVATION);\n    } catch (err) {\n      console.error('finishPostDeploy: activation phase auto-recovery failed'\x2C err);\n    }\n  }\n}\n\n/**\n * Clean up module-level _companionEmbedDeps for a game (e.g. when game is killed).\n * @param {string} gameId\n */\nexport function cleanupCompanionEmbedDeps(gameId) {\n  _companionEmbedDeps.delete(gameId);\n  _postDeployCallbacks.delete(gameId);\n}\n\n// \u2500\u2500 Public API \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Main entry point: replaces the old inline post-deploy block.\n *\n * @param {object} game\n * @param {string} gameId\n * @param {object} client - Discord client\n * @param {object} ctx - { logGameAction\x2C saveGames\x2C dcMessageMeta\x2C getBoardStateForMovement\x2C getMovementProfile\x2C computeMovementCache\x2C getMovementMinimapAttachment\x2C buildBoardMapPayload }\n * @param {function} onComplete - called when all post-deploy effects are done\n * @returns {boolean} true if a queue was created (async flow)\x2C false if all resolved immediately\n */\nexport async function runPostDeployPhase(game\x2C gameId\x2C client\x2C ctx\x2C onComplete) {\n  const { logGameAction\x2C saveGames } = ctx;\n\n  // Store companion DC embed deps if provided (consumed by resolveAutoAbility)\n  if (ctx.buildDcEmbedAndFiles) {\n    _companionEmbedDeps.set(gameId\x2C ctx);\n  }\n\n  if (game.postDeployEffectsFired) return false;\n\n  const initPn = getInitiativePlayerNum(game);\n  const otherPn = opponentPlayerNum(initPn);\n\n  const initAbilities = consolidateAbilities(scanPlayerPostDeployAbilities(game\x2C initPn));\n  const otherAbilities = consolidateAbilities(scanPlayerPostDeployAbilities(game\x2C otherPn));\n\n  // No abilities at all \u2014 skip\n  if (initAbilities.length === 0 && otherAbilities.length === 0) {\n    game.postDeployEffectsFired = true;\n    _companionEmbedDeps.delete(gameId);\n    return false;\n  }\n\n  const initHasInteractive = initAbilities.some(a => a.interactive);\n  const otherHasInteractive = otherAbilities.some(a => a.interactive);\n\n  // All auto-apply for both players \u2014 resolve immediately\n  if (!initHasInteractive && !otherHasInteractive) {\n    game.postDeployEffectsFired = true;\n    for (const ab of initAbilities) await resolveAutoAbility(game\x2C ab\x2C client\x2C logGameAction);\n    for (const ab of otherAbilities) await resolveAutoAbility(game\x2C ab\x2C client\x2C logGameAction);\n    _companionEmbedDeps.delete(gameId);\n    // Check for overflow after batch auto-resolve\n    if (game.pendingPowerTokenOverflow?.length > 0) {\n      const _ovCh = await fetchGameChannel(client\x2C game.generalId);\n      if (_ovCh) {\n        const _ovEntry = game.pendingPowerTokenOverflow[0];\n        const _ovPn = _ovEntry?.playerNum || initPn;\n        await sendPowerTokenOverflowUI(game\x2C gameId\x2C _ovCh\x2C _ovPn\x2C saveGames);\n      }\n    }\n    if (saveGames) saveGames();\n    return false;\n  }\n\n  // Set up the queue\n  game.postDeployQueue = {\n    currentPlayerNum: initPn\x2C\n    abilities: initAbilities\x2C\n    nextPlayerAbilities: otherAbilities\x2C\n    awaitingOrder: false\x2C\n    activeAbility: null\x2C\n  };\n\n  // Store callback in module-level map (NOT on game \u2014 functions don't survive JSON.stringify).\n  // If this process restarts before finishPostDeploy\x2C the callback is lost; the CC-draw\n  // safety net in refreshAllGameComponents will re-post prompts from state.\n  if (onComplete) _postDeployCallbacks.set(gameId\x2C onComplete);\n\n  await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames);\n  if (saveGames) saveGames();\n  return true;\n}\n\n/**\n * Called after an interactive sub-flow completes to advance the queue.\n */\nexport async function advancePostDeployQueue(game\x2C gameId\x2C client\x2C ctx) {\n  const { logGameAction\x2C saveGames } = ctx;\n  const q = game.postDeployQueue;\n  if (!q) return;\n\n  q.activeAbility = null;\n  await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames);\n  if (saveGames) saveGames();\n}\n\n// \u2500\u2500 Button handlers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Player picks which ability to resolve next.\n */\nexport async function handlePostDeployPick(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'pd_pick_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const abilityIdx = parseInt(parts[2]\x2C 10);\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (canActAsPlayer && !canActAsPlayer(game\x2C interaction.user.id\x2C playerNum)) {\n    await interaction.followUp({ content: 'Only the owning player can pick post-deploy abilities.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const q = game.postDeployQueue;\n  if (!q || q.currentPlayerNum !== playerNum) {\n    await interaction.followUp({ content: 'Not your turn for post-deploy abilities.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const abilities = q.abilities || [];\n  if (abilityIdx < 0 || abilityIdx >= abilities.length) {\n    await interaction.followUp({ content: 'Invalid ability selection.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  // Remove from queue\n  const [ability] = abilities.splice(abilityIdx\x2C 1);\n  q.awaitingOrder = false;\n\n  // Disable buttons on the picker message\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  const { clearPromptRecord } = await import('../engine/prompt-reconciler.js');\n  clearPromptRecord(game\x2C 'postDeployChooser');\n\n  if (!ability.interactive) {\n    await resolveAutoAbility(game\x2C ability\x2C client\x2C logGameAction);\n    if (game.pendingPowerTokenOverflow?.length > 0) {\n      const _ovCh = await fetchGameChannel(client\x2C game.generalId);\n      if (_ovCh) await sendPowerTokenOverflowUI(game\x2C gameId\x2C _ovCh\x2C ability.playerNum\x2C saveGames);\n    }\n    await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames);\n  } else {\n    await postInteractiveAbility(game\x2C gameId\x2C ability\x2C client\x2C ctx);\n  }\n  saveGames();\n}\n\n/**\n * Security Detail: player picks which LEADER gets the Block Token.\n */\nexport async function handleSecurityDetailPick(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'pd_security_pick_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (canActAsPlayer && !canActAsPlayer(game\x2C interaction.user.id\x2C playerNum)) {\n    await interaction.followUp({ content: 'Only the owning player can pick.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const leaderFk = parts.slice(2).join('_');\n  const leaderDcName = dcNameFromFigureKey(leaderFk);\n  grantPowerTokens(game\x2C leaderFk\x2C 'Block'\x2C 1);\n  await logGameAction(game\x2C client\x2C `\ud83d\udee1\ufe0f **Security Detail** \u2014 **${leaderDcName}** gains **1 Block Token**.`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n  if (game.pendingPowerTokenOverflow?.length > 0) {\n    await sendPowerTokenOverflowUI(game\x2C gameId\x2C interaction.channel\x2C playerNum\x2C saveGames);\n  }\n\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  const q = game.postDeployQueue;\n  if (q) {\n    q.activeAbility = null;\n    await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames);\n  }\n  saveGames();\n}\n\n/**\n * Strike Team: player picks adjacent friendly for 2 MP.\n */\nexport async function handleStrikeTeamAdjPick(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'pd_strike_adj_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const friendFk = parts.slice(2).join('_');\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (canActAsPlayer && !canActAsPlayer(game\x2C interaction.user.id\x2C playerNum)) {\n    await interaction.followUp({ content: 'Only the owning player can pick.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const friendDcName = dcNameFromFigureKey(friendFk);\n  const active = game.postDeployQueue?.activeAbility;\n  const cassianFk = active?.figureKey;\n  const cassianName = cassianFk ? dcNameFromFigureKey(cassianFk) : 'Cassian Andor';\n  await logGameAction(game\x2C client\x2C `\u26a1 **Strike Team** \u2014 **${cassianName}** and **${friendDcName}** each gain **2 MP**.`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  // Let player choose movement order\n  if (active) {\n    const cassianMove = active.cassianMoveFigure || { figureKey: cassianFk\x2C dcName: cassianName\x2C mp: 2 };\n    active.step = 'order_pick';\n    active.cassianMoveFigure = cassianMove;\n    active.friendMoveFigure = { figureKey: friendFk\x2C dcName: friendDcName\x2C mp: 2 };\n    const ownerId = getPlayerId(game\x2C playerNum);\n    const orderBtns = [\n      new ButtonBuilder().setCustomId(`pd_strike_order_${gameId}_${playerNum}_cassian`).setLabel(`Move ${cassianName} first`).setStyle(ButtonStyle.Primary)\x2C\n      new ButtonBuilder().setCustomId(`pd_strike_order_${gameId}_${playerNum}_friend`).setLabel(`Move ${friendDcName} first`).setStyle(ButtonStyle.Primary)\x2C\n    ];\n    _stashPendingActions(game\x2C orderBtns\x2C 'Strike Team');\n    await logGameAction(game\x2C client\x2C `\u26a1 **Strike Team** \u2014 <@${ownerId}>\x2C choose who moves first:`\x2C {\n      components: [new ActionRowBuilder().addComponents(orderBtns)]\x2C\n      allowedMentions: { users: [ownerId] }\x2C\n    });\n  }\n  saveGames();\n}\n\n/**\n * Strike Team: player chooses movement order (Cassian first or friend first).\n */\nexport async function handleStrikeTeamOrderPick(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'pd_strike_order_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const choice = parts[2]; // 'cassian' or 'friend'\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (canActAsPlayer && !canActAsPlayer(game\x2C interaction.user.id\x2C playerNum)) {\n    await interaction.followUp({ content: 'Only the owning player can pick.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const active = game.postDeployQueue?.activeAbility;\n  if (!active || active.abilityId !== 'strike_team' || active.step !== 'order_pick') return;\n\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  const cassianMove = active.cassianMoveFigure;\n  const friendMove = active.friendMoveFigure;\n  active.step = 'movement';\n  active.moveFigures = choice === 'friend'\n    ? [friendMove\x2C cassianMove]\n    : [cassianMove\x2C friendMove];\n  active.currentFigureIdx = 0;\n  await _startNextMovement(game\x2C gameId\x2C client\x2C ctx);\n  saveGames();\n}\n\n/**\n * Strike Team: player picks a figure outside deployment zone for Damage Token.\n */\nexport async function handleStrikeTeamTokenPick(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'pd_strike_token_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const figureKey = parts.slice(2).join('_');\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (canActAsPlayer && !canActAsPlayer(game\x2C interaction.user.id\x2C playerNum)) {\n    await interaction.followUp({ content: 'Only the owning player can pick.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const active = game.postDeployQueue?.activeAbility;\n  if (!active || active.abilityId !== 'strike_team') return;\n\n  const dcName = dcNameFromFigureKey(figureKey);\n  grantPowerTokens(game\x2C figureKey\x2C 'Damage'\x2C 1);\n  active.tokenRemaining -= 1;\n  if (!active.alreadyReceived) active.alreadyReceived = [];\n  active.alreadyReceived.push(figureKey);\n\n  await logGameAction(game\x2C client\x2C `\u26a1 **Strike Team** \u2014 **${dcName}** gains **1 Damage Token** (${active.tokenRemaining} remaining).`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n  if (game.pendingPowerTokenOverflow?.length > 0) {\n    await sendPowerTokenOverflowUI(game\x2C gameId\x2C interaction.channel\x2C playerNum\x2C saveGames);\n  }\n\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  if (active.tokenRemaining <= 0) {\n    game.postDeployQueue.activeAbility = null; game.postDeployQueue.pendingActions = null;\n    await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames);\n  } else {\n    await _postStrikeTeamTokenPicker(game\x2C gameId\x2C playerNum\x2C client\x2C logGameAction);\n  }\n  saveGames();\n}\n\n/**\n * Strike Team: player is done distributing Damage Tokens.\n */\nexport async function handleStrikeTeamTokenDone(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'pd_strike_token_done_');\n  const gameId = parts[0];\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const _tdPn = game.postDeployQueue?.currentPlayerNum;\n  if (_tdPn && canActAsPlayer && !canActAsPlayer(game\x2C interaction.user.id\x2C _tdPn)) {\n    await interaction.followUp({ content: 'Only the owning player can do this.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  const q = game.postDeployQueue;\n  if (q) {\n    q.activeAbility = null;\n    await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames);\n  }\n  saveGames();\n}\n\n/**\n * Post-deploy movement skip: player skips movement for a figure.\n */\nexport async function handlePostDeployMoveSkip(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'pd_move_skip_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const moveKey = parts.slice(2).join('_');\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (canActAsPlayer && !canActAsPlayer(game\x2C interaction.user.id\x2C playerNum)) {\n    await interaction.followUp({ content: 'Only the owning player can skip.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  // Read figureKey BEFORE cleaning up moveInProgress (needed for smooth_landing tracking)\n  const skippedFigureKey = game.moveInProgress?.[moveKey]?.figureKey || null;\n\n  // Clean up pendingSpacePick\n  cleanupSpacePick(game\x2C `${gameId}_${moveKey}`);\n\n  // Clean up moveInProgress\n  if (game.moveInProgress?.[moveKey]) {\n    delete game.moveInProgress[moveKey];\n  }\n  // Clean up grid messages\n  if (game.moveGridMessageIds?.[moveKey]) {\n    for (const mid of game.moveGridMessageIds[moveKey]) {\n      try {\n        const ch = interaction.channel || await fetchGameChannel(client\x2C game.generalId);\n        const msg = await ch.messages.fetch(mid).catch(() => null);\n        if (msg) await msg.edit({ components: [] }).catch(discordCatch);\n      } catch {}\n    }\n    delete game.moveGridMessageIds[moveKey];\n  }\n\n  const q = game.postDeployQueue;\n  if (!q) { saveGames(); return; }\n\n  await _advanceAfterFigure(game\x2C gameId\x2C client\x2C ctx\x2C skippedFigureKey);\n  saveGames();\n}\n\n/**\n * Scavenged Walker: player starts the post-deploy move.\n */\nexport async function handleWalkerMove(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'pd_walker_move_');\n  const gameId = parts[0];\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const _wmPn = game.postDeployQueue?.currentPlayerNum;\n  if (_wmPn && canActAsPlayer && !canActAsPlayer(game\x2C interaction.user.id\x2C _wmPn)) {\n    await interaction.followUp({ content: 'Only the owning player can move.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  const { clearPromptRecord } = await import('../engine/prompt-reconciler.js');\n  clearPromptRecord(game\x2C 'walkerMove');\n\n  const active = game.postDeployQueue?.activeAbility;\n  if (!active || active.abilityId !== 'scavenged_walker_move') return;\n\n  // Start the movement flow\n  await _startNextMovement(game\x2C gameId\x2C client\x2C ctx);\n  saveGames();\n}\n\n/**\n * Scavenged Walker: player skips the post-deploy move.\n */\nexport async function handleWalkerSkip(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'pd_walker_skip_');\n  const gameId = parts[0];\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const _wsPn = game.postDeployQueue?.currentPlayerNum;\n  if (_wsPn && canActAsPlayer && !canActAsPlayer(game\x2C interaction.user.id\x2C _wsPn)) {\n    await interaction.followUp({ content: 'Only the owning player can skip.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  const { clearPromptRecord } = await import('../engine/prompt-reconciler.js');\n  clearPromptRecord(game\x2C 'walkerMove');\n\n  const q = game.postDeployQueue;\n  if (q) {\n    q.activeAbility = null;\n    await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames);\n  }\n  saveGames();\n}\n\n/**\n * Smooth Landing figure picker: player chooses which figure moves next.\n */\nexport async function handleSmoothLandingPick(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'pd_sl_pick_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const figureKey = parts.slice(2).join('_');\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (canActAsPlayer && !canActAsPlayer(game\x2C interaction.user.id\x2C playerNum)) {\n    await interaction.followUp({ content: 'Only the owning player can pick.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  const active = game.postDeployQueue?.activeAbility;\n  if (!active || active.abilityId !== 'smooth_landing') return;\n\n  // Set the picked figure and start its movement\n  active._pickedFigureKey = figureKey;\n  await _startNextMovement(game\x2C gameId\x2C client\x2C ctx);\n  saveGames();\n}\n\n/**\n * Post-deploy movement Stay: figure stays in place (no valid movement spaces).\n */\nexport async function handlePostDeployMoveStay(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'pd_move_stay_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const figureKey = parts.slice(2).join('_');\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (canActAsPlayer && !canActAsPlayer(game\x2C interaction.user.id\x2C playerNum)) {\n    await interaction.followUp({ content: 'Only the owning player can skip.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  const dcName = dcNameFromFigureKey(figureKey);\n  const active = game.postDeployQueue?.activeAbility;\n  await logGameAction(game\x2C client\x2C `\ud83d\udeec **${active?.abilityLabel || 'Post-Deploy'}** \u2014 **${dcName}** stays in place.`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n\n  await _advanceAfterFigure(game\x2C gameId\x2C client\x2C ctx\x2C figureKey);\n  saveGames();\n}\n\n/**\n * Called from movement.js handleMovePick when a postDeployReturn move finishes.\n * If massive displacement is still unresolved\x2C record a lightweight descriptor\n * on game state and defer. The massive-push dispatcher resumes by calling\n * resumeDeferredPostDeployMove with its own ctx (movePick group) once the\n * displacement queue drains.\n *\n * The descriptor is pure state \u2014 no in-memory closures \u2014 so refresh and\n * restart paths can reconstruct the resume action from game alone.\n */\nexport async function onPostDeployMovementComplete(game\x2C gameId\x2C client\x2C ctx\x2C completedFigureKey) {\n  const { saveGames } = ctx;\n  if (game.pendingMassivePush) {\n    game._postDeployMoveDeferred = { figureKey: completedFigureKey\x2C at: Date.now() };\n    if (saveGames) saveGames();\n    return;\n  }\n  await _advanceAfterFigure(game\x2C gameId\x2C client\x2C ctx\x2C completedFigureKey);\n  if (saveGames) saveGames();\n}\n\n/**\n * Resume a deferred post-deploy movement-complete advance. Called by the\n * massive-push dispatcher once the queue drains. Caller supplies the ctx\n * (movePick group) which is a superset of what _advanceAfterFigure needs.\n * No-op if nothing was deferred.\n */\nexport async function resumeDeferredPostDeployMove(game\x2C gameId\x2C client\x2C ctx) {\n  const deferred = game._postDeployMoveDeferred;\n  if (!deferred) return;\n  const figureKey = deferred.figureKey;\n  delete game._postDeployMoveDeferred;\n  await _advanceAfterFigure(game\x2C gameId\x2C client\x2C ctx\x2C figureKey);\n  const saveGames = ctx?.saveGames;\n  if (saveGames) saveGames();\n}\n\n/**\n * Called from the existing handleExtraArmorPick when all tokens are distributed\x2C\n * if a postDeployQueue is active.\n */\nexport async function onExtraArmorComplete(game\x2C gameId\x2C client\x2C ctx) {\n  const { logGameAction\x2C saveGames } = ctx;\n  const q = game.postDeployQueue;\n  if (!q) return;\n\n  q.activeAbility = null;\n  await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames);\n  if (saveGames) saveGames();\n}\n\n/**\n * Arms Distribution (Deploy): player picks a friendly figure within 3 spaces of Ko-Tun.\n */\nexport async function handleArmsDistFigPick(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'pd_arms_dist_fig_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const figureKey = parts.slice(2).join('_');\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (canActAsPlayer && !canActAsPlayer(game\x2C interaction.user.id\x2C playerNum)) {\n    await interaction.followUp({ content: 'Only the owning player can pick.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const active = game.postDeployQueue?.activeAbility;\n  if (!active || active.abilityId !== 'arms_distribution_deploy') return;\n\n  // Store selected figure\x2C show token type picker\n  active.selectedFigure = figureKey;\n  active.step = 'pick_token';\n  const dcName = dcNameFromFigureKey(figureKey);\n\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  const tokenBtns = ['Damage'\x2C 'Surge'\x2C 'Block'\x2C 'Evade'].map(t => new ButtonBuilder()\n    .setCustomId(`pd_arms_dist_token_${gameId}_${playerNum}_${t}`)\n    .setLabel(t)\n    .setStyle(t === 'Damage' || t === 'Surge' ? ButtonStyle.Danger : ButtonStyle.Primary)\n  );\n  _stashPendingActions(game\x2C tokenBtns\x2C 'Arms Distribution');\n  await logGameAction(game\x2C client\x2C `\ud83c\udfaf **Arms Distribution (Deploy)** \u2014 Choose a Power Token type for **${dcName}**:`\x2C {\n    components: [new ActionRowBuilder().addComponents(tokenBtns)]\x2C\n  });\n  saveGames();\n}\n\n/**\n * Arms Distribution (Deploy): player picks token type (Hit/Surge/Block/Evade).\n */\nexport async function handleArmsDistTokenPick(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'pd_arms_dist_token_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const tokenType = parts[2]; // 'Damage'\x2C 'Surge'\x2C 'Block'\x2C or 'Evade'\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (canActAsPlayer && !canActAsPlayer(game\x2C interaction.user.id\x2C playerNum)) {\n    await interaction.followUp({ content: 'Only the owning player can pick.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const active = game.postDeployQueue?.activeAbility;\n  if (!active || active.abilityId !== 'arms_distribution_deploy' || !active.selectedFigure) return;\n\n  const figureKey = active.selectedFigure;\n  const dcName = dcNameFromFigureKey(figureKey);\n\n  grantPowerTokens(game\x2C figureKey\x2C tokenType\x2C 1);\n  await logGameAction(game\x2C client\x2C `\ud83c\udfaf **Arms Distribution (Deploy)** \u2014 **${dcName}** gains **1 ${tokenType} Token**.`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n  if (game.pendingPowerTokenOverflow?.length > 0) {\n    await sendPowerTokenOverflowUI(game\x2C gameId\x2C interaction.channel\x2C playerNum\x2C saveGames);\n  }\n\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  game.postDeployQueue.activeAbility = null;\n  await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames);\n  saveGames();\n}\n\n/**\n * Companion deploy: player picks a space to deploy the companion.\n */\nexport async function handleCompanionDeployPick(interaction\x2C ctx) {\n  const { getGame\x2C canActAsPlayer\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  // customId: pd_comp_space_${gameId}_${playerNum}_${space}\n  const parts = splitCustomId(interaction.customId\x2C 'pd_comp_space_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const space = parts.slice(2).join('_');\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (canActAsPlayer && !canActAsPlayer(game\x2C interaction.user.id\x2C playerNum)) {\n    await interaction.followUp({ content: 'Only the owning player can deploy companions.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const active = game.postDeployQueue?.activeAbility;\n  if (!active || active.abilityId !== 'companion_deploy') {\n    await interaction.followUp({ content: 'No companion deploy in progress.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const normSpace = normalizeCoord(space);\n  const companionKey = `${active.companionName}-0-0`;\n  if (!game.figurePositions[playerNum]) game.figurePositions[playerNum] = {};\n  game.figurePositions[playerNum][companionKey] = normSpace;\n  game[`companionDeployed_${active.msgId}`] = true;\n\n  // Track companion \u2192 host relationship for activation\n  game.companionHostMap = game.companionHostMap || {};\n  game.companionHostMap[companionKey] = { hostFigureKey: active.figureKey\x2C playerNum };\n\n  await logGameAction(game\x2C client\x2C `\ud83d\udc76 **${active.companionName}** deployed at **${normSpace.toUpperCase()}** (${active.dcName}'s companion).`\x2C { phase: 'ROUND'\x2C icon: 'deployed' });\n\n  // Create DC embed for companion in Play Area\n  const embedDeps = _companionEmbedDeps.get(gameId);\n  if (embedDeps) {\n    try {\n      await _createCompanionDcEmbed(game\x2C active.companionName\x2C playerNum\x2C active.msgId\x2C client\x2C embedDeps);\n    } catch (err) {\n      console.error(`[post-deploy] Failed to create companion DC embed for ${active.companionName}:`\x2C err.message);\n    }\n  }\n\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  game.postDeployQueue.activeAbility = null;\n  await postAbilityPicker(game\x2C gameId\x2C client\x2C logGameAction\x2C saveGames);\n  saveGames();\n}\n
