script-source,286,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/pg-types/lib/binaryParsers.js,var parseInt64 = require('pg-int8');\n\nvar parseBits = function(data\x2C bits\x2C offset\x2C invert\x2C callback) {\n  offset = offset || 0;\n  invert = invert || false;\n  callback = callback || function(lastValue\x2C newValue\x2C bits) { return (lastValue * Math.pow(2\x2C bits)) + newValue; };\n  var offsetBytes = offset >> 3;\n\n  var inv = function(value) {\n    if (invert) {\n      return ~value & 0xff;\n    }\n\n    return value;\n  };\n\n  // read first (maybe partial) byte\n  var mask = 0xff;\n  var firstBits = 8 - (offset % 8);\n  if (bits < firstBits) {\n    mask = (0xff << (8 - bits)) & 0xff;\n    firstBits = bits;\n  }\n\n  if (offset) {\n    mask = mask >> (offset % 8);\n  }\n\n  var result = 0;\n  if ((offset % 8) + bits >= 8) {\n    result = callback(0\x2C inv(data[offsetBytes]) & mask\x2C firstBits);\n  }\n\n  // read bytes\n  var bytes = (bits + offset) >> 3;\n  for (var i = offsetBytes + 1; i < bytes; i++) {\n    result = callback(result\x2C inv(data[i])\x2C 8);\n  }\n\n  // bits to read\x2C that are not a complete byte\n  var lastBits = (bits + offset) % 8;\n  if (lastBits > 0) {\n    result = callback(result\x2C inv(data[bytes]) >> (8 - lastBits)\x2C lastBits);\n  }\n\n  return result;\n};\n\nvar parseFloatFromBits = function(data\x2C precisionBits\x2C exponentBits) {\n  var bias = Math.pow(2\x2C exponentBits - 1) - 1;\n  var sign = parseBits(data\x2C 1);\n  var exponent = parseBits(data\x2C exponentBits\x2C 1);\n\n  if (exponent === 0) {\n    return 0;\n  }\n\n  // parse mantissa\n  var precisionBitsCounter = 1;\n  var parsePrecisionBits = function(lastValue\x2C newValue\x2C bits) {\n    if (lastValue === 0) {\n      lastValue = 1;\n    }\n\n    for (var i = 1; i <= bits; i++) {\n      precisionBitsCounter /= 2;\n      if ((newValue & (0x1 << (bits - i))) > 0) {\n        lastValue += precisionBitsCounter;\n      }\n    }\n\n    return lastValue;\n  };\n\n  var mantissa = parseBits(data\x2C precisionBits\x2C exponentBits + 1\x2C false\x2C parsePrecisionBits);\n\n  // special cases\n  if (exponent == (Math.pow(2\x2C exponentBits + 1) - 1)) {\n    if (mantissa === 0) {\n      return (sign === 0) ? Infinity : -Infinity;\n    }\n\n    return NaN;\n  }\n\n  // normale number\n  return ((sign === 0) ? 1 : -1) * Math.pow(2\x2C exponent - bias) * mantissa;\n};\n\nvar parseInt16 = function(value) {\n  if (parseBits(value\x2C 1) == 1) {\n    return -1 * (parseBits(value\x2C 15\x2C 1\x2C true) + 1);\n  }\n\n  return parseBits(value\x2C 15\x2C 1);\n};\n\nvar parseInt32 = function(value) {\n  if (parseBits(value\x2C 1) == 1) {\n    return -1 * (parseBits(value\x2C 31\x2C 1\x2C true) + 1);\n  }\n\n  return parseBits(value\x2C 31\x2C 1);\n};\n\nvar parseFloat32 = function(value) {\n  return parseFloatFromBits(value\x2C 23\x2C 8);\n};\n\nvar parseFloat64 = function(value) {\n  return parseFloatFromBits(value\x2C 52\x2C 11);\n};\n\nvar parseNumeric = function(value) {\n  var sign = parseBits(value\x2C 16\x2C 32);\n  if (sign == 0xc000) {\n    return NaN;\n  }\n\n  var weight = Math.pow(10000\x2C parseBits(value\x2C 16\x2C 16));\n  var result = 0;\n\n  var digits = [];\n  var ndigits = parseBits(value\x2C 16);\n  for (var i = 0; i < ndigits; i++) {\n    result += parseBits(value\x2C 16\x2C 64 + (16 * i)) * weight;\n    weight /= 10000;\n  }\n\n  var scale = Math.pow(10\x2C parseBits(value\x2C 16\x2C 48));\n  return ((sign === 0) ? 1 : -1) * Math.round(result * scale) / scale;\n};\n\nvar parseDate = function(isUTC\x2C value) {\n  var sign = parseBits(value\x2C 1);\n  var rawValue = parseBits(value\x2C 63\x2C 1);\n\n  // discard usecs and shift from 2000 to 1970\n  var result = new Date((((sign === 0) ? 1 : -1) * rawValue / 1000) + 946684800000);\n\n  if (!isUTC) {\n    result.setTime(result.getTime() + result.getTimezoneOffset() * 60000);\n  }\n\n  // add microseconds to the date\n  result.usec = rawValue % 1000;\n  result.getMicroSeconds = function() {\n    return this.usec;\n  };\n  result.setMicroSeconds = function(value) {\n    this.usec = value;\n  };\n  result.getUTCMicroSeconds = function() {\n    return this.usec;\n  };\n\n  return result;\n};\n\nvar parseArray = function(value) {\n  var dim = parseBits(value\x2C 32);\n\n  var flags = parseBits(value\x2C 32\x2C 32);\n  var elementType = parseBits(value\x2C 32\x2C 64);\n\n  var offset = 96;\n  var dims = [];\n  for (var i = 0; i < dim; i++) {\n    // parse dimension\n    dims[i] = parseBits(value\x2C 32\x2C offset);\n    offset += 32;\n\n    // ignore lower bounds\n    offset += 32;\n  }\n\n  var parseElement = function(elementType) {\n    // parse content length\n    var length = parseBits(value\x2C 32\x2C offset);\n    offset += 32;\n\n    // parse null values\n    if (length == 0xffffffff) {\n      return null;\n    }\n\n    var result;\n    if ((elementType == 0x17) || (elementType == 0x14)) {\n      // int/bigint\n      result = parseBits(value\x2C length * 8\x2C offset);\n      offset += length * 8;\n      return result;\n    }\n    else if (elementType == 0x19) {\n      // string\n      result = value.toString(this.encoding\x2C offset >> 3\x2C (offset += (length << 3)) >> 3);\n      return result;\n    }\n    else {\n      console.log("ERROR: ElementType not implemented: " + elementType);\n    }\n  };\n\n  var parse = function(dimension\x2C elementType) {\n    var array = [];\n    var i;\n\n    if (dimension.length > 1) {\n      var count = dimension.shift();\n      for (i = 0; i < count; i++) {\n        array[i] = parse(dimension\x2C elementType);\n      }\n      dimension.unshift(count);\n    }\n    else {\n      for (i = 0; i < dimension[0]; i++) {\n        array[i] = parseElement(elementType);\n      }\n    }\n\n    return array;\n  };\n\n  return parse(dims\x2C elementType);\n};\n\nvar parseText = function(value) {\n  return value.toString('utf8');\n};\n\nvar parseBool = function(value) {\n  if(value === null) return null;\n  return (parseBits(value\x2C 8) > 0);\n};\n\nvar init = function(register) {\n  register(20\x2C parseInt64);\n  register(21\x2C parseInt16);\n  register(23\x2C parseInt32);\n  register(26\x2C parseInt32);\n  register(1700\x2C parseNumeric);\n  register(700\x2C parseFloat32);\n  register(701\x2C parseFloat64);\n  register(16\x2C parseBool);\n  register(1114\x2C parseDate.bind(null\x2C false));\n  register(1184\x2C parseDate.bind(null\x2C true));\n  register(1000\x2C parseArray);\n  register(1007\x2C parseArray);\n  register(1016\x2C parseArray);\n  register(1008\x2C parseArray);\n  register(1009\x2C parseArray);\n  register(25\x2C parseText);\n};\n\nmodule.exports = {\n  init: init\n};\n
