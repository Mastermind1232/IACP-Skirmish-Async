code-creation,Script,9,304536,0x3f05b92a12a0,52, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/engine/win-conditions.js:1:1,0x33c468583ce8,~
script-source,255,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/engine/win-conditions.js,/**\n * Win condition functions extracted from index.js.\n * Handles VP checks\x2C tiebreakers\x2C game-over posting\x2C and defeat-related bookkeeping.\n */\nimport { fetchGameChannel\x2C sanitizeMentions } from '../discord/channel-helpers.js';\nimport { cleanupAllSpacePicks } from '../discord/components.js';\nimport { countGameSpaces } from '../game/board-helpers.js';\n\n/**\n * Check if either player has reached 40 VP or been eliminated.\n * @param {object} game\n * @param {object} client - Discord client\n * @param {object} deps\n * @returns {Promise<{ ended: boolean\x2C winnerId?: string\x2C reason?: string }>}\n */\nexport async function checkWinConditions(game\x2C client\x2C deps) {\n  const crateBonus = deps.getCrateDeploymentVpBonus(game);\n  const patronBonus = deps.getAnchorheadPatronVpBonus(game);\n  const vp1 = (game.player1VP?.total ?? 0) + crateBonus.p1 + patronBonus.p1;\n  const vp2 = (game.player2VP?.total ?? 0) + crateBonus.p2 + patronBonus.p2;\n  const p1Figures = Object.keys(game.figurePositions?.[1] || {}).length;\n  const p2Figures = Object.keys(game.figurePositions?.[2] || {}).length;\n\n  if (vp1 >= 40 || vp2 >= 40) {\n    if (vp1 !== vp2) {\n      // Clear winner by VP total\n      const winnerId = vp1 > vp2 ? game.player1Id : game.player2Id;\n      const reason = vp1 >= 40 && vp2 >= 40 ? `40 VP (${vp1} vs ${vp2})` : '40 VP';\n      await deps.postGameOver(game\x2C client\x2C winnerId\x2C reason);\n      return { ended: true\x2C winnerId\x2C reason };\n    }\n    // VP tied \u2014 run tiebreakers\n    const { winnerId\x2C reason } = await resolveVpTiebreaker(game\x2C client\x2C vp1\x2C deps);\n    await deps.postGameOver(game\x2C client\x2C winnerId\x2C reason);\n    return { ended: true\x2C winnerId\x2C reason };\n  }\n  if (p1Figures === 0 && p2Figures === 0) {\n    await deps.postGameOver(game\x2C client\x2C null\x2C 'draw (both eliminated)');\n    return { ended: true\x2C winnerId: null\x2C reason: 'draw' };\n  }\n  if (p1Figures === 0 || p2Figures === 0) {\n    const winnerId = p1Figures === 0 ? game.player2Id : game.player1Id;\n    const reason = 'elimination';\n    await deps.postGameOver(game\x2C client\x2C winnerId\x2C reason);\n    return { ended: true\x2C winnerId\x2C reason };\n  }\n  return { ended: false };\n}\n\n/**\n * Resolve a VP tie when both players reach 40+ VP with the same total.\n * Tiebreaker order:\n *   1. Player with more kill VP wins\n *   2. Player with less total damage received wins\n *   3. Roll a blue die \u2014 higher accuracy wins (re-roll on tie)\n * @returns {Promise<{ winnerId: string\x2C reason: string }>}\n */\nexport async function resolveVpTiebreaker(game\x2C client\x2C tiedVp\x2C deps) {\n  const kills1 = game.player1VP?.kills ?? 0;\n  const kills2 = game.player2VP?.kills ?? 0;\n\n  // Tiebreaker 1: kill VP\n  if (kills1 !== kills2) {\n    const winnerId = kills1 > kills2 ? game.player1Id : game.player2Id;\n    const reason = `VP tiebreaker: kill VP (${kills1} vs ${kills2})\x2C tied at ${tiedVp} VP`;\n    await deps.logGameAction(game\x2C client\x2C `VP tied at **${tiedVp}**. Tiebreaker 1 \u2014 **Kill VP**: P1 ${kills1} vs P2 ${kills2}. **<@${winnerId}> wins!**`\x2C { phase: 'ROUND'\x2C icon: 'round'\x2C allowedMentions: { users: [winnerId] } });\n    return { winnerId\x2C reason };\n  }\n\n  // Tiebreaker 2: total damage received (lower wins)\n  const dmg1 = game.totalDamageReceived?.[1] ?? 0;\n  const dmg2 = game.totalDamageReceived?.[2] ?? 0;\n  if (dmg1 !== dmg2) {\n    const winnerId = dmg1 < dmg2 ? game.player1Id : game.player2Id;\n    const reason = `VP tiebreaker: damage received (${dmg1} vs ${dmg2})\x2C tied at ${tiedVp} VP`;\n    await deps.logGameAction(game\x2C client\x2C `VP tied at **${tiedVp}**. Kill VP tied (${kills1} each). Tiebreaker 2 \u2014 **Total damage received**: P1 ${dmg1} vs P2 ${dmg2} (lower wins). **<@${winnerId}> wins!**`\x2C { phase: 'ROUND'\x2C icon: 'round'\x2C allowedMentions: { users: [winnerId] } });\n    return { winnerId\x2C reason };\n  }\n\n  // Tiebreaker 3: roll blue die (higher accuracy wins\x2C re-roll on tie)\n  await deps.logGameAction(game\x2C client\x2C `VP tied at **${tiedVp}**. Kill VP tied (${kills1} each). Damage received tied (${dmg1} each). Tiebreaker 3 \u2014 **Blue die roll-off!**`\x2C { phase: 'ROUND'\x2C icon: 'round' });\n\n  const blueFaces = deps.getDiceData().attack?.blue;\n  if (!blueFaces?.length) {\n    // Fallback: should never happen\x2C but default to player 1 if dice data missing\n    return { winnerId: game.player1Id\x2C reason: `VP tiebreaker: blue die (dice data unavailable)\x2C tied at ${tiedVp} VP` };\n  }\n\n  let attempts = 0;\n  const maxAttempts = 20; // safety limit to prevent infinite loop\n  while (attempts < maxAttempts) {\n    attempts++;\n    const face1 = blueFaces[Math.floor(Math.random() * blueFaces.length)];\n    const face2 = blueFaces[Math.floor(Math.random() * blueFaces.length)];\n    const acc1 = face1.acc ?? 0;\n    const acc2 = face2.acc ?? 0;\n\n    if (acc1 !== acc2) {\n      const winnerId = acc1 > acc2 ? game.player1Id : game.player2Id;\n      const reason = `VP tiebreaker: blue die roll (${acc1} vs ${acc2} accuracy)\x2C tied at ${tiedVp} VP`;\n      await deps.logGameAction(game\x2C client\x2C `Blue die roll-off (attempt ${attempts}): P1 rolled **${acc1} accuracy**\x2C P2 rolled **${acc2} accuracy**. **<@${winnerId}> wins!**`\x2C { phase: 'ROUND'\x2C icon: 'round'\x2C allowedMentions: { users: [winnerId] } });\n      return { winnerId\x2C reason };\n    }\n    await deps.logGameAction(game\x2C client\x2C `Blue die roll-off (attempt ${attempts}): P1 rolled **${acc1} accuracy**\x2C P2 rolled **${acc2} accuracy** \u2014 tied\x2C re-rolling...`\x2C { phase: 'ROUND'\x2C icon: 'round' });\n  }\n\n  // Extremely unlikely: 20 ties in a row \u2014 pick randomly\n  const winnerId = Math.random() < 0.5 ? game.player1Id : game.player2Id;\n  const reason = `VP tiebreaker: blue die (random after ${maxAttempts} tied rolls)\x2C tied at ${tiedVp} VP`;\n  await deps.logGameAction(game\x2C client\x2C `Blue die roll-off: ${maxAttempts} consecutive ties! Random tiebreak: **<@${winnerId}> wins!**`\x2C { phase: 'ROUND'\x2C icon: 'round'\x2C allowedMentions: { users: [winnerId] } });\n  return { winnerId\x2C reason };\n}\n\n/**\n * Post game-over message\x2C record to DB\x2C check achievements\x2C save.\n * @param {object} game\n * @param {object} client - Discord client\n * @param {string|null} winnerId\n * @param {string} reason\n * @param {object} deps\n */\nexport async function postGameOver(game\x2C client\x2C winnerId\x2C reason\x2C deps) {\n  game.ended = true;\n  game.gameEndReason = reason ?? null;\n  deps.setPhase(game\x2C deps.PHASES.ENDED);\n  game.winnerId = winnerId ?? game.winnerId ?? null;\n  deps.cleanupGameLock(game.gameId);\n  deps.cleanupGameMaps(game.gameId);\n  cleanupAllSpacePicks(game);\n  if (deps.clearBuffer) deps.clearBuffer(game.gameId);\n  if (deps.clearEventLogSeqCounter) deps.clearEventLogSeqCounter(game.gameId);\n  if (deps.clearDomainSeqCounter) deps.clearDomainSeqCounter(game.gameId);\n  if (deps.clearGameErrorThread) await deps.clearGameErrorThread(game.gameId\x2C client);\n  if (deps.cleanupCompanionEmbedDeps) deps.cleanupCompanionEmbedDeps(game.gameId);\n  deps.pendingIllegalSquad.delete(`${game.gameId}_1`);\n  deps.pendingIllegalSquad.delete(`${game.gameId}_2`);\n  deps.pendingSquadConfirm.delete(`${game.gameId}_1`);\n  deps.pendingSquadConfirm.delete(`${game.gameId}_2`);\n  const embed = deps.buildScorecardEmbed(game\x2C deps.getMissionVpBonus(game));\n  const content = winnerId\n    ? `\\uD83C\\uDFC1 **GAME OVER** \u2014 <@${winnerId}> wins by ${reason}!`\n    : `\\uD83C\\uDFC1 **GAME OVER** \u2014 ${reason}`;\n  try {\n    const ch = await fetchGameChannel(client\x2C game.generalId);\n    await ch.send(sanitizeMentions({\n      content\x2C\n      embeds: [embed]\x2C\n      allowedMentions: winnerId ? { users: [winnerId] } : undefined\x2C\n    }));\n  } catch (err) {\n    console.error('Failed to post game over:'\x2C err);\n  }\n  if (deps.isDbConfigured()) {\n    deps.insertCompletedGame(game).catch((err) => console.error('[DB] insertCompletedGame:'\x2C err));\n    // Skip achievements for AI selfplay games \u2014 AI player IDs start with 'ai_player_'\n    const isAiGame = game.player1Id?.startsWith('ai_player_') || game.player2Id?.startsWith('ai_player_');\n    if (deps.achievementsChannelId && game.player1Id && game.player2Id && !isAiGame) {\n      (async () => {\n        try {\n          const [stats1\x2C stats2] = await Promise.all([\n            deps.getStatsSummaryForPlayer(game.player1Id)\x2C\n            deps.getStatsSummaryForPlayer(game.player2Id)\x2C\n          ]);\n          await Promise.all([\n            deps.checkAndPostAchievements(deps.checkAndGrantAchievements\x2C deps.postAchievementNotification\x2C client\x2C deps.achievementsChannelId\x2C game.player1Id\x2C 'game_complete'\x2C stats1.games)\x2C\n            deps.checkAndPostAchievements(deps.checkAndGrantAchievements\x2C deps.postAchievementNotification\x2C client\x2C deps.achievementsChannelId\x2C game.player2Id\x2C 'game_complete'\x2C stats2.games)\x2C\n          ]);\n          const wId = game.winnerId;\n          if (wId) {\n            const winnerStats = wId === game.player1Id ? stats1 : stats2;\n            await deps.checkAndPostAchievements(deps.checkAndGrantAchievements\x2C deps.postAchievementNotification\x2C client\x2C deps.achievementsChannelId\x2C wId\x2C 'game_win'\x2C winnerStats.wins);\n            // Shutout: opponent scored 0 VP\n            const loserId = wId === game.player1Id ? game.player2Id : game.player1Id;\n            const loserVP = wId === game.player1Id ? game.player2VP : game.player1VP;\n            if ((loserVP?.total ?? 0) === 0) {\n              await deps.checkAndPostAchievements(deps.checkAndGrantAchievements\x2C deps.postAchievementNotification\x2C client\x2C deps.achievementsChannelId\x2C wId\x2C 'shutout_win'\x2C 1);\n            }\n            // Survivor: winner lost no figures (all health entries have HP > 0)\n            const winnerDcList = wId === game.player1Id ? game.p1DcList : game.p2DcList;\n            const allSurvived = (winnerDcList || []).every((dc) => {\n              if (!dc?.healthState?.length) return true;\n              return dc.healthState.every((entry) => !entry || entry[0] > 0);\n            });\n            if (allSurvived && winnerDcList?.length > 0) {\n              await deps.checkAndPostAchievements(deps.checkAndGrantAchievements\x2C deps.postAchievementNotification\x2C client\x2C deps.achievementsChannelId\x2C wId\x2C 'no_losses_win'\x2C 1);\n            }\n            // Brutalist: win by eliminating all opponent figures\n            if (reason && reason.toLowerCase().includes('eliminat')) {\n              await deps.checkAndPostAchievements(deps.checkAndGrantAchievements\x2C deps.postAchievementNotification\x2C client\x2C deps.achievementsChannelId\x2C wId\x2C 'full_wipe_win'\x2C 1);\n            }\n          }\n        } catch (err) {\n          console.error('[Achievements] postGameOver hook failed:'\x2C err.message);\n        }\n      })();\n    }\n  }\n  deps.saveGames();\n}\n\n/**\n * Nefarious Gains (Jabba the Hutt): when ANY hostile figure is defeated\x2C\n * check if Jabba is alive on the opposing team and award 1 objective VP.\n * @param {object} game\n * @param {number} defeatedOwnerPN - playerNum who owned the defeated figure\n * @param {object} client - Discord client (for logging)\n * @param {object} deps\n */\nexport async function checkNefariousGains(game\x2C defeatedOwnerPN\x2C client\x2C deps) {\n  const result = deps._checkNefariousGainsVp(game\x2C defeatedOwnerPN);\n  if (!result) return;\n  await deps.logGameAction(game\x2C client\x2C `\\uD83D\\uDCB0 **Nefarious Gains** \u2014 **Jabba the Hutt** gains 1 VP (hostile defeated). P${result.jabbaOwnerPN} VP: ${result.vpTotal}`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n}\n\n/**\n * Hunt Dissent (Agent Kallus): when a hostile figure is defeated by Kallus\n * or a friendly TROOPER within 3 spaces of Kallus\x2C Kallus gains 1 Block Token.\n * @param {object} game\n * @param {number} attackerPlayerNum - playerNum who defeated the hostile figure\n * @param {string|null} attackerFigureKey - figureKey of the figure that did the defeating\n * @param {object} client - Discord client (for logging)\n * @param {object} deps\n */\nexport async function checkHuntDissent(game\x2C attackerPlayerNum\x2C attackerFigureKey\x2C client\x2C deps) {\n  if (!attackerFigureKey) return;\n  // Find all alive Kallus figures on the attacker's team\n  const kallusFigures = Object.keys(game.figurePositions?.[attackerPlayerNum] || {})\n    .filter(fk => fk.startsWith('Agent Kallus-'));\n  if (kallusFigures.length === 0) return;\n  // Verify Kallus has hunt_dissent_kallus ability\n  const kallusEff = deps.getDcEffects()?.['Agent Kallus'];\n  if (!(kallusEff?.specialAbilityIds || []).includes('hunt_dissent_kallus')) return;\n  const attackerDcName = deps.dcNameFromFigureKey(attackerFigureKey);\n  const isAttackerKallus = attackerDcName === 'Agent Kallus';\n  // Check if attacker is a TROOPER\n  let isAttackerTrooper = false;\n  if (!isAttackerKallus) {\n    const atkEff = deps.getDcEffects()?.[attackerDcName];\n    const atkKws = (atkEff?.keywords || []).map(k => String(k).toUpperCase());\n    isAttackerTrooper = atkKws.includes('TROOPER');\n  }\n  if (!isAttackerKallus && !isAttackerTrooper) return;\n  for (const kallusFk of kallusFigures) {\n    if (isAttackerKallus) {\n      // Kallus himself defeated the figure \u2014 grant Block Token\n      const granted = deps.grantPowerTokens(game\x2C kallusFk\x2C 'Block'\x2C 1);\n      if (granted > 0) {\n        await deps.logGameAction(game\x2C client\x2C `\\uD83D\\uDEE1\\uFE0F **Hunt Dissent** \u2014 **Agent Kallus** gains 1 **Block Token** (defeated hostile figure).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n      }\n    } else {\n      // Attacker is a TROOPER \u2014 check within 3 spaces of Kallus\n      const kallusPos = game.figurePositions?.[attackerPlayerNum]?.[kallusFk];\n      const atkPos = game.figurePositions?.[attackerPlayerNum]?.[attackerFigureKey];\n      if (kallusPos && atkPos) {\n        const dist = countGameSpaces(game\x2C kallusPos\x2C atkPos);\n        if (dist <= 3) {\n          const granted = deps.grantPowerTokens(game\x2C kallusFk\x2C 'Block'\x2C 1);\n          if (granted > 0) {\n            await deps.logGameAction(game\x2C client\x2C `\\uD83D\\uDEE1\\uFE0F **Hunt Dissent** \u2014 **Agent Kallus** gains 1 **Block Token** (friendly TROOPER **${attackerDcName}** defeated hostile within 3 spaces).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n          }\n        }\n      }\n    }\n  }\n}\n\n/**\n * This is the Way (The Armorer): When another friendly figure resolves an attack\x2C\n * if the defender was defeated\x2C that figure gains 1 Block Token.\n *\n * @param {object} game\n * @param {number} attackerPlayerNum - player who owns the attacker\n * @param {string|null} attackerFigureKey - figureKey of the figure that did the defeating\n * @param {object} client - Discord client (for logging)\n * @param {object} deps\n */\nexport async function checkThisIsTheWay(game\x2C attackerPlayerNum\x2C attackerFigureKey\x2C client\x2C deps) {\n  if (!attackerFigureKey) return;\n  // Find all alive Armorer figures on the attacker's team\n  const armorerFigures = Object.keys(game.figurePositions?.[attackerPlayerNum] || {})\n    .filter(fk => fk.startsWith('The Armorer-'));\n  if (armorerFigures.length === 0) return;\n  // Verify The Armorer has this_is_the_way_armorer ability\n  const armorerEff = deps.getDcEffects()?.['The Armorer'];\n  if (!(armorerEff?.specialAbilityIds || []).includes('this_is_the_way_armorer')) return;\n  // "another friendly figure" \u2014 The Armorer herself does NOT trigger this\n  const attackerDcName = deps.dcNameFromFigureKey(attackerFigureKey);\n  if (attackerDcName === 'The Armorer') return;\n  // Grant 1 Block Token to the attacker (not to The Armorer)\n  const granted = deps.grantPowerTokens(game\x2C attackerFigureKey\x2C 'Block'\x2C 1);\n  if (granted > 0) {\n    await deps.logGameAction(game\x2C client\x2C `\\uD83D\\uDEE1\\uFE0F **This is the Way** \u2014 **${attackerDcName}** gains 1 **Block Token** (defeated hostile figure while The Armorer is in play).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  }\n}\n\n/**\n * If a deployment group is fully defeated and hasn't activated yet\x2C\n * decrement the owner's remaining activations.\n * @param {object} game\n * @param {number} playerNum\n * @param {number} dcIdx\n * @param {object} client\n * @param {object} deps\n */\nexport async function decrementActivationIfGroupDefeated(game\x2C playerNum\x2C dcIdx\x2C client\x2C deps) {\n  if (dcIdx < 0 || !deps.isGroupDefeated(game\x2C playerNum\x2C dcIdx)) return;\n  deps.recomputeActivationCounts(game\x2C playerNum);\n  await deps.updateActivationsMessage(game\x2C playerNum\x2C client);\n}\n
