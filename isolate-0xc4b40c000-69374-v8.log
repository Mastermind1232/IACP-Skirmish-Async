adedByCJSLoader || translateContext.source == null);\n  const cjsLoader = shouldReloadByCJSLoader ? loadCJSModuleWithModuleLoad : loadCJSModule;\n\n  try {\n    // We still need to read the FS to detect the exports.\n    translateContext.source ??= readFileSync(new URL(url)\x2C 'utf8');\n  } catch {\n    // Continue regardless of error.\n  }\n  return createCJSModuleWrap(url\x2C translateContext\x2C parentURL\x2C cjsLoader);\n});\n\n/**\n * Get or create an entry in the CJS module cache for the given filename.\n * @param {string} filename CJS module filename\n * @param {CJSModule} parent The parent CJS module\n * @returns {CJSModule} the cached CJS module entry\n */\nfunction cjsEmplaceModuleCacheEntry(filename\x2C parent) {\n  // TODO: Do we want to keep hitting the user mutable CJS loader here?\n  let cjsMod = CJSModule._cache[filename];\n  if (cjsMod) {\n    return cjsMod;\n  }\n\n  cjsMod = new CJSModule(filename\x2C parent);\n  cjsMod.filename = filename;\n  cjsMod.paths = CJSModule._nodeModulePaths(cjsMod.path);\n  cjsMod[kIsCachedByESMLoader] = true;\n  CJSModule._cache[filename] = cjsMod;\n\n  return cjsMod;\n}\n\n/**\n * Pre-parses a CommonJS module's exports and re-exports.\n * @param {string} filename - The filename of the module.\n * @param {string} [source] - The source code of the module.\n * @param {string} [format]\n * @returns {{module: CJSModule\x2C exportNames: string[]}}\n */\nfunction cjsPreparseModuleExports(filename\x2C source\x2C format) {\n  const module = cjsEmplaceModuleCacheEntry(filename);\n  if (module[kModuleExportNames] !== undefined) {\n    return { module\x2C exportNames: module[kModuleExportNames] };\n  }\n\n  if (source === undefined) {\n    ({ source } = loadSourceForCJSWithHooks(module\x2C filename\x2C format));\n  }\n  module[kModuleSource] = source;\n\n  debug(`Preparsing exports of ${filename}`);\n  const { 0: exportNames\x2C 1: reexports } = cjsParse(source);\n\n  // Set first for cycles.\n  module[kModuleExportNames] = exportNames;\n\n  // If there are any re-exports e.g. `module.exports = { ...require(...) }`\x2C\n  // pre-parse the dependencies to find transitively exported names.\n  if (reexports.length) {\n    module.filename ??= filename;\n    module.paths ??= CJSModule._nodeModulePaths(dirname(filename));\n\n    for (let i = 0; i < reexports.length; i++) {\n      debug(`Preparsing re-exports of '${filename}'`);\n      const reexport = reexports[i];\n      let resolved;\n      let format;\n      try {\n        ({ format\x2C filename: resolved } = resolveForCJSWithHooks(reexport\x2C module\x2C false));\n      } catch (e) {\n        debug(`Failed to resolve '${reexport}'\x2C skipping`\x2C e);\n        continue;\n      }\n\n      if (format === 'commonjs' ||\n        (!BuiltinModule.normalizeRequirableId(resolved) && findLongestRegisteredExtension(resolved) === '.js')) {\n        const { exportNames: reexportNames } = cjsPreparseModuleExports(resolved\x2C undefined\x2C format);\n        for (const name of reexportNames) {\n          exportNames.add(name);\n        }\n      }\n    }\n  }\n\n  return { module\x2C exportNames };\n}\n\n// Strategy for loading a node builtin CommonJS module that isn't\n// through normal resolution\ntranslators.set('builtin'\x2C function builtinStrategy(url\x2C translateContext) {\n  debug(`Translating BuiltinModule ${url}`\x2C translateContext);\n  // Slice 'node:' scheme\n  const id = StringPrototypeSlice(url\x2C 5);\n  const module = loadBuiltinModule(id\x2C url);\n  cjsCache.set(url\x2C module);\n  if (!StringPrototypeStartsWith(url\x2C 'node:') || !module) {\n    throw new ERR_UNKNOWN_BUILTIN_MODULE(url);\n  }\n  debug(`Loading BuiltinModule ${url}`);\n  return module.getESMFacade();\n});\n\n// Strategy for loading a JSON file\ntranslators.set('json'\x2C function jsonStrategy(url\x2C translateContext) {\n  let { source } = translateContext;\n  assertBufferSource(source\x2C true\x2C 'load');\n  debug(`Loading JSONModule ${url}`);\n  const pathname = StringPrototypeStartsWith(url\x2C 'file:') ?\n    fileURLToPath(url) : null;\n  const shouldCheckAndPopulateCJSModuleCache =\n    // We want to involve the CJS loader cache only for `file:` URL with no search query and no hash.\n    pathname && !StringPrototypeIncludes(url\x2C '?') && !StringPrototypeIncludes(url\x2C '#');\n  let modulePath;\n  let module;\n  if (shouldCheckAndPopulateCJSModuleCache) {\n    modulePath = isWindows ?\n      StringPrototypeReplaceAll(pathname\x2C '/'\x2C '\\\\') : pathname;\n    module = CJSModule._cache[modulePath];\n    if (module?.loaded) {\n      const exports = module.exports;\n      return new ModuleWrap(url\x2C undefined\x2C ['default']\x2C function() {\n        this.setExport('default'\x2C exports);\n      });\n    }\n  }\n  source = stringify(source);\n  if (shouldCheckAndPopulateCJSModuleCache) {\n    // A require call could have been called on the same file during loading and\n    // that resolves synchronously. To make sure we always return the identical\n    // export\x2C we have to check again if the module already exists or not.\n    // TODO: remove CJS loader from here as well.\n    module = CJSModule._cache[modulePath];\n    if (module?.loaded) {\n      const exports = module.exports;\n      return new ModuleWrap(url\x2C undefined\x2C ['default']\x2C function() {\n        this.setExport('default'\x2C exports);\n      });\n    }\n  }\n  try {\n    const exports = JSONParse(stripBOM(source));\n    module = {\n      exports\x2C\n      loaded: true\x2C\n    };\n  } catch (err) {\n    // TODO (BridgeAR): We could add a NodeCore error that wraps the JSON\n    // parse error instead of just manipulating the original error message.\n    // That would allow to add further properties and maybe additional\n    // debugging information.\n    err.message = errPath(url) + ': ' + err.message;\n    throw err;\n  }\n  if (shouldCheckAndPopulateCJSModuleCache) {\n    CJSModule._cache[modulePath] = module;\n  }\n  cjsCache.set(url\x2C module);\n  return new ModuleWrap(url\x2C undefined\x2C ['default']\x2C function() {\n    debug(`Parsing JSONModule ${url}`);\n    this.setExport('default'\x2C module.exports);\n  });\n});\n\n// Strategy for loading a wasm module\n// This logic should collapse into WebAssembly Module Record in future.\n/**\n * @type {WeakMap<\n *   import('internal/modules/esm/utils').ModuleNamespaceObject\x2C\n *   WebAssembly.Instance\n * >} [[Instance]] slot proxy for WebAssembly Module Record\n */\nconst wasmInstances = new SafeWeakMap();\ntranslators.set('wasm'\x2C function(url\x2C translateContext) {\n  const { source } = translateContext;\n  // WebAssembly global is not available during snapshot building\x2C so we need to get it lazily.\n  const { WebAssembly } = globalThis;\n  assertBufferSource(source\x2C false\x2C 'load');\n\n  debug(`Translating WASMModule ${url}`\x2C translateContext);\n\n  let compiled;\n  try {\n    compiled = new WebAssembly.Module(source\x2C {\n      builtins: ['js-string']\x2C\n    });\n  } catch (err) {\n    err.message = errPath(url) + ': ' + err.message;\n    throw err;\n  }\n\n  const importsList = new SafeSet();\n  const wasmGlobalImports = [];\n  for (const impt of WebAssembly.Module.imports(compiled)) {\n    if (impt.kind === 'global') {\n      ArrayPrototypePush(wasmGlobalImports\x2C impt);\n    }\n    // Prefix reservations per https://webassembly.github.io/esm-integration/js-api/index.html#parse-a-webassembly-module.\n    if (impt.module.startsWith('wasm-js:')) {\n      throw new WebAssembly.LinkError(`Invalid Wasm import "${impt.module}" in ${url}`);\n    }\n    if (impt.name.startsWith('wasm:') || impt.name.startsWith('wasm-js:')) {\n      throw new WebAssembly.LinkError(`Invalid Wasm import name "${impt.module}" in ${url}`);\n    }\n    importsList.add(impt.module);\n  }\n\n  const exportsList = new SafeSet();\n  const wasmGlobalExports = new SafeSet();\n  for (const expt of WebAssembly.Module.exports(compiled)) {\n    if (expt.kind === 'g