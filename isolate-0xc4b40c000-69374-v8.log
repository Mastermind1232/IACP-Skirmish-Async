code-creation,Script,9,83859,0x7c987260b20,339, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game-state.js:1:1,0x78fd2b294c0,~
script-source,94,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game-state.js,/**\n * Game state ownership: games Map and DC-related Maps.\n * Handlers use getGame/setGame and persist via saveGames().\n */\nimport { readFileSync\x2C writeFileSync\x2C existsSync } from 'fs';\nimport { join\x2C dirname } from 'path';\nimport { fileURLToPath } from 'url';\nimport { isDbConfigured\x2C initDb\x2C loadGamesFromDb\x2C saveGamesToDb\x2C savePromise\x2C getActiveGameIdsFromEvents\x2C markGameDirty } from './db.js';\nimport { initSeqCounters\x2C replayToState } from './domain/event-store.js';\nimport { getDcList\x2C getDcMessageIds\x2C getActivatedDcIndices } from './game/player-helpers.js';\n\nconst __dirname = dirname(fileURLToPath(import.meta.url));\nconst rootDir = join(__dirname\x2C '..');\nconst GAMES_STATE_PATH = join(rootDir\x2C 'data'\x2C 'games-state.json');\n\n/** Current game state schema version (DB4). Bump when adding migrations. */\nexport const CURRENT_GAME_VERSION = 2;\n\n/** When true\x2C state blob AND domain events are persisted. When false\x2C only events. */\nexport const DUAL_WRITE_MODE = true;\n\n/**\n * Event-source read mode (env EVENT_SOURCE_READ).\n * - 'off' (default): load state from blob DB (current behavior)\n * - 'shadow': load from blob\x2C then replay events and log mismatches (safe validation)\n * - 'primary': load state from event replay\x2C blob as fallback only\n * - 'exclusive': load state from event replay only\x2C no blob fallback\n */\nconst EVENT_SOURCE_READ = process.env.EVENT_SOURCE_READ || 'off';\n\n/** gameId -> game object */\nconst games = new Map();\n\n/**\n * Set to true after loadGames() completes successfully.\n * saveGames() bails out early when false\x2C preventing a cold-start\n * empty-map save from wiping the DB.\n */\nlet gamesLoadedOk = false;\n\n/** Strip faction suffixes like (Mercenary)\x2C (Imperial)\x2C (Rebel) from CC card names. */\nfunction sanitizeCcNames(arr) {\n  if (!Array.isArray(arr)) return;\n  for (let i = 0; i < arr.length; i++) {\n    if (typeof arr[i] === 'string') {\n      arr[i] = arr[i].replace(/\\s+\\((?:Mercenary|Imperial|Rebel)\\)$/i\x2C '').trim();\n    }\n  }\n}\n\n/** Compute phase from legacy flags for v1\u2192v2 migration. */\nfunction computePhaseFromFlags(g) {\n  if (g.phase) return; // already set \u2014 idempotent\n  if (g.ended) {\n    g.phase = 'ended';\n    g.roundPhase = null;\n    return;\n  }\n  if (g.currentRound && g.player1CcDrawn && g.player2CcDrawn) {\n    g.phase = 'round_active';\n    if (g.endOfRoundWhoseTurn) {\n      g.roundPhase = 'end_of_round';\n    } else if ((g.pendingStartOfRoundResolve || 0) > 0) {\n      g.roundPhase = 'start_of_round';\n    } else {\n      g.roundPhase = 'activation';\n    }\n    return;\n  }\n  if (g.initiativePlayerDeployed && g.nonInitiativePlayerDeployed) {\n    if (g.setupAttachmentPhase) {\n      g.phase = 'attachment';\n    } else {\n      g.phase = 'cc_draw';\n    }\n    g.roundPhase = null;\n    return;\n  }\n  if (g.deploymentZoneChosen) {\n    g.phase = 'deployment';\n    g.roundPhase = null;\n    return;\n  }\n  if (g.initiativeDetermined) {\n    g.phase = 'zone_selection';\n    g.roundPhase = null;\n    return;\n  }\n  if (g.mapSelected) {\n    g.phase = 'initiative';\n    g.roundPhase = null;\n    return;\n  }\n  if (g.generalId) {\n    g.phase = 'map_selection';\n    g.roundPhase = null;\n    return;\n  }\n  g.phase = 'lobby';\n  g.roundPhase = null;\n}\n\n/** Run migrations on a loaded game so old saves keep working (DB4). */\nfunction migrateGame(g) {\n  if (!g || typeof g !== 'object') return;\n  const v = g.version ?? 0;\n  if (v < 1) {\n    g.version = 1;\n  }\n  if (v < 2) {\n    computePhaseFromFlags(g);\n    g.version = 2;\n  }\n  if (g.version < CURRENT_GAME_VERSION) {\n    g.version = CURRENT_GAME_VERSION;\n  }\n\n  // Strip faction suffixes from stored CC names (e.g. "Opportunistic (Mercenary)" \u2192 "Opportunistic")\n  sanitizeCcNames(g.player1CcHand);\n  sanitizeCcNames(g.player1CcDeck);\n  sanitizeCcNames(g.player1CcDiscard);\n  sanitizeCcNames(g.player2CcHand);\n  sanitizeCcNames(g.player2CcDeck);\n  sanitizeCcNames(g.player2CcDiscard);\n  if (g.player1Squad?.ccList) sanitizeCcNames(g.player1Squad.ccList);\n  if (g.player2Squad?.ccList) sanitizeCcNames(g.player2Squad.ccList);\n\n  // Migrate 'Hit' power tokens to 'Damage' (renamed for IACP correctness)\n  if (g.figurePowerTokens) {\n    for (const fk of Object.keys(g.figurePowerTokens)) {\n      const arr = g.figurePowerTokens[fk];\n      if (Array.isArray(arr)) {\n        for (let i = 0; i < arr.length; i++) { if (arr[i] === 'Hit') arr[i] = 'Damage'; }\n      }\n    }\n  }\n\n  ensureGameShape(g);\n}\n\n/**\n * Ensure commonly-used game state container properties exist with correct defaults.\n * Only initializes properties that are always-present containers (never used as\n * state flags via truthiness checks). Pending/active/inProgress properties are\n * excluded since code checks `if (game.X)` to detect whether that state is active.\n */\nfunction ensureGameShape(game) {\n  // Properties that should always be {} (keyed containers)\n  const OBJ = [\n    // Figure state (always keyed by playerNum or figureKey)\n    'figurePositions'\x2C 'figureConditions'\x2C 'figureStrain'\x2C 'figureConfig'\x2C\n    'figureOrientations'\x2C 'figureNicknames'\x2C 'figurePowerTokens'\x2C 'figureContraband'\x2C\n    // Movement containers (keyed by msgId)\n    'movementBank'\x2C 'moveGridMessageIds'\x2C\n    // DC state (keyed by msgId)\n    'dcActionsData'\x2C 'dcActivationLogMessageIds'\x2C 'dcFinishedPinged'\x2C\n    'deploySpaceGridMessageIds'\x2C 'lastActivationMsgIdByPlayer'\x2C\n    // Setup (keyed by playerNum)\n    'setupAttachmentPending'\x2C 'setupAttachmentApplied'\x2C 'setupAttachmentConfirmed'\x2C\n    // CC/DC attachments (keyed by msgId)\n    'p1CcAttachments'\x2C 'p2CcAttachments'\x2C 'p1DcAttachments'\x2C 'p2DcAttachments'\x2C\n    // Activation tracking (keyed by msgId or figureKey\x2C reset each activation)\n    'activationStartPositions'\x2C 'activationDamagedFigures'\x2C 'activationKills'\x2C\n    'activationDoubleSpecialAction'\x2C 'activationExtraActionThenStun'\x2C\n    'attackPerformedThisActivation'\x2C\n    // Round-scoped containers (keyed by msgId/figureKey\x2C reset each round)\n    'roundFigureAbilityUsed'\x2C 'roundAttackRerollDice'\x2C 'roundAttackSurgeBonus'\x2C\n    'roundDefenseBonusBlock'\x2C 'roundDefenseBonusEvade'\x2C 'roundDefenseAccuracyPenalty'\x2C 'roundDefenderBonusBlockPerEvade'\x2C\n    'roundEfficientTravel'\x2C 'roundProgrammingOverrideTrait'\x2C\n    'roundTrooperAttackHitBonus'\x2C 'roundVehicleSpeedBonus'\x2C 'roundTrooperSurgeStun'\x2C\n    // Combat targeting (keyed by msgId)\n    'attackTargets'\x2C 'falseOrdersAttackTargets'\x2C 'falseOrdersUpgrade'\x2C\n    'nextAttackBonusSurgeAbilities'\x2C 'nextAttackBonusAccuracy'\x2C 'nextAttackBonusPierce'\x2C\n    'nextAttackReach'\x2C 'nextAttacksBonusConditions'\x2C 'nextAttacksBonusHits'\x2C\n    'nextAttackIgnoreFigureLOS'\x2C 'nextActivationFreeAttack'\x2C 'nextHostileDefeatVpBonus'\x2C\n    // Post-combat / end-of-round containers\n    'postActivationConditions'\x2C 'endOfRoundSelfDamage'\x2C\n    // Map tokens (keyed by coord or id)\n    'cratePositions'\x2C 'crateHealth'\x2C 'crateTokens'\x2C 'deviceTokens'\x2C\n    'ancillaryTokens'\x2C 'orbitalBombardmentTokens'\x2C\n    // Misc keyed containers\n    'exhaustedSkirmishUpgrades'\x2C 'defenderThreadData'\x2C 'priceBounties'\x2C\n    'paybackBonusSurge'\x2C 'optimalBombardmentBlastBonus'\x2C\n    'lastResortTriggered'\x2C 'partingShotTriggered'\x2C 'selfDestructProtocolTriggered'\x2C\n    'recoverOnHostileDefeat'\x2C 'etiquetteBlockPairs'\x2C\n  ];\n  for (const k of OBJ) {\n    if (game[k] == null) game[k] = {};\n  }\n\n  // Tiebreaker tracking: total damage received per player\n  if (!game.totalDamageReceived || typeof game.totalDamageReceived !== 'object') {\n    game.totalDamageReceived = { 1: 0\x2C 2: 0 };\n  }\n\n  // Properties that should always be [] (arrays)\n  const ARR = [\n    'undoStack'\x2C 'openedDoors'\x2C 'rubbleTokens'\x2C\n    'crippledFigures'\x2C 'disabledFigures'\x2C\n    'p1ActivatedDcIndices'\x2C 'p2ActivatedDcIndices'\x2C\n    'p1DepletedDcMessageIds'\x2C 'p2DepletedDcMessageIds'\x2C\n    'initiativeDeployMessageIds'\x2C 'nonInitiativeDeployMessageIds'\x2C\n    'nonInitiativeDeployedConfirmIds'\x2C 'attachRedoNoticeIds'\x2C\n    'setupLogMessageIds'\x2C\n  ];\n  for (const k of ARR) {\n    if (!Array.isArray(game[k])) game[k] = [];\n  }\n}\n\n/** messageId -> { gameId\x2C playerNum\x2C dcName\x2C displayName } */\nconst dcMessageMeta = new Map();\n/** messageId -> boolean (exhausted) */\nconst dcExhaustedState = new Map();\n/** messageId -> healthState array */\nconst dcHealthState = new Map();\n/** key = `${gameId}_${playerNum}`\x2C value = { squad\x2C timestamp } */\nconst pendingIllegalSquad = new Map();\n/** key = `${gameId}_${playerNum}`\x2C value = { squad\x2C validation\x2C timestamp } */\nconst pendingSquadConfirm = new Map();\n\n/** Get a game by id. */\nexport function getGame(gameId) {\n  return games.get(gameId);\n}\n\n/** Set (or replace) a game by id. Does not persist; call saveGames() after. */\nexport function setGame(gameId\x2C game) {\n  games.set(gameId\x2C game);\n}\n\n/** Remove a game by id (e.g. when killed). Does not persist; call saveGames() after. */\nexport function deleteGame(gameId) {\n  games.delete(gameId);\n}\n\n/** Set game and persist in one call. Convenience wrapper to DRY up setGame+saveGames. */\nexport function persistGame(gameId\x2C game) {\n  games.set(gameId\x2C game);\n  saveGames(gameId);\n}\n\n/** Sync live dcHealthState Map back into game objects so persisted health is always current. */\nfunction syncHealthStateToGames() {\n  for (const [msgId\x2C healthState] of dcHealthState) {\n    const meta = dcMessageMeta.get(msgId);\n    if (!meta) continue;\n    const game = games.get(meta.gameId);\n    if (!game || game.ended) continue;\n    const dcMessageIds = getDcMessageIds(game\x2C meta.playerNum) || [];\n    const dcList = getDcList(game\x2C meta.playerNum) || [];\n    const idx = dcMessageIds.indexOf(msgId);\n    if (idx >= 0 && dcList[idx] && Array.isArray(healthState)) {\n      dcList[idx].healthState = [...healthState];\n    }\n  }\n}\n\n/** Persist games to DB or file. Pass gameId to save only that game; omit to save all. */\nexport async function saveGames(gameId) {\n  if (!gamesLoadedOk) {\n    console.warn('[Games] saveGames() called before load completed \u2014 skipping to protect DB.');\n    return;\n  }\n  // In exclusive event-source mode\x2C skip blob writes entirely\n  if (EVENT_SOURCE_READ === 'exclusive') {\n    return;\n  }\n  syncHealthStateToGames();\n  if (isDbConfigured()) {\n    if (gameId) {\n      markGameDirty(gameId);\n    } else {\n      // No specific game \u2014 mark all as dirty (backward compat)\n      for (const id of games.keys()) markGameDirty(id);\n    }\n    try {\n      await saveGamesToDb(games);\n    } catch (err) {\n      console.error('[Games] saveGamesToDb promise rejected:'\x2C err);\n    }\n    return;\n  }\n  try {\n    const data = Object.fromEntries(games);\n    writeFileSync(GAMES_STATE_PATH\x2C JSON.stringify(data\x2C null\x2C 2)\x2C 'utf8');\n  } catch (err) {\n    console.error('Failed to save games state:'\x2C err);\n  }\n}\n\n/** Load all games from DB or file; repopulate DC Maps from loaded games. Call at startup. */\nexport async function loadGames() {\n  if (isDbConfigured()) {\n    try {\n      await initDb();\n\n      if (EVENT_SOURCE_READ === 'exclusive') {\n        // Load entirely from event replay \u2014 no blob\n        await _loadFromEventReplay();\n      } else if (EVENT_SOURCE_READ === 'primary') {\n        // Try event replay first\x2C fall back to blob\n        const replayOk = await _loadFromEventReplay();\n        if (!replayOk) {\n          console.warn('[Games] Event replay failed\x2C falling back to blob.');\n          await _loadFromBlob();\n        }\n      } else {\n        // 'off' or 'shadow': load from blob (default)\n        await _loadFromBlob();\n\n        if (EVENT_SOURCE_READ === 'shadow') {\n          // Shadow mode: replay events and compare with blob\x2C log mismatches\n          await _shadowValidateAll();\n        }\n      }\n\n      gamesLoadedOk = true;\n      console.log(`[Games] Loaded ${games.size} game(s) from PostgreSQL (mode: ${EVENT_SOURCE_READ}).`);\n\n      // Initialize domain event seq counters from DB\n      try {\n        await initSeqCounters([...games.keys()]);\n      } catch (seqErr) {\n        console.warn('[Games] Seq counter init failed (non-fatal):'\x2C seqErr.message);\n      }\n    } catch (err) {\n      console.error('Failed to load games from DB:'\x2C err);\n    }\n    repopulateDcMapsFromGames();\n    return;\n  }\n  try {\n    if (!existsSync(GAMES_STATE_PATH)) {\n      gamesLoadedOk = true;\n      return;\n    }\n    const raw = readFileSync(GAMES_STATE_PATH\x2C 'utf8');\n    const data = JSON.parse(raw);\n    if (data && typeof data === 'object') {\n      for (const [id\x2C g] of Object.entries(data)) {\n        if (g && typeof g === 'object') {\n          delete g.pendingAttack;\n          migrateGame(g);\n        }\n        games.set(id\x2C g);\n      }\n    }\n    gamesLoadedOk = true;\n    repopulateDcMapsFromGames();\n  } catch (err) {\n    console.error('Failed to load games state:'\x2C err);\n  }\n}\n\n/** Load games from the state blob in DB. */\nasync function _loadFromBlob() {\n  const data = await loadGamesFromDb();\n  for (const [id\x2C g] of Object.entries(data)) {\n    if (g && typeof g === 'object') {\n      delete g.pendingAttack;\n      migrateGame(g);\n    }\n    games.set(id\x2C g);\n  }\n}\n\n/** Load games by replaying domain events. Returns true on success. */\nasync function _loadFromEventReplay() {\n  try {\n    const gameIds = await getActiveGameIdsFromEvents();\n    if (gameIds.length === 0) {\n      console.warn('[Games] No games found in domain_events table.');\n      return false;\n    }\n    let loaded = 0;\n    let failed = 0;\n    for (const gameId of gameIds) {\n      try {\n        const state = await replayToState(gameId);\n        if (state && Object.keys(state).length > 0) {\n          games.set(gameId\x2C state);\n          loaded++;\n        }\n      } catch (e) {\n        console.error(`[Games] Event replay failed for ${gameId}:`\x2C e.message);\n        failed++;\n      }\n    }\n    console.log(`[Games] Event replay: ${loaded} loaded\x2C ${failed} failed out of ${gameIds.length} games.`);\n    return failed === 0;\n  } catch (e) {\n    console.error('[Games] Event replay failed:'\x2C e.message);\n    return false;\n  }\n}\n\n/** Shadow validation: replay events for each loaded game\x2C log mismatches. */\nasync function _shadowValidateAll() {\n  try {\n    const { shadowCompare } = await import('./domain/event-verifier.js');\n    let checked = 0;\n    let mismatched = 0;\n    for (const [gameId\x2C blobState] of games) {\n      try {\n        const result = await shadowCompare(gameId\x2C blobState);\n        checked++;\n        if (!result.match) {\n          mismatched++;\n          console.warn(`[shadow] Game ${gameId}: ${result.mismatches.join('\x2C ')} (${result.eventCount} events)`);\n        }\n      } catch (e) {\n        console.warn(`[shadow] Game ${gameId} check failed:`\x2C e.message);\n      }\n    }\n    console.log(`[shadow] Startup validation: ${checked} checked\x2C ${mismatched} mismatches.`);\n  } catch (e) {\n    console.warn('[shadow] Validation failed:'\x2C e.message);\n  }\n}\n\n/** Repopulate dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState from loaded games (after loadGames). */\nfunction repopulateDcMapsFromGames() {\n  for (const [gameId\x2C game] of games) {\n    for (const playerNum of [1\x2C 2]) {\n      const dcList = getDcList(game\x2C playerNum) || [];\n      const dcMessageIds = getDcMessageIds(game\x2C playerNum) || [];\n      const activatedIndices = new Set(getActivatedDcIndices(game\x2C playerNum) || []);\n      for (let i = 0; i < dcMessageIds.length && i < dcList.length; i++) {\n        const msgId = dcMessageIds[i];\n        const dc = dcList[i];\n        if (!msgId || !dc) continue;\n        dcMessageMeta.set(msgId\x2C {\n          gameId\x2C\n          playerNum\x2C\n          dcName: dc.dcName\x2C\n          displayName: dc.displayName || dc.dcName\x2C\n        });\n        const abilityExhausted = (game.abilityExhaustedMsgIds || []).includes(msgId);\n        dcExhaustedState.set(msgId\x2C activatedIndices.has(i) || abilityExhausted);\n        dcHealthState.set(msgId\x2C dc.healthState || [[null\x2C null]]);\n      }\n    }\n  }\n}\n\n/** For db.js deleteGameFromDb and any code that needs to iterate or pass the Map. */\nexport function getGamesMap() {\n  return games;\n}\n\n/**\n * Rebuild dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState for a single game.\n * Call after restoring a game snapshot to keep side-channel Maps consistent.\n */\nexport function repopulateDcMapsForGame(gameId) {\n  // Clear existing entries for this game\n  for (const [msgId\x2C meta] of dcMessageMeta) {\n    if (meta?.gameId === gameId) {\n      dcMessageMeta.delete(msgId);\n      dcExhaustedState.delete(msgId);\n      dcHealthState.delete(msgId);\n    }\n  }\n  // Rebuild from current game state\n  const game = games.get(gameId);\n  if (!game) return;\n  for (const playerNum of [1\x2C 2]) {\n    const dcList = getDcList(game\x2C playerNum) || [];\n    const dcMessageIds = getDcMessageIds(game\x2C playerNum) || [];\n    const activatedIndices = new Set(getActivatedDcIndices(game\x2C playerNum) || []);\n    for (let i = 0; i < dcMessageIds.length && i < dcList.length; i++) {\n      const msgId = dcMessageIds[i];\n      const dc = dcList[i];\n      if (!msgId || !dc) continue;\n      dcMessageMeta.set(msgId\x2C {\n        gameId\x2C\n        playerNum\x2C\n        dcName: dc.dcName\x2C\n        displayName: dc.displayName || dc.dcName\x2C\n      });\n      const abilityExhausted = (game.abilityExhaustedMsgIds || []).includes(msgId);\n      dcExhaustedState.set(msgId\x2C activatedIndices.has(i) || abilityExhausted);\n      dcHealthState.set(msgId\x2C dc.healthState || [[null\x2C null]]);\n    }\n  }\n}\n\n/** Remove all dcMessageMeta/dcExhaustedState/dcHealthState entries for a game. Prevents memory leaks on game end. */\nexport function cleanupGameMaps(gameId) {\n  for (const [msgId\x2C meta] of dcMessageMeta) {\n    if (meta?.gameId === gameId) {\n      dcMessageMeta.delete(msgId);\n      dcExhaustedState.delete(msgId);\n      dcHealthState.delete(msgId);\n    }\n  }\n}\n\nexport {\n  dcMessageMeta\x2C\n  dcExhaustedState\x2C\n  dcHealthState\x2C\n  pendingIllegalSquad\x2C\n  pendingSquadConfirm\x2C\n};\n\n/** Graceful shutdown: flush pending DB writes before the process exits. */\nasync function gracefulShutdown(signal) {\n  console.log(`[Games] ${signal} received \u2014 flushing pending saves...`);\n  try {\n    syncHealthStateToGames();\n    if (isDbConfigured() && gamesLoadedOk) {\n      await saveGamesToDb(games);\n      await savePromise;\n    }\n    console.log('[Games] Save complete. Exiting.');\n  } catch (err) {\n    console.error('[Games] Shutdown save failed:'\x2C err);\n  }\n  process.exit(0);\n}\nprocess.on('SIGTERM'\x2C () => gracefulShutdown('SIGTERM'));\nprocess.on('SIGINT'\x2C () => gracefulShutdown('SIGINT'));\n
