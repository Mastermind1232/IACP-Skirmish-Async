oken: +1 Evade.');\n      }\n    }\n    await advanceTokenPhase(thread\x2C game\x2C combat\x2C expectedPhase\x2C ctx);\n    saveGames();\n    return;\n  }\n\n  // Spend token\n  const tokenIndex = parseInt(choice\x2C 10);\n  const figureKey = isAttacker ? combat.attackerFigureKey : combat.target.figureKey;\n  const tokens = game.figurePowerTokens?.[figureKey] || [];\n  const tokenType = tokens[tokenIndex];\n  if (!tokenType) return;\n\n  // Wild: prompt for type selection first\n  if (tokenType === 'Wild') {\n    combat.pendingWildRole = expectedPhase;\n    combat.pendingWildTokenIndex = tokenIndex;\n    await sendWildTypeWindow(thread\x2C game.gameId\x2C expectedPhase);\n    saveGames();\n    return;\n  }\n\n  applyTokenBonus(combat\x2C tokenType\x2C isAttacker);\n  const _tokenBonusAmt = (isAttacker ? combat.attackerUnhingedBonus : combat.defenderUnhingedBonus) ? 2 : 1;\n  removeSpentToken(game\x2C figureKey\x2C tokenIndex);\n  await thread.send(`**Power Token spent:** +${_tokenBonusAmt} ${tokenType}${_tokenBonusAmt > 1 ? ' (Unhinged Director)' : ''}`);\n  logGameAction?.(game\x2C interaction.client\x2C `\ud83c\udfaf **Power Token spent** \u2014 ${isAttacker ? 'Attacker' : 'Defender'}: +1 ${tokenType}`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  // Track attacker Power Token spending for Pulse Cannon (Iden Versio)\n  if (isAttacker) combat.attackerSpentPowerToken = true;\n  // Track defender modifications for Quick Strike (Electrostaff loadout)\n  if (!isAttacker) combat.defenderRerolledOrModified = true;\n  // Track Block token spending for Mandalorian Steel\n  if (!isAttacker && tokenType === 'Block') combat.defenderSpentBlock = true;\n  // Personal Combat Shield (Gar Saxon): when spending a Block token while defending\x2C +1 Evade\n  if (!isAttacker && tokenType === 'Block') {\n    const _pcsDcEff = ctx.getDcEffects ? ctx.getDcEffects() : {};\n    const _pcsDefDcName = dcNameFromFigureKey(combat.target?.figureKey || '');\n    const _pcsDefEff = _pcsDcEff[_pcsDefDcName] || _pcsDcEff[(_pcsDefDcName || '').replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n    if ((_pcsDefEff?.specialAbilityIds || []).includes('personal_combat_shield_gar_saxon')) {\n      combat.bonusEvade = (combat.bonusEvade || 0) + 1;\n      await thread.send('**Personal Combat Shield** \u2014 Gar Saxon spent a Block token: +1 Evade.');\n    }\n  }\n  await advanceTokenPhase(thread\x2C game\x2C combat\x2C expectedPhase\x2C ctx);\n  saveGames();\n}\n\n/**\n * F6 Cleave: Apply cleave damage to chosen target in melee; finish combat resolution.\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C replyIfGameEnded\x2C dcHealthState\x2C findDcMessageIdForFigure\x2C getDcStats\x2C getDcEffects\x2C logGameAction\x2C isGroupDefeated\x2C checkWinConditions\x2C finishCombatResolution\x2C updateActivationsMessage\x2C saveGames\x2C client\n */\nexport async function handleCleaveTarget(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    replyIfGameEnded\x2C\n    dcHealthState\x2C\n    findDcMessageIdForFigure\x2C\n    getDcStats\x2C\n    getDcEffects\x2C\n    logGameAction\x2C\n    isGroupDefeated\x2C\n    checkWinConditions\x2C\n    finishCombatResolution\x2C\n    updateActivationsMessage\x2C\n    updateAttachmentMessageForDc\x2C\n    saveGames\x2C\n    client\x2C\n    calculateKillVp\x2C\n    checkHuntDissent\x2C\n    checkThisIsTheWay\x2C\n    decrementActivationIfGroupDefeated\x2C\n    checkFriendlyDefeatedPassiveRedraws: ctxCheckFriendlyRedraws\x2C\n    checkNefariousGains: ctxCheckNefariousGains\x2C\n    ccAttachmentsKey: ctxCcAttachmentsKey\x2C\n  } = ctx;\n  const match = interaction.customId.match(/^cleave_target_([^_]+)_(\\d+)$/);\n  if (!match) return;\n  const [\x2C gameId\x2C indexStr] = match;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (await replyIfGameEnded(game\x2C interaction)) return;\n  const pending = game.pendingCleave;\n  if (!pending || pending.gameId !== gameId) {\n    await interaction.followUp({ content: 'No cleave target selection in progress.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (interaction.user.id !== pending.ownerId) {\n    await interaction.followUp({ content: 'Only the attacker may choose the cleave target.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const targetIndex = parseInt(indexStr\x2C 10);\n  const target = pending.targets[targetIndex];\n  if (!target) {\n    await interaction.followUp({ content: 'Invalid target.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { figureKey: cleaveFigureKey\x2C playerNum: cleavePlayerNum } = target;\n  const attackerPlayerNum = pending.attackerPlayerNum;\n  const ownerId = pending.ownerId;\n  const cleaveMsgId = findDcMessageIdForFigure(game.gameId\x2C cleavePlayerNum\x2C cleaveFigureKey);\n  if (cleaveMsgId) {\n    const cleaveM = cleaveFigureKey.match(/-(\\d+)-(\\d+)$/);\n    const cleaveFigIndex = cleaveM ? parseInt(cleaveM[2]\x2C 10) : 0;\n    const cleaveDmg = pending.surgeCleave || 0;\n    const { newHp: newCCur\x2C wasDefeated: cleaveDefeated } = reduceHp(dcHealthState\x2C game\x2C cleaveMsgId\x2C cleaveFigIndex\x2C cleaveDmg\x2C cleavePlayerNum);\n    // Fury of Kashyyyk (army-wide): when a friendly WOOKIEE suffers 3+ damage\x2C become Focused\n    if (cleaveDmg >= 3 && newCCur > 0) {\n      const _fokCleaveDcList = getDcList(game\x2C cleavePlayerNum) || [];\n      if (_fokCleaveDcList.some(dc => dc.dcName === '[Fury of Kashyyyk]')) {\n        const _fokCleaveName = dcNameFromFigureKey(cleaveFigureKey);\n        const _fokCleaveKws = (getDcKeywordsGlobal(game)[_fokCleaveName] || []).map(k => String(k).toUpperCase());\n        if (_fokCleaveKws.includes('WOOKIEE')) {\n          if (applyCondition(game\x2C cleaveFigureKey\x2C 'Focus')) {\n            await logGameAction(game\x2C client\x2C `**Fury of Kashyyyk** \u2014 **${_fokCleaveName}** became **Focused** (suffered ${cleaveDmg} Cleave Damage).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n          }\n        }\n      }\n    }\n    {\n      const cleaveDcIds = getDcMessageIds(game\x2C cleavePlayerNum);\n      const cleaveDcList = getDcList(game\x2C cleavePlayerNum);\n      const cleaveIdx = (cleaveDcIds || []).indexOf(cleaveMsgId);\n      const cleaveLabel = target.label || cleaveDcList?.[cleaveIdx]?.displayName || cleaveFigureKey;\n      await logGameAction(game\x2C client\x2C `Cleave: <@${ownerId}> dealt **${pending.surgeCleave}** damage to **${cleaveLabel}**`\x2C { allowedMentions: { users: [ownerId] }\x2C phase: 'ROUND'\x2C icon: 'attack' });\n      if (newCCur <= 0) {\n        const cleaveDcName = cleaveDcList[cleaveIdx]?.dcName;\n        await processFigureDefeat(game\x2C {\n          defeatedPlayerNum: cleavePlayerNum\x2C\n          figureKey: cleaveFigureKey\x2C\n          attackerPlayerNum\x2C\n          attackerFigureKey: pending.combat?.attackerFigureKey || null\x2C\n          msgId: cleaveMsgId\x2C\n          dcIdx: cleaveIdx\x2C\n          dcName: cleaveDcName\x2C\n          displayName: cleaveLabel\x2C\n          source: 'Cleave'\x2C\n        }\x2C {\n          removeFigurePosition\x2C\n          calculateKillVp: calculateKillVp || ((name) => {\n            const s = getDcStats(name); const e = getDcEffects()?.[name];\n            return (s?.figures > 1 && e?.subCost != null) ? e.subCost : (s?.cost ?? 5);\n          })\x2C\n          awardKillVp\x2C\n          dcNameFromFigureKey\x2C\n          logGameAction\x2C\n          client\x2C\n          decrementActivationIfGroupDefeated\x2C\n          ccAttachmentsKey: ctxCcAttachmentsKey || ccAttachmentsKey\x2C\n          updateAttachmentMessageForDc\x2C\n          checkFriendlyDefeatedPassiveRedraws: ctxCheckFriendlyRedraws || checkFriendlyDefeatedPassiveRedraws\x2C\n          checkNefariousGains: ctxCheckNefariousGains || checkNefariousGains\x2C\n          checkHuntDissent\x2C\n          checkThisIsTheWay\x2C\n          checkWinConditions\x2C\n        });\n      }\n    }\n  }\n  try {\n    await interaction.message.edit({ components: [] }).catch(discordCatch);\n  } catch {}\n  const embedRefreshMsgIds = new Set(pending.initialEmbedRefreshMsgIds || []);\n  if (cleaveMsgId) embedRefreshMsgIds.add(cleaveMsgId);\n  delete game.pendingCleave;\n  const { checkPostCombatSurges } = ctx;\n  if (checkPostCombatSurges) {\n    const defPN = opponentPlayerNum(pending.attackerPlayerNum);\n    const cThread = await fetchCombatThread(client\x2C pending.combat.combatThreadId);\n    if (cThread) {\n      const triggered = await checkPostCombatSurges(game\x2C pending.combat\x2C pending.resultText\x2C embedRefreshMsgIds\x2C cThread\x2C pending.ownerId\x2C defPN);\n      if (triggered) { saveGames(); return; }\n    }\n  }\n  await finishCombatResolution(game\x2C pending.combat\x2C pending.resultText\x2C embedRefreshMsgIds\x2C client);\n  saveGames();\n}\n\n/**\n * Handle power token type-choice buttons (power_token_choice_).\n * Fired after any ability grants a generic "power token"; player picks Hit/Surge/Block/Evade.\n */\nexport async function handlePowerTokenChoice(interaction\x2C ctx) {\n  await interaction.deferUpdate().catch(discordCatch);\n  const { getGame\x2C saveGames } = ctx;\n  const match = interaction.customId.match(/^power_token_choice_([^_]+)_(damage|hit|surge|block|evade)$/);\n  if (!match) { await interaction.followUp({ content: 'Invalid token choice.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  const [\x2C gameId\x2C typeRaw] = match;\n  const type = typeRaw === 'damage' ? 'Damage' : typeRaw === 'hit' ? 'Damage' : typeRaw[0].toUpperCase() + typeRaw.slice(1); // 'Damage'\x2C 'Surge'\x2C 'Block'\x2C 'Evade'\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  if (!game.pendingPowerTokenGrant?.grants?.length) { await interaction.followUp({ content: 'No pending token grant found.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  const { grants\x2C channelId\x2C playerNum } = game.pendingPowerTokenGrant;\n  if (playerNum && !await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Not your token choice.')) return;\n  game.figurePowerTokens = game.figurePowerTokens || {};\n  const lines = [];\n  for (const { figureKey\x2C figName\x2C count } of grants) {\n    grantPowerTokens(game\x2C figureKey\x2C type\x2C count);\n    lines.push(`${figName}: ${count > 1 ? `${count}\xd7 ` : ''}**${type}**`);\n  }\n  game.pendingPowerTokenGrant = null;\n  if (channelId) {\n    const ch = await fetchGameChannel(interaction.client\x2C channelId);\n    if (ch) {\n      await ch.send(`**Power Token(s) granted:** ${lines.join('\x2C ')}`).catch(discordCatch);\n      // Check for overflow and prompt discard if needed\n      if (game.pendingPowerTokenOverflow?.length > 0) {\n        const _ptCombat = game.pendingCombat;\n        if (_ptCombat && (_ptCombat.surgeRemaining || 0) > 0) {\n          game.pendingSurgeOverflow = { combatThreadId: channelId\x2C attackerPlayerNum: playerNum };\n        }\n        await sendPowerTokenOverflowUI(game\x2C gameId\x2C ch\x2C playerNum\x2C saveGames);\n        return; // wait for overflow resolution before continuing\n      }\n    }\n  }\n  // If mid-surge\x2C resume surge choice UI (only if surges remain \u2014 avoids\n  // incorrectly sending "ready to resolve" for non-surge token grants like Flawless Execution)\n  const combat = game.pendingCombat;\n  if (combat && channelId && (combat.surgeRemaining || 0) > 0) {\n    const thread = await fetchCombatThread(interaction.client\x2C channelId);\n    if (thread) {\n      await resumeSurgeChoiceOrResolve(game\x2C gameId\x2C combat\x2C thread\x2C ctx);\n    }\n  }\n  saveGames();\n}\n\n/**\n * Handle Spread the Pain condition choice during surge phase.\n * Custom ID: spread_pain_cond_{gameId}_{stun|weaken|bleed|skip}\n */\nexport async function handleSpreadThePainCondPick(interaction\x2C ctx) {\n  await interaction.deferUpdate().catch(discordCatch);\n  const { getGame\x2C saveGames } = ctx;\n  const m = interaction.customId.match(/^spread_pain_cond_([^_]+)_(stun|weaken|bleed|skip)$/);\n  if (!m) { await interaction.followUp({ content: 'Invalid condition choice.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  const [\x2C gameId\x2C condRaw] = m;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  if (!game.pendingSpreadThePainCondPick) { await interaction.followUp({ content: 'No pending condition pick.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  const { attackerPlayerNum\x2C combatThreadId } = game.pendingSpreadThePainCondPick;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C attackerPlayerNum\x2C canActAsPlayer\x2C 'Not your choice.')) return;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  game.pendingSpreadThePainCondPick = null;\n  const combat = game.pendingCombat;\n  if (!combat || combat.gameId !== gameId) { saveGames(); return; }\n\n  const thread = await fetchCombatThread(interaction.client\x2C combatThreadId);\n  if (!thread) { saveGames(); return; }\n\n  if (condRaw !== 'skip') {\n    const cond = condRaw[0].toUpperCase() + condRaw.slice(1); // 'Stun' | 'Weaken' | 'Bleed'\n    combat.spreadThePainConditions = [...(combat.spreadThePainConditions || [])\x2C cond];\n    await thread.send(`**Spread the Pain** \u2014 **${cond}** chosen. Will apply post-combat.`).catch(discordCatch);\n  }\n\n  // Check for power token overflow before resuming surge\n  if (game.pendingPowerTokenOverflow?.length > 0) {\n    game.pendingSurgeOverflow = { combatThreadId\x2C attackerPlayerNum };\n    await sendPowerTokenOverflowUI(game\x2C gameId\x2C thread\x2C attackerPlayerNum\x2C saveGames);\n    return;\n  }\n  // Resume surge phase\n  await resumeSurgeChoiceOrResolve(game\x2C gameId\x2C combat\x2C thread\x2C ctx);\n  saveGames();\n}\n\n/**\n * Handle Rogue One token pick: player selects which friendly figure's power token to discard.\n * Custom ID: rogue_one_token_{gameId}_{figureKey}_{tokenIndex}  or  rogue_one_token_{gameId}_skip\n */\nexport async function handleRogueOneTokenPick(interaction\x2C ctx) {\n  await interaction.deferUpdate().catch(discordCatch);\n  const { getGame\x2C saveGames } = ctx;\n  const customId = interaction.customId;\n  // Parse: rogue_one_token_{gameId}_skip  OR  rogue_one_token_{gameId}_{figureKey}_{tokenIndex}\n  const skipMatch = customId.match(/^rogue_one_token_([^_]+)_skip$/);\n  if (skipMatch) {\n    const [\x2C gameId] = skipMatch;\n    const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n    if (!game) return;\n    delete game.pendingRogueOneTokenPick;\n    const combat = game.pendingCombat;\n    if (!combat) return;\n    const thread = await fetchCombatThread(interaction.client\x2C combat.combatThreadId);\n    if (!thread) { saveGames(); return; }\n    await interaction.message.edit({ components: [] }).catch(discordCatch);\n    await thread.send('**Rogue One** \u2014 Cancelled\x2C no token discarded.').catch(discordCatch);\n    // Re-show surge UI\n    await _resumeRogueOneSurgeUI(thread\x2C game\x2C combat\x2C gameId\x2C ctx);\n    saveGames();\n    return;\n  }\n  // Parse figureKey and tokenIndex \u2014 figureKey can contain hyphens (e.g. "Cassian Andor-1-0")\n  // Format: rogue_one_token_{gameId}_{dcName}-{dgIdx}-{figIdx}_{tokenIndex}\n  const prefix = 'rogue_one_token_';\n  const rest = customId.slice(prefix.length); // gameId_figureKey_tokenIndex\n  const firstUnderscore = rest.indexOf('_');\n  if (firstUnderscore < 0) return;\n  const gameId = rest.slice(0\x2C firstUnderscore);\n  const remainder = rest.slice(firstUnderscore + 1); // figureKey_tokenIndex\n  const lastUnderscore = remainder.lastIndexOf('_');\n  if (lastUnderscore < 0) return;\n  const figureKey = remainder.slice(0\x2C lastUnderscore);\n  const tokenIndex = parseInt(remainder.slice(lastUnderscore + 1)\x2C 10);\n  if (isNaN(tokenIndex)) return;\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  if (!game.pendingRogueOneTokenPick) {\n    await interaction.followUp({ content: 'No pending Rogue One token pick.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { attackerPlayerNum } = game.pendingRogueOneTokenPick;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C attackerPlayerNum\x2C canActAsPlayer\x2C 'Not your choice.')) return;\n  delete game.pendingRogueOneTokenPick;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  const combat = game.pendingCombat;\n  if (!combat || combat.gameId !== gameId) { saveGames(); return; }\n  const thread = await fetchCombatThread(interaction.client\x2C combat.combatThreadId);\n  if (!thread) { saveGames(); return; }\n\n  // Validate the token still exists\n  const tokens = game.figurePowerTokens?.[figureKey] || [];\n  if (tokenIndex >= tokens.length) {\n    await thread.send('**Rogue One** \u2014 That token is no longer available.').catch(discordCatch);\n    await _resumeRogueOneSurgeUI(thread\x2C game\x2C combat\x2C gameId\x2C ctx);\n    saveGames();\n    return;\n  }\n  const tokenType = tokens[tokenIndex];\n  const donorDcName = dcNameFromFigureKey(figureKey);\n  removeSpentToken(game\x2C figureKey\x2C tokenIndex);\n\n  // Add +1 Hit to the attack\n  combat.bonusHits = (combat.bonusHits || 0) + 1;\n  combat.rogueOneHitsGained = (combat.rogueOneHitsGained || 0) + 1;\n  await thread.send(`**Rogue One** \u2014 Discarded **${tokenType}** token from **${donorDcName}** \u2192 **+1 Hit**.`).catch(discordCatch);\n\n  // Re-show surge UI\n  await _resumeRogueOneSurgeUI(thread\x2C game\x2C combat\x2C gameId\x2C ctx);\n  saveGames();\n}\n\n/** Helper to re-show the surge UI after Rogue One token pick resolves. */\nasync function _resumeRogueOneSurgeUI(thread\x2C game\x2C combat\x2C gameId\x2C ctx) {\n  const remaining = combat.surgeRemaining || 0;\n  if (remaining <= 0 && getRogueOneDonors(game\x2C combat).length === 0) {\n    await sendReadyToResolveRolls(thread\x2C gameId\x2C game\x2C ctx);\n    return;\n  }\n  const getSurgeLabel = ctx.getSurgeAbilityLabel || ((id) => (ctx.SURGE_LABELS?.[id]) || id);\n  const surgeAbilities = ctx.getAttackerSurgeAbilities ? ctx.getAttackerSurgeAbilities(combat) : [];\n  // Overload (Rebel Saboteur): allow same surge to be used twice\n  const _roAtkEff = getDcEffectsGlobal()?.[combat.attackerDcName] || getDcEffectsGlobal()?.[(combat.attackerDcName || '').replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n  const _roMaxUses = (_roAtkEff?.specialAbilityIds || []).includes('overload_saboteur') ? 2 : 1;\n  const surgeRows = [];\n  for (let i = 0; i < surgeAbilities.length; i++) {\n    const k = surgeAbilities[i];\n    const cost = (k?.startsWith?.('double:') ? 2 : (ctx.getAbility?.(k)?.surgeCost ?? 1));\n    if (cost > remaining) continue;\n    if (((combat.surgeSpentCount || {})[i] || 0) >= _roMaxUses) continue;\n    const label = (getSurgeLabel(k) || k).slice(0\x2C 80);\n    const btnLabel = cost > 1 ? `Spend ${cost} surge: ${label}` : `Spend 1 surge: ${label}`;\n    surgeRows.push(new ButtonBuilder().setCustomId(`combat_surge_${gameId}_${i}`).setLabel(btnLabel.slice(0\x2C 80)).setStyle(ButtonStyle.Secondary));\n  }\n  if (combat.attackerConds?.includes('Bleed') && !combat.surgePreventBleed) {\n    surgeRows.push(new ButtonBuilder().setCustomId(`combat_surge_${gameId}_bleed_prevention`).setLabel('Spend 1 Surge \u2014 Prevent Bleed').setStyle(ButtonStyle.Secondary));\n  }\n  // Rogue One: may still be usable if more donor tokens exist\n  surgeRows.push(...buildRogueOneSurgeButton(game\x2C combat));\n  surgeRows.push(new ButtonBuilder().setCustomId(`combat_surge_${gameId}_done`).setLabel('Done (no more surge)').setStyle(ButtonStyle.Primary));\n  const surgeRow = new ActionRowBuilder().addComponents(surgeRows.slice(0\x2C 5));\n  await thread.send({ content: `**Spend surge?** **${remaining}** surge left. Choose an ability or Done.`\x2C components: [surgeRow] }).catch(discordCatch);\n}\n\n/**\n * Handle Figurehead ability decision (use or skip).\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - combat context\n */\nexport async function handleFigureheadDecision(interaction\x2C ctx) {\n  const { getGame\x2C client\x2C saveGames\x2C applyDamageAndFinishCombat\x2C isDcUnique\x2C getCelebrationButtons\x2C dcHealthState\x2C logGameAction\x2C getDcStats\x2C getDcEffects\x2C processFigureDefeat: ctxProcessFigureDefeat } = ctx;\n  const isUse = interaction.customId.startsWith('figurehead_use_');\n  const gameId = parseCustomId(interaction.customId\x2C isUse ? 'figurehead_use_' : 'figurehead_skip_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  await interaction.deferUpdate().catch(discordCatch);\n  const pending = game.pendingFigurehead;\n  if (!pending) {\n    await interaction.followUp({ content: 'No pending Figurehead decision.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  delete game.pendingFigurehead;\n  const combat = game.pendingCombat;\n  if (!combat) {\n    await interaction.followUp({ content: 'Combat data missing.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { damage\x2C hit\x2C resultText\x2C totalBlast\x2C defenderPlayerNum\x2C attackerPlayerNum\x2C ownerId\x2C targetMsgId\x2C targetFigIndex\x2C fhFigKey\x2C fhMsgId\x2C fhFigIndex\x2C fhLabel } = pending;\n  const thread = await fetchCombatThread(client\x2C combat.combatThreadId);\n\n  if (isUse) {\n    const fhDamage = Math.max(0\x2C damage - 1);\n    let fhResultText = '';\n    if (fhMsgId && fhFigKey && dcHealthState) {\n      const { newHp: fhNew\x2C prevHp: fhPrev\x2C maxHp: fhMaxHp } = reduceHp(dcHealthState\x2C game\x2C fhMsgId\x2C fhFigIndex\x2C fhDamage\x2C defenderPlayerNum);\n      if (fhMaxHp > 0) {\n        fhResultText = `**Figurehead** \u2014 ${fhLabel || 'Murne Rin'} suffers **${fhDamage} damage** (${fhPrev} \u2014 ${fhNew} HP); ${combat.target.label} suffers 0.`;\n        if (fhNew <= 0) {\n          // Murne Rin defeated \u2014 centralized defeat pipeline\n          const fhDcName = dcNameFromFigureKey(fhFigKey);\n          if (ctxProcessFigureDefeat) {\n            const defeatResult = await ctxProcessFigureDefeat(game\x2C {\n              defeatedPlayerNum: defenderPlayerNum\x2C\n              figureKey: fhFigKey\x2C\n              attackerPlayerNum\x2C\n              msgId: fhMsgId\x2C\n              dcName: fhDcName\x2C\n              displayName: fhLabel || fhDcName\x2C\n              source: 'Figurehead'\x2C\n            });\n            fhResultText += ` \u2014 **${fhLabel || 'Murne Rin'} defeated!** +${defeatResult?.vp ?? 0} VP`;\n          }\n          // Post-defeat: Celebration (unique figure defeated \u2192 offer Celebration CC play)\n          const fhAtkerOwnerId = getPlayerId(game\x2C attackerPlayerNum);\n          if (!game.pendingCelebration && isDcUnique?.(fhDcName)) {\n            game.pendingCelebration = { attackerPlayerNum\x2C combatThreadId: combat.combatThreadId };\n            await thread.send(sanitizeMentions({\n              content: `<@${fhAtkerOwnerId}> \u2014 You defeated a unique figure (Figurehead). Play **Celebration** to gain 4 VP?`\x2C\n              components: [getCelebrationButtons(game.gameId)]\x2C\n              allowedMentions: { users: [fhAtkerOwnerId] }\x2C\n            })).catch(discordCatch);\n          }\n        }\n      }\n    }\n    if (fhResultText) await thread.send(fhResultText);\n    await applyDamageAndFinishCombat(game\x2C combat\x2C { damage: 0\x2C hit\x2C resultText\x2C totalBlast\x2C defenderPlayerNum\x2C attackerPlayerNum\x2C ownerId\x2C targetMsgId\x2C targetFigIndex }\x2C client);\n  } else {\n    await thread.send('**Figurehead** skipped.');\n    await applyDamageAndFinishCombat(game\x2C combat\x2C { damage\x2C hit\x2C resultText\x2C totalBlast\x2C defenderPlayerNum\x2C attackerPlayerNum\x2C ownerId\x2C targetMsgId\x2C targetFigIndex }\x2C client);\n  }\n  if (isUse && fhMsgId && ctx.updateAttachmentMessageForDc) {\n    await ctx.updateAttachmentMessageForDc(game\x2C defenderPlayerNum\x2C fhMsgId\x2C client).catch(discordCatch);\n  }\n  await interaction.editReply({ components: [] }).catch(discordCatch);\n  saveGames();\n}\n\n// \u2500\u2500\u2500 Lasat Honor Guard helpers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/** Send die picker for Lasat Honor Guard (multiple eligible dice). */\nasync function sendLasatDiePicker(thread\x2C gameId\x2C combat\x2C eligibleIdxs\x2C ctx) {\n  if (eligibleIdxs.length === 1) {\n    await sendLasatFacePicker(thread\x2C gameId\x2C combat\x2C eligibleIdxs[0]\x2C ctx);\n    return;\n  }\n  const buttons = eligibleIdxs.map((idx) => {\n    const die = combat.attackDiceResults[idx];\n    const face = `${die.acc || 0}a/${die.dmg || 0}d/${die.surge || 0}s`;\n    return new ButtonBuilder()\n      .setCustomId(`lasat_die_${gameId}_${idx}`)\n      .setLabel(`${(die.color || 'die').charAt(0).toUpperCase() + (die.color || 'die').slice(1)} [${face}]`)\n      .setStyle(ButtonStyle.Secondary);\n  });\n  const rows = buildActionRows(buttons);\n  await thread.send({ content: '**Lasat Honor Guard** \u2014 Choose which die to turn:'\x2C components: rows });\n}\n\n/** Send face picker for Lasat Honor Guard (player selects new face). */\nasync function sendLasatFacePicker(thread\x2C gameId\x2C combat\x2C dieIdx\x2C ctx) {\n  const getDiceData = ctx.getDiceData;\n  if (!getDiceData) {\n    await thread.send('**Lasat Honor Guard** \u2014 Dice data unavailable; ability skipped.');\n    return;\n  }\n  const die = combat.attackDiceResults[dieIdx];\n  const faces = getDiceData().attack?.[die.color] || [];\n  const currentKey = `${die.acc || 0}/${die.dmg || 0}/${die.surge || 0}`;\n  const otherFaces = faces\n    .map((f\x2C i) => ({ f\x2C i }))\n    .filter(({ f }) => `${f.acc || 0}/${f.dmg || 0}/${f.surge || 0}` !== currentKey);\n  if (otherFaces.length === 0) {\n    await thread.send('**Lasat Honor Guard** \u2014 No other faces available; ability skipped.');\n    return;\n  }\n  const buttons = otherFaces.map(({ f\x2C i }) =>\n    new ButtonBuilder()\n      .setCustomId(`lasat_face_${gameId}_${dieIdx}_${i}`)\n      .setLabel(`${f.acc || 0}a/${f.dmg || 0}d/${f.surge || 0}s`)\n      .setStyle(ButtonStyle.Primary)\n  );\n  const rows = buildActionRows(buttons.slice(0\x2C 25));\n  await thread.send({ content: `**Lasat Honor Guard** \u2014 Turn die ${dieIdx + 1} (${die.color || '?'}) to:`\x2C components: rows });\n}\n\n/**\n * Handle lasat_die_ button: player selects which eligible die to turn.\n * customId: lasat_die_{gameId}_{dieIdx}\n */\nexport async function handleLasatDiePick(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^lasat_die_([^_]+)_(\\d+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C idxStr] = m;\n  const dieIdx = parseInt(idxStr\x2C 10);\n  const { getGame\x2C replyIfGameEnded\x2C saveGames } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (await replyIfGameEnded(game\x2C interaction)) return;\n  const combat = game.pendingCombat;\n  if (!combat || combat.gameId !== gameId || !combat.lasatHonorGuardPhase) {\n    await interaction.followUp({ content: 'No Lasat die choice active.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const effectiveAttacker = combat.falseOrdersControllerPlayerNum ?? combat.attackerPlayerNum;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C effectiveAttacker\x2C canActAsPlayer\x2C 'Only the attacker may choose.')) return;\n  if (!(combat.lasatEligibleDiceIndices || []).includes(dieIdx)) {\n    await interaction.followUp({ content: 'That die is not eligible.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  await interaction.deferUpdate().catch(discordCatch);\n  const thread = await fetchCombatThread(interaction.client\x2C combat.combatThreadId);\n  combat.lasatChosenDieIndex = dieIdx;\n  await sendLasatFacePicker(thread\x2C gameId\x2C combat\x2C dieIdx\x2C ctx);\n  saveGames();\n}\n\n/**\n * Handle lasat_face_ button: player selects the new face for the chosen die.\n * customId: lasat_face_{gameId}_{dieIdx}_{faceIdx}\n */\nexport async function handleLasatFacePick(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^lasat_face_([^_]+)_(\\d+)_(\\d+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C dieIdxStr\x2C faceIdxStr] = m;\n  const dieIdx = parseInt(dieIdxStr\x2C 10);\n  const faceIdx = parseInt(faceIdxStr\x2C 10);\n  const { getGame\x2C replyIfGameEnded\x2C saveGames } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (await replyIfGameEnded(game\x2C interaction)) return;\n  const combat = game.pendingCombat;\n  if (!combat || combat.gameId !== gameId || !combat.lasatHonorGuardPhase) {\n    await interaction.followUp({ content: 'No Lasat face choice active.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const effectiveAttacker = combat.falseOrdersControllerPlayerNum ?? combat.attackerPlayerNum;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C effectiveAttacker\x2C canActAsPlayer\x2C 'Only the attacker may choose.')) return;\n  const getDiceData = ctx.getDiceData;\n  if (!getDiceData) { await interaction.followUp({ content: 'Dice data unavailable.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  const die = combat.attackDiceResults?.[dieIdx];\n  if (!die) { await interaction.followUp({ content: 'Die not found.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  const faces = getDiceData().attack?.[die.color] || [];\n  const newFace = faces[faceIdx];\n  if (!newFace) { await interaction.followUp({ content: 'Invalid face selection.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  // Subtract old face contribution\x2C add new face values\n  combat.attackRoll.acc = Math.max(0\x2C (combat.attackRoll.acc || 0) - (die.acc || 0)) + (newFace.acc || 0);\n  combat.attackRoll.dmg = Math.max(0\x2C (combat.attackRoll.dmg || 0) - (die.dmg || 0)) + (newFace.dmg || 0);\n  combat.attackRoll.surge = Math.max(0\x2C (combat.attackRoll.surge || 0) - (die.surge || 0)) + (newFace.surge || 0);\n  combat.attackDiceResults[dieIdx] = { ...die\x2C acc: newFace.acc || 0\x2C dmg: newFace.dmg || 0\x2C surge: newFace.surge || 0 };\n  combat.lasatHonorGuardPhase = false;\n  await interaction.deferUpdate().catch(discordCatch);\n  const thread = await fetchCombatThread(interaction.client\x2C combat.combatThreadId);\n  await thread.send(`**Lasat Honor Guard** \u2014 Turned die to ${newFace.acc || 0}a/${newFace.dmg || 0}d/${newFace.surge || 0}s. New total: ${combat.attackRoll.acc}a/${combat.attackRoll.dmg}d/${combat.attackRoll.surge}s.`);\n  await proceedAfterRerolls(thread\x2C game\x2C combat\x2C ctx);\n  saveGames();\n}\n\n// \u2500\u2500\u2500 False Orders combat handler \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Handle false_orders_atk_ button: set up combat with the controlled figure attacking a target.\n * customId: false_orders_atk_{gameId}_{msgId}_{targetIdx}\n */\nexport async function handleFalseOrdersAtkPick(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^false_orders_atk_([^_]+)_([^_]+)_(\\d+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C msgId\x2C targetIdxStr] = m;\n  const targetIdx = parseInt(targetIdxStr\x2C 10);\n  const { getGame\x2C replyIfGameEnded\x2C getDcStats\x2C getDcEffects\x2C dcHealthState\x2C logGameAction\x2C ACTION_ICONS\x2C ThreadAutoArchiveDuration\x2C saveGames\x2C client } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (await replyIfGameEnded(game\x2C interaction)) return;\n  const fo = game.pendingFalseOrders;\n  if (!fo || (!fo.isLure && fo.murneRinMsgId !== msgId)) {\n    await interaction.followUp({ content: 'No pending False Orders / Lure.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { controllerPlayerNum\x2C controlledFigureKey\x2C controlledPlayerNum } = fo;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C controllerPlayerNum\x2C canActAsPlayer\x2C 'Only the controller may choose.')) return;\n  const targets = game.falseOrdersAttackTargets?.[msgId];\n  const target = targets?.[targetIdx];\n  if (!target) {\n    await interaction.followUp({ content: 'Target no longer valid.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  delete game.falseOrdersAttackTargets?.[msgId];\n  delete game.pendingFalseOrders;\n  const controlledName = dcNameFromFigureKey(controlledFigureKey);\n  const controlledStats = getDcStats(controlledName);\n  const attackInfo = controlledStats?.attack || { dice: ['red']\x2C range: [1\x2C 3] };\n  const targetDcName = dcNameFromFigureKey(target.figureKey);\n  const targetStats = getDcStats(targetDcName);\n  const targetEff = getDcEffects()[targetDcName] || getDcEffects()[targetDcName?.replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n  const defenderPlayerNum = opponentPlayerNum(controlledPlayerNum);\n  const combatDeclare = `**False Orders** \u2014 P${controllerPlayerNum} controls "${controlledName}" attacking "${target.label}"!`;\n  const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n  const declareMsg = await generalChannel.send({\n    content: `${ACTION_ICONS?.attack || '\u2694\ufe0f'} <t:${Math.floor(Date.now() / 1000)}:t> \u2014 ${combatDeclare}`\x2C\n    allowedMentions: { users: snowflakeUsers([game.player1Id\x2C game.player2Id]) }\x2C\n  });\n  const thread = await declareMsg.startThread({\n    name: `Combat (False Orders): P${controllerPlayerNum} vs P${defenderPlayerNum}`\x2C\n    autoArchiveDuration: ThreadAutoArchiveDuration?.OneWeek ?? 10080\x2C\n  });\n  const readyRow = new ActionRowBuilder().addComponents(\n    new ButtonBuilder()\n      .setCustomId(`combat_ready_${gameId}`)\n      .setLabel('Ready to roll combat dice')\n      .setStyle(ButtonStyle.Secondary)\n  );\n  const preCombatMsg = await thread.send({\n    content: '**Pre-combat window** \u2014 Both players: resolve any Command Cards\x2C etc. When ready\x2C click **Ready to roll combat dice** below.'\x2C\n    components: [readyRow]\x2C\n  });\n  const isRanged = attackInfo.type === 'range';\n  game.pendingCombat = {\n    gameId\x2C\n    attackerPlayerNum: controlledPlayerNum\x2C\n    defenderPlayerNum\x2C\n    attackerMsgId: msgId\x2C\n    attackerDcName: controlledName\x2C\n    attackerDisplayName: controlledName\x2C\n    attackerFigureKey: controlledFigureKey\x2C\n    attackerConds: game.figureConditions?.[controlledFigureKey] || []\x2C\n    defenderConds: game.figureConditions?.[target.figureKey] || []\x2C\n    target: { ...target }\x2C\n    targetStats: {\n      defense: targetStats?.defense || 'white'\x2C\n      cost: targetStats?.cost ?? 5\x2C\n      subCost: targetEff?.subCost\x2C\n      figures: targetStats?.figures ?? 1\x2C\n    }\x2C\n    attackInfo\x2C\n    isRanged\x2C\n    distanceToTarget: target.dist ?? 1\x2C\n    combatThreadId: thread.id\x2C\n    combatDeclareMsgId: declareMsg.id\x2C\n    combatPreMsgId: preCombatMsg.id\x2C\n    p1Ready: false\x2C\n    p2Ready: false\x2C\n    attackRoll: null\x2C\n    defenseRoll: null\x2C\n    attackTargetMsgId: interaction.message.id\x2C\n    falseOrdersControllerPlayerNum: controllerPlayerNum\x2C\n    isLure: !!fo.isLure\x2C\n    lurePostAttackStrain: fo.postAttackStrain || 0\x2C\n  };\n  const controlledEff = getDcEffects()[controlledName] || getDcEffects()[controlledName?.replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n  const defEff = getDcEffects()[targetDcName] || getDcEffects()[targetDcName?.replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n  applyDcPassivesToCombat(game.pendingCombat\x2C controlledStats?.passives || []\x2C targetStats?.passives || []);\n  const abilityLabel = fo.isLure ? 'Lure of the Dark Side' : 'False Orders';\n  await interaction.message.edit({ content: `**${abilityLabel} \u2014 Attack declared**. See thread in Game Log.`\x2C components: [] }).catch(discordCatch);\n  if (logGameAction) await logGameAction(game\x2C client\x2C `\u2694\ufe0f **${abilityLabel}** \u2014 P${controllerPlayerNum} controlling **${controlledName}** attacks **${targetDcName}**.`\x2C { phase: 'ROUND'\x2C icon: 'attack' }).catch(discordCatch);\n  saveGames();\n}\n\n/**\n * Cover Fire \u2014 Block Token distribution picker.\n * cover_fire_block_{gameId}_{playerNum}_{figureKey}\n */\nexport async function handleCoverFireBlock(interaction\x2C ctx) {\n  await interaction.deferUpdate().catch(discordCatch);\n  const { getGame\x2C saveGames\x2C logGameAction\x2C client\x2C findDcMessageIdForFigure } = ctx;\n  const match = interaction.customId.match(/^cover_fire_block_(\\d+)_(\\d+)_(.+)$/);\n  if (!match) return;\n  const [\x2C gameId\x2C playerNumStr\x2C figureKey] = match;\n  const playerNum = parseInt(playerNumStr\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the attacker can choose.')) return;\n  grantPowerTokens(game\x2C figureKey\x2C 'Block'\x2C 1);\n  game.pendingCoverFire = null;\n  const dcName = dcNameFromFigureKey(figureKey);\n  await interaction.message.edit({ content: `\ud83d\udee1\ufe0f **Cover Fire** \u2014 **${dcName}** received 1 Block Token.`\x2C components: [] }).catch(discordCatch);\n  if (logGameAction) await logGameAction(game\x2C client\x2C `\ud83d\udee1\ufe0f **Cover Fire** \u2014 **${dcName}** gained 1 Block Token.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  // G73: Check for power token overflow\n  if (game.pendingPowerTokenOverflow?.length > 0) {\n    const ch = await fetchGameChannel(interaction.client\x2C interaction.channelId);\n    if (ch) await sendPowerTokenOverflowUI(game\x2C gameId\x2C ch\x2C playerNum\x2C saveGames);\n    return;\n  }\n  saveGames();\n}\n\n/**\n * Cover Fire \u2014 Discard a condition or Power Token from the target.\n * cover_fire_discard_{gameId}_{type}_{index}_{figureKey}\n * cover_fire_discard_skip_{gameId}\n */\nexport async function handleCoverFireDiscard(interaction\x2C ctx) {\n  await interaction.deferUpdate().catch(discordCatch);\n  const { getGame\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  // Skip button\n  if (interaction.customId.startsWith('cover_fire_discard_skip_')) {\n    const skipGameId = parseCustomId(interaction.customId\x2C 'cover_fire_discard_skip_');\n    const skipGame = await requireGame(interaction\x2C getGame\x2C skipGameId\x2C { silent: true });\n    if (skipGame) skipGame.pendingCoverFire = null;\n    await interaction.message.edit({ content: '\ud83d\udee1\ufe0f **Cover Fire** \u2014 Skipped condition/token removal.'\x2C components: [] }).catch(discordCatch);\n    if (skipGame) saveGames();\n    return;\n  }\n  const match = interaction.customId.match(/^cover_fire_discard_(\\d+)_(condition|token)_(\\d+)_(.+)$/);\n  if (!match) return;\n  const [\x2C gameId\x2C type\x2C indexStr\x2C figureKey] = match;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  const dcName = dcNameFromFigureKey(figureKey);\n  game.pendingCoverFire = null;\n  if (type === 'condition') {\n    const conds = game.figureConditions?.[figureKey] || [];\n    const idx = parseInt(indexStr\x2C 10);\n    if (idx < conds.length) {\n      const removed = conds[idx];\n      filterCondition(game\x2C figureKey\x2C removed);\n      await interaction.message.edit({ content: `\ud83d\udee1\ufe0f **Cover Fire** \u2014 Discarded **${removed}** from **${dcName}**.`\x2C components: [] }).catch(discordCatch);\n      if (logGameAction) await logGameAction(game\x2C client\x2C `\ud83d\udee1\ufe0f **Cover Fire** \u2014 Discarded **${removed}** from **${dcName}**.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n    }\n  } else if (type === 'token') {\n    const tokens = game.figurePowerTokens?.[figureKey] || [];\n    const idx = parseInt(indexStr\x2C 10);\n    if (idx < tokens.length) {\n      const removed = tokens[idx];\n      tokens.splice(idx\x2C 1);\n      game.figurePowerTokens[figureKey] = tokens;\n      await interaction.message.edit({ content: `\ud83d\udee1\ufe0f **Cover Fire** \u2014 Discarded **${removed} Token** from **${dcName}**.`\x2C components: [] }).catch(discordCatch);\n      if (logGameAction) await logGameAction(game\x2C client\x2C `\ud83d\udee1\ufe0f **Cover Fire** \u2014 Discarded **${removed} Token** from **${dcName}**.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n    }\n  }\n  saveGames();\n}\n\n/** Guidance Systems (Mortar Trooper): apply -1 Hit\x2C +2 Accuracy. May be used multiple times. */\nexport async function handleGuidanceSystems(interaction\x2C ctx) {\n  const { getGame\x2C saveGames } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'guidance_systems_');\n  const gameId = parts[0];\n  const action = parts[1]; // 'use' or 'done'\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const combat = game.pendingCombat;\n  if (!combat || combat.gameId !== gameId) {\n    await interaction.followUp({ content: 'No pending combat.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const thread = await fetchCombatThread(interaction.client\x2C combat.combatThreadId);\n  if (action === 'use') {\n    combat.attackRoll.dmg = Math.max(0\x2C (combat.attackRoll.dmg || 0) - 1);\n    combat.attackRoll.acc = (combat.attackRoll.acc || 0) + 2;\n    combat.guidanceSystemsCount = (combat.guidanceSystemsCount || 0) + 1;\n    const gsCount = combat.guidanceSystemsCount;\n    const _gsRow = new ActionRowBuilder().addComponents(\n      new ButtonBuilder().setCustomId(`guidance_systems_${gameId}_use`).setLabel('Use again (-1 Hit\x2C +2 Acc)').setStyle(ButtonStyle.Primary)\x2C\n      new ButtonBuilder().setCustomId(`guidance_systems_${gameId}_done`).setLabel('Done').setStyle(ButtonStyle.Secondary)\x2C\n    );\n    await interaction.message.edit({\n      content: `**Guidance Systems** \u2014 Applied ${gsCount}x (-${gsCount} Hit\x2C +${gsCount * 2} Acc). Current: ${combat.attackRoll.acc} acc\x2C ${combat.attackRoll.dmg} dmg\x2C ${combat.attackRoll.surge} surge. Use again?`\x2C\n      components: [_gsRow]\x2C\n    }).catch(discordCatch);\n    saveGames();\n  } else {\n    // Done \u2014 continue to defense roll\n    const gsCount = combat.guidanceSystemsCount || 0;\n    await interaction.message.edit({\n      content: `**Guidance Systems** \u2014 Applied ${gsCount}x. Final attack: ${combat.attackRoll.acc} acc\x2C ${combat.attackRoll.dmg} dmg\x2C ${combat.attackRoll.surge} surge.`\x2C\n      components: []\x2C\n    }).catch(discordCatch);\n    saveGames();\n  }\n}\n\n/**\n * Zillo Technique: defender discards a CC from hand for +1 Block\x2C or skips.\n */\nexport async function handleZilloDiscard(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const isSkip = interaction.customId.startsWith('zillo_discard_skip_');\n  const parts = splitCustomId(interaction.customId\x2C isSkip ? 'zillo_discard_skip_' : 'zillo_discard_');\n  const gameId = parts[0];\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  const combat = game.pendingCombat;\n  const pending = game.pendingZilloDiscard;\n  if (!combat || !pending) {\n    await interaction.message.edit({ components: [] }).catch(discordCatch);\n    return;\n  }\n  const thread = await fetchCombatThread(client\x2C combat.combatThreadId);\n  if (isSkip) {\n    delete game.pendingZilloDiscard;\n    await interaction.message.edit({ content: '**Zillo Technique** \u2014 Skipped (+1 Block).'\x2C components: [] }).catch(discordCatch);\n  } else {\n    const defPN = pending.defenderPN;\n    const cardIdx = parseInt(parts[1]\x2C 10);\n    const handKey = ccHandKey(defPN);\n    const hand = game[handKey] || [];\n    if (cardIdx >= 0 && cardIdx < hand.length) {\n      const cardName = hand[cardIdx];\n      hand.splice(cardIdx\x2C 1);\n      const discKey = ccDiscardKey(defPN);\n      game[discKey] = game[discKey] || [];\n      game[discKey].push(cardName);\n      combat.bonusBlock = (combat.bonusBlock || 0) + 1;\n      delete game.pendingZilloDiscard;\n      await interaction.message.edit({ content: `**Zillo Technique** \u2014 Discarded **${cardName}**: +1 Block applied to defense.`\x2C components: [] }).catch(discordCatch);\n      if (thread) await thread.send(`**Zillo Technique** \u2014 Defender discarded **${cardName}** for **+1 Block**.`).catch(discordCatch);\n    }\n  }\n  saveGames();\n}\n\n// \u2500\u2500\u2500 Power Token Overflow (G73) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/** Token-type emoji map for display. */\nconst TOKEN_EMOJI = { Damage: '\ud83d\udd34'\x2C Hit: '\ud83d\udd34'\x2C Surge: '\u26a1'\x2C Block: '\ud83d\udee1\ufe0f'\x2C Evade: '\ud83d\udfe2' };\n\n/**\n * Check whether game.pendingPowerTokenOverflow has any entries and\x2C if so\x2C\n * send discard-choice buttons for the first figure that is over its cap.\n * Should be called after any grantPowerTokens() call from the Discord layer.\n *\n * @param {object} game\n * @param {string} gameId\n * @param {object} channel - Discord TextChannel / ThreadChannel to send the prompt in\n * @param {number} playerNum - player who owns the figure (for access control)\n * @param {Function} saveGames\n * @returns {Promise<boolean>} true if an overflow prompt was sent\n */\nexport async function sendPowerTokenOverflowUI(game\x2C gameId\x2C channel\x2C playerNum\x2C saveGames) {\n  const overflowArr = game.pendingPowerTokenOverflow;\n  if (!overflowArr?.length) return false;\n  const entry = overflowArr[0];\n  const { figureKey\x2C discardCount } = entry;\n  const tokens = game.figurePowerTokens?.[figureKey] || [];\n  const max = getMaxPowerTokens(figureKey);\n  const figName = dcNameFromFigureKey(figureKey);\n\n  // Build one button per token the figure currently holds\n  const btns = [];\n  for (let i = 0; i < tokens.length; i++) {\n    const t = tokens[i];\n    const emoji = TOKEN_EMOJI[t] || '';\n    btns.push(\n      new ButtonBuilder()\n        .setCustomId(`pt_overflow_${gameId}_${playerNum}_${figureKey}_${i}`)\n        .setLabel(`${emoji} ${t}`.trim())\n        .setStyle(ButtonStyle.Secondary)\n    );\n  }\n  const rows = chunkButtonsToRows(btns);\n\n  // Store the playerNum so the handler can enforce access\n  entry.playerNum = playerNum;\n  entry.channelId = channel.id;\n\n  const tokenList = tokens.map(t => `${TOKEN_EMOJI[t] || ''} ${t}`).join('\x2C ');\n  await channel.send({\n    content: `\u26a0\ufe0f **Power Token Overflow** \u2014 **${figName}** has **${tokens.length}** tokens (max ${max}). ` +\n      `Discard **${discardCount}** token${discardCount > 1 ? 's' : ''}.\\n` +\n      `Current tokens: ${tokenList}\\n` +\n      `Choose which token to discard:`\x2C\n    components: rows\x2C\n  }).catch(discordCatch);\n\n  if (saveGames) saveGames();\n  return true;\n}\n\n/**\n * Handle overflow discard button: pt_overflow_{gameId}_{playerNum}_{figureKey}_{tokenIndex}\n */\nexport async function handlePowerTokenOverflowDiscard(interaction\x2C ctx) {\n  await interaction.deferUpdate().catch(discordCatch);\n  const { getGame\x2C saveGames } = ctx;\n  const match = interaction.customId.match(/^pt_overflow_(\\d+)_(\\d+)_(.+)_(\\d+)$/);\n  if (!match) {\n    await interaction.followUp({ content: 'Invalid overflow discard.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C gameId\x2C playerNumStr\x2C figureKey\x2C indexStr] = match;\n  const playerNum = parseInt(playerNumStr\x2C 10);\n  const tokenIndex = parseInt(indexStr\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Not your token to discard.')) return;\n\n  // Validate we still have a pending overflow for this figure\n  const overflowArr = game.pendingPowerTokenOverflow;\n  if (!overflowArr?.length || !overflowArr.some(e => e.figureKey === figureKey && e.discardCount > 0)) {\n    await interaction.followUp({ content: 'No pending overflow for this figure.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const { discarded\x2C remaining } = resolveOverflowDiscard(game\x2C figureKey\x2C tokenIndex);\n  if (!discarded) {\n    await interaction.followUp({ content: 'Invalid token index.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const figName = dcNameFromFigureKey(figureKey);\n  const emoji = TOKEN_EMOJI[discarded] || '';\n\n  if (remaining > 0) {\n    // Still need more discards \u2014 rebuild the buttons with updated indices\n    const tokens = game.figurePowerTokens?.[figureKey] || [];\n    const btns = [];\n    for (let i = 0; i < tokens.length; i++) {\n      const t = tokens[i];\n      const te = TOKEN_EMOJI[t] || '';\n      btns.push(\n        new ButtonBuilder()\n          .setCustomId(`pt_overflow_${gameId}_${playerNum}_${figureKey}_${i}`)\n          .setLabel(`${te} ${t}`.trim())\n          .setStyle(ButtonStyle.Secondary)\n      );\n    }\n    const rows = chunkButtonsToRows(btns);\n    const max = getMaxPowerTokens(figureKey);\n    const tokenList = tokens.map(t => `${TOKEN_EMOJI[t] || ''} ${t}`).join('\x2C ');\n    await interaction.message.edit({\n      content: `\u26a0\ufe0f **Power Token Overflow** \u2014 **${figName}** discarded ${emoji} **${discarded}**. Still has **${tokens.length}** tokens (max ${max}). ` +\n        `Discard **${remaining}** more.\\n` +\n        `Current tokens: ${tokenList}\\n` +\n        `Choose which token to discard:`\x2C\n      components: rows\x2C\n    }).catch(discordCatch);\n  } else {\n    // Overflow resolved\n    const tokens = game.figurePowerTokens?.[figureKey] || [];\n    const tokenList = tokens.map(t => `${TOKEN_EMOJI[t] || ''} ${t}`).join('\x2C ');\n    await interaction.message.edit({\n      content: `\u2705 **${figName}** discarded ${emoji} **${discarded}**. Tokens: ${tokenList || 'none'}`\x2C\n      components: []\x2C\n    }).catch(discordCatch);\n\n    // Check if there are more figures with overflow\n    if (game.pendingPowerTokenOverflow?.length > 0) {\n      const nextEntry = game.pendingPowerTokenOverflow[0];\n      const ch = await fetchGameChannel(interaction.client\x2C nextEntry.channelId || interaction.channelId);\n      if (ch) {\n        await sendPowerTokenOverflowUI(game\x2C gameId\x2C ch\x2C nextEntry.playerNum || playerNum\x2C saveGames);\n        return; // saveGames already called\n      }\n    }\n\n    // Resume surge flow if overflow originated from surge resolution\n    if (game.pendingSurgeOverflow) {\n      const { combatThreadId\x2C attackerPlayerNum: atkNum } = game.pendingSurgeOverflow;\n      game.pendingSurgeOverflow = null;\n      const combat = game.pendingCombat;\n      if (combat && combatThreadId) {\n        const surgeThread = await fetchCombatThread(interaction.client\x2C combatThreadId);\n        if (surgeThread) {\n          await resumeSurgeChoiceOrResolve(game\x2C gameId\x2C combat\x2C surgeThread\x2C ctx);\n        }\n      }\n    }\n  }\n  saveGames();\n}\n
