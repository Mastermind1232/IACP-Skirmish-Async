script-source,503,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/discord.js/src/util/Colors.js,'use strict';\n\n/**\n * @typedef {Object} Colors\n * @property {number} Default 0x000000 | rgb(0\x2C0\x2C0)\n * @property {number} White 0xFFFFFF | rgb(255\x2C255\x2C255)\n * @property {number} Aqua 0x1ABC9C | rgb(26\x2C188\x2C156)\n * @property {number} Green 0x57F287 | rgb(87\x2C242\x2C135)\n * @property {number} Blue 0x3498DB | rgb(52\x2C152\x2C219)\n * @property {number} Yellow 0xFEE75C | rgb(254\x2C231\x2C92)\n * @property {number} Purple 0x9B59B6 | rgb(155\x2C89\x2C182)\n * @property {number} LuminousVividPink 0xE91E63 | rgb(233\x2C30\x2C99)\n * @property {number} Fuchsia 0xEB459E | rgb(235\x2C69\x2C158)\n * @property {number} Gold 0xF1C40F | rgb(241\x2C196\x2C15)\n * @property {number} Orange 0xE67E22 | rgb(230\x2C126\x2C34)\n * @property {number} Red 0xED4245 | rgb(237\x2C66\x2C69)\n * @property {number} Grey 0x95A5A6 | rgb(149\x2C165\x2C166)\n * @property {number} Navy 0x34495E | rgb(52\x2C73\x2C94)\n * @property {number} DarkAqua 0x11806A | rgb(17\x2C128\x2C106)\n * @property {number} DarkGreen 0x1F8B4C | rgb(31\x2C139\x2C76)\n * @property {number} DarkBlue 0x206694 | rgb(32\x2C102\x2C148)\n * @property {number} DarkPurple 0x71368A | rgb(113\x2C54\x2C138)\n * @property {number} DarkVividPink 0xAD1457 | rgb(173\x2C20\x2C87)\n * @property {number} DarkGold 0xC27C0E | rgb(194\x2C124\x2C14)\n * @property {number} DarkOrange 0xA84300 | rgb(168\x2C67\x2C0)\n * @property {number} DarkRed 0x992D22 | rgb(153\x2C45\x2C34)\n * @property {number} DarkGrey 0x979C9F | rgb(151\x2C156\x2C159)\n * @property {number} DarkerGrey 0x7F8C8D | rgb(127\x2C140\x2C141)\n * @property {number} LightGrey 0xBCC0C0 | rgb(188\x2C192\x2C192)\n * @property {number} DarkNavy 0x2C3E50 | rgb(44\x2C62\x2C80)\n * @property {number} Blurple 0x5865F2 | rgb(88\x2C101\x2C242)\n * @property {number} Greyple 0x99AAb5 | rgb(153\x2C170\x2C181)\n * @property {number} DarkButNotBlack 0x2C2F33 | rgb(