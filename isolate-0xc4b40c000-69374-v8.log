tick,0x183a9c694,269864,0,0x0,0,0x128add05c,0x128adf540,0x128adffe8,0x128ad7d54,0x128ad81f4,0x128ad84e0,0x128ad866c,0x128ad9e38,0x128ae4124,0x128ae3238,0x128ae37a0,0x128ae29b4,0x128ae4f30,0x128ae53d8,0x128ae44ac,0x128ae3238,0x128ae37a0,0x128ae29b4,0x7c98725b85c,0x7c98725b635,0x7c9872569a9,0x7c987256643,0x7c9872530c4,0x7c98725ba3d,0x7c98725b85c,0x7c98725b635,0x7c9872569a9,0x7c987256643,0x7c9872530c4,0x7c98725ba3d,0x7c98725b85c,0x7c98725b635,0x7c9872569a9,0x7c987256643,0x7c9872530c4,0x7c98725ba3d,0x7c98725b85c,0x7c98725b635,0x7c9872569a9,0x7c987256643,0x7c9872530c4,0x7c98725ba3d,0x7c98725b85c,0x7c98725b635,0x7c9872569a9,0x7c987256643,0x7c9872530c4,0x7c987252e14,0x7c987252ab2,0x7c9872528ff,0x7c9872527a0,0x7c987251931,0x7c987251743,0x7c98724efb7,0x7c987249608
