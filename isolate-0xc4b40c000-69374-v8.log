code-creation,Script,9,112309,0x7c9872770f0,52, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/requests.js:1:1,0x31fbc8de2618,~
script-source,147,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/requests.js,/**\n * Request moderation handlers: request_resolve_\x2C request_reject_.\n * Admin-only; mark bot-request threads as [IMPLEMENTED] or [REJECTED].\n */\nimport { PermissionFlagsBits } from 'discord.js';\nimport { discordCatch } from '../error-handling.js';\nimport { fetchGameChannel } from '../discord/channel-helpers.js';\nimport { parseCustomId } from '../discord/custom-id.js';\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - logGameErrorToBotLogs\n */\nexport async function handleRequestResolve(interaction\x2C ctx) {\n  const { logGameErrorToBotLogs } = ctx;\n  const threadId = parseCustomId(interaction.customId\x2C 'request_resolve_');\n  if (!interaction.member?.permissions?.has(PermissionFlagsBits.Administrator)) {\n    await interaction.followUp({ content: 'Only admins can resolve requests.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  try {\n    const thread = await fetchGameChannel(interaction.client\x2C threadId);\n    if (!thread?.isThread?.()) {\n      await interaction.followUp({ content: 'Thread not found.'\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n    const name = thread.name;\n    const prefix = '[IMPLEMENTED] ';\n    const newName = name.startsWith(prefix) ? name : prefix + name.replace(/^\\[REJECTED\\] /\x2C '');\n    await thread.setName(newName);\n    await interaction.message.edit({ content: '\u2713 Marked as resolved.'\x2C components: [] }).catch(discordCatch);\n  } catch (err) {\n    await logGameErrorToBotLogs(interaction.client\x2C interaction.guild\x2C null\x2C err\x2C 'request_resolve');\n    await interaction.followUp({ content: `Failed: ${err.message}`\x2C ephemeral: true }).catch(discordCatch);\n  }\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - logGameErrorToBotLogs\n */\nexport async function handleRequestReject(interaction\x2C ctx) {\n  const { logGameErrorToBotLogs } = ctx;\n  const threadId = parseCustomId(interaction.customId\x2C 'request_reject_');\n  if (!interaction.member?.permissions?.has(PermissionFlagsBits.Administrator)) {\n    await interaction.followUp({ content: 'Only admins can reject requests.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  try {\n    const thread = await fetchGameChannel(interaction.client\x2C threadId);\n    if (!thread?.isThread?.()) {\n      await interaction.followUp({ content: 'Thread not found.'\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n    const name = thread.name;\n    const prefix = '[REJECTED] ';\n    const newName = name.startsWith(prefix) ? name : prefix + name.replace(/^\\[IMPLEMENTED\\] /\x2C '');\n    await thread.setName(newName);\n    await interaction.message.edit({ content: '\u2713 Marked as rejected.'\x2C components: [] }).catch(discordCatch);\n  } catch (err) {\n    await logGameErrorToBotLogs(interaction.client\x2C interaction.guild\x2C null\x2C err\x2C 'request_reject');\n    await interaction.followUp({ content: `Failed: ${err.message}`\x2C ephemeral: true }).catch(discordCatch);\n  }\n}\n
