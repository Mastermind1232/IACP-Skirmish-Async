script-source,907,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/canvas/lib/pdfstream.js,'use strict'\n\n/*!\n * Canvas - PDFStream\n */\n\nconst { Readable } = require('stream')\nfunction noop () {}\n\nclass PDFStream extends Readable {\n  constructor (canvas\x2C options) {\n    super()\n\n    this.canvas = canvas\n    this.options = options\n  }\n\n  _read () {\n    // For now we're not controlling the c++ code's data emission\x2C so we only\n    // call canvas.streamPDFSync once and let it emit data at will.\n    this._read = noop\n\n    this.canvas.streamPDFSync((err\x2C chunk\x2C len) => {\n      if (err) {\n        this.emit('error'\x2C err)\n      } else if (len) {\n        this.push(chunk)\n      } else {\n        this.push(null)\n      }\n    }\x2C this.options)\n  }\n}\n\nmodule.exports = PDFStream\n
