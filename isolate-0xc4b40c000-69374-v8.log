script-source,196,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/context-factory.js,/**\n * Context factory: builds handler context objects from a shared dependencies bag.\n * Each context group defines the set of dependency keys its handlers need.\n */\n\n/** Shared combat dependencies \u2014 used by both combat and combatReactions groups. */\nconst COMBAT_DEPS = [\n  'getGame'\x2C 'replyIfGameEnded'\x2C 'dcMessageMeta'\x2C 'dcHealthState'\x2C\n  'findDcMessageIdForFigure'\x2C 'getDcStats'\x2C 'getDcEffects'\x2C\n  'updateDcActionsMessage'\x2C 'updateActivationsMessage'\x2C\n  'updateAttachmentMessageForDc'\x2C 'logGameAction'\x2C 'isGroupDefeated'\x2C\n  'checkWinConditions'\x2C 'finishCombatResolution'\x2C 'checkPostCombatSurges'\x2C\n  'ACTION_ICONS'\x2C 'ThreadAutoArchiveDuration'\x2C 'resolveCombatAfterRolls'\x2C\n  'saveGames'\x2C 'client'\x2C 'rollAttackDice'\x2C 'rollDefenseDice'\x2C\n  'rollSingleAttackDie'\x2C 'rollSingleDefenseDie'\x2C 'recalcAttackTotals'\x2C\n  'recalcDefenseTotals'\x2C 'getInnateRerolls'\x2C 'getAttackerSurgeAbilities'\x2C\n  'SURGE_LABELS'\x2C 'parseSurgeEffect'\x2C 'getAbility'\x2C 'resolveSurgeAbility'\x2C\n  'getSurgeAbilityLabel'\x2C 'getRange'\x2C 'hasLineOfSight'\x2C 'getDiceData'\x2C\n  'applyDamageAndFinishCombat'\x2C 'isDcUnique'\x2C 'getCelebrationButtons'\x2C 'getFiguresAdjacentToCoord'\x2C\n  'calculateKillVp'\x2C 'checkHuntDissent'\x2C 'checkThisIsTheWay'\x2C 'decrementActivationIfGroupDefeated'\x2C\n  'checkFriendlyDefeatedPassiveRedraws'\x2C 'ccAttachmentsKey'\x2C\n  'checkNefariousGains'\x2C 'updateHandVisualMessage'\x2C 'updateDiscardPileMessage'\x2C\n  'sendBleedingPrompt'\x2C 'processFigureDefeat'\x2C\n];\n\nconst CONTEXT_GROUPS = {\n  ccHand: [\n    'getGame'\x2C 'dcMessageMeta'\x2C 'dcHealthState'\x2C 'dcExhaustedState'\x2C 'saveGames'\x2C\n    'pushUndo'\x2C 'client'\x2C 'pendingIllegalSquad'\x2C 'pendingSquadConfirm'\x2C 'PENDING_ILLEGAL_TTL_MS'\x2C\n    'validateDeckLegal'\x2C 'sendDeckIllegalAlert'\x