code-creation,Script,9,271013,0x3f05b92948e0,130, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/phase-gate.js:1:1,0x1d6be1733bd0,~
script-source,219,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/phase-gate.js,/**\n * Phase gate handlers: phase_gate_ready_\x2C phase_gate_unready_\n * Sends confirmation messages to both hand channels before advancing phases.\n */\nimport { ActionRowBuilder\x2C ButtonBuilder\x2C ButtonStyle } from 'discord.js';\nimport {\n  createPhaseGate\x2C recordPhaseGateReady\x2C recordPhaseGateUnready\x2C\n  clearPhaseGate\x2C PHASE_GATE_LABELS\x2C playerNumFromId\x2C\n} from '../game/phase-gate.js';\nimport {\n  getPlayerId\x2C getHandChannelId\x2C\n} from '../game/player-helpers.js';\nimport { setPhase\x2C setRoundPhase\x2C PHASES\x2C ROUND_PHASES } from '../game/phase.js';\nimport { discordCatch } from '../error-handling.js';\nimport { fetchGameChannel } from '../discord/channel-helpers.js';\nimport { parseCustomId } from '../discord/custom-id.js';\nimport { getDcEffects } from '../data-loader.js';\nimport { getConfig } from '../game/figure-config.js';\nimport { sendCcShuffleDrawPrompts } from '../engine/cc-draw-prompts.js';\n\n// \u2500\u2500 Message builders \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * @param {object} gate\n * @param {object} game\n * @param {number} [viewerPn] - If provided\x2C only ping this player; show opponent as "Opponent".\n *                               Omit for game log (pings both).\n */\nfunction buildStatusLine(gate\x2C game\x2C viewerPn) {\n  const p1Id = getPlayerId(game\x2C 1);\n  const p2Id = getPlayerId(game\x2C 2);\n  const p1Label = (!viewerPn || viewerPn === 1) ? (p1Id ? `<@${p1Id}>` : 'P1') : 'Opponent';\n  const p2Label = (!viewerPn || viewerPn === 2) ? (p2Id ? `<@${p2Id}>` : 'P2') : 'Opponent';\n  const p1 = gate.p1Ready ? `${p1Label} \u2705` : `${p1Label} \u23f3`;\n  const p2 = gate.p2Ready ? `${p2Label} \u2705` : `${p2Label} \u23f3`;\n  const suffix = (gate.p1Ready && gate.p2Ready) ? ' \u2014 Advancing...' : '';\n  return `${p1} | ${p2}${suffix}`;\n}\n\nfunction buildGateLabel(phase\x2C game) {\n  return (PHASE_GATE_LABELS[phase] || 'Phase gate active')\n    .replace('{round}'\x2C String(game.currentRound || 1));\n}\n\nfunction buildGateContent(phase\x2C gate\x2C game\x2C viewerPn) {\n  const label = buildGateLabel(phase\x2C game);\n  const status = buildStatusLine(gate\x2C game\x2C viewerPn);\n  return `\ud83d\udd14 ${label}\\n${status}`;\n}\n\nfunction buildGateButtons(gameId\x2C playerNum\x2C gate) {\n  const isReady = playerNum === 1 ? gate.p1Ready : gate.p2Ready;\n  return new ActionRowBuilder().addComponents(\n    new ButtonBuilder()\n      .setCustomId(`phase_gate_ready_${gameId}`)\n      .setLabel('\u2705 Ready')\n      .setStyle(ButtonStyle.Success)\n      .setDisabled(isReady)\x2C\n    new ButtonBuilder()\n      .setCustomId(`phase_gate_unready_${gameId}`)\n      .setLabel('\u274c Not Ready')\n      .setStyle(ButtonStyle.Danger)\n      .setDisabled(!isReady)\x2C\n  );\n}\n\nfunction buildGatePayload(gameId\x2C playerNum\x2C gate\x2C game) {\n  // Pass playerNum as viewerPn so only the owning player is @-mentioned\n  const content = buildGateContent(gate.phase\x2C gate\x2C game\x2C playerNum);\n  const bothReady = gate.p1Ready && gate.p2Ready;\n  return {\n    content\x2C\n    components: bothReady ? [] : [buildGateButtons(gameId\x2C playerNum\x2C gate)]\x2C\n  };\n}\n\n// \u2500\u2500 Send phase gate messages \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Create and send phase gate messages to both hand channels.\n * @param {object} game\n * @param {string} phase - One of the PHASE_GATE_LABELS keys\n * @param {object} ctx - needs client\x2C logGameAction\x2C saveGames\n */\nexport async function sendPhaseGateMessages(game\x2C phase\x2C ctx) {\n  const { client\x2C logGameAction\x2C saveGames } = ctx;\n  const gameId = game.gameId;\n\n  createPhaseGate(game\x2C phase);\n  const gate = game.phaseGate;\n\n  // Send to each player's hand channel\n  for (const pn of [1\x2C 2]) {\n    const handId = getHandChannelId(game\x2C pn);\n    if (!handId) continue;\n    try {\n      const handCh = await fetchGameChannel(client\x2C handId);\n      const payload = buildGatePayload(gameId\x2C pn\x2C gate\x2C game);\n      const msg = await handCh.send(payload);\n      if (pn === 1) gate.p1MsgId = msg.id;\n      else gate.p2MsgId = msg.id;\n    } catch (err) {\n      console.error(`[phase-gate] Failed to send gate message to P${pn} hand:`\x2C err.message);\n    }\n  }\n\n  // Hand channel messages are sufficient \u2014 no Game Log message needed\n  // (players see Ready/Not Ready buttons in their Hand channels without revealing opponent status)\n\n  if (saveGames) saveGames();\n}\n\n// \u2500\u2500 Update gate messages \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function updateGateMessages(game\x2C ctx) {\n  const { client } = ctx;\n  const gate = game.phaseGate;\n  if (!gate) return;\n  const gameId = game.gameId;\n\n  for (const pn of [1\x2C 2]) {\n    const handId = getHandChannelId(game\x2C pn);\n    const msgId = pn === 1 ? gate.p1MsgId : gate.p2MsgId;\n    if (!handId || !msgId) continue;\n    try {\n      const handCh = await fetchGameChannel(client\x2C handId);\n      const msg = await handCh.messages.fetch(msgId);\n      const payload = buildGatePayload(gameId\x2C pn\x2C gate\x2C game);\n      await msg.edit(payload).catch(discordCatch);\n    } catch {\n      // Message gone \u2014 ignore\x2C recovery can handle later\n    }\n  }\n}\n\nasync function deleteGateMessages(game\x2C ctx) {\n  const { client } = ctx;\n  const gate = game.phaseGate;\n  if (!gate) return;\n\n  for (const pn of [1\x2C 2]) {\n    const handId = getHandChannelId(game\x2C pn);\n    const msgId = pn === 1 ? gate.p1MsgId : gate.p2MsgId;\n    if (!handId || !msgId) continue;\n    try {\n      const handCh = await fetchGameChannel(client\x2C handId);\n      const msg = await handCh.messages.fetch(msgId);\n      await msg.delete().catch(discordCatch);\n    } catch {\n      // Message already gone \u2014 fine\n    }\n  }\n}\n\n// \u2500\u2500 Ready handler \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Handle phase_gate_ready_ button click.\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx\n */\nexport async function handlePhaseGateReady(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'phase_gate_ready_');\n  const game = getGame(gameId);\n  if (!game || game.ended) {\n    await interaction.followUp({ content: 'Game not found or ended.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (!game.phaseGate) {\n    await interaction.followUp({ content: 'No pending phase gate.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const userId = interaction.user.id;\n  const clickerPn = playerNumFromId(game\x2C userId);\n  if (clickerPn === 0 && !game.isTestGame) {\n    await interaction.followUp({ content: 'Only players in this game can use this.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  // Block deploy_done if this player has incomplete loadout/form selections\n  if (game.phaseGate?.phase === 'deploy_done') {\n    const pn = clickerPn || (game.isTestGame ? 1 : 0);\n    if (pn > 0) {\n      const missing = getIncompleteDeploySelections(game\x2C pn);\n      if (missing.length > 0) {\n        const list = missing.map(m => `\u2022 **${m.dcName}**: ${m.what}`).join('\\n');\n        await interaction.followUp({\n          content: `Cannot mark ready \u2014 incomplete setup:\\n${list}\\n\\nPlease complete these selections in your Hand channel first.`\x2C\n          ephemeral: true\x2C\n        }).catch(discordCatch);\n        return;\n      }\n    }\n  }\n\n  const { alreadyReady\x2C bothReady\x2C playerNum } = recordPhaseGateReady(game\x2C userId);\n  if (alreadyReady) {\n    await interaction.followUp({ content: "You're already marked as ready."\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  if (!bothReady) {\n    await updateGateMessages(game\x2C ctx);\n    saveGames();\n    return;\n  }\n\n  // Both ready \u2014 finalize: delete gate messages from hand channels (no need to leave stale text)\n  await deleteGateMessages(game\x2C ctx);\n\n  const phase = game.phaseGate.phase;\n  clearPhaseGate(game);\n  await dispatchPhaseAdvance(game\x2C phase\x2C ctx);\n  saveGames();\n}\n\n// \u2500\u2500 Unready handler \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Handle phase_gate_unready_ button click.\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx\n */\nexport async function handlePhaseGateUnready(interaction\x2C ctx) {\n  const { getGame\x2C saveGames } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'phase_gate_unready_');\n  const game = getGame(gameId);\n  if (!game || game.ended) {\n    await interaction.followUp({ content: 'Game not found or ended.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (!game.phaseGate) {\n    await interaction.followUp({ content: 'No pending phase gate.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const userId = interaction.user.id;\n  const clickerPn = playerNumFromId(game\x2C userId);\n  if (clickerPn === 0 && !game.isTestGame) {\n    await interaction.followUp({ content: 'Only players in this game can use this.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const { alreadyUnready } = recordPhaseGateUnready(game\x2C userId);\n  if (alreadyUnready) {\n    await interaction.followUp({ content: "You're already marked as not ready."\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  await updateGateMessages(game\x2C ctx);\n  saveGames();\n}\n\n// \u2500\u2500 Dispatch table \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function dispatchPhaseAdvance(game\x2C phase\x2C ctx) {\n  const { client\x2C logGameAction\x2C saveGames } = ctx;\n  const gameId = game.gameId;\n\n  switch (phase) {\n    case 'deploy_done':\n      await advanceFromDeployment(game\x2C ctx);\n      break;\n\n    case 'attach_done': {\n      const { finishSetupAttachments } = ctx;\n      if (finishSetupAttachments) {\n        await finishSetupAttachments(game\x2C client);\n      }\n      break;\n    }\n\n    case 'cc_drawn': {\n      setPhase(game\x2C PHASES.ROUND_ACTIVE\x2C ROUND_PHASES.START_OF_ROUND);\n      const { getMissionRules\x2C getMapTokensData\x2C runStartOfRoundRules\x2C runStartOfRoundContinuation } = ctx;\n\n      // Round 1 enters start-of-round here (Round 2+ uses _runInitiativeSwapAndContinue).\n      // Run the same mission SOR gate + shared continuation so every start-of-round\n      // effect (mission rules\x2C CC passives\x2C DC passives\x2C hand refresh\x2C phase gate\x2C\n      // mission-specific prompts) fires identically in both paths.\n      const mapId = game.selectedMap?.id;\n      const variant = game.selectedMission?.variant;\n      const missionRules = getMissionRules?.(mapId\x2C variant) ?? {};\n      if (missionRules?.startOfRound?.randomRevealAndPlaceStrain) {\n        const missionName = game.selectedMission?.name || 'Mission Effect';\n        const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n        const row = new ActionRowBuilder().addComponents(\n          new ButtonBuilder()\n            .setCustomId(`sor_mission_reveal_${gameId}`)\n            .setLabel('Reveal Mission Tokens')\n            .setStyle(ButtonStyle.Primary)\n        );\n        await generalChannel.send({\n          content: `\u26a1 **Round ${game.currentRound || 1} \u2014 ${missionName}** \u2014 Each player randomly reveals 1 set-aside mission token. Either player: press to reveal.`\x2C\n          components: [row]\x2C\n        });\n        game.pendingMissionSorReveal = true;\n        saveGames();\n        return;\n      }\n      if (runStartOfRoundRules && missionRules?.startOfRound) {\n        await runStartOfRoundRules(game\x2C mapId\x2C variant\x2C missionRules.startOfRound\x2C { logGameAction\x2C client\x2C getMapTokensData });\n      }\n      if (runStartOfRoundContinuation) {\n        await runStartOfRoundContinuation(game\x2C gameId\x2C null\x2C ctx);\n      }\n      break;\n    }\n\n    case 'pre_end_of_round': {\n      setRoundPhase(game\x2C ROUND_PHASES.END_OF_ROUND);\n      game.endOfRoundWhoseTurn = game.initiativePlayerId;\n      const { getInitiativePlayerZoneLabel\x2C updateHandChannelMessages } = ctx;\n      const _eorInitPlayerNum = game.initiativePlayerId === game.player1Id ? 1 : 2;\n      const _eorOtherPlayerId = game.initiativePlayerId === game.player1Id ? game.player2Id : game.player1Id;\n      const _eorInitZone = getInitiativePlayerZoneLabel ? getInitiativePlayerZoneLabel(game) : '';\n      if (logGameAction) {\n        await logGameAction(game\x2C client\x2C `**End of Round** \u2014 1. Mission Rules/Effects (resolve as needed). 2. <@${game.initiativePlayerId}> (${_eorInitZone}Initiative). 3. <@${_eorOtherPlayerId}>. 4. Next phase. Initiative player: play any end-of-round effects or CCs\x2C then click **End 'End of Round' window** in your Hand.`\x2C { phase: 'ROUND'\x2C icon: 'round'\x2C allowedMentions: { users: [game.initiativePlayerId\x2C _eorOtherPlayerId] } });\n      }\n      if (updateHandChannelMessages) {\n        await updateHandChannelMessages(game\x2C client);\n      }\n      break;\n    }\n\n    case 'post_end_of_round': {\n      // Run the status phase (CC draw\x2C initiative swap\x2C etc.) then gate before activation\n      const { runStatusPhaseAfterEndOfRound } = ctx;\n      if (runStatusPhaseAfterEndOfRound) {\n        await runStatusPhaseAfterEndOfRound(game\x2C ctx);\n      }\n      break;\n    }\n\n    case 'post_start_of_round': {\n      // Start-of-round effects done \u2014 gate before activation\n      await sendPhaseGateMessages(game\x2C 'pre_activation'\x2C ctx);\n      break;\n    }\n\n    case 'pre_activation': {\n      setRoundPhase(game\x2C ROUND_PHASES.ACTIVATION);\n      const { sendRoundActivationPhaseMessage } = ctx;\n      if (sendRoundActivationPhaseMessage) {\n        await sendRoundActivationPhaseMessage(game\x2C client);\n      }\n      break;\n    }\n\n    default:\n      console.warn(`[phase-gate] Unknown phase for dispatch: ${phase}`);\n  }\n}\n\n// \u2500\u2500 Deploy-time selection validation \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nconst LOADOUT_ABILITY_IDS = ['imperial_loadout_purge_trooper'];\nconst FORM_ABILITY_IDS = ['shape_clawdite_elite'\x2C 'shape_clawdite_reg'];\n\n/**\n * Check if a player has any deployed figures missing required selections (loadout\x2C form).\n * @returns {Array<{ dcName: string\x2C what: string }>} List of missing selections\n */\nfunction getIncompleteDeploySelections(game\x2C playerNum) {\n  const missing = [];\n  const allEffects = getDcEffects() || {};\n  const positions = game.figurePositions?.[playerNum] || {};\n  for (const [fk\x2C pos] of Object.entries(positions)) {\n    if (!pos) continue;\n    const dcName = fk.replace(/-\\d+-\\d+$/\x2C '');\n    const eff = allEffects[dcName];\n    if (!eff?.specialAbilityIds) continue;\n    const cfg = getConfig(game\x2C fk);\n    if (eff.specialAbilityIds.some(id => LOADOUT_ABILITY_IDS.includes(id)) && !cfg.loadout) {\n      missing.push({ dcName: dcName.replace(/_/g\x2C ' ')\x2C what: 'select a Loadout card' });\n    }\n    if (eff.specialAbilityIds.some(id => FORM_ABILITY_IDS.includes(id)) && !cfg.form) {\n      missing.push({ dcName: dcName.replace(/_/g\x2C ' ')\x2C what: 'select a Form card' });\n    }\n  }\n  return missing;\n}\n\n// \u2500\u2500 advanceFromDeployment (extracted from setup.js) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Logic after both players have deployed: proceed to CC draw.\n * Attachments are already placed before deployment\x2C so no attachment check needed.\n */\nasync function advanceFromDeployment(game\x2C ctx) {\n  const {\n    client\x2C logGameAction\x2C saveGames\x2C\n    getInitiativePlayerZoneLabel\x2C clearPreGameSetup\x2C\n    runPostDeployPhase\x2C getCcShuffleDrawButton\x2C\n    // Companion DC embed deps (threaded to runPostDeployPhase)\n    buildDcEmbedAndFiles\x2C dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState\x2C\n    getDcPlayAreaComponents\x2C getNicknamesForDcMessage\x2C\n  } = ctx;\n  const gameId = game.gameId;\n\n  game.currentRound = 1;\n  setPhase(game\x2C PHASES.CC_DRAW);\n  game.currentActivationTurnPlayerId = game.initiativePlayerId;\n  if (clearPreGameSetup) await clearPreGameSetup(game\x2C client);\n\n  const _sendCcPrompts = async () => {\n    await sendCcShuffleDrawPrompts(game\x2C client\x2C {\n      getCcShuffleDrawButton\x2C getInitiativePlayerZoneLabel\x2C saveGames\x2C\n    });\n  };\n\n  let postDeployActive = false;\n  if (runPostDeployPhase) {\n    postDeployActive = await runPostDeployPhase(game\x2C gameId\x2C client\x2C {\n      logGameAction\x2C saveGames\x2C\n      buildDcEmbedAndFiles\x2C dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState\x2C\n      getDcPlayAreaComponents\x2C getNicknamesForDcMessage\x2C\n    }\x2C _sendCcPrompts);\n  }\n  if (!postDeployActive) {\n    await _sendCcPrompts();\n  }\n  if (saveGames) saveGames();\n}\n
