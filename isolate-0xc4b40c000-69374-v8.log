code-creation,Script,9,268469,0x3f05b9294460,160, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/recover.js:1:1,0x1d6be172e9f8,~
script-source,217,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/recover.js,/**\n * Recover handler: detect stuck game states and re-send missing UI prompts.\n * Invoked via botmenu_recover_ button or auto-recovery on bot startup.\n *\n * Phase 3.7.2: Now uses the available-actions system as a diagnostic layer.\n * getRecoveryPrompts() tells us which players need actions; the legacy\n * recover functions know HOW to reconstruct the Discord prompts.\n */\nimport { ActionRowBuilder\x2C ButtonBuilder\x2C ButtonStyle } from 'discord.js';\nimport {\n  getPlayerId\x2C getDcList\x2C getHandChannelId\x2C getPlayAreaId\x2C\n  getActivatedDcIndices\x2C opponentPlayerNum\x2C ccHandKey\x2C\n} from '../game/player-helpers.js';\nimport { discordCatch } from '../error-handling.js';\nimport { fetchGameChannel\x2C fetchCombatThread } from '../discord/channel-helpers.js';\nimport { parseCustomId } from '../discord/custom-id.js';\nimport { PHASE_GATE_LABELS } from '../game/phase-gate.js';\nimport { chunkButtonsToRows\x2C truncateLabel } from '../discord/components.js';\nimport { getRecoveryPrompts\x2C needsRecovery } from '../engine/recovery.js';\n\n/**\n * Main recovery handler \u2014 called from botmenu Recover button.\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx\n */\nexport async function handleBotmenuRecover(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'botmenu_recover_');\n  const game = getGame(gameId);\n  if (!game) {\n    await interaction.editReply({ content: 'Game not found.'\x2C components: [] }).catch(discordCatch);\n    return;\n  }\n  if (interaction.user.id !== game.player1Id && interaction.user.id !== game.player2Id) {\n    await interaction.editReply({ content: 'Only game participants can use Recover.'\x2C components: [] }).catch(discordCatch);\n    return;\n  }\n\n  const results = await runRecovery(game\x2C gameId\x2C ctx);\n\n  if (results.length === 0) {\n    // Include diagnostic info so the user can report what state the game is in\n    const diag = `phase=${game.phase || 'none'}\x2C round=${game.currentRound || 0}\x2C squads=${!!game.player1Squad}/${!!game.player2Squad}\x2C initiative=${!!game.initiativeDetermined}`;\n    await interaction.editReply({ content: `No missing prompts detected. (${diag})`\x2C components: [] }).catch(discordCatch);\n  } else {\n    const summary = results.map(r => `- ${r}`).join('\\n');\n    await interaction.editReply({ content: `**Recovered ${results.length} prompt(s):**\\n${summary}`\x2C components: [] }).catch(discordCatch);\n  }\n  saveGames();\n}\n\n/**\n * Core recovery logic \u2014 also called by auto-recovery on startup.\n * Returns array of description strings for each recovered prompt.\n *\n * Phase 3.7.2: Uses getRecoveryPrompts() from the available-actions system\n * as a diagnostic layer. The actions system tells us WHICH players need\n * prompts and WHAT types; the legacy recover functions know HOW to\n * reconstruct the specific Discord UI for each case.\n */\nexport async function runRecovery(game\x2C gameId\x2C ctx) {\n  const results = [];\n  let specificCount = 0;\n  let genericCount = 0;\n\n  // Helper: run a recovery function\x2C collect results\x2C log errors.\n  // Each recovery fn returns null (nothing to recover)\x2C a string\x2C or string[].\n  // `source` is 'specific' or 'generic' for observability.\n  async function tryRecover(name\x2C fn\x2C source = 'specific') {\n    try {\n      const r = await fn();\n      if (r == null) return;\n      const items = Array.isArray(r) ? r : [r];\n      results.push(...items);\n      if (source === 'generic') genericCount += items.length;\n      else specificCount += items.length;\n    } catch (err) {\n      console.error(`[recover] ${name}:`\x2C err.message);\n      results.push(`[ERROR] ${name}: ${err.message}`);\n    }\n  }\n\n  // \u2500\u2500 Available-actions diagnostic \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  let actionsDiag = [];\n  try {\n    const deps = { dcMessageMeta: ctx.dcMessageMeta\x2C dcExhaustedState: ctx.dcExhaustedState };\n    actionsDiag = getRecoveryPrompts(game\x2C deps);\n    if (actionsDiag.length > 0) {\n      console.log(`[recover] Available-actions diagnostic for game ${gameId}:`\x2C\n        actionsDiag.map(p => `P${p.playerNum}: ${p.description}`).join('; '));\n    }\n  } catch (err) {\n    console.error('[recover] Available-actions diagnostic failed:'\x2C err.message);\n  }\n\n  // \u2500\u2500 Phase gate (highest priority \u2014 blocks all other actions) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  await tryRecover('phaseGate'\x2C () => recoverPhaseGate(game\x2C gameId\x2C ctx));\n  if (game.phaseGate && results.length > 0) return results;\n\n  // \u2500\u2500 Run all recovery functions unconditionally \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  // Each function has its own internal guards (e.g. recoverPendingCombat\n  // checks game.pendingCombat). No phase-based dispatch needed \u2014 the\n  // guards are the single source of truth for "is this recovery relevant?"\n  await tryRecover('bothSquadsReady'\x2C     () => recoverBothSquadsReady(game\x2C gameId\x2C ctx));\n  await tryRecover('pendingCombat'\x2C       () => recoverPendingCombat(game\x2C gameId\x2C ctx));\n  await tryRecover('pendingNegation'\x2C     () => recoverPendingNegation(game\x2C gameId\x2C ctx));\n  await tryRecover('setupAttachment'\x2C     () => recoverSetupAttachmentPhase(game\x2C gameId\x2C ctx));\n  await tryRecover('pendingEndTurn'\x2C      () => recoverPendingEndTurn(game\x2C gameId\x2C ctx));\n  await tryRecover('endOfRoundWhoseTurn'\x2C () => recoverEndOfRoundWhoseTurn(game\x2C gameId\x2C ctx));\n  await tryRecover('forceVisionPending'\x2C  () => recoverForceVisionPending(game\x2C gameId\x2C ctx));\n  await tryRecover('pendingStartOfRound'\x2C () => recoverPendingStartOfRound(game\x2C gameId\x2C ctx));\n  await tryRecover('moveInProgress'\x2C      () => recoverMoveInProgress(game\x2C gameId\x2C ctx));\n  await tryRecover('roundActivation'\x2C     () => recoverRoundActivationMessage(game\x2C gameId\x2C ctx));\n  await tryRecover('ccDrawPhase'\x2C         () => recoverCcDrawPhase(game\x2C gameId\x2C ctx));\n  await tryRecover('pendingCcConfirmation'\x2C () => recoverPendingCcConfirmation(game\x2C gameId\x2C ctx));\n  await tryRecover('pendingCelebration'\x2C    () => recoverPendingCelebration(game\x2C gameId\x2C ctx));\n  await tryRecover('pendingPowerToken'\x2C     () => recoverPendingPowerTokenGrant(game\x2C gameId\x2C ctx));\n\n  // \u2500\u2500 Generic fallback: use available-actions to recover unhandled states \u2500\u2500\n  if (results.length === 0 && actionsDiag.length > 0) {\n    await tryRecover('genericActions'\x2C () => recoverFromAvailableActions(game\x2C gameId\x2C ctx\x2C actionsDiag)\x2C 'generic');\n  }\n\n  logRecoveryCrossCheck(actionsDiag\x2C results\x2C gameId);\n  if (results.length > 0) {\n    console.log(`[recover] Game ${gameId}: recovered=${results.length} (specific=${specificCount}\x2C generic=${genericCount})`);\n  }\n  return results;\n}\n\n// \u2500\u2500\u2500 Recover: both squads submitted but initiative button never posted \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function recoverBothSquadsReady(game\x2C gameId\x2C ctx) {\n  const { client\x2C saveGames } = ctx;\n\n  // Guard: both squads must be submitted\n  if (!game.player1Squad || !game.player2Squad) return null;\n  // Guard: initiative already determined \u2014 no recovery needed\n  if (game.initiativeDetermined || game.initiativePlayerId) return null;\n  // Guard: game already in active play\n  if (game.currentRound > 0) return null;\n\n  // Check if the initiative button already exists in the game log\n  if (!game.generalId) return null;\n  const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n  if (!generalChannel) return null;\n\n  const recentMsgs = await generalChannel.messages.fetch({ limit: 30 });\n  const hasInitiativeButton = recentMsgs.some(m =>\n    m.author.bot && m.components?.some(row =>\n      row.components?.some(c => c.customId?.startsWith('determine_initiative_'))\n    )\n  );\n  if (hasInitiativeButton) return 'Initiative button already present';\n\n  // Reuse the canonical "both squads ready" flow\n  const { postBothSquadsReady } = await import('../game-creation.js');\n  await postBothSquadsReady(game\x2C client\x2C {\n    createPlayAreaChannels: ctx.createPlayAreaChannels\x2C\n    createBoardChannel: ctx.createBoardChannel\x2C\n    buildBoardMapPayload: ctx.buildBoardMapPayload\x2C\n    populatePlayAreas: ctx.populatePlayAreas\x2C\n    getDetermineInitiativeButtons: ctx.getDetermineInitiativeButtons\x2C\n  }\x2C { tag: '[Recovered]' });\n  if (saveGames) saveGames();\n  return 'Re-posted "Both Squads Ready" with initiative button';\n}\n\n/**\n * Cross-check: compare available-actions diagnostic with actual recovery results.\n * Logs warnings when available-actions says players need prompts but legacy recovery\n * didn't send any. This helps identify recovery gaps over time.\n */\nfunction logRecoveryCrossCheck(actionsDiag\x2C results\x2C gameId) {\n  if (actionsDiag.length > 0 && results.length === 0) {\n    console.warn(`[recover] Cross-check: available-actions detected needs for game ${gameId} but legacy recovery sent nothing. Players: ${actionsDiag.map(p => `P${p.playerNum}: ${p.description}`).join('; ')}`);\n  }\n}\n\n// \u2500\u2500\u2500 Step 4: Recover pendingCombat \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function recoverPendingCombat(game\x2C gameId\x2C ctx) {\n  if (game.phase !== 'round_active') return null;\n  const { client\x2C sendReadyToResolveRolls } = ctx;\n  const combat = game.pendingCombat;\n  if (!combat?.combatThreadId) return null;\n\n  let thread;\n  try {\n    thread = await fetchCombatThread(client\x2C combat.combatThreadId);\n  } catch {\n    return null; // thread gone \u2014 cannot recover\n  }\n\n  // No attack roll yet and not both ready \u2192 re-send combat_ready_ button\n  if (!combat.attackRoll && (!combat.p1Ready || !combat.p2Ready)) {\n    const readyRow = new ActionRowBuilder().addComponents(\n      new ButtonBuilder()\n        .setCustomId(`combat_ready_${gameId}`)\n        .setLabel('Ready to roll combat dice')\n        .setStyle(ButtonStyle.Secondary)\n    );\n    await thread.send({\n      content: '**[Recover]** Pre-combat window \u2014 click **Ready to roll combat dice** when ready.'\x2C\n      components: [readyRow]\x2C\n    });\n    return 'Re-sent combat ready button';\n  }\n\n  // Both ready but no roll yet \u2192 re-send combat_roll_ button\n  if (!combat.attackRoll && combat.p1Ready && combat.p2Ready) {\n    const rollRow = new ActionRowBuilder().addComponents(\n      new ButtonBuilder()\n        .setCustomId(`combat_roll_${gameId}`)\n        .setLabel('Roll Combat Dice')\n        .setStyle(ButtonStyle.Danger)\n    );\n    await thread.send({\n      content: '**[Recover]** Both players ready \u2014 click **Roll Combat Dice** to proceed.'\x2C\n      components: [rollRow]\x2C\n    });\n    return 'Re-sent combat roll button';\n  }\n\n  // Combat sub-phase gate active \u2192 re-send gate buttons\n  if (combat.combatGate) {\n    const { sendCombatGate } = await import('./combat.js');\n    await sendCombatGate(thread\x2C game\x2C combat\x2C combat.combatGate.phase\x2C ctx);\n    return `Re-sent combat gate (${combat.combatGate.phase})`;\n  }\n\n  // Reroll phase active \u2192 re-send reroll UI\n  if (combat.rerollPhase) {\n    // Import sendRerollUI at the call site to avoid circular dependency\n    const { sendRerollUI } = await import('./combat.js');\n    await sendRerollUI(thread\x2C game\x2C combat\x2C combat.rerollPhase);\n    return `Re-sent reroll UI (${combat.rerollPhase} phase)`;\n  }\n\n  // Attack roll set\x2C defense roll set\x2C no reroll phase \u2192 re-send ready to resolve\n  if (combat.attackRoll && combat.defenseRoll && !combat.rerollPhase) {\n    if (sendReadyToResolveRolls) {\n      await sendReadyToResolveRolls(thread\x2C gameId\x2C game\x2C ctx);\n      return 'Re-sent ready-to-resolve-rolls button';\n    }\n  }\n\n  // Fallback: some other sub-phase (token/surge/etc.)\n  await thread.send({\n    content: '**[Recover]** Combat is in progress. If stuck\x2C check for surge spending\x2C token usage\x2C or other pending decisions in this thread.'\x2C\n  });\n  return 'Sent combat recovery guidance';\n}\n\n// \u2500\u2500\u2500 Step 5: Recover pendingNegation \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function recoverPendingNegation(game\x2C gameId\x2C ctx) {\n  if (game.phase !== 'round_active') return null;\n  const { client\x2C getNegationResponseButtons } = ctx;\n  if (!game.pendingNegation) return null;\n\n  const oppNum = opponentPlayerNum(game.pendingNegation.playedBy);\n  const handId = getHandChannelId(game\x2C oppNum);\n  if (!handId) return null;\n\n  const handCh = await fetchGameChannel(client\x2C handId);\n  const buttons = getNegationResponseButtons(gameId);\n  await handCh.send({\n    content: `**[Recover]** Your opponent played a Command Card. Respond with Negation or let it resolve:`\x2C\n    components: [buttons]\x2C\n  });\n  return 'Re-sent negation response buttons';\n}\n\n// \u2500\u2500\u2500 Step 6: Recover setupAttachmentPhase \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function recoverSetupAttachmentPhase(game\x2C gameId\x2C ctx) {\n  if (game.phase !== 'attachment') return [];\n  const { client } = ctx;\n  if (!game.setupAttachmentPhase) return [];\n\n  const results = [];\n  for (const pn of [1\x2C 2]) {\n    if (game.setupAttachmentConfirmed?.[pn]) continue;\n\n    const handId = getHandChannelId(game\x2C pn);\n    if (!handId) continue;\n    const handCh = await fetchGameChannel(client\x2C handId);\n\n    // Pending confirm \u2014 re-send confirm/reselect buttons\n    if (game.pendingAttachConfirm?.[pn]) {\n      const pc = game.pendingAttachConfirm[pn];\n      const row = new ActionRowBuilder().addComponents(\n        new ButtonBuilder()\n          .setCustomId(`attach_confirm_${gameId}_${pn}`)\n          .setLabel('Confirm')\n          .setStyle(ButtonStyle.Success)\x2C\n        new ButtonBuilder()\n          .setCustomId(`attach_reselect_${gameId}_${pn}`)\n          .setLabel('Choose Different Card')\n          .setStyle(ButtonStyle.Secondary)\x2C\n      );\n      await handCh.send({\n        content: `**[Recover]** Attach **${pc.card}** to **${pc.displayName || pc.dcName}**?`\x2C\n        components: [row]\x2C\n      });\n      results.push(`Re-sent attachment confirm for P${pn}`);\n      continue;\n    }\n\n    const pending = game.setupAttachmentPending?.[pn] || [];\n    if (pending.length > 0) {\n      // Has pending attachments \u2014 send guidance (can't fully reconstruct dropdown without setup.js internals)\n      // Use the exported recoverSetupAttachments from setup.js\n      const { recoverSetupAttachments } = await import('./setup.js');\n      if (recoverSetupAttachments) {\n        await recoverSetupAttachments(game\x2C gameId\x2C pn\x2C client);\n        results.push(`Re-sent attachment dropdown for P${pn}`);\n      } else {\n        await handCh.send({\n          content: `**[Recover]** You have ${pending.length} attachment(s) remaining to place. The dropdown should appear shortly \u2014 if not\x2C use Undo.`\x2C\n        });\n        results.push(`Sent attachment recovery guidance for P${pn}`);\n      }\n      continue;\n    }\n\n    // No pending\x2C not confirmed \u2192 re-send done prompt\n    const oppNum = opponentPlayerNum(pn);\n    const oppConfirmed = game.setupAttachmentConfirmed?.[oppNum];\n    const waitNote = !oppConfirmed ? '\\nWaiting for your opponent to finish placing theirs.' : '';\n    const row = new ActionRowBuilder().addComponents(\n      new ButtonBuilder()\n        .setCustomId(`attach_done_confirm_${gameId}_${pn}`)\n        .setLabel('Confirm')\n        .setStyle(ButtonStyle.Success)\x2C\n      new ButtonBuilder()\n        .setCustomId(`attach_done_redo_${gameId}_${pn}`)\n        .setLabel('Redo Attachments')\n        .setStyle(ButtonStyle.Secondary)\x2C\n    );\n    await handCh.send({\n      content: `**[Recover]** All attachments placed!${waitNote}`\x2C\n      components: [row]\x2C\n    });\n    results.push(`Re-sent attachment done prompt for P${pn}`);\n  }\n  return results;\n}\n\n// \u2500\u2500\u2500 Step 7: Recover pendingEndTurn \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function recoverPendingEndTurn(game\x2C gameId\x2C ctx) {\n  if (game.phase !== 'round_active') return [];\n  const { client } = ctx;\n  if (!game.pendingEndTurn || Object.keys(game.pendingEndTurn).length === 0) return [];\n\n  const results = [];\n  const generalCh = game.generalId ? await fetchGameChannel(client\x2C game.generalId) : null;\n  if (!generalCh) return [];\n\n  for (const [msgId\x2C entry] of Object.entries(game.pendingEndTurn)) {\n    // Check if the original message still exists\n    let exists = false;\n    if (entry.messageId) {\n      try {\n        await generalCh.messages.fetch(entry.messageId);\n        exists = true;\n      } catch { /* message gone */ }\n    }\n    if (exists) continue;\n\n    // Message is gone \u2014 re-send\n    const ownerId = getPlayerId(game\x2C entry.playerNum);\n    const endTurnBtn = new ActionRowBuilder().addComponents(\n      new ButtonBuilder()\n        .setCustomId(`end_turn_${gameId}_${msgId}`)\n        .setLabel('End Turn')\n        .setStyle(ButtonStyle.Primary)\n    );\n    const newMsg = await generalCh.send({\n      content: `**[Recover]** <@${ownerId}> (**Player ${entry.playerNum}**) **${entry.displayName}** finished all actions. Press **End Turn** when ready.`\x2C\n      components: [endTurnBtn]\x2C\n      allowedMentions: { users: [ownerId] }\x2C\n    });\n    entry.messageId = newMsg.id;\n    results.push(`Re-sent End Turn for ${entry.displayName}`);\n  }\n  return results;\n}\n\n// \u2500\u2500\u2500 Step 8: Recover endOfRoundWhoseTurn \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function recoverEndOfRoundWhoseTurn(game\x2C gameId\x2C ctx) {\n  if (game.phase !== 'round_active') return null;\n  const { client\x2C updateHandChannelMessages } = ctx;\n  if (!game.endOfRoundWhoseTurn) return null;\n\n  // Refresh hand channels (includes EOR button)\n  await updateHandChannelMessages(game\x2C client);\n\n  // Send reminder in general\n  if (game.generalId) {\n    const generalCh = await fetchGameChannel(client\x2C game.generalId);\n    await generalCh.send({\n      content: `**[Recover]** <@${game.endOfRoundWhoseTurn}> \u2014 it's your turn in the End of Round window. Click **End 'End of Round' window** in your Hand channel when done.`\x2C\n      allowedMentions: { users: [game.endOfRoundWhoseTurn] }\x2C\n    });\n  }\n  return 'Re-sent End of Round window reminder';\n}\n\n// \u2500\u2500\u2500 Step 9: Recover forceVisionPending \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function recoverForceVisionPending(game\x2C gameId\x2C ctx) {\n  if (game.phase !== 'round_active') return null;\n  const { client } = ctx;\n  const fvPn = game.forceVisionPending;\n  if (!fvPn) return null;\n\n  const dcList = getDcList(game\x2C fvPn) || [];\n  const activated = getActivatedDcIndices(game\x2C fvPn) || [];\n  const readyGroups = [];\n\n  for (let i = 0; i < dcList.length; i++) {\n    if (activated.includes(i)) continue;\n    const dc = dcList[i];\n    const figs = game.figurePositions?.[fvPn] || {};\n    const alive = Object.entries(figs).some(([fk\x2C pos]) => fk.startsWith(dc.dcName + '-') && pos);\n    if (!alive) continue;\n    readyGroups.push({ index: i\x2C dcName: dc.dcName\x2C displayName: dc.displayName || dc.dcName });\n  }\n\n  if (readyGroups.length === 0) return null;\n\n  const rows = [];\n  const btns = [];\n  for (const rg of readyGroups.slice(0\x2C 20)) {\n    btns.push(\n      new ButtonBuilder()\n        .setCustomId(`fv_pick_${gameId}_${fvPn}_${rg.index}`)\n        .setLabel(truncateLabel(rg.displayName))\n        .setStyle(ButtonStyle.Primary)\n    );\n    if (btns.length === 5) {\n      rows.push(new ActionRowBuilder().addComponents(...btns.splice(0)));\n    }\n  }\n  if (btns.length > 0) rows.push(new ActionRowBuilder().addComponents(...btns));\n\n  const ownerId = getPlayerId(game\x2C fvPn);\n  const generalCh = await fetchGameChannel(client\x2C game.generalId);\n  await generalCh.send({\n    content: `**[Recover]** Force Vision \u2014 <@${ownerId}>\x2C choose one of your ready groups to activate next:`\x2C\n    components: rows.slice(0\x2C 5)\x2C\n    allowedMentions: { users: [ownerId] }\x2C\n  });\n  return 'Re-sent Force Vision picker';\n}\n\n// \u2500\u2500\u2500 Step 10: Recover pendingStartOfRoundResolve \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function recoverPendingStartOfRound(game\x2C gameId\x2C ctx) {\n  if (game.phase !== 'round_active') return null;\n  const { client } = ctx;\n  if (!game.pendingStartOfRoundResolve || game.pendingStartOfRoundResolve <= 0) return null;\n\n  // Check for Rogue One pending\n  for (const pn of [1\x2C 2]) {\n    const roKey = `pendingRogueOne_p${pn}`;\n    const roPending = game[roKey];\n    if (roPending) {\n      const hand = game[ccHandKey(pn)] || [];\n      if (hand.length > 0) {\n        const handId = getHandChannelId(game\x2C pn);\n        const handCh = await fetchGameChannel(client\x2C handId);\n        const pickBtns = hand.slice(0\x2C 25).map((card\x2C idx) => new ButtonBuilder()\n          .setCustomId(`rogue_one_return_${gameId}_${pn}_${idx}`)\n          .setLabel(truncateLabel(card))\n          .setStyle(ButtonStyle.Primary)\n        );\n        const pickRows = chunkButtonsToRows(pickBtns);\n        await handCh.send({\n          content: `**[Recover]** Rogue One \u2014 Choose a card to place on top of your deck (${roPending.remaining} remaining):`\x2C\n          components: pickRows\x2C\n        });\n      }\n    }\n  }\n\n  // Always send a fallback end_start_of_round_ button in general\n  if (game.generalId) {\n    const generalCh = await fetchGameChannel(client\x2C game.generalId);\n    const fallbackRow = new ActionRowBuilder().addComponents(\n      new ButtonBuilder()\n        .setCustomId(`end_start_of_round_${gameId}`)\n        .setLabel('End Start of Round Window')\n        .setStyle(ButtonStyle.Secondary)\n    );\n    await generalCh.send({\n      content: `**[Recover]** Start-of-round effects are pending. Resolve any remaining effects\x2C then click below to advance.`\x2C\n      components: [fallbackRow]\x2C\n    });\n  }\n  return 'Re-sent start-of-round resolution prompts';\n}\n\n// \u2500\u2500\u2500 Step 11: Recover moveInProgress \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function recoverMoveInProgress(game\x2C gameId\x2C ctx) {\n  if (game.phase !== 'round_active') return [];\n  const { client\x2C getMoveMpButtonRows } = ctx;\n  if (!game.moveInProgress || Object.keys(game.moveInProgress).length === 0) return [];\n\n  const results = [];\n  for (const [moveKey\x2C moveState] of Object.entries(game.moveInProgress)) {\n    if (!moveState || moveState.mpRemaining <= 0) continue;\n\n    const channelId = getPlayAreaId(game\x2C moveState.playerNum);\n    if (!channelId) continue;\n\n    // Clear stale cached data\n    delete moveState.boardState;\n    delete moveState.movementCache;\n    delete moveState.distanceMessageId;\n    delete moveState.moveGridMessageIds;\n\n    // Re-send MP picker \u2014 moveKey is `${msgId}_${figureIndex}`\n    const lastUnderscore = moveKey.lastIndexOf('_');\n    const msgId = moveKey.slice(0\x2C lastUnderscore);\n    const figureIndex = moveKey.slice(lastUnderscore + 1);\n    const mpRows = getMoveMpButtonRows(msgId\x2C figureIndex\x2C moveState.mpRemaining);\n    if (mpRows.length === 0) continue;\n\n    const ch = await fetchGameChannel(client\x2C channelId);\n    await ch.send({\n      content: `**[Recover]** Movement in progress \u2014 ${moveState.mpRemaining} MP remaining. Choose how many to spend:`\x2C\n      components: mpRows\x2C\n    });\n    results.push(`Re-sent MP picker (${moveState.mpRemaining} MP remaining)`);\n  }\n  return results;\n}\n\n// \u2500\u2500\u2500 Step 12: Recover roundActivationMessageId \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function recoverRoundActivationMessage(game\x2C gameId\x2C ctx) {\n  if (game.phase !== 'round_active') return null;\n  const { client } = ctx;\n  if (!game.roundActivationMessageId || !game.generalId) return null;\n  if (!game.currentRound) return null;\n\n  // Check if message still exists\n  let generalCh;\n  try {\n    generalCh = await fetchGameChannel(client\x2C game.generalId);\n    await generalCh.messages.fetch(game.roundActivationMessageId);\n    return null; // message exists\x2C no recovery needed\n  } catch {\n    // Message is gone \u2014 re-create using current turn player (not initiative player)\n    const activePlayerId = game.currentActivationTurnPlayerId || game.initiativePlayerId;\n    const activePlayerNum = activePlayerId === game.player1Id ? 1 : 2;\n    const round = game.currentRound;\n    if (!generalCh) generalCh = await fetchGameChannel(client\x2C game.generalId);\n    const sent = await generalCh.send({\n      content: `**[Recover]** <@${activePlayerId}> (**Player ${activePlayerNum}**) **Round ${round}** \u2014 Your turn!`\x2C\n      allowedMentions: { users: [activePlayerId] }\x2C\n    });\n    game.roundActivationMessageId = sent.id;\n    return 'Re-sent round activation message';\n  }\n}\n\n// \u2500\u2500\u2500 Step 13: Recover CC draw phase \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function recoverCcDrawPhase(game\x2C gameId\x2C ctx) {\n  const { client } = ctx;\n  // Only recover CC draw if we're actually in cc_draw phase (or round_active with undrawn CCs)\n  if (game.phase !== 'cc_draw' && game.phase !== 'round_active') return [];\n  if (game.player1CcDrawn && game.player2CcDrawn) return [];\n  if (!game.p1HandId && !game.p2HandId) return [];\n\n  // Dynamically import to avoid circular deps\n  const { getCcShuffleDrawButton } = await import('../discord/components.js');\n  const results = [];\n\n  let posted = false;\n  for (const pn of [1\x2C 2]) {\n    const drawnKey = pn === 1 ? 'player1CcDrawn' : 'player2CcDrawn';\n    if (game[drawnKey]) continue;\n\n    const handId = getHandChannelId(game\x2C pn);\n    if (!handId) continue;\n\n    const handCh = await fetchGameChannel(client\x2C handId);\n    await handCh.send({\n      content: `**[Recover]** Shuffle your deck and draw your starting hand:`\x2C\n      components: [getCcShuffleDrawButton(gameId)]\x2C\n    });\n    results.push(`Re-sent shuffle/draw button for P${pn}`);\n    posted = true;\n  }\n  // Suppress the refresh-path safety net so a later auto-refresh doesn't double-post.\n  if (posted) game.ccShuffleDrawPromptsPosted = true;\n  return results;\n}\n\n// \u2500\u2500\u2500 Step 1: Recover phaseGate \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function recoverPhaseGate(game\x2C gameId\x2C ctx) {\n  if (!game.phaseGate) return null;\n  const { client } = ctx;\n  const gate = game.phaseGate;\n\n  // Check if gate messages still exist; re-send if missing\n  for (const pn of [1\x2C 2]) {\n    const handId = getHandChannelId(game\x2C pn);\n    if (!handId) continue;\n    const msgId = pn === 1 ? gate.p1MsgId : gate.p2MsgId;\n    let msgExists = false;\n    if (msgId) {\n      try {\n        const handCh = await fetchGameChannel(client\x2C handId);\n        await handCh.messages.fetch(msgId);\n        msgExists = true;\n      } catch {}\n    }\n    if (!msgExists) {\n      // Re-send gate message with current ready state\n      const handCh = await fetchGameChannel(client\x2C handId);\n      const label = (PHASE_GATE_LABELS[gate.phase] || 'Phase gate active')\n        .replace('{round}'\x2C String(game.currentRound || 1));\n      const isReady = pn === 1 ? gate.p1Ready : gate.p2Ready;\n      const p1s = gate.p1Ready ? 'P1 \u2705' : 'P1 \u23f3';\n      const p2s = gate.p2Ready ? 'P2 \u2705' : 'P2 \u23f3';\n      const row = new ActionRowBuilder().addComponents(\n        new ButtonBuilder().setCustomId(`phase_gate_ready_${gameId}`).setLabel('\u2705 Ready').setStyle(ButtonStyle.Success).setDisabled(isReady)\x2C\n        new ButtonBuilder().setCustomId(`phase_gate_unready_${gameId}`).setLabel('\u274c Not Ready').setStyle(ButtonStyle.Danger).setDisabled(!isReady)\x2C\n      );\n      const newMsg = await handCh.send({\n        content: `\ud83d\udd14 ${label}\\n${p1s} | ${p2s}`\x2C\n        components: [row]\x2C\n      });\n      if (pn === 1) gate.p1MsgId = newMsg.id;\n      else gate.p2MsgId = newMsg.id;\n    }\n  }\n  return 'Re-sent phase gate messages';\n}\n\n// \u2500\u2500\u2500 Step 14: Recover pendingCcConfirmation \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function recoverPendingCcConfirmation(game\x2C gameId\x2C ctx) {\n  if (game.phase !== 'round_active') return null;\n  const { client } = ctx;\n  const pending = game.pendingCcConfirmation;\n  if (!pending) return null;\n\n  const { playerNum\x2C card\x2C ts } = pending;\n\n  // Check 10-minute TTL \u2014 if expired\x2C clear state instead of re-sending stale buttons\n  const CONFIRM_TTL_MS = 10 * 60 * 1000;\n  if (ts && Date.now() - ts > CONFIRM_TTL_MS) {\n    delete game.pendingCcConfirmation;\n    console.log(`[recover] Cleared expired pendingCcConfirmation (card=${card}\x2C age=${Math.round((Date.now() - ts) / 60000)}m)`);\n    return 'Cleared expired CC confirmation (TTL exceeded)';\n  }\n\n  const handId = getHandChannelId(game\x2C playerNum);\n  if (!handId) return null;\n\n  const handCh = await fetchGameChannel(client\x2C handId);\n  if (!handCh) return null;\n\n  const row = new ActionRowBuilder().addComponents(\n    new ButtonBuilder().setCustomId(`cc_confirm_play_${gameId}`).setLabel('PLAY CARD').setStyle(ButtonStyle.Success)\x2C\n    new ButtonBuilder().setCustomId(`cc_cancel_play_${gameId}`).setLabel('DO SOMETHING ELSE').setStyle(ButtonStyle.Danger)\x2C\n  );\n  await handCh.send({\n    content: `**[Recover]** Play **${card}**?`\x2C\n    components: [row]\x2C\n  }).catch(discordCatch);\n  return `Re-sent CC confirmation for P${playerNum}: ${card} [hand]`;\n}\n\n// \u2500\u2500\u2500 Step 15: Recover pendingCelebration \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function recoverPendingCelebration(game\x2C gameId\x2C ctx) {\n  if (game.phase !== 'round_active') return null;\n  const { client } = ctx;\n  const pending = game.pendingCelebration;\n  if (!pending) return null;\n\n  const { attackerPlayerNum\x2C combatThreadId } = pending;\n  const ownerId = getPlayerId(game\x2C attackerPlayerNum);\n\n  // Try combat thread first (where it was originally sent)\n  let targetCh = null;\n  if (combatThreadId) {\n    try {\n      targetCh = await fetchCombatThread(client\x2C combatThreadId);\n    } catch { /* thread gone */ }\n  }\n  // Fall back to general channel\n  if (!targetCh && game.generalId) {\n    targetCh = await fetchGameChannel(client\x2C game.generalId);\n  }\n  if (!targetCh) return null;\n\n  // Import getCelebrationButtons from components\n  const { getCelebrationButtons } = await import('../discord/components.js');\n  await targetCh.send({\n    content: `**[Recover]** <@${ownerId}> \u2014 You defeated a unique figure. Play **Celebration** to gain 4 VP?`\x2C\n    components: [getCelebrationButtons(gameId)]\x2C\n    allowedMentions: { users: [ownerId] }\x2C\n  }).catch(discordCatch);\n  return `Re-sent Celebration prompt for P${attackerPlayerNum}`;\n}\n\n// \u2500\u2500\u2500 Step 16: Recover pendingPowerTokenGrant \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function recoverPendingPowerTokenGrant(game\x2C gameId\x2C ctx) {\n  if (game.phase !== 'round_active') return null;\n  const { client } = ctx;\n  const pending = game.pendingPowerTokenGrant;\n  if (!pending || !pending.grants || pending.grants.length === 0) return null;\n\n  const { grants\x2C channelId\x2C playerNum } = pending;\n  const ownerId = getPlayerId(game\x2C playerNum);\n\n  // Use stored channelId if available\x2C otherwise fall back to general\n  let targetCh = null;\n  if (channelId) {\n    try {\n      targetCh = await fetchGameChannel(client\x2C channelId);\n    } catch { /* channel gone */ }\n  }\n  if (!targetCh && game.generalId) {\n    targetCh = await fetchGameChannel(client\x2C game.generalId);\n  }\n  if (!targetCh) return null;\n\n  const totalCount = grants.reduce((sum\x2C g) => sum + g.count\x2C 0);\n  const figNames = [...new Set(grants.map(g => g.figName))].join('\x2C ');\n  const countLabel = totalCount > 1 ? `${totalCount} tokens` : '1 token';\n  const btns = ['Damage'\x2C 'Surge'\x2C 'Block'\x2C 'Evade'].map(t =>\n    new ButtonBuilder()\n      .setCustomId(`power_token_choice_${gameId}_${t.toLowerCase()}`)\n      .setLabel(t)\n      .setStyle(ButtonStyle.Secondary)\n  );\n  await targetCh.send({\n    content: `**[Recover]** <@${ownerId}> \u2014 **Choose power token type** for **${figNames}** (${countLabel}):`\x2C\n    components: [new ActionRowBuilder().addComponents(btns)]\x2C\n    allowedMentions: { users: [ownerId] }\x2C\n  }).catch(discordCatch);\n  return `Re-sent power token choice for P${playerNum}: ${figNames}`;\n}\n\n// \u2500\u2500\u2500 Generic fallback: build buttons from available-actions \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * When no specific recovery handler found anything\x2C but available-actions says\n * players have legal actions\x2C build generic button prompts from those actions.\n * This covers ~30 pending sub-states (pendingCoverFire\x2C pendingCcConfirmation\x2C\n * pendingStrainChoice\x2C etc.) without needing a specific handler for each.\n *\n * @param {object} game\n * @param {string} gameId\n * @param {object} ctx\n * @param {Array<{ playerNum: number\x2C playerId: string\x2C actions: object[]\x2C description: string }>} actionsDiag\n * @returns {string[]|null}\n */\n/**\n * Determine whether this player's recovery prompt should go to their hand\n * channel (true) or the general channel (false).\n */\nfunction shouldRouteToHand(game\x2C playerNum) {\n  // Check CC pending states that are owned by this player\n  if (game.pendingCcConfirmation && game.pendingCcConfirmation.playerNum === playerNum) return true;\n  if (game.pendingCcChoice && game.pendingCcChoice.playerNum === playerNum) return true;\n  if (game.pendingCcSpaceChoice && game.pendingCcSpaceChoice.playerNum === playerNum) return true;\n  return false;\n}\n\nasync function recoverFromAvailableActions(game\x2C gameId\x2C ctx\x2C actionsDiag) {\n  const { client } = ctx;\n  if (!actionsDiag || actionsDiag.length === 0) return null;\n  if (!game.generalId) return null;\n\n  const generalCh = await fetchGameChannel(client\x2C game.generalId);\n  if (!generalCh) return null;\n\n  const results = [];\n  for (const diag of actionsDiag) {\n    const { playerNum\x2C playerId\x2C actions\x2C description } = diag;\n    if (!actions || actions.length === 0) continue;\n\n    // Build buttons from actions (cap at 25 = 5 rows \xd7 5)\n    const btns = [];\n    for (const action of actions.slice(0\x2C 25)) {\n      if (!action.customId) continue;\n      // Use description as label\x2C truncate to Discord's 80 char limit\n      const label = (action.description || action.type || 'Action').slice(0\x2C 80);\n      btns.push(\n        new ButtonBuilder()\n          .setCustomId(action.customId)\n          .setLabel(label)\n          .setStyle(ButtonStyle.Primary)\n      );\n    }\n    if (btns.length === 0) continue;\n\n    const rows = chunkButtonsToRows(btns);\n\n    // Route CC-related states to hand channel; everything else to general\n    const useHand = shouldRouteToHand(game\x2C playerNum);\n    let targetCh = generalCh;\n    let channelNote = '';\n    if (useHand) {\n      const handId = getHandChannelId(game\x2C playerNum);\n      if (handId) {\n        const handCh = await fetchGameChannel(client\x2C handId);\n        if (handCh) {\n          targetCh = handCh;\n          channelNote = ' [hand]';\n        }\n      }\n    }\n\n    await targetCh.send({\n      content: `**[Recover]** <@${playerId}> (**Player ${playerNum}**) \u2014 ${description}:`\x2C\n      components: rows\x2C\n      allowedMentions: { users: [playerId] }\x2C\n    }).catch(discordCatch);\n    results.push(`Generic recovery for P${playerNum}: ${description}${channelNote}`);\n  }\n  return results.length > 0 ? results : null;\n}\n
