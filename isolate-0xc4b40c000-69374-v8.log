code-creation,Script,9,82462,0x7c987260570,52, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/lobby.js:1:1,0x78fd2b26300,~
script-source,92,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/lobby.js,/**\n * Lobby handlers: lobby_join_\x2C lobby_start_.\n * Dependencies passed via context from index (no import from index).\n */\nimport { COLORS } from '../discord/colors.js';\nimport { CURRENT_GAME_VERSION } from '../game-state.js';\nimport { PHASES } from '../game/phase.js';\nimport { parseCustomId } from '../discord/custom-id.js';\nimport { snowflakeUsers } from '../discord/channel-helpers.js';\n\n/**\n * Handle Join Game button in a lobby post.\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C setGame\x2C lobbies\x2C countActiveGamesForPlayer\x2C MAX_ACTIVE_GAMES_PER_PLAYER\x2C getLobbyEmbed\x2C getLobbyStartButton\x2C updateThreadName\n */\nexport async function handleLobbyJoin(interaction\x2C ctx) {\n  const {\n    lobbies\x2C\n    countActiveGamesForPlayer\x2C\n    MAX_ACTIVE_GAMES_PER_PLAYER\x2C\n    getLobbyEmbed\x2C\n    getLobbyStartButton\x2C\n    updateThreadName\x2C\n  } = ctx;\n  const threadId = parseCustomId(interaction.customId\x2C 'lobby_join_');\n  const lobby = lobbies.get(threadId);\n  if (!lobby) {\n    await interaction.followUp({ content: 'This lobby could not be found. If the bot was recently restarted\x2C try again in a moment \u2014 lobbies are restored automatically. Otherwise\x2C please create a new game in **#new-games**.'\x2C ephemeral: true });\n    return;\n  }\n  if (lobby.joinedId) {\n    await interaction.followUp({ content: 'This game already has two players.'\x2C ephemeral: true });\n    return;\n  }\n  const joinerId = interaction.user.id;\n  if (joinerId !== lobby.creatorId && countActiveGamesForPlayer(joinerId) >= MAX_ACTIVE_GAMES_PER_PLAYER) {\n    await interaction.followUp({\n      content: `You are already in **${MAX_ACTIVE_GAMES_PER_PLAYER}** active games. Finish or leave a game before joining another.`\x2C\n      ephemeral: true\x2C\n    });\n    return;\n  }\n  if (interaction.user.id === lobby.creatorId) {\n    lobby.joinedId = interaction.user.id;\n    lobby.status = 'Full';\n    await interaction.editReply({\n      embeds: [getLobbyEmbed(lobby)]\x2C\n      components: [getLobbyStartButton(threadId)]\x2C\n    });\n    await updateThreadName(interaction.channel\x2C lobby);\n    await interaction.followUp({ content: '*(Testing: you joined as Player 2. Use a second account for real games.)*'\x2C ephemeral: true });\n    return;\n  }\n  lobby.joinedId = interaction.user.id;\n  lobby.status = 'Full';\n  await interaction.editReply({\n    embeds: [getLobbyEmbed(lobby)]\x2C\n    components: [getLobbyStartButton(threadId)]\x2C\n  });\n  await updateThreadName(interaction.channel\x2C lobby);\n}\n\n/**\n * Handle Start Game button in a lobby post.\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - setGame\x2C saveGames\x2C lobbies\x2C countActiveGamesForPlayer\x2C MAX_ACTIVE_GAMES_PER_PLAYER\x2C createGameChannels\x2C getGeneralSetupButtons\x2C logGameErrorToBotLogs\x2C updateThreadName\x2C EmbedBuilder\n */\nexport async function handleLobbyStart(interaction\x2C ctx) {\n  const {\n    setGame\x2C\n    saveGames\x2C\n    lobbies\x2C\n    countActiveGamesForPlayer\x2C\n    MAX_ACTIVE_GAMES_PER_PLAYER\x2C\n    createGameChannels\x2C\n    getGeneralSetupButtons\x2C\n    logGameErrorToBotLogs\x2C\n    updateThreadName\x2C\n    EmbedBuilder\x2C\n  } = ctx;\n  const threadId = parseCustomId(interaction.customId\x2C 'lobby_start_');\n  const lobby = lobbies.get(threadId);\n  if (!lobby || !lobby.joinedId) {\n    await interaction.followUp({ content: 'Both players must join before starting. Player 2 has not joined yet.'\x2C ephemeral: true });\n    return;\n  }\n  if (lobby.status === 'Launched') {\n    await interaction.followUp({ content: 'This game is already being created. Please wait.'\x2C ephemeral: true });\n    return;\n  }\n  if (interaction.user.id !== lobby.creatorId && interaction.user.id !== lobby.joinedId) {\n    await interaction.followUp({ content: 'Only players in this game can start it.'\x2C ephemeral: true });\n    return;\n  }\n  const c1 = countActiveGamesForPlayer(lobby.creatorId);\n  const c2 = countActiveGamesForPlayer(lobby.joinedId);\n  if (c1 >= MAX_ACTIVE_GAMES_PER_PLAYER || c2 >= MAX_ACTIVE_GAMES_PER_PLAYER) {\n    const who = [];\n    if (c1 >= MAX_ACTIVE_GAMES_PER_PLAYER) who.push('<@' + lobby.creatorId + '>');\n    if (c2 >= MAX_ACTIVE_GAMES_PER_PLAYER) who.push('<@' + lobby.joinedId + '>');\n    await interaction.followUp({\n      content: `${who.join(' and ')} ${who.length > 1 ? 'are' : 'is'} already in **${MAX_ACTIVE_GAMES_PER_PLAYER}** active games. Finish or leave a game before starting another.`\x2C\n      ephemeral: true\x2C\n      allowedMentions: { users: [lobby.creatorId\x2C lobby.joinedId] }\x2C\n    });\n    return;\n  }\n  lobby.status = 'Launched';\n\n  // Remove Start button immediately to prevent double-clicks\n  await interaction.message?.edit({ components: [] }).catch(() => {});\n\n  await interaction.followUp({ content: 'Creating your game channels...'\x2C ephemeral: true });\n  let gameId;\n  try {\n    const guild = interaction.guild;\n    const { gameId: gid\x2C generalChannel\x2C chatChannel } =\n      await createGameChannels(guild\x2C lobby.creatorId\x2C lobby.joinedId);\n    gameId = gid;\n    const game = {\n      gameId\x2C\n      version: CURRENT_GAME_VERSION\x2C\n      gameCategoryId: generalChannel.parentId\x2C\n      player1Id: lobby.creatorId\x2C\n      player2Id: lobby.joinedId\x2C\n      generalId: generalChannel.id\x2C\n      chatId: chatChannel?.id || null\x2C\n      boardId: null\x2C\n      p1HandId: null\x2C\n      p2HandId: null\x2C\n      p1PlayAreaId: null\x2C\n      p2PlayAreaId: null\x2C\n      player1Squad: null\x2C\n      player2Squad: null\x2C\n      player1VP: { total: 0\x2C kills: 0\x2C objectives: 0 }\x2C\n      player2VP: { total: 0\x2C kills: 0\x2C objectives: 0 }\x2C\n      phase: PHASES.MAP_SELECTION\x2C\n      ended: false\x2C\n    };\n\n    setGame(gameId\x2C game);\n\n    const setupMsg = await generalChannel.send({\n      content: `<@${game.player1Id}> <@${game.player2Id}>`\x2C\n      allowedMentions: { users: snowflakeUsers([...new Set([game.player1Id\x2C game.player2Id])]) }\x2C\n      embeds: [\n        new EmbedBuilder()\n          .setTitle('Game Setup')\n          .setDescription('Select your **map and mission** below to begin. Once confirmed\x2C Play Areas and **Your Hand** threads will appear for squad selection.')\n          .setColor(COLORS.DARK_EMBED)\x2C\n      ]\x2C\n      components: [getGeneralSetupButtons(game)]\x2C\n    });\n    game.generalSetupMessageId = setupMsg.id;\n    saveGames();\n    await interaction.followUp({\n      content: `Game **IA Game #${gameId}** is ready! Head to <#${generalChannel.id}> to select your map.`\x2C\n      ephemeral: true\x2C\n    });\n    await updateThreadName(interaction.channel\x2C lobby);\n    await interaction.channel.setArchived(true);\n  } catch (err) {\n    console.error('Failed to create game channels:'\x2C err);\n    await logGameErrorToBotLogs(interaction.client\x2C interaction.guild\x2C gameId\x2C err\x2C 'create_game_channels');\n    await interaction.followUp({\n      content: `Failed to create game: ${err.message}. Ensure the bot has **Manage Channels** permission.`\x2C\n      ephemeral: true\x2C\n    });\n  }\n}\n
