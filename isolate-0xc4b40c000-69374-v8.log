egister('interact_cancel_'\x2C handleInteractCancel\x2C 'interactCancel');\nregister('interact_choice_'\x2C handleInteractChoice\x2C 'interact');\n\n// --- Round ---\nregister('end_end_of_round_'\x2C handleEndEndOfRound\x2C 'round');\nregister('end_start_of_round_'\x2C handleEndStartOfRound\x2C 'startOfRound');\nregister('sor_mission_reveal_'\x2C handleSorMissionReveal\x2C 'round');\nregister('extra_armor_pick_'\x2C handleExtraArmorPick\x2C 'round');\nregister('extra_armor_confirm_'\x2C handleExtraArmorConfirm\x2C 'round');\nregister('extra_armor_cancel_'\x2C handleExtraArmorCancel\x2C 'round');\nregister('rbf_discard_'\x2C handleRbfDiscard\x2C 'round');\nregister('rogue_one_return_'\x2C handleRogueOneReturn\x2C 'round');\nregister('ctf_pick_'\x2C handleCtfPick\x2C 'round');\nregister('ctf_strain_'\x2C handleCtfStrain\x2C 'round');\nregister('imp_citadel_'\x2C handleImpCitadel\x2C 'round');\nregister('prog_override_'\x2C handleProgrammingOverride\x2C 'round');\nregister('doubt_fig_'\x2C handleDoubtFigPick\x2C 'round');\nregister('doubt_remove_'\x2C handleDoubtRemove\x2C 'round');\n\n// --- Post-deploy ---\nregister('pd_pick_'\x2C handlePostDeployPick\x2C 'postDeploy');\nregister('pd_security_pick_'\x2C handleSecurityDetailPick\x2C 'postDeploy');\nregister('pd_strike_adj_'\x2C handleStrikeTeamAdjPick\x2C 'postDeploy');\nregister('pd_strike_order_'\x2C handleStrikeTeamOrderPick\x2C 'postDeploy');\nregister('pd_strike_token_done_'\x2C handleStrikeTeamTokenDone\x2C 'postDeploy');\nregister('pd_strike_token_'\x2C handleStrikeTeamTokenPick\x2C 'postDeploy');\nregister('pd_move_skip_'\x2C handlePostDeployMoveSkip\x2C 'postDeploy');\nregister('pd_move_stay_'\x2C handlePostDeployMoveStay\x2C 'postDeploy');\nregister('pd_sl_pick_'\x2C handleSmoothLandingPick\x2C 'postDeploy');\nregister('pd_walker_move_'\x2C handleWalkerMove\x2C 'postDeploy');\nregister('pd_walker_skip_'\x2C handleWalkerSkip\x2C 'postDeploy');\nregister('pd_arms_dist_fig_'\x2C handleArmsDistFigPick\x2C 'postD