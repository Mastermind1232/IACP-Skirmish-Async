HttpAgent } = require('_http_agent');\nconst {\n  httpServerPreClose\x2C\n  Server: HttpServer\x2C\n  setupConnectionsTracking\x2C\n  storeHTTPOptions\x2C\n  _connectionListener\x2C\n} = require('_http_server');\nconst { ClientRequest } = require('_http_client');\nlet debug = require('internal/util/debuglog').debuglog('https'\x2C (fn) => {\n  debug = fn;\n});\nconst net = require('net');\nconst { URL\x2C urlToHttpOptions\x2C isURL } = require('internal/url');\nconst { validateObject } = require('internal/validators');\nconst { isIP } = require('internal/net');\nconst assert = require('internal/assert');\nconst { getOptionValue } = require('internal/options');\n\nfunction Server(opts\x2C requestListener) {\n  if (!(this instanceof Server)) return new Server(opts\x2C requestListener);\n\n  let ALPNProtocols = ['http/1.1'];\n  if (typeof opts === 'function') {\n    requestListener = opts;\n    opts = kEmptyObject;\n  } else if (opts == null) {\n    opts = kEmptyObject;\n  } else {\n    validateObject(opts\x2C 'options');\n    // Only one of ALPNProtocols and ALPNCallback can be set\x2C so make sure we\n    // only set a default ALPNProtocols if the caller has not set either of them\n    if (opts.ALPNProtocols || opts.ALPNCallback)\n      ALPNProtocols = undefined;\n  }\n\n  FunctionPrototypeCall(storeHTTPOptions\x2C this\x2C opts);\n  FunctionPrototypeCall(tls.Server\x2C this\x2C\n                        {\n                          noDelay: true\x2C\n                          ALPNProtocols\x2C\n                          ...opts\x2C\n                        }\x2C\n                        _connectionListener);\n\n  this.httpAllowHalfOpen = false;\n\n  if (requestListener) {\n    this.addListener('request'\x2C requestListener);\n  }\n\n  this.addListener('tlsClientError'\x2C function addListener(err\x2C conn) {\n    if (!this.emit('clientError'\x2C err\x2C conn))\n      conn.destroy(err);\n  });\n\n  this.timeout = 0;\n  this.maxHeadersCount = null;\n  this.on('listening'\x2C setupConnectionsTracking);\n}\n\nObjectSetPrototypeOf(Server.prototype\x2C tls.Server.prototype);\nObjectSetPrototypeOf(Server\x2C tls.Server);\n\nServer.prototype.closeAllConnections = HttpServer.prototype.closeAllConnections;\n\nServer.prototype.closeIdleConnections = HttpServer.prototype.closeIdleConnections;\n\nServer.prototype.setTimeout = HttpServer.prototype.setTimeout;\n\nServer.prototype.close = function close() {\n  httpServerPreClose(this);\n  ReflectApply(tls.Server.prototype.close\x2C this\x2C arguments);\n  return this;\n};\n\nServer.prototype[SymbolAsyncDispose] = async function() {\n  await FunctionPrototypeCall(promisify(this.close)\x2C this);\n};\n\n/**\n * Creates a new `https.Server` instance.\n * @param {{\n *   IncomingMessage?: IncomingMessage;\n *   ServerResponse?: ServerResponse;\n *   insecureHTTPParser?: boolean;\n *   maxHeaderSize?: number;\n *   }} [opts]\n * @param {Function} [requestListener]\n * @returns {Server}\n */\nfunction createServer(opts\x2C requestListener) {\n  return new Server(opts\x2C requestListener);\n}\n\n// When proxying a HTTPS request\x2C the following needs to be done:\n// https://datatracker.ietf.org/doc/html/rfc9110#CONNECT\n// 1. Send a CONNECT request to the proxy server.\n// 2. Wait for 200 connection established response to establish the tunnel.\n// 3. Perform TLS handshake with the endpoint over the socket.\n// 4. Tunnel the request using the established connection.\n//\n// This function computes the tunnel configuration for HTTPS requests.\n// The handling of the tunnel connection is done in createConnection.\nfunction getTunnelConfigForProxiedHttps(agent\x2C reqOptions) {\n  if (!agent[kProxyConfig]) {\n    return null;\n  }\n  if ((reqOptions.protocol || agent.protocol) !== 'https:') {\n    return null;\n  }\n  const shouldUseProxy = checkShouldUseProxy(agent[kProxyConfig]\x2C reqOptions);\n  debug(`getTunnelConfigForProxiedHttps should use proxy for ${reqOptions.host}:${reqOptions.port}:`\x2C shouldUseProxy);\n  if (!shouldUseProxy) {\n    return null;\n  }\n  const { auth\x2C href } = agent[kProxyConfig];\n  // The request is a HTTPS request\x2C assemble the payload for establishing the tunnel.\n  const ipType = isIP(reqOptions.host);\n  // The request target must put IPv6 address in square brackets.\n  // Here reqOptions is already processed by urlToHttpOptions so we'll add them back if necessary.\n  // See https://www.rfc-editor.org/rfc/rfc3986#section-3.2.2\n  const requestHost = ipType === 6 ? `[${reqOptions.host}]` : reqOptions.host;\n  const requestPort = reqOptions.port || agent.defaultPort;\n  const endpoint = `${requestHost}:${requestPort}`;\n  // The ClientRequest constructor should already have validated the host and the port.\n  // When the request options come from a string invalid characters would be stripped away\x2C\n  // when it's an object ERR_INVALID_CHAR would be thrown. Here we just assert in case\n  // agent.createConnection() is called with invalid options.\n  assert(!endpoint.includes('\\r'));\n  assert(!endpoint.includes('\\n'));\n\n  let payload = `CONNECT ${endpoint} HTTP/1.1\\r\\n`;\n  // The parseProxyConfigFromEnv() method should have already validated the authorization header\n  // value.\n  if (auth) {\n    payload += `proxy-authorization: ${auth}\\r\\n`;\n  }\n  if (agent.keepAlive || agent.maxSockets !== Infinity) {\n    payload += 'proxy-connection: keep-alive\\r\\n';\n  }\n  payload += `host: ${endpoint}`;\n  payload += '\\r\\n\\r\\n';\n\n  const result = {\n    __proto__: null\x2C\n    proxyTunnelPayload: payload\x2C\n    requestOptions: {  // Options used for the request sent after the tunnel is established.\n      __proto__: null\x2C\n      servername: reqOptions.servername || ipType ? undefined : reqOptions.host\x2C\n      ...reqOptions\x2C\n    }\x2C\n  };\n  debug(`updated request for HTTPS proxy ${href} with`\x2C result);\n  return result;\n};\n\nfunction establishTunnel(agent\x2C socket\x2C options\x2C tunnelConfig\x2C afterSocket) {\n  const { proxyTunnelPayload } = tunnelConfig;\n  // By default\x2C the socket is in paused mode. Read to look for the 200\n  // connection established response.\n  function read() {\n    let chunk;\n    while ((chunk = socket.read()) !== null) {\n      if (onProxyData(chunk) !== -1) {\n        break;\n      }\n    }\n    socket.on('readable'\x2C read);\n  }\n\n  function cleanup() {\n    socket.removeListener('end'\x2C onProxyEnd);\n    socket.removeListener('error'\x2C onProxyError);\n    socket.removeListener('readable'\x2C read);\n    socket.setTimeout(0);  // Clear the timeout for the tunnel establishment.\n  }\n\n  function onProxyError(err) {\n    debug('onProxyError'\x2C err);\n    cleanup();\n    afterSocket(err\x2C socket);\n  }\n\n  // Read the headers from the chunks and check for the status code. If it fails we\n  // clean up the socket and return an error. Otherwise we establish the tunnel.\n  let buffer = '';\n  function onProxyData(chunk) {\n    const str = chunk.toString();\n    debug('onProxyData'\x2C str);\n    buffer += str;\n    const headerEndIndex = buffer.indexOf('\\r\\n\\r\\n');\n    if (headerEndIndex === -1) return headerEndIndex;\n    const statusLine = buffer.substring(0\x2C buffer.indexOf('\\r\\n'));\n    const statusCode = statusLine.split(' ')[1];\n    if (statusCode !== '200') {\n      debug(`onProxyData receives ${statusCode}\x2C cleaning up`);\n      cleanup();\n      const targetHost = proxyTunnelPayload.split('\\r')[0].split(' ')[1];\n      const message = `Failed to establish tunnel to ${targetHost} via ${agent[kProxyConfig].href}: ${statusLine}`;\n      const err = new ERR_PROXY_TUNNEL(message);\n      err.statusCode = NumberParseInt(statusCode);\n      afterSocket(err\x2C socket);\n    } else {\n      // https://datatracker.ietf.org/doc/html/rfc9110#CONNECT\n      // RFC 9110 says that it can be 2xx but in the real world\x2C proxy clients generally only\n      // accepts 200.\n      // Proxy servers are not supposed to send anything after the headers - the payload must be\n      // be empty. So after this point we will proceed with the tunnel e.g. starting TLS handshake.\n      debug('onProxyData receives 200\x2C establishing tunnel');\n      cleanup();\n\n      // Reuse the tunneled socket to perform the TLS handshake with the endpoint\x2C\n      // then send the request.\n      const { requestOptions } = tunnelConfig;\n      tunnelConfig.requestOptions = null;\n      requestOptions.socket = socket;\n      let tunneldSocket;\n      const onTLSHandshakeError = (err) => {\n        debug('Propagate error event from tunneled socket to tunnel socket');\n        afterSocket(err\x2C tunneldSocket);\n      };\n      tunneldSocket = tls.connect(requestOptions\x2C () => {\n        debug('TLS handshake over tunnel succeeded');\n        tunneldSocket.removeListener('error'\x2C onTLSHandshakeError);\n        afterSocket(null\x2C tunneldSocket);\n      });\n      tunneldSocket.on('free'\x2C () => {\n        debug('Propagate free event from tunneled socket to tunnel socket');\n        socket.emit('free');\n      });\n      tunneldSocket.on('error'\x2C onTLSHandshakeError);\n    }\n    return headerEndIndex;\n  }\n\n  function onProxyEnd() {\n    cleanup();\n    const err = new ERR_PROXY_TUNNEL('Connection to establish proxy tunnel ended unexpectedly');\n    afterSocket(err\x2C socket);\n  }\n\n  const proxyTunnelTimeout = tunnelConfig.requestOptions.timeout;\n  debug('proxyTunnelTimeout'\x2C proxyTunnelTimeout\x2C options.timeout);\n  // It may be worth a separate timeout error/event.\n  // But it also makes sense to treat the tunnel establishment timeout as\n  // a normal timeout for the request.\n  function onProxyTimeout() {\n    debug('onProxyTimeout'\x2C proxyTunnelTimeout);\n    cleanup();\n    const err = new ERR_PROXY_TUNNEL(`Connection to establish proxy tunnel timed out after ${proxyTunnelTimeout}ms`);\n    err.proxyTunnelTimeout = proxyTunnelTimeout;\n    afterSocket(err\x2C socket);\n  }\n\n  if (proxyTunnelTimeout && proxyTunnelTimeout > 0) {\n    debug('proxy tunnel setTimeout'\x2C proxyTunnelTimeout);\n    socket.setTimeout(proxyTunnelTimeout\x2C onProxyTimeout);\n  }\n\n  socket.on('error'\x2C onProxyError);\n  socket.on('end'\x2C onProxyEnd);\n  socket.write(proxyTunnelPayload);\n\n  read();\n}\n\n// HTTPS agents.\n// See ProxyConfig in internal/http.js for how the connection should be handled\n// when the agent is configured to use a proxy server.\nfunction createConnection(...args) {\n  // XXX: This signature (port\x2C host\x2C options) is different from all the other\n  // createConnection() methods.\n  let options\x2C cb;\n  if (args[0] !== null && typeof args[0] === 'object') {\n    options = args[0];\n  } else if (args[1] !== null && typeof args[1] === 'object') {\n    options = { ...args[1] };\n  } else if (args[2] === null || typeof args[2] !== 'object') {\n    options = {};\n  } else {\n    options = { ...args[2] };\n  }\n  if (typeof args[0] === 'number') {\n    options.port = args[0];\n  }\n  if (typeof args[1] === 'string') {\n    options.host = args[1];\n  }\n  if (typeof args[args.length - 1] === 'function') {\n    cb = args[args.length - 1];\n  }\n\n  debug('createConnection'\x2C options);\n\n  if (options._agentKey) {\n    const session = this._getSession(options._agentKey);\n    if (session) {\n      debug('reuse session for %j'\x2C options._agentKey);\n      options = {\n        session\x2C\n        ...options\x2C\n      };\n    }\n  }\n\n  let socket;\n  const tunnelConfig = getTunnelConfigForProxiedHttps(this\x2C options);\n  debug(`https createConnection should use proxy for ${options.host}:${options.port}:`\x2C tunnelConfig);\n\n  if (!tunnelConfig) {\n    socket = tls.connect(options);\n  } else {\n    const connectOptions = {\n      ...this[kProxyConfig].proxyConnectionOptions\x2C\n    };\n    debug('Create proxy socket'\x2C connectOptions);\n    const onError = (err) => {\n      cleanupAndPropagate