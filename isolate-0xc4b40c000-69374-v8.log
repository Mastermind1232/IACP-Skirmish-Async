script-source,424,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/undici/lib/web/fileapi/progressevent.js,'use strict'\n\nconst { webidl } = require('../fetch/webidl')\n\nconst kState = Symbol('ProgressEvent state')\n\n/**\n * @see https://xhr.spec.whatwg.org/#progressevent\n */\nclass ProgressEvent extends Event {\n  constructor (type\x2C eventInitDict = {}) {\n    type = webidl.converters.DOMString(type\x2C 'ProgressEvent constructor'\x2C 'type')\n    eventInitDict = webidl.converters.ProgressEventInit(eventInitDict ?? {})\n\n    super(type\x2C eventInitDict)\n\n    this[kState] = {\n      lengthComputable: eventInitDict.lengthComputable\x2C\n      loaded: eventInitDict.loaded\x2C\n      total: eventInitDict.total\n    }\n  }\n\n  get lengthComputable () {\n    webidl.brandCheck(this\x2C ProgressEvent)\n\n    return this[kState].lengthComputable\n  }\n\n  get loaded () {\n    webidl.brandCheck(this\x2C ProgressEvent)\n\n    return this[kState].loaded\n  }\n\n  get total () {\n    webidl.brandCheck(this\x2C ProgressEvent)\n\n    return this[kState].total\n  }\n}\n\nwebidl.converters.ProgressEventInit = webidl.dictionaryConverter([\n  {\n    key: 'lengthComputable'\x2C\n    converter: webidl.converters.boolean\x2C\n    defaultValue: () => false\n  }\x2C\n  {\n    key: 'loaded'\x2C\n    converter: webidl.converters['unsigned long long']\x2C\n    defaultValue: () => 0\n  }\x2C\n  {\n    key: 'total'\x2C\n    converter: webidl.converters['unsigned long long']\x2C\n    defaultValue: () => 0\n  }\x2C\n  {\n    key: 'bubbles'\x2C\n    converter: webidl.converters.boolean\x2C\n    defaultValue: () => false\n  }\x2C\n  {\n    key: 'cancelable'\x2C\n    converter: webidl.converters.boolean\x2C\n    defaultValue: () => false\n  }\x2C\n  {\n    key: 'composed'\x2C\n    converter: webidl.converters.boolean\x2C\n    defaultValue: () => false\n  }\n])\n\nmodule.exports = {\n  ProgressEvent\n}\n
