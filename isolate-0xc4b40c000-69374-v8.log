 'importKey');\n      } catch {\n        return false;\n      }\n\n      switch (normalizedAdditionalAlgorithm.name) {\n        case 'AES-OCB':\n        case 'AES-KW':\n        case 'AES-GCM':\n        case 'AES-CTR':\n        case 'AES-CBC':\n        case 'ChaCha20-Poly1305':\n        case 'HKDF':\n        case 'PBKDF2':\n        case 'Argon2i':\n        case 'Argon2d':\n        case 'Argon2id':\n          break;\n        case 'HMAC':\n        case 'KMAC128':\n        case 'KMAC256':\n          if (normalizedAdditionalAlgorithm.length === undefined || normalizedAdditionalAlgorithm.length === 256) {\n            break;\n          }\n          return false;\n        default:\n          return false;\n      }\n    }\n\n    return check(operation\x2C algorithm\x2C length);\n  }\n}\n\nfunction check(op\x2C alg\x2C length) {\n  if (op === 'encapsulateBits' || op === 'encapsulateKey') {\n    op = 'encapsulate';\n  }\n\n  if (op === 'decapsulateBits' || op === 'decapsulateKey') {\n    op = 'decapsulate';\n  }\n\n  let normalizedAlgorithm;\n  try {\n    normalizedAlgorithm = normalizeAlgorithm(alg\x2C op);\n  } catch {\n    if (op === 'wrapKey') {\n      return check('encrypt'\x2C alg);\n    }\n\n    if (op === 'unwrapKey') {\n      return check('decrypt'\x2C alg);\n    }\n\n    return false;\n  }\n\n  switch (op) {\n    case 'decapsulate':\n    case 'decrypt':\n    case 'digest':\n    case 'encapsulate':\n    case 'encrypt':\n    case 'exportKey':\n    case 'importKey':\n    case 'sign':\n    case 'unwrapKey':\n    case 'verify':\n    case 'wrapKey':\n      return true;\n    case 'deriveBits': {\n      if (normalizedAlgorithm.name === 'HKDF') {\n        try {\n          require('internal/crypto/hkdf').validateHkdfDeriveBitsLength(length);\n        } catch {\n          return false;\n        }\n      }\n\n      if (normalizedAlgorithm.name === 'PBKDF2') {\n        try {\n          require('internal/crypto/pbkdf2').validatePbkdf2DeriveBitsLength(length);\n        } catch {\n          return false;\n        }\n      }\n\n      if (StringPrototypeStartsWith(normalizedAlgorithm.name\x2C 'Argon2')) {\n        try {\n          require('internal/crypto/argon2').validateArgon2DeriveBitsLength(length);\n        } catch {\n          return false;\n        }\n      }\n\n      return true;\n    }\n    case 'generateKey': {\n      if (\n        normalizedAlgorithm.name === 'HMAC' &&\n        normalizedAlgorithm.length === undefined &&\n        StringPrototypeStartsWith(normalizedAlgorithm.hash.name\x2C 'SHA3-')\n      ) {\n        return false;\n      }\n\n      return true;\n    }\n    default: {\n      const assert = require('internal/assert');\n      assert.fail('Unreachable code');\n    }\n  }\n}\n\nconst subtle = ReflectConstruct(function() {}\x2C []\x2C SubtleCrypto);\n\nclass Crypto {\n  constructor() {\n    throw new ERR_ILLEGAL_CONSTRUCTOR();\n  }\n\n  get subtle() {\n    if (this !== crypto) throw new ERR_INVALID_THIS('Crypto');\n    return subtle;\n  }\n}\nconst crypto = ReflectConstruct(function() {}\x2C []\x2C Crypto);\n\nfunction getRandomValues(array) {\n  if (this !== crypto) throw new ERR_INVALID_THIS('Crypto');\n\n  webidl ??= require('internal/crypto/webidl');\n  const prefix = "Failed to execute 'getRandomValues' on 'Crypto'";\n  webidl.requiredArguments(arguments.length\x2C 1\x2C { prefix });\n\n  return ReflectApply(_getRandomValues\x2C this\x2C arguments);\n}\n\nObjectDefineProperties(\n  Crypto.prototype\x2C {\n    [SymbolToStringTag]: {\n      __proto__: null\x2C\n      enumerable: false\x2C\n      configurable: true\x2C\n      writable: false\x2C\n      value: 'Crypto'\x2C\n    }\x2C\n    subtle: kEnumerableProperty\x2C\n    getRandomValues: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: getRandomValues\x2C\n    }\x2C\n    randomUUID: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: randomUUID\x2C\n    }\x2C\n  });\n\nObjectDefineProperties(\n  SubtleCrypto.prototype\x2C {\n    [SymbolToStringTag]: {\n      __proto__: null\x2C\n      enumerable: false\x2C\n      configurable: true\x2C\n      writable: false\x2C\n      value: 'SubtleCrypto'\x2C\n    }\x2C\n    encrypt: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: encrypt\x2C\n    }\x2C\n    decrypt: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: decrypt\x2C\n    }\x2C\n    sign: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: sign\x2C\n    }\x2C\n    verify: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: verify\x2C\n    }\x2C\n    digest: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: digest\x2C\n    }\x2C\n    generateKey: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: generateKey\x2C\n    }\x2C\n    deriveKey: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: deriveKey\x2C\n    }\x2C\n    deriveBits: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: deriveBits\x2C\n    }\x2C\n    importKey: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: importKey\x2C\n    }\x2C\n    exportKey: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: exportKey\x2C\n    }\x2C\n    wrapKey: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: wrapKey\x2C\n    }\x2C\n    unwrapKey: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: unwrapKey\x2C\n    }\x2C\n    getPublicKey: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: getPublicKey\x2C\n    }\x2C\n    encapsulateBits: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: encapsulateBits\x2C\n    }\x2C\n    encapsulateKey: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: encapsulateKey\x2C\n    }\x2C\n    decapsulateBits: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: decapsulateBits\x2C\n    }\x2C\n    decapsulateKey: {\n      __proto__: null\x2C\n      enumerable: true\x2C\n      configurable: true\x2C\n      writable: true\x2C\n      value: decapsulateKey\x2C\n    }\x2C\n  });\n\nmodule.exports = {\n  Crypto\x2C\n  CryptoKey\x2C\n  SubtleCrypto\x2C\n  crypto\x2C\n};\n
