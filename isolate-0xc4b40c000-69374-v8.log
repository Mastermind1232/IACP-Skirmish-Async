code-creation,Script,9,295753,0x3f05b92a0b50,52, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/headless/headless-deps.js:1:1,0x6327002d3c0,~
script-source,249,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/headless/headless-deps.js,/**\n * Headless dependency builder: provides the full allDeps bag\n * using real game logic + fake Discord primitives.\n *\n * Any dep that touches Discord (sends messages\x2C fetches channels) is\n * replaced with a no-op or capture stub. Pure game logic is imported\n * from the real modules.\n */\n\nimport {\n  ActionRowBuilder\x2C\n  ButtonBuilder\x2C\n  ButtonStyle\x2C\n  EmbedBuilder\x2C\n  ThreadAutoArchiveDuration\x2C\n} from 'discord.js';\n\nimport { createFakeClient } from './fake-client.js';\n\n// \u2500\u2500 Pure game logic \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nimport {\n  validateDeckLegal\x2C parseCoord\x2C normalizeCoord\x2C getFootprintCells\x2C\n  getBoardStateForMovement\x2C getMovementProfile\x2C\n  computeMovementCache\x2C getSpacesAtCost\x2C getMovementTarget\x2C\n  getMovementPath\x2C ensureMovementCache\x2C getNormalizedFootprint\x2C\n  initMassiveDisplacement\x2C resolveNextDisplacements\x2C applyDisplacementChoice\x2C\n  resolveMassivePush\x2C rollAttackDice\x2C rollDefenseDice\x2C\n  rollSingleAttackDie\x2C rollSingleDefenseDie\x2C recalcAttackTotals\x2C\n  recalcDefenseTotals\x2C getInnateRerolls\x2C getAttackerSurgeAbilities\x2C\n  parseSurgeEffect\x2C SURGE_LABELS\x2C getAbility\x2C resolveSurgeAbility\x2C\n  getSurgeAbilityLabel\x2C resolveAbility\x2C getPlayableCcFromHand\x2C\n  isCcPlayableNow\x2C isCcPlayLegalByRestriction\x2C filterMapSpacesByBounds\x2C\n  reduceHp\x2C healHp\x2C awardKillVp\x2C awardObjectiveVp\x2C deductVp\x2C\n  getEffectiveSpeed\x2C getLegalInteractOptions\x2C getSpaceController\x2C\n  getFiguresOnOrAdjacentToSpace\x2C countTerminalsControlledByPlayer\x2C\n  isFigureInDeploymentZone\x2C filterCondition\x2C isConditionImmune\x2C\n  HARMFUL_CONDITIONS\x2C applyCondition\x2C\n  getRange\x2C hasLineOfSight\x2C\n  resolveDcName\x2C isFigurelessDc\x2C\n  dcNameFromFigureKey\x2C parseFigureKey\x2C getDcEffect\x2C getEffectiveFigureSize\x2C\n  computeCombatResult\x2C getEffectiveMapSpaces\x2C getFiguresAdjacentToTarget\x2C getFiguresAdjacentToCoord\x2C\n  grantMovementBank\x2C grantPowerTokens\x2C opponentPlayerNum\x2C checkNefariousGains as _checkNefariousGainsVp\x2C\n  cleanupGameLock\x2C\n} from '../game/index.js';\n\nimport {\n  removeFigurePosition\x2C syncHealthStateToList\x2C\n  getPlayerId\x2C getDcList\x2C getDcMessageIds\x2C\n  getCcHand\x2C getCcDiscard\x2C getCcDeck\x2C\n  getActivatedDcIndices\x2C getActivationsRemaining\x2C setActivationsRemaining\x2C\n  recomputeActivationCounts\x2C\n  vpKey\x2C ccHandKey\x2C ccDiscardKey\x2C ccDeckKey\x2C ccAttachmentsKey\x2C\n} from '../game/player-helpers.js';\n\n// \u2500\u2500 Data loaders \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nimport {\n  getDcEffects\x2C getDiceData\x2C getCcEffect\x2C isCcAttachment\x2C isDcAttachment\x2C\n  isDcUnique\x2C getMapData\x2C getMapRegistry\x2C getMapTokensData\x2C\n  getTournamentRotation\x2C getMissionCardsData\x2C getMissionRules\x2C\n  getDeploymentZones\x2C getDcStats\x2C getFigureSize\x2C\n  getDcKeywords\x2C getCcEffectsData\x2C\n} from '../data-loader.js';\n\n// \u2500\u2500 Discord UI (imported\x2C real functions \u2014 they build embeds/components\x2C not send) \u2500\u2500\n\nimport {\n  getInitiativePlayerZoneLabel\x2C PHASE_COLOR\x2C GAME_PHASES\x2C ACTION_ICONS\x2C\n  logGameAction as _logGameAction\x2C\n  getHandTooltipEmbed\x2C getHandSquadButtons\x2C getMapSelectionTooltipEmbed\x2C\n  getMoveMpButtonRows\x2C\n  getSpaceChoiceRows\x2C getActionsCounterContent\x2C\n  DC_ACTIONS_PER_ACTIVATION\x2C FIGURE_LETTERS\x2C\n  getGeneralSetupButtons\x2C getMapTypeButtons\x2C getMapConfirmButton\x2C\n  getMissionSelectDrawMenu\x2C getMissionSelectionPickMenu\x2C\n  getDeploymentZoneButtons\x2C getCcShuffleDrawButton\x2C\n  getIllegalCcPlayButtons\x2C getNegationResponseButtons\x2C getCelebrationButtons\x2C\n  getLobbyEmbed\x2C getLobbyStartButton\x2C updateThreadName\x2C\n  getDeploySpaceGridRows\x2C buildDeployRowButtons\x2C\n  getDeployFigureLabelsFromDiscord\x2C\n  getDeployButtonRowsFromDiscord\x2C\n  getDcActionButtons as getDcActionButtonsFromDiscord\x2C\n  getActivateDcButtons as getActivateDcButtonsFromDiscord\x2C\n  updateActivationsMessage\x2C\n} from '../discord/index.js';\n\n// \u2500\u2500 Game logic helpers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nimport {\n  getPlayableCcSpecialsForDc\x2C\n  getPlayableCcEndOfActivationForDc\x2C\n  getPlayableCcDoubleActionsForDc\x2C\n} from '../game/cc-timing.js';\n\nimport {\n  runEndOfRoundRules\x2C runStartOfRoundRules\x2C\n  runNpcThugActivation\x2C runNpcKryknaActivation\x2C\n} from '../game/mission-rules.js';\n\nimport { canActAsPlayer } from '../utils/can-act-as-player.js';\nimport { MAX_ACTIVE_GAMES_PER_PLAYER\x2C PENDING_ILLEGAL_TTL_MS } from '../constants.js';\nimport { getCommandCardImagePath\x2C getConditionCardPath } from '../asset-paths.js';\n\n// \u2500\u2500 Engine modules: combat bridge\x2C win conditions\x2C etc. \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nimport {\n  applyNpcDamageToFigure as _realApplyNpcDamageToFigure\x2C\n  applyDirectDamageToFigure as _realApplyDirectDamageToFigure\x2C\n  resolveCombatAfterRolls as _realResolveCombatAfterRolls\x2C\n  applyDamageAndFinishCombat as _realApplyDamageAndFinishCombat\x2C\n  finishCombatResolution as _realFinishCombatResolution\x2C\n  checkPostCombatSurges as _realCheckPostCombatSurges\x2C\n} from '../engine/combat-bridge.js';\n\nimport {\n  checkWinConditions as _realCheckWinConditions\x2C\n  checkNefariousGains as _realCheckNefariousGains\x2C\n  checkHuntDissent as _realCheckHuntDissent\x2C\n  checkThisIsTheWay as _realCheckThisIsTheWay\x2C\n  decrementActivationIfGroupDefeated as _realDecrementActivation\x2C\n  postGameOver as _realPostGameOver\x2C\n} from '../engine/win-conditions.js';\n\nimport { checkFriendlyDefeatedPassiveRedraws } from '../game/cc-passive-redraw.js';\nimport { processFigureDefeat as _realProcessFigureDefeat } from '../engine/defeat-handler.js';\nimport { isWithinN } from '../engine/utils.js';\nimport { lookupFigureDcIndex as _lookupFigureDcIndex } from '../engine/game-readers.js';\nimport { findFigureheadFigure as _findFigureheadFigureRaw } from '../engine/misc-helpers.js';\nimport { getCleaveTargetButtons\x2C getFightingKnifeTargetButtons } from '../discord/components.js';\nimport { PHASES } from '../game/phase.js';\nimport { setPhase\x2C enableStrictPhaseTransitions } from '../game/phase.js';\n\n// \u2500\u2500 Extracted engine modules \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nimport { shuffleArray\x2C filterValidTopLeftSpaces as _filterValidTopLeftSpacesPure } from '../engine/utils.js';\nimport {\n  getMissionTokenLabel\x2C calculateKillVp as _calculateKillVpRaw\x2C\n} from '../engine/mission-helpers.js';\nimport { isDcCompanion } from '../data-loader.js';\nimport {\n  hasActionsRemainingInGame as _hasActionsRemainingInGameRaw\x2C\n  shouldShowEndActivationPhaseButton as _shouldShowEndActivationPhaseButtonRaw\x2C\n  isGroupDefeated as _isGroupDefeatedRaw\x2C\n  isDepletedRemovedFromGame as _isDepletedRemovedFromGameRaw\x2C\n  findDcMessageIdForFigure as _findDcMessageIdForFigureRaw\x2C\n  getFigureLabel as _getFigureLabelRaw\x2C\n  getPlayerZoneLabel as _getPlayerZoneLabelRaw\x2C\n  countActiveGamesForPlayer as _countActiveGamesForPlayerRaw\x2C\n} from '../engine/game-readers.js';\nimport {\n  getDcUpgradeAttachments\x2C\n  getConditionsForDcMessage as _getConditionsForDcMessageRaw\x2C\n  getNicknamesForDcMessage as _getNicknamesForDcMessageRaw\x2C\n} from '../engine/dc-ui-helpers.js';\nimport { getPlayReadyMaps } from '../engine/board-ui-helpers.js';\n\n// \u2500\u2500 Rendering stubs \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nimport {\n  buildDcEmbedAndFiles\x2C\n  buildDiscardPileDisplayPayload\x2C\n  buildHandDisplayPayload as buildHandDisplayPayloadFromRendering\x2C\n  getActivationMinimapAttachment\x2C\n  getMovementMinimapAttachment\x2C\n  getDeploymentMapAttachment\x2C\n} from '../rendering.js';\n\n// \u2500\u2500 Handler-level re-exports \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nimport {\n  runStartOfRoundDcEffects\x2C\n  runStartOfRoundContinuation\x2C\n  runPostDeployPhase\x2C\n  sendRerollUI\x2C\n  proceedAfterRerolls\x2C\n  sendReadyToResolveRolls\x2C\n  runStatusPhaseAfterEndOfRound\x2C\n} from '../handlers/index.js';\n\nimport { sendPhaseGateMessages } from '../handlers/phase-gate.js';\n\n/**\n * Build the complete headless deps bag.\n *\n * @param {object} options\n * @param {Map} options.gamesMap \u2014 in-memory game storage\n * @param {object} [options.client] \u2014 fake client (auto-created if omitted)\n * @returns {object} allDeps \u2014 satisfies every key in getAllRequiredDepKeys()\n */\nexport function buildHeadlessDeps(options = {}) {\n  // Strict phase transitions: any invalid transition throws instead of warning.\n  // Safe for Discord too (valid transitions unaffected)\x2C but primarily for headless integrity.\n  enableStrictPhaseTransitions();\n\n  const lightweight = !!options.lightweight;\n  const gamesMap = options.gamesMap || new Map();\n  const client = options.client || createFakeClient();\n\n  // In-memory state maps\n  const dcMessageMeta = options.dcMessageMeta || new Map();\n  const dcExhaustedState = options.dcExhaustedState || new Map();\n  const dcHealthState = options.dcHealthState || new Map();\n  const pendingIllegalSquad = options.pendingIllegalSquad || new Map();\n  const pendingSquadConfirm = options.pendingSquadConfirm || new Map();\n\n  // Core state accessors\n  const getGame = (id) => gamesMap.get(id) || null;\n  const setGame = (id\x2C game) => { gamesMap.set(id\x2C game); };\n  const saveGames = () => {}; // no-op in headless\n  const deleteGame = (id) => { gamesMap.delete(id); };\n  const deleteGameFromDb = async () => {};\n\n  // Action log capture (disabled in lightweight mode to prevent OOM)\n  const actionLog = [];\n  const logGameAction = lightweight\n    ? async () => {}\n    : async (game\x2C clientArg\x2C msg\x2C opts) => {\n        actionLog.push({ gameId: game?.gameId\x2C msg\x2C opts });\n      };\n  const logGameErrorToBotLogs = async () => {};\n\n  // UI functions that send Discord messages \u2192 no-op stubs\n  const noopAsync = async () => {};\n  const noopSync = () => {};\n  const noopReturnsNull = () => null;\n  const noopReturnsEmptyArr = () => [];\n  const noopReturnsEmptyObj = () => ({});\n\n  // Locally-defined wrappers that need state closures\n  const replyIfGameEnded = async (game\x2C interaction) => {\n    if (game?.ended) return true;\n    return false;\n  };\n\n  // pushUndo: disabled in lightweight mode to prevent OOM from JSON.stringify of full game state\n  const pushUndo = lightweight\n    ? () => {}\n    : (game) => {\n        if (!game) return;\n        game.undoStack = game.undoStack || [];\n        const { undoStack: _\x2C ...rest } = game;\n        game.undoStack.push(JSON.parse(JSON.stringify(rest)));\n        if (game.undoStack.length > 5) game.undoStack.shift();\n      };\n\n  const extractGameIdFromInteraction = (interaction) => {\n    if (!interaction?.customId) return null;\n    const match = interaction.customId.match(/(\\d{5})/);\n    return match ? match[1] : null;\n  };\n\n  // Build board map payload \u2014 stub that returns empty payload\n  const buildBoardMapPayload = async () => ({ content: '[headless: board map]'\x2C files: [] });\n\n  // Update messages \u2014 all no-ops in headless\n  const updateAttachmentMessageForDc = noopAsync;\n  const updateMovementBankMessage = noopAsync;\n  const ensureMovementBankMessage = noopAsync;\n  const updateDcActionsMessage = noopAsync;\n  const updateHandChannelMessages = noopAsync;\n  const updateHandVisualMessage = noopAsync;\n  const updateDiscardPileMessage = noopAsync;\n  const updatePlayAreaDcButtons = noopAsync;\n  const clearMoveGridMessages = noopAsync;\n  const maybeShowEndActivationPhaseButton = noopAsync;\n  const refreshAllGameComponents = noopAsync;\n  const sendRoundActivationPhaseMessage = noopAsync;\n  const sendBleedingPrompt = noopAsync;\n  const sendDeckIllegalAlert = noopAsync;\n  const sendSquadConfirmation = noopAsync;\n  const postDevaronDoorButtons = noopAsync;\n  const postDevaronCratePushPrompts = noopAsync;\n  const postKryknaPushButtons = noopAsync;\n  const updateDeployPromptMessages = noopAsync;\n\n  // Setup/creation stubs\n  const createPlayAreaChannels = noopAsync;\n  const createBoardChannel = noopAsync;\n  const createHandThreads = noopAsync;\n  const createGameChannels = noopAsync;\n  const applySquadSubmission = noopAsync;\n  const finishSetupAttachments = noopAsync;\n  const runDraftRandom = noopAsync;\n  const clearPreGameSetup = noopAsync;\n\n  // Rendering helpers that return embeds/components (stubs)\n  const buildHandDisplayPayload = () => ({ embeds: []\x2C components: []\x2C files: [] });\n  const getMapAttachmentForSpaces = async () => ({ files: []\x2C embed: null });\n  const getDcPlayAreaComponents = () => [];\n  // Use real UI builders (remove override stubs \u2014 Task 3.28)\n  const getDcActionButtons = getDcActionButtonsFromDiscord;\n  const getActivateDcButtons = getActivateDcButtonsFromDiscord;\n\n  // \u2500\u2500 Shared helpers needed by combat deps \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  const discordCatch = () => {};\n  const calculateKillVp = (dcName) => _calculateKillVpRaw(dcName\x2C { isDcCompanion\x2C getDcStats\x2C getDcEffects });\n  const isDbConfigured = () => false;\n  const achievementsChannelId = null;\n  const checkAndGrantAchievements = noopAsync;\n  const checkAndPostAchievements = noopAsync;\n  const postAchievementNotification = noopAsync;\n\n  const _isGroupDefeated = (game\x2C playerNum\x2C dcIndex) => _isGroupDefeatedRaw(game\x2C playerNum\x2C dcIndex\x2C { getDcList: (g\x2C pn) => (pn === 1 ? g.p1DcList : g.p2DcList) || []\x2C getDcStats });\n  const _findDcMessageIdForFigure = (gameId\x2C playerNum\x2C figureKey) => _findDcMessageIdForFigureRaw(gameId\x2C playerNum\x2C figureKey\x2C dcMessageMeta);\n  const _getFigureLabel = (game\x2C playerNum\x2C figureKey\x2C fallback\x2C maxLen) => _getFigureLabelRaw(game\x2C playerNum\x2C figureKey\x2C fallback\x2C maxLen\x2C { dcMessageMeta\x2C dcNameFromFigureKey\x2C getDcList\x2C getDcMessageIds });\n  const _findFigureheadFigure = (game\x2C defenderPlayerNum\x2C targetFigureKey) => _findFigureheadFigureRaw(game\x2C defenderPlayerNum\x2C targetFigureKey\x2C {\n    getDcList\x2C getDcEffect\x2C dcNameFromFigureKey\x2C\n    isWithinN: (a\x2C b\x2C n\x2C mapId) => isWithinN(a\x2C b\x2C n\x2C mapId\x2C getMapData)\x2C\n    findDcMessageIdForFigure: _findDcMessageIdForFigure\x2C parseFigureKey\x2C\n  });\n  // Wrap DC UI helpers that need deps.getDcStats bound\n  const getConditionsForDcMessage = (game\x2C meta) => _getConditionsForDcMessageRaw(game\x2C meta\x2C { getDcStats });\n  const getNicknamesForDcMessage = (game\x2C meta) => _getNicknamesForDcMessageRaw(game\x2C meta\x2C { getDcStats });\n\n  // Build the shared deps object used by combat-bridge and win-conditions functions\n  const _buildCombatDeps = () => ({\n    logGameAction\x2C saveGames\x2C dcHealthState\x2C dcMessageMeta\x2C dcExhaustedState\x2C\n    dcNameFromFigureKey\x2C parseFigureKey\x2C opponentPlayerNum\x2C discordCatch\x2C\n    reduceHp\x2C healHp\x2C removeFigurePosition\x2C\n    calculateKillVp\x2C awardKillVp\x2C awardObjectiveVp\x2C vpKey\x2C\n    getDcList\x2C getDcMessageIds\x2C getDcStats\x2C getDcEffects\x2C getDcEffect\x2C getDcKeywords\x2C\n    getPlayerId\x2C getMapData\x2C getEffectiveMapSpaces\x2C\n    isWithinN: (a\x2C b\x2C n\x2C mapId) => isWithinN(a\x2C b\x2C n\x2C mapId\x2C getMapData)\x2C\n    hasLineOfSight\x2C getRange\x2C\n    getFiguresAdjacentToTarget\x2C getFiguresAdjacentToCoord\x2C getFiguresOnOrAdjacentToSpace\x2C\n    getEffectiveFigureSize\x2C getFootprintCells\x2C getFigureSize\x2C\n    findDcMessageIdForFigure: _findDcMessageIdForFigure\x2C\n    lookupFigureDcIndex: (game\x2C pn\x2C fk) => _lookupFigureDcIndex(game\x2C pn\x2C fk\x2C { dcMessageMeta\x2C getDcMessageIds\x2C getDcList })\x2C\n    getFigureLabel: _getFigureLabel\x2C\n    getCcHand\x2C getCcEffectsData\x2C getCcEffect\x2C\n    ccHandKey\x2C ccDiscardKey\x2C ccDeckKey\x2C ccAttachmentsKey\x2C\n    _applyCondition: applyCondition\x2C filterCondition\x2C isConditionImmune\x2C HARMFUL_CONDITIONS\x2C\n    isDcUnique\x2C getActivatedDcIndices\x2C\n    isDbConfigured\x2C achievementsChannelId\x2C checkAndGrantAchievements\x2C checkAndPostAchievements\x2C postAchievementNotification\x2C\n    grantMovementBank\x2C grantPowerTokens\x2C getDiceData\x2C\n    ButtonBuilder\x2C ButtonStyle\x2C ActionRowBuilder\x2C\n    getCelebrationButtons\x2C getCleaveTargetButtons\x2C getFightingKnifeTargetButtons\x2C\n    normalizeCoord\x2C computeCombatResult\x2C getBoardStateForMovement\x2C\n    findFigureheadFigure: _findFigureheadFigure\x2C\n    updateAttachmentMessageForDc\x2C updateMovementBankMessage\x2C ensureMovementBankMessage\x2C\n    updateDcActionsMessage\x2C updateHandChannelMessages\x2C updateHandVisualMessage\x2C\n    sendPowerTokenOverflowUI: noopAsync\x2C\n    sendBleedingPrompt\x2C\n    applyIndiscriminateFireSplash: noopAsync\x2C\n    buildDcEmbedAndFiles\x2C getConditionsForDcMessage\x2C getDcUpgradeAttachments\x2C getNicknamesForDcMessage\x2C\n    buildBoardMapPayload\x2C\n    getPlayAreaId: () => null\x2C\n    syncHealthStateToList\x2C\n    client\x2C\n    // headless flag for skipping Discord-only prompts\n    headless: true\x2C\n  });\n\n  // \u2500\u2500 Wire real game-logic functions \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n  // checkWinConditions: uses real implementation with headless postGameOver\n  const checkWinConditions = async (game\x2C clientArg) => {\n    const combatDeps = _buildCombatDeps();\n    const result = await _realCheckWinConditions(game\x2C clientArg || client\x2C {\n      ...combatDeps\x2C\n      getCrateDeploymentVpBonus: () => ({ p1: 0\x2C p2: 0 })\x2C\n      getAnchorheadPatronVpBonus: () => ({ p1: 0\x2C p2: 0 })\x2C\n      postGameOver: async (g\x2C c\x2C winnerId\x2C reason) => {\n        g.ended = true;\n        setPhase(g\x2C PHASES.ENDED);\n        g.winnerId = winnerId ?? null;\n        await logGameAction(g\x2C c\x2C `GAME OVER \u2014 ${winnerId ? `Player ${winnerId} wins` : reason}`\x2C { phase: 'ROUND'\x2C icon: 'round' });\n        saveGames();\n      }\x2C\n      logGameAction\x2C\n    });\n    return result;\n  };\n\n  // checkNefariousGains\x2C checkHuntDissent\x2C decrementActivationIfGroupDefeated\n  const checkNefariousGains = async (game\x2C defeatedOwnerPN\x2C clientArg) => {\n    await _realCheckNefariousGains(game\x2C defeatedOwnerPN\x2C clientArg || client\x2C {\n      _checkNefariousGainsVp\x2C logGameAction\x2C\n    });\n  };\n  const checkHuntDissent = async (game\x2C attackerPN\x2C attackerFigKey\x2C clientArg) => {\n    await _realCheckHuntDissent(game\x2C attackerPN\x2C attackerFigKey\x2C clientArg || client\x2C {\n      getDcEffects\x2C dcNameFromFigureKey\x2C grantPowerTokens\x2C getRange\x2C logGameAction\x2C\n    });\n  };\n  const checkThisIsTheWay = async (game\x2C attackerPN\x2C attackerFigKey\x2C clientArg) => {\n    await _realCheckThisIsTheWay(game\x2C attackerPN\x2C attackerFigKey\x2C clientArg || client\x2C {\n      getDcEffects\x2C dcNameFromFigureKey\x2C grantPowerTokens\x2C logGameAction\x2C\n    });\n  };\n  const decrementActivationIfGroupDefeated = async (game\x2C playerNum\x2C dcIdx\x2C clientArg) => {\n    await _realDecrementActivation(game\x2C playerNum\x2C dcIdx\x2C clientArg || client\x2C {\n      isGroupDefeated: _isGroupDefeated\x2C\n      recomputeActivationCounts\x2C\n      updateActivationsMessage\x2C\n    });\n  };\n\n  // processFigureDefeat: wired with headless deps (Discord I/O no-oped)\n  const processFigureDefeat = async (game\x2C opts) => {\n    return _realProcessFigureDefeat(game\x2C opts\x2C {\n      removeFigurePosition\x2C\n      calculateKillVp\x2C\n      awardKillVp\x2C\n      dcNameFromFigureKey\x2C\n      logGameAction\x2C\n      client\x2C\n      decrementActivationIfGroupDefeated\x2C\n      ccAttachmentsKey\x2C\n      updateAttachmentMessageForDc\x2C\n      checkFriendlyDefeatedPassiveRedraws\x2C\n      checkNefariousGains\x2C\n      checkHuntDissent\x2C\n      checkThisIsTheWay\x2C\n      checkWinConditions\x2C\n      findDcMessageIdForFigure: _findDcMessageIdForFigure\x2C\n      dcMessageMeta\x2C\n    });\n  };\n\n  // applyDamageAndFinishCombat: real implementation with full deps\n  const applyDamageAndFinishCombat = async (game\x2C combat\x2C params\x2C clientArg) => {\n    const combatDeps = _buildCombatDeps();\n    combatDeps.checkNefariousGains = checkNefariousGains;\n    combatDeps.checkWinConditions = checkWinConditions;\n    combatDeps.checkHuntDissent = checkHuntDissent;\n    combatDeps.checkThisIsTheWay = checkThisIsTheWay;\n    combatDeps.checkFriendlyDefeatedPassiveRedraws = checkFriendlyDefeatedPassiveRedraws;\n    combatDeps.decrementActivationIfGroupDefeated = decrementActivationIfGroupDefeated;\n    // Wire circular deps (combat bridge calls itself recursively for Blast/Cleave)\n    combatDeps.applyNpcDamageToFigure = applyNpcDamageToFigure;\n    combatDeps.checkPostCombatSurges = checkPostCombatSurges;\n    combatDeps.finishCombatResolution = finishCombatResolution;\n    await _realApplyDamageAndFinishCombat(game\x2C combat\x2C params\x2C clientArg || client\x2C combatDeps);\n  };\n\n  // resolveCombatAfterRolls\n  const resolveCombatAfterRolls = async (game\x2C combat\x2C clientArg) => {\n    const combatDeps = _buildCombatDeps();\n    combatDeps.applyDamageAndFinishCombat = applyDamageAndFinishCombat;\n    await _realResolveCombatAfterRolls(game\x2C combat\x2C clientArg || client\x2C combatDeps);\n  };\n\n  // finishCombatResolution\n  const finishCombatResolution = async (game\x2C combat\x2C resultText\x2C embedRefreshMsgIds\x2C clientArg) => {\n    const combatDeps = _buildCombatDeps();\n    await _realFinishCombatResolution(game\x2C combat\x2C resultText\x2C embedRefreshMsgIds\x2C clientArg || client\x2C combatDeps);\n  };\n\n  // checkPostCombatSurges\n  const checkPostCombatSurges = async (game\x2C combat\x2C resultText\x2C embedRefreshMsgIds\x2C thread\x2C ownerId\x2C defenderPlayerNum) => {\n    const combatDeps = _buildCombatDeps();\n    combatDeps.finishCombatResolution = finishCombatResolution;\n    await _realCheckPostCombatSurges(game\x2C combat\x2C resultText\x2C embedRefreshMsgIds\x2C thread\x2C ownerId\x2C defenderPlayerNum\x2C combatDeps);\n  };\n\n  // applyDirectDamageToFigure\n  const applyDirectDamageToFigure = async (game\x2C playerNum\x2C figKey\x2C msgId\x2C damage\x2C clientArg\x2C thread\x2C sourceName) => {\n    const combatDeps = _buildCombatDeps();\n    combatDeps.checkNefariousGains = checkNefariousGains;\n    combatDeps.checkWinConditions = checkWinConditions;\n    combatDeps.checkHuntDissent = checkHuntDissent;\n    combatDeps.checkThisIsTheWay = checkThisIsTheWay;\n    combatDeps.checkFriendlyDefeatedPassiveRedraws = checkFriendlyDefeatedPassiveRedraws;\n    combatDeps.decrementActivationIfGroupDefeated = decrementActivationIfGroupDefeated;\n    await _realApplyDirectDamageToFigure(game\x2C playerNum\x2C figKey\x2C msgId\x2C damage\x2C clientArg || client\x2C thread\x2C sourceName\x2C combatDeps);\n  };\n\n  // applyNpcDamageToFigure\n  const applyNpcDamageToFigure = async (game\x2C playerNum\x2C figureKey\x2C damage\x2C sourceLabel) => {\n    const combatDeps = _buildCombatDeps();\n    combatDeps.checkNefariousGains = checkNefariousGains;\n    combatDeps.checkWinConditions = checkWinConditions;\n    combatDeps.checkHuntDissent = checkHuntDissent;\n    combatDeps.checkThisIsTheWay = checkThisIsTheWay;\n    combatDeps.checkFriendlyDefeatedPassiveRedraws = checkFriendlyDefeatedPassiveRedraws;\n    combatDeps.decrementActivationIfGroupDefeated = decrementActivationIfGroupDefeated;\n    await _realApplyNpcDamageToFigure(game\x2C playerNum\x2C figureKey\x2C damage\x2C sourceLabel\x2C combatDeps);\n  };\n\n  // Mission helpers\n  const postMissionCardAfterMapSelection = noopAsync;\n  const postPinnedMissionCardFromGameState = noopAsync;\n\n  // Deployment helpers \u2014 wire real Discord UI builders for setup flow\n  const getDeployFigureLabels = (dcList\x2C game) => {\n    return getDeployFigureLabelsFromDiscord(dcList\x2C { resolveDcName: resolveDcName\x2C isFigurelessDc: isFigurelessDc\x2C getDcStats: getDcStats });\n  };\n  const getDeployButtonRows = (gameId\x2C playerNum\x2C dcList\x2C zone\x2C figurePositions\x2C game) => {\n    return getDeployButtonRowsFromDiscord(gameId\x2C playerNum\x2C dcList\x2C zone\x2C figurePositions\x2C { resolveDcName: resolveDcName\x2C isFigurelessDc: isFigurelessDc\x2C getDcStats: getDcStats });\n  };\n  const getDeploymentMapAttachmentStub = async () => ({ files: [] });\n\n  return {\n    // Core state\n    getGame\x2C setGame\x2C saveGames\x2C deleteGame\x2C deleteGameFromDb\x2C\n    dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState\x2C\n    pendingIllegalSquad\x2C pendingSquadConfirm\x2C\n    client\x2C\n\n    // Auth & utility\n    canActAsPlayer\x2C extractGameIdFromInteraction\x2C logGameErrorToBotLogs\x2C\n    replyIfGameEnded\x2C pushUndo\x2C\n\n    // Constants\n    PENDING_ILLEGAL_TTL_MS\x2C MAX_ACTIVE_GAMES_PER_PLAYER\x2C\n    DC_ACTIONS_PER_ACTIVATION\x2C GAME_PHASES\x2C PHASE_COLOR\x2C ACTION_ICONS\x2C\n    SURGE_LABELS\x2C FIGURE_LETTERS\x2C ThreadAutoArchiveDuration\x2C\n    DEFAULT_DECK_REBELS: []\x2C DEFAULT_DECK_SCUM: []\x2C DEFAULT_DECK_IMPERIAL: []\x2C\n\n    // Discord.js builders\n    ButtonBuilder\x2C ActionRowBuilder\x2C ButtonStyle\x2C EmbedBuilder\x2C\n\n    // Game logic (real implementations)\n    validateDeckLegal\x2C parseCoord\x2C normalizeCoord\x2C getFootprintCells\x2C\n    getBoardStateForMovement\x2C getMovementProfile\x2C\n    computeMovementCache\x2C getSpacesAtCost\x2C getMovementTarget\x2C\n    getMovementPath\x2C ensureMovementCache\x2C getNormalizedFootprint\x2C\n    initMassiveDisplacement\x2C resolveNextDisplacements\x2C applyDisplacementChoice\x2C\n    resolveMassivePush\x2C rollAttackDice\x2C rollDefenseDice\x2C\n    rollSingleAttackDie\x2C rollSingleDefenseDie\x2C recalcAttackTotals\x2C\n    recalcDefenseTotals\x2C getInnateRerolls\x2C getAttackerSurgeAbilities\x2C\n    parseSurgeEffect\x2C getAbility\x2C resolveSurgeAbility\x2C getSurgeAbilityLabel\x2C\n    resolveAbility\x2C getPlayableCcFromHand\x2C isCcPlayableNow\x2C\n    isCcPlayLegalByRestriction\x2C filterMapSpacesByBounds\x2C\n    reduceHp\x2C healHp\x2C awardKillVp\x2C awardObjectiveVp\x2C deductVp\x2C removeFigurePosition\x2C\n    dcNameFromFigureKey\x2C parseFigureKey\x2C getDcEffect\x2C getEffectiveFigureSize\x2C\n    computeCombatResult\x2C getEffectiveMapSpaces\x2C getFiguresAdjacentToTarget\x2C getFiguresAdjacentToCoord\x2C\n    grantMovementBank\x2C grantPowerTokens\x2C opponentPlayerNum\x2C\n    getPlayerId\x2C getDcList\x2C getDcMessageIds\x2C getCcHand\x2C\n    vpKey\x2C ccHandKey\x2C ccDiscardKey\x2C ccDeckKey\x2C ccAttachmentsKey\x2C\n    getActivatedDcIndices\x2C getActivationsRemaining\x2C setActivationsRemaining\x2C\n\n    // Data loaders (real implementations)\n    getDcEffects\x2C getDiceData\x2C getCcEffect\x2C isCcAttachment\x2C isDcAttachment\x2C\n    isDcUnique\x2C getMapData\x2C getMapRegistry\x2C getMapTokensData\x2C\n    getTournamentRotation\x2C getMissionCardsData\x2C getMissionRules\x2C\n    resolveDcName\x2C isFigurelessDc\x2C getFigureSize\x2C\n    getDcKeywords\x2C getCcEffectsData\x2C\n\n    // Discord UI (real functions that build data structures)\n    logGameAction\x2C\n    getInitiativePlayerZoneLabel\x2C\n    getHandTooltipEmbed\x2C getHandSquadButtons\x2C getMapSelectionTooltipEmbed\x2C\n    getMoveMpButtonRows\x2C\n    getSpaceChoiceRows\x2C getActionsCounterContent\x2C\n    updateActivationsMessage\x2C getGeneralSetupButtons\x2C getMapTypeButtons\x2C\n    getMapConfirmButton\x2C getMissionSelectDrawMenu\x2C getMissionSelectionPickMenu\x2C\n    getDeploymentZoneButtons\x2C getCcShuffleDrawButton\x2C\n    getIllegalCcPlayButtons\x2C getNegationResponseButtons\x2C getCelebrationButtons\x2C\n    getLobbyEmbed\x2C getLobbyStartButton\x2C updateThreadName\x2C\n    getDeploySpaceGridRows\x2C buildDeployRowButtons\x2C\n\n    // Combat (from handlers)\n    sendRerollUI\x2C proceedAfterRerolls\x2C sendReadyToResolveRolls\x2C\n\n    // Mission rules (real)\n    runEndOfRoundRules\x2C runStartOfRoundRules\x2C\n    runNpcThugActivation\x2C runNpcKryknaActivation\x2C\n\n    // Rendering (real where possible\x2C stubbed where Discord-dependent)\n    buildDcEmbedAndFiles\x2C buildDiscardPileDisplayPayload\x2C\n    buildBoardMapPayload\x2C buildHandDisplayPayload\x2C\n    getActivationMinimapAttachment\x2C getMovementMinimapAttachment\x2C\n    getDeploymentMapAttachment: getDeploymentMapAttachmentStub\x2C\n    getMapAttachmentForSpaces\x2C\n\n    // Extracted engine modules (real)\n    shuffleArray\x2C\n    filterValidTopLeftSpaces: (zoneSpaces\x2C occupiedSpaces\x2C size\x2C arg4\x2C arg5\x2C arg6) =>\n      typeof arg4 === 'function'\n        ? _filterValidTopLeftSpacesPure(zoneSpaces\x2C occupiedSpaces\x2C size\x2C getFootprintCells\x2C arg5\x2C arg6)\n        : _filterValidTopLeftSpacesPure(zoneSpaces\x2C occupiedSpaces\x2C size\x2C getFootprintCells\x2C arg4\x2C arg5)\x2C\n    getMissionTokenLabel\x2C calculateKillVp\x2C\n    // Game readers \u2014 wrapped to close over in-memory Maps (matching index.js wrapper signatures)\n    hasActionsRemainingInGame: (game\x2C gameId) => _hasActionsRemainingInGameRaw(game\x2C gameId\x2C dcMessageMeta)\x2C\n    shouldShowEndActivationPhaseButton: (game\x2C gameId) => _shouldShowEndActivationPhaseButtonRaw(game\x2C gameId\x2C dcMessageMeta)\x2C\n    isGroupDefeated: _isGroupDefeated\x2C\n    isDepletedRemovedFromGame: (game\x2C msgId) => _isDepletedRemovedFromGameRaw(game\x2C msgId)\x2C\n    findDcMessageIdForFigure: _findDcMessageIdForFigure\x2C\n    getFigureLabel: _getFigureLabel\x2C\n    getPlayerZoneLabel: (game\x2C playerId) => _getPlayerZoneLabelRaw(game\x2C playerId)\x2C\n    countActiveGamesForPlayer: (playerId) => _countActiveGamesForPlayerRaw(playerId\x2C gamesMap)\x2C\n    getDcUpgradeAttachments\x2C getConditionsForDcMessage\x2C getNicknamesForDcMessage\x2C\n    getPlayReadyMaps\x2C\n    checkFriendlyDefeatedPassiveRedraws\x2C\n\n    // Locally-defined stubs\n    updateAttachmentMessageForDc\x2C updateMovementBankMessage\x2C\n    ensureMovementBankMessage\x2C updateDcActionsMessage\x2C\n    updateHandChannelMessages\x2C updateHandVisualMessage\x2C\n    updateDiscardPileMessage\x2C updatePlayAreaDcButtons\x2C\n    clearMoveGridMessages\x2C maybeShowEndActivationPhaseButton\x2C\n    refreshAllGameComponents\x2C sendRoundActivationPhaseMessage\x2C\n    sendBleedingPrompt\x2C sendDeckIllegalAlert\x2C sendSquadConfirmation\x2C\n    postDevaronDoorButtons\x2C postDevaronCratePushPrompts\x2C postKryknaPushButtons\x2C\n    updateDeployPromptMessages\x2C getDcPlayAreaComponents\x2C\n    getDcActionButtons\x2C getActivateDcButtons\x2C\n\n    // Game operations (real implementations wired with headless deps)\n    processFigureDefeat\x2C\n    checkWinConditions\x2C resolveCombatAfterRolls\x2C applyDamageAndFinishCombat\x2C\n    finishCombatResolution\x2C checkPostCombatSurges\x2C\n    applyDirectDamageToFigure\x2C applyNpcDamageToFigure\x2C\n    decrementActivationIfGroupDefeated\x2C\n    checkNefariousGains\x2C checkHuntDissent\x2C checkThisIsTheWay\x2C\n\n    // Setup/creation stubs\n    createPlayAreaChannels\x2C createBoardChannel\x2C createHandThreads\x2C\n    createGameChannels\x2C applySquadSubmission\x2C finishSetupAttachments\x2C\n    runDraftRandom\x2C clearPreGameSetup\x2C\n    postMissionCardAfterMapSelection\x2C postPinnedMissionCardFromGameState\x2C\n    getDeployFigureLabels\x2C getDeployButtonRows\x2C\n\n    // Phase gate / round (real)\n    sendPhaseGateMessages\x2C\n    runStartOfRoundDcEffects\x2C runStartOfRoundContinuation\x2C runPostDeployPhase\x2C runStatusPhaseAfterEndOfRound\x2C\n\n    // Conditions (real)\n    filterCondition\x2C isConditionImmune\x2C applyCondition\x2C HARMFUL_CONDITIONS\x2C\n    getEffectiveSpeed\x2C\n    getRange\x2C hasLineOfSight\x2C\n    getDeploymentZones\x2C getDcStats\x2C\n    getLegalInteractOptions\x2C countTerminalsControlledByPlayer\x2C\n    isFigureInDeploymentZone\x2C getSpaceController\x2C getFiguresOnOrAdjacentToSpace\x2C\n    getPlayableCcSpecialsForDc\x2C getPlayableCcEndOfActivationForDc\x2C\n    getPlayableCcDoubleActionsForDc\x2C\n    getCommandCardImagePath\x2C getConditionCardPath\x2C\n\n    // Lobby\n    lobbies: new Map()\x2C\n\n    // Capture accessors for tests\n    _actionLog: actionLog\x2C\n    _gamesMap: gamesMap\x2C\n    _client: client\x2C\n  };\n}\n
