script-source,161,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/index.js,/**\n * Game logic (validation\x2C movement\x2C combat\x2C coords). No Discord.\n * Re-export from submodules for use by handlers and index.\n */\nexport {\n  validateDeckLegal\x2C\n  normalizeSquadInput\x2C\n  validateArmyAffiliation\x2C\n  validateUpgradeWarnings\x2C\n  resolveDcName\x2C\n  DC_POINTS_LEGAL\x2C\n  CC_CARDS_LEGAL\x2C\n  CC_COST_LEGAL\x2C\n} from './validation.js';\n\nexport {\n  parseCoord\x2C\n  normalizeCoord\x2C\n  colRowToCoord\x2C\n  edgeKey\x2C\n  toLowerSet\x2C\n  parseSizeString\x2C\n  sizeToString\x2C\n  rotateSizeString\x2C\n  shiftCoord\x2C\n  getFootprintCells\x2C\n} from './coords.js';\n\nexport {\n  isWithinGridBounds\x2C\n  filterMapSpacesByBounds\x2C\n  getBoundedMapSpaces\x2C\n  getOccupiedSpacesForMovement\x2C\n  getHostileOccupiedSpacesForMovement\x2C\n  getMovementKeywords\x2C\n  getBoardStateForMovement\x2C\n  getMovementProfile\x2C\n  buildTempBoardState\x2C\n  movementStateKey\x2C\n  getNormalizedFootprint\x2C\n  computeMovementCache\x2C\n  getSpacesAtCost\x2C\n  getMovementTarget\x2C\n  getMovementPath\x2C\n  ensureMovementCache\x2C\n  getReachableSpaces\x2C\n  getPathCost\x2C\n  getFiguresAdjacentToTarget\x2C\n  getFiguresAdjacentToCoord\x2C\n  collectOverlappingFigures\x2C\n  pushFigureToNearestValid\x2C\n  initMassiveDisplacement\x2C\n  resolveNextDisplacements\x2C\n  applyDisplacementChoice\x2C\n  resolveMassivePush\x2C\n  getEffectiveMapSpaces\x2C\n} from './movement.js';\n\nexport {\n  rollAttackDice\x2C\n  rollDefenseDice\x2C\n  rollSingleAttackDie\x2C\n  rollSingleDefenseDie\x2C\n  recalcAttackTotals\x2C\n  recalcDefenseTotals\x2C\n  getInnateRerolls\x2C\n  SURGE_LABELS\x2C\n  getAttackerSurgeAbilities\x2C\n  parseSurgeEffect\x2C\n  computeCombatResult\x2C\n} from './combat.js';\n\nexport { getAbility\x2C resolveSurgeAbility\x2C getSurgeAbilityLabel\x2C resolveAbility } from './abilities.js';\n\nexport { getCcPlayContext\x2C isCcPlayableNow\x2C getPlayableCcFromHand\x2C isCcPlayLegalByRestriction } from './cc-timing.js';\n\nexport { getGameLock\x2C cleanupGameLock\x2C withGameLock } from './action-queue.js';\n\nexport { getConfig\x2C setConfig\x2C clearConfig\x2C getAttachments\x2C hasAttachment } from './figure-config.js';\n\nexport {\n  getRange\x2C\n  isAdjacentCoords\x2C\n  isWithinRange\x2C\n  hasLineOfSight\x2C\n  isWithinSpaces\x2C\n  countSpaces\x2C\n  getFiguresWithinRange\x2C\n  getFiguresAdjacentTo\x2C\n} from './spatial.js';\n\nexport { cleanupActivation\x2C cleanupRoundStart } from './activation-state.js';\n\nexport { reduceHp\x2C healHp\x2C healHpDistributed } from './damage-helpers.js';\n\nexport { awardKillVp\x2C awardObjectiveVp\x2C deductVp\x2C checkNefariousGains } from './vp-helpers.js';\n\nexport { filterCondition\x2C isConditionImmune\x2C HARMFUL_CONDITIONS\x2C applyCondition\x2C applyConditionWithDie\x2C resetCondition } from './conditions.js';\n\nexport { dcNameFromFigureKey\x2C parseFigureKey\x2C getDcEffect\x2C isFigurelessDc\x2C hasDepleteEffect\x2C hasExhaustEffect\x2C getCompanionDescriptionForDc\x2C getMaxPowerTokens\x2C buildFigureButtonLabel\x2C figureChoiceLabels\x2C isCompanionHostDefeated } from './dc-helpers.js';\n\nexport { opponentPlayerNum\x2C getInitiativePlayerNum } from './player-helpers.js';\n\nexport { grantMovementBank\x2C grantPowerTokens\x2C resolveOverflowDiscard\x2C getPlayerDeploymentZones } from './game-helpers.js';\n\nexport {\n  getEffectiveFigureSize\x2C\n  getPlayerOccupiedCells\x2C\n  getPlayerOccupiedCellsForControl\x2C\n  getMissionTokenCoords\x2C\n  isFigureAdjacentOrOnMissionToken\x2C\n  getEffectiveSpeed\x2C\n  isFigureInDeploymentZone\x2C\n  isFigureAdjacentOrOnAny\x2C\n  getFigureAdjacentCoordsFromSet\x2C\n  getLegalInteractOptions\x2C\n  getSpaceController\x2C\n  getFiguresOnOrAdjacentToSpace\x2C\n  countTerminalsControlledByPlayer\x2C\n} from './board-helpers.js';\n
