script-source,178,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/engine/defeat-handler.js,import { chunkButtonsToRows\x2C truncateLabel } from '../discord/components.js';\nimport { fetchGameChannel } from '../discord/channel-helpers.js';\n\n/**\n * Universal figure defeat handler.\n *\n * Single source of truth for the common defeat sequence. Every code path\n * that defeats a figure (combat\x2C Blast\x2C Cleave\x2C Strain\x2C NPC damage\x2C etc.)\n * should call this instead of inlining the steps.\n *\n * Handles:\n *  1. Remove position + conditions + device tokens\n *  2. Calculate and award VP (companion guard via calculateKillVp)\n *  3. Log defeat\n *  4. Decrement activation counter if group fully defeated\n *  5. Clear CC attachments for the defeated DC\n *  6. Check passive CC redraws (Shared Experience\x2C etc.)\n *  7. Check Nefarious Gains (Jabba VP)\n *  8. Check Hunt Dissent (Kallus block token)\n *  8d. Check This is the Way (Armorer: attacker gains block token)\n *  8b. Check Heroic Effort (draw/return CC on unique defeat)\n *  9. Check win conditions\n *\n * Does NOT handle combat-specific post-defeat abilities (Last Stand\x2C\n * Vengeance\x2C Celebration\x2C reaction card prompts\x2C etc.) \u2014 those belong\n * in the combat code and should run AFTER calling this function.\n *\n * @param {object} game\n * @param {object} opts\n * @param {number} opts.defeatedPlayerNum   - player who owns the defeated figure\n * @param {string} opts.figureKey           - e.g. 'Imperial Officer-0-0'\n * @param {number} opts.attackerPlayerNum   - player who caused the defeat (for VP)\n * @param {string|null} [opts.attackerFigureKey] - for Hunt Dissent; null if N/A\n * @param {string|null} [opts.msgId]        - DC message ID (for CC attachments)\n * @param {number}      [opts.dcIdx=-1]     - index in dcList (for activation decrement)\n * @param {string|null} [opts.dcName]       - DC name; derived from figureKey if omitted\n * @param {string|null} [opts.displayName]  - for logging; defaults to dcName\n * @param {string}      [opts.source]       - defeat source label (e.g. 'Blast'\x2C 'Strain')\n * @param {boolean}     [opts.awardVp=true] - false for self-inflicted (Adrenaline)\n * @param {object} deps - required dependencies (see destructuring below)\n * @returns {{ vp: number\x2C dcName: string }}\n */\nimport { getDcEffects\x2C getDcStats } from '../data-loader.js';\nimport { getDcList\x2C getDcMessageIds\x2C ccHandKey\x2C ccDeckKey\x2C getHandChannelId\x2C dcAttachmentsKey } from '../game/player-helpers.js';\nimport { cardNameIncludes } from '../game/card-names.js';\n\nexport async function processFigureDefeat(game\x2C opts\x2C deps) {\n  const {\n    defeatedPlayerNum\x2C\n    figureKey\x2C\n    attackerPlayerNum\x2C\n    attackerFigureKey = null\x2C\n    msgId: msgIdOpt = null\x2C\n    dcIdx: dcIdxOpt = -1\x2C\n    dcName: dcNameOpt = null\x2C\n    displayName: displayNameOpt = null\x2C\n    source = ''\x2C\n    awardVp = true\x2C\n    skipWinConditions = false\x2C\n  } = opts;\n\n  const {\n    removeFigurePosition\x2C\n    calculateKillVp\x2C\n    awardKillVp\x2C\n    dcNameFromFigureKey\x2C\n    logGameAction\x2C\n    client\x2C\n    // Activation + attachment cleanup\n    decrementActivationIfGroupDefeated\x2C\n    ccAttachmentsKey\x2C\n    updateAttachmentMessageForDc\x2C\n    // Post-defeat checks\n    checkFriendlyDefeatedPassiveRedraws\x2C\n    checkNefariousGains\x2C\n    checkHuntDissent\x2C\n    checkThisIsTheWay\x2C\n    checkWinConditions\x2C\n    // Optional: for auto-resolving msgId/dcIdx when not provided\n    findDcMessageIdForFigure: findMsgId\x2C\n    dcMessageMeta\x2C\n  } = deps;\n\n  const dcName = dcNameOpt || dcNameFromFigureKey(figureKey);\n  const displayName = displayNameOpt || dcName;\n\n  // Auto-resolve msgId and dcIdx when not provided by caller\n  let msgId = msgIdOpt;\n  let dcIdx = dcIdxOpt;\n  if ((!msgId || dcIdx < 0) && findMsgId && dcMessageMeta) {\n    if (!msgId) msgId = findMsgId(game.gameId\x2C defeatedPlayerNum\x2C figureKey\x2C dcMessageMeta);\n    if (msgId && dcIdx < 0) {\n      const dcIds = getDcMessageIds(game\x2C defeatedPlayerNum);\n      dcIdx = (dcIds || []).indexOf(msgId);\n    }\n  }\n\n  // 1. Remove position + conditions + device tokens\n  removeFigurePosition(game\x2C defeatedPlayerNum\x2C figureKey);\n\n  // 2. Calculate and award VP\n  let vp = 0;\n  let attachmentVp = 0;\n  if (awardVp) {\n    vp = calculateKillVp(dcName);\n    if (vp > 0) awardKillVp(game\x2C attackerPlayerNum\x2C vp);\n\n    // 2b. Attachment VP: when last figure in group defeated\x2C award attachment deployment cost\n    // Rules: "When the last figure of a group with an 'Attachment' card is defeated\x2C\n    //  the opposing player scores VPs equal to the deployment cost of the 'Attachment' card."\n    // Negative deployment cost attachments reduce total VP (rules: NEGATIVE DEPLOYMENT COST).\n    if (msgId) {\n      const figPos = game.figurePositions?.[defeatedPlayerNum] || {};\n      const groupAlive = Object.keys(figPos).some(fk => fk.startsWith(dcName + '-') && figPos[fk]);\n      if (!groupAlive) {\n        const attKey = dcAttachmentsKey(defeatedPlayerNum);\n        const attachments = game[attKey]?.[msgId] || [];\n        for (const attName of attachments) {\n          const attStats = getDcStats(attName);\n          const attCost = attStats?.cost ?? 0;\n          if (attCost !== 0) {\n            attachmentVp += attCost;\n          }\n        }\n        if (attachmentVp !== 0) {\n          awardKillVp(game\x2C attackerPlayerNum\x2C attachmentVp);\n        }\n      }\n    }\n  }\n\n  // 3. Log defeat\n  const totalVp = vp + attachmentVp;\n  const vpText = totalVp > 0 ? ` (+${totalVp} VP to P${attackerPlayerNum})` : totalVp < 0 ? ` (${totalVp} VP to P${attackerPlayerNum})` : '';\n  const attachNote = attachmentVp !== 0 ? ` [includes ${attachmentVp > 0 ? '+' : ''}${attachmentVp} attachment VP]` : '';\n  const prefix = source ? `${source}: ` : '';\n  await logGameAction(game\x2C client\x2C\n    `${prefix}**${displayName}** was defeated!${vpText}${attachNote}`\x2C\n    { phase: 'ROUND'\x2C icon: 'attack' });\n\n  // 4. Decrement activation if group fully defeated\n  if (dcIdx >= 0 && decrementActivationIfGroupDefeated) {\n    await decrementActivationIfGroupDefeated(game\x2C defeatedPlayerNum\x2C dcIdx\x2C client);\n  }\n\n  // 5. Clear CC attachments\n  if (msgId && dcIdx >= 0 && ccAttachmentsKey && updateAttachmentMessageForDc) {\n    const key = ccAttachmentsKey(defeatedPlayerNum);\n    if (game[key]?.[msgId]?.length) {\n      delete game[key][msgId];\n      await updateAttachmentMessageForDc(game\x2C defeatedPlayerNum\x2C msgId\x2C client);\n    }\n  }\n\n  // 6. Passive CC redraws (Shared Experience\x2C etc.)\n  if (checkFriendlyDefeatedPassiveRedraws) {\n    const result = checkFriendlyDefeatedPassiveRedraws(game\x2C defeatedPlayerNum\x2C dcName);\n    for (const card of result.redrawn) {\n      await logGameAction(game\x2C client\x2C\n        `**Passive Redraw** \u2014 **${card}** re-drawn from discard (friendly **${dcName}** defeated).`\x2C\n        { phase: 'ROUND'\x2C icon: 'card' });\n    }\n  }\n\n  // 7. Nefarious Gains (Jabba: gain 1 VP when hostile defeated)\n  if (checkNefariousGains) {\n    await checkNefariousGains(game\x2C defeatedPlayerNum\x2C client);\n  }\n\n  // 8. Hunt Dissent (Kallus: gain Block token when hostile defeated)\n  if (attackerFigureKey && checkHuntDissent) {\n    await checkHuntDissent(game\x2C attackerPlayerNum\x2C attackerFigureKey\x2C client);\n  }\n\n  // 8d. This is the Way (The Armorer: another friendly defeats hostile \u2192 attacker gains Block token)\n  if (attackerFigureKey && checkThisIsTheWay) {\n    await checkThisIsTheWay(game\x2C attackerPlayerNum\x2C attackerFigureKey\x2C client);\n  }\n\n  // 8b. Heroic Effort: when unique figure defeated\x2C owner draws 1 CC + must return 1 to deck bottom\n  {\n    const dcList = getDcList(game\x2C defeatedPlayerNum) || [];\n    const hasHeroicEffort = dcList.some(dc => (dc.dcName || dc) === '[Heroic Effort]');\n    if (hasHeroicEffort) {\n      const dcEff = getDcEffects();\n      const effEntry = dcEff?.[dcName] || dcEff?.[dcName?.replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n      if (effEntry?.unique) {\n        const hKey = ccHandKey(defeatedPlayerNum);\n        const dKey = ccDeckKey(defeatedPlayerNum);\n        const deck = game[dKey] || [];\n        if (deck.length > 0) {\n          const drawn = deck.shift();\n          game[hKey] = [...(game[hKey] || [])\x2C drawn];\n          game[dKey] = deck;\n          await logGameAction(game\x2C client\x2C\n            `**Heroic Effort** \u2014 Drew 1 Command card (unique **${dcName}** defeated). Must return 1 card to deck bottom.`\x2C\n            { phase: 'ROUND'\x2C icon: 'card' });\n          // Set pending state for the return-card-to-deck-bottom interaction\n          game.pendingHeroicEffortReturn = game.pendingHeroicEffortReturn || {};\n          game.pendingHeroicEffortReturn[defeatedPlayerNum] = true;\n          // Send pick buttons to hand channel\n          const handChId = getHandChannelId(game\x2C defeatedPlayerNum);\n          if (handChId && client) {\n            try {\n              const { ActionRowBuilder\x2C ButtonBuilder\x2C ButtonStyle } = await import('discord.js');\n              const hand = game[hKey] || [];\n              const btns = hand.slice(0\x2C 25).map((card\x2C idx) =>\n                new ButtonBuilder()\n                  .setCustomId(`heroic_effort_return_${game.gameId}_${defeatedPlayerNum}_${idx}`)\n                  .setLabel(truncateLabel(card))\n                  .setStyle(ButtonStyle.Primary)\n              );\n              const rows = chunkButtonsToRows(btns);\n              const handCh = await fetchGameChannel(client\x2C handChId);\n              await handCh.send({\n                content: '**Heroic Effort** \u2014 Choose 1 Command card from your hand to place on the bottom of your deck:'\x2C\n                components: rows.slice(0\x2C 5)\x2C\n              });\n            } catch (err) {\n              console.error('Heroic Effort return buttons error:'\x2C err);\n            }\n          }\n        }\n      }\n    }\n  }\n\n  // 8c. Scavenged Weaponry: when group fully defeated\x2C offer transfer to another friendly Droid/Vehicle\n  if (msgId) {\n    const attKey = dcAttachmentsKey(defeatedPlayerNum);\n    const attachments = game[attKey]?.[msgId] || [];\n    if (cardNameIncludes(attachments\x2C 'Scavenged Weaponry')) {\n      // Check if group is fully defeated (no more figures of this DC on board)\n      const figPos = game.figurePositions?.[defeatedPlayerNum] || {};\n      const groupAlive = Object.keys(figPos).some(fk => fk.startsWith(dcName + '-') && figPos[fk]);\n      if (!groupAlive) {\n        const dcEff = getDcEffects();\n        const dcListArr = getDcList(game\x2C defeatedPlayerNum) || [];\n        const dcMsgIds = getDcMessageIds(game\x2C defeatedPlayerNum) || [];\n        // Find eligible Droid/Vehicle groups (alive\x2C not the defeated group)\n        const eligible = [];\n        for (let i = 0; i < dcListArr.length; i++) {\n          const dc = dcListArr[i];\n          const dn = dc?.dcName || dc;\n          if (dn === dcName) continue; // same DC\n          if (/^\\[.+\\]$/.test(dn)) continue; // skip upgrades\n          const eff = dcEff?.[dn];\n          const kws = (eff?.keywords || []).map(k => String(k).toUpperCase());\n          if (!kws.includes('DROID') && !kws.includes('VEHICLE')) continue;\n          // Check if group has at least one alive figure\n          const hasFigure = Object.keys(figPos).some(fk => fk.startsWith(dn + '-') && figPos[fk]);\n          if (!hasFigure) continue;\n          eligible.push({ dcName: dn\x2C displayName: dc?.displayName || dn\x2C msgId: dcMsgIds[i] });\n        }\n        if (eligible.length > 0) {\n          // Remove from old group\x2C set pending state\n          const idx = attachments.indexOf('Scavenged Weaponry');\n          attachments.splice(idx\x2C 1);\n          game[attKey][msgId] = attachments;\n          if (eligible.length === 1) {\n            // Auto-transfer to only option\n            const target = eligible[0];\n            game[attKey][target.msgId] = [...(game[attKey][target.msgId] || [])\x2C 'Scavenged Weaponry'];\n            await logGameAction(game\x2C client\x2C\n              `**Scavenged Weaponry** \u2014 Transferred from defeated **${dcName}** to **${target.displayName}**.`\x2C\n              { phase: 'ROUND'\x2C icon: 'card' });\n          } else {\n            // Multiple options \u2014 send picker buttons to hand channel\n            game.pendingScavengedWeaponryTransfer = { playerNum: defeatedPlayerNum\x2C eligible };\n            const handChId = getHandChannelId(game\x2C defeatedPlayerNum);\n            if (handChId && client) {\n              try {\n                const { ActionRowBuilder\x2C ButtonBuilder\x2C ButtonStyle } = await import('discord.js');\n                const btns = eligible.slice(0\x2C 10).map((e\x2C i) =>\n                  new ButtonBuilder()\n                    .setCustomId(`scav_weapon_transfer_${game.gameId}_${defeatedPlayerNum}_${i}`)\n                    .setLabel(truncateLabel(e.displayName))\n                    .setStyle(ButtonStyle.Primary)\n                );\n                const rows = chunkButtonsToRows(btns);\n                const handCh = await fetchGameChannel(client\x2C handChId);\n                await handCh.send({\n                  content: `**Scavenged Weaponry** \u2014 **${dcName}** was defeated. Choose a friendly Droid/Vehicle to transfer it to:`\x2C\n                  components: rows.slice(0\x2C 5)\x2C\n                });\n              } catch (err) {\n                console.error('Scavenged Weaponry transfer buttons error:'\x2C err);\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n\n  // 9. Check win conditions (skipped when caller handles timing\x2C e.g. combat post-defeat VP mods)\n  if (checkWinConditions && !skipWinConditions) {\n    await checkWinConditions(game\x2C client);\n  }\n\n  return { vp\x2C dcName };\n}\n
