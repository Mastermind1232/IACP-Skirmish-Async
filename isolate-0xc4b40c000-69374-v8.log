script-source,868,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/discord.js/src/structures/ChatInputCommandInteraction.js,'use strict';\n\nconst CommandInteraction = require('./CommandInteraction');\nconst CommandInteractionOptionResolver = require('./CommandInteractionOptionResolver');\nconst { transformResolved } = require('../util/Util');\n\n/**\n * Represents a command interaction.\n * @extends {CommandInteraction}\n */\nclass ChatInputCommandInteraction extends CommandInteraction {\n  constructor(client\x2C data) {\n    super(client\x2C data);\n\n    /**\n     * The options passed to the command.\n     * @type {CommandInteractionOptionResolver}\n     */\n    this.options = new CommandInteractionOptionResolver(\n      this.client\x2C\n      data.data.options?.map(option => this.transformOption(option\x2C data.data.resolved)) ?? []\x2C\n      transformResolved({ client: this.client\x2C guild: this.guild\x2C channel: this.channel }\x2C data.data.resolved)\x2C\n    );\n  }\n\n  /**\n   * Returns a string representation of the command interaction.\n   * This can then be copied by a user and executed again in a new command while keeping the option order.\n   * @returns {string}\n   */\n  toString() {\n    const properties = [\n      this.commandName\x2C\n      this.options._group\x2C\n      this.options._subcommand\x2C\n      ...this.options._hoistedOptions.map(option => `${option.name}:${option.value}`)\x2C\n    ];\n    return `/${properties.filter(Boolean).join(' ')}`;\n  }\n}\n\nmodule.exports = ChatInputCommandInteraction;\n
