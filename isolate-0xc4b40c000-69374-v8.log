script-source,133,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/activation-state.js,/**\n * Activation + round state cleanup.\n * Single authoritative lists of per-activation and round-scoped flags.\n */\n\n/**\n * Per-activation flags keyed by msgId.\n * Deleted from game[key] at end of activation.\n */\nconst ACTIVATION_MSGID_FLAGS = [\n  'dcActionsData'\x2C\n  'movementBank'\x2C\n  'dcFinishedPinged'\x2C\n  'pendingEndTurn'\x2C\n  'fellSwoopFreeAttack'\x2C\n  'overrunThisActivation'\x2C\n  'overrunDamagedThisMove'\x2C\n  'pummelTwoAttacksThisActivation'\x2C\n  'pummelAttacksRemaining'\x2C\n  'stayDownPendingMsgId'\x2C\n  'burstFirePendingMsgId'\x2C\n  'cripplingBlowPending'\x2C\n  'disruptorRiflePending'\x2C\n  'tonfaStrikeSecondAttack'\x2C\n  'barrageSecondAttack'\x2C\n  'barrageTargetSpace'\x2C\n  'barrageDefenseBonus'\x2C\n  'pendingMultiTargetRoll'\x2C\n  'closeQuartersActive'\x2C\n  'mobileMovementActive'\x2C\n  'rushPending'\x2C\n  'shoulderRushPending'\x2C\n  'forcedAttackTarget'\x2C\n  'selfDefeatsAfterAttackMsgId'\x2C\n  'applySelfStunAfterAttackPlayerNum'\x2C\n  'postActivationConditions'\x2C\n  'pendingCombatResupply'\x2C\n  'pendingPostAttackConditions'\x2C\n  'pendingMpBonus'\x2C\n  'freeAttackBonusPending'\x2C\n  'pendingOverrideAttackDice'\x2C\n  'nextAttackReach'\x2C\n  'selfDestructProtocolTriggered'\x2C\n  'falseOrdersUpgrade'\x2C\n  'setTrapSpace'\x2C\n  'reverseEngineerActive'\x2C\n  'findsmanMeditationTarget'\x2C\n  'nextAttackIgnoreFigureLOS'\x2C\n  'optimalBombardmentBlastBonus'\x2C\n  'deflectionPending'\x2C\n  'deflectionUnconditional'\x2C\n  'dcActivationLogMessageIds'\x2C\n  'defenderThreadData'\x2C\n  'deviceRerollGranted'\x2C\n  'autofireActive'\x2C\n  'fireMissionActive'\x2C\n  'autofireChainTargetSpace'\x2C\n  'darksaberSecondAttack'\x2C\n  'saberOrbitAttacksRemaining'\x2C\n  'pendingOverwatchPlacement'\x2C\n  'activationKills'\x2C\n  'activationDamagedFigures'\x2C\n  'unstableDevicesUsedThisActivation'\x2C\n  'yhsiwOptions'\x2C\n  'pendingBoRifle'\x2C\n  'pendingBombDrop'\x2C\n  'activationExtraActionThenStun'\x2C\n  'beastTamerInteractOverride'\x2C\n  'imperialRetrofittingMultiAttack'\x2C\n  'arcingShotActive'\x2C\n  'wookieeAvengerSlamUsed'\x2C\n  'specialActionUsedThisActivation'\x2C\n  'focusFireActive'\x2C\n  'multiFireActive'\x2C\n  'multiFireBlockedTarget'\x2C\n  'spotWeldPending'\x2C\n  'pendingMissileSalvo'\x2C\n  'pendingPounceSpaceChoice'\x2C\n];\n\n/**\n * Per-activation flags keyed by figureKey (e.g. "Trooper-0-0").\n * Deleted for each figure in the activated deployment group.\n */\nconst ACTIVATION_FIGKEY_FLAGS = [\n  'figureMoved'\x2C\n  'tripodAttacked'\x2C\n  'activationStartPositions'\x2C\n  'overdriveUsedThisActivation'\x2C\n  'massiveMovementLocked'\x2C\n];\n\n/**\n * Per-activation flags keyed by playerNum.\n * Deleted for the activating player at end of activation.\n */\nconst ACTIVATION_PLAYERNUM_FLAGS = [\n  'nextAttacksBonusHits'\x2C\n  'nextAttacksBonusConditions'\x2C\n  'nextAttackBonusSurgeAbilities'\x2C\n  'nextAttackBonusPierce'\x2C\n  'nextAttackBonusAccuracy'\x2C\n  'vetInstinctsActiveThisActivation'\x2C\n];\n\n/**\n * Per-activation scalar flags (deleted outright).\n */\nconst ACTIVATION_SCALAR_FLAGS = [\n  'commsJammerActivePlayerNum'\x2C\n  'partingShotTriggered'\x2C\n  'onTheLamActive'\x2C\n  'arcingShotActiveScalar'\x2C\n  'pendingWookSlamPush'\x2C\n  'pendingSurgeOverflow'\x2C\n];\n\n/**\n * Clean per-activation state when a DC ends its activation.\n * @param {object} game\n * @param {string} msgId  - DC message ID for the activated card\n * @param {number} playerNum - 1 or 2\n * @param {string[]} figureKeys - all figureKeys for figures in this DG (e.g. ["Trooper-0-0"\x2C "Trooper-0-1"])\n */\nexport function cleanupActivation(game\x2C msgId\x2C playerNum\x2C figureKeys) {\n  for (const key of ACTIVATION_MSGID_FLAGS) {\n    if (game[key]?.[msgId] !== undefined) delete game[key][msgId];\n  }\n  for (const key of ACTIVATION_FIGKEY_FLAGS) {\n    if (!game[key]) continue;\n    for (const fk of figureKeys) {\n      delete game[key][fk];\n    }\n  }\n  for (const key of ACTIVATION_PLAYERNUM_FLAGS) {\n    if (game[key]?.[playerNum] !== undefined) delete game[key][playerNum];\n  }\n  for (const key of ACTIVATION_SCALAR_FLAGS) {\n    delete game[key];\n  }\n  // moveInProgress uses compound keys `${msgId}_${figureIndex}` \u2014 clean any matching this activation\n  if (game.moveInProgress) {\n    const prefix = `${msgId}_`;\n    for (const mk of Object.keys(game.moveInProgress)) {\n      if (mk.startsWith(prefix)) delete game.moveInProgress[mk];\n    }\n  }\n}\n\n/**\n * All round-scoped flags reset at start of new round.\n * Object flags are reset to {}; null flags to null; array flags to [].\n */\nconst ROUND_OBJECT_FLAGS = [\n  'roundDefenseBonusBlock'\x2C\n  'roundDefenseBonusEvade'\x2C\n  'roundDefenseAccuracyPenalty'\x2C\n  'roundMobileDefenseBonusBlock'\x2C\n  'roundDefenderBonusBlockPerEvade'\x2C\n  'roundTrooperAttackHitBonus'\x2C\n  'roundVehicleSpeedBonus'\x2C\n  'deflectionPending'\x2C\n  'deflectionUnconditional'\x2C\n  'roundAttackRerollDice'\x2C\n  'freeAttackBonusPending'\x2C\n  'pendingOverrideAttackDice'\x2C\n  'nextAttackReach'\x2C\n  'fellSwoopFreeAttack'\x2C\n  'roundAttackSurgeBonus'\x2C\n  'overrunThisActivation'\x2C\n  'roundFigureAbilityUsed'\x2C\n  'roundEfficientTravel'\x2C\n  'nextAttackIgnoreFigureLOS'\x2C\n  'findsmanMeditationTarget'\x2C\n  'vanishImmunityUntilNextActivation'\x2C\n  'falseOrdersUpgrade'\x2C\n  'setTrapSpace'\x2C\n  'reverseEngineerActive'\x2C\n  'pendingMpBonus'\x2C\n  'pummelTwoAttacksThisActivation'\x2C\n  'pummelAttacksRemaining'\x2C\n  'overrunDamagedThisMove'\x2C\n  'overdriveUsedThisActivation'\x2C\n  'stayDownPendingMsgId'\x2C\n  'burstFirePendingMsgId'\x2C\n  'cripplingBlowPending'\x2C\n  'disruptorRiflePending'\x2C\n  'tonfaStrikeSecondAttack'\x2C\n  'barrageSecondAttack'\x2C\n  'barrageTargetSpace'\x2C\n  'barrageDefenseBonus'\x2C\n  'pendingMultiTargetRoll'\x2C\n  'closeQuartersActive'\x2C\n  'selfDestructProtocolTriggered'\x2C\n  'mobileMovementActive'\x2C\n  'rushPending'\x2C\n  'shoulderRushPending'\x2C\n  'forcedAttackTarget'\x2C\n  'figureMoved'\x2C\n  'tripodAttacked'\x2C\n  'activationStartPositions'\x2C\n  'selfDefeatsAfterAttackMsgId'\x2C\n  'applySelfStunAfterAttackPlayerNum'\x2C\n  'postActivationConditions'\x2C\n  'pendingCombatResupply'\x2C\n  'pendingPostAttackConditions'\x2C\n  'nextActivationFreeAttack'\x2C\n  'vetInstinctsActiveThisActivation'\x2C\n  'surgeDoublingActive'\x2C\n  'optimalBombardmentBlastBonus'\x2C\n  'recoverOnHostileDefeat'\x2C\n  'nextHostileDefeatVpBonus'\x2C\n  'dcActivationLogMessageIds'\x2C\n  'defenderThreadData'\x2C\n  'deviceRerollGranted'\x2C\n  'nextAttackBonusAccuracy'\x2C\n  'priceBounties'\x2C\n  'diplomaticMissionEvade'\x2C\n  'lastResortTriggered'\x2C\n  'attackPerformedThisActivation'\x2C\n  'vadersFocusUsedThisRound'\x2C\n  'scavengedWalkerAttackPenalty'\x2C\n  'drivenByHatredAttackPenalty'\x2C\n  'roundProgrammingOverrideTrait'\x2C\n  'autofireActive'\x2C\n  'fireMissionActive'\x2C\n  'autofireChainTargetSpace'\x2C\n  'darksaberSecondAttack'\x2C\n  'saberOrbitAttacksRemaining'\x2C\n  'pendingOverwatchPlacement'\x2C\n  'activationKills'\x2C\n  'activationDamagedFigures'\x2C\n  'pendingBombDrop'\x2C\n  // crossTrainingExhausted \u2014 removed: Cross Training now uses exhaustedSkirmishUpgrades\n  'massiveMovementLocked'\x2C\n  'disarmPermanentWeakened'\x2C\n  'adrenalineBonuses'\x2C\n  'opportunisticMustSpendNow'\x2C\n  'imperialRetrofittingMultiAttack'\x2C\n  'urgencyMustSpendAll'\x2C\n  'arcingShotActive'\x2C\n  'pendingSpacePick'\x2C\n  'roundTrooperSurgeStun'\x2C\n  'pendingDcAbilityChoice'\x2C\n  'moveInProgress'\x2C\n  'forceSlowSkipActivation'\x2C\n  'executorTriggered'\x2C\n];\n\nconst ROUND_NULL_FLAGS = [\n  'hitAndRunPendingMp'\x2C\n  'nextAttacksBonusHits'\x2C\n  'nextAttackBonusSurgeAbilities'\x2C\n  'nextAttackBonusPierce'\x2C\n  'nextAttacksBonusConditions'\x2C\n  'roundDefenderCannotBeTargetedUnlessWithinSpaces'\x2C\n  'roundDebuffNextHostileActivation'\x2C\n  'roundDroidExtraActionCostDamage'\x2C\n  'sitTightPlayerNum'\x2C\n  'roundInTheShadowsPlayerNum'\x2C\n  'strengthInNumbersPlayerNum'\x2C\n  'strengthInNumbersData'\x2C\n  'provokeNextActivation'\x2C\n  'agitateNextActivation'\x2C\n  'forceVisionNextActivation'\x2C\n  'forceVisionPending'\x2C\n  'stillFasterExcludeMsgId'\x2C\n  'pendingStillFaster'\x2C\n  'roundUtinniJawaBuffs'\x2C\n  'roundSmugglersTricksPlayerNum'\x2C\n  'squadSwarmPlayerNum'\x2C\n  'squadSwarmCumulativeCost'\x2C\n  'whenDefeatHostileWithin3GainBlockTokens'\x2C\n  'pendingRushPush'\x2C\n  'pendingMassivePush'\x2C\n  'pendingEmperorInterrupt'\x2C\n  'pendingExecutiveOrder'\x2C\n  'pendingBombardmentSorin'\x2C\n  'pendingFiringSquad'\x2C\n  'pendingCoordinatedRaid'\x2C\n  'pendingFieldTactics'\x2C\n  'pendingAwr'\x2C\n  'sonOfSkywalkerActive'\x2C\n  'dataTheftStolenCard'\x2C\n  'conditionalFocusIfDamagedGte'\x2C\n  'pendingToughLuck'\x2C\n  'pendingBELReorder'\x2C\n  'pendingThereIsNoTry'\x2C\n  'pendingSelfDestruct'\x2C\n  'pendingLastResort'\x2C\n  'nextDefeatedFriendlyVpReduction'\x2C\n  'forceDefenderRerollOne'\x2C\n  'doubleMatchingIconsOnReroll'\x2C\n  'pendingHunterProtocol'\x2C\n  'holdGroundPlayerNum'\x2C\n  'windfallActive'\x2C\n  'wreakVengeanceActive'\x2C\n  'toughLuckPlayerNum'\x2C\n  'thereIsNoTryPlayerNum'\x2C\n  'youWillNotDenyMeActive'\x2C\n  'mandaAsteelPlayerNum'\x2C\n  'stillFasterPlayerNum'\x2C\n  'signalJammerActive'\x2C\n  'terminalControlPlayerNum'\x2C\n  'unlimitedPowerActive'\x2C\n  'shadowOpsBlockedPlayer'\x2C\n  'criticalHitBlockedPlayer'\x2C\n  'pendingOrbitalBombardment'\x2C\n  'pendingYHSIW'\x2C\n  'powerfulInfluencePlayerNum'\x2C\n  'restInPeaceActive'\x2C\n  'pendingIllicitArms'\x2C\n  'pendingExtraProtection'\x2C\n  'extraProtectionTriggeredThisCombat'\x2C\n  'pendingExecutorInterrupt'\x2C\n  'pendingCcConfirmation'\x2C\n  'pendingNegation'\x2C\n  'pendingCommDisruptionPrompt'\x2C\n  'pendingCoverFire'\x2C\n  'pendingStrainChoice'\x2C\n  'pendingVoracious'\x2C\n  'pendingAssassinsBlade'\x2C\n  'pendingPunishingStrike'\x2C\n  'pendingConspire'\x2C\n  'pendingItWillBeAlright'\x2C\n  'pendingGeneralsOrders'\x2C\n  'pendingMotivation'\x2C\n  'pendingTrustedAlly'\x2C\n  'pendingTokenDistribution'\x2C\n  'pendingLieInAmbush'\x2C\n  'pendingPowerTokenGrant'\x2C\n  'pendingChannelTheForceStrain'\x2C\n  'pendingIllegalCcPlay'\x2C\n  'pendingCcAttachment'\x2C\n  'pendingCcChoice'\x2C\n  'pendingCcSpaceChoice'\x2C\n  'pendingIKnowEverything'\x2C\n  'pendingSurgeOverflow'\x2C\n  'pendingInterrogate'\x2C\n  'pendingMastery'\x2C\n  'pendingMissionSorReveal'\x2C\n  'pendingSuppressiveFireMp'\x2C\n  // Combat pipeline pendings \u2014 safety net (deleted on happy path\x2C but no fallback if handler throws)\n  // NOTE: pendingCombat intentionally omitted \u2014 handled by recovery.js\n  'pendingCelebration'\x2C\n  'pendingCleave'\x2C\n  'pendingFightingKnife'\x2C\n  'pendingConcussiveBolt'\x2C\n  'pendingSpreadThePain'\x2C\n  'pendingSpreadThePainCondPick'\x2C\n  'pendingReaction'\x2C\n  'pendingBoltslinger'\x2C\n  'pendingIndiscriminateFire'\x2C\n  'pendingHeavyFire'\x2C\n  'pendingHavocShot'\x2C\n  'pendingDeflect'\x2C\n  'pendingWantonDestruction'\x2C\n  'pendingFigurehead'\x2C\n  'pendingRogueOneTokenPick'\x2C\n  'pendingZilloDiscard'\x2C\n  'pendingStrikeMeDown'\x2C\n  'pendingSlowOnTheDraw'\x2C\n  'pendingForceExhaustion'\x2C\n  'slowOnTheDrawInterrupt'\x2C\n  // Movement/activation pendings \u2014 safety net\n  'pendingFalseOrders'\x2C\n  'pendingOrderedMove'\x2C\n  'pendingShoulderRush'\x2C\n  'pendingDioFollow'\x2C\n  'pendingEe3Carbine'\x2C\n  'pendingRightBackAtYa'\x2C\n  'pendingBattlefieldLeadership'\x2C\n  'pendingScavengedWeaponryTransfer'\x2C\n  'pendingHeroicEffortReturn'\x2C\n];\n\nconst ROUND_ARRAY_FLAGS = [\n  'crippledFigures'\x2C\n  'disabledFigures'\x2C\n  'etiquetteBlockPairs'\x2C\n  'fluctuationSwappedThisRound'\x2C\n  'abilityExhaustedMsgIds'\x2C\n];\n\nconst ROUND_FALSE_FLAGS = [\n  'harshEnvironmentActive'\x2C\n  'noCommandDrawThisRound'\x2C\n  'p1LaunchPanelFlippedThisRound'\x2C\n  'p2LaunchPanelFlippedThisRound'\x2C\n  'powerConverterUsedThisRound'\x2C\n];\n\nconst ROUND_DELETE_FLAGS = [\n  'commsJammerActivePlayerNum'\x2C\n  'partingShotTriggered'\x2C\n  'onTheLamActive'\x2C\n  'jundlandTerrorPlayedThisEor'\x2C\n  'reinforcementsPlayedThisSor'\x2C\n  'pendingBlackMarket'\x2C\n  'deWannaWangaUsedThisRound'\x2C\n  'arcingShotActiveScalar'\x2C\n  'pendingDoorSelections'\x2C\n  'pendingKryknaPushQueue'\x2C\n  'kryknaPushedIds'\x2C\n  'pendingClaimedKryknaQueue'\x2C\n  'roundDioxisActive'\x2C\n  'pendingStartOfRoundResolve'\x2C\n  'pendingSorActions'\x2C\n  'pendingDeployOrientation'\x2C\n  'pendingFluctuationSwapQueue'\x2C\n  'pendingFluctuationSwapFirst'\x2C\n  'drivenByHatredForceChoke'\x2C\n  // Stale per-attack tracking \u2014 safety net\n  'lastAttackAttackerMsgId'\x2C\n  'lastAttackAttackerFigureIndex'\x2C\n  'lastAttackTargetFigureKey'\x2C\n  'lastDefeatInfo'\x2C\n  'lastAttackTargetSpacesForRubble'\x2C\n  'lastAttackAttackerPlayerNum'\x2C\n  // Per-round gates that must reset\n  'iKnowEverythingResolved'\x2C\n];\n\n/**\n * Reset all round-scoped flags at the start of a new round.\n * Called in handleEndEndOfRound after all end-of-round effects resolve.\n * @param {object} game\n */\nexport function cleanupRoundStart(game) {\n  for (const key of ROUND_OBJECT_FLAGS) {\n    game[key] = {};\n  }\n  for (const key of ROUND_NULL_FLAGS) {\n    game[key] = null;\n  }\n  for (const key of ROUND_ARRAY_FLAGS) {\n    game[key] = [];\n  }\n  for (const key of ROUND_FALSE_FLAGS) {\n    game[key] = false;\n  }\n  for (const key of ROUND_DELETE_FLAGS) {\n    delete game[key];\n  }\n}\n\n// Export flag lists for testing\nexport {\n  ACTIVATION_MSGID_FLAGS\x2C\n  ACTIVATION_FIGKEY_FLAGS\x2C\n  ACTIVATION_PLAYERNUM_FLAGS\x2C\n  ACTIVATION_SCALAR_FLAGS\x2C\n  ROUND_OBJECT_FLAGS\x2C\n  ROUND_NULL_FLAGS\x2C\n  ROUND_ARRAY_FLAGS\x2C\n  ROUND_FALSE_FLAGS\x2C\n  ROUND_DELETE_FLAGS\x2C\n};\n
