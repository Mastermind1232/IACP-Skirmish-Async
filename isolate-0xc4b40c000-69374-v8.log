script-source,134,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/domain/reducer/combat-reducer.js,export const combatReducerHandlers = {\n  CombatDeclared(state\x2C payload) {\n    return {\n      ...state\x2C\n      pendingCombat: {\n        attackerMsgId: payload.attackerMsgId\x2C\n        defenderMsgId: payload.defenderMsgId\x2C\n        attackerPlayerNum: payload.attackerPlayerNum\x2C\n        defenderPlayerNum: payload.defenderPlayerNum\x2C\n        attackerDcName: payload.attackerDcName || null\x2C\n        defenderDcName: payload.defenderDcName || null\x2C\n        attackType: payload.attackType || 'melee'\x2C\n        attackDice: payload.attackDice || []\x2C\n        defenseDice: payload.defenseDice || []\x2C\n        attackRoll: null\x2C\n        defenseRoll: null\x2C\n        p1Ready: false\x2C\n        p2Ready: false\x2C\n        surgeRemaining: 0\x2C\n        surgesSpent: []\x2C\n        bonusHits: payload.bonusHits || 0\x2C\n        bonusAccuracy: payload.bonusAccuracy || 0\x2C\n        bonusSurge: payload.bonusSurge || 0\x2C\n        bonusBlock: payload.bonusBlock || 0\x2C\n        bonusEvade: payload.bonusEvade || 0\x2C\n        bonusPierce: payload.bonusPierce || 0\x2C\n        bonusBlast: payload.bonusBlast || 0\x2C\n        ...(payload.extra || {})\x2C\n      }\x2C\n    };\n  }\x2C\n\n  CombatPlayerReady(state\x2C payload) {\n    const readyKey = payload.playerNum === 1 ? 'p1Ready' : 'p2Ready';\n    return {\n      ...state\x2C\n      pendingCombat: {\n        ...state.pendingCombat\x2C\n        [readyKey]: true\x2C\n      }\x2C\n    };\n  }\x2C\n\n  CombatDiceRolled(state\x2C payload) {\n    const updates = {};\n    if (payload.side === 'attack') {\n      updates.attackRoll = payload.dice;\n    } else {\n      updates.defenseRoll = payload.dice;\n    }\n    return {\n      ...state\x2C\n      pendingCombat: {\n        ...state.pendingCombat\x2C\n        ...updates\x2C\n      }\x2C\n    };\n  }\x2C\n\n  CombatRerollPerformed(state\x2C payload) {\n    const rollKey = payload.side === 'attack' ? 'attackRoll' : 'defenseRoll';\n    const newRoll = [...state.pendingCombat[rollKey]];\n    newRoll[payload.dieIndex] = {\n      ...newRoll[payload.dieIndex]\x2C\n      face: payload.newFace\x2C\n    };\n    return {\n      ...state\x2C\n      pendingCombat: {\n        ...state.pendingCombat\x2C\n        [rollKey]: newRoll\x2C\n      }\x2C\n    };\n  }\x2C\n\n  CombatSurgeSpent(state\x2C payload) {\n    return {\n      ...state\x2C\n      pendingCombat: {\n        ...state.pendingCombat\x2C\n        surgeRemaining: state.pendingCombat.surgeRemaining - (payload.cost || 1)\x2C\n        surgesSpent: [...state.pendingCombat.surgesSpent\x2C payload.surgeKey]\x2C\n      }\x2C\n    };\n  }\x2C\n\n  CombatPassiveApplied(state\x2C payload) {\n    const bonus = {};\n    if (payload.effect) {\n      for (const [key\x2C value] of Object.entries(payload.effect)) {\n        bonus[key] = (state.pendingCombat[key] || 0) + value;\n      }\n    }\n    return {\n      ...state\x2C\n      pendingCombat: {\n        ...state.pendingCombat\x2C\n        ...bonus\x2C\n      }\x2C\n    };\n  }\x2C\n\n  CombatTokenApplied(state\x2C payload) {\n    const bonus = {};\n    if (payload.effect) {\n      for (const [key\x2C value] of Object.entries(payload.effect)) {\n        bonus[key] = (state.pendingCombat[key] || 0) + value;\n      }\n    }\n    return {\n      ...state\x2C\n      pendingCombat: {\n        ...state.pendingCombat\x2C\n        ...bonus\x2C\n      }\x2C\n    };\n  }\x2C\n\n  CombatDamageCalculated(state\x2C payload) {\n    return {\n      ...state\x2C\n      pendingCombat: {\n        ...state.pendingCombat\x2C\n        totalDamage: payload.totalDamage\x2C\n        totalBlock: payload.totalBlock\x2C\n        netDamage: payload.netDamage\x2C\n      }\x2C\n    };\n  }\x2C\n\n  CombatResolved(state\x2C payload) {\n    const next = { ...state };\n    delete next.pendingCombat;\n    return next;\n  }\x2C\n\n  CombatCancelled(state) {\n    const next = { ...state };\n    delete next.pendingCombat;\n    return next;\n  }\x2C\n\n  CleaveTargetSelected(state\x2C payload) {\n    return {\n      ...state\x2C\n      lastCleaveTarget: payload.targetFigureKey\x2C\n      lastCleaveDamage: payload.cleaveDamage\x2C\n    };\n  }\x2C\n};\n
