script-source,430,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/undici/lib/web/cookies/index.js,'use strict'\n\nconst { parseSetCookie } = require('./parse')\nconst { stringify } = require('./util')\nconst { webidl } = require('../fetch/webidl')\nconst { Headers } = require('../fetch/headers')\n\n/**\n * @typedef {Object} Cookie\n * @property {string} name\n * @property {string} value\n * @property {Date|number|undefined} expires\n * @property {number|undefined} maxAge\n * @property {string|undefined} domain\n * @property {string|undefined} path\n * @property {boolean|undefined} secure\n * @property {boolean|undefined} httpOnly\n * @property {'Strict'|'Lax'|'None'} sameSite\n * @property {string[]} unparsed\n */\n\n/**\n * @param {Headers} headers\n * @returns {Record<string\x2C string>}\n */\nfunction getCookies (headers) {\n  webidl.argumentLengthCheck(arguments\x2C 1\x2C 'getCookies')\n\n  webidl.brandCheck(headers\x2C Headers\x2C { strict: false })\n\n  const cookie = headers.get('cookie')\n  const out = {}\n\n  if (!cookie) {\n    return out\n  }\n\n  for (const piece of cookie.split(';')) {\n    const [name\x2C ...value] = piece.split('=')\n\n    out[name.trim()] = value.join('=')\n  }\n\n  return out\n}\n\n/**\n * @param {Headers} headers\n * @param {string} name\n * @param {{ path?: string\x2C domain?: string }|undefined} attributes\n * @returns {void}\n */\nfunction deleteCookie (headers\x2C name\x2C attributes) {\n  webidl.brandCheck(headers\x2C Headers\x2C { strict: false })\n\n  const prefix = 'deleteCookie'\n  webidl.argumentLengthCheck(arguments\x2C 2\x2C prefix)\n\n  name = webidl.converters.DOMString(name\x2C prefix\x2C 'name')\n  attributes = webidl.converters.DeleteCookieAttributes(attributes)\n\n  // Matches behavior of\n  // https://github.com/denoland/deno_std/blob/63827b16330b82489a04614027c33b7904e08be5/http/cookie.ts#L278\n  setCookie(headers\x2C {\n    name\x2C\n    value: ''\x2C\n    expires: new Date(0)\x2C\n    ...attributes\n  })\n}\n\n/**\n * @param {Headers} headers\n * @returns {Cookie[]}\n */\nfunction getSetCookies (headers) {\n  webidl.argumentLengthCheck(arguments\x2C 1\x2C 'getSetCookies')\n\n  webidl.brandCheck(headers\x2C Headers\x2C { strict: false })\n\n  const cookies = headers.getSetCookie()\n\n  if (!cookies) {\n    return []\n  }\n\n  return cookies.map((pair) => parseSetCookie(pair))\n}\n\n/**\n * @param {Headers} headers\n * @param {Cookie} cookie\n * @returns {void}\n */\nfunction setCookie (headers\x2C cookie) {\n  webidl.argumentLengthCheck(arguments\x2C 2\x2C 'setCookie')\n\n  webidl.brandCheck(headers\x2C Headers\x2C { strict: false })\n\n  cookie = webidl.converters.Cookie(cookie)\n\n  const str = stringify(cookie)\n\n  if (str) {\n    headers.append('Set-Cookie'\x2C str)\n  }\n}\n\nwebidl.converters.DeleteCookieAttributes = webidl.dictionaryConverter([\n  {\n    converter: webidl.nullableConverter(webidl.converters.DOMString)\x2C\n    key: 'path'\x2C\n    defaultValue: () => null\n  }\x2C\n  {\n    converter: webidl.nullableConverter(webidl.converters.DOMString)\x2C\n    key: 'domain'\x2C\n    defaultValue: () => null\n  }\n])\n\nwebidl.converters.Cookie = webidl.dictionaryConverter([\n  {\n    converter: webidl.converters.DOMString\x2C\n    key: 'name'\n  }\x2C\n  {\n    converter: webidl.converters.DOMString\x2C\n    key: 'value'\n  }\x2C\n  {\n    converter: webidl.nullableConverter((value) => {\n      if (typeof value === 'number') {\n        return webidl.converters['unsigned long long'](value)\n      }\n\n      return new Date(value)\n    })\x2C\n    key: 'expires'\x2C\n    defaultValue: () => null\n  }\x2C\n  {\n    converter: webidl.nullableConverter(webidl.converters['long long'])\x2C\n    key: 'maxAge'\x2C\n    defaultValue: () => null\n  }\x2C\n  {\n    converter: webidl.nullableConverter(webidl.converters.DOMString)\x2C\n    key: 'domain'\x2C\n    defaultValue: () => null\n  }\x2C\n  {\n    converter: webidl.nullableConverter(webidl.converters.DOMString)\x2C\n    key: 'path'\x2C\n    defaultValue: () => null\n  }\x2C\n  {\n    converter: webidl.nullableConverter(webidl.converters.boolean)\x2C\n    key: 'secure'\x2C\n    defaultValue: () => null\n  }\x2C\n  {\n    converter: webidl.nullableConverter(webidl.converters.boolean)\x2C\n    key: 'httpOnly'\x2C\n    defaultValue: () => null\n  }\x2C\n  {\n    converter: webidl.converters.USVString\x2C\n    key: 'sameSite'\x2C\n    allowedValues: ['Strict'\x2C 'Lax'\x2C 'None']\n  }\x2C\n  {\n    converter: webidl.sequenceConverter(webidl.converters.DOMString)\x2C\n    key: 'unparsed'\x2C\n    defaultValue: () => new Array(0)\n  }\n])\n\nmodule.exports = {\n  getCookies\x2C\n  deleteCookie\x2C\n  getSetCookies\x2C\n  setCookie\n}\n
