script-source,132,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/domain/reducer/phase-reducer.js,import {\n  ROUND_OBJECT_FLAGS\x2C\n  ROUND_NULL_FLAGS\x2C\n  ROUND_ARRAY_FLAGS\x2C\n  ROUND_FALSE_FLAGS\x2C\n  ROUND_DELETE_FLAGS\x2C\n} from '../../game/activation-state.js';\n\nexport const phaseReducerHandlers = {\n  GameCreated(state\x2C payload) {\n    return {\n      ...(state || {})\x2C\n      gameId: payload.generalId\x2C\n      player1Id: payload.player1Id\x2C\n      player2Id: payload.player2Id\x2C\n      generalId: payload.generalId\x2C\n      gameCategoryId: payload.gameCategoryId || null\x2C\n      phase: 'map_selection'\x2C\n      player1VP: { total: 0\x2C kills: 0\x2C objectives: 0 }\x2C\n      player2VP: { total: 0\x2C kills: 0\x2C objectives: 0 }\x2C\n      p1DcList: []\x2C\n      p2DcList: []\x2C\n    };\n  }\x2C\n\n  MapSelected(state\x2C payload) {\n    return {\n      ...state\x2C\n      selectedMap: payload.mapId\x2C\n      selectedMission: payload.missionVariant || null\x2C\n      phase: 'initiative'\x2C\n    };\n  }\x2C\n\n  InitiativeDetermined(state\x2C payload) {\n    return {\n      ...state\x2C\n      initiativePlayerNum: payload.initiativePlayerNum\x2C\n      phase: 'zone_selection'\x2C\n    };\n  }\x2C\n\n  DeploymentZoneChosen(state\x2C payload) {\n    const key = payload.playerNum === 1 ? 'player1DeploymentZone' : 'player2DeploymentZone';\n    return {\n      ...state\x2C\n      [key]: payload.zoneId\x2C\n      phase: 'deployment'\x2C\n    };\n  }\x2C\n\n  DeploymentCompleted(state\x2C payload) {\n    const key = payload.playerNum === 1 ? 'player1Deployed' : 'player2Deployed';\n    return {\n      ...state\x2C\n      [key]: true\x2C\n    };\n  }\x2C\n\n  AttachmentsConfirmed(state\x2C payload) {\n    return {\n      ...state\x2C\n      setupAttachmentConfirmed: true\x2C\n    };\n  }\x2C\n\n  CommandCardsDrawn(state\x2C payload) {\n    const key = payload.playerNum === 1 ? 'player1CcDrawn' : 'player2CcDrawn';\n    return {\n      ...state\x2C\n      [key]: true\x2C\n    };\n  }\x2C\n\n  RoundStarted(state\x2C payload) {\n    const next = { ...state };\n    next.currentRound = payload.roundNumber;\n    next.phase = 'round_active';\n    next.roundPhase = 'start_of_round';\n    for (const key of ROUND_OBJECT_FLAGS) {\n      next[key] = {};\n    }\n    for (const key of ROUND_NULL_FLAGS) {\n      next[key] = null;\n    }\n    for (const key of ROUND_ARRAY_FLAGS) {\n      next[key] = [];\n    }\n    for (const key of ROUND_FALSE_FLAGS) {\n      next[key] = false;\n    }\n    for (const key of ROUND_DELETE_FLAGS) {\n      delete next[key];\n    }\n    return next;\n  }\x2C\n\n  ActivationPhaseStarted(state\x2C payload) {\n    return {\n      ...state\x2C\n      roundPhase: 'activation'\x2C\n      currentActivationTurnPlayerId: payload.activePlayerId || null\x2C\n    };\n  }\x2C\n\n  ActivationPhaseEnded(state) {\n    return {\n      ...state\x2C\n      player1ActivationPhaseEnded: true\x2C\n      player2ActivationPhaseEnded: true\x2C\n    };\n  }\x2C\n\n  EndOfRoundStarted(state) {\n    return {\n      ...state\x2C\n      roundPhase: 'end_of_round'\x2C\n    };\n  }\x2C\n\n  RoundEnded(state) {\n    return {\n      ...state\x2C\n      roundPhase: null\x2C\n    };\n  }\x2C\n\n  GameEnded(state\x2C payload) {\n    return {\n      ...state\x2C\n      ended: true\x2C\n      winnerId: payload.winnerId\x2C\n      phase: 'ended'\x2C\n    };\n  }\x2C\n\n  PhaseGateOpened(state\x2C payload) {\n    return {\n      ...state\x2C\n      phaseGate: {\n        phase: payload.gateType\x2C\n        p1Ready: false\x2C\n        p2Ready: false\x2C\n      }\x2C\n    };\n  }\x2C\n\n  PhaseGatePlayerReady(state\x2C payload) {\n    const readyKey = payload.playerNum === 1 ? 'p1Ready' : 'p2Ready';\n    return {\n      ...state\x2C\n      phaseGate: {\n        ...state.phaseGate\x2C\n        [readyKey]: true\x2C\n      }\x2C\n    };\n  }\x2C\n\n  PhaseGateCleared(state) {\n    const next = { ...state };\n    delete next.phaseGate;\n    return next;\n  }\x2C\n};\n
