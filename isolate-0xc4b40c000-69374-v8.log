script-source,387,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/undici/lib/mock/pending-interceptors-formatter.js,'use strict'\n\nconst { Transform } = require('node:stream')\nconst { Console } = require('node:console')\n\nconst PERSISTENT = process.versions.icu ? '\u2705' : 'Y '\nconst NOT_PERSISTENT = process.versions.icu ? '\u274c' : 'N '\n\n/**\n * Gets the output of `console.table(\u2026)` as a string.\n */\nmodule.exports = class PendingInterceptorsFormatter {\n  constructor ({ disableColors } = {}) {\n    this.transform = new Transform({\n      transform (chunk\x2C _enc\x2C cb) {\n        cb(null\x2C chunk)\n      }\n    })\n\n    this.logger = new Console({\n      stdout: this.transform\x2C\n      inspectOptions: {\n        colors: !disableColors && !process.env.CI\n      }\n    })\n  }\n\n  format (pendingInterceptors) {\n    const withPrettyHeaders = pendingInterceptors.map(\n      ({ method\x2C path\x2C data: { statusCode }\x2C persist\x2C times\x2C timesInvoked\x2C origin }) => ({\n        Method: method\x2C\n        Origin: origin\x2C\n        Path: path\x2C\n        'Status code': statusCode\x2C\n        Persistent: persist ? PERSISTENT : NOT_PERSISTENT\x2C\n        Invocations: timesInvoked\x2C\n        Remaining: persist ? Infinity : times - timesInvoked\n      }))\n\n    this.logger.table(withPrettyHeaders)\n    return this.transform.read().toString()\n  }\n}\n
