code-creation,Script,9,233098,0x3f05b9290a40,59, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/interact.js:1:1,0x3e1e4d0b24e0,~
script-source,203,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/interact.js,/**\n * Interact handlers: interact_cancel_\x2C interact_choice_\n */\nimport { getPlayerId\x2C getDcList\x2C getDcMessageIds } from '../game/player-helpers.js';\nimport { isDcCompanion } from '../data-loader.js';\nimport { discordCatch } from '../error-handling.js';\nimport { requireGame } from '../utils/guards.js';\n\nconst FIGURE_LETTERS = 'abcdefghij';\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C dcMessageMeta\n */\nexport async function handleInteractCancel(interaction\x2C ctx) {\n  const { getGame\x2C dcMessageMeta } = ctx;\n  const match = interaction.customId.match(/^interact_cancel_([^_]+)_(.+)_(\\d+)$/);\n  if (!match) return;\n  const [\x2C gameId\x2C msgId\x2C figureIdxStr] = match;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game) return;\n  const meta = dcMessageMeta.get(msgId);\n  if (!meta || meta.gameId !== gameId) return;\n  const ownerId = getPlayerId(game\x2C meta.playerNum);\n  if (interaction.user.id !== ownerId) return;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C dcMessageMeta\x2C getLegalInteractOptions\x2C getDcStats\x2C updateDcActionsMessage\x2C logGameAction\x2C saveGames\x2C pushUndo\n */\nexport async function handleInteractChoice(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    dcMessageMeta\x2C\n    getLegalInteractOptions\x2C\n    getDcStats\x2C\n    updateDcActionsMessage\x2C\n    logGameAction\x2C\n    saveGames\x2C\n    pushUndo\x2C\n  } = ctx;\n  const match = interaction.customId.match(/^interact_choice_([^_]+)_(.+)_(\\d+)_(.+)$/);\n  if (!match) return;\n  const [\x2C gameId\x2C msgId\x2C figureIdxStr\x2C optionId] = match;\n  const figureIndex = parseInt(figureIdxStr\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const meta = dcMessageMeta.get(msgId);\n  if (!meta || meta.gameId !== gameId) {\n    await interaction.followUp({ content: 'Invalid.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const ownerId = getPlayerId(game\x2C meta.playerNum);\n  if (interaction.user.id !== ownerId) {\n    await interaction.followUp({ content: 'Only the owner can perform this action.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // G48: Companion figures cannot interact (includes retrieve)\n  if (isDcCompanion(meta.dcName)) {\n    await interaction.followUp({ content: 'Companion figures cannot interact.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const actionsData = game.dcActionsData?.[msgId];\n  const previousRemaining = actionsData?.remaining ?? 2;\n  if (previousRemaining <= 0) {\n    await interaction.followUp({ content: 'No actions remaining this activation.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const dgIndex = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? 1;\n  const figureKey = `${meta.dcName}-${dgIndex}-${figureIndex}`;\n  const playerNum = meta.playerNum;\n  const mapId = game.selectedMap?.id;\n  const options = mapId ? getLegalInteractOptions(game\x2C playerNum\x2C figureKey\x2C mapId) : [];\n  const opt = options.find((o) => o.id === optionId);\n  if (!opt) {\n    await interaction.followUp({ content: 'That interact is no longer valid.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // F14: Snapshot state before mutate for undo\n  const previousContraband = optionId === 'retrieve_contraband' ? game.figureContraband?.[figureKey] : undefined;\n  let previousLaunchPanelState;\n  let previousOpenedDoors;\n  let previousP1LaunchFlipped;\n  let previousP2LaunchFlipped;\n  if (optionId.startsWith('launch_panel_')) {\n    const coord = optionId.replace('launch_panel_'\x2C '').split('_')[0]?.toLowerCase();\n    previousLaunchPanelState = coord != null && game.launchPanelState ? game.launchPanelState[coord] : undefined;\n    previousP1LaunchFlipped = game.p1LaunchPanelFlippedThisRound;\n    previousP2LaunchFlipped = game.p2LaunchPanelFlippedThisRound;\n  }\n  if (optionId.startsWith('open_door_')) {\n    previousOpenedDoors = game.openedDoors ? game.openedDoors.slice() : [];\n  }\n\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  actionsData.remaining = Math.max(0\x2C previousRemaining - 1);\n  await updateDcActionsMessage(game\x2C msgId\x2C interaction.client);\n\n  const stats = getDcStats(meta.dcName);\n  const displayName = meta.displayName || meta.dcName;\n  const shortName = (displayName || meta.dcName || '').replace(/\\s*\\[(?:DG|Group) \\d+\\]$/\x2C '') || displayName;\n  const figLabel = (stats.figures ?? 1) > 1 ? `${shortName} ${dgIndex}${FIGURE_LETTERS[figureIndex] || 'a'}` : shortName;\n  const pLabel = `P${playerNum}`;\n\n  const tokenLabel = typeof ctx.getMissionTokenLabel === 'function' ? ctx.getMissionTokenLabel(game) : 'Mission Token';\n\n  let logMsg = null;\n  if (optionId === 'retrieve_contraband') {\n    game.figureContraband = game.figureContraband || {};\n    game.figureContraband[figureKey] = true;\n    logMsg = await logGameAction(game\x2C interaction.client\x2C `**${pLabel}: ${figLabel}** retrieved **${tokenLabel}**!`\x2C { phase: 'ROUND'\x2C icon: 'deploy' });\n  } else if (optionId.startsWith('launch_panel_')) {\n    const parts = optionId.replace('launch_panel_'\x2C '').split('_');\n    const coord = parts[0];\n    const side = parts[1];\n    game.launchPanelState = game.launchPanelState || {};\n    game.launchPanelState[coord.toLowerCase()] = side;\n    if (playerNum === 1) game.p1LaunchPanelFlippedThisRound = true;\n    else game.p2LaunchPanelFlippedThisRound = true;\n    const upper = String(coord).toUpperCase();\n    logMsg = await logGameAction(game\x2C interaction.client\x2C `**${pLabel}: ${figLabel}** flipped **${tokenLabel}** (${upper}) to **${side}**.`\x2C { phase: 'ROUND'\x2C icon: 'deploy' });\n  } else if (optionId === 'use_terminal') {\n    logMsg = await logGameAction(game\x2C interaction.client\x2C `**${pLabel}: ${figLabel}** used terminal.`\x2C { phase: 'ROUND'\x2C icon: 'deploy' });\n  } else if (optionId.startsWith('open_door_')) {\n    // Door ID may contain multiple comma-separated edge keys for multi-space doors\n    const edgeKeys = optionId.replace('open_door_'\x2C '').split('\x2C');\n    game.openedDoors = game.openedDoors || [];\n    for (const ek of edgeKeys) {\n      if (!game.openedDoors.includes(ek)) game.openedDoors.push(ek);\n    }\n    const doorLabel = edgeKeys[0].split('|').map((s) => s.toUpperCase()).join('\u2013');\n    logMsg = await logGameAction(game\x2C interaction.client\x2C `**${pLabel}: ${figLabel}** opened door (${doorLabel}).`\x2C { phase: 'ROUND'\x2C icon: 'deploy' });\n  } else {\n    logMsg = await logGameAction(game\x2C interaction.client\x2C `**${pLabel}: ${figLabel}** \u2014 ${opt.label}.`\x2C { phase: 'ROUND'\x2C icon: 'deploy' });\n  }\n\n  if (pushUndo) {\n    pushUndo(game\x2C {\n      type: 'interact'\x2C\n      gameId: game.gameId\x2C\n      msgId\x2C\n      figureIndex\x2C\n      optionId\x2C\n      figureKey\x2C\n      previousRemaining\x2C\n      previousContraband\x2C\n      previousLaunchPanelState\x2C\n      previousOpenedDoors\x2C\n      previousP1LaunchFlipped\x2C\n      previousP2LaunchFlipped\x2C\n      launchPanelCoord: optionId.startsWith('launch_panel_') ? optionId.replace('launch_panel_'\x2C '').split('_')[0]?.toLowerCase() : undefined\x2C\n      openDoorEdgeKey: optionId.startsWith('open_door_') ? optionId.replace('open_door_'\x2C '') : undefined\x2C\n      gameLogMessageId: logMsg?.id\x2C\n    });\n  }\n  // Bleeding: trigger after Interact action resolves\n  if ((game.figureConditions?.[figureKey] || []).includes('Bleed') && ctx.sendBleedingPrompt) {\n    await ctx.sendBleedingPrompt(game\x2C interaction.channel\x2C figureKey\x2C playerNum\x2C displayName);\n  }\n  // Curious (Loth-cat E/R): after interact\x2C suffer 1 Strain (= 1 HP damage)\n  if (ctx.getDcEffects) {\n    const _curEff = ctx.getDcEffects()?.[meta.dcName];\n    if ((_curEff?.passives || []).includes('Curious')) {\n      const _curMsgId = msgId;\n      const _curHS = ctx.dcHealthState?.get(_curMsgId);\n      if (_curHS?.[figureIndex]) {\n        const [_curCur\x2C _curMax] = _curHS[figureIndex];\n        const _curNew = Math.max(0\x2C (_curCur || 0) - 1);\n        _curHS[figureIndex] = [_curNew\x2C _curMax || _curCur];\n        ctx.dcHealthState?.set(_curMsgId\x2C _curHS);\n        const dcList = getDcList(game\x2C playerNum);\n        const dcIds = getDcMessageIds(game\x2C playerNum) || [];\n        const _curIdx = dcIds.indexOf(_curMsgId);\n        if (_curIdx >= 0 && dcList?.[_curIdx]) dcList[_curIdx].healthState = [..._curHS];\n        await logGameAction(game\x2C interaction.client\x2C `\ud83d\ude3f **Curious** \u2014 **${shortName}** suffers 1 Strain after interacting.`\x2C { phase: 'ROUND'\x2C icon: 'activate' });\n      }\n    }\n  }\n  saveGames();\n}\n
