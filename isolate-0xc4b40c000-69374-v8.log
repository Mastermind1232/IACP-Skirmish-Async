script-source,218,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/phase-gate.js,/**\n * Phase gate state management and getWaitingPlayers utility.\n * Pure logic \u2014 no Discord dependencies.\n */\nimport { getPlayerId\x2C getHandChannelId\x2C opponentPlayerNum } from './player-helpers.js';\nimport { PHASES\x2C ROUND_PHASES } from './phase.js';\n\n// \u2500\u2500 Phase gate labels \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nexport const PHASE_GATE_LABELS = {\n  deploy_done:          'Currently in Deployment. Ready to proceed to Command Card Draw?'\x2C\n  attach_done:          'Currently in Attachments. Ready to proceed to Deployment?'\x2C\n  cc_drawn:             'Currently in Command Card Draw. Ready to proceed to Round {round}?'\x2C\n  pre_end_of_round:     'Currently in Round {round} Activation. Ready to proceed to End of Round?'\x2C\n  post_end_of_round:    'Currently in Round {round} End of Round. Ready to proceed to Status Phase?'\x2C\n  post_start_of_round:  'Currently in Round {round} Start of Round. Effects resolved \\u2014 ready to proceed?'\x2C\n  pre_activation:       'Currently in Round {round} Start of Round. Ready to begin Activation?'\x2C\n};\n\n// \u2500\u2500 State management \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Initialize a phase gate on the game object.\n * @param {object} game\n * @param {string} phase - One of the PHASE_GATE_LABELS keys\n */\nexport function createPhaseGate(game\x2C phase) {\n  game.phaseGate = {\n    phase\x2C\n    p1Ready: false\x2C\n    p2Ready: false\x2C\n    p1MsgId: null\x2C\n    p2MsgId: null\x2C\n  };\n}\n\n/**\n * Mark a player as ready. Handles test game (P1 acts for both).\n * @param {object} game\n * @param {string} userId\n * @returns {{ alreadyReady: boolean\x2C bothReady: boolean\x2C playerNum: number }}\n */\nexport function recordPhaseGateReady(game\x2C userId) {\n  const gate = game.phaseGate;\n  let playerNum = playerNumFromId(game\x2C userId);\n\n  // Test game: P1 clicks for both \u2014 first click = P1\x2C second = P2\n  if (game.isTestGame && playerNum === 1) {\n    playerNum = gate.p1Ready ? 2 : 1;\n  }\n\n  const key = playerNum === 1 ? 'p1Ready' : 'p2Ready';\n  if (gate[key]) {\n    return { alreadyReady: true\x2C bothReady: false\x2C playerNum };\n  }\n\n  gate[key] = true;\n  const bothReady = gate.p1Ready && gate.p2Ready;\n  return { alreadyReady: false\x2C bothReady\x2C playerNum };\n}\n\n/**\n * Mark a player as unready. Handles test game (un-readies last readied).\n * @param {object} game\n * @param {string} userId\n * @returns {{ alreadyUnready: boolean\x2C playerNum: number }}\n */\nexport function recordPhaseGateUnready(game\x2C userId) {\n  const gate = game.phaseGate;\n  let playerNum = playerNumFromId(game\x2C userId);\n\n  // Test game: P1 acts for both \u2014 un-ready the last one that was readied\n  if (game.isTestGame && playerNum === 1) {\n    if (gate.p2Ready) playerNum = 2;\n    else playerNum = 1;\n  }\n\n  const key = playerNum === 1 ? 'p1Ready' : 'p2Ready';\n  if (!gate[key]) {\n    return { alreadyUnready: true\x2C playerNum };\n  }\n\n  gate[key] = false;\n  return { alreadyUnready: false\x2C playerNum };\n}\n\n/**\n * Clear the phase gate from the game object.\n * @param {object} game\n */\nexport function clearPhaseGate(game) {\n  game.phaseGate = null;\n}\n\n// \u2500\u2500 getWaitingPlayers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Compute waiting players for round_active sub-states (combat\x2C movement\x2C etc.).\n * @param {object} game\n * @returns {{ waitType: string\x2C description: string\x2C playerNums: number[] }}\n */\nfunction computeRoundActiveWaiting(game) {\n  // pendingCombat \u2014 combat sub-phase gate (both must confirm)\n  if (game.pendingCombat?.combatGate) {\n    const gate = game.pendingCombat.combatGate;\n    const waiting = [];\n    if (!gate.p1Ready) waiting.push(1);\n    if (!gate.p2Ready) waiting.push(2);\n    return { waitType: 'combatGate'\x2C description: `Combat gate: ${gate.phase}`\x2C playerNums: waiting };\n  }\n\n  // pendingCombat \u2014 not both ready\n  if (game.pendingCombat && (!game.pendingCombat.p1Ready || !game.pendingCombat.p2Ready)) {\n    const waiting = [];\n    if (!game.pendingCombat.p1Ready) waiting.push(1);\n    if (!game.pendingCombat.p2Ready) waiting.push(2);\n    return { waitType: 'combatReady'\x2C description: 'Waiting for combat ready'\x2C playerNums: waiting };\n  }\n\n  // pendingCombat \u2014 reroll phase\n  if (game.pendingCombat?.rerollPhase) {\n    const rp = game.pendingCombat.rerollPhase;\n    const attackerPn = game.pendingCombat.attackerPlayerNum || 1;\n    const defenderPn = opponentPlayerNum(attackerPn);\n    const pn = rp === 'attacker' ? attackerPn : defenderPn;\n    return { waitType: 'combatReroll'\x2C description: 'Reroll decision'\x2C playerNums: [pn] };\n  }\n\n  // pendingCombat \u2014 rolls done\x2C no reroll\n  if (game.pendingCombat?.attackRoll && game.pendingCombat?.defenseRoll) {\n    return { waitType: 'combatResolution'\x2C description: 'Combat resolution in progress'\x2C playerNums: [1\x2C 2] };\n  }\n\n  // pendingNegation\n  if (game.pendingNegation) {\n    const oppPn = opponentPlayerNum(game.pendingNegation.playedBy);\n    return { waitType: 'negation'\x2C description: 'Negation window'\x2C playerNums: [oppPn] };\n  }\n\n  // forceVisionPending\n  if (game.forceVisionPending) {\n    return { waitType: 'forceVision'\x2C description: 'Force Vision pick'\x2C playerNums: [game.forceVisionPending] };\n  }\n\n  // endOfRoundWhoseTurn\n  if (game.endOfRoundWhoseTurn) {\n    const pn = game.endOfRoundWhoseTurn === game.player1Id ? 1 : 2;\n    return { waitType: 'eorWindow'\x2C description: 'End of Round window'\x2C playerNums: [pn] };\n  }\n\n  // pendingStartOfRoundResolve\n  if ((game.pendingStartOfRoundResolve || 0) > 0) {\n    const waiting = [];\n    if (game.pendingRogueOne_p1) waiting.push(1);\n    if (game.pendingRogueOne_p2) waiting.push(2);\n    return { waitType: 'sorEffect'\x2C description: 'Start-of-round effects'\x2C playerNums: waiting.length ? waiting : [1\x2C 2] };\n  }\n\n  // pendingEndTurn\n  if (game.pendingEndTurn && Object.keys(game.pendingEndTurn).length > 0) {\n    const pns = new Set();\n    for (const entry of Object.values(game.pendingEndTurn)) {\n      if (entry.playerNum) pns.add(entry.playerNum);\n    }\n    return { waitType: 'endTurn'\x2C description: 'End Turn confirmation'\x2C playerNums: pns.size ? [...pns] : [1\x2C 2] };\n  }\n\n  // moveInProgress\n  if (game.moveInProgress && Object.keys(game.moveInProgress).length > 0) {\n    const pns = new Set();\n    for (const ms of Object.values(game.moveInProgress)) {\n      if (ms?.playerNum) pns.add(ms.playerNum);\n    }\n    return { waitType: 'movement'\x2C description: 'Movement in progress'\x2C playerNums: pns.size ? [...pns] : [1\x2C 2] };\n  }\n\n  // currentActivationTurnPlayerId\n  if (game.currentActivationTurnPlayerId) {\n    const pn = game.currentActivationTurnPlayerId === game.player1Id ? 1 : 2;\n    return { waitType: 'activation'\x2C description: 'Activation turn'\x2C playerNums: [pn] };\n  }\n\n  return { waitType: 'unknown'\x2C description: 'Game active'\x2C playerNums: [1\x2C 2] };\n}\n\n/**\n * Legacy flag-based getWaitingPlayers for unmigrated games (no game.phase).\n * @param {object} game\n * @returns {{ waitType: string\x2C description: string\x2C playerNums: number[] }}\n */\nfunction getWaitingPlayersLegacy(game) {\n  // pendingCombat \u2014 combat sub-phase gate\n  if (game.pendingCombat?.combatGate) {\n    const gate = game.pendingCombat.combatGate;\n    const waiting = [];\n    if (!gate.p1Ready) waiting.push(1);\n    if (!gate.p2Ready) waiting.push(2);\n    return { waitType: 'combatGate'\x2C description: `Combat gate: ${gate.phase}`\x2C playerNums: waiting };\n  }\n  // pendingCombat \u2014 not both ready\n  if (game.pendingCombat && (!game.pendingCombat.p1Ready || !game.pendingCombat.p2Ready)) {\n    const waiting = [];\n    if (!game.pendingCombat.p1Ready) waiting.push(1);\n    if (!game.pendingCombat.p2Ready) waiting.push(2);\n    return { waitType: 'combatReady'\x2C description: 'Waiting for combat ready'\x2C playerNums: waiting };\n  }\n  if (game.pendingCombat?.rerollPhase) {\n    const rp = game.pendingCombat.rerollPhase;\n    const attackerPn = game.pendingCombat.attackerPlayerNum || 1;\n    const defenderPn = opponentPlayerNum(attackerPn);\n    const pn = rp === 'attacker' ? attackerPn : defenderPn;\n    return { waitType: 'combatReroll'\x2C description: 'Reroll decision'\x2C playerNums: [pn] };\n  }\n  if (game.pendingCombat?.attackRoll && game.pendingCombat?.defenseRoll) {\n    return { waitType: 'combatResolution'\x2C description: 'Combat resolution in progress'\x2C playerNums: [1\x2C 2] };\n  }\n  if (game.pendingNegation) {\n    const oppPn = opponentPlayerNum(game.pendingNegation.playedBy);\n    return { waitType: 'negation'\x2C description: 'Negation window'\x2C playerNums: [oppPn] };\n  }\n  if (game.forceVisionPending) {\n    return { waitType: 'forceVision'\x2C description: 'Force Vision pick'\x2C playerNums: [game.forceVisionPending] };\n  }\n  if (game.setupAttachmentPhase) {\n    const waiting = [];\n    if (!game.setupAttachmentConfirmed?.[1]) waiting.push(1);\n    if (!game.setupAttachmentConfirmed?.[2]) waiting.push(2);\n    return { waitType: 'setupAttach'\x2C description: 'Placing attachments'\x2C playerNums: waiting.length ? waiting : [1\x2C 2] };\n  }\n  if ((game.p1HandId || game.p2HandId) && (!game.player1CcDrawn || !game.player2CcDrawn)) {\n    if (game.initiativePlayerDeployed && game.nonInitiativePlayerDeployed) {\n      const waiting = [];\n      if (!game.player1CcDrawn) waiting.push(1);\n      if (!game.player2CcDrawn) waiting.push(2);\n      return { waitType: 'ccDraw'\x2C description: 'Drawing command cards'\x2C playerNums: waiting };\n    }\n  }\n  if (game.deploymentZoneChosen && (!game.initiativePlayerDeployed || !game.nonInitiativePlayerDeployed)) {\n    const initPn = game.initiativePlayerId === game.player1Id ? 1 : 2;\n    const otherPn = opponentPlayerNum(initPn);\n    if (!game.initiativePlayerDeployed) {\n      return { waitType: 'deploy'\x2C description: 'Deploying figures'\x2C playerNums: [initPn] };\n    }\n    return { waitType: 'deploy'\x2C description: 'Deploying figures'\x2C playerNums: [otherPn] };\n  }\n  if (game.endOfRoundWhoseTurn) {\n    const pn = game.endOfRoundWhoseTurn === game.player1Id ? 1 : 2;\n    return { waitType: 'eorWindow'\x2C description: 'End of Round window'\x2C playerNums: [pn] };\n  }\n  if ((game.pendingStartOfRoundResolve || 0) > 0) {\n    const waiting = [];\n    if (game.pendingRogueOne_p1) waiting.push(1);\n    if (game.pendingRogueOne_p2) waiting.push(2);\n    return { waitType: 'sorEffect'\x2C description: 'Start-of-round effects'\x2C playerNums: waiting.length ? waiting : [1\x2C 2] };\n  }\n  if (game.pendingEndTurn && Object.keys(game.pendingEndTurn).length > 0) {\n    const pns = new Set();\n    for (const entry of Object.values(game.pendingEndTurn)) {\n      if (entry.playerNum) pns.add(entry.playerNum);\n    }\n    return { waitType: 'endTurn'\x2C description: 'End Turn confirmation'\x2C playerNums: pns.size ? [...pns] : [1\x2C 2] };\n  }\n  if (game.moveInProgress && Object.keys(game.moveInProgress).length > 0) {\n    const pns = new Set();\n    for (const ms of Object.values(game.moveInProgress)) {\n      if (ms?.playerNum) pns.add(ms.playerNum);\n    }\n    return { waitType: 'movement'\x2C description: 'Movement in progress'\x2C playerNums: pns.size ? [...pns] : [1\x2C 2] };\n  }\n  if (game.currentActivationTurnPlayerId) {\n    const pn = game.currentActivationTurnPlayerId === game.player1Id ? 1 : 2;\n    return { waitType: 'activation'\x2C description: 'Activation turn'\x2C playerNums: [pn] };\n  }\n  return { waitType: 'unknown'\x2C description: 'Game active'\x2C playerNums: [1\x2C 2] };\n}\n\n/**\n * Determine who the game is waiting on using phase-based dispatch.\n * Falls back to legacy flag-based chain for unmigrated games.\n * @param {object} game\n * @returns {{ waitType: string\x2C description: string\x2C playerNums: number[] }}\n */\nexport function getWaitingPlayers(game) {\n  // Phase gate always takes priority (blocks all other actions)\n  if (game.phaseGate) {\n    const gate = game.phaseGate;\n    const waiting = [];\n    if (!gate.p1Ready) waiting.push(1);\n    if (!gate.p2Ready) waiting.push(2);\n    const label = (PHASE_GATE_LABELS[gate.phase] || 'Phase gate active')\n      .replace('{round}'\x2C String(game.currentRound || 1));\n    return { waitType: 'phaseGate'\x2C description: label\x2C playerNums: waiting.length ? waiting : [1\x2C 2] };\n  }\n\n  // Legacy fallback for unmigrated games\n  if (!game.phase) {\n    return getWaitingPlayersLegacy(game);\n  }\n\n  switch (game.phase) {\n    case 'lobby':\n    case 'map_selection':\n    case 'initiative':\n      return { waitType: 'setup'\x2C description: 'Game setup in progress'\x2C playerNums: [1\x2C 2] };\n\n    case 'zone_selection': {\n      const chooserId = game.deviousSchemeZoneChooser || game.initiativePlayerId;\n      const chooserPn = chooserId === game.player1Id ? 1 : 2;\n      return { waitType: 'zoneSelection'\x2C description: 'Picking deployment zone'\x2C playerNums: [chooserPn] };\n    }\n\n    case 'deployment': {\n      const initPn = game.initiativePlayerId === game.player1Id ? 1 : 2;\n      const otherPn = opponentPlayerNum(initPn);\n      if (!game.initiativePlayerDeployed) {\n        return { waitType: 'deploy'\x2C description: 'Deploying figures'\x2C playerNums: [initPn] };\n      }\n      return { waitType: 'deploy'\x2C description: 'Deploying figures'\x2C playerNums: [otherPn] };\n    }\n\n    case 'attachment': {\n      const waiting = [];\n      if (!game.setupAttachmentConfirmed?.[1]) waiting.push(1);\n      if (!game.setupAttachmentConfirmed?.[2]) waiting.push(2);\n      return { waitType: 'setupAttach'\x2C description: 'Placing attachments'\x2C playerNums: waiting.length ? waiting : [1\x2C 2] };\n    }\n\n    case 'cc_draw': {\n      const waiting = [];\n      if (!game.player1CcDrawn) waiting.push(1);\n      if (!game.player2CcDrawn) waiting.push(2);\n      return { waitType: 'ccDraw'\x2C description: 'Drawing command cards'\x2C playerNums: waiting.length ? waiting : [1\x2C 2] };\n    }\n\n    case 'round_active':\n      return computeRoundActiveWaiting(game);\n\n    case 'ended':\n      return { waitType: 'ended'\x2C description: 'Game ended'\x2C playerNums: [] };\n\n    default:\n      return { waitType: 'unknown'\x2C description: 'Game active'\x2C playerNums: [1\x2C 2] };\n  }\n}\n\n// \u2500\u2500 Helpers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Get player number (1 or 2) from userId.\n * @param {object} game\n * @param {string} userId\n * @returns {number} 1 or 2\x2C or 0 if not a player\n */\nexport function playerNumFromId(game\x2C userId) {\n  if (userId === game.player1Id) return 1;\n  if (userId === game.player2Id) return 2;\n  return 0;\n}\n
