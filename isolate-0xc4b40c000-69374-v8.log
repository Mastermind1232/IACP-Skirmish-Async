script-source,142,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/domain/events.js,// DomainEvent shape:\n// { type\x2C gameId\x2C seq\x2C timestamp\x2C playerId\x2C correlationId\x2C aggregateVersion\x2C payload }\n\nconst seqCounters = new Map(); // gameId \u2192 next seq (in-memory\x2C loaded from DB in 4.1.3)\n\nexport function createDomainEvent(type\x2C gameId\x2C playerId\x2C payload\x2C meta = {}) {\n  const seq = (seqCounters.get(gameId) || 0) + 1;\n  seqCounters.set(gameId\x2C seq);\n  return {\n    type\x2C\n    gameId\x2C\n    seq\x2C\n    timestamp: new Date().toISOString()\x2C\n    playerId: playerId || null\x2C\n    correlationId: meta.correlationId || null\x2C\n    aggregateVersion: meta.aggregateVersion || seq\x2C\n    payload: payload || {}\x2C\n  };\n}\n\nexport function resetSeqCounter(gameId\x2C startSeq) { seqCounters.set(gameId\x2C startSeq); }\nexport function getSeqCounter(gameId) { return seqCounters.get(gameId) || 0; }\nexport function clearSeqCounter(gameId) { seqCounters.delete(gameId); }\n\n/** Bump seq counter and update the event object in-place (used by retry logic). */\nexport function bumpEventSeq(event) {\n  const next = (seqCounters.get(event.gameId) || event.seq) + 1;\n  seqCounters.set(event.gameId\x2C next);\n  event.seq = next;\n  event.aggregateVersion = next;\n  return event;\n}\n
