code-creation,Script,9,292967,0x3f05b92a0960,76, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/combat-special-effects.js:1:1,0x63270024ba8,~
script-source,247,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/combat-special-effects.js,/**\n * Combat special-effect handlers extracted from index.js:\n * bleed\x2C sidewinder\x2C boltslinger\x2C indiscriminate fire\x2C fighting knife\x2C\n * concussive bolt\x2C spread the pain\x2C missile salvo.\n */\nimport { ButtonBuilder\x2C ActionRowBuilder\x2C ButtonStyle } from 'discord.js';\nimport { splitCustomId } from '../discord/custom-id.js';\nimport { reduceHp\x2C opponentPlayerNum\x2C parseFigureKey\x2C dcNameFromFigureKey\x2C applyCondition } from '../game/index.js';\nimport { getPlayAreaId\x2C getPlayerId\x2C getDcList\x2C getDcMessageIds\x2C ccDeckKey\x2C ccHandKey\x2C ccDiscardKey\x2C pushFigure } from '../game/player-helpers.js';\nimport { getDcKeywords } from '../data-loader.js';\nimport { checkDeckDiscardPassiveRedraws } from '../game/cc-passive-redraw.js';\nimport { discordCatch } from '../error-handling.js';\nimport { requirePlayer } from '../utils/guards.js';\nimport { chunkButtonsToRows } from '../discord/components.js';\nimport { fetchCombatThread\x2C fetchGameChannel\x2C sanitizeMentions } from '../discord/channel-helpers.js';\n\n// \u2500\u2500 Internal helpers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/** Apply Indiscriminate Fire splash damage/strain to all figures within 2 of target. */\nexport async function applyIndiscriminateFireSplash(game\x2C attackerPlayerNum\x2C combatThreadId\x2C die\x2C splashTargets\x2C thread\x2C ctx) {\n  const {\n    client\x2C saveGames\x2C dcMessageMeta\x2C dcHealthState\x2C dcExhaustedState\x2C\n    findDcMessageIdForFigure\x2C renderDcEmbed\x2C getDcEffects\x2C logGameAction\x2C\n    checkWinConditions\x2C processFigureDefeat\x2C\n  } = ctx;\n  const totalDmg = die.dmg || 0;\n  const totalStrain = die.surge || 0;\n  const totalEffect = totalDmg + totalStrain;\n  const dieColor = String(die.color || '').replace(/^\\w/\x2C (c) => c.toUpperCase());\n  const dieDesc = `${dieColor} die (${totalDmg} dmg\x2C ${totalStrain} strain)`;\n  if (splashTargets.length === 0) {\n    await thread.send(`**Indiscriminate Fire** \u2014 ${dieDesc}: No figures within 2 spaces of the target.`).catch(discordCatch);\n    return;\n  }\n  if (totalEffect === 0) {\n    await thread.send(`**Indiscriminate Fire** \u2014 ${dieDesc}: 0 effect on splash targets.`).catch(discordCatch);\n    return;\n  }\n  const lines = [];\n  for (const t of splashTargets) {\n    const mid = findDcMessageIdForFigure(game.gameId\x2C t.playerNum\x2C t.figureKey);\n    if (!mid) continue;\n    const { figureIndex: figIdx } = parseFigureKey(t.figureKey);\n    const { newHp\x2C maxHp: splashMaxHp } = reduceHp(dcHealthState\x2C game\x2C mid\x2C figIdx\x2C totalEffect\x2C t.playerNum);\n    if (splashMaxHp === 0) continue;\n    // Fury of Kashyyyk (army-wide): when a friendly WOOKIEE suffers 3+ damage\x2C become Focused\n    if (totalEffect >= 3 && newHp > 0) {\n      const _fokSplashDcList = getDcList(game\x2C t.playerNum) || [];\n      if (_fokSplashDcList.some(dc => dc.dcName === '[Fury of Kashyyyk]')) {\n        const _fokSplashName = dcNameFromFigureKey(t.figureKey);\n        const _fokSplashKws = (getDcKeywords(game)[_fokSplashName] || []).map(k => String(k).toUpperCase());\n        if (_fokSplashKws.includes('WOOKIEE')) {\n          if (applyCondition(game\x2C t.figureKey\x2C 'Focus')) {\n            await logGameAction(game\x2C client\x2C `**Fury of Kashyyyk** \u2014 **${_fokSplashName}** became **Focused** (suffered ${totalEffect} Damage from Indiscriminate Fire).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n          }\n        }\n      }\n    }\n    const parts = [];\n    if (totalDmg > 0) parts.push(`${totalDmg} Damage`);\n    if (totalStrain > 0) parts.push(`${totalStrain} Strain`);\n    lines.push(`\u2022 **${t.label}** suffers ${parts.join(' + ')}`);\n    if (newHp <= 0) {\n      const defeatResult = processFigureDefeat ? await processFigureDefeat(game\x2C {\n        defeatedPlayerNum: t.playerNum\x2C\n        figureKey: t.figureKey\x2C\n        attackerPlayerNum\x2C\n        source: 'Indiscriminate Fire'\x2C\n      }) : null;\n      const splashVP = defeatResult?.vp ?? 0;\n      lines.push(`  \u2192 **${t.label} defeated!** +${splashVP} VP`);\n    }\n    try {\n      const tMeta = dcMessageMeta.get(mid);\n      if (tMeta) {\n        const ch = await fetchGameChannel(client\x2C getPlayAreaId(game\x2C tMeta.playerNum));\n        const msg = await ch.messages.fetch(mid);\n        const { embed\x2C files } = await renderDcEmbed(game\x2C mid\x2C ctx);\n        await msg.edit({ embeds: [embed]\x2C files }).catch(discordCatch);\n      }\n    } catch {}\n  }\n  const msg = `**Indiscriminate Fire** \u2014 ${dieDesc}:\\n${lines.join('\\n')}`;\n  await thread.send(msg).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `**Indiscriminate Fire** \u2014 ${dieDesc}:\\n${lines.join('\\n')}`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  saveGames();\n}\n\n/** Show next Spread the Pain figure-pick prompt\x2C or finish if all conditions applied. */\nasync function advanceSpreadThePain(game\x2C pending\x2C ctx) {\n  const {\n    client\x2C saveGames\x2C finishCombatResolution\x2C getMapData\x2C getFigureLabel\x2C\n  } = ctx;\n  const thread = await fetchCombatThread(client\x2C pending.combatThreadId);\n  if (!thread) { await finishCombatResolution(game\x2C pending.combat\x2C pending.resultText\x2C new Set(pending.initialEmbedRefreshMsgIds || [])\x2C client); saveGames(); return; }\n  if (pending.conditionIdx >= pending.conditions.length) {\n    delete game.pendingSpreadThePain;\n    await finishCombatResolution(game\x2C pending.combat\x2C pending.resultText\x2C new Set(pending.initialEmbedRefreshMsgIds || [])\x2C client);\n    saveGames();\n    return;\n  }\n  const nextCond = pending.conditions[pending.conditionIdx];\n  const targetPos = game.figurePositions?.[pending.defenderPlayerNum]?.[pending.combat.target?.figureKey];\n  const figuresAtSpaces = [];\n  if (targetPos && game.selectedMap?.id) {\n    const ms = getMapData(game.selectedMap.id);\n    const adjacency = ms?.adjacency || {};\n    const candSpaces = new Set([String(targetPos).toLowerCase()\x2C ...(adjacency[String(targetPos).toLowerCase()] || []).map((s) => String(s).toLowerCase())]);\n    for (const p of [1\x2C 2]) {\n      for (const [figKey\x2C figPos] of Object.entries(game.figurePositions?.[p] || {})) {\n        if (candSpaces.has(String(figPos).toLowerCase())) {\n          const { label } = getFigureLabel(game\x2C p\x2C figKey\x2C undefined\x2C 70);\n          figuresAtSpaces.push({ figureKey: figKey\x2C playerNum: p\x2C label });\n        }\n      }\n    }\n  }\n  if (figuresAtSpaces.length === 0) {\n    delete game.pendingSpreadThePain;\n    await finishCombatResolution(game\x2C pending.combat\x2C pending.resultText\x2C new Set(pending.initialEmbedRefreshMsgIds || [])\x2C client);\n    saveGames();\n    return;\n  }\n  const btns = figuresAtSpaces.slice(0\x2C 4).map((f) =>\n    new ButtonBuilder()\n      .setCustomId(`spread_pain_fig_${game.gameId}_${f.figureKey}`)\n      .setLabel(f.label)\n      .setStyle(f.playerNum === pending.defenderPlayerNum ? ButtonStyle.Danger : ButtonStyle.Secondary)\n  );\n  btns.push(new ButtonBuilder().setCustomId(`spread_pain_skip_${game.gameId}`).setLabel('Skip').setStyle(ButtonStyle.Secondary));\n  await thread.send({\n    content: `<@${pending.ownerId}> **Spread the Pain** \u2014 Apply **${nextCond}** to a figure at or adjacent to target (${String(targetPos).toUpperCase()}):`\x2C\n    allowedMentions: { users: [pending.ownerId] }\x2C\n    components: [new ActionRowBuilder().addComponents(btns)]\x2C\n  }).catch(discordCatch);\n  saveGames();\n}\n\n// \u2500\u2500 Exported handlers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/** Handle bleed_accept_ / bleed_prevent_ button clicks. */\nexport async function handleBleedResolve(interaction\x2C ctx) {\n  const {\n    getGame\x2C saveGames\x2C client\x2C dcMessageMeta\x2C dcHealthState\x2C dcExhaustedState\x2C\n    findDcMessageIdForFigure\x2C renderDcEmbed\x2C logGameAction\x2C calculateKillVp\x2C\n    decrementActivationIfGroupDefeated\x2C checkWinConditions\x2C canActAsPlayer\x2C\n    filterCondition\x2C\n    updateHandVisualMessage\x2C updateDiscardPileMessage\x2C\n    processFigureDefeat\x2C\n  } = ctx;\n  const match = interaction.customId.match(/^bleed_(accept|prevent)_(\\d+)_(1|2)_(.+)$/);\n  if (!match) return;\n  const [\x2C action\x2C gameId\x2C playerNumStr\x2C figureKey] = match;\n  const playerNum = parseInt(playerNumStr\x2C 10);\n  const game = getGame(gameId);\n  if (!game) {\n    await interaction.followUp({ content: 'Game not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const playerId = getPlayerId(game\x2C playerNum);\n  if (interaction.user.id !== playerId && !game.isTestGame) {\n    await interaction.followUp({ content: 'Only the figure owner can resolve Bleeding.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const msgId = findDcMessageIdForFigure(gameId\x2C playerNum\x2C figureKey);\n  const { figureIndex } = parseFigureKey(figureKey);\n  const dcName = dcNameFromFigureKey(figureKey);\n\n  if (action === 'accept') {\n    if (msgId) {\n      const { newHp\x2C wasDefeated } = reduceHp(dcHealthState\x2C game\x2C msgId\x2C figureIndex\x2C 1\x2C playerNum);\n      if (dcHealthState.get(msgId)?.[figureIndex]) {\n        await logGameAction(game\x2C interaction.client\x2C `\\u{1FA78} **Bleeding** \u2014 **${dcName}** suffered 1 damage.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n        const dcIds = getDcMessageIds(game\x2C playerNum);\n        const dcList = getDcList(game\x2C playerNum);\n        const idx = (dcIds || []).indexOf(msgId);\n        if (wasDefeated) {\n          const oppPN = opponentPlayerNum(playerNum);\n          // Route through centralized defeat handler (VP\x2C CC attachments\x2C passive redraws\x2C\n          // Heroic Effort\x2C Scavenged Weaponry\x2C Hunt Dissent\x2C activation decrement\x2C win conditions)\n          if (processFigureDefeat) {\n            await processFigureDefeat(game\x2C {\n              defeatedPlayerNum: playerNum\x2C\n              figureKey\x2C\n              attackerPlayerNum: oppPN\x2C\n              msgId\x2C\n              dcIdx: idx\x2C\n              dcName\x2C\n              source: 'Bleeding'\x2C\n            });\n          }\n          // Bespoke cleanup: clear game sub-states tied to this DC when group fully defeated\n          const _bleedHs = dcHealthState.get(msgId);\n          if (_bleedHs && _bleedHs.every(fig => fig && fig[0] <= 0)) {\n            if (game.dcActionsData?.[msgId]) delete game.dcActionsData[msgId];\n            if (game.movementBank?.[msgId]) delete game.movementBank[msgId];\n          }\n          if (game.pendingDcAbilityChoice) {\n            for (const k of Object.keys(game.pendingDcAbilityChoice)) {\n              if (k.startsWith(`${msgId}_`)) delete game.pendingDcAbilityChoice[k];\n            }\n            if (Object.keys(game.pendingDcAbilityChoice).length === 0) delete game.pendingDcAbilityChoice;\n          }\n          if (game.pendingPounceSpaceChoice?.[msgId]) {\n            delete game.pendingPounceSpaceChoice[msgId];\n            if (Object.keys(game.pendingPounceSpaceChoice).length === 0) delete game.pendingPounceSpaceChoice;\n          }\n        }\n        // Refresh DC embed\n        try {\n          const meta = dcMessageMeta.get(msgId);\n          if (meta) {\n            const channelId = getPlayAreaId(game\x2C playerNum);\n            const ch = await fetchGameChannel(interaction.client\x2C channelId);\n            const dcMsg = await ch.messages.fetch(msgId);\n            const { embed\x2C files } = await renderDcEmbed(game\x2C msgId\x2C ctx);\n            await dcMsg.edit({ embeds: [embed]\x2C files }).catch(discordCatch);\n          }\n        } catch (err) {\n          console.error('Failed to update DC embed after Bleeding:'\x2C err);\n        }\n      }\n    }\n  } else {\n    // prevent: discard top CC from deck\n    const deckKey = ccDeckKey(playerNum);\n    const deck = game[deckKey] || [];\n    if (deck.length === 0) {\n      await interaction.followUp({ content: 'No CCs in deck to discard!'\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n    const discardedCard = deck.splice(0\x2C 1)[0];\n    game[deckKey] = deck;\n    const bleedDiscardKey = ccDiscardKey(playerNum);\n    game[bleedDiscardKey] = [...(game[bleedDiscardKey] || [])\x2C discardedCard];\n    await logGameAction(game\x2C interaction.client\x2C `\\u{1FA78} **Bleeding** \u2014 **${dcName}** prevented 1 damage (discarded **${discardedCard}** from deck top).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n    // CC Passive Redraw: deck-discard trigger (Built on Hope)\n    const _bprResult = checkDeckDiscardPassiveRedraws(game\x2C playerNum\x2C discardedCard);\n    for (const _bprCard of _bprResult.redrawn) {\n      await logGameAction(game\x2C interaction.client\x2C `**Passive Redraw** \u2014 **${_bprCard}** re-drawn from discard (discarded from deck).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n    }\n    // Discard pile changed (card added from deck + possibly redrawn to hand)\n    if (updateDiscardPileMessage) await updateDiscardPileMessage(game\x2C playerNum\x2C interaction.client).catch(discordCatch);\n    if (_bprResult.redrawn.length > 0) {\n      if (updateHandVisualMessage) await updateHandVisualMessage(game\x2C playerNum\x2C interaction.client).catch(discordCatch);\n    }\n  }\n  filterCondition(game\x2C figureKey\x2C 'Bleed');\n  delete game.pendingBleeding; // Clear headless pending state if present\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  saveGames();\n}\n\n/** Sidewinder (Jyn Odan): apply 1 Strain + grant 2 MP after attack. */\nexport async function handleSidewinderApply(interaction\x2C ctx) {\n  const {\n    getGame\x2C saveGames\x2C client\x2C canActAsPlayer\x2C dcMessageMeta\x2C dcHealthState\x2C\n    dcExhaustedState\x2C renderDcEmbed\x2C logGameAction\x2C ensureMovementBankMessage\x2C\n  } = ctx;\n  const m = interaction.customId.match(/^sidewinder_apply_([^_]+)_([^_]+)_(\\d+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C attackerMsgId\x2C figIndexStr] = m;\n  const game = getGame(gameId);\n  if (!game) return;\n  const figureIndex = parseInt(figIndexStr\x2C 10);\n  const meta = dcMessageMeta.get(attackerMsgId);\n  if (!meta) return;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C meta.playerNum\x2C canActAsPlayer\x2C 'Only the attacker can use Sidewinder.')) return;\n  const dgIndex = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n  const figureKey = `${meta.dcName}-${dgIndex}-${figureIndex}`;\n  const swKey = figureKey + '_sidewinder';\n  if (game.roundFigureAbilityUsed?.[swKey]) {\n    await interaction.followUp({ content: 'Sidewinder already used this round.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  await interaction.deferUpdate().catch(discordCatch);\n  // Apply 1 Strain\n  reduceHp(dcHealthState\x2C game\x2C attackerMsgId\x2C figureIndex\x2C 1\x2C meta.playerNum);\n  // Grant 2 MP\n  game.movementBank = game.movementBank || {};\n  const bank = game.movementBank[attackerMsgId] || { total: 0\x2C remaining: 0 };\n  bank.total = (bank.total ?? 0) + 2;\n  bank.remaining = (bank.remaining ?? 0) + 2;\n  game.movementBank[attackerMsgId] = bank;\n  // Mark used this round\n  game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n  game.roundFigureAbilityUsed[swKey] = true;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  await interaction.message.channel.send('**Sidewinder** \u2014 Jyn Odan suffered 1 Strain and gained +2 MP.');\n  await logGameAction(game\x2C client\x2C `**Sidewinder** \u2014 Jyn Odan suffered 1 Strain and gained +2 MP.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  await ensureMovementBankMessage(game\x2C attackerMsgId\x2C client);\n  try {\n    const ch = await fetchGameChannel(client\x2C getPlayAreaId(game\x2C meta.playerNum));\n    const msg = await ch.messages.fetch(attackerMsgId);\n    const { embed\x2C files } = await renderDcEmbed(game\x2C attackerMsgId\x2C ctx);\n    await msg.edit({ embeds: [embed]\x2C files }).catch(discordCatch);\n  } catch (e) { console.error('Failed to refresh Sidewinder DC embed:'\x2C e); }\n  saveGames();\n}\n\nexport async function handleSidewinderSkip(interaction\x2C ctx) {\n  const { saveGames } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  saveGames();\n}\n\n/** Boltslinger (Vinto Hreeda): deal 1 Dmg to chosen nearby hostile. */\nexport async function handleBoltslingerTarget(interaction\x2C ctx) {\n  const {\n    getGame\x2C saveGames\x2C client\x2C canActAsPlayer\x2C dcMessageMeta\x2C dcHealthState\x2C\n    dcExhaustedState\x2C renderDcEmbed\x2C logGameAction\x2C findDcMessageIdForFigure\x2C\n    processFigureDefeat\x2C\n  } = ctx;\n  const m = interaction.customId.match(/^boltslinger_target_([^_]+)_(\\d+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C idxStr] = m;\n  const game = getGame(gameId);\n  if (!game?.pendingBoltslinger) return;\n  const { attackerPlayerNum\x2C combatThreadId\x2C targets } = game.pendingBoltslinger;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C attackerPlayerNum\x2C canActAsPlayer\x2C 'Only the attacker can use Boltslinger.')) return;\n  const target = targets[parseInt(idxStr\x2C 10)];\n  if (!target) return;\n  await interaction.deferUpdate().catch(discordCatch);\n  const targetMsgId = findDcMessageIdForFigure(gameId\x2C target.playerNum\x2C target.figureKey);\n  if (targetMsgId) {\n    const { figureIndex: figIdx } = parseFigureKey(target.figureKey);\n    const { newHp: bsNewHp\x2C wasDefeated: bsDied } = reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C figIdx\x2C 1\x2C target.playerNum);\n    try {\n      const tMeta = dcMessageMeta.get(targetMsgId);\n      if (tMeta) {\n        const ch = await fetchGameChannel(client\x2C getPlayAreaId(game\x2C tMeta.playerNum));\n        const msg = await ch.messages.fetch(targetMsgId);\n        const { embed\x2C files } = await renderDcEmbed(game\x2C targetMsgId\x2C ctx);\n        await msg.edit({ embeds: [embed]\x2C files }).catch(discordCatch);\n      }\n    } catch (e) { console.error('Failed to refresh Boltslinger target embed:'\x2C e); }\n    if (bsDied && processFigureDefeat) {\n      const _bsDcIds = getDcMessageIds(game\x2C target.playerNum) || [];\n      const _bsIdx = _bsDcIds.indexOf(targetMsgId);\n      const _bsDcName = dcNameFromFigureKey(target.figureKey);\n      await processFigureDefeat(game\x2C {\n        defeatedPlayerNum: target.playerNum\x2C\n        figureKey: target.figureKey\x2C\n        attackerPlayerNum\x2C\n        msgId: targetMsgId\x2C\n        dcIdx: _bsIdx\x2C\n        dcName: _bsDcName\x2C\n        displayName: target.label\x2C\n        source: 'Boltslinger'\x2C\n      });\n    }\n  }\n  const blThread = await fetchCombatThread(client\x2C combatThreadId);\n  if (blThread) await blThread.send(`**Boltslinger** \u2014 **${target.label}** suffers 1 Damage.`);\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `**Boltslinger** \u2014 **${target.label}** suffers 1 Damage.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  delete game.pendingBoltslinger;\n  saveGames();\n}\n\nexport async function handleBoltslingerSkip(interaction\x2C ctx) {\n  const { getGame\x2C saveGames } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const m = interaction.customId.match(/^boltslinger_skip_([^_]+)$/);\n  if (!m) return;\n  const game = getGame(m[1]);\n  if (game) delete game.pendingBoltslinger;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  saveGames();\n}\n\n/** Indiscriminate Fire die choice button: indiscriminate_die_{gameId}_{dieIndex} */\nexport async function handleIndiscriminateFireDie(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C canActAsPlayer } = ctx;\n  const m = interaction.customId.match(/^indiscriminate_die_([^_]+)_(\\d+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C idxStr] = m;\n  const game = getGame(gameId);\n  if (!game?.pendingIndiscriminateFire) return;\n  const { attackerPlayerNum\x2C combatThreadId\x2C targets\x2C availableDice } = game.pendingIndiscriminateFire;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C attackerPlayerNum\x2C canActAsPlayer\x2C 'Only the attacker can choose the Indiscriminate Fire die.')) return;\n  const die = availableDice[parseInt(idxStr\x2C 10)];\n  if (!die) return;\n  await interaction.deferUpdate().catch(discordCatch);\n  delete game.pendingIndiscriminateFire;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  const thread = await fetchCombatThread(client\x2C combatThreadId);\n  if (thread) await applyIndiscriminateFireSplash(game\x2C attackerPlayerNum\x2C combatThreadId\x2C die\x2C targets\x2C thread\x2C ctx);\n  saveGames();\n}\n\n/** Indiscriminate Fire skip button: indiscriminate_skip_{gameId} */\nexport async function handleIndiscriminateFireSkip(interaction\x2C ctx) {\n  const { getGame\x2C saveGames } = ctx;\n  const m = interaction.customId.match(/^indiscriminate_skip_([^_]+)$/);\n  if (!m) return;\n  const game = getGame(m[1]);\n  await interaction.deferUpdate().catch(discordCatch);\n  if (game) delete game.pendingIndiscriminateFire;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  saveGames();\n}\n\n/** Fighting Knife target pick: fighting_knife_target_{gameId}_{index} */\nexport async function handleFightingKnifeTarget(interaction\x2C ctx) {\n  const {\n    getGame\x2C saveGames\x2C client\x2C canActAsPlayer\x2C dcMessageMeta\x2C dcHealthState\x2C\n    dcExhaustedState\x2C renderDcEmbed\x2C logGameAction\x2C findDcMessageIdForFigure\x2C\n    finishCombatResolution\x2C rollSingleAttackDie\x2C\n    processFigureDefeat\x2C\n  } = ctx;\n  const m = interaction.customId.match(/^fighting_knife_target_([^_]+)_(\\d+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C idxStr] = m;\n  const game = getGame(gameId);\n  if (!game?.pendingFightingKnife) return;\n  const pending = game.pendingFightingKnife;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pending.attackerPlayerNum\x2C canActAsPlayer\x2C 'Only the attacker can pick the Fighting Knife target.')) return;\n  const target = pending.targets[parseInt(idxStr\x2C 10)];\n  if (!target) return;\n  await interaction.deferUpdate().catch(discordCatch);\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  delete game.pendingFightingKnife;\n  // Roll 1 red die\n  const die = rollSingleAttackDie('red');\n  const hits = die.dmg || 0;\n  const thread = await fetchCombatThread(client\x2C pending.combatThreadId);\n  if (!thread) { saveGames(); return; }\n  const embedRefreshMsgIds = new Set(pending.initialEmbedRefreshMsgIds || []);\n  if (hits > 0 && target.msgId) {\n    const { figureIndex: figIndex } = parseFigureKey(target.figureKey);\n    const { newHp: newCur\x2C wasDefeated: fkDefeated } = reduceHp(dcHealthState\x2C game\x2C target.msgId\x2C figIndex\x2C hits\x2C target.playerNum);\n    // Fury of Kashyyyk (army-wide): when a friendly WOOKIEE suffers 3+ damage\x2C become Focused\n    if (hits >= 3 && newCur > 0) {\n      const _fokFkDcList = getDcList(game\x2C target.playerNum) || [];\n      if (_fokFkDcList.some(dc => dc.dcName === '[Fury of Kashyyyk]')) {\n        const _fokFkName = dcNameFromFigureKey(target.figureKey);\n        const _fokFkKws = (getDcKeywords(game)[_fokFkName] || []).map(k => String(k).toUpperCase());\n        if (_fokFkKws.includes('WOOKIEE')) {\n          if (applyCondition(game\x2C target.figureKey\x2C 'Focus')) {\n            await logGameAction(game\x2C client\x2C `**Fury of Kashyyyk** \u2014 **${_fokFkName}** became **Focused** (suffered ${hits} Damage from Fighting Knife).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n          }\n        }\n      }\n    }\n    embedRefreshMsgIds.add(target.msgId);\n    if (fkDefeated && processFigureDefeat) {\n      await processFigureDefeat(game\x2C {\n        defeatedPlayerNum: target.playerNum\x2C\n        figureKey: target.figureKey\x2C\n        attackerPlayerNum: pending.attackerPlayerNum\x2C\n        msgId: target.msgId\x2C\n        dcName: dcNameFromFigureKey(target.figureKey)\x2C\n        displayName: target.label\x2C\n        source: 'Fighting Knife'\x2C\n      });\n    }\n  }\n  const dieDesc = `${die.dmg}dmg${die.surge ? `/${die.surge}\\u21AF` : ''}`;\n  await logGameAction(game\x2C client\x2C `**Fighting Knife** \u2014 ${target.label}: rolled 1 red die (${dieDesc})\x2C dealt **${hits}** damage`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  await thread.send(`**Fighting Knife** \u2014 Rolled 1 red die on **${target.label}**: ${dieDesc} \\u2192 **${hits} Damage**.`).catch(discordCatch);\n  await finishCombatResolution(game\x2C pending.combat\x2C pending.resultText\x2C embedRefreshMsgIds\x2C client);\n  saveGames();\n}\n\n/** Fighting Knife skip: fighting_knife_skip_{gameId} */\nexport async function handleFightingKnifeSkip(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C finishCombatResolution } = ctx;\n  const m = interaction.customId.match(/^fighting_knife_skip_([^_]+)$/);\n  if (!m) return;\n  const game = getGame(m[1]);\n  if (!game?.pendingFightingKnife) return;\n  const pending = game.pendingFightingKnife;\n  await interaction.deferUpdate().catch(discordCatch);\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  delete game.pendingFightingKnife;\n  const embedRefreshMsgIds = new Set(pending.initialEmbedRefreshMsgIds || []);\n  await finishCombatResolution(game\x2C pending.combat\x2C pending.resultText\x2C embedRefreshMsgIds\x2C client);\n  saveGames();\n}\n\n/** Concussive Bolt push target: concussive_bolt_push_{gameId}_{space} */\nexport async function handleConcussiveBoltPush(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C canActAsPlayer\x2C logGameAction\x2C finishCombatResolution } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const m = interaction.customId.match(/^concussive_bolt_push_([^_]+)_([a-z0-9]+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C space] = m;\n  const game = getGame(gameId);\n  if (!game?.pendingConcussiveBolt) return;\n  const pending = game.pendingConcussiveBolt;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pending.attackerPlayerNum\x2C canActAsPlayer\x2C 'Only the attacker can choose the Concussive Bolt push direction.')) return;\n  if (!pending.adjSpaces.includes(space)) {\n    await interaction.followUp({ content: 'Invalid push destination.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  delete game.pendingConcussiveBolt;\n  // Move the figure to the chosen space\n  pushFigure(game\x2C pending.defenderPlayerNum\x2C pending.figureKey\x2C space);\n  const embedRefreshMsgIds = new Set(pending.initialEmbedRefreshMsgIds || []);\n  await logGameAction(game\x2C client\x2C `**Concussive Bolt** \u2014 **${pending.figureLabel}** pushed from ${String(pending.currentPos).toUpperCase()} to **${space.toUpperCase()}**`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  await finishCombatResolution(game\x2C pending.combat\x2C pending.resultText\x2C embedRefreshMsgIds\x2C client);\n  saveGames();\n}\n\n/** Concussive Bolt skip: concussive_bolt_skip_{gameId} */\nexport async function handleConcussiveBoltSkip(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C finishCombatResolution } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const m = interaction.customId.match(/^concussive_bolt_skip_([^_]+)$/);\n  if (!m) return;\n  const game = getGame(m[1]);\n  if (!game?.pendingConcussiveBolt) return;\n  const pending = game.pendingConcussiveBolt;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  delete game.pendingConcussiveBolt;\n  const embedRefreshMsgIds = new Set(pending.initialEmbedRefreshMsgIds || []);\n  await finishCombatResolution(game\x2C pending.combat\x2C pending.resultText\x2C embedRefreshMsgIds\x2C client);\n  saveGames();\n}\n\n/** Spread the Pain figure pick: spread_pain_fig_{gameId}_{figureKey} */\nexport async function handleSpreadThePainFigPick(interaction\x2C ctx) {\n  const {\n    getGame\x2C saveGames\x2C client\x2C canActAsPlayer\x2C logGameAction\x2C\n    isConditionImmune\x2C applyCondition\x2C HARMFUL_CONDITIONS\x2C\n  } = ctx;\n  const m = interaction.customId.match(/^spread_pain_fig_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C figureKey] = m;\n  const game = getGame(gameId);\n  if (!game?.pendingSpreadThePain) return;\n  const pending = game.pendingSpreadThePain;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pending.attackerPlayerNum\x2C canActAsPlayer\x2C 'Only the attacker can choose the Spread the Pain target.')) return;\n  await interaction.deferUpdate().catch(discordCatch);\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  const cond = pending.conditions[pending.conditionIdx];\n  // Apply condition to figureKey\n  const dcName = dcNameFromFigureKey(figureKey);\n  if (HARMFUL_CONDITIONS.includes(cond) && isConditionImmune(game\x2C figureKey)) {\n    await logGameAction(game\x2C client\x2C `**Condition Immunity** \u2014 **${dcName}** is immune to **${cond}** (Spread the Pain).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  } else {\n    applyCondition(game\x2C figureKey\x2C cond);\n    await logGameAction(game\x2C client\x2C `**Spread the Pain** \u2014 **${dcName}** gains **${cond}**`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  }\n  pending.conditionIdx++;\n  await advanceSpreadThePain(game\x2C pending\x2C ctx);\n}\n\n/** Spread the Pain skip: spread_pain_skip_{gameId} */\nexport async function handleSpreadThePainSkip(interaction\x2C ctx) {\n  const { getGame } = ctx;\n  const m = interaction.customId.match(/^spread_pain_skip_([^_]+)$/);\n  if (!m) return;\n  const game = getGame(m[1]);\n  if (!game?.pendingSpreadThePain) return;\n  const pending = game.pendingSpreadThePain;\n  await interaction.deferUpdate().catch(discordCatch);\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  pending.conditionIdx++;\n  await advanceSpreadThePain(game\x2C pending\x2C ctx);\n}\n\n/** Missile Salvo die choice: missile_salvo_die_{color}_{gameId}_{msgId} */\nexport async function handleMissileSalvoDie(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C canActAsPlayer } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const m = interaction.customId.match(/^missile_salvo_die_([a-z]+)_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C color\x2C gameId\x2C msgId] = m;\n  const game = getGame(gameId);\n  if (!game?.pendingMissileSalvo?.[msgId]) return;\n  const { playerNum\x2C diceAvailable } = game.pendingMissileSalvo[msgId];\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the activating player can choose the Missile Salvo die.')) return;\n  if (!diceAvailable.includes(color)) {\n    await interaction.followUp({ content: `The ${color} die is no longer available for this salvo.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Remove chosen die from available pool\n  game.pendingMissileSalvo[msgId].diceAvailable = diceAvailable.filter((c) => c !== color);\n  // Set up overridden ranged attack with this die + +3 accuracy\n  game.pendingOverrideAttackDice = game.pendingOverrideAttackDice || {};\n  game.pendingOverrideAttackDice[msgId] = { dice: [color]\x2C type: 'ranged'\x2C bonusAccuracy: 3 };\n  game.freeAttackBonusPending = game.freeAttackBonusPending || {};\n  game.freeAttackBonusPending[msgId] = true;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  const threadId = game.pendingMissileSalvo[msgId].threadId || game.dcActionsData?.[msgId]?.threadId;\n  const salvoThread = await fetchCombatThread(client\x2C threadId);\n  const ownerId = getPlayerId(game\x2C playerNum);\n  const colorLabel = color.charAt(0).toUpperCase() + color.slice(1);\n  const msg = `<@${ownerId}> **Missile Salvo** \u2014 **${colorLabel} die** selected (+3 Accuracy). Click **Attack** to target a different hostile figure. This attack costs no action.`;\n  if (salvoThread) await salvoThread.send(sanitizeMentions({ content: msg\x2C allowedMentions: { users: [ownerId] } })).catch(discordCatch);\n  saveGames();\n}\n\n/** Missile Salvo done: missile_salvo_done_{gameId}_{msgId} */\nexport async function handleMissileSalvoDone(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C canActAsPlayer\x2C dcMessageMeta\x2C updateDcActionsMessage\x2C client } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const m = interaction.customId.match(/^missile_salvo_done_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C msgId] = m;\n  const game = getGame(gameId);\n  if (!game?.pendingMissileSalvo?.[msgId]) return;\n  const { playerNum } = game.pendingMissileSalvo[msgId];\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the activating player can end the salvo.')) return;\n  delete game.pendingMissileSalvo[msgId];\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  // Dubious Counterparts (Doctor Aphra): after a friendly DROID resolves Missile Salvo\x2C\n  // that figure may perform 1 additional action\n  const _dcAphraDcList = getDcList(game\x2C playerNum) || [];\n  const _dcAphraAlive = _dcAphraDcList.some(dc => dc?.dcName === 'Doctor Aphra') &&\n    Object.keys(game.figurePositions?.[playerNum] || {}).some(fk => fk.startsWith('Doctor Aphra-'));\n  if (_dcAphraAlive) {\n    const actionsData = game.dcActionsData?.[msgId];\n    if (actionsData) {\n      actionsData.remaining = Math.min((actionsData.total ?? 2) + 1\x2C actionsData.remaining + 1);\n      if (updateDcActionsMessage) await updateDcActionsMessage(game\x2C msgId\x2C client || interaction.client);\n      const _dcMeta = dcMessageMeta?.get(msgId);\n      const _dcDisplayName = _dcMeta?.displayName || _dcMeta?.dcName || 'BT-1';\n      const _dcThreadId = actionsData.threadId;\n      const _dcThread = _dcThreadId ? await (client || interaction.client).channels.fetch(_dcThreadId).catch(() => null) : interaction.channel;\n      if (_dcThread) {\n        await _dcThread.send(`**Dubious Counterparts** (Doctor Aphra) \u2014 **${_dcDisplayName}** gains 1 additional action after resolving **Missile Salvo**.`).catch(discordCatch);\n      }\n    }\n  }\n  saveGames();\n}\n\n// \u2500\u2500 Heavy Fire handlers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/** Internal helper: advance to next Heavy Fire target pick\x2C or finish. */\nasync function advanceHeavyFirePick(game\x2C pending\x2C ctx) {\n  const { client\x2C saveGames\x2C logGameAction } = ctx;\n  const thread = await fetchCombatThread(client\x2C pending.combatThreadId);\n  if (!thread) { saveGames(); return; }\n\n  const remaining = pending.diceCount - pending.chosenTargets.length;\n  if (remaining <= 0 || pending.hostiles.length === 0) {\n    await startHeavyFireConditions(game\x2C pending\x2C ctx);\n    return;\n  }\n\n  // Filter out already-chosen targets\n  const chosenKeys = new Set(pending.chosenTargets.map(t => t.figureKey));\n  const available = pending.hostiles.filter(t => !chosenKeys.has(t.figureKey));\n  if (available.length === 0) {\n    await startHeavyFireConditions(game\x2C pending\x2C ctx);\n    return;\n  }\n\n  const ownerId = getPlayerId(game\x2C pending.attackerPlayerNum);\n  const btns = available.slice(0\x2C 4).map((t) =>\n    new ButtonBuilder()\n      .setCustomId(`heavy_fire_tgt_${game.gameId}_${t.figureKey}`)\n      .setLabel(t.label)\n      .setStyle(ButtonStyle.Danger)\n  );\n  btns.push(new ButtonBuilder().setCustomId(`heavy_fire_tgt_done_${game.gameId}`).setLabel('Done Picking').setStyle(ButtonStyle.Secondary));\n  await thread.send({\n    content: `<@${ownerId}> **Heavy Fire** \u2014 Pick hostile target ${pending.chosenTargets.length + 1}/${pending.diceCount} (within 2 of target space). ${remaining} pick${remaining !== 1 ? 's' : ''} left:`\x2C\n    allowedMentions: { users: [ownerId] }\x2C\n    components: [new ActionRowBuilder().addComponents(btns)]\x2C\n  }).catch(discordCatch);\n  saveGames();\n}\n\n/** Internal helper: apply damage to all chosen targets\x2C then start opponent condition picking. */\nasync function startHeavyFireConditions(game\x2C pending\x2C ctx) {\n  const {\n    client\x2C saveGames\x2C dcMessageMeta\x2C dcHealthState\x2C dcExhaustedState\x2C\n    findDcMessageIdForFigure\x2C renderDcEmbed\x2C getDcEffects\x2C logGameAction\x2C\n    processFigureDefeat\x2C\n  } = ctx;\n  const thread = await fetchCombatThread(client\x2C pending.combatThreadId);\n  if (!thread) { saveGames(); return; }\n\n  if (pending.chosenTargets.length === 0) {\n    await thread.send('**Heavy Fire** \u2014 No targets chosen. Effect skipped.').catch(discordCatch);\n    delete game.pendingHeavyFire;\n    saveGames();\n    return;\n  }\n\n  // Apply 1 Damage to each chosen hostile\n  const lines = [];\n  const defeatedTargets = [];\n  for (const t of pending.chosenTargets) {\n    const mid = findDcMessageIdForFigure(game.gameId\x2C t.playerNum\x2C t.figureKey);\n    if (!mid) continue;\n    const { figureIndex: figIdx } = parseFigureKey(t.figureKey);\n    const { newHp\x2C wasDefeated } = reduceHp(dcHealthState\x2C game\x2C mid\x2C figIdx\x2C 1\x2C t.playerNum);\n    lines.push(`\u2022 **${t.label}** suffers 1 Damage`);\n    if (wasDefeated && processFigureDefeat) {\n      const defeatResult = await processFigureDefeat(game\x2C {\n        defeatedPlayerNum: t.playerNum\x2C\n        figureKey: t.figureKey\x2C\n        attackerPlayerNum: pending.attackerPlayerNum\x2C\n        msgId: mid\x2C\n        dcName: dcNameFromFigureKey(t.figureKey)\x2C\n        displayName: t.label\x2C\n        source: 'Heavy Fire'\x2C\n      });\n      lines.push(`  \u2192 **${t.label} defeated!** +${defeatResult?.vp ?? 0} VP`);\n      defeatedTargets.push(t);\n    }\n    // Refresh DC embed\n    try {\n      const tMeta = dcMessageMeta.get(mid);\n      if (tMeta) {\n        const ch = await fetchGameChannel(client\x2C getPlayAreaId(game\x2C tMeta.playerNum));\n        const msg = await ch.messages.fetch(mid);\n        const { embed\x2C files } = await renderDcEmbed(game\x2C mid\x2C ctx);\n        await msg.edit({ embeds: [embed]\x2C files }).catch(discordCatch);\n      }\n    } catch {}\n  }\n  const dmgMsg = `**Heavy Fire** \u2014 Splash damage:\\n${lines.join('\\n')}`;\n  await thread.send(dmgMsg).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C dmgMsg\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n\n  // Filter out defeated targets from condition penalty list\n  const defeatedKeys = new Set(defeatedTargets.map(t => t.figureKey));\n  const survivingChosen = pending.chosenTargets.filter(t => !defeatedKeys.has(t.figureKey));\n  pending.conditionsOwed = survivingChosen.length;\n\n  if (pending.conditionsOwed <= 0) {\n    await thread.send('**Heavy Fire** \u2014 No conditions owed (all targeted figures were defeated).').catch(discordCatch);\n    delete game.pendingHeavyFire;\n    saveGames();\n    return;\n  }\n\n  // Opponent picks 1 harmful condition per surviving chosen target to apply to the attacker\n  pending.conditionsApplied = 0;\n  await advanceHeavyFireConditionPick(game\x2C pending\x2C ctx);\n}\n\n/** Internal helper: prompt opponent to pick 1 harmful condition for the attacker. */\nasync function advanceHeavyFireConditionPick(game\x2C pending\x2C ctx) {\n  const { client\x2C saveGames } = ctx;\n  const thread = await fetchCombatThread(client\x2C pending.combatThreadId);\n  if (!thread) { saveGames(); return; }\n\n  if (pending.conditionsApplied >= pending.conditionsOwed) {\n    await thread.send(`**Heavy Fire** \u2014 All ${pending.conditionsOwed} harmful condition${pending.conditionsOwed !== 1 ? 's' : ''} applied to **${pending.attackerDcName}**.`).catch(discordCatch);\n    delete game.pendingHeavyFire;\n    saveGames();\n    return;\n  }\n\n  const oppPN = opponentPlayerNum(pending.attackerPlayerNum);\n  const oppId = getPlayerId(game\x2C oppPN);\n  const conditions = ['Stun'\x2C 'Bleed'\x2C 'Weaken'];\n  const btns = conditions.map(c =>\n    new ButtonBuilder()\n      .setCustomId(`heavy_fire_cond_${game.gameId}_${c}`)\n      .setLabel(c)\n      .setStyle(ButtonStyle.Danger)\n  );\n  const condNum = pending.conditionsApplied + 1;\n  await thread.send({\n    content: `<@${oppId}> **Heavy Fire** \u2014 Choose a harmful condition to apply to **${pending.attackerDcName}** (${condNum}/${pending.conditionsOwed}):`\x2C\n    allowedMentions: { users: [oppId] }\x2C\n    components: [new ActionRowBuilder().addComponents(btns)]\x2C\n  }).catch(discordCatch);\n  saveGames();\n}\n\n/** Heavy Fire "Use" button: heavy_fire_use_{gameId} */\nexport async function handleHeavyFireUse(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C canActAsPlayer\x2C dcExhaustedState\x2C\n    dcMessageMeta\x2C renderDcEmbed\x2C logGameAction } = ctx;\n  const m = interaction.customId.match(/^heavy_fire_use_([^_]+)$/);\n  if (!m) return;\n  const game = getGame(m[1]);\n  if (!game?.pendingHeavyFire) return;\n  const pending = game.pendingHeavyFire;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pending.attackerPlayerNum\x2C canActAsPlayer\x2C 'Only the attacker can use Heavy Fire.')) return;\n  await interaction.deferUpdate().catch(discordCatch);\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  // Exhaust the Heavy Fire card (persist for restart survival)\n  if (pending.hfMsgId) {\n    dcExhaustedState.set(pending.hfMsgId\x2C true);\n    game.abilityExhaustedMsgIds = game.abilityExhaustedMsgIds || [];\n    if (!game.abilityExhaustedMsgIds.includes(pending.hfMsgId)) game.abilityExhaustedMsgIds.push(pending.hfMsgId);\n    // Refresh the Heavy Fire DC embed\n    try {\n      const hfMeta = dcMessageMeta.get(pending.hfMsgId);\n      if (hfMeta) {\n        const ch = await fetchGameChannel(client\x2C getPlayAreaId(game\x2C hfMeta.playerNum));\n        const msg = await ch.messages.fetch(pending.hfMsgId);\n        const { embed\x2C files } = await renderDcEmbed(game\x2C pending.hfMsgId\x2C ctx);\n        await msg.edit({ embeds: [embed]\x2C files }).catch(discordCatch);\n      }\n    } catch {}\n  }\n  await logGameAction(game\x2C client\x2C `**Heavy Fire** \u2014 Exhausted by P${pending.attackerPlayerNum} after **${pending.attackerDcName}** resolved an attack.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n\n  // Start target picking\n  await advanceHeavyFirePick(game\x2C pending\x2C ctx);\n}\n\n/** Heavy Fire skip (don't use): heavy_fire_skip_{gameId} */\nexport async function handleHeavyFireSkip(interaction\x2C ctx) {\n  const { getGame\x2C saveGames } = ctx;\n  const m = interaction.customId.match(/^heavy_fire_skip_([^_]+)$/);\n  if (!m) return;\n  const game = getGame(m[1]);\n  await interaction.deferUpdate().catch(discordCatch);\n  if (game) delete game.pendingHeavyFire;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  saveGames();\n}\n\n/** Heavy Fire target pick: heavy_fire_tgt_{gameId}_{figureKey} */\nexport async function handleHeavyFireTarget(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C canActAsPlayer } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'heavy_fire_tgt_');\n  const gameId = parts[0];\n  const figureKey = parts.slice(1).join('_');\n  if (!gameId || !figureKey) return;\n  const game = getGame(gameId);\n  if (!game?.pendingHeavyFire) return;\n  const pending = game.pendingHeavyFire;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pending.attackerPlayerNum\x2C canActAsPlayer\x2C 'Only the attacker can pick Heavy Fire targets.')) return;\n  const target = pending.hostiles.find(t => t.figureKey === figureKey);\n  if (!target) return;\n  await interaction.deferUpdate().catch(discordCatch);\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  pending.chosenTargets.push(target);\n\n  // Check if we've picked enough or can pick more\n  if (pending.chosenTargets.length >= pending.diceCount) {\n    await startHeavyFireConditions(game\x2C pending\x2C ctx);\n  } else {\n    await advanceHeavyFirePick(game\x2C pending\x2C ctx);\n  }\n}\n\n/** Heavy Fire "Done Picking" button: heavy_fire_tgt_done_{gameId} */\nexport async function handleHeavyFireDone(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C canActAsPlayer } = ctx;\n  const m = interaction.customId.match(/^heavy_fire_tgt_done_([^_]+)$/);\n  if (!m) return;\n  const game = getGame(m[1]);\n  if (!game?.pendingHeavyFire) return;\n  const pending = game.pendingHeavyFire;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pending.attackerPlayerNum\x2C canActAsPlayer\x2C 'Only the attacker can finish Heavy Fire picking.')) return;\n  await interaction.deferUpdate().catch(discordCatch);\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  // Finish picking \u2014 apply damage to whatever was chosen\n  await startHeavyFireConditions(game\x2C pending\x2C ctx);\n}\n\n/** Heavy Fire condition choice by opponent: heavy_fire_cond_{gameId}_{condition} */\nexport async function handleHeavyFireCondition(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C canActAsPlayer\x2C applyCondition\x2C\n    isConditionImmune\x2C logGameAction } = ctx;\n  const m = interaction.customId.match(/^heavy_fire_cond_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C condition] = m;\n  const game = getGame(gameId);\n  if (!game?.pendingHeavyFire) return;\n  const pending = game.pendingHeavyFire;\n  const oppPN = opponentPlayerNum(pending.attackerPlayerNum);\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C oppPN\x2C canActAsPlayer\x2C 'Only the opponent can choose the Heavy Fire condition.')) return;\n  await interaction.deferUpdate().catch(discordCatch);\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n\n  // Apply the chosen harmful condition to the attacker figure\n  const attackerFk = pending.attackerFigureKey;\n  if (isConditionImmune(game\x2C attackerFk)) {\n    const thread = await fetchCombatThread(client\x2C pending.combatThreadId);\n    if (thread) await thread.send(`**Heavy Fire** \u2014 **${pending.attackerDcName}** is immune to conditions; **${condition}** not applied.`).catch(discordCatch);\n    await logGameAction(game\x2C client\x2C `**Heavy Fire** \u2014 **${pending.attackerDcName}** is immune to conditions; **${condition}** not applied.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  } else {\n    applyCondition(game\x2C attackerFk\x2C condition);\n    const thread = await fetchCombatThread(client\x2C pending.combatThreadId);\n    if (thread) await thread.send(`**Heavy Fire** \u2014 **${pending.attackerDcName}** gains **${condition}** (opponent's choice).`).catch(discordCatch);\n    await logGameAction(game\x2C client\x2C `**Heavy Fire** \u2014 **${pending.attackerDcName}** gains **${condition}** (opponent's choice).`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  }\n\n  pending.conditionsApplied++;\n  await advanceHeavyFireConditionPick(game\x2C pending\x2C ctx);\n}\n\n// \u2500\u2500 Havoc Shot (Fenn Signis) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nexport async function handleHavocShotUse(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C canActAsPlayer\x2C dcHealthState\x2C dcMessageMeta\x2C\n    dcExhaustedState\x2C findDcMessageIdForFigure\x2C renderDcEmbed\x2C logGameAction } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const m = interaction.customId.match(/^havoc_shot_use_([^_]+)$/);\n  if (!m) return;\n  const game = getGame(m[1]);\n  if (!game?.pendingHavocShot) return;\n  const hs = game.pendingHavocShot;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C hs.attackerPlayerNum\x2C canActAsPlayer\x2C 'Only the attacker can use Havoc Shot.')) return;\n  // Suffer 1 Strain (HP damage) to attacker\n  const atkMsgId = hs.attackerMsgId;\n  if (atkMsgId) {\n    reduceHp(dcHealthState\x2C game\x2C atkMsgId\x2C hs.attackerFigureIndex\x2C 1\x2C hs.attackerPlayerNum);\n    // Refresh attacker embed\n    try {\n      const atkMeta = dcMessageMeta.get(atkMsgId);\n      if (atkMeta) {\n        const ch = await fetchGameChannel(client\x2C getPlayAreaId(game\x2C atkMeta.playerNum));\n        const msg = await ch.messages.fetch(atkMsgId);\n        const { embed\x2C files } = await renderDcEmbed(game\x2C atkMsgId\x2C ctx);\n        await msg.edit({ embeds: [embed]\x2C files }).catch(discordCatch);\n      }\n    } catch {}\n  }\n  // Show figure picker\n  const btns = hs.targets.slice(0\x2C 4).map((t\x2C i) =>\n    new ButtonBuilder().setCustomId(`havoc_shot_pick_${game.gameId}_${i}`).setLabel(t.label.slice(0\x2C 80)).setStyle(ButtonStyle.Danger)\n  );\n  btns.push(new ButtonBuilder().setCustomId(`havoc_shot_done_${game.gameId}`).setLabel('Done (skip remaining)').setStyle(ButtonStyle.Secondary));\n  const rows = chunkButtonsToRows(btns);\n  await interaction.message.edit({\n    content: `**Havoc Shot** \u2014 Suffered 1 Strain. Choose up to ${hs.maxPicks} figure(s) to deal 1 Damage:`\x2C\n    components: rows\x2C\n  }).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `**Havoc Shot** \u2014 **${dcNameFromFigureKey(hs.attackerFigureKey)}** suffered 1 Strain.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  saveGames();\n}\n\nexport async function handleHavocShotSkip(interaction\x2C ctx) {\n  const { getGame\x2C saveGames } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const m = interaction.customId.match(/^havoc_shot_skip_([^_]+)$/);\n  if (!m) return;\n  const game = getGame(m[1]);\n  if (game) delete game.pendingHavocShot;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  saveGames();\n}\n\nexport async function handleHavocShotPick(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C canActAsPlayer\x2C dcHealthState\x2C dcMessageMeta\x2C\n    dcExhaustedState\x2C findDcMessageIdForFigure\x2C renderDcEmbed\x2C logGameAction } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const m = interaction.customId.match(/^havoc_shot_pick_([^_]+)_(\\d+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C idxStr] = m;\n  const game = getGame(gameId);\n  if (!game?.pendingHavocShot) return;\n  const hs = game.pendingHavocShot;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C hs.attackerPlayerNum\x2C canActAsPlayer\x2C 'Only the attacker can pick.')) return;\n  const target = hs.targets[parseInt(idxStr\x2C 10)];\n  if (!target) return;\n  // Apply 1 Damage\n  const targetMsgId = findDcMessageIdForFigure(gameId\x2C target.playerNum\x2C target.figureKey);\n  if (targetMsgId) {\n    const { figureIndex: figIdx } = parseFigureKey(target.figureKey);\n    reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C figIdx\x2C 1\x2C target.playerNum);\n    try {\n      const tMeta = dcMessageMeta.get(targetMsgId);\n      if (tMeta) {\n        const ch = await fetchGameChannel(client\x2C getPlayAreaId(game\x2C tMeta.playerNum));\n        const msg = await ch.messages.fetch(targetMsgId);\n        const { embed\x2C files } = await renderDcEmbed(game\x2C targetMsgId\x2C ctx);\n        await msg.edit({ embeds: [embed]\x2C files }).catch(discordCatch);\n      }\n    } catch {}\n  }\n  hs.chosen.push(target.figureKey);\n  const thread = await fetchCombatThread(client\x2C hs.combatThreadId);\n  if (thread) await thread.send(`**Havoc Shot** \u2014 **${target.label}** suffers 1 Damage.`).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `**Havoc Shot** \u2014 **${target.label}** suffers 1 Damage.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  // If more picks available and more targets\n  const remaining = hs.maxPicks - hs.chosen.length;\n  const remainingTargets = hs.targets.filter((t\x2C i) => !hs.chosen.includes(t.figureKey));\n  const remaining2 = remainingTargets;\n  if (remaining > 0 && remaining2.length > 0) {\n    const btns2 = remaining2.slice(0\x2C 4).map((t) => {\n      const origIdx = hs.targets.indexOf(t);\n      return new ButtonBuilder().setCustomId(`havoc_shot_pick_${gameId}_${origIdx}`).setLabel(t.label.slice(0\x2C 80)).setStyle(ButtonStyle.Danger);\n    });\n    btns2.push(new ButtonBuilder().setCustomId(`havoc_shot_done_${gameId}`).setLabel('Done').setStyle(ButtonStyle.Secondary));\n    const rows2 = chunkButtonsToRows(btns2);\n    await interaction.message.edit({ content: `**Havoc Shot** \u2014 ${remaining} pick(s) remaining:`\x2C components: rows2 }).catch(discordCatch);\n  } else {\n    delete game.pendingHavocShot;\n    await interaction.message.edit({ content: `**Havoc Shot** \u2014 Complete.`\x2C components: [] }).catch(discordCatch);\n  }\n  saveGames();\n}\n\nexport async function handleHavocShotDone(interaction\x2C ctx) {\n  const { getGame\x2C saveGames } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const m = interaction.customId.match(/^havoc_shot_done_([^_]+)$/);\n  if (!m) return;\n  const game = getGame(m[1]);\n  if (game) delete game.pendingHavocShot;\n  await interaction.message.edit({ content: `**Havoc Shot** \u2014 Complete.`\x2C components: [] }).catch(discordCatch);\n  saveGames();\n}\n\n// \u2500\u2500 Deflect (Luke Skywalker JK) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nexport async function handleDeflectPick(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C canActAsPlayer\x2C dcHealthState\x2C dcMessageMeta\x2C\n    dcExhaustedState\x2C findDcMessageIdForFigure\x2C renderDcEmbed\x2C logGameAction } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const m = interaction.customId.match(/^deflect_pick_([^_]+)_(\\d+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C idxStr] = m;\n  const game = getGame(gameId);\n  if (!game?.pendingDeflect) return;\n  const df = game.pendingDeflect;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C df.deflectorPlayerNum\x2C canActAsPlayer\x2C 'Only the Deflect owner can pick.')) return;\n  const target = df.hostiles[parseInt(idxStr\x2C 10)];\n  if (!target) return;\n  const targetMsgId = findDcMessageIdForFigure(gameId\x2C target.playerNum\x2C target.figureKey);\n  if (targetMsgId) {\n    const { figureIndex: figIdx } = parseFigureKey(target.figureKey);\n    reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C figIdx\x2C 1\x2C target.playerNum);\n    try {\n      const tMeta = dcMessageMeta.get(targetMsgId);\n      if (tMeta) {\n        const ch = await fetchGameChannel(client\x2C getPlayAreaId(game\x2C tMeta.playerNum));\n        const msg = await ch.messages.fetch(targetMsgId);\n        const { embed\x2C files } = await renderDcEmbed(game\x2C targetMsgId\x2C ctx);\n        await msg.edit({ embeds: [embed]\x2C files }).catch(discordCatch);\n      }\n    } catch {}\n  }\n  const dfThread = await fetchCombatThread(client\x2C df.combatThreadId);\n  if (dfThread) await dfThread.send(`**Deflect** \u2014 **${df.deflectorDcName}**: **${target.label}** suffers 1 Damage.`).catch(discordCatch);\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `**Deflect** \u2014 **${df.deflectorDcName}** redirects 1 Damage to **${target.label}**.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  delete game.pendingDeflect;\n  saveGames();\n}\n\nexport async function handleDeflectSkip(interaction\x2C ctx) {\n  const { getGame\x2C saveGames } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const m = interaction.customId.match(/^deflect_skip_([^_]+)$/);\n  if (!m) return;\n  const game = getGame(m[1]);\n  if (game) delete game.pendingDeflect;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  saveGames();\n}\n\n// \u2500\u2500 Wanton Destruction (Saw Gerrera) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nexport async function handleWantonUse(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C canActAsPlayer\x2C logGameAction } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const m = interaction.customId.match(/^wanton_use_([^_]+)$/);\n  if (!m) return;\n  const game = getGame(m[1]);\n  if (!game?.pendingWantonDestruction) return;\n  const wd = game.pendingWantonDestruction;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C wd.ownerPlayerNum\x2C canActAsPlayer\x2C 'Only the attacker\\'s team can use Wanton Destruction.')) return;\n  // Discard the first CC card from hand (auto-pick cheapest)\n  const hKey = ccHandKey(wd.ownerPlayerNum);\n  const hand = game[hKey] || [];\n  if (hand.length === 0) {\n    await interaction.followUp({ content: 'No Command cards in hand to discard.'\x2C ephemeral: true }).catch(discordCatch);\n    delete game.pendingWantonDestruction;\n    await interaction.message.edit({ components: [] }).catch(discordCatch);\n    saveGames(); return;\n  }\n  // Show CC cards as buttons for the player to pick which to discard\n  // Discord allows max 25 buttons (5 rows x 5)\n  const ccBtns = [...new Set(hand)].slice(0\x2C 25).map((card\x2C i) =>\n    new ButtonBuilder().setCustomId(`wanton_cc_${game.gameId}_${i}_${card.replace(/\\s+/g\x2C '_').slice(0\x2C 40)}`).setLabel(card.slice(0\x2C 80)).setStyle(ButtonStyle.Secondary)\n  );\n  const ccRows = chunkButtonsToRows(ccBtns);\n  await interaction.message.edit({\n    content: `**Wanton Destruction** \u2014 Choose a Command card to discard:`\x2C\n    components: ccRows\x2C\n  }).catch(discordCatch);\n  saveGames();\n}\n\nexport async function handleWantonCcPick(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C canActAsPlayer\x2C dcHealthState\x2C dcMessageMeta\x2C\n    dcExhaustedState\x2C findDcMessageIdForFigure\x2C renderDcEmbed\x2C logGameAction } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  // wanton_cc_{gameId}_{index}_{cardNameSlug}\n  const m = interaction.customId.match(/^wanton_cc_([^_]+)_(\\d+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C idxStr\x2C cardSlug] = m;\n  const game = getGame(gameId);\n  if (!game?.pendingWantonDestruction) return;\n  const wd = game.pendingWantonDestruction;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C wd.ownerPlayerNum\x2C canActAsPlayer\x2C 'Not your choice.')) return;\n  // Find and discard the CC card\n  const hKey = ccHandKey(wd.ownerPlayerNum);\n  const dKey = ccDiscardKey(wd.ownerPlayerNum);\n  const hand = game[hKey] || [];\n  const uniqueCards = [...new Set(hand)];\n  const cardIdx = parseInt(idxStr\x2C 10);\n  const cardName = uniqueCards[cardIdx];\n  if (!cardName) return;\n  // Remove from hand\x2C add to discard\n  const hIdx = hand.indexOf(cardName);\n  if (hIdx >= 0) hand.splice(hIdx\x2C 1);\n  game[hKey] = hand;\n  game[dKey] = [...(game[dKey] || [])\x2C cardName];\n  await logGameAction(game\x2C client\x2C `**Wanton Destruction** \u2014 Discarded **${cardName}**.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  // Show figure picker \u2014 Discord allows max 25 buttons (5 rows x 5); reserve 1 for Done\n  const btns = wd.targets.slice(0\x2C 24).map((t\x2C i) =>\n    new ButtonBuilder().setCustomId(`wanton_pick_${gameId}_${i}`).setLabel(t.label.slice(0\x2C 80)).setStyle(ButtonStyle.Danger)\n  );\n  btns.push(new ButtonBuilder().setCustomId(`wanton_done_${gameId}`).setLabel('Done').setStyle(ButtonStyle.Secondary));\n  const rows = chunkButtonsToRows(btns);\n  await interaction.message.edit({\n    content: `**Wanton Destruction** \u2014 CC discarded. Choose up to ${wd.maxPicks} figures to deal 1 Damage:`\x2C\n    components: rows\x2C\n  }).catch(discordCatch);\n  saveGames();\n}\n\nexport async function handleWantonPick(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C client\x2C canActAsPlayer\x2C dcHealthState\x2C dcMessageMeta\x2C\n    dcExhaustedState\x2C findDcMessageIdForFigure\x2C renderDcEmbed\x2C logGameAction } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const m = interaction.customId.match(/^wanton_pick_([^_]+)_(\\d+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C idxStr] = m;\n  const game = getGame(gameId);\n  if (!game?.pendingWantonDestruction) return;\n  const wd = game.pendingWantonDestruction;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C wd.ownerPlayerNum\x2C canActAsPlayer\x2C 'Not your pick.')) return;\n  const target = wd.targets[parseInt(idxStr\x2C 10)];\n  if (!target) return;\n  const targetMsgId = findDcMessageIdForFigure(gameId\x2C target.playerNum\x2C target.figureKey);\n  if (targetMsgId) {\n    const { figureIndex: figIdx } = parseFigureKey(target.figureKey);\n    reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C figIdx\x2C 1\x2C target.playerNum);\n    try {\n      const tMeta = dcMessageMeta.get(targetMsgId);\n      if (tMeta) {\n        const ch = await fetchGameChannel(client\x2C getPlayAreaId(game\x2C tMeta.playerNum));\n        const msg = await ch.messages.fetch(targetMsgId);\n        const { embed\x2C files } = await renderDcEmbed(game\x2C targetMsgId\x2C ctx);\n        await msg.edit({ embeds: [embed]\x2C files }).catch(discordCatch);\n      }\n    } catch {}\n  }\n  wd.chosen.push(target.figureKey);\n  const thread = await fetchCombatThread(client\x2C wd.combatThreadId);\n  if (thread) await thread.send(`**Wanton Destruction** \u2014 **${target.label}** suffers 1 Damage.`).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `**Wanton Destruction** \u2014 **${target.label}** suffers 1 Damage.`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  const remaining = wd.maxPicks - wd.chosen.length;\n  const remTargets = wd.targets.filter(t => !wd.chosen.includes(t.figureKey));\n  if (remaining > 0 && remTargets.length > 0) {\n    // Discord allows max 25 buttons (5 rows x 5); reserve 1 for Done\n    const btns2 = remTargets.slice(0\x2C 24).map(t => {\n      const origIdx = wd.targets.indexOf(t);\n      return new ButtonBuilder().setCustomId(`wanton_pick_${gameId}_${origIdx}`).setLabel(t.label.slice(0\x2C 80)).setStyle(ButtonStyle.Danger);\n    });\n    btns2.push(new ButtonBuilder().setCustomId(`wanton_done_${gameId}`).setLabel('Done').setStyle(ButtonStyle.Secondary));\n    const rows2 = chunkButtonsToRows(btns2);\n    await interaction.message.edit({ content: `**Wanton Destruction** \u2014 ${remaining} pick(s) remaining:`\x2C components: rows2 }).catch(discordCatch);\n  } else {\n    delete game.pendingWantonDestruction;\n    await interaction.message.edit({ content: `**Wanton Destruction** \u2014 Complete.`\x2C components: [] }).catch(discordCatch);\n  }\n  saveGames();\n}\n\nexport async function handleWantonDone(interaction\x2C ctx) {\n  const { getGame\x2C saveGames } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const m = interaction.customId.match(/^wanton_done_([^_]+)$/);\n  if (!m) return;\n  const game = getGame(m[1]);\n  if (game) delete game.pendingWantonDestruction;\n  await interaction.message.edit({ content: `**Wanton Destruction** \u2014 Complete.`\x2C components: [] }).catch(discordCatch);\n  saveGames();\n}\n\nexport async function handleWantonSkip(interaction\x2C ctx) {\n  const { getGame\x2C saveGames } = ctx;\n  await interaction.deferUpdate().catch(discordCatch);\n  const m = interaction.customId.match(/^wanton_skip_([^_]+)$/);\n  if (!m) return;\n  const game = getGame(m[1]);\n  if (game) delete game.pendingWantonDestruction;\n  await interaction.message.edit({ components: [] }).catch(discordCatch);\n  saveGames();\n}\n
