script-source,496,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/discord.js/src/errors/Messages.js,'use strict';\n\nconst DjsErrorCodes = require('./ErrorCodes');\n\nconst Messages = {\n  [DjsErrorCodes.ClientInvalidOption]: (prop\x2C must) => `The ${prop} option must be ${must}`\x2C\n  [DjsErrorCodes.ClientInvalidProvidedShards]: 'None of the provided shards were valid.'\x2C\n  [DjsErrorCodes.ClientMissingIntents]: 'Valid intents must be provided for the Client.'\x2C\n  [DjsErrorCodes.ClientNotReady]: action => `The client needs to be logged in to ${action}.`\x2C\n\n  [DjsErrorCodes.TokenInvalid]: 'An invalid token was provided.'\x2C\n  [DjsErrorCodes.TokenMissing]: 'Request to use token\x2C but token was unavailable to the client.'\x2C\n  [DjsErrorCodes.ApplicationCommandPermissionsTokenMissing]:\n    'Editing application command permissions requires an OAuth2 bearer token\x2C but none was provided.'\x2C\n\n  [DjsErrorCodes.WSCloseRequested]: 'WebSocket closed due to user request.'\x2C\n  [DjsErrorCodes.WSConnectionExists]: 'There is already an existing WebSocket connection.'\x2C\n  [DjsErrorCodes.WSNotOpen]: (data = 'data') => `WebSocket not open to send ${data}`\x2C\n  [DjsErrorCodes.ManagerDestroyed]: 'Manager was destroyed.'\x2C\n\n  [DjsErrorCodes.BitFieldInvalid]: bit => `Invalid bitfield flag or number: ${bit}.`\x2C\n\n  [DjsErrorCodes.ShardingInvalid]: 'Invalid shard settings were provided.'\x2C\n  [DjsErrorCodes.ShardingRequired]: 'This session would have handled too many guilds - Sharding is required.'\x2C\n  [DjsErrorCodes.InvalidIntents]: 'Invalid intent provided for WebSocket intents.'\x2C\n  [DjsErrorCodes.DisallowedIntents]: 'Privileged intent provided is not enabled or whitelisted.'\x2C\n  [DjsErrorCodes.ShardingNoShards]: 'No shards have been spawned.'\x2C\n  [DjsErrorCodes.ShardingInProcess]: 'Shards are still being spawned.'\x2C\n  [DjsErrorCodes.ShardingInvalidEvalBroadcast]: 'Script to evaluate must be a function'\x2C\n  [DjsErrorCodes.ShardingShardNotFound]: id => `Shard ${id} could not be found.`\x2C\n  [DjsErrorCodes.ShardingAlreadySpawned]: count => `Already spawned ${count} shards.`\x2C\n  [DjsErrorCodes.ShardingProcessExists]: id => `Shard ${id} already has an active process.`\x2C\n  [DjsErrorCodes.ShardingWorkerExists]: id => `Shard ${id} already has an active worker.`\x2C\n  [DjsErrorCodes.ShardingReadyTimeout]: id => `Shard ${id}'s Client took too long to become ready.`\x2C\n  [DjsErrorCodes.ShardingReadyDisconnected]: id => `Shard ${id}'s Client disconnected before becoming ready.`\x2C\n  [DjsErrorCodes.ShardingReadyDied]: id => `Shard ${id}'s process exited before its Client became ready.`\x2C\n  [DjsErrorCodes.ShardingNoChildExists]: id => `Shard ${id} has no active process or worker.`\x2C\n  [DjsErrorCodes.ShardingShardMiscalculation]: (shard\x2C guild\x2C count) =>\n    `Calculated invalid shard ${shard} for guild ${guild} with ${count} shards.`\x2C\n\n  [DjsErrorCodes.ColorRange]: 'Color must be within the range 0 - 16777215 (0xFFFFFF).'\x2C\n  [DjsErrorCodes.ColorConvert]: color => `Unable to convert "${color}" to a number.`\x2C\n\n  [DjsErrorCodes.InviteOptionsMissingChannel]:\n    'A valid guild channel must be provided when GuildScheduledEvent is EXTERNAL.'\x2C\n\n  [DjsErrorCodes.ButtonLabel]: 'MessageButton label must be a string'\x2C\n  [DjsErrorCodes.ButtonURL]: 'MessageButton URL must be a string'\x2C\n  [DjsErrorCodes.ButtonCustomId]: 'MessageButton customId must be a string'\x2C\n\n  [DjsErrorCodes.SelectMenuCustomId]: 'MessageSelectMenu customId must be a string'\x2C\n  [DjsErrorCodes.SelectMenuPlaceholder]: 'MessageSelectMenu placeholder must be a string'\x2C\n  [DjsErrorCodes.SelectOptionLabel]: 'MessageSelectOption label must be a string'\x2C\n  [DjsErrorCodes.SelectOptionValue]: 'MessageSelectOption value must be a string'\x2C\n  [DjsErrorCodes.SelectOptionDescription]: 'MessageSelectOption description must be a string'\x2C\n\n  [DjsErrorCodes.InteractionCollectorError]: reason =>\n    `Collector received no interactions before ending with reason: ${reason}`\x2C\n\n  [DjsErrorCodes.FileNotFound]: file => `File could not be found: ${file}`\x2C\n\n  [DjsErrorCodes.UserBannerNotFetched]: "You must fetch this user's banner before trying to generate its URL!"\x2C\n  [DjsErrorCodes.UserNoDMChannel]: 'No DM Channel exists!'\x2C\n\n  [DjsErrorCodes.VoiceNotStageChannel]: 'You are only allowed to do this in stage channels.'\x2C\n\n  [DjsErrorCodes.VoiceStateNotOwn]:\n    'You cannot self-deafen/mute/request to speak on VoiceStates that do not belong to the ClientUser.'\x2C\n  [DjsErrorCodes.VoiceStateInvalidType]: name => `${name} must be a boolean.`\x2C\n\n  [DjsErrorCodes.ReqResourceType]: 'The resource must be a string\x2C Buffer or a valid file stream.'\x2C\n\n  [DjsErrorCodes.ImageFormat]: format => `Invalid image format: ${format}`\x2C\n  [DjsErrorCodes.ImageSize]: size => `Invalid image size: ${size}`\x2C\n\n  [DjsErrorCodes.MessageBulkDeleteType]: 'The messages must be an Array\x2C Collection\x2C or number.'\x2C\n  [DjsErrorCodes.MessageContentType]: 'Message content must be a string.'\x2C\n  [DjsErrorCodes.MessageNonceRequired]: 'Message nonce is required when enforceNonce is true.'\x2C\n  [DjsErrorCodes.MessageNonceType]: 'Message nonce must be an integer or a string.'\x2C\n\n  [DjsErrorCodes.SplitMaxLen]: 'Chunk exceeds the max length and contains no split characters.'\x2C\n\n  [DjsErrorCodes.BanResolveId]: (ban = false) => `Couldn't resolve the user id to ${ban ? 'ban' : 'unban'}.`\x2C\n  [DjsErrorCodes.FetchBanResolveId]: "Couldn't resolve the user id to fetch the ban."\x2C\n\n  [DjsErrorCodes.PruneDaysType]: 'Days must be a number'\x2C\n\n  [DjsErrorCodes.GuildChannelResolve]: 'Could not resolve channel to a guild channel.'\x2C\n  [DjsErrorCodes.GuildVoiceChannelResolve]: 'Could not resolve channel to a guild voice channel.'\x2C\n  [DjsErrorCodes.GuildChannelOrphan]: 'Could not find a parent to this guild channel.'\x2C\n  [DjsErrorCodes.GuildChannelUnowned]: "The fetched channel does not belong to this manager's guild."\x2C\n  [DjsErrorCodes.GuildOwned]: 'Guild is owned by the client.'\x2C\n  [DjsErrorCodes.GuildMembersTimeout]: "Members didn't arrive in time."\x2C\n  [DjsErrorCodes.GuildSoundboardSoundsTimeout]: "Soundboard sounds didn't arrive in time."\x2C\n  [DjsErrorCodes.GuildUncachedMe]: 'The client user as a member of this guild is uncached.'\x2C\n  [DjsErrorCodes.ChannelNotCached]: 'Could not find the channel where this message came from in the cache!'\x2C\n  [DjsErrorCodes.StageChannelResolve]: 'Could not resolve channel to a stage channel.'\x2C\n  [DjsErrorCodes.GuildScheduledEventResolve]: 'Could not resolve the guild scheduled event.'\x2C\n  [DjsErrorCodes.FetchOwnerId]: type =>\n    `Couldn't resolve the ${type} ownerId to fetch the ${type} ${type === 'group DM' ? 'owner' : 'member'}.`\x2C\n\n  [DjsErrorCodes.InvalidType]: (name\x2C expected\x2C an = false) => `Supplied ${name} is not a${an ? 'n' : ''} ${expected}.`\x2C\n  [DjsErrorCodes.InvalidElement]: (type\x2C name\x2C elem) => `Supplied ${type} ${name} includes an invalid element: ${elem}`\x2C\n\n  [DjsErrorCodes.MessageThreadParent]: 'The message was not sent in a guild text or news channel'\x2C\n  [DjsErrorCodes.MessageExistingThread]: 'The message already has a thread'\x2C\n  [DjsErrorCodes.ThreadInvitableType]: type => `Invitable cannot be edited on ${type}`\x2C\n\n  [DjsErrorCodes.WebhookMessage]: 'The message was not sent by a webhook.'\x2C\n  [DjsErrorCodes.WebhookTokenUnavailable]: 'This action requires a webhook token\x2C but none is available.'\x2C\n  [DjsErrorCodes.WebhookURLInvalid]: 'The provided webhook URL is not valid.'\x2C\n  [DjsErrorCodes.WebhookApplication]: 'This message webhook belongs to an application and cannot be fetched.'\x2C\n  [DjsErrorCodes.MessageReferenceMissing]: 'The message does not reference another message'\x2C\n\n  [DjsErrorCodes.EmojiType]: 'Emoji must be a string or GuildEmoji/ReactionEmoji'\x2C\n  [DjsErrorCodes.EmojiManaged]: 'Emoji is managed and has no Author.'\x2C\n  [DjsErrorCodes.MissingManageGuildExpressionsPermission]: guild =>\n    // eslint-disable-next-line max-len\n    `Client must have Create Guild Expressions or Manage Guild Expressions permission in guild ${guild} to see emoji authors.`\x2C\n  [DjsErrorCodes.MissingManageEmojisAndStickersPermission]: guild =>\n    `Client must have Manage Emojis and Stickers permission in guild ${guild} to see emoji authors.`\x2C\n\n  [DjsErrorCodes.NotGuildSoundboardSound]: action =>\n    `Soundboard sound is a default (non-guild) soundboard sound and can't be ${action}.`\x2C\n  [DjsErrorCodes.NotGuildSticker]: 'Sticker is a standard (non-guild) sticker and has no author.'\x2C\n\n  [DjsErrorCodes.ReactionResolveUser]: "Couldn't resolve the user id to remove from the reaction."\x2C\n\n  [DjsErrorCodes.VanityURL]: 'This guild does not have the vanity URL feature enabled.'\x2C\n\n  [DjsErrorCodes.InviteResolveCode]: 'Could not resolve the code to fetch the invite.'\x2C\n\n  [DjsErrorCodes.InviteNotFound]: 'Could not find the requested invite.'\x2C\n\n  [DjsErrorCodes.DeleteGroupDMChannel]: "Bots don't have access to Group DM Channels and cannot delete them"\x2C\n  [DjsErrorCodes.FetchGroupDMChannel]: "Bots don't have access to Group DM Channels and cannot fetch them"\x2C\n\n  [DjsErrorCodes.MemberFetchNonceLength]: 'Nonce length must not exceed 32 characters.'\x2C\n\n  [DjsErrorCodes.GlobalCommandPermissions]:\n    'Permissions for global commands may only be fetched or modified by providing a GuildResolvable ' +\n    "or from a guild's application command manager."\x2C\n  [DjsErrorCodes.GuildUncachedEntityResolve]: type =>\n    `Cannot resolve ${type} from an arbitrary guild\x2C provide an id instead`\x2C\n\n  [DjsErrorCodes.InteractionAlreadyReplied]: 'The reply to this interaction has already been sent or deferred.'\x2C\n  [DjsErrorCodes.InteractionNotReplied]: 'The reply to this interaction has not been sent or deferred.'\x2C\n  [DjsErrorCodes.InteractionEphemeralReplied]: 'Ephemeral responses cannot be deleted.'\x2C\n\n  [DjsErrorCodes.CommandInteractionOptionNotFound]: name => `Required option "${name}" not found.`\x2C\n  [DjsErrorCodes.CommandInteractionOptionType]: (name\x2C type\x2C expected) =>\n    `Option "${name}" is of type: ${type}; expected ${expected}.`\x2C\n  [DjsErrorCodes.CommandInteractionOptionEmpty]: (name\x2C type) =>\n    `Required option "${name}" is of type: ${type}; expected a non-empty value.`\x2C\n  [DjsErrorCodes.CommandInteractionOptionNoSubcommand]: 'No subcommand specified for interaction.'\x2C\n  [DjsErrorCodes.CommandInteractionOptionNoSubcommandGroup]: 'No subcommand group specified for interaction.'\x2C\n  [DjsErrorCodes.CommandInteractionOptionInvalidChannelType]: (name\x2C type\x2C expected) =>\n    `The type of channel of the option "${name}" is: ${type}; expected ${expected}.`\x2C\n  [DjsErrorCodes.AutocompleteInteractionOptionNoFocusedOption]: 'No focused option for autocomplete interaction.'\x2C\n\n  [DjsErrorCodes.ModalSubmitInteractionFieldNotFound]: customId =>\n    `Required field with custom id "${customId}" not found.`\x2C\n  [DjsErrorCodes.ModalSubmitInteractionFieldType]: (customId\x2C type\x2C expected) =>\n    `Field with custom id "${customId}" is of type: ${type}; expected ${expected}.`\x2C\n  [DjsErrorCodes.ModalSubmitInteractionFieldEmpty]: (customId\x2C type) =>\n    `Required field with custom id "${customId}" is of type: ${type}; expected a non-empty value.`\x2C\n  [DjsErrorCodes.ModalSubmitInteractionFieldInvalidChannelType]: (customId\x2C type\x2C expected) =>\n    `The type of channel of the field with custom id "${customId}" is: ${type}; expected ${expected}.`\x2C\n\n  [DjsErrorCodes.InvalidMissingScopes]: 'At least one valid scope must be provided for the invite'\x2C\n  [DjsErrorCodes.InvalidScopesWithPermissions]: 'Permissions cannot be set without the bot scope.'\x2C\n\n  [DjsErrorCodes.NotImplemented]: (what\x2C name) => `Method ${what} not implemented on ${name}.`\x2C\n\n  [DjsErrorCodes.SweepFilterReturn]: 'The return value of the sweepFilter function was not false or a Function'\x2C\n\n  [DjsErrorCodes.GuildForumMessageRequired]: 'You must provide a message to create a guild forum thread'\x2C\n\n  [DjsErrorCodes.EntitlementCreateInvalidOwner]:\n    'You must provide either a guild or a user to create an entitlement\x2C but not both'\x2C\n\n  [DjsErrorCodes.BulkBanUsersOptionEmpty]: 'Option "users" array or collection is empty'\x2C\n\n  [DjsErrorCodes.PollAlreadyExpired]: 'This poll has already expired.'\x2C\n};\n\nmodule.exports = Messages;\n
