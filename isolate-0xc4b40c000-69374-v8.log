script-source,436,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/undici/lib/web/websocket/constants.js,'use strict'\n\n// This is a Globally Unique Identifier unique used\n// to validate that the endpoint accepts websocket\n// connections.\n// See https://www.rfc-editor.org/rfc/rfc6455.html#section-1.3\nconst uid = '258EAFA5-E914-47DA-95CA-C5AB0DC85B11'\n\n/** @type {PropertyDescriptor} */\nconst staticPropertyDescriptors = {\n  enumerable: true\x2C\n  writable: false\x2C\n  configurable: false\n}\n\nconst states = {\n  CONNECTING: 0\x2C\n  OPEN: 1\x2C\n  CLOSING: 2\x2C\n  CLOSED: 3\n}\n\nconst sentCloseFrameState = {\n  NOT_SENT: 0\x2C\n  PROCESSING: 1\x2C\n  SENT: 2\n}\n\nconst opcodes = {\n  CONTINUATION: 0x0\x2C\n  TEXT: 0x1\x2C\n  BINARY: 0x2\x2C\n  CLOSE: 0x8\x2C\n  PING: 0x9\x2C\n  PONG: 0xA\n}\n\nconst maxUnsigned16Bit = 2 ** 16 - 1 // 65535\n\nconst parserStates = {\n  INFO: 0\x2C\n  PAYLOADLENGTH_16: 2\x2C\n  PAYLOADLENGTH_64: 3\x2C\n  READ_DATA: 4\n}\n\nconst emptyBuffer = Buffer.allocUnsafe(0)\n\nconst sendHints = {\n  string: 1\x2C\n  typedArray: 2\x2C\n  arrayBuffer: 3\x2C\n  blob: 4\n}\n\nmodule.exports = {\n  uid\x2C\n  sentCloseFrameState\x2C\n  staticPropertyDescriptors\x2C\n  states\x2C\n  opcodes\x2C\n  maxUnsigned16Bit\x2C\n  parserStates\x2C\n  emptyBuffer\x2C\n  sendHints\n}\n
