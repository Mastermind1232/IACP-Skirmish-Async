script-source,138,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/domain/reducer/hand-reducer.js,export const handReducerHandlers = {\n  DeckShuffled(state\x2C payload) {\n    const deckKey = payload.playerNum === 1 ? 'player1CcDeck' : 'player2CcDeck';\n    const discardKey = payload.playerNum === 1 ? 'player1CcDiscard' : 'player2CcDiscard';\n    // Shuffle discard into deck\n    const shuffled = [...(state[discardKey] || [])];\n    // Fisher-Yates (seeded externally if needed \u2014 for reducer\x2C just accept the payload order)\n    if (payload.newDeckOrder) {\n      return { ...state\x2C [deckKey]: payload.newDeckOrder\x2C [discardKey]: [] };\n    }\n    return { ...state\x2C [deckKey]: shuffled\x2C [discardKey]: [] };\n  }\x2C\n\n  CardsDrawn(state\x2C payload) {\n    const deckKey = payload.playerNum === 1 ? 'player1CcDeck' : 'player2CcDeck';\n    const handKey = payload.playerNum === 1 ? 'player1CcHand' : 'player2CcHand';\n    const deck = [...(state[deckKey] || [])];\n    const hand = [...(state[handKey] || [])];\n    const drawn = deck.splice(0\x2C payload.count);\n    hand.push(...drawn);\n    return { ...state\x2C [deckKey]: deck\x2C [handKey]: hand };\n  }\x2C\n\n  CardPlayed(state\x2C payload) {\n    const handKey = payload.playerNum === 1 ? 'player1CcHand' : 'player2CcHand';\n    const hand = (state[handKey] || []).filter(c => c !== payload.cardName);\n    return { ...state\x2C [handKey]: hand };\n  }\x2C\n\n  CardDiscarded(state\x2C payload) {\n    const handKey = payload.playerNum === 1 ? 'player1CcHand' : 'player2CcHand';\n    const discardKey = payload.playerNum === 1 ? 'player1CcDiscard' : 'player2CcDiscard';\n    const hand = (state[handKey] || []).filter(c => c !== payload.cardName);\n    const discard = [...(state[discardKey] || [])\x2C payload.cardName];\n    return { ...state\x2C [handKey]: hand\x2C [discardKey]: discard };\n  }\x2C\n\n  NegationAttempted(state\x2C payload) {\n    return {\n      ...state\x2C\n      pendingNegation: {\n        playerNum: payload.playerNum\x2C\n        targetCardName: payload.targetCardName\x2C\n        resolved: false\x2C\n      }\x2C\n    };\n  }\x2C\n\n  NegationResolved(state\x2C payload) {\n    const next = { ...state };\n    delete next.pendingNegation;\n    return next;\n  }\x2C\n\n  SquadSubmitted(state\x2C payload) {\n    const squadKey = payload.playerNum === 1 ? 'player1Squad' : 'player2Squad';\n    return {\n      ...state\x2C\n      [squadKey]: {\n        affiliation: payload.affiliation\x2C\n        cards: payload.cards || []\x2C\n      }\x2C\n    };\n  }\x2C\n};\n
