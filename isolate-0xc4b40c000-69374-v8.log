rning) {\n        const readableURIEncode = (string) => ArrayPrototypeReduce(\n          [\n            [/'/g\x2C '%27']\x2C // We need to URL-encode the single quote as it's the delimiter for the --import flag.\n            [/%22/g\x2C '"']\x2C // We can decode the double quotes to improve readability.\n            [/%2F/ig\x2C '/']\x2C // We can decode the slashes to improve readability.\n          ]\x2C\n          (str\x2C { 0: regex\x2C 1: replacement }) => RegExpPrototypeSymbolReplace(hardenRegExp(regex)\x2C str\x2C replacement)\x2C\n          encodeURIComponent(string));\n        process.emitWarning(\n          '`--experimental-loader` may be removed in the future; instead use `register()`:\\n' +\n          `--import 'data:text/javascript\x2Cimport { register } from "node:module"; import { pathToFileURL } from "node:url"; ${ArrayPrototypeJoin(\n            ArrayPrototypeMap(userLoaderPaths\x2C (loader) => `register(${readableURIEncode(JSONStringify(loader))}\x2C pathToFileURL("./"))`)\x2C\n            '; '\x2C\n          )};'`\x2C\n          'ExperimentalWarning'\x2C\n        );\n        emittedLoaderFlagWarning = true;\n      }\n      const { AsyncLoaderHooksProxiedToLoaderHookWorker } = require('internal/modules/esm/hooks');\n      asyncLoaderHooks = new AsyncLoaderHooksProxiedToLoaderHookWorker();\n    }\n  }\n\n  return new ModuleLoader(asyncLoaderHooks);\n}\n\nlet allowImportMetaResolveParentURL;\n/**\n * This is only called from the native ImportMetaObjectInitialize function to set up import.meta.resolve\n * when import.meta.resolve is accessed for the first time in a module.\n * @param {ModuleLoader} loader The cascaded loader to use. Bound when this function gets passed to native land.\n * @param {string} moduleURL URL of the module accessing import.meta\n * @returns {function(string\x2C URL['href']=): string} The import.meta.resolve function\n */\nfunction createImportMetaResolve(loader\x2C moduleURL) {\n  /**\n   * @param {string} specifier The modul