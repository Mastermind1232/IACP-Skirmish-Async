= options.parentURL;\n  }\n  getOrInitializeCascadedLoader().register(\n    specifier\x2C\n    parentURL ?? 'data:'\x2C\n    options?.data\x2C\n    options?.transferList\x2C\n  );\n}\n\nmodule.exports = {\n  createModuleLoader\x2C\n  getOrInitializeCascadedLoader\x2C\n  isCascadedLoaderInitialized\x2C\n  register\x2C\n};\n
