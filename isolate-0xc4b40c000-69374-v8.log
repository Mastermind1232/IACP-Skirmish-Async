script-source,510,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/discord.js/src/structures/Base.js,'use strict';\n\nconst { flatten } = require('../util/Util');\n\n/**\n * Represents a data model that is identifiable by a Snowflake (i.e. Discord API data models).\n * @abstract\n */\nclass Base {\n  constructor(client) {\n    /**\n     * The client that instantiated this\n     * @name Base#client\n     * @type {Client}\n     * @readonly\n     */\n    Object.defineProperty(this\x2C 'client'\x2C { value: client });\n  }\n\n  _clone() {\n    return Object.assign(Object.create(this)\x2C this);\n  }\n\n  _patch(data) {\n    return data;\n  }\n\n  _update(data) {\n    const clone = this._clone();\n    this._patch(data);\n    return clone;\n  }\n\n  toJSON(...props) {\n    return flatten(this\x2C ...props);\n  }\n\n  valueOf() {\n    return this.id;\n  }\n}\n\nmodule.exports = Base;\n
