se 'HMAC':\n      resultType = 'CryptoKey';\n      result = await require('internal/crypto/mac')\n        .hmacGenerateKey(algorithm\x2C extractable\x2C keyUsages);\n      break;\n    case 'AES-CTR':\n      // Fall through\n    case 'AES-CBC':\n      // Fall through\n    case 'AES-GCM':\n      // Fall through\n    case 'AES-OCB':\n      // Fall through\n    case 'AES-KW':\n      resultType = 'CryptoKey';\n      result = await require('internal/crypto/aes')\n        .aesGenerateKey(algorithm\x2C extractable\x2C keyUsages);\n      break;\n    case 'ChaCha20-Poly1305':\n      resultType = 'CryptoKey';\n      result = await require('internal/crypto/chacha20_poly1305')\n        .c20pGenerateKey(algorithm\x2C extractable\x2C keyUsages);\n      break;\n    case 'ML-DSA-44':\n      // Fall through\n    case 'ML-DSA-65':\n      // Fall through\n    case 'ML-DSA-87':\n      resultType = 'CryptoKeyPair';\n      result = await require('internal/crypto/ml_dsa')\n        .mlDsaGenerateKey(algorithm\x2C extractable\x2C keyUsages);\n      break;\n    case 'ML-KEM-512':\n      // Fall through\n    case 'ML-KEM-768':\n      // Fall through\n    case 'ML-KEM-1024':\n      resultType = 'CryptoKeyPair';\n      result = await require('internal/crypto/ml_kem')\n        .mlKemGenerateKey(algorithm\x2C extractable\x2C keyUsages);\n      break;\n    case 'KMAC128':\n      // Fall through\n    case 'KMAC256':\n      resultType = 'CryptoKey';\n      result = await require('internal/crypto/mac')\n        .kmacGenerateKey(algorithm\x2C extractable\x2C keyUsages);\n      break;\n    default:\n      throw lazyDOMException('Unrecognized algorithm name'\x2C 'NotSupportedError');\n  }\n\n  if (\n    (resultType === 'CryptoKey' &&\n      (result[kKeyType] === 'secret' || result[kKeyType] === 'private') &&\n      result[kKeyUsages].length === 0) ||\n    (resultType === 'CryptoKeyPair' && result.privateKey[kKeyUsages].length === 0)\n  ) {\n    throw lazyDOMException(\n      'Usages cannot be empty when creating a key.'\x2C\n      'SyntaxError');\n  }\n\n  return result;\n}\n\nasync function deriveBits(algorithm\x2C baseKey\x2C length = null) {\n  if (this !== subtle) throw new ERR_INVALID_THIS('SubtleCrypto');\n\n  webidl ??= require('internal/crypto/webidl');\n  const prefix = "Failed to execute 'deriveBits' on 'SubtleCrypto'";\n  webidl.requiredArguments(arguments.length\x2C 2\x2C { prefix });\n  algorithm = webidl.converters.AlgorithmIdentifier(algorithm\x2C {\n    prefix\x2C\n    context: '1st argument'\x2C\n  });\n  baseKey = webidl.converters.CryptoKey(baseKey\x2C {\n    prefix\x2C\n    context: '2nd argument'\x2C\n  });\n  if (length !== null) {\n    length = webidl.converters['unsigned long'](length\x2C {\n      prefix\x2C\n      context: '3rd argument'\x2C\n    });\n  }\n\n  algorithm = normalizeAlgorithm(algorithm\x2C 'deriveBits');\n  if (!ArrayPrototypeIncludes(baseKey[kKeyUsages]\x2C 'deriveBits')) {\n    throw lazyDOMException(\n      'baseKey does not have deriveBits usage'\x2C\n      'InvalidAccessError');\n  }\n  if (baseKey[kAlgorithm].name !== algorithm.name)\n    throw lazyDOMException('Key algorithm mismatch'\x2C 'InvalidAccessError');\n  switch (algorithm.name) {\n    case 'X25519':\n      // Fall through\n    case 'X448':\n      // Fall through\n    case 'ECDH':\n      return await require('internal/crypto/diffiehellman')\n        .ecdhDeriveBits(algorithm\x2C baseKey\x2C length);\n    case 'HKDF':\n      return await require('internal/crypto/hkdf')\n        .hkdfDeriveBits(algorithm\x2C baseKey\x2C length);\n    case 'PBKDF2':\n      return await require('internal/crypto/pbkdf2')\n        .pbkdf2DeriveBits(algorithm\x2C baseKey\x2C length);\n    case 'Argon2d':\n      // Fall through\n    case 'Argon2i':\n      // Fall through\n    case 'Argon2id':\n      return await require('internal/crypto/argon2')\n        .argon2DeriveBits(algorithm\x2C baseKey\x2C length);\n  }\n  throw lazyDOMException('Unrecognized algorithm name'\x2C 'NotSupportedError');\n}\n\nfunction getKeyLength({ name\x2C length\x2C hash }) {\n  switch (name) {\n    case 'AES-CTR':\n    case 'AES-CBC':\n    case 'AES-GCM':\n    case 'AES-OCB':\n    case 'AES-KW':\n      if (length !== 128 && length !== 192 && length !== 256)\n        throw lazyDOMException('Invalid key length'\x2C 'OperationError');\n\n      return length;\n    case 'HMAC':\n      if (length === undefined) {\n        return getBlockSize(hash?.name);\n      }\n\n      if (typeof length === 'number' && length !== 0) {\n        return length;\n      }\n\n      throw lazyDOMException('Invalid key length'\x2C 'OperationError');\n    case 'KMAC128':\n    case 'KMAC256':\n      if (typeof length === 'number') {\n        return length;\n      }\n\n      return name === 'KMAC128' ? 128 : 256;\n    case 'HKDF':\n    case 'PBKDF2':\n    case 'Argon2d':\n    case 'Argon2i':\n    case 'Argon2id':\n      return null;\n    case 'ChaCha20-Poly1305':\n      return 256;\n  }\n}\n\nasync function deriveKey(\n  algorithm\x2C\n  baseKey\x2C\n  derivedKeyAlgorithm\x2C\n  extractable\x2C\n  keyUsages) {\n  if (this !== subtle) throw new ERR_INVALID_THIS('SubtleCrypto');\n\n  webidl ??= require('internal/crypto/webidl');\n  const prefix = "Failed to execute 'deriveKey' on 'SubtleCrypto'";\n  webidl.requiredArguments(arguments.length\x2C 5\x2C { prefix });\n  algorithm = webidl.converters.AlgorithmIdentifier(algorithm\x2C {\n    prefix\x2C\n    context: '1st argument'\x2C\n  });\n  baseKey = webidl.converters.CryptoKey(baseKey\x2C {\n    prefix\x2C\n    context: '2nd argument'\x2C\n  });\n  derivedKeyAlgorithm = webidl.converters.AlgorithmIdentifier(derivedKeyAlgorithm\x2C {\n    prefix\x2C\n    context: '3rd argument'\x2C\n  });\n  extractable = webidl.converters.boolean(extractable\x2C {\n    prefix\x2C\n    context: '4th argument'\x2C\n  });\n  keyUsages = webidl.converters['sequence<KeyUsage>'](keyUsages\x2C {\n    prefix\x2C\n    context: '5th argument'\x2C\n  });\n\n  algorithm = normalize