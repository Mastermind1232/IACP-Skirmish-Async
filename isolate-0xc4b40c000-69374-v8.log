script-source,91,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/index.js,/**\n * Handler registry: map handler key (prefix) to async (interaction\x2C context) => void.\n * Single place to register all handlers. index.js dispatches via if-chains with hand-built context objects.\n */\nimport { handleLobbyJoin\x2C handleLobbyStart } from './lobby.js';\nimport { handleRequestResolve\x2C handleRequestReject } from './requests.js';\nimport {\n  handleRefreshMap\x2C\n  handleRefreshAll\x2C\n  handleUndo\x2C\n  handleKillGame\x2C\n  handleDefaultDeck\x2C\n} from './game-tools.js';\nimport { handleSpecialDone } from './special.js';\nimport { handleInteractCancel\x2C handleInteractChoice } from './interact.js';\nimport { handleEndEndOfRound\x2C handleEndStartOfRound\x2C handleSorMissionReveal\x2C runStartOfRoundDcEffects\x2C runStartOfRoundContinuation\x2C runStatusPhaseAfterEndOfRound\x2C handleExtraArmorPick\x2C handleExtraArmorConfirm\x2C handleExtraArmorCancel\x2C handleRbfDiscard\x2C handleRogueOneReturn\x2C handleImpCitadel\x2C handleProgrammingOverride\x2C handleCtfPick\x2C handleCtfStrain\x2C handleDoubtFigPick\x2C handleDoubtRemove\x2C resolveStartOfRoundEffect } from './round.js';\nimport {\n  runPostDeployPhase\x2C advancePostDeployQueue\x2C onPostDeployMovementComplete\x2C onExtraArmorComplete\x2C\n  cleanupCompanionEmbedDeps\x2C\n  handlePostDeployPick\x2C handleSecurityDetailPick\x2C handleStrikeTeamAdjPick\x2C\n  handleStrikeTeamOrderPick\x2C handleStrikeTeamTokenPick\x2C handleStrikeTeamTokenDone\x2C\n  handlePostDeployMoveSkip\x2C handlePostDeployMoveStay\x2C handleSmoothLandingPick\x2C\n  handleWalkerMove\x2C handleWalkerSkip\x2C\n  handleArmsDistFigPick\x2C handleArmsDistTokenPick\x2C\n  handleCompanionDeployPick\x2C\n} from './post-deploy.js';\nimport { handleMoveMp\x2C handleMoveAdjustMp\x2C handleMovePick\x2C handleMoveInterruptPlay\x2C handleMoveInterruptSkip\x2C handleOverwatchInterruptUse\x2C handleOverwatchInterruptSkip\x2C handleDioFollowPick\x2C handleDioStay\x2C handleMassivePushSpace\x2C handleMassivePushFigure } from './movement.js';\nimport { handleAttackTarget\x2C handleCombatReady\x2C handleCombatResolveReady\x2C handleCombatRoll\x2C handleCombatSurge\x2C handleCleaveTarget\x2C handleCombatReroll\x2C handleCrossTrainingReroll\x2C handlePreReroll\x2C handleCombatPassive\x2C handleCombatToken\x2C handlePowerTokenChoice\x2C handlePowerTokenOverflowDiscard\x2C handleSpreadThePainCondPick\x2C handleFigureheadDecision\x2C handleLasatDiePick\x2C handleLasatFacePick\x2C handleFalseOrdersAtkPick\x2C handleCoverFireBlock\x2C handleCoverFireDiscard\x2C handleGuidanceSystems\x2C handleZilloDiscard\x2C handleStrainChoice\x2C handleUnderDuress\x2C handleRogueOneTokenPick\x2C handleCombatGateReady } from './combat.js';\nimport { handleStatusPhase\x2C handlePassActivationTurn\x2C handleEndTurn\x2C handleDcEndActivation\x2C handleDcSwitchFig\x2C handleConfirmActivate\x2C handleCancelActivate\x2C handleActPassive\x2C handleFieldTacticsPick\x2C handleForceVisionPick\x2C handleLiaDeployZone\x2C handleHeroicEffortReturn\x2C handleScavWeaponTransfer\x2C handleScFigPick\x2C handleHairTriggerUse\x2C handleHairTriggerSkip\x2C handleItWillBeAlrightUse\x2C handleItWillBeAlrightSkip\x2C handleItWillBeAlrightPick\x2C handleItWillBeAlrightAction } from './activation.js';\nimport {\n  handleMapSelection\x2C\n  handleMapTypeChoice\x2C\n  handleMapSelectionDraw\x2C\n  handleMapSelectionPick\x2C\n  handleDraftRandom\x2C\n  handleDetermineInitiative\x2C\n  handleDeploymentZone\x2C\n  handleDeploymentFig\x2C\n  handleDeploymentOrient\x2C\n  handleDeployPick\x2C\n  handleDeployRow\x2C\n  handleDeployRowBack\x2C\n  handleLoadoutSelect\x2C\n  handleLoadoutConfirm\x2C\n  handleFormPick\x2C\n  handleDeploymentDone\x2C\n  handleAutoDeploy\x2C\n  handleMapConfirm\x2C\n  handleMapGoBack\x2C\n  handleSetupAttachTo\x2C\n  handleAttachConfirm\x2C\n  handleAttachReselect\x2C\n  handleAttachDoneConfirm\x2C\n  handleAttachDoneRedo\x2C