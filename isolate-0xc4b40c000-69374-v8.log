script-source,349,node:http2,'use strict';\n\nconst {\n  connect\x2C\n  constants\x2C\n  createServer\x2C\n  createSecureServer\x2C\n  getDefaultSettings\x2C\n  getPackedSettings\x2C\n  getUnpackedSettings\x2C\n  performServerHandshake\x2C\n  sensitiveHeaders\x2C\n  Http2ServerRequest\x2C\n  Http2ServerResponse\x2C\n} = require('internal/http2/core');\n\nmodule.exports = {\n  connect\x2C\n  constants\x2C\n  createServer\x2C\n  createSecureServer\x2C\n  getDefaultSettings\x2C\n  getPackedSettings\x2C\n  getUnpackedSettings\x2C\n  performServerHandshake\x2C\n  sensitiveHeaders\x2C\n  Http2ServerRequest\x2C\n  Http2ServerResponse\x2C\n};\n
