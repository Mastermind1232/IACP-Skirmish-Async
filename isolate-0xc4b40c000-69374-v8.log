script-source,152,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/game/coords.js,/**\n * Coordinate and size helpers for map/grid. No Discord\x2C no game state.\n * Used by movement\x2C setup\x2C interact\x2C and index.\n */\n\nexport function normalizeCoord(coord) {\n  if (coord == null || typeof coord !== 'string') return '';\n  return coord.toLowerCase().trim();\n}\n\nexport function parseCoord(coord) {\n  const s = String(coord || '').toLowerCase();\n  const letter = s.match(/[a-z]+/)?.[0] || '';\n  const num = parseInt(s.match(/\\d+/)?.[0] || '0'\x2C 10);\n  const col = letter\n    ? [...letter].reduce((acc\x2C c) => acc * 26 + (c.charCodeAt(0) - 96)\x2C 0) - 1\n    : -1;\n  const row = num - 1;\n  return { col\x2C row };\n}\n\nexport function colRowToCoord(col\x2C row) {\n  if (col < 0 || row < 0) return '';\n  let letter = '';\n  let c = col;\n  while (c >= 0) {\n    letter = String.fromCharCode(65 + (c % 26)) + letter;\n    c = Math.floor(c / 26) - 1;\n  }\n  return letter.toLowerCase() + (row + 1);\n}\n\n/** Convert a topLeft coord to the bottom-left coord for display (same col\x2C last row of footprint). */\nexport function bottomLeftCoord(topLeft\x2C size) {\n  if (!topLeft) return topLeft;\n  const [\x2C rowsStr] = String(size || '1x1').split('x');\n  const rows = parseInt(rowsStr\x2C 10) || 1;\n  if (rows <= 1) return String(topLeft).toLowerCase();\n  const { col\x2C row } = parseCoord(topLeft);\n  return colRowToCoord(col\x2C row + rows - 1);\n}\n\nexport function edgeKey(a\x2C b) {\n  return [String(a).toLowerCase()\x2C String(b).toLowerCase()].sort().join('|');\n}\n\nexport function toLowerSet(arr = []) {\n  return new Set((arr || []).map((s) => normalizeCoord(s)));\n}\n\nexport function parseSizeString(size) {\n  const [colsRaw\x2C rowsRaw] = String(size || '1x1')\n    .toLowerCase()\n    .split('x')\n    .map((n) => parseInt(n\x2C 10) || 1);\n  return { cols: colsRaw || 1\x2C rows: rowsRaw || 1 };\n}\n\nexport function sizeToString(cols\x2C rows) {\n  return `${Math.max(1\x2C cols)}x${Math.max(1\x2C rows)}`;\n}\n\nexport function rotateSizeString(size) {\n  const { cols\x2C rows } = parseSizeString(size);\n  if (cols === rows) return sizeToString(cols\x2C rows);\n  return sizeToString(rows\x2C cols);\n}\n\nexport function shiftCoord(coord\x2C dx\x2C dy) {\n  const { col\x2C row } = parseCoord(coord);\n  return normalizeCoord(colRowToCoord(col + dx\x2C row + dy));\n}\n\n/** Get all cells a unit occupies when its top-left is at topLeftCoord. size: "1x1"|"1x2"|"2x2"|"2x3". */\nexport function getFootprintCells(topLeftCoord\x2C size) {\n  const { col\x2C row } = parseCoord(topLeftCoord);\n  if (col < 0 || row < 0) return [topLeftCoord];\n  const [cols\x2C rows] = (size || '1x1').split('x').map(Number) || [1\x2C 1];\n  const cells = [];\n  for (let r = 0; r < (rows || 1); r++) {\n    for (let c = 0; c < (cols || 1); c++) {\n      cells.push(colRowToCoord(col + c\x2C row + r));\n    }\n  }\n  return cells;\n}\n
