code-creation,Script,9,108579,0x315fd3056430,102, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/domain/reducer/activation-reducer.js:1:1,0x337a3506b9f0,~
script-source,136,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/domain/reducer/activation-reducer.js,import {\n  ACTIVATION_MSGID_FLAGS\x2C\n  ACTIVATION_FIGKEY_FLAGS\x2C\n  ACTIVATION_PLAYERNUM_FLAGS\x2C\n  ACTIVATION_SCALAR_FLAGS\x2C\n} from '../../game/activation-state.js';\n\nexport const activationReducerHandlers = {\n  DcActivated(state\x2C payload) {\n    const dcActionsData = { ...(state.dcActionsData || {}) };\n    dcActionsData[payload.msgId] = {\n      remaining: payload.totalActions || 2\x2C\n      total: payload.totalActions || 2\x2C\n      threadId: payload.threadId || null\x2C\n      messageId: payload.messageId || null\x2C\n      specialsUsed: []\x2C\n      selectedFigure: payload.selectedFigure || null\x2C\n    };\n    const activatedDcIndices = [...(state.activatedDcIndices || [])];\n    if (payload.dcIndex != null && !activatedDcIndices.includes(payload.dcIndex)) {\n      activatedDcIndices.push(payload.dcIndex);\n    }\n    return { ...state\x2C dcActionsData\x2C activatedDcIndices };\n  }\x2C\n\n  DcActionPerformed(state\x2C payload) {\n    const dcActionsData = { ...(state.dcActionsData || {}) };\n    const entry = dcActionsData[payload.msgId];\n    if (entry) {\n      dcActionsData[payload.msgId] = {\n        ...entry\x2C\n        remaining: entry.remaining - (payload.actionCost || 1)\x2C\n      };\n    }\n    return { ...state\x2C dcActionsData };\n  }\x2C\n\n  DcEndedActivation(state\x2C payload) {\n    const dcActionsData = { ...(state.dcActionsData || {}) };\n    const entry = dcActionsData[payload.msgId];\n    if (entry) {\n      dcActionsData[payload.msgId] = { ...entry\x2C remaining: 0 };\n    }\n    return { ...state\x2C dcActionsData };\n  }\x2C\n\n  ActivationCleanedUp(state\x2C payload) {\n    const next = { ...state };\n    for (const key of ACTIVATION_MSGID_FLAGS) {\n      if (next[key]?.[payload.msgId] !== undefined) {\n        next[key] = { ...next[key] };\n        delete next[key][payload.msgId];\n      }\n    }\n    if (payload.figureKeys) {\n      for (const key of ACTIVATION_FIGKEY_FLAGS) {\n        if (!next[key]) continue;\n        next[key] = { ...next[key] };\n        for (const fk of payload.figureKeys) {\n          delete next[key][fk];\n        }\n      }\n    }\n    if (payload.playerNum) {\n      for (const key of ACTIVATION_PLAYERNUM_FLAGS) {\n        if (next[key]?.[payload.playerNum] !== undefined) {\n          next[key] = { ...next[key] };\n          delete next[key][payload.playerNum];\n        }\n      }\n    }\n    for (const key of ACTIVATION_SCALAR_FLAGS) {\n      delete next[key];\n    }\n    return next;\n  }\x2C\n\n  ActivationTurnPassed(state\x2C payload) {\n    return {\n      ...state\x2C\n      currentActivationTurnPlayerNum: payload.newActivePlayerNum\x2C\n    };\n  }\x2C\n};\n
