ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const playerNum = meta.playerNum;\n  const enemyPlayerNum = opponentPlayerNum(playerNum);\n  const figureKey = `${meta.dcName}-${dgIndex}-${figureIndex}`;\n  const attackerPos = game.figurePositions?.[playerNum]?.[figureKey];\n  if (!attackerPos) {\n    await interaction.followUp({ content: 'Figure has no position yet.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  await buildAndSendAttackTargets(interaction\x2C ctx\x2C game\x2C meta\x2C msgId\x2C figureKey\x2C figureIndex\x2C {\n    dgIndex\x2C attackerPos\x2C attackerKws\x2C minRange: effectiveMinRange\x2C effectiveMaxRange: effectiveMaxRange_\x2C ms\x2C playerNum\x2C enemyPlayerNum\x2C stats\x2C\n    excludeFigureKeys: game.pendingMissileSalvo?.[msgId]?.targetsFired\x2C\n  });\n}\n\n/**\n * Handle false_orders_action_ button: choose Move or Attack for the controlled figure.\n * customId: false_orders_action_{gameId}_{msgId}_{move|attack}\n */\nexport async function handleFalseOrdersAction(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^false_orders_action_([^_]+)_([^_]+)_(move|attack|skip)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C msgId\x2C choice] = m;\n  const {\n    getGame\x2C replyIfGameEnded\x2C getDcStats\x2C getDcEffects\x2C getMapData\x2C\n    getFigureSize\x2C getFootprintCells\x2C getRange\x2C hasLineOfSight\x2C\n    getBoardStateForMovement\x2C getMovementProfile\x2C computeMovementCache\x2C\n    getMapAttachmentForSpaces\x2C\n    saveGames\x2C FIGURE_LETTERS\x2C getMapTokensData\x2C\n  } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (await replyIfGameEnded(game\x2C interaction)) return;\n  const fo = game.pendingFalseOrders;\n  if (!fo || (!fo.isLure && fo.murneRinMsgId !== msgId)) {\n    await interaction.followUp({ content: 'No pending False Orders / Lure.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { controlledFigureKey\x2C controlledPlayerNum\x2C controllerPlayerNum } = fo;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C controllerPlayerNum\x2C canActAsPlayer\x2C 'Only the controller may choose.')) return;\n  const controlledName = dcNameFromFigureKey(controlledFigureKey);\n  const controlledStats = getDcStats(controlledName);\n  const controlledPos = game.figurePositions?.[controlledPlayerNum]?.[controlledFigureKey];\n\n  // Lure skip: hostile suffers 2 strain anyway (per card rules\x2C strain happens regardless)\n  if (choice === 'skip') {\n    if (fo.isLure && fo.postAttackStrain > 0) {\n      // Apply Lure strain directly via dcHealthState\n      const _lureMsgId = ctx.findDcMessageIdForFigure?.(game.gameId\x2C controlledPlayerNum\x2C controlledFigureKey);\n      if (_lureMsgId) {\n        const _lureFigMatch = controlledFigureKey.match(/-(\\d+)-(\\d+)$/);\n        const _lureFigIdx = _lureFigMatch ? parseInt(_lureFigMatch[2]\x2C 10) : 0;\n        const _lureHs = ctx.dcHealthState?.get(_lureMsgId) || [];\n        const _lureEntry = _lureHs[_lureFigIdx];\n        if (_lureEntry) {\n          const [_lureCur\x2C _lureMax] = _lureEntry;\n          _lureHs[_lureFigIdx] = [Math.max(0\x2C _lureCur - fo.postAttackStrain)\x2C _lureMax];\n          ctx.dcHealthState.set(_lureMsgId\x2C _lureHs);\n        }\n      }\n      await interaction.followUp({ content: `**Lure of the Dark Side** \u2014 Skipped attack. **${controlledName}** suffers ${fo.postAttackStrain} Strain.`\x2C ephemeral: false }).catch(discordCatch);\n    } else {\n      await interaction.followUp({ content: `Skipped.`\x2C ephemeral: false }).catch(discordCatch);\n    }\n    delete game.pendingFalseOrders;\n    saveGames();\n    return;\n  }\n\n  if (choice === 'move') {\n    if (!controlledPos) {\n      await interaction.followUp({ content: `${controlledName} has no position \u2014 resolve manually.`\x2C ephemeral: false }).catch(discordCatch);\n      return;\n    }\n    const boardState = getBoardStateForMovement(game\x2C controlledFigureKey);\n    if (!boardState) {\n      await interaction.followUp({ content: 'Map spaces not found.'\x2C ephemeral: true }).catch(discordCatch);\n      return;\n    }\n    const moveSpeed = controlledStats?.move ?? 3;\n    const profile = getMovementProfile(controlledName\x2C controlledFigureKey\x2C game);\n    const cache = computeMovementCache(controlledPos\x2C moveSpeed\x2C boardState\x2C profile);\n    const reachableSpaces = [...cache.cells.keys()];\n    if (reachableSpaces.length === 0) {\n      await interaction.followUp({ content: `${controlledName} cannot move (no valid spaces).`\x2C ephemeral: false }).catch(discordCatch);\n      return;\n    }\n    const foMapSpaces = boardState?.mapSpaces || {};\n    const foContextKey = `${gameId}_${msgId}`;\n    const foHeader = `**False Orders** \u2014 Choose a space for **${controlledName}** to move to`;\n    game.pendingSpacePick = game.pendingSpacePick || {};\n    game.pendingSpacePick[foContextKey] = {\n      validSpaces: reachableSpaces\x2C\n      cellPrefix: `false_orders_space_${gameId}_${msgId}_`\x2C\n      mapSpaces: foMapSpaces\x2C\n      headerText: foHeader\x2C\n    };\n    const { rows: foRowBtns } = buildRowPickerButtons(reachableSpaces\x2C `space_row_${foContextKey}_`);\n    const mapAttachment = getMapAttachmentForSpaces ? await getMapAttachmentForSpaces(game\x2C reachableSpaces) : null;\n    const payload = {\n      content: `${foHeader}:\\nChoose a row:`\x2C\n      components: foRowBtns.slice(0\x2C 5)\x2C\n      ephemeral: false\x2C\n    };\n    if (mapAttachment) payload.files = [mapAttachment];\n    await interaction.followUp(payload).catch(discordCatch);\n    saveGames();\n    return;\n  }\n\n  // Attack case\n  if (!controlledPos) {\n    await interaction.followUp({ content: `${controlledName} has no position \u2014 resolve manually.`\x2C ephemeral: false }).catch(discordCatch);\n    return;\n  }\n  const controlledAttackInfo = controlledStats?.attack || { dice: ['red']\x2C type: 'range' };\n  const [foMinRange\x2C foMaxRange] = defaultAttackRange(controlledAttackInfo);\n  const controlledEff = getDcEffects()[controlledName] || getDcEffects()[controlledName?.replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n  const controlledKws = (controlledEff?.keywords || []).map((k) => String(k).toUpperCase());\n  const foHasReach = controlledKws.includes('REACH') || (controlledEff?.passives || []).some((p) => String(p).toUpperCase() === 'REACH') || _hasFuryReach(game\x2C controlledPlayerNum\x2C controlledKws);\n  let foEffectiveMaxRange = foHasReach && foMaxRange < 2 ? 2 : foMaxRange;\n  // Lure of the Dark Side: cap range at 4 (or whatever maxRange is set)\n  if (fo.isLure && fo.maxRange) foEffectiveMaxRange = Math.min(foEffectiveMaxRange\x2C fo.maxRange);\n  const ms = getEffectiveMapSpaces(game\x2C getMapData(game.selectedMap?.id));\n  if (!ms) {\n    await interaction.followUp({ content: 'Map spaces not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Compute closed-door edges for graph-distance counting AND LOS\n  const foMapId = game.selectedMap?.id;\n  const foAllDoors = (getMapTokensData && foMapId) ? (getMapTokensData()[foMapId]?.doors || []) : [];\n  const foOpenedSet = new Set((game.openedDoors || []).map(k => String(k).toLowerCase()));\n  const foClosedEdges = foAllDoors.filter(e => {\n    const a = String(e[0]).toLowerCase()\x2C b = String(e[1]).toLowerCase();\n    return !foOpenedSet.has(`${a}|${b}`) && !foOpenedSet.has(`${b}|${a}`);\n  });\n  const foClosedDoorEdges = new Set(foClosedEdges.map(e => edgeKey(e[0]\x2C e[1])));\n  // Build LOS-aware mapSpaces: merge closed doors + energy shields + smoke\n  let losMs = ms;\n  {\n    const shieldSpaces = (game.ancillaryTokens?.energyShield || []).map(s => String(s).toLowerCase());\n    const smokeSpaces = (game.ancillaryTokens?.smoke || []).map(s => String(s).toLowerCase());\n    const extraBlocking = [...shieldSpaces\x2C ...smokeSpaces];\n    const mergedImpassable = foClosedEdges.length > 0\n      ? [...(ms?.impassableEdges || [])\x2C ...foClosedEdges]\n      : ms?.impassableEdges;\n    if (foClosedEdges.length > 0 || extraBlocking.length > 0) {\n      losMs = {\n        ...ms\x2C\n        impassableEdges: mergedImpassable || []\x2C\n        blocking: extraBlocking.length > 0 ? [...(ms?.blocking || [])\x2C ...extraBlocking] : ms?.blocking\x2C\n      };\n    }\n  }\n  // Collect all other figures as potential targets\n  const allOtherPositions = {};\n  for (const [figKey\x2C pos] of Object.entries(game.figurePositions?.[1] || {})) {\n    if (figKey !== controlledFigureKey) allOtherPositions[figKey] = pos;\n  }\n  for (const [figKey\x2C pos] of Object.entries(game.figurePositions?.[2] || {})) {\n    if (figKey !== controlledFigureKey) allOtherPositions[figKey] = pos;\n  }\n  // Build figure-blocking coords for the controlled attacker (LOS-19b fix)\n  const controlledSize = game.figureOrientations?.[controlledFigureKey] || getFigureSize(controlledName);\n  const foBlockingCoords = buildFigureBlockingCoords(game\x2C controlledPlayerNum\x2C controlledPos\x2C controlledSize\x2C ctx);\n  const foTargets = [];\n  for (const [figKey\x2C targetPos] of Object.entries(allOtherPositions)) {\n    const dist = countSpaces(ms\x2C controlledPos\x2C targetPos\x2C foClosedDoorEdges);\n    if (dist < foMinRange || dist > foEffectiveMaxRange) continue;\n    // Refine blocking set per target: remove target's own footprint\x2C skip blocking for MASSIVE targets\n    let losBlockingCoords = foBlockingCoords;\n    if (foBlockingCoords) {\n      const tDcName = dcNameFromFigureKey(figKey);\n      const tEff = getDcEffects()[tDcName] || getDcEffects()[tDcName.replace(/\\s*\\[.*\\]\\s*$/\x2C '')];\n      if ((tEff?.keywords || []).some(kw => String(kw).toUpperCase() === 'MASSIVE')) {\n        losBlockingCoords = null;\n      } else {\n        const tSize = game.figureOrientations?.[figKey] || getFigureSize(tDcName);\n        const tFp = getFootprintCells(targetPos\x2C tSize).map(c => String(c).toLowerCase());\n        if (tFp.some(c => foBlockingCoords.has(c))) {\n          losBlockingCoords = new Set([...foBlockingCoords].filter(c => !tFp.includes(c)));\n        }\n      }\n    }\n    const los = hasLineOfSight ? hasLineOfSight(controlledPos\x2C targetPos\x2C losMs\x2C losBlockingCoords) : true;\n    const fkMatch = figKey.match(/^(.+)-(\\d+)-(\\d+)$/);\n    const targetDcName = fkMatch ? dcNameFromFigureKey(figKey) : figKey;\n    const dg = fkMatch ? fkMatch[2] : '1';\n    const fi = fkMatch ? parseInt(fkMatch[3]\x2C 10) : 0;\n    const figCount = getDcStats(targetDcName)?.figures ?? 1;\n    const label = figCount > 1 ? `${targetDcName} ${dg}${FIGURE_LETTERS?.[fi] || 'a'}` : targetDcName;\n    foTargets.push({ figureKey: figKey\x2C label\x2C coord: targetPos\x2C dist\x2C hasLOS: los });\n  }\n  if (foTargets.length === 0) {\n    await interaction.followUp({ content: `No valid targets for **${controlledName}** in range.`\x2C ephemeral: false }).catch(discordCatch);\n    return;\n  }\n  game.falseOrdersAttackTargets = game.falseOrdersAttackTargets || {};\n  game.falseOrdersAttackTargets[msgId] = foTargets;\n  const targetBtns = foTargets.map((t\x2C targetIndex) => {\n    const noLOS = t.hasLOS === false;\n    return new ButtonBuilder()\n      .setCustomId(`false_orders_atk_${gameId}_${msgId}_${targetIndex}`)\n      .setLabel(`${t.label} (${String(t.coord).toUpperCase()})${noLOS ? ' [No LOS]' : ''}`.slice(0\x2C 80))\n      .setStyle(noLOS ? ButtonStyle.Secondary : ButtonStyle.Danger)\n      .setDisabled(noLOS);\n  });\n  const targetRows = chunkButtonsToRows(targetBtns);\n  await interaction.followUp({\n    content: `**False Orders** \u2014 Choose attack target for **${controlledName}**:`\x2C\n    components: targetRows\x2C\n    ephemeral: false\x2C\n  }).catch(discordCatch);\n  saveGames();\n}\n\n/**\n * Handle false_orders_space_ button: complete the False Orders Move when a space is chosen.\n * customId: false_orders_space_{gameId}_{msgId}_{space}\n */\nexport async function handleFalseOrdersMovePick(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^false_orders_space_([^_]+)_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C msgId\x2C space] = m;\n  const chosenSpace = String(space).toLowerCase();\n  const { getGame\x2C replyIfGameEnded\x2C logGameAction\x2C buildBoardMapPayload\x2C saveGames\x2C client } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  cleanupSpacePick(game\x2C `${gameId}_${msgId}`);\n  if (await replyIfGameEnded(game\x2C interaction)) return;\n  const fo = game.pendingFalseOrders;\n  if (!fo || fo.murneRinMsgId !== msgId) {\n    await interaction.followUp({ content: 'No pending False Orders move.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { controlledFigureKey\x2C controlledPlayerNum\x2C controllerPlayerNum } = fo;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C controllerPlayerNum\x2C canActAsPlayer\x2C 'Only the controller may choose.')) return;\n  const controlledName = dcNameFromFigureKey(controlledFigureKey);\n  game.figurePositions = game.figurePositions || {};\n  game.figurePositions[controlledPlayerNum] = game.figurePositions[controlledPlayerNum] || {};\n  game.figurePositions[controlledPlayerNum][controlledFigureKey] = chosenSpace;\n  game.figureMoved = game.figureMoved || {};\n  game.figureMoved[controlledFigureKey] = true;\n  delete game.pendingFalseOrders;\n  if (logGameAction) await logGameAction(game\x2C client\x2C `\ud83c\udfaf **False Orders** \u2014 P${controllerPlayerNum} moved **${controlledName}** to **${chosenSpace.toUpperCase()}**.`\x2C { phase: 'ROUND'\x2C icon: 'move' }).catch(discordCatch);\n  const doneRow = new ActionRowBuilder().addComponents(\n    new ButtonBuilder()\n      .setCustomId(`special_done_${gameId}_${msgId}`)\n      .setLabel('Done')\n      .setStyle(ButtonStyle.Success)\n  );\n  let boardPayload = null;\n  if (buildBoardMapPayload) boardPayload = await buildBoardMapPayload(game).catch(() => null);\n  const replyPayload = {\n    content: `**False Orders** \u2014 **${controlledName}** moved to **${chosenSpace.toUpperCase()}**. Click Done when finished.`\x2C\n    components: [doneRow]\x2C\n    ephemeral: false\x2C\n  };\n  if (boardPayload?.files) replyPayload.files = boardPayload.files;\n  await interaction.followUp(replyPayload).catch(discordCatch);\n  saveGames();\n}\n\n/**\n * Handle order_move_ button: player chose to move the ordered figure.\n * Computes reachable spaces and presents the space picker.\n * customId: order_move_{gameId}_{officerMsgId}\n */\nexport async function handleOrderMove(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^order_move_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C officerMsgId] = m;\n  const {\n    getGame\x2C replyIfGameEnded\x2C getDcStats\x2C\n    getBoardStateForMovement\x2C getMovementProfile\x2C computeMovementCache\x2C\n    getMapAttachmentForSpaces\x2C saveGames\x2C client\x2C FIGURE_LETTERS\x2C\n  } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (await replyIfGameEnded(game\x2C interaction)) return;\n  const pending = game.pendingOrderedMove;\n  if (!pending) {\n    await interaction.followUp({ content: 'No pending ordered move.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pending.playerNum\x2C canActAsPlayer\x2C 'Only the ordering player may choose.')) return;\n\n  const { figureKey\x2C mp\x2C label } = pending;\n  const pos = game.figurePositions?.[pending.playerNum]?.[figureKey];\n  if (!pos) {\n    const dcName = dcNameFromFigureKey(figureKey);\n    await interaction.followUp({ content: `**${dcName}** has no position on the board.`\x2C ephemeral: false }).catch(discordCatch);\n    delete game.pendingOrderedMove;\n    saveGames();\n    return;\n  }\n\n  const dcName = dcNameFromFigureKey(figureKey);\n  const boardState = getBoardStateForMovement(game\x2C figureKey);\n  if (!boardState) {\n    await interaction.followUp({ content: 'Map spaces not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const profile = getMovementProfile(dcName\x2C figureKey\x2C game);\n  const cache = computeMovementCache(pos\x2C mp\x2C boardState\x2C profile);\n  const reachableSpaces = [...cache.cells.keys()];\n  if (reachableSpaces.length === 0) {\n    await interaction.followUp({ content: `**${dcName}** cannot move (no valid spaces within ${mp} MP).`\x2C ephemeral: false }).catch(discordCatch);\n    delete game.pendingOrderedMove;\n    saveGames();\n    return;\n  }\n\n  const contextKey = `${gameId}_${officerMsgId}`;\n  const headerText = `**${label}** \u2014 Choose a space for **${dcName}** to move to`;\n  game.pendingSpacePick = game.pendingSpacePick || {};\n  game.pendingSpacePick[contextKey] = {\n    validSpaces: reachableSpaces\x2C\n    cellPrefix: `order_move_space_${gameId}_${officerMsgId}_`\x2C\n    mapSpaces: boardState.mapSpaces || {}\x2C\n    headerText\x2C\n  };\n  const { rows } = buildRowPickerButtons(reachableSpaces\x2C `space_row_${contextKey}_`);\n  const mapAttachment = getMapAttachmentForSpaces ? await getMapAttachmentForSpaces(game\x2C reachableSpaces) : null;\n  const payload = {\n    content: `${headerText}:\\nChoose a row:`\x2C\n    components: rows.slice(0\x2C 5)\x2C\n    ephemeral: false\x2C\n  };\n  if (mapAttachment) payload.files = [mapAttachment];\n  await interaction.followUp(payload).catch(discordCatch);\n  saveGames();\n}\n\n/**\n * Handle order_move_space_ button: complete the ordered figure move when a space is chosen.\n * customId: order_move_space_{gameId}_{officerMsgId}_{space}\n */\nexport async function handleOrderMoveSpacePick(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^order_move_space_([^_]+)_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C officerMsgId\x2C space] = m;\n  const chosenSpace = String(space).toLowerCase();\n  const { getGame\x2C replyIfGameEnded\x2C logGameAction\x2C buildBoardMapPayload\x2C saveGames\x2C client } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  cleanupSpacePick(game\x2C `${gameId}_${officerMsgId}`);\n  if (await replyIfGameEnded(game\x2C interaction)) return;\n  const pending = game.pendingOrderedMove;\n  if (!pending) {\n    await interaction.followUp({ content: 'No pending ordered move.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pending.playerNum\x2C canActAsPlayer\x2C 'Only the ordering player may choose.')) return;\n\n  const { figureKey\x2C targetMsgId\x2C label } = pending;\n  const dcName = dcNameFromFigureKey(figureKey);\n  game.figurePositions = game.figurePositions || {};\n  game.figurePositions[pending.playerNum] = game.figurePositions[pending.playerNum] || {};\n  game.figurePositions[pending.playerNum][figureKey] = chosenSpace;\n  game.figureMoved = game.figureMoved || {};\n  game.figureMoved[figureKey] = true;\n\n  // Clear the movement bank since all ordered MP are spent\n  if (targetMsgId && game.movementBank?.[targetMsgId]) {\n    game.movementBank[targetMsgId].remaining = 0;\n  }\n  delete game.pendingOrderedMove;\n\n  if (logGameAction) await logGameAction(game\x2C client\x2C `\ud83c\udfaf **${label}** \u2014 **${dcName}** moved to **${chosenSpace.toUpperCase()}**.`\x2C { phase: 'ROUND'\x2C icon: 'move' }).catch(discordCatch);\n\n  const doneRow = new ActionRowBuilder().addComponents(\n    new ButtonBuilder()\n      .setCustomId(`special_done_${gameId}_${officerMsgId}`)\n      .setLabel('Done')\n      .setStyle(ButtonStyle.Success)\n  );\n  let boardPayload = null;\n  if (buildBoardMapPayload) boardPayload = await buildBoardMapPayload(game).catch(() => null);\n  const replyPayload = {\n    content: `**${label}** \u2014 **${dcName}** moved to **${chosenSpace.toUpperCase()}**. Click Done when finished.`\x2C\n    components: [doneRow]\x2C\n    ephemeral: false\x2C\n  };\n  if (boardPayload?.files) replyPayload.files = boardPayload.files;\n  await interaction.followUp(replyPayload).catch(discordCatch);\n  saveGames();\n}\n\n/**\n * Apply N damage to a figure via dcHealthState\x2C syncing dcList. Returns { newHp\x2C wasDefeated }.\n */\nfunction _applyHpDamage(game\x2C dcHealthState\x2C dcMessageMeta\x2C figureKey\x2C damage) {\n  const fkMatch = figureKey.match(/^(.+)-(\\d+)-(\\d+)$/);\n  if (!fkMatch) return { newHp: null\x2C wasDefeated: false };\n  const [\x2C dcName\x2C dgIndex\x2C figIndexStr] = fkMatch;\n  const figIndex = parseInt(figIndexStr\x2C 10);\n  // Find msgId for this figure's DC\n  let targetMsgId = null;\n  for (const [mId\x2C mMeta] of dcMessageMeta) {\n    if (mMeta.gameId !== game.gameId) continue;\n    if (mMeta.dcName !== dcName) continue;\n    const dgMatch = (mMeta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/);\n    const dgIdx = dgMatch ? dgMatch[1] : '1';\n    if (String(dgIdx) === String(dgIndex)) { targetMsgId = mId; break; }\n  }\n  if (!targetMsgId) return { newHp: null\x2C wasDefeated: false };\n  const meta = dcMessageMeta.get(targetMsgId);\n  const playerNum = meta?.playerNum ?? 1;\n  const { newHp\x2C prevHp\x2C wasDefeated } = reduceHp(dcHealthState\x2C game\x2C targetMsgId\x2C figIndex\x2C damage\x2C playerNum);\n  if (prevHp === 0 && newHp === 0) return { newHp: prevHp\x2C wasDefeated: false }; // already dead or no entry\n  return { newHp\x2C wasDefeated\x2C targetMsgId };\n}\n\n/**\n * Handle rush_push_fig_ button: player picks which adjacent SMALL hostile to push.\n */\nexport async function handleRushPushFig(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^rush_push_fig_([^_]+)_([^_]+)_(\\d+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C msgId\x2C choiceIdxStr] = m;\n  const choiceIndex = parseInt(choiceIdxStr\x2C 10);\n  const { getGame\x2C dcMessageMeta\x2C dcHealthState\x2C getMapData\x2C logGameAction\x2C buildBoardMapPayload\x2C\n    updateDcActionsMessage\x2C getMapAttachmentForSpaces\x2C saveGames\x2C client\x2C processFigureDefeat } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const pending = game.pendingRushPush;\n  if (!pending || pending.msgId !== msgId) {\n    await interaction.followUp({ content: 'No pending Rush push.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pending.playerNum\x2C canActAsPlayer\x2C 'Only the activating player can choose.')) return;\n  const targetFk = pending.targets?.[choiceIndex];\n  if (!targetFk) { await interaction.followUp({ content: 'Invalid target.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  pending.chosenTarget = targetFk;\n  const oppNum = opponentPlayerNum(pending.playerNum);\n  const targetPos = game.figurePositions?.[oppNum]?.[targetFk];\n  if (!targetPos) {\n    delete game.pendingRushPush;\n    await interaction.message.edit({ content: '**Rush** \u2014 Target no longer on board.'\x2C components: [] }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n  // Find valid landing spaces: target's current space + adjacent unoccupied\n  const mapId = game.selectedMap?.id;\n  const mapSpaces = mapId ? getMapData(mapId) : null;\n  const adjToTarget = mapSpaces?.adjacency?.[targetPos] || [];\n  const occupied = new Set([\n    ...Object.values(game.figurePositions?.[1] || {})\x2C\n    ...Object.values(game.figurePositions?.[2] || {})\x2C\n  ].filter(Boolean));\n  occupied.delete(targetPos); // target can stay in its own space\n  const validSpaces = [targetPos\x2C ...adjToTarget.filter(s => !occupied.has(s))];\n  if (validSpaces.length === 1) {\n    // Only current space \u2014 auto-resolve (damage only\x2C no actual push)\n    const targetName = dcNameFromFigureKey(targetFk);\n    const t = _applyHpDamage(game\x2C dcHealthState\x2C dcMessageMeta\x2C targetFk\x2C 1);\n    const a = _applyHpDamage(game\x2C dcHealthState\x2C dcMessageMeta\x2C pending.activatorFigureKey\x2C 1);\n    const tNote = t.wasDefeated ? ' **(defeated)**' : '';\n    const aNote = a.wasDefeated ? ' **(defeated)**' : '';\n    const logMsg = `**Rush** \u2014 Both suffer 1 Damage: **${targetName}**${tNote}\x2C **Onar**${aNote}. No push (no open space).`;\n    if (logGameAction) await logGameAction(game\x2C client\x2C logMsg\x2C { phase: 'ROUND'\x2C icon: 'attack' }).catch(discordCatch);\n    if (t.wasDefeated && processFigureDefeat) {\n      await processFigureDefeat(game\x2C { defeatedPlayerNum: oppNum\x2C figureKey: targetFk\x2C attackerPlayerNum: pending.playerNum\x2C source: 'Rush' });\n    }\n    if (a.wasDefeated && processFigureDefeat) {\n      await processFigureDefeat(game\x2C { defeatedPlayerNum: pending.playerNum\x2C figureKey: pending.activatorFigureKey\x2C attackerPlayerNum: oppNum\x2C source: 'Rush' });\n    }\n    await updateDcActionsMessage(game\x2C msgId\x2C client).catch(discordCatch);\n    delete game.pendingRushPush;\n    await interaction.message.edit({ content: logMsg\x2C components: [] }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n  // Show 2-step row\u2192cell space picker via generic space_row_ handler\n  pending.chosenTarget = targetFk;\n  const boardState = ctx.getBoardStateForMovement ? ctx.getBoardStateForMovement(game\x2C null) : null;\n  const bMapSpaces = boardState?.mapSpaces || {};\n  const contextKey = `${gameId}_${msgId}`;\n  const headerText = `**Rush** \u2014 Pick landing space for **${dcNameFromFigureKey(targetFk)}** (or stay at **${targetPos.toUpperCase()}**)`;\n  game.pendingSpacePick = game.pendingSpacePick || {};\n  game.pendingSpacePick[contextKey] = {\n    validSpaces\x2C\n    cellPrefix: `rush_push_space_${gameId}_${msgId}_`\x2C\n    mapSpaces: bMapSpaces\x2C\n    headerText\x2C\n  };\n  const { rows: rowBtns } = buildRowPickerButtons(validSpaces\x2C `space_row_${contextKey}_`);\n  const mapAttachment = await getMapAttachmentForSpaces(game\x2C validSpaces);\n  const payload = {\n    content: `${headerText}:\\nChoose a row:`\x2C\n    components: rowBtns.slice(0\x2C 5)\x2C\n  };\n  if (mapAttachment) payload.files = [mapAttachment];\n  await interaction.message.edit({ content: '**Rush** \u2014 Choosing push destination...'\x2C components: [] }).catch(discordCatch);\n  await interaction.followUp(payload).catch(discordCatch);\n  saveGames();\n}\n\n/**\n * Handle rush_push_space_ button: finalize Rush push + apply mutual 1 Damage.\n */\nexport async function handleRushPushSpace(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^rush_push_space_([^_]+)_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C msgId\x2C space] = m;\n  const chosenSpace = String(space).toLowerCase();\n  const { getGame\x2C dcMessageMeta\x2C dcHealthState\x2C logGameAction\x2C buildBoardMapPayload\x2C\n    updateDcActionsMessage\x2C saveGames\x2C client\x2C processFigureDefeat } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  cleanupSpacePick(game\x2C `${gameId}_${msgId}`);\n  const pending = game.pendingRushPush;\n  if (!pending || pending.msgId !== msgId) {\n    await interaction.followUp({ content: 'No pending Rush push.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pending.playerNum\x2C canActAsPlayer\x2C 'Only the activating player can choose.')) return;\n  const targetFk = pending.chosenTarget;\n  const oppNum = opponentPlayerNum(pending.playerNum);\n  const { prevPos } = pushFigure(game\x2C oppNum\x2C targetFk\x2C chosenSpace) || { prevPos: null };\n  const targetName = dcNameFromFigureKey(targetFk);\n  const pushed = chosenSpace !== (prevPos ? String(prevPos).toLowerCase() : null);\n  // Apply 1 damage to both\n  const t = _applyHpDamage(game\x2C dcHealthState\x2C dcMessageMeta\x2C targetFk\x2C 1);\n  const a = _applyHpDamage(game\x2C dcHealthState\x2C dcMessageMeta\x2C pending.activatorFigureKey\x2C 1);\n  const tNote = t.wasDefeated ? ' **(defeated)**' : '';\n  const aNote = a.wasDefeated ? ' **(defeated)**' : '';\n  const pushNote = pushed ? ` Pushed **${targetName}** from ${prevPos?.toUpperCase() ?? '?'} \u2192 ${chosenSpace.toUpperCase()}.` : '';\n  const logMsg = `**Rush** \u2014${pushNote} Both suffer 1 Damage: **${targetName}**${tNote}\x2C **Onar**${aNote}.`;\n  if (logGameAction) await logGameAction(game\x2C client\x2C logMsg\x2C { phase: 'ROUND'\x2C icon: 'attack' }).catch(discordCatch);\n  if (t.wasDefeated && processFigureDefeat) {\n    await processFigureDefeat(game\x2C { defeatedPlayerNum: oppNum\x2C figureKey: targetFk\x2C attackerPlayerNum: pending.playerNum\x2C source: 'Rush' });\n  }\n  if (a.wasDefeated && processFigureDefeat) {\n    await processFigureDefeat(game\x2C { defeatedPlayerNum: pending.playerNum\x2C figureKey: pending.activatorFigureKey\x2C attackerPlayerNum: oppNum\x2C source: 'Rush' });\n  }\n  // Refresh board\n  if (game.boardId && game.selectedMap && buildBoardMapPayload) {\n    try {\n      const boardChannel = await fetchGameChannel(client\x2C game.boardId);\n      if (boardChannel) {\n        const boardPayload = await buildBoardMapPayload(game.gameId\x2C game.selectedMap\x2C game);\n        await boardChannel.send(boardPayload);\n      }\n    } catch { /* ignore */ }\n  }\n  await updateDcActionsMessage(game\x2C msgId\x2C client).catch(discordCatch);\n  delete game.pendingRushPush;\n  await interaction.message.edit({ content: logMsg\x2C components: [] }).catch(discordCatch);\n  saveGames();\n}\n\n/**\n * Handle rush_push_skip_ button: skip Rush push.\n */\nexport async function handleRushPushSkip(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^rush_push_skip_([^_]+)_([^_]+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C msgId] = m;\n  const { getGame\x2C saveGames } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  cleanupSpacePick(game\x2C `${gameId}_${msgId}`);\n  delete game.pendingRushPush;\n  await interaction.message.edit({ content: '**Rush** \u2014 Push skipped.'\x2C components: [] }).catch(discordCatch);\n  saveGames();\n}\n\n/**\n * Handle shoulder_rush_fig_ button: player picks which adjacent hostile to target.\n */\nexport async function handleShoulderRushFig(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^shoulder_rush_fig_([^_]+)_([^_]+)_(\\d+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C msgId\x2C choiceIdxStr] = m;\n  const choiceIndex = parseInt(choiceIdxStr\x2C 10);\n  const { getGame\x2C dcMessageMeta\x2C dcHealthState\x2C getMapData\x2C logGameAction\x2C buildBoardMapPayload\x2C\n    updateDcActionsMessage\x2C getMapAttachmentForSpaces\x2C saveGames\x2C client } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const pending = game.pendingShoulderRush;\n  if (!pending || pending.msgId !== msgId) {\n    await interaction.followUp({ content: 'No pending Shoulder Rush.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pending.playerNum\x2C canActAsPlayer\x2C 'Only the activating player can choose.')) return;\n  const targetFk = pending.targets?.[choiceIndex];\n  if (!targetFk) { await interaction.followUp({ content: 'Invalid target.'\x2C ephemeral: true }).catch(discordCatch); return; }\n  const oppNum = opponentPlayerNum(pending.playerNum);\n  const targetPos = game.figurePositions?.[oppNum]?.[targetFk];\n  const targetName = dcNameFromFigureKey(targetFk);\n  if (!targetPos) {\n    delete game.pendingShoulderRush;\n    await interaction.message.edit({ content: '**Shoulder Rush** \u2014 Target no longer on board.'\x2C components: [] }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n  // Check if target is SMALL\n  const effects = getDcEffects();\n  const targetDcName = dcNameFromFigureKey(targetFk);\n  const targetEff = effects?.[targetDcName];\n  const targetKw = (targetEff?.keywords || []).map(k => String(k).toUpperCase());\n  const isSmall = !targetKw.includes('LARGE') && !targetKw.includes('MASSIVE');\n  if (!isSmall) {\n    // Not SMALL: grant free attack targeting this figure\x2C no push\n    game.freeAttackBonusPending = game.freeAttackBonusPending || {};\n    game.freeAttackBonusPending[msgId] = true;\n    game.forcedAttackTarget = game.forcedAttackTarget || {};\n    game.forcedAttackTarget[msgId] = targetFk;\n    const logMsg = `**Shoulder Rush** \u2014 Targeting **${targetName}** (not SMALL\x2C no push). Attack that figure (free action).`;\n    if (logGameAction) await logGameAction(game\x2C client\x2C logMsg\x2C { phase: 'ROUND'\x2C icon: 'attack' }).catch(discordCatch);\n    await updateDcActionsMessage(game\x2C msgId\x2C client).catch(discordCatch);\n    delete game.pendingShoulderRush;\n    await interaction.message.edit({ content: logMsg\x2C components: [] }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n  // Target is SMALL: show push space picker (adjacent to target\x2C unoccupied)\n  pending.chosenTarget = targetFk;\n  const mapId = game.selectedMap?.id;\n  const mapSpaces = mapId ? getMapData(mapId) : null;\n  const adjToTarget = mapSpaces?.adjacency?.[targetPos] || [];\n  const occupied = new Set([\n    ...Object.values(game.figurePositions?.[1] || {})\x2C\n    ...Object.values(game.figurePositions?.[2] || {})\x2C\n  ].filter(Boolean));\n  occupied.delete(targetPos); // target vacates its own space\n  // Valid spaces: adjacent to target\x2C unoccupied (not including current space \u2014 must push away)\n  const validSpaces = adjToTarget.filter(s => !occupied.has(s));\n  if (validSpaces.length === 0) {\n    // No room to push \u2014 grant free attack without push\n    game.freeAttackBonusPending = game.freeAttackBonusPending || {};\n    game.freeAttackBonusPending[msgId] = true;\n    game.forcedAttackTarget = game.forcedAttackTarget || {};\n    game.forcedAttackTarget[msgId] = targetFk;\n    const logMsg = `**Shoulder Rush** \u2014 **${targetName}** is SMALL but no room to push. Attack that figure (free action).`;\n    if (logGameAction) await logGameAction(game\x2C client\x2C logMsg\x2C { phase: 'ROUND'\x2C icon: 'attack' }).catch(discordCatch);\n    await updateDcActionsMessage(game\x2C msgId\x2C client).catch(discordCatch);\n    delete game.pendingShoulderRush;\n    await interaction.message.edit({ content: logMsg\x2C components: [] }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n  // Show 2-step row\u2192cell space picker via generic space_row_ handler\n  const boardState = ctx.getBoardStateForMovement ? ctx.getBoardStateForMovement(game\x2C null) : null;\n  const bMapSpaces = boardState?.mapSpaces || {};\n  const srContextKey = `${gameId}_${msgId}`;\n  const srHeader = `**Shoulder Rush** \u2014 **${targetName}** is SMALL. Push to which space? (You will enter the vacated space.)`;\n  game.pendingSpacePick = game.pendingSpacePick || {};\n  game.pendingSpacePick[srContextKey] = {\n    validSpaces\x2C\n    cellPrefix: `shoulder_rush_space_${gameId}_${msgId}_`\x2C\n    mapSpaces: bMapSpaces\x2C\n    headerText: srHeader\x2C\n  };\n  const { rows: srRowBtns } = buildRowPickerButtons(validSpaces\x2C `space_row_${srContextKey}_`);\n  const mapAttachment = await getMapAttachmentForSpaces(game\x2C validSpaces);\n  const payload = {\n    content: `${srHeader}\\nChoose a row:`\x2C\n    components: srRowBtns.slice(0\x2C 5)\x2C\n  };\n  if (mapAttachment) payload.files = [mapAttachment];\n  await interaction.message.edit({ content: '**Shoulder Rush** \u2014 Choosing push destination...'\x2C components: [] }).catch(discordCatch);\n  await interaction.followUp(payload).catch(discordCatch);\n  saveGames();\n}\n\n/**\n * Handle shoulder_rush_space_ button: finalize push + enter vacated space + grant free attack.\n */\nexport async function handleShoulderRushSpace(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^shoulder_rush_space_([^_]+)_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C msgId\x2C space] = m;\n  const chosenSpace = String(space).toLowerCase();\n  const { getGame\x2C dcMessageMeta\x2C logGameAction\x2C buildBoardMapPayload\x2C\n    updateDcActionsMessage\x2C saveGames\x2C client } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  cleanupSpacePick(game\x2C `${gameId}_${msgId}`);\n  const pending = game.pendingShoulderRush;\n  if (!pending || pending.msgId !== msgId) {\n    await interaction.followUp({ content: 'No pending Shoulder Rush.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C pending.playerNum\x2C canActAsPlayer\x2C 'Only the activating player can choose.')) return;\n  const targetFk = pending.chosenTarget;\n  const oppNum = opponentPlayerNum(pending.playerNum);\n  const { prevPos } = pushFigure(game\x2C oppNum\x2C targetFk\x2C chosenSpace) || { prevPos: null };\n  const targetName = dcNameFromFigureKey(targetFk);\n  // Move activator into the vacated space\n  if (pending.activatorFigureKey && pending.activatorPos && prevPos) {\n    pushFigure(game\x2C pending.playerNum\x2C pending.activatorFigureKey\x2C prevPos);\n  }\n  // Grant free attack targeting the pushed figure\n  game.freeAttackBonusPending = game.freeAttackBonusPending || {};\n  game.freeAttackBonusPending[msgId] = true;\n  game.forcedAttackTarget = game.forcedAttackTarget || {};\n  game.forcedAttackTarget[msgId] = targetFk;\n  const logMsg = `**Shoulder Rush** \u2014 Pushed **${targetName}** from ${prevPos?.toUpperCase() ?? '?'} \u2192 ${chosenSpace.toUpperCase()}. Entered vacated space. Attack that figure (free action).`;\n  if (logGameAction) await logGameAction(game\x2C client\x2C logMsg\x2C { phase: 'ROUND'\x2C icon: 'attack' }).catch(discordCatch);\n  // Refresh board\n  if (game.boardId && game.selectedMap && buildBoardMapPayload) {\n    try {\n      const boardChannel = await fetchGameChannel(client\x2C game.boardId);\n      if (boardChannel) {\n        const boardPayload = await buildBoardMapPayload(game.gameId\x2C game.selectedMap\x2C game);\n        await boardChannel.send(boardPayload);\n      }\n    } catch { /* ignore */ }\n  }\n  await updateDcActionsMessage(game\x2C msgId\x2C client).catch(discordCatch);\n  delete game.pendingShoulderRush;\n  await interaction.message.edit({ content: logMsg\x2C components: [] }).catch(discordCatch);\n  saveGames();\n}\n\n/**\n * Handle shoulder_rush_skip_ button: skip Shoulder Rush target selection.\n */\nexport async function handleShoulderRushSkip(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^shoulder_rush_skip_([^_]+)_([^_]+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C msgId] = m;\n  const { getGame\x2C saveGames } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  cleanupSpacePick(game\x2C `${gameId}_${msgId}`);\n  delete game.pendingShoulderRush;\n  await interaction.message.edit({ content: '**Shoulder Rush** \u2014 No target chosen.'\x2C components: [] }).catch(discordCatch);\n  saveGames();\n}\n\n/** Handle Overwatch token space placement. */\nexport async function handleOverwatchSpacePick(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^overwatch_space_([^_]+)_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C msgId\x2C space] = m;\n  const { getGame\x2C saveGames\x2C logGameAction\x2C dcMessageMeta } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  cleanupSpacePick(game\x2C `${gameId}_${msgId}`);\n  const chosenSpace = String(space).toLowerCase();\n  game.overwatchTokenPosition = game.overwatchTokenPosition || {};\n  game.overwatchTokenPosition[msgId] = chosenSpace;\n  delete game.pendingOverwatchPlacement?.[msgId];\n  const meta = dcMessageMeta?.get(msgId);\n  const displayName = meta?.displayName || meta?.dcName || 'E-Web Engineer';\n  await interaction.message.edit({ content: `**Overwatch** \u2014 Token placed at **${chosenSpace.toUpperCase()}**. When a hostile figure enters a space on or adjacent to this token\x2C you may interrupt to attack.`\x2C components: [] }).catch(discordCatch);\n  if (logGameAction) await logGameAction(game\x2C interaction.client\x2C `**Overwatch** \u2014 **${displayName}** placed token at **${chosenSpace.toUpperCase()}**.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  saveGames();\n}\n\n/** Handle Orbital Bombardment deplete \u2014 start space selection for damage. */\nexport async function handleOrbitalBombardmentDeplete(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^ob_deplete_([^_]+)_([^_]+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C msgId] = m;\n  const { getGame\x2C saveGames\x2C logGameAction\x2C dcMessageMeta\x2C getMapData } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const tokenCount = game.orbitalBombardmentTokens?.[msgId] || 0;\n  if (tokenCount <= 0) {\n    await interaction.followUp({ content: '**Orbital Bombardment** \u2014 No tokens on this card.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Deplete: remove card from attachments\n  const meta = dcMessageMeta?.get(msgId);\n  const playerNum = meta?.playerNum || 1;\n  const attKey = dcAttachmentsKey(playerNum);\n  if (game[attKey]?.[msgId]) {\n    game[attKey][msgId] = game[attKey][msgId].filter(c => c !== 'Orbital Bombardment');\n  }\n  delete game.orbitalBombardmentTokens[msgId];\n  // Set up multi-space selection\n  game.pendingOrbitalBombardment = { msgId\x2C playerNum\x2C spacesRemaining: tokenCount\x2C spacesChosen: []\x2C gameId };\n  // Show space picker (all occupied spaces)\n  const mapId = game.selectedMap?.id;\n  const ms = getMapData?.(mapId);\n  const allSpaces = ms?.adjacency ? Object.keys(ms.adjacency) : [];\n  if (allSpaces.length === 0) {\n    await interaction.message.edit({ content: '**Orbital Bombardment** \u2014 Map data unavailable. Choose spaces manually.'\x2C components: [] }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n  const obContextKey = `${gameId}_${msgId}`;\n  const obHeader = `**Orbital Bombardment** \u2014 Choose space **1 of ${tokenCount}** for bombardment (each figure on a chosen space suffers 2 Damage)`;\n  game.pendingSpacePick = game.pendingSpacePick || {};\n  game.pendingSpacePick[obContextKey] = {\n    validSpaces: allSpaces\x2C\n    cellPrefix: `ob_space_${gameId}_${msgId}_`\x2C\n    mapSpaces: ms\x2C\n    headerText: obHeader\x2C\n  };\n  const { rows: obRowBtns } = buildRowPickerButtons(allSpaces\x2C `space_row_${obContextKey}_`);\n  await interaction.message.edit({\n    content: `${obHeader}:\\nChoose a row:`\x2C\n    components: obRowBtns.slice(0\x2C 5)\x2C\n  }).catch(discordCatch);\n  if (logGameAction) await logGameAction(game\x2C interaction.client\x2C `**Orbital Bombardment** \u2014 **${meta?.displayName || 'DC'}** depleted. Choosing ${tokenCount} spaces for bombardment.`\x2C { phase: 'ROUND'\x2C icon: 'card' });\n  saveGames();\n}\n\n/** Handle Orbital Bombardment skip (decline to deplete at activation start). */\nexport async function handleOrbitalBombardmentSkip(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^ob_skip_([^_]+)_([^_]+)$/);\n  if (!m) return;\n  const { getGame\x2C saveGames } = ctx;\n  const game = getGame(m[1]);\n  if (!game) return;\n  await interaction.message.edit({ content: '**Orbital Bombardment** \u2014 Skipped (tokens remain on card).'\x2C components: [] }).catch(discordCatch);\n  saveGames();\n}\n\n/** Handle Orbital Bombardment space selection (sequential picker). */\nexport async function handleOrbitalBombardmentSpacePick(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^ob_space_([^_]+)_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C msgId\x2C space] = m;\n  const { getGame\x2C saveGames\x2C logGameAction\x2C dcMessageMeta\x2C dcHealthState\x2C getMapData\x2C findDcMessageIdForFigure\x2C processFigureDefeat } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game?.pendingOrbitalBombardment) return;\n  const pending = game.pendingOrbitalBombardment;\n  const chosenSpace = String(space).toLowerCase();\n  pending.spacesChosen.push(chosenSpace);\n\n  if (pending.spacesChosen.length < pending.spacesRemaining) {\n    // More spaces to pick \u2014 re-store pendingSpacePick and show row picker again\n    const mapId = game.selectedMap?.id;\n    const ms = getMapData?.(mapId);\n    const allSpaces = ms?.adjacency ? Object.keys(ms.adjacency) : [];\n    const obSeqContextKey = `${gameId}_${msgId}`;\n    const obSeqHeader = `**Orbital Bombardment** \u2014 Chosen: ${pending.spacesChosen.map(s => s.toUpperCase()).join('\x2C ')}. Choose space **${pending.spacesChosen.length + 1} of ${pending.spacesRemaining}**`;\n    game.pendingSpacePick = game.pendingSpacePick || {};\n    game.pendingSpacePick[obSeqContextKey] = {\n      validSpaces: allSpaces\x2C\n      cellPrefix: `ob_space_${gameId}_${msgId}_`\x2C\n      mapSpaces: ms\x2C\n      headerText: obSeqHeader\x2C\n    };\n    const { rows: obSeqRowBtns } = buildRowPickerButtons(allSpaces\x2C `space_row_${obSeqContextKey}_`);\n    await interaction.message.edit({\n      content: `${obSeqHeader}:\\nChoose a row:`\x2C\n      components: obSeqRowBtns.slice(0\x2C 5)\x2C\n    }).catch(discordCatch);\n    saveGames();\n    return;\n  }\n\n  // All spaces chosen \u2014 apply 2 damage to each figure on chosen spaces\n  const meta = dcMessageMeta?.get(msgId);\n  const attackerPlayerNum = pending.playerNum;\n  const damageLog = [];\n  const defeatedFigures = [];\n  for (const sp of pending.spacesChosen) {\n    // Check both players' figures\n    for (const pn of [1\x2C 2]) {\n      const positions = game.figurePositions?.[pn] || {};\n      for (const [fk\x2C pos] of Object.entries(positions)) {\n        if (!pos || String(pos).toLowerCase() !== sp) continue;\n        // Apply 2 damage to this figure\n        const fkMsgId = findDcMessageIdForFigure?.(gameId\x2C pn\x2C fk);\n        if (!fkMsgId) continue;\n        const hs = dcHealthState?.get(fkMsgId) || [];\n        const figMatch = fk.match(/-(\\d+)-(\\d+)$/);\n        const figIdx = figMatch ? parseInt(figMatch[2]\x2C 10) : 0;\n        const entry = hs[figIdx];\n        if (!entry) continue;\n        const [cur\x2C max] = entry;\n        const newCur = Math.max(0\x2C (cur ?? max) - 2);\n        hs[figIdx] = [newCur\x2C max ?? newCur];\n        dcHealthState?.set(fkMsgId\x2C hs);\n        const dcIds = getDcMessageIds(game\x2C pn);\n        const dcList = getDcList(game\x2C pn);\n        const idx = (dcIds || []).indexOf(fkMsgId);\n        if (idx >= 0 && dcList?.[idx]) dcList[idx].healthState = [...hs];\n        const dcName = dcNameFromFigureKey(fk);\n        damageLog.push(`**${dcName}** (${cur ?? max} \u2192 ${newCur} HP)`);\n        if (newCur <= 0) {\n          damageLog[damageLog.length - 1] += ' **(defeated)**';\n          defeatedFigures.push({ figureKey: fk\x2C playerNum: pn });\n        }\n      }\n    }\n  }\n  const spacesStr = pending.spacesChosen.map(s => s.toUpperCase()).join('\x2C ');\n  const resultStr = damageLog.length > 0 ? `Damage: ${damageLog.join('\x2C ')}` : 'No figures on chosen spaces.';\n  await interaction.message.edit({\n    content: `**Orbital Bombardment** \u2014 Spaces: ${spacesStr}. Each figure suffers 2 Damage.\\n${resultStr}`\x2C\n    components: []\x2C\n  }).catch(discordCatch);\n  if (logGameAction) await logGameAction(game\x2C interaction.client\x2C `**Orbital Bombardment** \u2014 Bombarded spaces: ${spacesStr}. ${resultStr}`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  for (const df of defeatedFigures) {\n    if (processFigureDefeat) {\n      await processFigureDefeat(game\x2C { defeatedPlayerNum: df.playerNum\x2C figureKey: df.figureKey\x2C attackerPlayerNum: opponentPlayerNum(df.playerNum)\x2C source: 'Orbital Bombardment' });\n    }\n  }\n  cleanupSpacePick(game\x2C `${gameId}_${msgId}`);\n  delete game.pendingOrbitalBombardment;\n  saveGames();\n}\n\n/** Handle Bomb Drop space selection \u2014 apply 2 damage to all figures on/adjacent to chosen space. */\nexport async function handleBombDropSpacePick(interaction\x2C ctx) {\n  const m = interaction.customId.match(/^bomb_drop_space_([^_]+)_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C msgId\x2C space] = m;\n  const { getGame\x2C saveGames\x2C logGameAction\x2C dcMessageMeta\x2C dcHealthState\x2C getMapData\x2C findDcMessageIdForFigure\x2C processFigureDefeat } = ctx;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { silent: true });\n  if (!game?.pendingBombDrop?.[msgId]) return;\n  cleanupSpacePick(game\x2C `${gameId}_${msgId}`);\n  const pending = game.pendingBombDrop[msgId];\n  const chosenSpace = String(space).toLowerCase();\n\n  // Discard the explosive\n  if (game.figureContraband?.[pending.figureKey]) {\n    delete game.figureContraband[pending.figureKey];\n  }\n\n  // Find all spaces on/adjacent to chosen space\n  const mapId = game.selectedMap?.id;\n  const ms = getMapData?.(mapId);\n  const adjSpaces = ms?.adjacency?.[chosenSpace] || [];\n  const affectedSpaces = new Set([chosenSpace\x2C ...adjSpaces.map(s => String(s).toLowerCase())]);\n\n  // Apply 2 damage to each figure on affected spaces\n  const damageLog = [];\n  const defeatedFigures = [];\n  for (const pn of [1\x2C 2]) {\n    const positions = game.figurePositions?.[pn] || {};\n    for (const [fk\x2C pos] of Object.entries(positions)) {\n      if (!pos || !affectedSpaces.has(String(pos).toLowerCase())) continue;\n      const fkMsgId = findDcMessageIdForFigure?.(gameId\x2C pn\x2C fk);\n      if (!fkMsgId) continue;\n      const hs = dcHealthState?.get(fkMsgId) || [];\n      const figMatch = fk.match(/-(\\d+)-(\\d+)$/);\n      const figIdx = figMatch ? parseInt(figMatch[2]\x2C 10) : 0;\n      const entry = hs[figIdx];\n      if (!entry) continue;\n      const [cur\x2C max] = entry;\n      const newCur = Math.max(0\x2C (cur ?? max) - 2);\n      hs[figIdx] = [newCur\x2C max ?? newCur];\n      dcHealthState?.set(fkMsgId\x2C hs);\n      const dcIds = getDcMessageIds(game\x2C pn);\n      const dcList = getDcList(game\x2C pn);\n      const idx = (dcIds || []).indexOf(fkMsgId);\n      if (idx >= 0 && dcList?.[idx]) dcList[idx].healthState = [...hs];\n      const dcName = dcNameFromFigureKey(fk);\n      damageLog.push(`**${dcName}** (${cur ?? max} \u2192 ${newCur} HP)`);\n      if (newCur <= 0) {\n        damageLog[damageLog.length - 1] += ' **(defeated)**';\n        defeatedFigures.push({ figureKey: fk\x2C playerNum: pn });\n      }\n    }\n  }\n  const resultStr = damageLog.length > 0 ? `Damage: ${damageLog.join('\x2C ')}` : 'No figures affected.';\n  await interaction.message.edit({\n    content: `**Bomb Drop** \u2014 Detonated at **${chosenSpace.toUpperCase()}**. Each figure on/adjacent suffers 2 Damage.\\n${resultStr}`\x2C\n    components: []\x2C\n  }).catch(discordCatch);\n  if (logGameAction) await logGameAction(game\x2C interaction.client\x2C `**Bomb Drop** \u2014 Detonated at **${chosenSpace.toUpperCase()}**. ${resultStr}`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  for (const df of defeatedFigures) {\n    if (processFigureDefeat) {\n      await processFigureDefeat(game\x2C { defeatedPlayerNum: df.playerNum\x2C figureKey: df.figureKey\x2C attackerPlayerNum: opponentPlayerNum(df.playerNum)\x2C source: 'Bomb Drop' });\n    }\n  }\n  delete game.pendingBombDrop[msgId];\n  saveGames();\n}\n
