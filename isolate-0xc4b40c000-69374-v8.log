script-source,179,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/utils/guards.js,import { discordCatch } from '../error-handling.js';\n\nexport async function requireGame(interaction\x2C getGame\x2C gameId\x2C opts = {}) {\n  const game = getGame(gameId);\n  const respond = opts.useReply ? interaction.reply.bind(interaction) : interaction.followUp.bind(interaction);\n  if (!game) {\n    if (!opts.silent) {\n      await respond({ content: 'Game not found.'\x2C ephemeral: true }).catch(discordCatch);\n    }\n    return null;\n  }\n  if (opts.checkEnded && game.ended) {\n    if (!opts.silent) {\n      await respond({ content: 'This game has ended.'\x2C ephemeral: true }).catch(discordCatch);\n    }\n    return null;\n  }\n  return game;\n}\n\nexport async function requirePlayer(interaction\x2C game\x2C userId\x2C playerNum\x2C canActAsPlayer\x2C message\x2C opts = {}) {\n  if (!canActAsPlayer(game\x2C userId\x2C playerNum)) {\n    const respond = opts.useReply ? interaction.reply.bind(interaction) : interaction.followUp.bind(interaction);\n    await respond({\n      content: message || 'Only the owner can perform this action.'\x2C\n      ephemeral: true\x2C\n    }).catch(discordCatch);\n    return false;\n  }\n  return true;\n}\n
