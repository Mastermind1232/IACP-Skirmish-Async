hould stay in TDZ)\n          continue;\n        }\n      }\n      reflect.exports[expt].set(val);\n    }\n  });\n  // WebAssembly modules support source phase imports\x2C to import the compiled module\n  // separate from the linked instance.\n  module.setModuleSourceObject(compiled);\n  return module;\n});\n\n// Strategy for loading a addon\ntranslators.set('addon'\x2C function translateAddon(url\x2C translateContext\x2C parentURL) {\n  emitExperimentalWarning('Importing addons');\n\n  const { source } = translateContext;\n  // The addon must be loaded from file system with dlopen. Assert\n  // the source is null.\n  if (source !== null) {\n    throw new ERR_INVALID_RETURN_PROPERTY_VALUE(\n      'null'\x2C\n      'load'\x2C\n      'source'\x2C\n      source);\n  }\n\n  debug(`Translating addon ${url}`\x2C translateContext);\n\n  return createCJSNoSourceModuleWrap(url\x2C parentURL);\n});\n\n// Strategy for loading a commonjs TypeScript module\ntranslators.set('commonjs-typescript'\x2C function(url\x2C translateContext\x2C parentURL) {\n  const { source } = translateContext;\n  assertBufferSource(source\x2C true\x2C 'load');\n  debug(`Translating TypeScript ${url}`\x2C translateContext);\n  translateContext.source = stripTypeScriptModuleTypes(stringify(source)\x2C url);\n  return FunctionPrototypeCall(translators.get('commonjs')\x2C this\x2C url\x2C translateContext\x2C parentURL);\n});\n\n// Strategy for loading an esm TypeScript module\ntranslators.set('module-typescript'\x2C function(url\x2C translateContext\x2C parentURL) {\n  const { source } = translateContext;\n  assertBufferSource(source\x2C true\x2C 'load');\n  debug(`Translating TypeScript ${url}`\x2C translateContext);\n  translateContext.source = stripTypeScriptModuleTypes(stringify(source)\x2C url);\n  return FunctionPrototypeCall(translators.get('module')\x2C this\x2C url\x2C translateContext\x2C parentURL);\n});\n
