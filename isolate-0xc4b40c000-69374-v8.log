script-source,149,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/game-tools.js,/**\n * Game tools handlers: refresh_map_\x2C refresh_all_\x2C undo_\x2C kill_game_\x2C default_deck_.\n * Participants-only; require getGame and various helpers via context.\n */\nimport { ActionRowBuilder\x2C ButtonBuilder\x2C ButtonStyle\x2C PermissionFlagsBits } from 'discord.js';\nimport { deleteGameChannelsAndGame } from './botmenu.js';\nimport { discordCatch } from '../error-handling.js';\nimport { logGameAction } from '../discord/messages.js';\nimport { requireGame } from '../utils/guards.js';\nimport { getInitiativePlayerNum\x2C getPlayAreaId\x2C getPlayerId } from '../game/player-helpers.js';\nimport { PHASES } from '../game/phase.js';\nimport { fetchGameChannel } from '../discord/channel-helpers.js';\nimport { parseCustomId\x2C splitCustomId } from '../discord/custom-id.js';\nimport { captureManualKillDiagnostic } from '../ai/self-play.js';\n\n/** Build a short description of the current game state after an undo\x2C so players know what to do next. */\nfunction describeGameState(game) {\n  // Phase-based dispatch\n  if (game.phase) {\n    switch (game.phase) {\n      case 'zone_selection': {\n        const chooserId = game.deviousSchemeZoneChooser || game.initiativePlayerId;\n        return `Waiting for <@${chooserId}> to pick a deployment zone.`;\n      }\n      case 'deployment': {\n        if (!game.initiativePlayerDeployed) {\n          const initPn = getInitiativePlayerNum(game);\n          return `Waiting for <@${getPlayerId(game\x2C initPn)}> (initiative) to deploy figures.`;\n        }\n        if (!game.nonInitiativePlayerDeployed) {\n          const otherPn = getInitiativePlayerNum(game) === 1 ? 2 : 1;\n          return `Waiting for <@${getPlayerId(game\x2C otherPn)}> to deploy figures.`;\n        }\n        return null;\n      }\n      case 'attachment':\n        return 'Place Skirmish Upgrade attachments\x2C then confirm.';\n      case 'cc_draw': {\n        const waiting = [];\n        if (!game.player1CcDrawn) waiting.push(`<@${game.player1Id}>`);\n        if (!game.player2CcDrawn) waiting.push(`<@${game.player2Id}>`);\n        return waiting.length\n          ? `Waiting for ${waiting.join(' and ')} to shuffle and draw starting hand.`\n          : null;\n      }\n      case 'round_active':\n        if (game.currentRound && game.currentActivationTurnPlayerId) {\n          return `Round ${game.currentRound} \u2014 <@${game.currentActivationTurnPlayerId}>'s turn.`;\n        }\n        return null;\n      default:\n        return null;\n    }\n  }\n\n  // Legacy fallback for unmigrated games\n  if (!game.deploymentZoneChosen) {\n    const chooserId = game.deviousSchemeZoneChooser || game.initiativePlayerId;\n    return `Waiting for <@${chooserId}> to pick a deployment zone.`;\n  }\n  if (!game.initiativePlayerDeployed) {\n    const initPn = getInitiativePlayerNum(game);\n    return `Waiting for <@${getPlayerId(game\x2C initPn)}> (initiative) to deploy figures.`;\n  }\n  if (!game.nonInitiativePlayerDeployed) {\n    const otherPn = getInitiativePlayerNum(game) === 1 ? 2 : 1;\n    return `Waiting for <@${getPlayerId(game\x2C otherPn)}> to deploy figures.`;\n  }\n  if (game.setupAttachmentPhase) {\n    return 'Place Skirmish Upgrade attachments\x2C then confirm.';\n  }\n  if (!game.player1CcDrawn || !game.player2CcDrawn) {\n    const waiting = [];\n    if (!game.player1CcDrawn) waiting.push(`<@${game.player1Id}>`);\n    if (!game.player2CcDrawn) waiting.push(`<@${game.player2Id}>`);\n    return `Waiting for ${waiting.join(' and ')} to shuffle and draw starting hand.`;\n  }\n  if (game.currentRound && game.currentActivationTurnPlayerId) {\n    return `Round ${game.currentRound} \u2014 <@${game.currentActivationTurnPlayerId}>'s turn.`;\n  }\n  return null;\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C buildBoardMapPayload\x2C logGameErrorToBotLogs\x2C client\n */\nexport async function handleRefreshMap(interaction\x2C ctx) {\n  const { getGame\x2C buildBoardMapPayload\x2C logGameErrorToBotLogs\x2C client } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'refresh_map_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (interaction.user.id !== game.player1Id && interaction.user.id !== game.player2Id) {\n    await interaction.followUp({ content: 'Only players in this game can refresh the map.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (!game.selectedMap) {\n    await interaction.followUp({ content: 'No map selected yet.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  try {\n    const boardChannel = await fetchGameChannel(client\x2C game.boardId);\n    if (!boardChannel) throw new Error('Board channel not found');\n    const payload = await buildBoardMapPayload(gameId\x2C game.selectedMap\x2C game);\n    await boardChannel.send(payload);\n  } catch (err) {\n    console.error('Failed to refresh map:'\x2C err);\n    await logGameErrorToBotLogs(interaction.client\x2C interaction.guild\x2C gameId\x2C err\x2C 'refresh_map');\n    await interaction.followUp({ content: 'Failed to refresh map.'\x2C ephemeral: true }).catch(discordCatch);\n  }\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C refreshAllGameComponents\x2C logGameErrorToBotLogs\x2C client\n */\nexport async function handleRefreshAll(interaction\x2C ctx) {\n  const { getGame\x2C refreshAllGameComponents\x2C logGameErrorToBotLogs\x2C saveGames\x2C client } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'refresh_all_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (interaction.user.id !== game.player1Id && interaction.user.id !== game.player2Id) {\n    await interaction.followUp({ content: 'Only players in this game can refresh.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  try {\n    await refreshAllGameComponents(game\x2C client);\n    saveGames();\n    await interaction.message.delete().catch(discordCatch);\n    await interaction.followUp({ content: '\u2713 Full refresh complete. Reloaded all JSON data\x2C map renderer cache\x2C map\x2C DCs\x2C hands\x2C discard piles.'\x2C ephemeral: true }).catch(discordCatch);\n  } catch (err) {\n    console.error('Failed to refresh all:'\x2C err);\n    await logGameErrorToBotLogs(interaction.client\x2C interaction.guild\x2C gameId\x2C err\x2C 'refresh_all');\n    await interaction.followUp({ content: 'Failed to refresh: ' + (err?.message || String(err))\x2C ephemeral: true }).catch(discordCatch);\n  }\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C saveGames\x2C updateMovementBankMessage\x2C buildBoardMapPayload\x2C updateDeployPromptMessages\x2C updateDcActionsMessage\x2C updateHandVisualMessage\x2C updateDiscardPileMessage\x2C updateAttachmentMessageForDc\x2C client\n */\nexport async function handleUndo(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    saveGames\x2C\n    updateMovementBankMessage\x2C\n    buildBoardMapPayload\x2C\n    updateDeployPromptMessages\x2C\n    updateDcActionsMessage\x2C\n    updateHandVisualMessage\x2C\n    updateDiscardPileMessage\x2C\n    updateAttachmentMessageForDc\x2C\n    getDeploymentZoneButtons\x2C\n    dcExhaustedState\x2C\n    dcMessageMeta\x2C\n    renderDcEmbed\x2C\n    getDcPlayAreaComponents\x2C\n    updateActivationsMessage\x2C\n    client\x2C\n  } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'undo_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (game.ended) {\n    await interaction.followUp({ content: 'Undo is disabled once the game has ended.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (interaction.user.id !== game.player1Id && interaction.user.id !== game.player2Id) {\n    await interaction.followUp({ content: 'Only players in this game can use Undo.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const last = game.undoStack?.pop();\n  if (!last) {\n    await interaction.followUp({ content: 'Nothing to undo yet.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  // Guard: deploy_pick can only be undone during the setup phase (before game rounds begin).\n  // Check BEFORE snapshot restore so we inspect current game state\x2C not the snapshot's.\n  if (last.type === 'deploy_pick' && game.currentRound) {\n    game.undoStack.push(last); // put it back\n    await interaction.followUp({ content: 'Deployment undo is only available before the game starts.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  /** F14 time-travel: remove the original action message from Game Log so it looks exactly as before. */\n  if (last.gameLogMessageId && game.generalId) {\n    try {\n      const ch = await fetchGameChannel(client\x2C game.generalId);\n      if (!ch) throw new Error('Channel not found');\n      const msg = await ch.messages.fetch(last.gameLogMessageId).catch(() => null);\n      if (msg) await msg.delete().catch(discordCatch);\n    } catch {\n      // ignore\n    }\n  }\n\n  // === UNIVERSAL SNAPSHOT RESTORE ===\n  // Restore entire game state from snapshot. Discord UI refresh is handled per-type below.\n  if (last.snapshot) {\n    const savedStack = game.undoStack; // already has `last` popped off\n    for (const key of Object.keys(game)) {\n      if (key !== 'undoStack') delete game[key];\n    }\n    Object.assign(game\x2C last.snapshot);\n    game.undoStack = savedStack;\n\n    // If restored snapshot has an active phase gate\x2C re-send gate messages\n    // (old Discord messages are stale after undo)\n    if (game.phaseGate) {\n      const { sendPhaseGateMessages } = ctx;\n      if (sendPhaseGateMessages) {\n        try {\n          await sendPhaseGateMessages(game\x2C game.phaseGate.phase\x2C ctx);\n        } catch (err) {\n          console.error('Failed to re-send phase gate after undo:'\x2C err);\n        }\n      }\n    }\n  }\n  // ===================================\n\n  // Log undo to game log so both players can see what was reverted + current state\n  const undoLabel = last.label || last.card || last.type?.replace(/_/g\x2C ' ') || 'action';\n  const undoUser = interaction.user.username;\n  const stateDesc = describeGameState(game);\n  const undoLogMsg = stateDesc\n    ? `**${undoUser}** undid: ${undoLabel}\\n**Current state:** ${stateDesc}`\n    : `**${undoUser}** undid: ${undoLabel}`;\n  logGameAction(game\x2C client\x2C undoLogMsg).catch(discordCatch);\n\n  // Per-type Discord UI sync (game state is already restored above)\n  if (last.type === 'pass_turn') {\n    if (last.roundMessageId && last.roundContentBefore != null && game.generalId) {\n      try {\n        const ch = await fetchGameChannel(client\x2C game.generalId);\n        const msg = await ch.messages.fetch(last.roundMessageId).catch(() => null);\n        if (msg) {\n          const _undoMyRem = game.p1ActivationsRemaining ?? 0;\n          const _undoOppRem = game.p2ActivationsRemaining ?? 0;\n          const prevPlayerNum = last.previousTurnPlayerId === game.player1Id ? 1 : 2;\n          const _myAct = prevPlayerNum === 1 ? _undoMyRem : _undoOppRem;\n          const _theirAct = prevPlayerNum === 1 ? _undoOppRem : _undoMyRem;\n          const passRow = new ActionRowBuilder().addComponents(\n            new ButtonBuilder()\n              .setCustomId(`pass_activation_turn_${last.gameId || gameId}`)\n              .setLabel(`Pass (opponent has ${_theirAct - _myAct} more activation${_theirAct - _myAct !== 1 ? 's' : ''} than you)`)\n              .setStyle(ButtonStyle.Secondary)\n          );\n          await msg.edit({\n            content: last.roundContentBefore\x2C\n            components: [passRow]\x2C\n            allowedMentions: { users: [last.previousTurnPlayerId] }\x2C\n          }).catch(discordCatch);\n        }\n      } catch {\n        // ignore\n      }\n    }\n    saveGames();\n    await interaction.followUp({ content: 'Pass turn undone.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (last.type === 'activation') {\n    // Archive the activation thread\n    if (last.activationThreadId) {\n      try {\n        const activationThread = await fetchGameChannel(client\x2C last.activationThreadId);\n        if (activationThread) {\n          await activationThread.send('Activation cancelled (undo).').catch(discordCatch);\n          await activationThread.setArchived(true).catch(discordCatch);\n        }\n      } catch { /* thread already gone or inaccessible */ }\n    }\n    // Un-exhaust the DC and refresh its play area embed\n    if (last.msgId && dcExhaustedState && dcMessageMeta) {\n      dcExhaustedState.set(last.msgId\x2C false);\n      const meta = dcMessageMeta.get(last.msgId);\n      if (meta && renderDcEmbed && getDcPlayAreaComponents) {\n        try {\n          const playAreaId = getPlayAreaId(game\x2C last.playerNum);\n          const playChannel = await fetchGameChannel(client\x2C playAreaId);\n          const dcMsg = await playChannel.messages.fetch(last.msgId).catch(() => null);\n          if (dcMsg) {\n            const { embed\x2C files } = await renderDcEmbed(game\x2C last.msgId\x2C ctx\x2C { exhausted: false });\n            await dcMsg.edit({ embeds: [embed]\x2C files\x2C components: getDcPlayAreaComponents(last.msgId\x2C false\x2C game\x2C meta.dcName) });\n          }\n        } catch (err) {\n          console.error('Failed to refresh DC embed after activation undo:'\x2C err);\n        }\n      }\n    }\n    // Refresh activations message\n    if (updateActivationsMessage) {\n      try { await updateActivationsMessage(game\x2C last.playerNum\x2C client); } catch { /* ignore */ }\n    }\n    saveGames();\n    await interaction.followUp({ content: 'Activation undone.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (last.type === 'move') {\n    if (game.movementBank?.[last.msgId] != null) {\n      try { await updateMovementBankMessage(game\x2C last.msgId\x2C client); } catch { /* ignore */ }\n    }\n    if (game.boardId && game.selectedMap) {\n      try {\n        const boardChannel = await fetchGameChannel(client\x2C game.boardId);\n        if (boardChannel) {\n          const payload = await buildBoardMapPayload(game.gameId\x2C game.selectedMap\x2C game);\n          await boardChannel.send(payload);\n        }\n      } catch (err) {\n        console.error('Failed to update map after undo move:'\x2C err);\n      }\n    }\n    saveGames();\n    await interaction.followUp({ content: 'Movement undone.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (last.type === 'deploy_pick') {\n    await updateDeployPromptMessages(game\x2C last.playerNum\x2C client);\n    if (game.boardId && game.selectedMap) {\n      try {\n        const boardChannel = await fetchGameChannel(client\x2C game.boardId);\n        if (boardChannel) {\n          const payload = await buildBoardMapPayload(gameId\x2C game.selectedMap\x2C game);\n          await boardChannel.send(payload);\n        }\n      } catch (err) {\n        console.error('Failed to update map after undo:'\x2C err);\n      }\n    }\n    saveGames();\n    await interaction.followUp({ content: 'Last deployment undone.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (last.type === 'deployment_zone') {\n    // Delete the deploy prompt messages that were sent to initiative player's hand\n    if (last.deployMessageIds?.length && last.deployHandChannelId) {\n      try {\n        const handCh = await fetchGameChannel(client\x2C last.deployHandChannelId);\n        for (const msgId of last.deployMessageIds) {\n          const msg = await handCh.messages.fetch(msgId).catch(() => null);\n          if (msg) await msg.delete().catch(discordCatch);\n        }\n      } catch { /* ignore */ }\n    }\n    // Delete old zone picker message and send a new one at the bottom of chat\n    if (game.generalId && getDeploymentZoneButtons) {\n      try {\n        const generalChannel = await fetchGameChannel(client\x2C game.generalId);\n        if (game.deploymentZoneMessageId) {\n          const oldMsg = await generalChannel.messages.fetch(game.deploymentZoneMessageId).catch(() => null);\n          if (oldMsg) await oldMsg.delete().catch(discordCatch);\n        }\n        const zoneChooserId = game.deviousSchemeZoneChooser || game.initiativePlayerId;\n        const zoneChooserPlayerNum = zoneChooserId === game.player1Id ? 1 : 2;\n        const newMsg = await generalChannel.send({\n          content: `<@${zoneChooserId}> (**Player ${zoneChooserPlayerNum}**) \u2014 Pick your deployment zone:`\x2C\n          components: [getDeploymentZoneButtons(last.gameId || gameId)]\x2C\n        });\n        game.deploymentZoneMessageId = newMsg.id;\n      } catch { /* ignore */ }\n    }\n    saveGames();\n    await interaction.followUp({ content: 'Deployment zone selection undone.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (last.type === 'interact') {\n    if (updateDcActionsMessage && last.msgId) await updateDcActionsMessage(game\x2C last.msgId\x2C client).catch(discordCatch);\n    saveGames();\n    await interaction.followUp({ content: 'Interact undone.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (last.type === 'cc_play') {\n    if (updateHandVisualMessage) await updateHandVisualMessage(game\x2C last.playerNum\x2C client).catch(discordCatch);\n    if (updateDiscardPileMessage) await updateDiscardPileMessage(game\x2C last.playerNum\x2C client).catch(discordCatch);\n    saveGames();\n    await interaction.followUp({ content: 'Command card play undone.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (last.type === 'cc_play_dc') {\n    if (last.previousAttachments != null && last.msgId != null) {\n      if (updateAttachmentMessageForDc) await updateAttachmentMessageForDc(game\x2C last.playerNum\x2C last.msgId\x2C client).catch(discordCatch);\n    }\n    if (updateHandVisualMessage) await updateHandVisualMessage(game\x2C last.playerNum\x2C client).catch(discordCatch);\n    if (updateDiscardPileMessage) await updateDiscardPileMessage(game\x2C last.playerNum\x2C client).catch(discordCatch);\n    if (updateDcActionsMessage && last.msgId) await updateDcActionsMessage(game\x2C last.msgId\x2C client).catch(discordCatch);\n    saveGames();\n    await interaction.followUp({ content: 'Command card (Special) play undone.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (last.type === 'attack' || last.type === 'dc_special' || last.type === 'end_activation') {\n    // Refresh DC action counter if we have the msgId\n    if (last.msgId && updateDcActionsMessage) await updateDcActionsMessage(game\x2C last.msgId\x2C client).catch(discordCatch);\n    // Step 15: Attack undo \u2014 clean up the combat thread\n    if (last.type === 'attack' && last.snapshot?.pendingCombat?.combatThreadId) {\n      try {\n        const combatThread = await fetchGameChannel(client\x2C last.snapshot.pendingCombat.combatThreadId);\n        if (combatThread) {\n          await combatThread.send('Combat cancelled (undo).').catch(discordCatch);\n          await combatThread.setArchived(true).catch(discordCatch);\n        }\n      } catch { /* thread already gone or inaccessible */ }\n    }\n    // Step 16: Always refresh board for attack\x2C dc_special\x2C and end_activation undos\n    if (game.boardId && game.selectedMap && buildBoardMapPayload) {\n      try {\n        const boardChannel = await fetchGameChannel(client\x2C game.boardId);\n        if (boardChannel) {\n          const payload = await buildBoardMapPayload(game.gameId\x2C game.selectedMap\x2C game);\n          await boardChannel.send(payload);\n        }\n      } catch { /* ignore */ }\n    }\n    const label = last.label || last.type.replace('_'\x2C ' ');\n    saveGames();\n    await interaction.followUp({ content: `${label} undone.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  // Unknown type but snapshot was restored \u2014 still valid\x2C just no specific Discord cleanup\n  if (last.snapshot) {\n    saveGames();\n    await interaction.followUp({ content: `${last.label || 'Action'} undone.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  await interaction.followUp({ content: 'That action cannot be undone yet.'\x2C ephemeral: true }).catch(discordCatch);\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C deleteGame\x2C saveGames\x2C dcMessageMeta\x2C dcExhaustedState\x2C dcHealthState\x2C logGameErrorToBotLogs\x2C client\x2C deleteGameFromDb\n */\nexport async function handleKillGame(interaction\x2C ctx) {\n  const { getGame\x2C logGameErrorToBotLogs } = ctx;\n  const gameId = parseCustomId(interaction.customId\x2C 'kill_game_');\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  const isPlayer = interaction.user.id === game.player1Id || interaction.user.id === game.player2Id;\n  const isAdmin = interaction.member?.permissions?.has(PermissionFlagsBits.ManageGuild);\n  if (!isPlayer && !isAdmin) {\n    await interaction.followUp({ content: 'Only players in this game (or server admins) can kill it.'\x2C ephemeral: true });\n    return;\n  }\n  try {\n    try { await captureManualKillDiagnostic(game\x2C gameId); } catch (e) { console.warn('[kill_game] Pre-kill dump failed:'\x2C e.message); }\n    await deleteGameChannelsAndGame(game\x2C gameId\x2C ctx);\n    await interaction.followUp({ content: `Game **IA Game #${gameId}** deleted. All channels removed.`\x2C ephemeral: true }).catch(discordCatch);\n  } catch (err) {\n    console.error('Kill game error:'\x2C err);\n    await logGameErrorToBotLogs(interaction.client\x2C interaction.guild\x2C gameId\x2C err\x2C 'kill_game');\n    await interaction.followUp({ content: `Failed to delete: ${err.message}`\x2C ephemeral: true }).catch(discordCatch);\n  }\n}\n\n/**\n * @param {import('discord.js').ButtonInteraction} interaction\n * @param {object} ctx - getGame\x2C applySquadSubmission\x2C logGameErrorToBotLogs\x2C DEFAULT_DECK_REBELS\x2C DEFAULT_DECK_SCUM\x2C DEFAULT_DECK_IMPERIAL\x2C client\n */\nexport async function handleDefaultDeck(interaction\x2C ctx) {\n  const {\n    getGame\x2C\n    applySquadSubmission\x2C\n    logGameErrorToBotLogs\x2C\n    DEFAULT_DECK_REBELS\x2C\n    DEFAULT_DECK_SCUM\x2C\n    DEFAULT_DECK_IMPERIAL\x2C\n    client\x2C\n  } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'default_deck_');\n  if (parts.length < 3) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const gameId = parts[0];\n  const playerNum = parts[1];\n  const faction = parts[2];\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!game.mapSelected) {\n    await interaction.followUp({ content: 'Map selection must be completed before you can load a squad.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const isP1 = playerNum === '1';\n  const userId = isP1 ? game.player1Id : game.player2Id;\n  if (interaction.user.id !== userId) {\n    await interaction.followUp({ content: 'Only the owner of this hand can load a default deck.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const squadMap = { rebel: DEFAULT_DECK_REBELS\x2C scum: DEFAULT_DECK_SCUM\x2C imperial: DEFAULT_DECK_IMPERIAL };\n  const squad = squadMap[faction];\n  if (!squad) {\n    await interaction.followUp({ content: 'Unknown faction.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  try {\n    await applySquadSubmission(game\x2C isP1\x2C { ...squad }\x2C client);\n    await interaction.followUp({ content: `Loaded **${squad.name}** (${squad.dcCount} DCs\x2C ${squad.ccCount} CCs).`\x2C ephemeral: true }).catch(discordCatch);\n  } catch (err) {\n    console.error('Failed to apply default deck:'\x2C err);\n    await logGameErrorToBotLogs(interaction.client\x2C interaction.guild\x2C gameId\x2C err\x2C 'default_deck');\n    await interaction.followUp({ content: `Failed to load deck: ${err.message}`\x2C ephemeral: true }).catch(discordCatch);\n  }\n}\n
