script-source,665,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/discord.js/src/structures/GuildOnboardingPrompt.js,'use strict';\n\nconst { Collection } = require('@discordjs/collection');\nconst Base = require('./Base');\nconst { GuildOnboardingPromptOption } = require('./GuildOnboardingPromptOption');\n\n/**\n * Represents the data of a prompt of a guilds onboarding.\n * @extends {Base}\n */\nclass GuildOnboardingPrompt extends Base {\n  constructor(client\x2C data\x2C guildId) {\n    super(client);\n\n    /**\n     * The id of the guild this onboarding prompt is from\n     * @type {Snowflake}\n     */\n    this.guildId = guildId;\n\n    /**\n     * The id of the prompt\n     * @type {Snowflake}\n     */\n    this.id = data.id;\n\n    /**\n     * The options available within the prompt\n     * @type {Collection<Snowflake\x2C GuildOnboardingPromptOption>}\n     */\n    this.options = data.options.reduce(\n      (options\x2C option) => options.set(option.id\x2C new GuildOnboardingPromptOption(client\x2C option\x2C guildId))\x2C\n      new Collection()\x2C\n    );\n\n    /**\n     * The title of the prompt\n     * @type {string}\n     */\n    this.title = data.title;\n\n    /**\n     * Whether users are limited to selecting one option for the prompt\n     * @type {boolean}\n     */\n    this.singleSelect = data.single_select;\n\n    /**\n     * Whether the prompt is required before a user completes the onboarding flow\n     * @type {boolean}\n     */\n    this.required = data.required;\n\n    /**\n     * Whether the prompt is present in the onboarding flow.\n     * If `false`\x2C the prompt will only appear in the Channels & Roles tab\n     * @type {boolean}\n     */\n    this.inOnboarding = data.in_onboarding;\n\n    /**\n     * The type of the prompt\n     * @type {GuildOnboardingPromptType}\n     */\n    this.type = data.type;\n  }\n\n  /**\n   * The guild this onboarding prompt is from\n   * @type {Guild}\n   * @readonly\n   */\n  get guild() {\n    return this.client.guilds.cache.get(this.guildId);\n  }\n}\n\nexports.GuildOnboardingPrompt = GuildOnboardingPrompt;\n
