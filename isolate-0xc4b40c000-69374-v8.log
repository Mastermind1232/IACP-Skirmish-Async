script-source,368,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/undici/lib/dispatcher/retry-agent.js,'use strict'\n\nconst Dispatcher = require('./dispatcher')\nconst RetryHandler = require('../handler/retry-handler')\n\nclass RetryAgent extends Dispatcher {\n  #agent = null\n  #options = null\n  constructor (agent\x2C options = {}) {\n    super(options)\n    this.#agent = agent\n    this.#options = options\n  }\n\n  dispatch (opts\x2C handler) {\n    const retry = new RetryHandler({\n      ...opts\x2C\n      retryOptions: this.#options\n    }\x2C {\n      dispatch: this.#agent.dispatch.bind(this.#agent)\x2C\n      handler\n    })\n    return this.#agent.dispatch(opts\x2C retry)\n  }\n\n  close () {\n    return this.#agent.close()\n  }\n\n  destroy () {\n    return this.#agent.destroy()\n  }\n}\n\nmodule.exports = RetryAgent\n
