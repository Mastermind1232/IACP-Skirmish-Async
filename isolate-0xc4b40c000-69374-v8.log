code-creation,Script,9,281317,0x3f05b92955e8,79, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/favorites.js:1:1,0x3dc363b8c910,~
script-source,226,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/favorites.js,/**\n * Favorite deck handlers for setup flow and /favorites management.\n *\n * Button prefixes: fav_save_\x2C fav_remove_\x2C fav_rename_\x2C fav_choose_\x2C fav_choose_select_\n * Modal prefixes: fav_name_modal_\x2C fav_rename_modal_\n * /favorites list: fav_list_select_\x2C fav_list_rename_\x2C fav_list_remove_\x2C fav_list_back_\n * /favorites modal: fav_list_rename_modal_\n */\nimport {\n  ActionRowBuilder\x2C\n  ButtonBuilder\x2C\n  ButtonStyle\x2C\n  StringSelectMenuBuilder\x2C\n  StringSelectMenuOptionBuilder\x2C\n  ModalBuilder\x2C\n  TextInputBuilder\x2C\n  TextInputStyle\x2C\n} from 'discord.js';\nimport { splitCustomId } from '../discord/custom-id.js';\nimport { discordCatch } from '../error-handling.js';\nimport { requireGame\x2C requirePlayer } from '../utils/guards.js';\nimport { canActAsPlayer } from '../utils/can-act-as-player.js';\nimport { fetchGameChannel } from '../discord/channel-helpers.js';\nimport { normalizeSquadInput\x2C validateDeckLegal } from '../game/validation.js';\nimport { computeDeckHash } from '../game/deck-hash.js';\nimport {\n  isFavoritesAvailable\x2C\n  getFavoriteDecks\x2C\n  getFavoriteDeckByHash\x2C\n  getFavoriteDeckById\x2C\n  insertFavoriteDeck\x2C\n  deleteFavoriteDeck\x2C\n  renameFavoriteDeck\x2C\n  touchFavoriteDeckUsage\x2C\n} from '../db.js';\nimport { validateArmyAffiliation } from '../game/validation.js';\nimport { truncateLabel } from '../discord/components.js';\nimport { getPlayerId } from '../game/player-helpers.js';\n\nconst UNAVAILABLE_MSG = 'Favorites are unavailable right now.';\nconst MAX_SELECT_OPTIONS = 25;\nconst MAX_DESCRIPTION_LENGTH = 100;\n\n/** Truncate a string for select menu description (max 100 chars in Discord). */\nfunction truncateDescription(s\x2C max = MAX_DESCRIPTION_LENGTH) {\n  if (!s) return '';\n  return s.length <= max ? s : s.slice(0\x2C max - 1) + '\u2026';\n}\n\n/**\n * Build the favorite-aware button row for the squad confirmation message.\n * @param {string} gameId\n * @param {number} playerNum\n * @param {object|null} existingFavorite - row from DB if deck is already a favorite\x2C null otherwise\n * @returns {ActionRowBuilder}\n */\nexport function buildFavoriteConfirmButtons(gameId\x2C playerNum\x2C existingFavorite) {\n  const buttons = [\n    new ButtonBuilder()\n      .setCustomId(`squad_confirm_${gameId}_${playerNum}`)\n      .setLabel('Confirm Deck')\n      .setStyle(ButtonStyle.Success)\x2C\n  ];\n\n  if (existingFavorite) {\n    buttons.push(\n      new ButtonBuilder()\n        .setCustomId(`fav_rename_${gameId}_${playerNum}`)\n        .setLabel('Rename Favorite')\n        .setStyle(ButtonStyle.Secondary)\x2C\n      new ButtonBuilder()\n        .setCustomId(`fav_remove_${gameId}_${playerNum}`)\n        .setLabel('Remove Favorite')\n        .setStyle(ButtonStyle.Danger)\x2C\n    );\n  } else {\n    buttons.push(\n      new ButtonBuilder()\n        .setCustomId(`fav_save_${gameId}_${playerNum}`)\n        .setLabel('Save to Favorites')\n        .setStyle(ButtonStyle.Secondary)\x2C\n    );\n  }\n\n  buttons.push(\n    new ButtonBuilder()\n      .setCustomId(`squad_cancel_${gameId}_${playerNum}`)\n      .setLabel('Cancel')\n      .setStyle(ButtonStyle.Danger)\x2C\n  );\n\n  return new ActionRowBuilder().addComponents(...buttons);\n}\n\n/**\n * Build confirmation message content\x2C optionally prepending the favorite indicator.\n */\nexport function buildFavoriteConfirmContent(baseText\x2C existingFavorite) {\n  if (!existingFavorite) return baseText;\n  return `\u2605 **Saved favorite:** "${existingFavorite.saved_name}"\\n\\n${baseText}`;\n}\n\n// \u2500\u2500 Setup flow handlers \u2500\u2500\n\n/** Save to Favorites button \u2192 show naming modal */\nexport async function handleFavSave(interaction\x2C ctx) {\n  if (!isFavoritesAvailable()) {\n    await interaction.reply({ content: UNAVAILABLE_MSG\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { getGame\x2C pendingSquadConfirm\x2C PENDING_ILLEGAL_TTL_MS } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'fav_save_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner of this hand can save favorites.')) return;\n\n  const key = `${gameId}_${playerNum}`;\n  const pending = pendingSquadConfirm.get(key);\n  if (!pending || (Date.now() - pending.timestamp > PENDING_ILLEGAL_TTL_MS)) {\n    await interaction.reply({ content: 'This squad confirmation has expired. Please submit your squad again.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const modal = new ModalBuilder()\n    .setCustomId(`fav_name_modal_${gameId}_${playerNum}`)\n    .setTitle('Name Your Favorite');\n  modal.addComponents(\n    new ActionRowBuilder().addComponents(\n      new TextInputBuilder()\n        .setCustomId('fav_deck_name')\n        .setLabel('Favorite Name')\n        .setStyle(TextInputStyle.Short)\n        .setPlaceholder('e.g. Vader\\'s Fist')\n        .setRequired(true)\n        .setMaxLength(100)\n    )\x2C\n  );\n  await interaction.showModal(modal);\n}\n\n/** Save to Favorites modal submit \u2192 insert into DB */\nexport async function handleFavNameModal(interaction\x2C ctx) {\n  if (!isFavoritesAvailable()) {\n    await interaction.reply({ content: UNAVAILABLE_MSG\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { getGame\x2C pendingSquadConfirm\x2C PENDING_ILLEGAL_TTL_MS } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'fav_name_modal_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { useReply: true });\n  if (!game) return;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner of this hand can save favorites.'\x2C { useReply: true })) return;\n\n  const key = `${gameId}_${playerNum}`;\n  const pending = pendingSquadConfirm.get(key);\n  if (!pending || (Date.now() - pending.timestamp > PENDING_ILLEGAL_TTL_MS)) {\n    await interaction.reply({ content: 'This squad confirmation has expired. Please submit your squad again.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const savedName = interaction.fields.getTextInputValue('fav_deck_name').trim();\n  if (!savedName) {\n    await interaction.reply({ content: 'Favorite name cannot be empty.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const squad = pending.squad;\n  const deckHash = computeDeckHash(squad);\n  const userId = interaction.user.id;\n\n  // Check if already exists\n  const existing = await getFavoriteDeckByHash(userId\x2C deckHash);\n  if (existing) {\n    await interaction.reply({ content: `This deck is already saved as **"${existing.saved_name}"**.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const { primaryAffiliation } = validateArmyAffiliation(squad);\n  const validation = pending.validation;\n  const deckData = { dcList: squad.dcList\x2C ccList: squad.ccList\x2C dcCount: squad.dcCount\x2C ccCount: squad.ccCount };\n  const rawText = squad._rawListText || null;\n\n  const row = await insertFavoriteDeck(userId\x2C deckHash\x2C savedName\x2C deckData\x2C rawText\x2C primaryAffiliation\x2C validation.dcTotal);\n  if (!row) {\n    await interaction.reply({ content: 'This deck is already saved as a favorite.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  // Update the pending entry to track that it's now a favorite\n  pending._favoriteId = row.id;\n  pending._favoriteName = savedName;\n\n  // Refresh the confirmation message with favorite-aware buttons\n  const favoriteInfo = { saved_name: savedName\x2C id: row.id };\n  try {\n    const text = buildFavoriteConfirmContent(interaction.message.content\x2C favoriteInfo);\n    const buttons = buildFavoriteConfirmButtons(gameId\x2C playerNum\x2C favoriteInfo);\n    await interaction.message.edit({ content: text\x2C components: [buttons] }).catch(discordCatch);\n  } catch { /* non-fatal: buttons may have been removed */ }\n\n  await interaction.reply({ content: `Saved to favorites as **"${savedName}"**.`\x2C ephemeral: true }).catch(discordCatch);\n}\n\n/** Remove Favorite button (setup flow) */\nexport async function handleFavRemove(interaction\x2C ctx) {\n  if (!isFavoritesAvailable()) {\n    await interaction.reply({ content: UNAVAILABLE_MSG\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { getGame\x2C pendingSquadConfirm\x2C PENDING_ILLEGAL_TTL_MS } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'fav_remove_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner of this hand can remove favorites.')) return;\n\n  const key = `${gameId}_${playerNum}`;\n  const pending = pendingSquadConfirm.get(key);\n  if (!pending || (Date.now() - pending.timestamp > PENDING_ILLEGAL_TTL_MS)) {\n    await interaction.reply({ content: 'This squad confirmation has expired. Please submit your squad again.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const squad = pending.squad;\n  const deckHash = computeDeckHash(squad);\n  const userId = interaction.user.id;\n  const existing = await getFavoriteDeckByHash(userId\x2C deckHash);\n  if (!existing) {\n    await interaction.reply({ content: 'This deck is not in your favorites.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  await deleteFavoriteDeck(userId\x2C existing.id);\n  delete pending._favoriteId;\n  delete pending._favoriteName;\n\n  // Refresh: swap back to Save to Favorites\n  try {\n    // Strip the \u2605 favorite indicator from the content\n    const content = interaction.message.content.replace(/^\u2605 \\*\\*Saved favorite:\\*\\* "[^"]*"\\n\\n/\x2C '');\n    const buttons = buildFavoriteConfirmButtons(gameId\x2C playerNum\x2C null);\n    await interaction.message.edit({ content\x2C components: [buttons] }).catch(discordCatch);\n  } catch { /* non-fatal */ }\n\n  await interaction.reply({ content: 'Removed from favorites.'\x2C ephemeral: true }).catch(discordCatch);\n}\n\n/** Rename Favorite button (setup flow) \u2192 show rename modal */\nexport async function handleFavRename(interaction\x2C ctx) {\n  if (!isFavoritesAvailable()) {\n    await interaction.reply({ content: UNAVAILABLE_MSG\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { getGame\x2C pendingSquadConfirm\x2C PENDING_ILLEGAL_TTL_MS } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'fav_rename_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner of this hand can rename favorites.')) return;\n\n  const key = `${gameId}_${playerNum}`;\n  const pending = pendingSquadConfirm.get(key);\n  if (!pending || (Date.now() - pending.timestamp > PENDING_ILLEGAL_TTL_MS)) {\n    await interaction.reply({ content: 'This squad confirmation has expired. Please submit your squad again.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const squad = pending.squad;\n  const deckHash = computeDeckHash(squad);\n  const userId = interaction.user.id;\n  const existing = await getFavoriteDeckByHash(userId\x2C deckHash);\n  if (!existing) {\n    await interaction.reply({ content: 'This deck is not in your favorites.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const modal = new ModalBuilder()\n    .setCustomId(`fav_rename_modal_${gameId}_${playerNum}`)\n    .setTitle('Rename Favorite');\n  modal.addComponents(\n    new ActionRowBuilder().addComponents(\n      new TextInputBuilder()\n        .setCustomId('fav_deck_name')\n        .setLabel('New Favorite Name')\n        .setStyle(TextInputStyle.Short)\n        .setValue(existing.saved_name)\n        .setRequired(true)\n        .setMaxLength(100)\n    )\x2C\n  );\n  await interaction.showModal(modal);\n}\n\n/** Rename Favorite modal submit (setup flow) */\nexport async function handleFavRenameModal(interaction\x2C ctx) {\n  if (!isFavoritesAvailable()) {\n    await interaction.reply({ content: UNAVAILABLE_MSG\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { getGame\x2C pendingSquadConfirm\x2C PENDING_ILLEGAL_TTL_MS } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'fav_rename_modal_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId\x2C { useReply: true });\n  if (!game) return;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner of this hand can rename favorites.'\x2C { useReply: true })) return;\n\n  const key = `${gameId}_${playerNum}`;\n  const pending = pendingSquadConfirm.get(key);\n  if (!pending) {\n    await interaction.reply({ content: 'This squad confirmation has expired.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const newName = interaction.fields.getTextInputValue('fav_deck_name').trim();\n  if (!newName) {\n    await interaction.reply({ content: 'Favorite name cannot be empty.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const squad = pending.squad;\n  const deckHash = computeDeckHash(squad);\n  const userId = interaction.user.id;\n  const existing = await getFavoriteDeckByHash(userId\x2C deckHash);\n  if (!existing) {\n    await interaction.reply({ content: 'This deck is not in your favorites.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  await renameFavoriteDeck(userId\x2C existing.id\x2C newName);\n  pending._favoriteName = newName;\n\n  // Refresh the confirmation message\n  try {\n    const baseContent = interaction.message.content.replace(/^\u2605 \\*\\*Saved favorite:\\*\\* "[^"]*"\\n\\n/\x2C '');\n    const favoriteInfo = { saved_name: newName\x2C id: existing.id };\n    const text = buildFavoriteConfirmContent(baseContent\x2C favoriteInfo);\n    const buttons = buildFavoriteConfirmButtons(gameId\x2C playerNum\x2C favoriteInfo);\n    await interaction.message.edit({ content: text\x2C components: [buttons] }).catch(discordCatch);\n  } catch { /* non-fatal */ }\n\n  await interaction.reply({ content: `Favorite renamed to **"${newName}"**.`\x2C ephemeral: true }).catch(discordCatch);\n}\n\n// \u2500\u2500 Choose from Favorites (setup flow) \u2500\u2500\n\n/** Choose from Favorites button \u2192 show select menu */\nexport async function handleFavChoose(interaction\x2C ctx) {\n  if (!isFavoritesAvailable()) {\n    await interaction.reply({ content: UNAVAILABLE_MSG\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { getGame } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'fav_choose_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner of this hand can choose favorites.')) return;\n\n  if (!game.mapSelected) {\n    await interaction.reply({ content: 'Map selection must be completed before you can select your squad.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const userId = interaction.user.id;\n  const favorites = await getFavoriteDecks(userId);\n  if (favorites === null) {\n    await interaction.reply({ content: UNAVAILABLE_MSG\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (favorites.length === 0) {\n    await interaction.reply({ content: 'You don\\'t have any saved favorites yet. Submit a squad list first\x2C then use **Save to Favorites** to save it.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const options = favorites.slice(0\x2C MAX_SELECT_OPTIONS).map((fav) => {\n    const desc = [fav.affiliation\x2C fav.point_total != null ? `${fav.point_total}pt` : null\x2C fav.use_count ? `used ${fav.use_count}x` : null]\n      .filter(Boolean).join(' \xb7 ');\n    return new StringSelectMenuOptionBuilder()\n      .setLabel(truncateLabel(fav.saved_name\x2C 100))\n      .setDescription(truncateDescription(desc))\n      .setValue(String(fav.id));\n  });\n\n  const select = new StringSelectMenuBuilder()\n    .setCustomId(`fav_choose_select_${gameId}_${playerNum}`)\n    .setPlaceholder('Select a saved favorite')\n    .addOptions(options);\n\n  await interaction.reply({\n    content: '**Choose from Favorites**\\nSelect a saved deck to load.'\x2C\n    components: [new ActionRowBuilder().addComponents(select)]\x2C\n    ephemeral: true\x2C\n  }).catch(discordCatch);\n}\n\n/** Choose from Favorites select \u2192 load deck into confirmation flow */\nexport async function handleFavChooseSelect(interaction\x2C ctx) {\n  if (!isFavoritesAvailable()) {\n    await interaction.reply({ content: UNAVAILABLE_MSG\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { getGame\x2C validateDeckLegal\x2C sendSquadConfirmation } = ctx;\n  const parts = splitCustomId(interaction.customId\x2C 'fav_choose_select_');\n  const gameId = parts[0];\n  const playerNum = parseInt(parts[1]\x2C 10);\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n  if (!await requirePlayer(interaction\x2C game\x2C interaction.user.id\x2C playerNum\x2C canActAsPlayer\x2C 'Only the owner of this hand can choose favorites.')) return;\n\n  const userId = interaction.user.id;\n  const favoriteId = parseInt(interaction.values[0]\x2C 10);\n  const fav = await getFavoriteDeckById(userId\x2C favoriteId);\n  if (!fav) {\n    await interaction.reply({ content: 'Favorite not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  // Reconstruct squad from deck_data\x2C using saved_name as the squad name\n  const deckData = typeof fav.deck_data === 'string' ? JSON.parse(fav.deck_data) : fav.deck_data;\n  const squad = {\n    name: fav.saved_name\x2C\n    dcList: deckData.dcList || []\x2C\n    ccList: deckData.ccList || []\x2C\n    dcCount: deckData.dcCount ?? deckData.dcList?.length ?? 0\x2C\n    ccCount: deckData.ccCount ?? deckData.ccList?.length ?? 0\x2C\n  };\n\n  // Re-normalize and re-validate against current card data\n  normalizeSquadInput(squad);\n  const validation = validateDeckLegal(squad);\n  const isP1 = playerNum === 1;\n\n  // Bump usage stats\n  await touchFavoriteDeckUsage(userId\x2C favoriteId);\n\n  // Feed into the standard confirmation flow\n  await sendSquadConfirmation(game\x2C isP1\x2C squad\x2C validation\x2C interaction.client);\n\n  // Clean up the select menu message\n  try {\n    await interaction.update({ content: `Loading **"${fav.saved_name}"**\u2026`\x2C components: [] }).catch(discordCatch);\n  } catch {\n    await interaction.deferUpdate().catch(discordCatch);\n  }\n}\n\n// \u2500\u2500 /favorites list management handlers \u2500\u2500\n\n/**\n * Build the /favorites list view (select menu + summary).\n * @param {Array} favorites - rows from getFavoriteDecks\n * @returns {{ content: string\x2C components: ActionRowBuilder[] }}\n */\nexport function buildFavoritesListPayload(favorites) {\n  if (!favorites || favorites.length === 0) {\n    return {\n      content: 'You don\\'t have any saved favorites yet.\\nSave a deck during game setup to add one here.'\x2C\n      components: []\x2C\n    };\n  }\n\n  const options = favorites.slice(0\x2C MAX_SELECT_OPTIONS).map((fav) => {\n    const desc = [fav.affiliation\x2C fav.point_total != null ? `${fav.point_total}pt` : null\x2C fav.use_count ? `used ${fav.use_count}x` : null]\n      .filter(Boolean).join(' \xb7 ');\n    return new StringSelectMenuOptionBuilder()\n      .setLabel(truncateLabel(fav.saved_name\x2C 100))\n      .setDescription(truncateDescription(desc || 'Saved deck'))\n      .setValue(String(fav.id));\n  });\n\n  const select = new StringSelectMenuBuilder()\n    .setCustomId('fav_list_select_')\n    .setPlaceholder('Select a favorite to view')\n    .addOptions(options);\n\n  let content = `**Your Saved Favorites** (${favorites.length} deck${favorites.length !== 1 ? 's' : ''})`;\n  if (favorites.length > MAX_SELECT_OPTIONS) {\n    content += `\\n*Showing ${MAX_SELECT_OPTIONS} most recently used.*`;\n  }\n\n  return {\n    content\x2C\n    components: [new ActionRowBuilder().addComponents(select)]\x2C\n  };\n}\n\n/**\n * Build the /favorites detail view for a single favorite.\n * @param {object} fav - row from getFavoriteDeckById\n * @param {object} deps - { buildSquadConfirmText\x2C validateDeckLegal }\n * @returns {{ content: string\x2C components: ActionRowBuilder[] }}\n */\nexport function buildFavoriteDetailPayload(fav\x2C deps) {\n  const deckData = typeof fav.deck_data === 'string' ? JSON.parse(fav.deck_data) : fav.deck_data;\n  const squad = {\n    name: fav.saved_name\x2C\n    dcList: deckData.dcList || []\x2C\n    ccList: deckData.ccList || []\x2C\n    dcCount: deckData.dcCount ?? deckData.dcList?.length ?? 0\x2C\n    ccCount: deckData.ccCount ?? deckData.ccList?.length ?? 0\x2C\n  };\n\n  normalizeSquadInput(squad);\n  const validation = deps.validateDeckLegal(squad);\n  const deckText = deps.buildSquadConfirmText(squad\x2C validation);\n\n  const affLine = fav.affiliation ? ` (${fav.affiliation}\x2C ${fav.point_total ?? '?'}pt)` : '';\n  const usageParts = [];\n  if (fav.created_at) usageParts.push(`Saved: ${new Date(fav.created_at).toLocaleDateString()}`);\n  if (fav.last_used_at) usageParts.push(`Last used: ${new Date(fav.last_used_at).toLocaleDateString()}`);\n  if (fav.use_count) usageParts.push(`Used ${fav.use_count} time${fav.use_count !== 1 ? 's' : ''}`);\n  const usageLine = usageParts.length ? `\\n*${usageParts.join(' \xb7 ')}*` : '';\n\n  const content = `\u2605 **${fav.saved_name}**${affLine}\\n\\n${deckText}${usageLine}`;\n\n  const row = new ActionRowBuilder().addComponents(\n    new ButtonBuilder()\n      .setCustomId(`fav_list_rename_${fav.id}`)\n      .setLabel('Rename Favorite')\n      .setStyle(ButtonStyle.Secondary)\x2C\n    new ButtonBuilder()\n      .setCustomId(`fav_list_remove_${fav.id}`)\n      .setLabel('Remove Favorite')\n      .setStyle(ButtonStyle.Danger)\x2C\n    new ButtonBuilder()\n      .setCustomId('fav_list_back_')\n      .setLabel('Back to List')\n      .setStyle(ButtonStyle.Secondary)\x2C\n  );\n\n  return { content\x2C components: [row] };\n}\n\n/** /favorites select menu \u2192 show detail view */\nexport async function handleFavListSelect(interaction\x2C ctx) {\n  if (!isFavoritesAvailable()) {\n    await interaction.reply({ content: UNAVAILABLE_MSG\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const userId = interaction.user.id;\n  const favoriteId = parseInt(interaction.values[0]\x2C 10);\n  const fav = await getFavoriteDeckById(userId\x2C favoriteId);\n  if (!fav) {\n    await interaction.reply({ content: 'Favorite not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const { validateDeckLegal\x2C buildSquadConfirmText } = ctx;\n  const payload = buildFavoriteDetailPayload(fav\x2C { validateDeckLegal\x2C buildSquadConfirmText });\n  await interaction.update(payload).catch(discordCatch);\n}\n\n/** /favorites rename button \u2192 show modal */\nexport async function handleFavListRename(interaction) {\n  if (!isFavoritesAvailable()) {\n    await interaction.reply({ content: UNAVAILABLE_MSG\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const favoriteId = splitCustomId(interaction.customId\x2C 'fav_list_rename_')[0];\n  const userId = interaction.user.id;\n  const fav = await getFavoriteDeckById(userId\x2C parseInt(favoriteId\x2C 10));\n  if (!fav) {\n    await interaction.reply({ content: 'Favorite not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const modal = new ModalBuilder()\n    .setCustomId(`fav_list_rename_modal_${favoriteId}`)\n    .setTitle('Rename Favorite');\n  modal.addComponents(\n    new ActionRowBuilder().addComponents(\n      new TextInputBuilder()\n        .setCustomId('fav_deck_name')\n        .setLabel('New Favorite Name')\n        .setStyle(TextInputStyle.Short)\n        .setValue(fav.saved_name)\n        .setRequired(true)\n        .setMaxLength(100)\n    )\x2C\n  );\n  await interaction.showModal(modal);\n}\n\n/** /favorites rename modal submit */\nexport async function handleFavListRenameModal(interaction\x2C ctx) {\n  if (!isFavoritesAvailable()) {\n    await interaction.reply({ content: UNAVAILABLE_MSG\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const favoriteId = parseInt(splitCustomId(interaction.customId\x2C 'fav_list_rename_modal_')[0]\x2C 10);\n  const userId = interaction.user.id;\n  const fav = await getFavoriteDeckById(userId\x2C favoriteId);\n  if (!fav) {\n    await interaction.reply({ content: 'Favorite not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const newName = interaction.fields.getTextInputValue('fav_deck_name').trim();\n  if (!newName) {\n    await interaction.reply({ content: 'Favorite name cannot be empty.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  await renameFavoriteDeck(userId\x2C favoriteId\x2C newName);\n\n  // Refresh detail view\n  const { validateDeckLegal\x2C buildSquadConfirmText } = ctx;\n  const updated = await getFavoriteDeckById(userId\x2C favoriteId);\n  if (updated) {\n    const payload = buildFavoriteDetailPayload(updated\x2C { validateDeckLegal\x2C buildSquadConfirmText });\n    try {\n      await interaction.message.edit(payload).catch(discordCatch);\n    } catch { /* non-fatal */ }\n  }\n  await interaction.reply({ content: `Favorite renamed to **"${newName}"**.`\x2C ephemeral: true }).catch(discordCatch);\n}\n\n/** /favorites remove button */\nexport async function handleFavListRemove(interaction\x2C ctx) {\n  if (!isFavoritesAvailable()) {\n    await interaction.reply({ content: UNAVAILABLE_MSG\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const favoriteId = parseInt(splitCustomId(interaction.customId\x2C 'fav_list_remove_')[0]\x2C 10);\n  const userId = interaction.user.id;\n  const fav = await getFavoriteDeckById(userId\x2C favoriteId);\n  if (!fav) {\n    await interaction.reply({ content: 'Favorite not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  await deleteFavoriteDeck(userId\x2C favoriteId);\n\n  // Refresh: go back to list view\n  const favorites = await getFavoriteDecks(userId);\n  const payload = buildFavoritesListPayload(favorites || []);\n  try {\n    await interaction.update(payload).catch(discordCatch);\n  } catch {\n    await interaction.reply({ ...payload\x2C ephemeral: true }).catch(discordCatch);\n  }\n}\n\n/** /favorites back button \u2192 re-render list view */\nexport async function handleFavListBack(interaction) {\n  if (!isFavoritesAvailable()) {\n    await interaction.reply({ content: UNAVAILABLE_MSG\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const userId = interaction.user.id;\n  const favorites = await getFavoriteDecks(userId);\n  if (favorites === null) {\n    await interaction.reply({ content: UNAVAILABLE_MSG\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const payload = buildFavoritesListPayload(favorites);\n  await interaction.update(payload).catch(discordCatch);\n}\n
