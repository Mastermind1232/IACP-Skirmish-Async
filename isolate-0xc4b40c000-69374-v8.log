script-source,213,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/blitz-deploy.js,/**\n * Blitz deployment handlers \u2014 Lothal-Wastes-A special deployment flow.\n *\n * Blitz rules (from mission card):\n * "Players do not deploy normally. Instead\x2C players alternate deploying groups\x2C\n *  following the rules for passing. When a figure is deployed\x2C it may move up\n *  to 8 spaces."\n *\n * State machine: group_select \u2192 figure_place \u2192 movement \u2192 (next turn or done)\n *\n * Each figure gets 8 MP of standard movement (terrain costs\x2C blocking apply)\n * after being placed. Passing follows standard IA rules: both consecutive\n * passes end deployment.\n */\n\nimport { ActionRowBuilder\x2C ButtonBuilder\x2C ButtonStyle } from 'discord.js';\nimport { fetchGameChannel } from '../discord/channel-helpers.js';\nimport { buildRowPickerButtons\x2C cleanupSpacePick } from '../discord/components.js';\nimport { discordCatch } from '../error-handling.js';\nimport { requireGame } from '../utils/guards.js';\nimport {\n  getPlayerId\x2C getHandChannelId\x2C getInitiativePlayerNum\x2C\n  opponentPlayerNum\x2C getSquad\x2C\n  deployMetadataKey\x2C deployLabelsKey\x2C\n} from '../game/player-helpers.js';\nimport { getDcStats } from '../data-loader.js';\nimport {\n  getBoardStateForMovement\x2C getMovementProfile\x2C computeMovementCache\x2C\n} from '../game/movement.js';\nimport { normalizeCoord } from '../game/coords.js';\n\nconst BLITZ_MP = 8;\n\n// \u2500\u2500 Detection \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nexport function isBlitzMission(game) {\n  return game.selectedMission?.name === 'Blitz';\n}\n\n// \u2500\u2500 State initialization \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nexport function initBlitzDeployment(game) {\n  const initiativePlayerNum = getInitiativePlayerNum(game);\n  game.blitzDeployment = {\n    phase: 'group_select'\x2C\n    currentPlayerNum: initiativePlayerNum\x2C\n    consecutivePasses: 0\x2C\n    deployedGroups: { 1: []\x2C 2: [] }\x2C\n    activeGroup: null\x2C\n    pendingMovement: null\x2C\n    uiMessageIds: { 1: []\x2C 2: [] }\x2C\n  };\n}\n\n// \u2500\u2500 Deploy label helpers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/**\n * Ensure deploy labels/metadata exist for a player. Normally computed during\n * _sendInitiativeDeployButtons\x2C but Blitz needs them for both players upfront.\n */\nfunction ensureDeployLabels(game\x2C playerNum\x2C ctx) {\n  if (game[deployLabelsKey(playerNum)]) return;\n  const squad = getSquad(game\x2C playerNum);\n  const dcList = squad?.dcList || [];\n  const { labels\x2C metadata } = ctx.getDeployFigureLabels(dcList\x2C game);\n  game[deployLabelsKey(playerNum)] = labels;\n  game[deployMetadataKey(playerNum)] = metadata;\n}\n\n// \u2500\u2500 Group utilities \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/** Get deployment groups for a player from stored deploy metadata. */\nfunction getDeployGroups(game\x2C playerNum) {\n  const metadata = game[deployMetadataKey(playerNum)] || [];\n  const labels = game[deployLabelsKey(playerNum)] || [];\n  const groups = [];\n  const seen = new Map();\n\n  for (let i = 0; i < metadata.length; i++) {\n    const meta = metadata[i];\n    const key = `${meta.dcName}|${meta.dgIndex}`;\n    if (!seen.has(key)) {\n      seen.set(key\x2C groups.length);\n      const stats = getDcStats(meta.dcName);\n      groups.push({\n        dcName: meta.dcName\x2C\n        dgIndex: meta.dgIndex\x2C\n        figures: stats?.figures ?? 1\x2C\n        flatIndices: [i]\x2C\n        figureKeys: [`${meta.dcName}-${meta.dgIndex}-${meta.figureIndex}`]\x2C\n      });\n    } else {\n      const gi = seen.get(key);\n      groups[gi].flatIndices.push(i);\n      groups[gi].figureKeys.push(`${meta.dcName}-${meta.dgIndex}-${meta.figureIndex}`);\n    }\n  }\n  return groups;\n}\n\n/** Check if a group's figures all have positions. */\nfunction isGroupFullyDeployed(game\x2C playerNum\x2C group) {\n  const pos = game.figurePositions?.[playerNum] || {};\n  return group.figureKeys.every(fk => pos[fk]);\n}\n\n/** Get groups that haven't been fully placed yet. */\nfunction getUndeployedGroups(game\x2C playerNum) {\n  return getDeployGroups(game\x2C playerNum).filter(\n    g => !isGroupFullyDeployed(game\x2C playerNum\x2C g)\n  );\n}\n\n// \u2500\u2500 UI cleanup \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function cleanupBlitzMessages(game\x2C playerNum\x2C client) {\n  const ids = game.blitzDeployment?.uiMessageIds?.[playerNum] || [];\n  if (ids.length === 0) return;\n  const handId = getHandChannelId(game\x2C playerNum);\n  try {\n    const ch = await fetchGameChannel(client\x2C handId);\n    for (const msgId of ids) {\n      try { await (await ch.messages.fetch(msgId)).delete(); } catch {}\n    }\n  } catch {}\n  if (game.blitzDeployment?.uiMessageIds) {\n    game.blitzDeployment.uiMessageIds[playerNum] = [];\n  }\n}\n\n// \u2500\u2500 UI: Group selection prompt \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nexport async function sendBlitzTurnPrompt(game\x2C playerNum\x2C ctx) {\n  const { client\x2C saveGames\x2C logGameAction } = ctx;\n  const gameId = game.gameId;\n\n  ensureDeployLabels(game\x2C playerNum\x2C ctx);\n  if (!game.figurePositions) game.figurePositions = { 1: {}\x2C 2: {} };\n\n  const handId = getHandChannelId(game\x2C playerNum);\n  const handChannel = await fetchGameChannel(client\x2C handId);\n  const playerId = getPlayerId(game\x2C playerNum);\n\n  await cleanupBlitzMessages(game\x2C playerNum\x2C client);\n\n  const undeployed = getUndeployedGroups(game\x2C playerNum);\n\n  // If no groups to deploy\x2C auto-pass\n  if (undeployed.length === 0) {\n    await handleAutoPass(game\x2C playerNum\x2C ctx);\n    return;\n  }\n\n  // Build group buttons (index into ALL groups for this player\x2C not just undeployed)\n  const allGroups = getDeployGroups(game\x2C playerNum);\n  const rows = [];\n  for (const g of undeployed) {\n    const groupIndex = allGroups.findIndex(\n      ag => ag.dcName === g.dcName && ag.dgIndex === g.dgIndex\n    );\n    const label = g.figures > 1\n      ? `Deploy ${g.dcName} (${g.figures} figures)`\n      : `Deploy ${g.dcName}`;\n    rows.push(\n      new ActionRowBuilder().addComponents(\n        new ButtonBuilder()\n          .setCustomId(`blitz_group_${gameId}_${playerNum}_${groupIndex}`)\n          .setLabel(label.slice(0\x2C 80))\n          .setStyle(ButtonStyle.Success)\n      )\n    );\n  }\n\n  // Pass button\n  rows.push(\n    new ActionRowBuilder().addComponents(\n      new ButtonBuilder()\n        .setCustomId(`blitz_pass_${gameId}_${playerNum}`)\n        .setLabel('Pass (do not deploy)')\n        .setStyle(ButtonStyle.Secondary)\n    )\n  );\n\n  const deployed = allGroups.length - undeployed.length;\n  const msg = await handChannel.send({\n    content: `<@${playerId}> **Blitz Deployment** \u2014 Your turn. Choose a group to deploy (${deployed}/${allGroups.length} deployed).`\x2C\n    components: rows.slice(0\x2C 5)\x2C\n    allowedMentions: { users: [playerId] }\x2C\n  });\n\n  game.blitzDeployment.uiMessageIds[playerNum] = [msg.id];\n  game.blitzDeployment.phase = 'group_select';\n  if (saveGames) saveGames();\n}\n\n// \u2500\u2500 UI: Group figure deploy buttons \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function sendBlitzGroupDeployButtons(game\x2C playerNum\x2C ctx) {\n  const { client\x2C getDeploymentMapAttachment } = ctx;\n  const gameId = game.gameId;\n  const handId = getHandChannelId(game\x2C playerNum);\n  const handChannel = await fetchGameChannel(client\x2C handId);\n  const playerId = getPlayerId(game\x2C playerNum);\n\n  const initiativePlayerNum = getInitiativePlayerNum(game);\n  const zone = playerNum === initiativePlayerNum\n    ? game.deploymentZoneChosen\n    : (game.deploymentZoneChosen === 'red' ? 'blue' : 'red');\n  const zoneStyle = zone === 'red' ? ButtonStyle.Danger : ButtonStyle.Primary;\n\n  const group = game.blitzDeployment.activeGroup;\n  const labels = game[deployLabelsKey(playerNum)] || [];\n  const positions = game.figurePositions?.[playerNum] || {};\n\n  await cleanupBlitzMessages(game\x2C playerNum\x2C client);\n\n  const deployRows = [];\n  for (let idx = 0; idx < group.flatIndices.length; idx++) {\n    const flatIndex = group.flatIndices[idx];\n    const fk = group.figureKeys[idx];\n    const label = labels[flatIndex] || `Deploy figure ${idx}`;\n    const space = positions[fk];\n    const displaySpace = space ? space.toUpperCase() : '';\n    const btnLabel = space\n      ? `${label} (at ${displaySpace})`.slice(0\x2C 80)\n      : label.slice(0\x2C 80);\n    deployRows.push(\n      new ActionRowBuilder().addComponents(\n        new ButtonBuilder()\n          .setCustomId(`deployment_fig_${gameId}_${playerNum}_${flatIndex}`)\n          .setLabel(btnLabel)\n          .setStyle(space ? ButtonStyle.Secondary : zoneStyle)\n          .setDisabled(!!space)\n      )\n    );\n  }\n\n  const mapAttachment = await getDeploymentMapAttachment(game\x2C zone);\n  const payload = {\n    content: `<@${playerId}> Deploy **${group.dcName}** \u2014 place each figure in the **${zone}** zone:`\x2C\n    components: deployRows.slice(0\x2C 5)\x2C\n    allowedMentions: { users: [playerId] }\x2C\n  };\n  if (mapAttachment) payload.files = [mapAttachment];\n\n  const msg = await handChannel.send(payload);\n  game.blitzDeployment.uiMessageIds[playerNum] = [msg.id];\n}\n\n// \u2500\u2500 UI: Post-deploy movement prompt \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function sendBlitzMovementPrompt(game\x2C playerNum\x2C ctx) {\n  const { client } = ctx;\n  const gameId = game.gameId;\n  const handId = getHandChannelId(game\x2C playerNum);\n  const handChannel = await fetchGameChannel(client\x2C handId);\n  const playerId = getPlayerId(game\x2C playerNum);\n\n  const pending = game.blitzDeployment.pendingMovement;\n  const remaining = pending.figureKeys.filter(fk => !pending.movedKeys.includes(fk));\n\n  if (remaining.length === 0) {\n    await advanceBlitzTurn(game\x2C ctx);\n    return;\n  }\n\n  await cleanupBlitzMessages(game\x2C playerNum\x2C client);\n\n  const rows = [];\n  for (let i = 0; i < pending.figureKeys.length; i++) {\n    const fk = pending.figureKeys[i];\n    if (pending.movedKeys.includes(fk)) continue;\n    const dcName = fk.replace(/-\\d+-\\d+$/\x2C '');\n    const pos = game.figurePositions?.[playerNum]?.[fk] || '?';\n    rows.push(\n      new ActionRowBuilder().addComponents(\n        new ButtonBuilder()\n          .setCustomId(`blitz_move_fig_${gameId}_${i}`)\n          .setLabel(`Move ${dcName} (at ${pos.toUpperCase()}) \u2014 ${BLITZ_MP} MP`.slice(0\x2C 80))\n          .setStyle(ButtonStyle.Primary)\n      )\n    );\n  }\n\n  rows.push(\n    new ActionRowBuilder().addComponents(\n      new ButtonBuilder()\n        .setCustomId(`blitz_move_done_${gameId}`)\n        .setLabel('Skip Remaining Movement')\n        .setStyle(ButtonStyle.Secondary)\n    )\n  );\n\n  const msg = await handChannel.send({\n    content: `<@${playerId}> **Blitz Movement** \u2014 Each deployed figure may move up to **${BLITZ_MP} spaces**. Select a figure to move\x2C or skip.`\x2C\n    components: rows.slice(0\x2C 5)\x2C\n    allowedMentions: { users: [playerId] }\x2C\n  });\n\n  game.blitzDeployment.uiMessageIds[playerNum] = [msg.id];\n}\n\n// \u2500\u2500 Handler: Group select \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nexport async function handleBlitzGroupSelect(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n\n  const m = interaction.customId.match(/^blitz_group_(\\w+)_(\\d+)_(\\d+)$/);\n  if (!m) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C gameId\x2C playerNumStr\x2C groupIndexStr] = m;\n  const playerNum = parseInt(playerNumStr\x2C 10);\n  const groupIndex = parseInt(groupIndexStr\x2C 10);\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game?.blitzDeployment) return;\n\n  if (game.blitzDeployment.currentPlayerNum !== playerNum) {\n    await interaction.followUp({ content: "It's not your turn to deploy."\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (interaction.user.id !== getPlayerId(game\x2C playerNum)) {\n    await interaction.followUp({ content: 'Only the owning player can deploy.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const groups = getDeployGroups(game\x2C playerNum);\n  const group = groups[groupIndex];\n  if (!group) {\n    await interaction.followUp({ content: 'Group not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (isGroupFullyDeployed(game\x2C playerNum\x2C group)) {\n    await interaction.followUp({ content: 'This group is already deployed.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  game.blitzDeployment.activeGroup = {\n    dcName: group.dcName\x2C\n    dgIndex: group.dgIndex\x2C\n    figures: group.figures\x2C\n    figureKeys: [...group.figureKeys]\x2C\n    flatIndices: [...group.flatIndices]\x2C\n  };\n  game.blitzDeployment.phase = 'figure_place';\n\n  await cleanupBlitzMessages(game\x2C playerNum\x2C client);\n  await logGameAction(game\x2C client\x2C `<@${interaction.user.id}> selected **${group.dcName}** to deploy (Blitz)`\x2C { allowedMentions: { users: [interaction.user.id] }\x2C phase: 'DEPLOYMENT'\x2C icon: 'deploy' });\n  await sendBlitzGroupDeployButtons(game\x2C playerNum\x2C ctx);\n  saveGames();\n}\n\n// \u2500\u2500 Handler: Pass \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nexport async function handleBlitzPass(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n\n  const m = interaction.customId.match(/^blitz_pass_(\\w+)_(\\d+)$/);\n  if (!m) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C gameId\x2C playerNumStr] = m;\n  const playerNum = parseInt(playerNumStr\x2C 10);\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game?.blitzDeployment) return;\n\n  if (game.blitzDeployment.currentPlayerNum !== playerNum) {\n    await interaction.followUp({ content: "It's not your turn."\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (interaction.user.id !== getPlayerId(game\x2C playerNum)) {\n    await interaction.followUp({ content: 'Only the owning player can pass.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  await cleanupBlitzMessages(game\x2C playerNum\x2C client);\n  await logGameAction(game\x2C client\x2C `<@${interaction.user.id}> passed (Blitz deployment)`\x2C { allowedMentions: { users: [interaction.user.id] }\x2C phase: 'DEPLOYMENT'\x2C icon: 'deploy' });\n\n  game.blitzDeployment.consecutivePasses++;\n\n  if (game.blitzDeployment.consecutivePasses >= 2) {\n    await endBlitzDeployment(game\x2C ctx);\n  } else {\n    // Switch to other player\n    const nextPlayerNum = opponentPlayerNum(playerNum);\n    game.blitzDeployment.currentPlayerNum = nextPlayerNum;\n    await sendBlitzTurnPrompt(game\x2C nextPlayerNum\x2C ctx);\n  }\n  saveGames();\n}\n\n/** Auto-pass when a player has no undeployed groups. */\nasync function handleAutoPass(game\x2C playerNum\x2C ctx) {\n  const { client\x2C logGameAction\x2C saveGames } = ctx;\n\n  await logGameAction(game\x2C client\x2C `Player ${playerNum} auto-passed (no groups left to deploy\x2C Blitz)`\x2C { phase: 'DEPLOYMENT'\x2C icon: 'deploy' });\n\n  game.blitzDeployment.consecutivePasses++;\n\n  if (game.blitzDeployment.consecutivePasses >= 2) {\n    await endBlitzDeployment(game\x2C ctx);\n  } else {\n    const nextPlayerNum = opponentPlayerNum(playerNum);\n    game.blitzDeployment.currentPlayerNum = nextPlayerNum;\n    await sendBlitzTurnPrompt(game\x2C nextPlayerNum\x2C ctx);\n  }\n  if (saveGames) saveGames();\n}\n\n// \u2500\u2500 Handler: Move figure select \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nexport async function handleBlitzMoveFig(interaction\x2C ctx) {\n  const { getGame\x2C client\x2C saveGames } = ctx;\n\n  const m = interaction.customId.match(/^blitz_move_fig_(\\w+)_(\\d+)$/);\n  if (!m) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C gameId\x2C figureIndexStr] = m;\n  const figureIndex = parseInt(figureIndexStr\x2C 10);\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game?.blitzDeployment?.pendingMovement) {\n    await interaction.followUp({ content: 'No pending Blitz movement.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const blitz = game.blitzDeployment;\n  const playerNum = blitz.pendingMovement.playerNum;\n  if (interaction.user.id !== getPlayerId(game\x2C playerNum)) {\n    await interaction.followUp({ content: 'Only the deploying player can move figures.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const figureKey = blitz.pendingMovement.figureKeys[figureIndex];\n  if (!figureKey) {\n    await interaction.followUp({ content: 'Figure not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  if (blitz.pendingMovement.movedKeys.includes(figureKey)) {\n    await interaction.followUp({ content: 'This figure has already moved.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const startCoord = game.figurePositions?.[playerNum]?.[figureKey];\n  if (!startCoord) {\n    await interaction.followUp({ content: 'Figure has no position.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  // Compute reachable spaces (8 MP\x2C standard movement rules)\n  const dcName = figureKey.replace(/-\\d+-\\d+$/\x2C '');\n  const board = getBoardStateForMovement(game\x2C figureKey);\n  const profile = getMovementProfile(dcName\x2C figureKey\x2C game);\n  const cache = computeMovementCache(normalizeCoord(startCoord)\x2C BLITZ_MP\x2C board\x2C profile);\n\n  const reachable = [];\n  for (const [coord\x2C info] of cache.cells) {\n    reachable.push(coord);\n  }\n\n  if (reachable.length === 0) {\n    await interaction.followUp({ content: `No reachable spaces for **${dcName}** (surrounded by blocking terrain or figures). Figure stays at **${startCoord.toUpperCase()}**.`\x2C ephemeral: true }).catch(discordCatch);\n    // Mark as moved (nowhere to go)\n    blitz.pendingMovement.movedKeys.push(figureKey);\n    await sendBlitzMovementPrompt(game\x2C playerNum\x2C ctx);\n    saveGames();\n    return;\n  }\n\n  // Set up generic space picker\n  const contextKey = `${gameId}_blitzmv`;\n  game.pendingSpacePick = game.pendingSpacePick || {};\n  game.pendingSpacePick[contextKey] = {\n    validSpaces: reachable\x2C\n    cellPrefix: `blitz_move_pick_${gameId}_${figureIndex}_`\x2C\n    mapSpaces: board.mapSpaces\x2C\n    headerText: `**Blitz Move** \u2014 ${dcName} from ${startCoord.toUpperCase()} (${BLITZ_MP} MP)`\x2C\n    actionButtons: [\n      { customId: `blitz_move_done_${gameId}`\x2C label: 'Skip Remaining Movement'\x2C style: ButtonStyle.Secondary }\x2C\n    ]\x2C\n  };\n\n  const { rows: rowBtns } = buildRowPickerButtons(reachable\x2C `space_row_${contextKey}_`);\n\n  await cleanupBlitzMessages(game\x2C playerNum\x2C client);\n\n  const handId = getHandChannelId(game\x2C playerNum);\n  const handChannel = await fetchGameChannel(client\x2C handId);\n  const skipBtn = new ActionRowBuilder().addComponents(\n    new ButtonBuilder()\n      .setCustomId(`blitz_move_done_${gameId}`)\n      .setLabel('Skip Remaining Movement')\n      .setStyle(ButtonStyle.Secondary)\n  );\n\n  const msg = await handChannel.send({\n    content: `**Blitz Move** \u2014 ${dcName} from **${startCoord.toUpperCase()}** (${BLITZ_MP} MP):\\nChoose a row:`\x2C\n    components: [...rowBtns.slice(0\x2C 4)\x2C skipBtn]\x2C\n  });\n\n  blitz.uiMessageIds[playerNum] = [msg.id];\n  saveGames();\n}\n\n// \u2500\u2500 Handler: Move pick (destination selected) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nexport async function handleBlitzMovePick(interaction\x2C ctx) {\n  const { getGame\x2C client\x2C saveGames\x2C logGameAction\x2C buildBoardMapPayload } = ctx;\n\n  // Parse: blitz_move_pick_{gameId}_{figureIndex}_{coord}\n  const m = interaction.customId.match(/^blitz_move_pick_(\\w+)_(\\d+)_(.+)$/);\n  if (!m) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C gameId\x2C figureIndexStr\x2C coord] = m;\n  const figureIndex = parseInt(figureIndexStr\x2C 10);\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game?.blitzDeployment?.pendingMovement) {\n    await interaction.followUp({ content: 'No pending Blitz movement.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const blitz = game.blitzDeployment;\n  const playerNum = blitz.pendingMovement.playerNum;\n  if (interaction.user.id !== getPlayerId(game\x2C playerNum)) {\n    await interaction.followUp({ content: 'Only the deploying player can move figures.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const figureKey = blitz.pendingMovement.figureKeys[figureIndex];\n  if (!figureKey) {\n    await interaction.followUp({ content: 'Figure not found.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  // Validate the destination is in the valid spaces\n  const contextKey = `${gameId}_blitzmv`;\n  const pending = game.pendingSpacePick?.[contextKey];\n  const normalDest = normalizeCoord(coord);\n  if (pending && !pending.validSpaces.includes(normalDest)) {\n    await interaction.followUp({ content: 'Invalid destination.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  // Move the figure\n  const oldPos = game.figurePositions[playerNum][figureKey];\n  game.figurePositions[playerNum][figureKey] = normalDest;\n\n  // Clean up space picker\n  cleanupSpacePick(game\x2C contextKey);\n\n  // Mark as moved\n  blitz.pendingMovement.movedKeys.push(figureKey);\n\n  const dcName = figureKey.replace(/-\\d+-\\d+$/\x2C '');\n  await logGameAction(game\x2C client\x2C\n    `**${dcName}** moved from **${(oldPos || '?').toUpperCase()}** to **${normalDest.toUpperCase()}** (Blitz deployment\x2C ${BLITZ_MP} MP)`\x2C\n    { phase: 'DEPLOYMENT'\x2C icon: 'move' });\n\n  // Update board map\n  if (game.boardId && game.selectedMap) {\n    try {\n      const boardChannel = await fetchGameChannel(client\x2C game.boardId);\n      const payload = await buildBoardMapPayload(game.gameId\x2C game.selectedMap\x2C game);\n      await boardChannel.send(payload);\n    } catch (err) {\n      console.error('Failed to update map after Blitz move:'\x2C err);\n    }\n  }\n\n  // Continue with remaining movement or advance turn\n  await sendBlitzMovementPrompt(game\x2C playerNum\x2C ctx);\n  saveGames();\n}\n\n// \u2500\u2500 Handler: Skip remaining movement \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nexport async function handleBlitzMoveDone(interaction\x2C ctx) {\n  const { getGame\x2C client\x2C saveGames\x2C logGameAction } = ctx;\n\n  const m = interaction.customId.match(/^blitz_move_done_(\\w+)$/);\n  if (!m) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C gameId] = m;\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game?.blitzDeployment) {\n    await interaction.followUp({ content: 'No active Blitz deployment.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const blitz = game.blitzDeployment;\n  // Determine which player triggered this\n  const playerNum = blitz.pendingMovement?.playerNum || blitz.currentPlayerNum;\n  if (interaction.user.id !== getPlayerId(game\x2C playerNum)) {\n    await interaction.followUp({ content: 'Only the deploying player can skip movement.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  // Clean up space picker if active\n  const contextKey = `${gameId}_blitzmv`;\n  cleanupSpacePick(game\x2C contextKey);\n\n  await cleanupBlitzMessages(game\x2C playerNum\x2C client);\n  await logGameAction(game\x2C client\x2C `<@${interaction.user.id}> skipped remaining Blitz movement`\x2C { allowedMentions: { users: [interaction.user.id] }\x2C phase: 'DEPLOYMENT'\x2C icon: 'move' });\n\n  await advanceBlitzTurn(game\x2C ctx);\n  saveGames();\n}\n\n// \u2500\u2500 Blitz group completion check (called from handleDeployPick) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nexport async function checkBlitzGroupComplete(game\x2C playerNum\x2C interaction\x2C ctx) {\n  const blitz = game.blitzDeployment;\n  if (!blitz?.activeGroup) return;\n\n  // Don't proceed if loadout/form selection is pending\n  if (game.pendingLoadoutSelection?.playerNum === playerNum) return;\n\n  const positions = game.figurePositions?.[playerNum] || {};\n  const allPlaced = blitz.activeGroup.figureKeys.every(fk => positions[fk]);\n\n  if (!allPlaced) {\n    // Not all placed \u2014 refresh group deploy buttons\n    await sendBlitzGroupDeployButtons(game\x2C playerNum\x2C ctx);\n    ctx.saveGames();\n    return;\n  }\n\n  // All placed \u2014 mark group as deployed\n  blitz.deployedGroups[playerNum].push(`${blitz.activeGroup.dcName}|${blitz.activeGroup.dgIndex}`);\n  blitz.consecutivePasses = 0;\n\n  const groupDcName = blitz.activeGroup.dcName;\n  const groupFigureKeys = [...blitz.activeGroup.figureKeys];\n\n  // Transition to movement phase\n  blitz.phase = 'movement';\n  blitz.pendingMovement = {\n    figureKeys: groupFigureKeys\x2C\n    movedKeys: []\x2C\n    playerNum\x2C\n  };\n  blitz.activeGroup = null;\n\n  await cleanupBlitzMessages(game\x2C playerNum\x2C ctx.client);\n\n  await ctx.logGameAction(game\x2C ctx.client\x2C\n    `**${groupDcName}** fully deployed (Blitz). Each figure may move up to ${BLITZ_MP} spaces.`\x2C\n    { phase: 'DEPLOYMENT'\x2C icon: 'deploy' });\n\n  await sendBlitzMovementPrompt(game\x2C playerNum\x2C ctx);\n  ctx.saveGames();\n}\n\n// \u2500\u2500 Turn management \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nasync function advanceBlitzTurn(game\x2C ctx) {\n  const { client\x2C logGameAction } = ctx;\n  const blitz = game.blitzDeployment;\n\n  // Clean up current player's UI\n  const currentPN = blitz.currentPlayerNum;\n  await cleanupBlitzMessages(game\x2C currentPN\x2C client);\n\n  // Clear movement state\n  blitz.pendingMovement = null;\n  blitz.activeGroup = null;\n\n  // Check if both players have deployed all groups\n  const p1Undeployed = getUndeployedGroups(game\x2C 1);\n  const p2Undeployed = getUndeployedGroups(game\x2C 2);\n  if (p1Undeployed.length === 0 && p2Undeployed.length === 0) {\n    await endBlitzDeployment(game\x2C ctx);\n    return;\n  }\n\n  // Switch to other player\n  const nextPN = opponentPlayerNum(currentPN);\n  blitz.currentPlayerNum = nextPN;\n  blitz.phase = 'group_select';\n\n  await sendBlitzTurnPrompt(game\x2C nextPN\x2C ctx);\n}\n\nasync function endBlitzDeployment(game\x2C ctx) {\n  const { client\x2C logGameAction\x2C saveGames\x2C sendPhaseGateMessages } = ctx;\n\n  // Mark deployment as complete (for compatibility with phase gate checks)\n  game.initiativePlayerDeployed = true;\n  game.nonInitiativePlayerDeployed = true;\n\n  // Clean up blitz state messages for both players\n  await cleanupBlitzMessages(game\x2C 1\x2C client);\n  await cleanupBlitzMessages(game\x2C 2\x2C client);\n\n  await logGameAction(game\x2C client\x2C '**Blitz deployment complete.** Both players have finished deploying.'\x2C { phase: 'DEPLOYMENT'\x2C icon: 'deployed' });\n\n  // Use the standard phase gate to advance from deployment \u2192 CC draw\n  await sendPhaseGateMessages(game\x2C 'deploy_done'\x2C ctx);\n  if (saveGames) saveGames();\n}\n
