script-source,610,/Users/adammeehan/Public/IACP-Skirmish-Async/node_modules/discord.js/src/managers/ApplicationCommandManager.js,'use strict';\n\nconst { Collection } = require('@discordjs/collection');\nconst { makeURLSearchParams } = require('@discordjs/rest');\nconst { isJSONEncodable } = require('@discordjs/util');\nconst { Routes } = require('discord-api-types/v10');\nconst ApplicationCommandPermissionsManager = require('./ApplicationCommandPermissionsManager');\nconst CachedManager = require('./CachedManager');\nconst { DiscordjsTypeError\x2C ErrorCodes } = require('../errors');\nconst ApplicationCommand = require('../structures/ApplicationCommand');\nconst PermissionsBitField = require('../util/PermissionsBitField');\n\n/**\n * Manages API methods for application commands and stores their cache.\n * @extends {CachedManager}\n */\nclass ApplicationCommandManager extends CachedManager {\n  constructor(client\x2C iterable) {\n    super(client\x2C ApplicationCommand\x2C iterable);\n\n    /**\n     * The manager for permissions of arbitrary commands on arbitrary guilds\n     * @type {ApplicationCommandPermissionsManager}\n     */\n    this.permissions = new ApplicationCommandPermissionsManager(this);\n  }\n\n  /**\n   * The cache of this manager\n   * @type {Collection<Snowflake\x2C ApplicationCommand>}\n   * @name ApplicationCommandManager#cache\n   */\n\n  _add(data\x2C cache\x2C guildId) {\n    return super._add(data\x2C cache\x2C { extras: [this.guild\x2C guildId] });\n  }\n\n  /**\n   * The APIRouter path to the commands\n   * @param {Snowflake} [options.id] The application command's id\n   * @param {Snowflake} [options.guildId] The guild's id to use in the path\x2C\n   * ignored when using a {@link GuildApplicationCommandManager}\n   * @returns {string}\n   * @private\n   */\n  commandPath({ id\x2C guildId } = {}) {\n    if (this.guild ?? guildId) {\n      if (id) {\n        return Routes.applicationGuildCommand(this.client.application.id\x2C this.guild?.id ?? guildId\x2C id);\n      }\n\n      return Routes.applicationGuildCommands(this.client.application.id\x2C this.guild?.id ?? guildId);\n    }\n\n    if (id) {\n      return Routes.applicationCommand(this.client.application.id\x2C id);\n    }\n\n    return Routes.applicationCommands(this.client.application.id);\n  }\n\n  /**\n   * Data that resolves to give an ApplicationCommand object. This can be:\n   * * An ApplicationCommand object\n   * * A Snowflake\n   * @typedef {ApplicationCommand|Snowflake} ApplicationCommandResolvable\n   */\n\n  /**\n   * Data that resolves to the data of an ApplicationCommand\n   * @typedef {ApplicationCommandData|APIApplicationCommand} ApplicationCommandDataResolvable\n   */\n\n  /**\n   * Options used to fetch data from Discord\n   * @typedef {Object} BaseFetchOptions\n   * @property {boolean} [cache=true] Whether to cache the fetched data if it wasn't already\n   * @property {boolean} [force=false] Whether to skip the cache check and request the API\n   */\n\n  /**\n   * Options used to fetch Application Commands from Discord\n   * @typedef {BaseFetchOptions} FetchApplicationCommandOptions\n   * @property {Snowflake} [guildId] The guild's id to fetch commands for\x2C for when the guild is not cached\n   * @property {Locale} [locale] The locale to use when fetching this command\n   * @property {boolean} [withLocalizations] Whether to fetch all localization data\n   */\n\n  /**\n   * Obtains one or multiple application commands from Discord\x2C or the cache if it's already available.\n   * @param {Snowflake|FetchApplicationCommandOptions} [id] Options for fetching application command(s)\n   * @param {FetchApplicationCommandOptions} [options] Additional options for this fetch\n   * @returns {Promise<ApplicationCommand|Collection<Snowflake\x2C ApplicationCommand>>}\n   * @example\n   * // Fetch a single command\n   * client.application.commands.fetch('123456789012345678')\n   *   .then(command => console.log(`Fetched command ${command.name}`))\n   *   .catch(console.error);\n   * @example\n   * // Fetch all commands\n   * guild.commands.fetch()\n   *   .then(commands => console.log(`Fetched ${commands.size} commands`))\n   *   .catch(console.error);\n   */\n  async fetch(id\x2C { guildId\x2C cache = true\x2C force = false\x2C locale\x2C withLocalizations } = {}) {\n    if (typeof id === 'object') {\n      ({ guildId\x2C cache = true\x2C locale\x2C withLocalizations } = id);\n    } else if (id) {\n      if (!force) {\n        const existing = this.cache.get(id);\n        if (existing) return existing;\n      }\n      const command = await this.client.rest.get(this.commandPath({ id\x2C guildId }));\n      return this._add(command\x2C cache);\n    }\n\n    const data = await this.client.rest.get(this.commandPath({ guildId })\x2C {\n      headers: {\n        'X-Discord-Locale': locale\x2C\n      }\x2C\n      query: makeURLSearchParams({ with_localizations: withLocalizations })\x2C\n    });\n    return data.reduce((coll\x2C command) => coll.set(command.id\x2C this._add(command\x2C cache\x2C guildId))\x2C new Collection());\n  }\n\n  /**\n   * Creates an application command.\n   * @param {ApplicationCommandDataResolvable} command The command\n   * @param {Snowflake} [guildId] The guild's id to create this command in\x2C\n   * ignored when using a {@link GuildApplicationCommandManager}\n   * @returns {Promise<ApplicationCommand>}\n   * @example\n   * // Create a new command\n   * client.application.commands.create({\n   *   name: 'test'\x2C\n   *   description: 'A test command'\x2C\n   * })\n   *   .then(console.log)\n   *   .catch(console.error);\n   */\n  async create(command\x2C guildId) {\n    const data = await this.client.rest.post(this.commandPath({ guildId })\x2C {\n      body: this.constructor.transformCommand(command)\x2C\n    });\n    return this._add(data\x2C true\x2C guildId);\n  }\n\n  /**\n   * Sets all the commands for this application or guild.\n   * @param {ApplicationCommandDataResolvable[]} commands The commands\n   * @param {Snowflake} [guildId] The guild's id to create the commands in\x2C\n   * ignored when using a {@link GuildApplicationCommandManager}\n   * @returns {Promise<Collection<Snowflake\x2C ApplicationCommand>>}\n   * @example\n   * // Set all commands to just this one\n   * client.application.commands.set([\n   *   {\n   *     name: 'test'\x2C\n   *     description: 'A test command'\x2C\n   *   }\x2C\n   * ])\n   *   .then(console.log)\n   *   .catch(console.error);\n   * @example\n   * // Remove all commands\n   * guild.commands.set([])\n   *   .then(console.log)\n   *   .catch(console.error);\n   */\n  async set(commands\x2C guildId) {\n    const data = await this.client.rest.put(this.commandPath({ guildId })\x2C {\n      body: commands.map(command => this.constructor.transformCommand(command))\x2C\n    });\n    return data.reduce(\n      (collection\x2C command) => collection.set(command.id\x2C this._add(command\x2C true\x2C guildId))\x2C\n      new Collection()\x2C\n    );\n  }\n\n  /**\n   * Edits an application command.\n   * @param {ApplicationCommandResolvable} command The command to edit\n   * @param {Partial<ApplicationCommandDataResolvable>} data The data to update the command with\n   * @param {Snowflake} [guildId] The guild's id where the command registered\x2C\n   * ignored when using a {@link GuildApplicationCommandManager}\n   * @returns {Promise<ApplicationCommand>}\n   * @example\n   * // Edit an existing command\n   * client.application.commands.edit('123456789012345678'\x2C {\n   *   description: 'New description'\x2C\n   * })\n   *   .then(console.log)\n   *   .catch(console.error);\n   */\n  async edit(command\x2C data\x2C guildId) {\n    const id = this.resolveId(command);\n    if (!id) throw new DiscordjsTypeError(ErrorCodes.InvalidType\x2C 'command'\x2C 'ApplicationCommandResolvable');\n\n    const patched = await this.client.rest.patch(this.commandPath({ id\x2C guildId })\x2C {\n      body: this.constructor.transformCommand(data)\x2C\n    });\n    return this._add(patched\x2C true\x2C guildId);\n  }\n\n  /**\n   * Deletes an application command.\n   * @param {ApplicationCommandResolvable} command The command to delete\n   * @param {Snowflake} [guildId] The guild's id where the command is registered\x2C\n   * ignored when using a {@link GuildApplicationCommandManager}\n   * @returns {Promise<?ApplicationCommand>}\n   * @example\n   * // Delete a command\n   * guild.commands.delete('123456789012345678')\n   *   .then(console.log)\n   *   .catch(console.error);\n   */\n  async delete(command\x2C guildId) {\n    const id = this.resolveId(command);\n    if (!id) throw new DiscordjsTypeError(ErrorCodes.InvalidType\x2C 'command'\x2C 'ApplicationCommandResolvable');\n\n    await this.client.rest.delete(this.commandPath({ id\x2C guildId }));\n\n    const cached = this.cache.get(id);\n    this.cache.delete(id);\n    return cached ?? null;\n  }\n\n  /**\n   * Transforms an {@link ApplicationCommandData} object into something that can be used with the API.\n   * @param {ApplicationCommandDataResolvable} command The command to transform\n   * @returns {APIApplicationCommand}\n   * @private\n   */\n  static transformCommand(command) {\n    if (isJSONEncodable(command)) return command.toJSON();\n\n    let default_member_permissions;\n\n    if ('default_member_permissions' in command) {\n      default_member_permissions = command.default_member_permissions\n        ? new PermissionsBitField(BigInt(command.default_member_permissions)).bitfield.toString()\n        : command.default_member_permissions;\n    }\n\n    if ('defaultMemberPermissions' in command) {\n      default_member_permissions =\n        command.defaultMemberPermissions !== null\n          ? new PermissionsBitField(command.defaultMemberPermissions).bitfield.toString()\n          : command.defaultMemberPermissions;\n    }\n\n    return {\n      name: command.name\x2C\n      name_localizations: command.nameLocalizations ?? command.name_localizations\x2C\n      description: command.description\x2C\n      nsfw: command.nsfw\x2C\n      description_localizations: command.descriptionLocalizations ?? command.description_localizations\x2C\n      type: command.type\x2C\n      options: command.options?.map(option => ApplicationCommand.transformOption(option))\x2C\n      default_member_permissions\x2C\n      dm_permission: command.dmPermission ?? command.dm_permission\x2C\n      integration_types: command.integrationTypes ?? command.integration_types\x2C\n      contexts: command.contexts\x2C\n      handler: command.handler\x2C\n    };\n  }\n}\n\nmodule.exports = ApplicationCommandManager;\n
