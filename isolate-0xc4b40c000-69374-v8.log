script-source,199,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/exploration/transition-key.js,/**\n * Canonical transition identity for coverage tracking.\n * Shared between headless explorer and Discord self-play.\n *\n * Transition key = "roundPhase|frozenPendingSet|actionType"\n *\n * This module is the single source of truth for PENDING_STATE_KEYS and\n * the transition key computation. Both headless (flow-harness\x2C explorer-coverage)\n * and Discord (self-play.js) import from here.\n */\n\n// Canonical list: every pending state key that affects game-state identity.\n// Order matters (determines frozenPendingSet string). Do not reorder.\nexport const PENDING_STATE_KEYS = [\n  'pendingCombat'\x2C\n  'pendingNegation'\x2C\n  'pendingCelebration'\x2C\n  'pendingPowerTokenGrant'\x2C\n  'pendingDcAbilityChoice'\x2C\n  'pendingPounceSpaceChoice'\x2C\n  'pendingMissileSalvo'\x2C\n  'pendingCoverFire'\x2C\n  'pendingSpreadThePainCondPick'\x2C\n  'pendingStrainChoice'\x2C\n  'pendingStillFaster'\x2C\n  'pendingLastResort'\x2C\n  'pendingStrikeMeDown'\x2C\n  'pendingSlowOnTheDraw'\x2C\n  'pendingForceExhaustion'\x2C\n  'pendingIllicitArms'\x2C\n  'pendingPowerConverter'\x2C\n  'pendingThereIsNoTry'\x2C\n  'pendingToughLuck'\x2C\n  'pendingHunterProtocol'\x2C\n  'pendingBleeding'\x2C\n  'pendingEe3Carbine'\x2C\n  'pendingBoRifle'\x2C\n  'pendingRushPush'\x2C\n  'pendingShoulderRush'\x2C\n  'pendingFalseOrders'\x2C\n  'pendingOverwatchPlacement'\x2C\n  'pendingOrbitalBombardment'\x2C\n  'pendingBombDrop'\x2C\n  'pendingCcConfirmation'\x2C\n  'pendingCcChoice'\x2C\n  'pendingCcSpaceChoice'\x2C\n  'moveInProgress'\x2C\n  'endOfRoundWhoseTurn'\x2C\n];\n\n/** Check if a pending field is "active" (truthy\x2C non-empty object). */\nfunction isPendingActive(val) {\n  if (!val) return false;\n  if (typeof val === 'object' && !Array.isArray(val) && Object.keys(val).length === 0) return false;\n  return true;\n}\n\n/** Snapshot which pending states are active on a game. */\nexport function snapshotPendingStates(game) {\n  const snap = {};\n  for (const key of PENDING_STATE_KEYS) {\n    snap[key] = isPendingActive(game[key]);\n  }\n  return snap;\n}\n\n/**\n * Compute the transition key for a game state + action type.\n * Key format: "roundPhase|pendingSet|actionType"\n */\nexport function computeTransitionKey(game\x2C actionType) {\n  const roundPhase = game.roundPhase || 'null';\n  const activePending = PENDING_STATE_KEYS.filter(k => isPendingActive(game[k]));\n  return `${roundPhase}|${activePending.join('\x2C')}|${actionType}`;\n}\n\n/**\n * Parse a transition key back into its component parts.\n */\nexport function parseTransitionKey(key) {\n  const parts = key.split('|');\n  return {\n    roundPhase: parts[0] || 'null'\x2C\n    pendingSet: parts[1] || ''\x2C\n    actionType: parts[2] || ''\x2C\n  };\n}\n
