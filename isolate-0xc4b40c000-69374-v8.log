onst newMoveContextKey = `${meta.gameId}_${moveKey}`;\n      const newMoveHeader = `**Move** \u2014 Pick destination (**${newMp}** MP remaining):${newMultiTileNote}`;\n      const newMoveActionBtns = [\n        { customId: `move_adjust_mp_${msgId}_${figureIndex}`\x2C label: 'Pick Path Manually'\x2C style: ButtonStyle.Secondary }\x2C\n      ];\n      if (!game.urgencyMustSpendAll?.[msgId]) {\n        newMoveActionBtns.push(\n          { customId: `move_pick_${msgId}_${figureIndex}_done`\x2C label: 'End Movement'\x2C style: ButtonStyle.Secondary }\n        );\n      }\n      game.pendingSpacePick = game.pendingSpacePick || {};\n      game.pendingSpacePick[newMoveContextKey] = {\n        validSpaces: newButtonSpaces\x2C\n        cellPrefix: `move_pick_${msgId}_${figureIndex}_`\x2C\n        mapSpaces: nextBoard.mapSpaces\x2C\n        labelMap: newLabelMap\x2C\n        headerText: newMoveHeader\x2C\n        actionButtons: newMoveActionBtns\x2C\n      };\n      const { rows: newRowBtns } = buildRowPickerButtons(newButtonSpaces\x2C `space_row_${newMoveContextKey}_`);\n      const newActionBtns = newMoveActionBtns.map(b =>\n        new ButtonBuilder().setCustomId(b.customId).setLabel(b.label).setStyle(b.style)\n      );\n      const newActionRow = new ActionRowBuilder().addComponents(...newActionBtns);\n      const newFirstPayload = {\n        content: `${newMoveHeader}\\nChoose a row:`\x2C\n        components: [...newRowBtns.slice(0\x2C 4)\x2C newActionRow]\x2C\n        fetchReply: true\x2C\n      };\n      if (newMinimap) newFirstPayload.files = [newMinimap];\n      const newGridMsg = await interaction.followUp(newFirstPayload).catch(() => null);\n      game.moveGridMessageIds = game.moveGridMessageIds || {};\n      game.moveGridMessageIds[moveKey] = newGridMsg?.id ? [newGridMsg.id] : [];\n    } else {\n      game.moveGridMessageIds = game.moveGridMessageIds || {};\n      game.moveGridMessageIds[moveKey] = [];\n    }\n  }\n  if (game.boardId && game.selectedMap) {\n    try {\n      const boardChannel = await fetchGameChannel(client\x2C game.boardId);\n      if (!boardChannel) throw new Error('Board channel not found');\n      const payload = await buildBoardMapPayload(game.gameId\x2C game.selectedMap\x2C game);\n      await boardChannel.send(payload);\n    } catch (err) {\n      console.error('Failed to update map after move:'\x2C err);\n    }\n  }\n  // Re-render the activation thread minimap so it shows the figure's new position\n  if (ctx.updateDcActionsMessage) {\n    try {\n      await ctx.updateDcActionsMessage(game\x2C msgId\x2C client);\n    } catch (err) {\n      console.error('Failed to update activation minimap after move:'\x2C err);\n    }\n  }\n  // (Interactive massive-push prompts are posted directly from the init block\n  // above via _dispatchNextMassivePush. No post-hoc branch needed here.)\n  // Bleeding: trigger once after first space moved (pendingBleed set when Move action declared)\n  if (moveState.pendingBleed && ctx.sendBleedingPrompt) {\n    moveState.pendingBleed = false;\n    if ((game.figureConditions?.[moveState.figureKey] || []).includes('Bleed')) {\n      await ctx.sendBleedingPrompt(game\x2C interaction.channel\x2C moveState.figureKey\x2C moveState.playerNum\x2C moveState.displayName);\n    }\n  }\n  // Rush (Onar): after all movement MP exhausted\x2C offer push on adjacent SMALL hostile\n  if (newMp <= 0 && game.rushPending?.[msgId]) {\n    delete game.rushPending[msgId];\n    const rushMapId = game.selectedMap?.id;\n    const rushAdjSpaces = rushMapId ? (getMapData(rushMapId)?.adjacency?.[newTopLeft] || []) : [];\n    const rushEffects = getDcEffects();\n    const rushOppNum = opponentPlayerNum(playerNum);\n    const rushOppPos = game.figurePositions?.[rushOppNum] || {};\n    const rushAdjSet = new Set(rushAdjSpaces);\n    const rushTargets = [];\n    for (const [fk\x2C pos] of Object.entries(rushOppPos)) {\n      if (!pos || !rushAdjSet.has(pos)) continue;\n      const rDcName = dcNameFromFigureKey(fk);\n      const rEff = rushEffects?.[rDcName];\n      const rKw = (rEff?.keywords || []).map(k => String(k).toUpperCase());\n      if (rKw.includes('LARGE') || rKw.includes('MASSIVE')) continue;\n      // Spiked Boots: cannot be pushed except by MASSIVE\n      if ((rEff?.specialAbilityIds || []).includes('spiked_boots_snowtrooper')) {\n        const pusherEff = rushEffects?.[meta.dcName];\n        if (!(pusherEff?.keywords || []).some(k => String(k).toUpperCase() === 'MASSIVE')) continue;\n      }\n      rushTargets.push({ figureKey: fk\x2C dcName: rDcName });\n    }\n    if (rushTargets.length > 0) {\n      game.pendingRushPush = {\n        msgId\x2C playerNum\x2C activatorFigureKey: figureKey\x2C\n        activatorPos: newTopLeft\x2C\n        targets: rushTargets.map(t => t.figureKey)\x2C\n      };\n      const btns = rushTargets.map((t\x2C i) =>\n        new ButtonBuilder()\n          .setCustomId(`rush_push_fig_${game.gameId}_${msgId}_${i}`)\n          .setLabel(t.dcName.replace(/_/g\x2C ' '))\n          .setStyle(ButtonStyle.Primary)\n      );\n      btns.push(\n        new ButtonBuilder()\n          .setCustomId(`rush_push_skip_${game.gameId}_${msgId}`)\n          .setLabel('Skip Rush Push')\n          .setStyle(ButtonStyle.Secondary)\n      );\n      const rushRows = [];\n      while (btns.length > 0) rushRows.push(new ActionRowBuilder().addComponents(btns.splice(0\x2C 5)));\n      await interaction.followUp({\n        content: '**Rush** \u2014 Push an adjacent SMALL hostile 1 space? Both suffer 1 Damage.'\x2C\n        components: rushRows.slice(0\x2C 5)\x2C\n      });\n    }\n  }\n  // Shoulder Rush (KX-Series Security Droid): after movement MP exhausted\x2C choose adjacent hostile \u2192 push if SMALL + enter space \u2192 free attack\n  if (newMp <= 0 && game.shoulderRushPending?.[msgId]) {\n    const srData = game.shoulderRushPending[msgId];\n    delete game.shoulderRushPending[msgId];\n    const srMapId = game.selectedMap?.id;\n    const srAdjSpaces = srMapId ? (getMapData(srMapId)?.adjacency?.[newTopLeft] || []) : [];\n    const srEffects = getDcEffects();\n    const srOppNum = opponentPlayerNum(playerNum);\n    const srOppPos = game.figurePositions?.[srOppNum] || {};\n    const srAdjSet = new Set(srAdjSpaces);\n    const srTargets = [];\n    for (const [fk\x2C pos] of Object.entries(srOppPos)) {\n      if (!pos || !srAdjSet.has(pos)) continue;\n      const srDcName = dcNameFromFigureKey(fk);\n      srTargets.push({ figureKey: fk\x2C dcName: srDcName });\n    }\n    if (srTargets.length > 0) {\n      game.pendingShoulderRush = {\n        msgId\x2C playerNum\x2C activatorFigureKey: figureKey\x2C\n        activatorPos: newTopLeft\x2C\n        targets: srTargets.map(t => t.figureKey)\x2C\n      };\n      const srBtns = srTargets.map((t\x2C i) =>\n        new ButtonBuilder()\n          .setCustomId(`shoulder_rush_fig_${game.gameId}_${msgId}_${i}`)\n          .setLabel(t.dcName.replace(/_/g\x2C ' '))\n          .setStyle(ButtonStyle.Primary)\n      );\n      srBtns.push(\n        new ButtonBuilder()\n          .setCustomId(`shoulder_rush_skip_${game.gameId}_${msgId}`)\n          .setLabel('Skip (No Target)')\n          .setStyle(ButtonStyle.Secondary)\n      );\n      const srRows = [];\n      while (srBtns.length > 0) srRows.push(new ActionRowBuilder().addComponents(srBtns.splice(0\x2C 5)));\n      await interaction.followUp({\n        content: '**Shoulder Rush** \u2014 Choose an adjacent hostile figure to target:'\x2C\n        components: srRows.slice(0\x2C 5)\x2C\n      });\n    }\n  }\n  // Deference Protocol (KX-Series Security Droid): when a friendly LEADER enters a space adjacent to KX\x2C it may gain 1 Block token (once per round)\n  {\n    const dpMapId = game.selectedMap?.id;\n    const dpEffects = getDcEffects();\n    // Check all figures on the same team: does any have deference_protocol and is adjacent to the figure that just moved?\n    const friendlyPositions = game.figurePositions?.[playerNum] || {};\n    const movedFigDcName = meta.dcName;\n    const movedFigEff = dpEffects?.[movedFigDcName];\n    const movedFigKw = (movedFigEff?.keywords || []).map(k => String(k).toUpperCase());\n    const movedFigIsLeader = movedFigKw.includes('LEADER');\n    if (movedFigIsLeader) {\n      for (const [fk\x2C pos] of Object.entries(friendlyPositions)) {\n        if (!pos || fk === figureKey) continue; // skip self\n        const dpDcName = dcNameFromFigureKey(fk);\n        const dpEff = dpEffects?.[dpDcName];\n        if (!(dpEff?.specialAbilityIds || []).includes('deference_protocol')) continue;\n        // Check adjacency\n        const adjSpaces = dpMapId ? (getMapData(dpMapId)?.adjacency?.[pos] || []) : [];\n        if (!adjSpaces.includes(newTopLeft)) continue;\n        // Once per round check\n        game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n        const dpKey = `deference_protocol_${fk}`;\n        if (game.roundFigureAbilityUsed[dpKey]) continue;\n        game.roundFigureAbilityUsed[dpKey] = true;\n        // Grant Block token\n        grantPowerTokens(game\x2C fk\x2C 'Block'\x2C 1);\n        if (logGameAction) {\n          await logGameAction(game\x2C client\x2C `**Deference Protocol** \u2014 **${dpDcName}** gained a Block token (friendly LEADER entered adjacent space).`\x2C { phase: 'ROUND'\x2C icon: 'defend' });\n        }\n      }\n    }\n  }\n  // Cassian Said I Had To (K-2S0): when a friendly LEADER enters an adjacent space\x2C gain up to 1 Damage Token (once per round)\n  {\n    const csMapId = game.selectedMap?.id;\n    const csEffects = getDcEffects();\n    const csFriendlyPositions = game.figurePositions?.[playerNum] || {};\n    const csMovedFigDcName = meta.dcName;\n    const csMovedFigEff = csEffects?.[csMovedFigDcName];\n    const csMovedFigKw = (csMovedFigEff?.keywords || []).map(k => String(k).toUpperCase());\n    const csMovedFigIsLeader = csMovedFigKw.includes('LEADER');\n    if (csMovedFigIsLeader) {\n      for (const [fk\x2C pos] of Object.entries(csFriendlyPositions)) {\n        if (!pos || fk === figureKey) continue;\n        const csDcName = dcNameFromFigureKey(fk);\n        const csEff = csEffects?.[csDcName];\n        if (!(csEff?.specialAbilityIds || []).includes('cassian_said_i_had_to')) continue;\n        const csAdjSpaces = csMapId ? (getMapData(csMapId)?.adjacency?.[pos] || []) : [];\n        if (!csAdjSpaces.includes(newTopLeft)) continue;\n        game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n        const csKey = `cassian_said_i_had_to_${fk}`;\n        if (game.roundFigureAbilityUsed[csKey]) continue;\n        game.roundFigureAbilityUsed[csKey] = true;\n        grantPowerTokens(game\x2C fk\x2C 'Damage'\x2C 1);\n        if (logGameAction) {\n          await logGameAction(game\x2C client\x2C `**Cassian Said I Had To** \u2014 **${csDcName}** gained a Damage Token (friendly LEADER entered adjacent space).`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n        }\n      }\n    }\n  }\n  // Swipe (Salacious B. Crumb): when entering a space containing a hostile figure during movement\x2C deal 1 Damage (limit once per figure per round)\n  if (meta.dcName === 'Salacious B. Crumb' && path && path.length >= 2) {\n    const _swOppPN = opponentPlayerNum(playerNum);\n    const _swEnemyFigs = game.figurePositions?.[_swOppPN] || {};\n    const _swHs = ctx.dcHealthState;\n    // Walk each space entered (skip path[0] which is start position)\n    for (let _swPi = 1; _swPi < path.length; _swPi++) {\n      const _swSpace = String(path[_swPi]).toLowerCase();\n      for (const [_swEfk\x2C _swEpos] of Object.entries(_swEnemyFigs)) {\n        if (!_swEpos || String(_swEpos).toLowerCase() !== _swSpace) continue;\n        const _swKey = `swipe_${figureKey}_${_swEfk}`;\n        game.roundFigureAbilityUsed = game.roundFigureAbilityUsed || {};\n        if (game.roundFigureAbilityUsed[_swKey]) continue;\n        game.roundFigureAbilityUsed[_swKey] = true;\n        const _swTgtDcName = dcNameFromFigureKey(_swEfk);\n        const _swMatch = _swEfk.match(/^(.+)-(\\d+)-(\\d+)$/);\n        if (!_swMatch) continue;\n        const [\x2C \x2C _swDgIdx\x2C _swFigIdxStr] = _swMatch;\n        const _swFigIdx = parseInt(_swFigIdxStr\x2C 10);\n        let _swTgtMsgId = null;\n        for (const [mId\x2C mMeta] of dcMessageMeta) {\n          if (mMeta.gameId !== game.gameId || mMeta.playerNum !== _swOppPN || mMeta.dcName !== _swTgtDcName) continue;\n          const dgM = (mMeta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/);\n          if (String(dgM ? dgM[1] : '1') === String(_swDgIdx)) { _swTgtMsgId = mId; break; }\n        }\n        if (!_swTgtMsgId || !_swHs) continue;\n        const _swEntry = _swHs.get(_swTgtMsgId)?.[_swFigIdx];\n        if (!_swEntry || !Array.isArray(_swEntry)) continue;\n        const [_swCur\x2C _swMax] = _swEntry;\n        if ((_swMax ?? 0) === 0 || ((_swCur ?? _swMax ?? 0) <= 0)) continue;\n        const { prevHp: _swPrev\x2C newHp: _swNew } = reduceHp(_swHs\x2C game\x2C _swTgtMsgId\x2C _swFigIdx\x2C 1\x2C _swOppPN);\n        const _swDefeat = _swNew <= 0 ? ' **(defeated)**' : '';\n        await logGameAction(game\x2C client\x2C `**Swipe** \u2014 **Salacious B. Crumb** enters **${_swTgtDcName}**'s space: 1 Damage${_swDefeat} (HP: ${_swPrev}\u2192${_swNew}).`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n        if (_swNew <= 0 && processFigureDefeat) {\n          await processFigureDefeat(game\x2C {\n            defeatedPlayerNum: _swOppPN\x2C\n            figureKey: _swEfk\x2C\n            attackerPlayerNum: playerNum\x2C\n            source: 'Swipe'\x2C\n          });\n        }\n      }\n    }\n  }\n  // Attached (Dio): when Iden Versio exits Dio's space during movement\x2C Dio may move up to 1 space\n  if (meta.dcName === 'Iden Versio' && startCoord && String(newTopLeft).toLowerCase() !== String(startCoord).toLowerCase()) {\n    const _dioFriendlyFigs = game.figurePositions?.[playerNum] || {};\n    for (const [_dioFk\x2C _dioPos] of Object.entries(_dioFriendlyFigs)) {\n      if (!_dioPos) continue;\n      if (!_dioFk.startsWith('Dio-')) continue;\n      if (String(_dioPos).toLowerCase() !== String(startCoord).toLowerCase()) continue;\n      // Iden was on Dio's space and has now moved away \u2014 trigger Attached\n      const _dioMapId = game.selectedMap?.id;\n      if (!_dioMapId) continue;\n      const _dioAdj = getMapData(_dioMapId)?.adjacency?.[_dioPos] || [];\n      if (_dioAdj.length === 0) continue;\n      // Best follow space is path[1] (first step on Iden's path)\n      const _dioDefaultSpace = (path && path.length >= 2) ? String(path[1]).toLowerCase() : _dioAdj[0];\n      game.pendingDioFollow = {\n        dioFigureKey: _dioFk\x2C\n        dioPlayerNum: playerNum\x2C\n        currentSpace: _dioPos\x2C\n        followSpace: _dioDefaultSpace\x2C\n      };\n      const _dioOwnerId = getPlayerId(game\x2C playerNum);\n      const _dioSpaceBtns = _dioAdj.slice(0\x2C 19).map(s =>\n        new ButtonBuilder()\n          .setCustomId(`dio_follow_pick_${game.gameId}_${s}`)\n          .setLabel(s.toUpperCase())\n          .setStyle(s === _dioDefaultSpace ? ButtonStyle.Primary : ButtonStyle.Secondary)\n      );\n      _dioSpaceBtns.push(\n        new ButtonBuilder()\n          .setCustomId(`dio_stay_${game.gameId}`)\n          .setLabel('Stay')\n          .setStyle(ButtonStyle.Secondary)\n      );\n      const _dioRows = [];\n      while (_dioSpaceBtns.length > 0) _dioRows.push(new ActionRowBuilder().addComponents(_dioSpaceBtns.splice(0\x2C 5)));\n      await interaction.followUp({\n        content: `<@${_dioOwnerId}> **Attached** \u2014 **Iden Versio** exited **Dio**'s space. Dio may interrupt to move up to 1 space:`\x2C\n        components: _dioRows.slice(0\x2C 5)\x2C\n        allowedMentions: { users: _dioOwnerId ? [_dioOwnerId] : [] }\x2C\n      }).catch(discordCatch);\n      break;\n    }\n  }\n  // --- Post-move interrupt detection: C23 Parting Blow\x2C C15 Dirty Trick\x2C C43 Disengage ---\n  if (path && path.length >= 2) {\n    const interruptTriggers = detectPostMoveInterrupts(game\x2C playerNum\x2C figureKey\x2C path);\n    for (const trigger of interruptTriggers) {\n      const oppId = getPlayerId(game\x2C trigger.candidatePlayerNum);\n      if (trigger.type === 'overwatch') {\n        // Overwatch uses different buttons (DC exhaust\x2C not CC play)\n        const owBtns = new ActionRowBuilder().addComponents(\n          new ButtonBuilder()\n            .setCustomId(`ow_interrupt_use_${game.gameId}_${trigger.owMsgId}`)\n            .setLabel('Use Overwatch (Interrupt Attack)')\n            .setStyle(ButtonStyle.Danger)\x2C\n          new ButtonBuilder()\n            .setCustomId(`ow_interrupt_skip_${game.gameId}_${trigger.owMsgId}`)\n            .setLabel('Skip')\n            .setStyle(ButtonStyle.Secondary)\x2C\n        );\n        await interaction.channel.send({\n          content: `\u26a0\ufe0f <@${oppId}> \u2014 ${trigger.description}`\x2C\n          components: [owBtns]\x2C\n          allowedMentions: { users: oppId ? [oppId] : [] }\x2C\n        }).catch(discordCatch);\n      } else {\n        const triggerBtns = new ActionRowBuilder().addComponents(\n          new ButtonBuilder()\n            .setCustomId(`mvint_play_${game.gameId}_${trigger.type}_${trigger.candidateFigureKey}`)\n            .setLabel(`Play ${trigger.cardName}`)\n            .setStyle(ButtonStyle.Danger)\x2C\n          new ButtonBuilder()\n            .setCustomId(`mvint_skip_${game.gameId}_${trigger.type}_${trigger.candidateFigureKey}`)\n            .setLabel('Skip')\n            .setStyle(ButtonStyle.Secondary)\x2C\n        );\n        await interaction.channel.send({\n          content: `\u26a0\ufe0f <@${oppId}> \u2014 ${trigger.description}`\x2C\n          components: [triggerBtns]\x2C\n          allowedMentions: { users: oppId ? [oppId] : [] }\x2C\n        }).catch(discordCatch);\n      }\n      await logGameAction(game\x2C client\x2C `\u26a0\ufe0f Movement interrupt opportunity: ${trigger.description}`\x2C { phase: 'ROUND'\x2C icon: 'warn' });\n    }\n  }\n  saveGames();\n}\n\n/**\n * Handle mvint_play_ \u2014 player chose to play a movement interrupt CC (Parting Blow / Dirty Trick / Disengage).\n * This acknowledges the choice and logs it; actual card resolution still goes through the normal CC play flow.\n */\nexport async function handleMoveInterruptPlay(interaction\x2C ctx) {\n  const { getGame\x2C logGameAction\x2C saveGames\x2C client } = ctx;\n  const m = interaction.customId.match(/^mvint_play_([^_]+)_(\\w+)_(.+)$/);\n  if (!m) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C gameId\x2C triggerType\x2C candidateFigureKey] = m;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n\n  const cardNames = { partingBlow: 'Parting Blow'\x2C dirtyTrick: 'Dirty Trick'\x2C disengage: 'Disengage' };\n  const cardName = cardNames[triggerType] || triggerType;\n  const dcName = dcNameFromFigureKey(candidateFigureKey).replace(/_/g\x2C ' ');\n\n  // Disable the buttons on the original message\n  try {\n    await interaction.update({ components: [] });\n  } catch {\n    try { await interaction.deferUpdate(); } catch { /* already handled */ }\n  }\n\n  await logGameAction(game\x2C client\x2C `**${dcName}** chose to play **${cardName}**. Resolve via the CC hand (play the card normally).`\x2C { phase: 'ROUND'\x2C icon: 'cc' });\n  await interaction.followUp({\n    content: `\u2705 **${cardName}** acknowledged \u2014 play the card from your hand to resolve it.`\x2C\n    ephemeral: true\x2C\n  }).catch(discordCatch);\n  saveGames();\n}\n\n/**\n * Handle mvint_skip_ \u2014 player chose to skip a movement interrupt opportunity.\n */\nexport async function handleMoveInterruptSkip(interaction\x2C ctx) {\n  const { getGame\x2C logGameAction\x2C saveGames\x2C client } = ctx;\n  const m = interaction.customId.match(/^mvint_skip_([^_]+)_(\\w+)_(.+)$/);\n  if (!m) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C gameId\x2C triggerType\x2C candidateFigureKey] = m;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n\n  const cardNames = { partingBlow: 'Parting Blow'\x2C dirtyTrick: 'Dirty Trick'\x2C disengage: 'Disengage' };\n  const cardName = cardNames[triggerType] || triggerType;\n  const dcName = dcNameFromFigureKey(candidateFigureKey).replace(/_/g\x2C ' ');\n\n  // Disable the buttons on the original message\n  try {\n    await interaction.update({ components: [] });\n  } catch {\n    try { await interaction.deferUpdate(); } catch { /* already handled */ }\n  }\n\n  await logGameAction(game\x2C client\x2C `**${dcName}** skipped **${cardName}** opportunity.`\x2C { phase: 'ROUND'\x2C icon: 'skip' });\n  saveGames();\n}\n\n/**\n * Handle ow_interrupt_use_ \u2014 player chose to use Overwatch interrupt attack.\n */\nexport async function handleOverwatchInterruptUse(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const m = interaction.customId.match(/^ow_interrupt_use_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C owMsgId] = m;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n\n  // Exhaust the Overwatch card\n  game.exhaustedSkirmishUpgrades = game.exhaustedSkirmishUpgrades || {};\n  game.exhaustedSkirmishUpgrades[owMsgId] = [...(game.exhaustedSkirmishUpgrades[owMsgId] || [])\x2C 'Overwatch'];\n\n  // Remove the token\n  if (game.overwatchTokenPosition) delete game.overwatchTokenPosition[owMsgId];\n\n  // Determine DC name\n  let dcDisplayName = 'E-Web Engineer';\n  for (const pn of [1\x2C 2]) {\n    const dcList = getDcList(game\x2C pn) || [];\n    const msgIds = getDcMessageIds(game\x2C pn) || [];\n    const idx = msgIds.indexOf(owMsgId);\n    if (idx >= 0) {\n      dcDisplayName = dcList[idx]?.displayName || dcList[idx]?.dcName || dcDisplayName;\n      break;\n    }\n  }\n\n  try { await interaction.update({ components: [] }); } catch { try { await interaction.deferUpdate(); } catch { /* already handled */ } }\n\n  await logGameAction(game\x2C client\x2C `**Overwatch** \u2014 **${dcDisplayName}** interrupts to perform an attack! Use the DC's Attack button. Token removed. (Exhausted)`\x2C { phase: 'ROUND'\x2C icon: 'attack' });\n  await interaction.followUp({ content: `\u2705 **Overwatch** activated \u2014 use **${dcDisplayName}**'s Attack button to perform the interrupt attack. The Overwatch token has been removed.`\x2C ephemeral: true }).catch(discordCatch);\n  saveGames();\n}\n\n/**\n * Handle ow_interrupt_skip_ \u2014 player chose to skip Overwatch interrupt.\n */\nexport async function handleOverwatchInterruptSkip(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const m = interaction.customId.match(/^ow_interrupt_skip_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId] = m;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n\n  try { await interaction.update({ components: [] }); } catch { try { await interaction.deferUpdate(); } catch { /* already handled */ } }\n\n  await logGameAction(game\x2C client\x2C `**Overwatch** interrupt opportunity skipped.`\x2C { phase: 'ROUND'\x2C icon: 'skip' });\n  saveGames();\n}\n\n/**\n * Handle dio_follow_pick_ \u2014 player chose a space for Dio to follow Iden.\n */\nexport async function handleDioFollowPick(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const m = interaction.customId.match(/^dio_follow_pick_([^_]+)_(.+)$/);\n  if (!m) return;\n  const [\x2C gameId\x2C space] = m;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n\n  const pending = game.pendingDioFollow;\n  if (!pending) {\n    try { await interaction.update({ components: [] }); } catch { /* already handled */ }\n    return;\n  }\n\n  try { await interaction.update({ components: [] }); } catch { try { await interaction.deferUpdate(); } catch { /* already handled */ } }\n\n  // Move Dio to the chosen space\n  const { dioFigureKey\x2C dioPlayerNum\x2C currentSpace } = pending;\n  game.figurePositions = game.figurePositions || {};\n  game.figurePositions[dioPlayerNum] = game.figurePositions[dioPlayerNum] || {};\n  game.figurePositions[dioPlayerNum][dioFigureKey] = space;\n  delete game.pendingDioFollow;\n\n  await interaction.message.edit({ content: `**Attached** \u2014 **Dio** moved from **${currentSpace.toUpperCase()}** to **${space.toUpperCase()}** (following Iden Versio).`\x2C components: [] }).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `**Attached** \u2014 **Dio** moved to **${space.toUpperCase()}** (following Iden Versio).`\x2C { phase: 'ROUND'\x2C icon: 'move' });\n  saveGames();\n}\n\n/**\n * Handle dio_stay_ \u2014 player chose for Dio to stay put.\n */\nexport async function handleDioStay(interaction\x2C ctx) {\n  const { getGame\x2C saveGames\x2C logGameAction\x2C client } = ctx;\n  const m = interaction.customId.match(/^dio_stay_([^_]+)$/);\n  if (!m) return;\n  const [\x2C gameId] = m;\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n\n  try { await interaction.update({ components: [] }); } catch { try { await interaction.deferUpdate(); } catch { /* already handled */ } }\n\n  delete game.pendingDioFollow;\n  await interaction.message.edit({ content: `**Attached** \u2014 **Dio** stays put.`\x2C components: [] }).catch(discordCatch);\n  await logGameAction(game\x2C client\x2C `**Attached** \u2014 Dio chose to stay (did not follow Iden).`\x2C { phase: 'ROUND'\x2C icon: 'skip' });\n  saveGames();\n}\n\n
