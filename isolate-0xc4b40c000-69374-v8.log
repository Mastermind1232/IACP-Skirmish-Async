script-source,18,node:internal/util/inspect,'use strict';\n\nconst {\n  AggregateError\x2C\n  AggregateErrorPrototype\x2C\n  Array\x2C\n  ArrayBuffer\x2C\n  ArrayBufferPrototype\x2C\n  ArrayIsArray\x2C\n  ArrayPrototype\x2C\n  ArrayPrototypeFilter\x2C\n  ArrayPrototypeForEach\x2C\n  ArrayPrototypeIncludes\x2C\n  ArrayPrototypeIndexOf\x2C\n  ArrayPrototypeJoin\x2C\n  ArrayPrototypeMap\x2C\n  ArrayPrototypePop\x2C\n  ArrayPrototypePush\x2C\n  ArrayPrototypePushApply\x2C\n  ArrayPrototypeSlice\x2C\n  ArrayPrototypeSort\x2C\n  ArrayPrototypeSplice\x2C\n  ArrayPrototypeUnshift\x2C\n  BigIntPrototypeValueOf\x2C\n  Boolean\x2C\n  BooleanPrototype\x2C\n  BooleanPrototypeValueOf\x2C\n  DataView\x2C\n  DataViewPrototype\x2C\n  Date\x2C\n  DatePrototype\x2C\n  DatePrototypeGetTime\x2C\n  DatePrototypeToISOString\x2C\n  DatePrototypeToString\x2C\n  Error\x2C\n  ErrorPrototype\x2C\n  ErrorPrototypeToString\x2C\n  Function\x2C\n  FunctionPrototype\x2C\n  FunctionPrototypeBind\x2C\n  FunctionPrototypeCall\x2C\n  FunctionPrototypeSymbolHasInstance\x2C\n  FunctionPrototypeToString\x2C\n  JSONStringify\x2C\n  Map\x2C\n  MapPrototype\x2C\n  MapPrototypeEntries\x2C\n  MapPrototypeGetSize\x2C\n  MathFloor\x2C\n  MathMax\x2C\n  MathMin\x2C\n  MathRound\x2C\n  MathSqrt\x2C\n  MathTrunc\x2C\n  Number\x2C\n  NumberIsFinite\x2C\n  NumberIsNaN\x2C\n  NumberParseFloat\x2C\n  NumberParseInt\x2C\n  NumberPrototype\x2C\n  NumberPrototypeToString\x2C\n  NumberPrototypeValueOf\x2C\n  Object\x2C\n  ObjectAssign\x2C\n  ObjectDefineProperty\x2C\n  ObjectGetOwnPropertyDescriptor\x2C\n  ObjectGetOwnPropertyNames\x2C\n  ObjectGetOwnPropertySymbols\x2C\n  ObjectGetPrototypeOf\x2C\n  ObjectIs\x2C\n  ObjectKeys\x2C\n  ObjectPrototype\x2C\n  ObjectPrototypeHasOwnProperty\x2C\n  ObjectPrototypePropertyIsEnumerable\x2C\n  ObjectPrototypeToString\x2C\n  ObjectSeal\x2C\n  ObjectSetPrototypeOf\x2C\n  Promise\x2C\n  PromisePrototype\x2C\n  RangeError\x2C\n  RangeErrorPrototype\x2C\n  ReflectApply\x2C\n  ReflectOwn