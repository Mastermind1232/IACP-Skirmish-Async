code-creation,Script,9,308693,0x3f05b92a1c78,139, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/rendering.js:1:1,0x33c46858da30,~
script-source,261,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/rendering.js,/**\n * Rendering / display helpers extracted from index.js.\n * Builds payloads (embeds\x2C files\x2C components) for board maps\x2C DC cards\x2C\n * hand displays\x2C discard piles\x2C minimaps\x2C and deployment-zone maps.\n */\n\nimport { EmbedBuilder\x2C AttachmentBuilder } from 'discord.js';\nimport { existsSync } from 'fs';\nimport { join\x2C dirname } from 'path';\nimport { fileURLToPath } from 'url';\nimport { COLORS } from './discord/colors.js';\nimport { snowflakeUsers } from './discord/channel-helpers.js';\nimport { renderMap } from './map-renderer.js';\nimport { getCommandCardImagePath\x2C getDcImagePath\x2C getFigureImagePath\x2C resolveAssetPath\x2C UPGRADE_IMAGE_OVERRIDES } from './asset-paths.js';\nimport {\n  resolveDcName\x2C\n  parseCoord\x2C\n  edgeKey\x2C\n  toLowerSet\x2C\n  dcNameFromFigureKey\x2C\n  parseFigureKey\x2C\n  getInitiativePlayerNum\x2C\n  getEffectiveFigureSize\x2C\n  getMissionTokenCoords\x2C\n  getEffectiveSpeed\x2C\n  getOccupiedSpacesForMovement\x2C\n  colRowToCoord\x2C\n} from './game/index.js';\nimport {\n  getDcEffects\x2C\n  getDcStats\x2C\n  getMapTokensData\x2C\n  getDeploymentZones\x2C\n  getMapData\x2C\n  getMapSpaceSet\x2C\n  getFigureSize\x2C\n} from './data-loader.js';\nimport { dcMessageMeta } from './game-state.js';\nimport { getSquad } from './game/player-helpers.js';\nimport {\n  buildScorecardEmbed\x2C\n  formatHealthSection\x2C\n  EMBEDS_PER_MESSAGE\x2C\n  FIGURE_LETTERS\x2C\n  getActionsCounterContent\x2C\n  getCcActionButtons\x2C\n  getBoardButtons\x2C\n} from './discord/index.js';\nimport {\n  isFigurelessDc as _isFigurelessDc\x2C\n  hasDepleteEffect as _hasDepleteEffect\x2C\n  hasExhaustEffect as _hasExhaustEffect\x2C\n  getConfig\x2C\n} from './game/index.js';\n\nconst __dirname = dirname(fileURLToPath(import.meta.url));\nconst rootDir = join(__dirname\x2C '..');\n\n/**\n * Extract the loadout name for a DC embed\x2C if a loadout card is configured for the first figure.\n * @param {object} game\n * @param {string} dcName\n * @param {number} playerNum\n * @param {string} displayName - for DG index extraction\n * @returns {string|null}\n */\nexport function getLoadoutNameForEmbed(game\x2C dcName\x2C playerNum\x2C displayName) {\n  if (!game || !dcName) return null;\n  const dgIndex = (displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? '1';\n  const fks = Object.keys(game.figurePositions?.[playerNum] || {}).filter(fk => fk.startsWith(`${dcName}-${dgIndex}-`));\n  if (fks.length === 0) return null;\n  return getConfig(game\x2C fks[0])?.loadout || null;\n}\n\nconst isFigurelessDc = _isFigurelessDc;\nconst hasDepleteEffect = _hasDepleteEffect;\nconst hasExhaustEffect = _hasExhaustEffect;\n\n// ---------------------------------------------------------------------------\n// buildHandDisplayPayload\n// ---------------------------------------------------------------------------\n\n/**\n * Build the payload for showing a player's hand of command cards.\n * @param {Function} getHandWindowButtonRow - locally defined in index.js\x2C passed in\n */\nexport function buildHandDisplayPayload(hand\x2C deck\x2C gameId\x2C game = null\x2C playerNum = 1\x2C { getHandWindowButtonRow } = {}) {\n  const files = [];\n  const embeds = [];\n\n  // Header embed\n  embeds.push(new EmbedBuilder()\n    .setTitle('Command Cards in Hand')\n    .setDescription(`**${hand.length}** cards in hand \u2022 **${deck.length}** in deck`)\n    .setColor(COLORS.DARK_EMBED));\n\n  // One embed per card (thumbnail = same size as DC embeds in Play Area)\n  // Discord allows max 10 embeds per message (1 header + 9 cards)\n  const maxCardEmbeds = 9;\n  for (let i = 0; i < Math.min(hand.length\x2C maxCardEmbeds); i++) {\n    const card = hand[i];\n    const path = getCommandCardImagePath(card);\n    const ext = path ? (path.toLowerCase().endsWith('.png') ? 'png' : 'jpg') : 'jpg';\n    const fileName = `cc-${i}-${(card || '').replace(/[^a-zA-Z0-9]/g\x2C '')}.${ext}`;\n    const embed = new EmbedBuilder()\n      .setTitle(card || `Card ${i + 1}`)\n      .setColor(COLORS.DARK_EMBED);\n    if (path && existsSync(path)) {\n      files.push(new AttachmentBuilder(path\x2C { name: fileName }));\n      embed.setThumbnail(`attachment://${fileName}`);\n    }\n    embeds.push(embed);\n  }\n\n  const content = hand.length > 0\n    ? `**Hand:** ${hand.join('\x2C ')}\\n**Deck:** ${deck.length} cards remaining.`\n    : `**Hand:** (empty)\\n**Deck:** ${deck.length} cards remaining.`;\n  const hasHandOrDeck = hand.length > 0 || deck.length > 0;\n  const rows = hasHandOrDeck ? [getCcActionButtons(gameId\x2C hand\x2C deck)] : [];\n  const windowRow = getHandWindowButtonRow ? getHandWindowButtonRow(game\x2C playerNum\x2C gameId) : null;\n  if (windowRow) rows.push(windowRow);\n  return {\n    content\x2C\n    embeds\x2C\n    files: files.length > 0 ? files : undefined\x2C\n    components: rows\x2C\n  };\n}\n\n// ---------------------------------------------------------------------------\n// getFiguresForRender\n// ---------------------------------------------------------------------------\n\nexport function getFiguresForRender(game) {\n  const pos = game.figurePositions;\n  if (!pos || (!pos[1] && !pos[2])) return [];\n  const figures = [];\n  const zoneColors = { red: '#e74c3c'\x2C blue: '#3498db' };\n  const initiativePlayerNum = getInitiativePlayerNum(game);\n  const chosen = game.deploymentZoneChosen;\n  if (!chosen) return figures;\n  const otherZone = chosen === 'red' ? 'blue' : 'red';\n  for (const p of [1\x2C 2]) {\n    const zone = p === initiativePlayerNum ? chosen : otherZone;\n    const color = zoneColors[zone] || '#888';\n    const poses = pos[p] || {};\n    const dcList = getSquad(game\x2C p)?.dcList || [];\n    const totals = {};\n    for (const d of dcList) {\n      const n = resolveDcName(d);\n      if (n && !isFigurelessDc(n)) totals[n] = (totals[n] || 0) + 1;\n    }\n    for (const [figureKey\x2C space] of Object.entries(poses)) {\n      const dcName = dcNameFromFigureKey(figureKey);\n      const { dgIndex\x2C figureIndex } = parseFigureKey(figureKey);\n      let figureCount = getDcStats(dcName).figures ?? 1;\n      if (figureCount <= 1 && dcName) {\n        const base = dcName.replace(/\\s*\\((?:Elite|Regular)\\)\\s*$/i\x2C '').trim();\n        const allEffects = getDcEffects();\n        const key = Object.keys(allEffects).find(\n          (k) => k.toLowerCase().startsWith(base.toLowerCase() + ' ') || k.toLowerCase() === base.toLowerCase()\n        );\n        if (key) figureCount = allEffects[key]?.figures ?? figureCount;\n      }\n      const dcCopies = totals[dcName] ?? 1;\n      let label = null;\n      if (figureCount > 1 || figureIndex > 0) {\n        label = `${dgIndex}${FIGURE_LETTERS[figureIndex] || 'a'}`;\n      } else if (dcCopies > 1) {\n        label = String(dgIndex);\n      }\n      const imagePath = getFigureImagePath(dcName);\n      const baseSize = getFigureSize(dcName);\n      const figureSize = game.figureOrientations?.[figureKey] || baseSize;\n      const powerTokens = game.figurePowerTokens?.[figureKey] || [];\n      const conditions = game.figureConditions?.[figureKey] || [];\n      // Find damage for this figure from dcList healthState\n      let damage = 0;\n      let _dgCount = 0;\n      for (const d of dcList) {\n        if (resolveDcName(d) === dcName) {\n          _dgCount++;\n          if (_dgCount === dgIndex) {\n            const hs = d.healthState;\n            if (hs?.[figureIndex]) damage = hs[figureIndex][1] - hs[figureIndex][0];\n            break;\n          }\n        }\n      }\n      figures.push({\n        coord: space\x2C\n        color\x2C\n        imagePath: imagePath || undefined\x2C\n        dcName\x2C\n        figureSize\x2C\n        baseSize\x2C\n        label\x2C\n        figureKey\x2C\n        powerTokens\x2C\n        conditions\x2C\n        damage\x2C\n      });\n    }\n  }\n  return figures;\n}\n\n// ---------------------------------------------------------------------------\n// buildMissionTokens\n// ---------------------------------------------------------------------------\n\n/** Build rich token array from tokenTypes + positions. Returns [{coord\x2C label\x2C image}]. Falls back to flat coord array with fallbackLabel.\n *  @param {object} [labelCounts] - Optional map of base-label \u2192 numeric count. When a token's label matches a key\x2C " (N)" is appended so dynamic counters render next to the icon (e.g. Sabacc VPs). Zero/missing counts are omitted. */\nexport function buildMissionTokens(missionData\x2C fallbackLabel\x2C labelCounts = null) {\n  if (!missionData) return [];\n  const applyCount = (label) => {\n    if (!labelCounts || !label) return label;\n    const n = labelCounts[label];\n    return typeof n === 'number' && n > 0 ? `${label} (${n})` : label;\n  };\n  const tokenTypes = missionData.tokenTypes;\n  const positions = missionData.positions;\n  if (Array.isArray(tokenTypes) && positions && typeof positions === 'object') {\n    const typeMap = {};\n    for (const t of tokenTypes) typeMap[t.id] = t;\n    const result = [];\n    for (const [typeId\x2C coords] of Object.entries(positions)) {\n      const tDef = typeMap[typeId] || {};\n      const baseLabel = tDef.label || fallbackLabel;\n      for (const coord of Array.isArray(coords) ? coords : [coords]) {\n        result.push({ coord\x2C label: applyCount(baseLabel)\x2C image: tDef.image || null });\n      }\n    }\n    return result;\n  }\n  const flat = getMissionTokenCoords(missionData);\n  return flat.map((coord) => ({ coord\x2C label: applyCount(fallbackLabel)\x2C image: null }));\n}\n\n// ---------------------------------------------------------------------------\n// getMapTokensForRender\n// ---------------------------------------------------------------------------\n\n/** Get map tokens (terminals + mission-specific + closed doors + ancillary) for renderMap.\n * @param {object|null} fluctuationPositions - If provided\x2C overrides missionB positions for Lothal Wastes B swap rendering.\n *   Shape: { "0": ["j10"\x2C "p10"]\x2C ... } \u2014 same as game.fluctuationPositions from getCurrentFluctuationPositions(). */\n/** Derive per-label counters for mission tokens. Currently: Sabacc VPs (Corellian Underground B). */\nexport function buildLabelCountsFromGame(game) {\n  if (!game) return null;\n  const counts = {};\n  if (typeof game.sabaccTokenCount === 'number' && game.sabaccTokenCount > 0) {\n    counts['Sabacc VPs'] = game.sabaccTokenCount;\n  }\n  return Object.keys(counts).length ? counts : null;\n}\n\nexport function getMapTokensForRender(mapId\x2C missionVariant\x2C openedDoors = []\x2C ancillaryTokens = null\x2C tokenLabel = 'Token'\x2C strainMap = null\x2C fluctuationPositions = null\x2C labelCounts = null) {\n  const mapData = getMapTokensData()[mapId];\n  if (!mapData) return { terminals: []\x2C missionA: []\x2C missionB: []\x2C doors: []\x2C smoke: []\x2C rubble: []\x2C energyShield: []\x2C device: []\x2C napalm: [] };\n  const terminals = mapData.terminals || [];\n  const missionA = buildMissionTokens(mapData.missionA\x2C tokenLabel\x2C labelCounts);\n  // If fluctuation positions are provided (post-swap)\x2C build missionB with overridden positions\n  let missionBData = mapData.missionB;\n  if (fluctuationPositions && missionBData) {\n    missionBData = { ...missionBData\x2C positions: fluctuationPositions };\n  }\n  const missionB = buildMissionTokens(missionBData\x2C tokenLabel\x2C labelCounts);\n  const doorEdges = mapData.doors || [];\n  const openedSet = new Set((openedDoors || []).map((k) => String(k).toLowerCase()));\n  const doors = doorEdges.filter((edge) => {\n    if (!edge || edge.length < 2) return false;\n    const ek = edgeKey(edge[0]\x2C edge[1]);\n    return !openedSet.has(ek);\n  });\n  const anc = ancillaryTokens || {};\n  return {\n    terminals\x2C\n    missionA: missionVariant === 'a' ? missionA : []\x2C\n    missionB: missionVariant === 'b' ? missionB : []\x2C\n    doors\x2C\n    smoke: anc.smoke || []\x2C\n    rubble: anc.rubble || []\x2C\n    energyShield: anc.energyShield || []\x2C\n    device: anc.device || []\x2C\n    napalm: anc.napalm || []\x2C\n    namedAreas: (mapData.namedAreas || []).filter(a => a.name && a.cells?.length)\x2C\n    strainMarkers: _buildStrainMarkers(strainMap)\x2C\n  };\n}\n\n/** Convert strain state map {coord: count} to render-ready array [{coord\x2C count}]. */\nfunction _buildStrainMarkers(strainMap) {\n  if (!strainMap || typeof strainMap !== 'object') return [];\n  const markers = [];\n  for (const [coord\x2C count] of Object.entries(strainMap)) {\n    if (count > 0) markers.push({ coord\x2C count });\n  }\n  return markers;\n}\n\n// ---------------------------------------------------------------------------\n// getActivationMinimapAttachment\n// ---------------------------------------------------------------------------\n\n/** Returns AttachmentBuilder for activation minimap (zoomed on figure\x2C size = speed * 1.75 cells). msgId = DC message ID. */\nexport async function getActivationMinimapAttachment(game\x2C msgId) {\n  const meta = dcMessageMeta.get(msgId);\n  const map = game?.selectedMap;\n  if (!meta || !map?.id) return null;\n  const playerNum = meta.playerNum;\n  const dcName = meta.dcName;\n  const dgIndex = (meta.displayName || '').match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? 1;\n  const poses = game.figurePositions?.[playerNum] || {};\n  let figureKey = null;\n  let pos = null;\n  for (let fi = 0; fi < 10; fi++) {\n    const fk = `${dcName}-${dgIndex}-${fi}`;\n    if (fk in poses) {\n      figureKey = fk;\n      pos = poses[fk];\n      break;\n    }\n  }\n  if (!figureKey || !pos) return null;\n  const speed = getEffectiveSpeed(dcName\x2C figureKey\x2C game\x2C playerNum);\n  const size = getEffectiveFigureSize(game\x2C figureKey\x2C dcName);\n  const { col: tlCol\x2C row: tlRow } = parseCoord(pos);\n  const [cols = 1\x2C rows = 1] = String(size || '1x1').split('x').map(Number);\n  const centerCol = Math.floor(tlCol + (cols - 1) / 2);\n  const centerRow = Math.floor(tlRow + (rows - 1) / 2);\n  const halfExtent = Math.max(1\x2C Math.ceil((speed * 1.75) / 2));\n  const cropCoords = [];\n  for (let dr = -halfExtent; dr <= halfExtent; dr++) {\n    for (let dc = -halfExtent; dc <= halfExtent; dc++) {\n      const c = colRowToCoord(centerCol + dc\x2C centerRow + dr);\n      if (c) cropCoords.push(c);\n    }\n  }\n  if (cropCoords.length === 0) return null;\n  // Only label valid map spaces within the crop zone (not off-map/wall cells)\n  const mapSpaceSet = getMapSpaceSet(map.id);\n  const labelCoords = mapSpaceSet.size\n    ? cropCoords.filter(c => mapSpaceSet.has(c.toLowerCase())).map(c => c.toLowerCase())\n    : [];\n  try {\n    const figures = getFiguresForRender(game);\n    const tokens = getMapTokensForRender(map.id\x2C game?.selectedMission?.variant\x2C game?.openedDoors\x2C game?.ancillaryTokens\x2C game?.selectedMission?.tokenLabel || 'Token'\x2C game?.signalMarkerStrain\x2C game?.fluctuationPositions\x2C buildLabelCountsFromGame(game));\n    const buffer = await renderMap(map.id\x2C {\n      figures\x2C\n      tokens\x2C\n      showGrid: true\x2C\n      maxWidth: 800\x2C\n      cropToZone: cropCoords\x2C\n      gridStyle: 'black'\x2C\n      showGridOnlyOnCoords: labelCoords\x2C\n    });\n    return new AttachmentBuilder(buffer\x2C { name: 'activation-minimap.png' });\n  } catch (err) {\n    console.error('Activation minimap render error:'\x2C err);\n    return null;\n  }\n}\n\n// ---------------------------------------------------------------------------\n// getMovementMinimapAttachment\n// ---------------------------------------------------------------------------\n\n/** Returns AttachmentBuilder for movement minimap (zoomed on figure\x2C coords only on spacesAtCost). */\nexport async function getMovementMinimapAttachment(game\x2C msgId\x2C figureKey\x2C spacesAtCost) {\n  const meta = dcMessageMeta.get(msgId);\n  const map = game?.selectedMap;\n  if (!meta || !map?.id || !spacesAtCost?.length) return null;\n  const playerNum = meta.playerNum;\n  const pos = game.figurePositions?.[playerNum]?.[figureKey];\n  if (!pos) return null;\n  const dcName = dcNameFromFigureKey(figureKey);\n  const speed = getEffectiveSpeed(dcName\x2C figureKey\x2C game\x2C playerNum);\n  const size = getEffectiveFigureSize(game\x2C figureKey\x2C dcName);\n  const { col: tlCol\x2C row: tlRow } = parseCoord(pos);\n  const [cols = 1\x2C rows = 1] = String(size || '1x1').split('x').map(Number);\n  const centerCol = Math.floor(tlCol + (cols - 1) / 2);\n  const centerRow = Math.floor(tlRow + (rows - 1) / 2);\n  const halfExtent = Math.max(1\x2C Math.ceil((speed * 2.5) / 2));\n  const cropCoords = [];\n  for (let dr = -halfExtent; dr <= halfExtent; dr++) {\n    for (let dc = -halfExtent; dc <= halfExtent; dc++) {\n      const c = colRowToCoord(centerCol + dc\x2C centerRow + dr);\n      if (c) cropCoords.push(c);\n    }\n  }\n  if (cropCoords.length === 0) return null;\n  const labelCoords = spacesAtCost.map((s) => String(s).toLowerCase());\n  try {\n    const figures = getFiguresForRender(game);\n    const tokens = getMapTokensForRender(map.id\x2C game?.selectedMission?.variant\x2C game?.openedDoors\x2C game?.ancillaryTokens\x2C game?.selectedMission?.tokenLabel || 'Token'\x2C game?.signalMarkerStrain\x2C game?.fluctuationPositions\x2C buildLabelCountsFromGame(game));\n    const buffer = await renderMap(map.id\x2C {\n      figures\x2C\n      tokens\x2C\n      showGrid: true\x2C\n      maxWidth: 800\x2C\n      cropToZone: cropCoords\x2C\n      gridStyle: 'black'\x2C\n      showGridOnlyOnCoords: labelCoords\x2C\n    });\n    return new AttachmentBuilder(buffer\x2C { name: 'move-destinations.png' });\n  } catch (err) {\n    console.error('Movement minimap render error:'\x2C err);\n    return null;\n  }\n}\n\n// ---------------------------------------------------------------------------\n// getDeploymentMapAttachment\n// ---------------------------------------------------------------------------\n\n/** Returns AttachmentBuilder for deployment zone map (zoomed\x2C black coords). zone = 'red' | 'blue'. */\nexport async function getDeploymentMapAttachment(game\x2C zone\x2C opts = {}) {\n  const map = game?.selectedMap;\n  if (!map?.id) return null;\n  try {\n    const figures = getFiguresForRender(game);\n    const tokens = getMapTokensForRender(map.id\x2C game?.selectedMission?.variant\x2C game?.openedDoors\x2C game?.ancillaryTokens\x2C game?.selectedMission?.tokenLabel || 'Token'\x2C game?.signalMarkerStrain\x2C game?.fluctuationPositions\x2C buildLabelCountsFromGame(game));\n    let zoneSpaces = zone && getDeploymentZones()[map.id]?.[zone] ? [...getDeploymentZones()[map.id][zone]] : null;\n    // For Massive/Mobile figures\x2C include blocking cells in the zone so they appear numbered\n    if (opts.includeBlocking && zoneSpaces) {\n      const ms = getMapData(map.id);\n      const blockingCells = (ms?.blocking || []).map(s => String(s).toLowerCase());\n      zoneSpaces = [...new Set([...zoneSpaces\x2C ...blockingCells])];\n    }\n    const occupiedSet = toLowerSet(getOccupiedSpacesForMovement(game) || []);\n    const validLabelCoords =\n      zoneSpaces && zoneSpaces.length > 0\n        ? zoneSpaces.filter((c) => !occupiedSet.has(String(c).toLowerCase()))\n        : null;\n    const buffer = await renderMap(map.id\x2C {\n      figures\x2C\n      tokens\x2C\n      showGrid: true\x2C\n      maxWidth: 900\x2C\n      cropToZone: zoneSpaces && zoneSpaces.length > 0 ? zoneSpaces : null\x2C\n      gridStyle: 'black'\x2C\n      showGridOnlyOnCoords: validLabelCoords && validLabelCoords.length > 0 ? validLabelCoords : null\x2C\n    });\n    return new AttachmentBuilder(buffer\x2C { name: 'deployment-zone.png' });\n  } catch (err) {\n    console.error('Deployment map render error:'\x2C err);\n    return null;\n  }\n}\n\n// ---------------------------------------------------------------------------\n// buildBoardMapPayload\n// ---------------------------------------------------------------------------\n\n/**\n * Build the full board-map message payload (map image\x2C scorecard\x2C buttons).\n * @param {object} client - Discord.js Client instance (for user cache lookups)\n * @param {object} deps - { getMissionVpBonus\x2C getHandWindowButtonRow } local helpers from index.js\n */\nexport async function buildBoardMapPayload(gameId\x2C map\x2C game\x2C client\x2C { getMissionVpBonus } = {}) {\n  const components = getBoardButtons(gameId\x2C { game });\n  const embeds = game && getMissionVpBonus ? [buildScorecardEmbed(game\x2C getMissionVpBonus(game))] : (game ? [buildScorecardEmbed(game\x2C 0)] : []);\n  const figures = game ? getFiguresForRender(game) : [];\n  const tokens = getMapTokensForRender(map.id\x2C game?.selectedMission?.variant\x2C game?.openedDoors\x2C game?.ancillaryTokens\x2C game?.selectedMission?.tokenLabel || 'Token'\x2C game?.signalMarkerStrain\x2C game?.fluctuationPositions\x2C buildLabelCountsFromGame(game));\n  const hasFigures = figures.length > 0;\n  const hasAncillary = (tokens.smoke?.length || 0) + (tokens.rubble?.length || 0) + (tokens.energyShield?.length || 0) + (tokens.device?.length || 0) + (tokens.napalm?.length || 0) > 0;\n  const hasTokens = tokens.terminals?.length > 0 || tokens.missionA?.length > 0 || tokens.missionB?.length > 0 || tokens.doors?.length > 0 || hasAncillary;\n  const resolvedMapPath = map.imagePath ? resolveAssetPath(map.imagePath\x2C 'maps') : null;\n  const imagePath = resolvedMapPath ? join(rootDir\x2C resolvedMapPath) : null;\n  const pdfPath = join(rootDir\x2C 'data'\x2C 'map-pdfs'\x2C `${map.id}.pdf`);\n\n  const rawUsers = game ? snowflakeUsers([...new Set([game.player1Id\x2C game.player2Id])]) : [];\n  const allowedMentions = rawUsers.length > 0 ? { users: rawUsers } : undefined;\n  // Player labels: Discord names over each player's deployment zone\n  const playerLabels = [];\n  if (game?.deploymentZoneChosen && game?.player1Id && game?.player2Id) {\n    const zoneData = getDeploymentZones()[map.id] || {};\n    const initZone = game.deploymentZoneChosen;\n    const otherZone = initZone === 'red' ? 'blue' : 'red';\n    const p1IsInit = game.player1Id === game.initiativePlayerId;\n    const p1ZoneCells = zoneData[p1IsInit ? initZone : otherZone] || [];\n    const p2ZoneCells = zoneData[p1IsInit ? otherZone : initZone] || [];\n    const p1User = client.users.cache.get(game.player1Id);\n    const p2User = client.users.cache.get(game.player2Id);\n    const p1Name = p1User?.globalName || p1User?.username || 'P1';\n    const p2Name = p2User?.globalName || p2User?.username || 'P2';\n    if (p1ZoneCells.length > 0) playerLabels.push({ label: p1Name\x2C zone: p1ZoneCells });\n    if (p2ZoneCells.length > 0) playerLabels.push({ label: p2Name\x2C zone: p2ZoneCells });\n  }\n\n  if ((hasFigures || hasTokens) && imagePath && existsSync(imagePath)) {\n    try {\n      const buffer = await renderMap(map.id\x2C { figures\x2C tokens\x2C showGrid: false\x2C maxWidth: 1200\x2C playerLabels });\n      return {\n        content: `**Game map: ${map.name}** \u2014 Refresh to update figure positions.`\x2C\n        files: [new AttachmentBuilder(buffer\x2C { name: 'map-with-figures.png' })]\x2C\n        embeds\x2C\n        components\x2C\n        allowedMentions\x2C\n      };\n    } catch (err) {\n      console.error('Map render error:'\x2C err);\n    }\n  }\n  if (existsSync(pdfPath)) {\n    return {\n      content: `**Game map: ${map.name}** (high-res PDF)`\x2C\n      files: [new AttachmentBuilder(pdfPath\x2C { name: `${map.id}.pdf` })]\x2C\n      embeds\x2C\n      components\x2C\n      allowedMentions\x2C\n    };\n  }\n  if (imagePath && existsSync(imagePath)) {\n    return {\n      content: `**Game map: ${map.name}** *(Add \\`data/map-pdfs/${map.id}.pdf\\` for high-res PDF)*`\x2C\n      files: [\n        new AttachmentBuilder(imagePath\x2C { name: `map.${(map.imagePath || '').split('.').pop() || 'gif'}` })\x2C\n      ]\x2C\n      embeds\x2C\n      components\x2C\n      allowedMentions\x2C\n    };\n  }\n  return {\n    content: `**Game map: ${map.name}** \u2014 Add high-res PDF at \\`data/map-pdfs/${map.id}.pdf\\` to display it here.`\x2C\n    files: undefined\x2C\n    embeds\x2C\n    components\x2C\n    allowedMentions\x2C\n  };\n}\n\n// ---------------------------------------------------------------------------\n// buildDcEmbedAndFiles\n// ---------------------------------------------------------------------------\n\nexport async function buildDcEmbedAndFiles(dcName\x2C exhausted\x2C displayName\x2C healthState\x2C conditionsByFigure\x2C dcAttachments = []\x2C tokensByFigure = null\x2C actionsData = null\x2C nicknamesByFigure = null\x2C options = {}) {\n  const loadoutName = options.loadoutName || (options.game && options.playerNum ? getLoadoutNameForEmbed(options.game\x2C dcName\x2C options.playerNum\x2C displayName) : null);\n  const figureless = isFigurelessDc(dcName);\n  const canExhaust = figureless && (hasExhaustEffect(dcName) || hasDepleteEffect(dcName));\n  const showStatus = !figureless || canExhaust;\n  const status = showStatus ? (exhausted ? 'EXHAUSTED' : 'READIED') : null;\n  const color = exhausted ? COLORS.RED : COLORS.GREEN; // red : green\n  const dgIndex = displayName.match(/\\[(?:DG|Group) (\\d+)\\]/)?.[1] ?? 1;\n  const stats = getDcStats(dcName);\n  const figures = stats.figures ?? 1;\n  const variant = dcName?.includes('(Elite)') ? 'Elite' : dcName?.includes('(Regular)') ? 'Regular' : null;\n  const healthSection = figureless ? null : formatHealthSection(Number(dgIndex)\x2C healthState\x2C conditionsByFigure\x2C tokensByFigure\x2C nicknamesByFigure);\n  const actionsLine = (actionsData != null && exhausted) ? getActionsCounterContent(actionsData.remaining\x2C actionsData.total) : null;\n  const loadoutLine = loadoutName ? `**Loadout:** ${loadoutName}` : null;\n  // Imperial Citadel: show token inventory on the card\n  let citadelTokenLine = null;\n  if (figureless && dcName?.includes('Imperial Citadel') && options.game?.imperialCitadelTokens) {\n    const ct = options.game.imperialCitadelTokens;\n    const parts = Object.entries(ct).filter(([\x2C v]) => v > 0).map(([k\x2C v]) => `${v} ${k.charAt(0).toUpperCase() + k.slice(1)}`);\n    citadelTokenLine = parts.length > 0 ? `**Tokens:** ${parts.join('\x2C ')}` : '**Tokens:** none';\n  }\n  const lines = figureless\n    ? [actionsLine\x2C variant ? `**Variant:** ${variant}` : null\x2C citadelTokenLine].filter(Boolean)\n    : [\n        actionsLine\x2C\n        `**Figures:** ${figures}`\x2C\n        variant ? `**Variant:** ${variant}` : null\x2C\n        loadoutLine\x2C\n        ''\x2C\n        healthSection\x2C\n      ].filter(Boolean);\n  const embed = new EmbedBuilder()\n    .setTitle(status ? `${status} \u2014 ${displayName}` : displayName)\n    .setDescription(lines.length ? lines.join('\\n') : '\\u200b')\n    .setColor(color);\n\n  let files = [];\n  // Check if any attached skirmish upgrade overrides the card image\n  const baseDcForOverride = (dcName || '').replace(/\\s*\\[.*\\]\\s*$/\x2C '').trim();\n  const upgradeMap = UPGRADE_IMAGE_OVERRIDES[baseDcForOverride];\n  let imagePath = getDcImagePath(dcName?.trim());\n  if (upgradeMap && dcAttachments?.length) {\n    for (const attachName of dcAttachments) {\n      if (upgradeMap[attachName]) { imagePath = upgradeMap[attachName]; break; }\n    }\n  }\n  if (imagePath) {\n    const fullPath = join(rootDir\x2C imagePath);\n    if (existsSync(fullPath)) {\n      const ext = imagePath.split('.').pop() || 'png';\n      const attachName = `dc-card.${ext}`;\n      files.push(new AttachmentBuilder(fullPath\x2C { name: attachName }));\n      embed.setImage(`attachment://${attachName}`);\n    }\n  }\n  return { embed\x2C files };\n}\n\n// ---------------------------------------------------------------------------\n// buildDiscardPileDisplayPayload\n// ---------------------------------------------------------------------------\n\n/** Build discard pile display for thread (embeds with card images\x2C like hand view). Returns array of { embeds\x2C files } for chunked sends. */\nexport function buildDiscardPileDisplayPayload(discard) {\n  const cardData = [];\n  for (let i = 0; i < discard.length; i++) {\n    const card = discard[i];\n    const path = getCommandCardImagePath(card);\n    const ext = path ? (path.toLowerCase().endsWith('.png') ? 'png' : 'jpg') : 'jpg';\n    const fileName = `cc-discard-${i}-${(card || '').replace(/[^a-zA-Z0-9]/g\x2C '')}.${ext}`;\n    const embed = new EmbedBuilder()\n      .setTitle(card || `Card ${i + 1}`)\n      .setColor(COLORS.DARK_EMBED);\n    let file = null;\n    if (path && existsSync(path)) {\n      file = new AttachmentBuilder(path\x2C { name: fileName });\n      embed.setThumbnail(`attachment://${fileName}`);\n    }\n    cardData.push({ embed\x2C file });\n  }\n  const header = new EmbedBuilder()\n    .setTitle('Command Cards in Discard Pile')\n    .setDescription(`**${discard.length}** cards discarded`)\n    .setColor(COLORS.DARK_EMBED);\n  const chunks = [];\n  let embeds = [header];\n  let files = [];\n  for (let i = 0; i < cardData.length; i++) {\n    if (embeds.length >= EMBEDS_PER_MESSAGE) {\n      chunks.push({ embeds\x2C files: files.length > 0 ? files : undefined });\n      embeds = [];\n      files = [];\n    }\n    embeds.push(cardData[i].embed);\n    if (cardData[i].file) files.push(cardData[i].file);\n  }\n  if (embeds.length > 0) chunks.push({ embeds\x2C files: files.length > 0 ? files : undefined });\n  return chunks;\n}\n
