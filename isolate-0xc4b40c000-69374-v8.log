lue)); } catch (e) { reject(e); } }\n        function step(result) { result.done ? resolve(result.value) : adopt(result.value).then(fulfilled\x2C rejected); }\n        step((generator = generator.apply(thisArg\x2C _arguments || [])).next());\n    });\n};\nclass Mutex {\n    constructor(cancelError) {\n        this._semaphore = new Semaphore(1\x2C cancelError);\n    }\n    acquire() {\n        return __awaiter$1(this\x2C arguments\x2C void 0\x2C function* (priority = 0) {\n            const [\x2C releaser] = yield this._semaphore.acquire(1\x2C priority);\n            return releaser;\n        });\n    }\n    runExclusive(callback\x2C priority = 0) {\n        return this._semaphore.runExclusive(() => callback()\x2C 1\x2C priority);\n    }\n    isLocked() {\n        return this._semaphore.isLocked();\n    }\n    waitForUnlock(priority = 0) {\n        return this._semaphore.waitForUnlock(1\x2C priority);\n    }\n    release() {\n        if (this._semaphore.isLocked())\n            this._semaphore.release();\n    }\n    cancel() {\n        return this._semaphore.cancel();\n    }\n}\n\nvar __awaiter = (undefined && undefined.__awaiter) || function (thisArg\x2C _arguments\x2C P\x2C generator) {\n    function adopt(value) { return value instanceof P ? value : new P(function (resolve) { resolve(value); }); }\n    return new (P || (P = Promise))(function (resolve\x2C reject) {\n        function fulfilled(value) { try { step(generator.next(value)); } catch (e) { reject(e); } }\n        function rejected(value) { try { step(generator["throw"](value)); } catch (e) { reject(e); } }\n        function step(result) { result.done ? resolve(result.value) : adopt(result.value).then(fulfilled\x2C rejected); }\n        step((generator = generator.apply(thisArg\x2C _arguments || [])).next());\n    });\n};\nfunction withTimeout(sync\x2C timeout\x2C timeoutError = E_TIMEOUT) {\n    return {\n        acquire: (weightOrPriority\x2C priority) => {\n            let weight;\n            if (isSemaphore(sync)) {\n                weight = weightOrPriority;\n            }\n            else {\n                weight = undefined;\n                priority = weightOrPriority;\n            }\n            if (weight !== undefined && weight <= 0) {\n                throw new Error(`invalid weight ${weight}: must be positive`);\n            }\n            return new Promise((resolve\x2C reject) => __awaiter(this\x2C void 0\x2C void 0\x2C function* () {\n                let isTimeout = false;\n                const handle = setTimeout(() => {\n                    isTimeout = true;\n                    reject(timeoutError);\n                }\x2C timeout);\n                try {\n                    const ticket = yield (isSemaphore(sync)\n                        ? sync.acquire(weight\x2C priority)\n                        : sync.acquire(priority));\n                    if (isTimeout) {\n                        const release = Array.isArray(ticket) ? ticket[1] : ticket;\n                        release();\n                    }\n                    else {\n                        clearTimeout(handle);\n                        resolve(ticket);\n                    }\n                }\n                catch (e) {\n                    if (!isTimeout) {\n                        clearTimeout(handle);\n                        reject(e);\n                    }\n                }\n            }));\n        }\x2C\n        runExclusive(callback\x2C weight\x2C priority) {\n            return __awaiter(this\x2C void 0\x2C void 0\x2C function* () {\n                let release = () => undefined;\n                try {\n                    const ticket = yield this.acquire(weight\x2C priority);\n                    if (Array.isArray(ticket)) {\n                        release = ticket[1];\n                        return yield callback(ticket[0]);\n                    }\n                    else {\n                        release = ticket;\n                        return yield call