code-creation,Script,9,294866,0x3f05b92a0a70,52, file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/space-picker.js:1:1,0x6327002a208,~
script-source,248,file:///Users/adammeehan/Public/IACP-Skirmish-Async/src/handlers/space-picker.js,/**\n * Generic 2-step space picker handlers: space_row_\x2C space_row_back_\n *\n * Usage contract:\n * 1. Flow stores game.pendingSpacePick[contextKey] with validSpaces\x2C cellPrefix\x2C etc.\n * 2. Flow calls buildRowPickerButtons(validSpaces\x2C `space_row_${contextKey}_`\x2C options)\n * 3. These generic handlers manage the row\u2192cell\u2192back cycle\n * 4. Cell pick still routes to the flow's own handler (via cellPrefix)\n * 5. Flow's cell handler calls cleanupSpacePick(game\x2C contextKey) on resolution\n *\n * pendingSpacePick[contextKey] shape:\n *   { validSpaces\x2C cellPrefix\x2C mapSpaces\x2C labelMap?\x2C headerText?\x2C style?\x2C actionButtons? }\n *\n * actionButtons (optional): serializable button descriptors shown alongside Back on cell view\n * and alongside rows on row view. Format: [{ customId\x2C label\x2C style (ButtonStyle int) }]\n *\n * contextKey format: must start with gameId (e.g. '00001_msgId' or '00001_msgId_figIdx').\n * gameId is extracted as contextKey.split('_')[0].\n */\n\nimport { ActionRowBuilder\x2C ButtonBuilder\x2C ButtonStyle } from 'discord.js';\nimport {\n  buildRowPickerButtons\x2C\n  filterSpacesToRow\x2C\n  getSpaceChoiceRows\x2C\n} from '../discord/components.js';\nimport { requireGame } from '../utils/guards.js';\nimport { discordCatch } from '../error-handling.js';\n\n/**\n * Handle space_row_{contextKey}_{rowNum}: user picked a row\x2C show cells in that row.\n */\nexport async function handleSpaceRow(interaction\x2C ctx) {\n  const { getGame } = ctx;\n  // contextKey can contain underscores; rowNum is always the last numeric segment\n  const m = interaction.customId.match(/^space_row_(.+)_(\\d+)$/);\n  if (!m) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C contextKey\x2C rowNumStr] = m;\n  const rowNum = parseInt(rowNumStr\x2C 10);\n  const gameId = contextKey.split('_')[0];\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n\n  const pending = game.pendingSpacePick?.[contextKey];\n  if (!pending) {\n    await interaction.followUp({ content: 'Space selection expired.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const filtered = filterSpacesToRow(pending.validSpaces\x2C rowNum);\n  const displayRow = rowNum + (pending.rowDisplayOffset || 0);\n  if (filtered.length === 0) {\n    await interaction.followUp({ content: `No spaces in Row ${displayRow}.`\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const { rows: cellRows } = getSpaceChoiceRows(\n    pending.cellPrefix\x2C\n    filtered\x2C\n    pending.mapSpaces\x2C\n    Infinity\x2C\n    pending.labelMap || {}\x2C\n  );\n\n  const backBtn = new ButtonBuilder()\n    .setCustomId(`space_row_back_${contextKey}`)\n    .setLabel('Back to Rows')\n    .setStyle(ButtonStyle.Secondary);\n  const extraBtns = (pending.actionButtons || []).map(b =>\n    new ButtonBuilder().setCustomId(b.customId).setLabel(b.label).setStyle(b.style || ButtonStyle.Secondary)\n  );\n  const actionRow = new ActionRowBuilder().addComponents(backBtn\x2C ...extraBtns);\n\n  const components = [...cellRows.slice(0\x2C 4)\x2C actionRow];\n\n  try {\n    await interaction.message.edit({\n      content: `${pending.headerText || 'Pick a space'} \u2014 **Row ${displayRow}** (${filtered.length} space${filtered.length !== 1 ? 's' : ''}):`\x2C\n      components\x2C\n    });\n  } catch {\n    await interaction.followUp({\n      content: `**Row ${displayRow}** \u2014 pick a space:`\x2C\n      components\x2C\n      ephemeral: false\x2C\n    }).catch(discordCatch);\n  }\n}\n\n/**\n * Handle space_row_back_{contextKey}: return to the row picker.\n */\nexport async function handleSpaceRowBack(interaction\x2C ctx) {\n  const { getGame } = ctx;\n  const m = interaction.customId.match(/^space_row_back_(.+)$/);\n  if (!m) {\n    await interaction.followUp({ content: 'Invalid button.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n  const [\x2C contextKey] = m;\n  const gameId = contextKey.split('_')[0];\n\n  const game = await requireGame(interaction\x2C getGame\x2C gameId);\n  if (!game) return;\n\n  const pending = game.pendingSpacePick?.[contextKey];\n  if (!pending) {\n    await interaction.followUp({ content: 'Space selection expired.'\x2C ephemeral: true }).catch(discordCatch);\n    return;\n  }\n\n  const { rows } = buildRowPickerButtons(\n    pending.validSpaces\x2C\n    `space_row_${contextKey}_`\x2C\n    { style: pending.style || ButtonStyle.Primary\x2C rowDisplayOffset: pending.rowDisplayOffset || 0 }\x2C\n  );\n\n  const maxRowBtns = pending.actionButtons?.length ? 4 : 5;\n  const components = rows.slice(0\x2C maxRowBtns);\n  if (pending.actionButtons?.length) {\n    const extraBtns = pending.actionButtons.map(b =>\n      new ButtonBuilder().setCustomId(b.customId).setLabel(b.label).setStyle(b.style || ButtonStyle.Secondary)\n    );\n    components.push(new ActionRowBuilder().addComponents(...extraBtns));\n  }\n\n  try {\n    await interaction.message.edit({\n      content: pending.headerText || 'Pick a row:'\x2C\n      components\x2C\n    });\n  } catch {\n    await interaction.followUp({\n      content: pending.headerText || 'Pick a row:'\x2C\n      components\x2C\n      ephemeral: false\x2C\n    }).catch(discordCatch);\n  }\n}\n
