<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent that runs the bothelpers allowlist sync every 10 minutes.

  Install:
    cp scripts/com.iacp.bothelpers-sync.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.iacp.bothelpers-sync.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.iacp.bothelpers-sync.plist
    rm ~/Library/LaunchAgents/com.iacp.bothelpers-sync.plist

  Logs: /tmp/iacp-bothelpers-sync.{out,err}.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.iacp.bothelpers-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>/Users/adammeehan/Public/IACP-Skirmish-Async/scripts/sync-bothelpers-allowlist.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/adammeehan/Public/IACP-Skirmish-Async</string>

  <key>StartInterval</key>
  <integer>5</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/iacp-bothelpers-sync.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/iacp-bothelpers-sync.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
